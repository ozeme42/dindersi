    "content": {
      "text": "Peltek Harfler"
    },
    "updatedAt": "2026-09-19T11:14:44.167Z"
  },
  {
    "id": "def_EgNZXs2YrRrFddA4HFvv_0",
    "type": "definition",
    "topicId": "EgNZXs2YrRrFddA4HFvv",
    "unitId": "SxbbRsztz3FrWwzGVAoh",
    "courseId": "8dWTFfJd7fb2jTCVkXNb",
    "content": {
      "term": "Mahreç",
      "definition": "Harflerin ses yolundan çıktığı, seslendirildiği yere verilen isimdir."
    },
    "updatedAt": "2026-09-19T11:14:44.167Z"
  },
  {
    "id": "def_EgNZXs2YrRrFddA4HFvv_1",
    "type": "definition",
    "topicId": "EgNZXs2YrRrFddA4HFvv",
    "unitId": "SxbbRsztz3FrWwzGVAoh",
    "courseId": "8dWTFfJd7fb2jTCVkXNb",
    "content": {
      "term": "Peltek Harfler",
      "definition": "Dil ucunun üst ön dişlerin ucuna getirilerek seslendirildiği, yumuşak okunan ses grubudur."
    },
    "updatedAt": "2026-09-19T11:14:44.167Z"
  },
  {
    "id": "sentence_EgNZXs2YrRrFddA4HFvv_0",
    "type": "sentence",
    "topicId": "EgNZXs2YrRrFddA4HFvv",
    "unitId": "SxbbRsztz3FrWwzGVAoh",
    "courseId": "8dWTFfJd7fb2jTCVkXNb",
    "content": {
      "text": "Boğaz harfleri boğazdan gelen titreşimle seslendirilir."
    },
    "updatedAt": "2026-09-19T11:14:44.167Z"
  },
  {
    "id": "sentence_EgNZXs2YrRrFddA4HFvv_1",
    "type": "sentence",
    "topicId": "EgNZXs2YrRrFddA4HFvv",
    "unitId": "SxbbRsztz3FrWwzGVAoh",
    "courseId": "8dWTFfJd7fb2jTCVkXNb",
    "content": {
      "text": "Peltek harfler okunurken dil ucu kullanılır."
    },
    "updatedAt": "2026-09-19T11:14:44.167Z"
  },
  {
    "id": "sentence_EgNZXs2YrRrFddA4HFvv_2",
    "type": "sentence",
    "topicId": "EgNZXs2YrRrFddA4HFvv",
    "unitId": "SxbbRsztz3FrWwzGVAoh",
    "courseId": "8dWTFfJd7fb2jTCVkXNb",
    "content": {
      "text": "Lâmelif alfabede müstakil bir harf değildir."
    },
    "updatedAt": "2026-09-19T11:14:44.167Z"
  },
  {
    "id": "sentence_EgNZXs2YrRrFddA4HFvv_3",
    "type": "sentence",
    "topicId": "EgNZXs2YrRrFddA4HFvv",
    "unitId": "SxbbRsztz3FrWwzGVAoh",
    "courseId": "8dWTFfJd7fb2jTCVkXNb",
    "content": {
      "text": "Yanlış telaffuz kelimenin anlamını tamamen değiştirebilir."
    },
    "updatedAt": "2026-09-19T11:14:44.167Z"
  },
  {
    "id": "sentence_EgNZXs2YrRrFddA4HFvv_4",
    "type": "sentence",
    "topicId": "EgNZXs2YrRrFddA4HFvv",
    "unitId": "SxbbRsztz3FrWwzGVAoh",
    "courseId": "8dWTFfJd7fb2jTCVkXNb",
    "content": {
      "text": "Kalın harfler tok bir sesle okunur."
    },
    "updatedAt": "2026-09-19T11:14:44.167Z"
  },
  {
    "id": "sentence_EgNZXs2YrRrFddA4HFvv_5",
    "type": "sentence",
    "topicId": "EgNZXs2YrRrFddA4HFvv",
    "unitId": "SxbbRsztz3FrWwzGVAoh",
    "courseId": "8dWTFfJd7fb2jTCVkXNb",
    "content": {
      "text": "Kur'an alfabesi yirmi sekiz harften oluşur."
    },
    "updatedAt": "2026-09-19T11:14:44.167Z"
  },
  {
    "id": "sentence_EgNZXs2YrRrFddA4HFvv_6",
    "type": "sentence",
    "topicId": "EgNZXs2YrRrFddA4HFvv",
    "unitId": "SxbbRsztz3FrWwzGVAoh",
    "courseId": "8dWTFfJd7fb2jTCVkXNb",
    "content": {
      "text": "Rı harfi bazen ince bazen kalın okunur."
    },
    "updatedAt": "2026-09-19T11:14:44.167Z"
  },
  {
    "id": "sentence_EgNZXs2YrRrFddA4HFvv_7",
    "type": "sentence",
    "topicId": "EgNZXs2YrRrFddA4HFvv",
    "unitId": "SxbbRsztz3FrWwzGVAoh",
    "courseId": "8dWTFfJd7fb2jTCVkXNb",
    "content": {
      "text": "Harflerin çıkış yerine mahreç adı verilir."
    },
    "updatedAt": "2026-09-19T11:14:44.167Z"
  },
  {
    "id": "sentence_EgNZXs2YrRrFddA4HFvv_8",
    "type": "sentence",
    "topicId": "EgNZXs2YrRrFddA4HFvv",
    "unitId": "SxbbRsztz3FrWwzGVAoh",
    "courseId": "8dWTFfJd7fb2jTCVkXNb",
    "content": {
      "text": "Kur'an harfleri sağdan sola doğru okunur."
    },
    "updatedAt": "2026-09-19T11:14:44.167Z"
  }
]