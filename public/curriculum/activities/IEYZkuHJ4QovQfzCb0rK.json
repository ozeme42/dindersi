  {
    "id": "def_IEYZkuHJ4QovQfzCb0rK_0",
    "type": "definition",
    "topicId": "IEYZkuHJ4QovQfzCb0rK",
    "unitId": "jjotqKbHyi504QHH40ko",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "term": "Esmâyıhüsnâ",
      "definition": "Allah'ın en güzel isimleri."
    },
    "updatedAt": "2026-09-08T14:12:03.688Z"
  },
  {
    "id": "def_IEYZkuHJ4QovQfzCb0rK_1",
    "type": "definition",
    "topicId": "IEYZkuHJ4QovQfzCb0rK",
    "unitId": "jjotqKbHyi504QHH40ko",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "term": "(sav)",
      "definition": "Sallallahu aleyhi ve sellem: Allah (cc) ona salat ve selam eylesin demektir."
    },
    "updatedAt": "2026-09-08T14:12:03.688Z"
  },
  {
    "id": "def_IEYZkuHJ4QovQfzCb0rK_2",
    "type": "definition",
    "topicId": "IEYZkuHJ4QovQfzCb0rK",
    "unitId": "jjotqKbHyi504QHH40ko",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "term": "Semî'",
      "definition": "Her şeyi işiten Allah'ın ismi nedir?"
    },
    "updatedAt": "2026-09-08T14:12:03.688Z"
  },
  {
    "id": "def_IEYZkuHJ4QovQfzCb0rK_3",
    "type": "definition",
    "topicId": "IEYZkuHJ4QovQfzCb0rK",
    "unitId": "jjotqKbHyi504QHH40ko",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "term": "Rahman",
      "definition": "Bütün yaratılmışlara şefkat gösteren, merhamet eden, sürekli nimetler veren, rahmeti sonsuz olan Allah'ın ismi nedir?"
    },
    "updatedAt": "2026-09-08T14:12:03.688Z"
  },
  {
    "id": "def_IEYZkuHJ4QovQfzCb0rK_4",
    "type": "definition",
    "topicId": "IEYZkuHJ4QovQfzCb0rK",
    "unitId": "jjotqKbHyi504QHH40ko",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "term": "Kadîr",
      "definition": "Her şeye gücü yeten Allah'ın ismi nedir?"
    },
    "updatedAt": "2026-09-08T14:12:03.688Z"
  },
  {
    "id": "def_IEYZkuHJ4QovQfzCb0rK_5",
    "type": "definition",
    "topicId": "IEYZkuHJ4QovQfzCb0rK",
    "unitId": "jjotqKbHyi504QHH40ko",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "term": "Rahîm",
      "definition": "Yarattığı bütün varlıklara karşılık beklemeden nimetler veren, koruyan, esirgeyen, bağışlayan ve merhamet eden, ahirette inanan kullarına şefkat eden ve onları ödüllendiren Allah'ın ismi nedir?"
    },
    "updatedAt": "2026-09-08T14:12:03.688Z"
  },
  {
    "id": "def_IEYZkuHJ4QovQfzCb0rK_6",
    "type": "definition",
    "topicId": "IEYZkuHJ4QovQfzCb0rK",
    "unitId": "jjotqKbHyi504QHH40ko",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "term": "Besmele",
      "definition": "Bir işe başlarken Allah'ın adıyla başlamak için söylenen ifade."
    },
    "updatedAt": "2026-09-08T14:12:03.688Z"
  },
  {
    "id": "def_IEYZkuHJ4QovQfzCb0rK_7",
    "type": "definition",
    "topicId": "IEYZkuHJ4QovQfzCb0rK",
    "unitId": "jjotqKbHyi504QHH40ko",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "term": "Basîr",
      "definition": "Her şeyi gören Allah'ın ismi nedir?"
    },
    "updatedAt": "2026-09-08T14:12:03.688Z"
  },
  {
    "id": "def_IEYZkuHJ4QovQfzCb0rK_8",
    "type": "definition",
    "topicId": "IEYZkuHJ4QovQfzCb0rK",
    "unitId": "jjotqKbHyi504QHH40ko",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "term": "Âlim",
      "definition": "Gizli ve açık ne varsa her şeyi bilen Allah'ın ismi nedir?"
    },
    "updatedAt": "2026-09-08T14:12:03.688Z"
  },
  {
    "id": "sentence_IEYZkuHJ4QovQfzCb0rK_0",
    "type": "sentence",
    "topicId": "IEYZkuHJ4QovQfzCb0rK",
    "unitId": "jjotqKbHyi504QHH40ko",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "text": "Besmele, Rahman ve Rahîm isimlerini içerir ve günlük hayatta sıkça kullanılır."
    },
    "updatedAt": "2026-09-08T14:12:03.688Z"
  },
  {
    "id": "sentence_IEYZkuHJ4QovQfzCb0rK_1",
    "type": "sentence",
    "topicId": "IEYZkuHJ4QovQfzCb0rK",
    "unitId": "jjotqKbHyi504QHH40ko",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "text": "Allah’ın bilgisi olmadan ne bir yaprak düşer ne de yerin karanlıklarında bir tane saklı kalır."
    },
    "updatedAt": "2026-09-08T14:12:03.688Z"
  },
  {
    "id": "sentence_IEYZkuHJ4QovQfzCb0rK_2",
    "type": "sentence",
    "topicId": "IEYZkuHJ4QovQfzCb0rK",
    "unitId": "jjotqKbHyi504QHH40ko",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "text": "Allah'ın 99 güzel ismi vardır ve bunlara Esmâyıhüsnâ denir."
    },
    "updatedAt": "2026-09-08T14:12:03.688Z"
  },
  {
    "id": "sentence_IEYZkuHJ4QovQfzCb0rK_3",
    "type": "sentence",
    "topicId": "IEYZkuHJ4QovQfzCb0rK",
    "unitId": "jjotqKbHyi504QHH40ko",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "text": "Esmayıhüsna, Allah'ın gücünü, mükemmelliğini ve benzersizliğini anlatan isimlerdir."
    },
    "updatedAt": "2026-09-08T14:12:03.688Z"
  },
  {
    "id": "sentence_IEYZkuHJ4QovQfzCb0rK_4",
    "type": "sentence",
    "topicId": "IEYZkuHJ4QovQfzCb0rK",
    "unitId": "jjotqKbHyi504QHH40ko",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "text": "Allah'ın ilmi sonsuzdur."
    },
    "updatedAt": "2026-09-08T14:12:03.688Z"
  },
  {
    "id": "sentence_IEYZkuHJ4QovQfzCb0rK_5",
    "type": "sentence",
    "topicId": "IEYZkuHJ4QovQfzCb0rK",
    "unitId": "jjotqKbHyi504QHH40ko",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "text": "Rahman ve Rahîm, Allah'ın merhametini ifade eden isimlerdir."
    },
    "updatedAt": "2026-09-08T14:12:03.688Z"
  },
  {
    "id": "sentence_IEYZkuHJ4QovQfzCb0rK_6",
    "type": "sentence",
    "topicId": "IEYZkuHJ4QovQfzCb0rK",
    "unitId": "jjotqKbHyi504QHH40ko",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "text": "Allah, kendisinden başka ilah olmayandır. En güzel isimler O’na mahsustur."
    },
    "updatedAt": "2026-09-08T14:12:03.688Z"
  },
  {
    "id": "sentence_IEYZkuHJ4QovQfzCb0rK_7",
    "type": "sentence",
    "topicId": "IEYZkuHJ4QovQfzCb0rK",
    "unitId": "jjotqKbHyi504QHH40ko",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "text": "Kadir her şeye gücü yeter."
    },
    "updatedAt": "2026-09-08T14:12:03.688Z"
  },
  {
    "id": "sentence_IEYZkuHJ4QovQfzCb0rK_8",
    "type": "sentence",
    "topicId": "IEYZkuHJ4QovQfzCb0rK",
    "unitId": "jjotqKbHyi504QHH40ko",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "text": "Basir her şeyi görür."
    },
    "updatedAt": "2026-09-08T14:12:03.688Z"
  },
  {
    "id": "sentence_IEYZkuHJ4QovQfzCb0rK_9",
    "type": "sentence",
    "topicId": "IEYZkuHJ4QovQfzCb0rK",
    "unitId": "jjotqKbHyi504QHH40ko",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "text": "Göklerdeki her şeyi, yerdeki her şeyi de bilir. Allah her şeye hakkıyla gücü yetendir."
    },
    "updatedAt": "2026-09-08T14:12:03.688Z"
  },
  {
    "id": "sentence_IEYZkuHJ4QovQfzCb0rK_10",
    "type": "sentence",
    "topicId": "IEYZkuHJ4QovQfzCb0rK",
    "unitId": "jjotqKbHyi504QHH40ko",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "text": "Allah'ı güzel isimleriyle anmak ve O'na dua etmek önemlidir."
    },
    "updatedAt": "2026-09-08T14:12:03.688Z"
  },
  {
    "id": "sentence_IEYZkuHJ4QovQfzCb0rK_11",
    "type": "sentence",
    "topicId": "IEYZkuHJ4QovQfzCb0rK",
    "unitId": "jjotqKbHyi504QHH40ko",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "text": "Âlim her şeyi bilir."
    },
    "updatedAt": "2026-09-08T14:12:03.688Z"
  },
  {
    "id": "sentence_IEYZkuHJ4QovQfzCb0rK_12",
    "type": "sentence",
    "topicId": "IEYZkuHJ4QovQfzCb0rK",
    "unitId": "jjotqKbHyi504QHH40ko",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "text": "Semi her şeyi işitir."
    },
    "updatedAt": "2026-09-08T14:12:03.688Z"
  },
  {
    "id": "sentence_IEYZkuHJ4QovQfzCb0rK_13",
    "type": "sentence",
    "topicId": "IEYZkuHJ4QovQfzCb0rK",
    "unitId": "jjotqKbHyi504QHH40ko",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "text": "Allah'ın gücü sınırsızdır."
    },
    "updatedAt": "2026-09-08T14:12:03.688Z"
  },
  {
    "id": "sentence_IEYZkuHJ4QovQfzCb0rK_14",
    "type": "sentence",
    "topicId": "IEYZkuHJ4QovQfzCb0rK",
    "unitId": "jjotqKbHyi504QHH40ko",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "text": "Esmayıhüsna Allah'ı anlatır."
    },
    "updatedAt": "2026-09-08T14:12:03.688Z"
  },
  {
    "id": "sentence_IEYZkuHJ4QovQfzCb0rK_15",
    "type": "sentence",
    "topicId": "IEYZkuHJ4QovQfzCb0rK",
    "unitId": "jjotqKbHyi504QHH40ko",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "text": "Besmele Rahman ve Rahîm'dir."
    },
    "updatedAt": "2026-09-08T14:12:03.688Z"
  },
  {
    "id": "sentence_IEYZkuHJ4QovQfzCb0rK_16",
    "type": "sentence",
    "topicId": "IEYZkuHJ4QovQfzCb0rK",
    "unitId": "jjotqKbHyi504QHH40ko",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "text": "Rahman, Rahîm merhamettir."
    },
    "updatedAt": "2026-09-08T14:12:03.688Z"
  },
  {
    "id": "sentence_IEYZkuHJ4QovQfzCb0rK_17",
    "type": "sentence",
    "topicId": "IEYZkuHJ4QovQfzCb0rK",
    "unitId": "jjotqKbHyi504QHH40ko",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "text": "Allah'ın isimleri anlamlıdır."
    },
    "updatedAt": "2026-09-08T14:12:03.688Z"
  },
  {
    "id": "sentence_IEYZkuHJ4QovQfzCb0rK_18",
    "type": "sentence",
    "topicId": "IEYZkuHJ4QovQfzCb0rK",
    "unitId": "jjotqKbHyi504QHH40ko",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "text": "Âlim, Allah'ın her şeyi bildiğini, Basîr her şeyi gördüğünü, Semî' ise her şeyi işittiğini ifade eder."
    },
    "updatedAt": "2026-09-08T14:12:03.688Z"
  },
  {
    "id": "sentence_IEYZkuHJ4QovQfzCb0rK_19",
    "type": "sentence",
    "topicId": "IEYZkuHJ4QovQfzCb0rK",
    "unitId": "jjotqKbHyi504QHH40ko",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "text": "En güzel isimler Allah’ındır, bu güzel isimlerle O’na dua edin."
    },
    "updatedAt": "2026-09-08T14:12:03.688Z"
  },
  {
    "id": "sentence_IEYZkuHJ4QovQfzCb0rK_20",
    "type": "sentence",
    "topicId": "IEYZkuHJ4QovQfzCb0rK",
    "unitId": "jjotqKbHyi504QHH40ko",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "text": "Yaratan bilmez olur mu? O, bütün inceliklerin farkındadır ve her şeyden haberdardır."
    },
    "updatedAt": "2026-09-08T14:12:03.688Z"
  },
  {
    "id": "sentence_IEYZkuHJ4QovQfzCb0rK_21",
    "type": "sentence",
    "topicId": "IEYZkuHJ4QovQfzCb0rK",
    "unitId": "jjotqKbHyi504QHH40ko",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "text": "Kadîr, Allah'ın her şeye gücünün yettiğini anlatır."
    },
    "updatedAt": "2026-09-08T14:12:03.688Z"
  }
]