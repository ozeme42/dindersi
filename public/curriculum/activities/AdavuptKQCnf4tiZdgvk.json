    "courseId": "jBx7iE5eK5eFQRvCU008",
    "content": {
      "definition": "Yüce Allah'ın peygamberi aracılığıyla bildirdiği esasları gönülden benimseme, doğrulama ve kesin bir şekilde inanma durumudur.",
      "term": "İman"
    },
    "type": "definition",
    "unitId": "VC0yE9BJBCwFETUtXPfH",
    "createdAt": {
      "type": "firestore/timestamp/1.0",
