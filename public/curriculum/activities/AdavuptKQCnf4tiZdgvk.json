    "id": "4HBYmXDJRAGD197SSqul",
    "content": {
      "text": "İman gönülden inanıp tasdik etmektir."
    },
    "type": "sentence",
    "courseId": "jBx7iE5eK5eFQRvCU008",
    "unitId": "VC0yE9BJBCwFETUtXPfH",
