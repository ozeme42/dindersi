    "unitId": "VC0yE9BJBCwFETUtXPfH"
  },
  {
    "id": "lycDK37KhKpHAmr2uf56",
    "unitId": "VC0yE9BJBCwFETUtXPfH",
    "content": {
      "text": "İslam imanın hayata yansıyan şeklidir."
