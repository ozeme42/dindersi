    "unitId": "VC0yE9BJBCwFETUtXPfH",
    "content": {
      "term": "Tevhid",
      "definition": "Allah'ın bir tek olduğuna, O'nun eşi, benzeri ve ortağı bulunmadığına inanmaktır."
    },
    "createdAt": {
      "type": "firestore/timestamp/1.0",
      "seconds": 1789210448,
      "nanoseconds": 323000000
    },
    "courseId": "jBx7iE5eK5eFQRvCU008"
