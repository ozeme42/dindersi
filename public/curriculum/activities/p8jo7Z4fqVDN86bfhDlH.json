  },
  {
    "id": "def_p8jo7Z4fqVDN86bfhDlH_0",
    "type": "definition",
    "topicId": "p8jo7Z4fqVDN86bfhDlH",
    "unitId": "cUF2X2vchdqDFkcWMNkj",
    "courseId": "OgnmTvY8rxVpEIP45iq4",
    "content": {
      "term": "Yetim",
      "definition": "Babası ölmüş olan çocuk"
    },
    "updatedAt": "2026-10-05T19:08:37.366Z"
  },
  {
    "id": "def_p8jo7Z4fqVDN86bfhDlH_1",
    "type": "definition",
    "topicId": "p8jo7Z4fqVDN86bfhDlH",
    "unitId": "cUF2X2vchdqDFkcWMNkj",
    "courseId": "OgnmTvY8rxVpEIP45iq4",
    "content": {
      "term": "Merhamet",
      "definition": "Bir insanı başka insanlar ve diğer canlıların sıkıntıları karşısında duyarlı olmaya ve yardım etmeye sevk eden acıma duygusu"
    },
    "updatedAt": "2026-10-05T19:08:37.366Z"
  },
  {
    "id": "def_p8jo7Z4fqVDN86bfhDlH_2",
    "type": "definition",
    "topicId": "p8jo7Z4fqVDN86bfhDlH",
    "unitId": "cUF2X2vchdqDFkcWMNkj",
    "courseId": "OgnmTvY8rxVpEIP45iq4",
    "content": {
      "term": "Ebu Umeyr (Kuş Babası)",
      "definition": "Peygamberimizin kuşu öldüğü için teselli etmeye gittiği çocuk sahabe."
    },
    "updatedAt": "2026-10-05T19:08:37.366Z"
  },
  {
    "id": "def_p8jo7Z4fqVDN86bfhDlH_3",
    "type": "definition",
    "topicId": "p8jo7Z4fqVDN86bfhDlH",
    "unitId": "cUF2X2vchdqDFkcWMNkj",
    "courseId": "OgnmTvY8rxVpEIP45iq4",
    "content": {
      "term": "Hürmet",
      "definition": "Bir kimseye, bir şeye karşı dikkatli, özenli, ölçülü davranmaya sebep olan sevgi duygusu"
    },
    "updatedAt": "2026-10-05T19:08:37.366Z"
  },
  {
    "id": "def_p8jo7Z4fqVDN86bfhDlH_4",
    "type": "definition",
    "topicId": "p8jo7Z4fqVDN86bfhDlH",
    "unitId": "cUF2X2vchdqDFkcWMNkj",
    "courseId": "OgnmTvY8rxVpEIP45iq4",
    "content": {
      "term": "Ümame",
      "definition": "Peygamberimizin torunu, kendisine hediye edilen kolyeyi taktığı kız çocuğu."
    },
    "updatedAt": "2026-10-05T19:08:37.366Z"
  },
  {
    "id": "def_p8jo7Z4fqVDN86bfhDlH_5",
    "type": "definition",
    "topicId": "p8jo7Z4fqVDN86bfhDlH",
    "unitId": "cUF2X2vchdqDFkcWMNkj",
    "courseId": "OgnmTvY8rxVpEIP45iq4",
    "content": {
      "term": "Adalet",
      "definition": "Hak ve hukuka uygun davranma, hakkı gözetme, herkese kendi hakkı olanı verme"
    },
    "updatedAt": "2026-10-05T19:08:37.366Z"
  },
  {
    "id": "def_p8jo7Z4fqVDN86bfhDlH_6",
    "type": "definition",
    "topicId": "p8jo7Z4fqVDN86bfhDlH",
    "unitId": "cUF2X2vchdqDFkcWMNkj",
    "courseId": "OgnmTvY8rxVpEIP45iq4",
    "content": {
      "term": "Muhabbet",
      "definition": "Bir insanı bir şeye veya bir kimseye karşı yakın ilgi ve bağlılık göstermeye yönelten duygu"
    },
    "updatedAt": "2026-10-05T19:08:37.366Z"
  },
  {
    "id": "def_p8jo7Z4fqVDN86bfhDlH_7",
    "type": "definition",
    "topicId": "p8jo7Z4fqVDN86bfhDlH",
    "unitId": "cUF2X2vchdqDFkcWMNkj",
    "courseId": "OgnmTvY8rxVpEIP45iq4",
    "content": {
      "term": "Tevazu",
      "definition": "İnsanın, kendisinin de yaratılmış olduğunu bilerek insanlara karşı büyüklük taslamaması, alçak gönüllü ve yumuşak huylu olması"
    },
    "updatedAt": "2026-10-05T19:08:37.366Z"
  },
  {
    "id": "def_p8jo7Z4fqVDN86bfhDlH_8",
    "type": "definition",
    "topicId": "p8jo7Z4fqVDN86bfhDlH",
    "unitId": "cUF2X2vchdqDFkcWMNkj",
    "courseId": "OgnmTvY8rxVpEIP45iq4",
    "content": {
      "term": "Ebu Mahzure",
      "definition": "Peygamberimizin sesini beğenip kendisine ezanı öğrettiği ve Mekke müezzini yaptığı çocuk."
    },
    "updatedAt": "2026-10-05T19:08:37.366Z"
  },
  {
    "id": "sentence_p8jo7Z4fqVDN86bfhDlH_0",
    "type": "sentence",
    "topicId": "p8jo7Z4fqVDN86bfhDlH",
    "unitId": "cUF2X2vchdqDFkcWMNkj",
    "courseId": "OgnmTvY8rxVpEIP45iq4",
    "content": {
      "text": "Çocuklara güzel terbiye verilmesini ve onlara şefkatle davranılmasını isterdi."
    },
    "updatedAt": "2026-10-05T19:08:37.366Z"
  },
  {
    "id": "sentence_p8jo7Z4fqVDN86bfhDlH_1",
    "type": "sentence",
    "topicId": "p8jo7Z4fqVDN86bfhDlH",
    "unitId": "cUF2X2vchdqDFkcWMNkj",
    "courseId": "OgnmTvY8rxVpEIP45iq4",
    "content": {
      "text": "Peygamberimiz, kız ve erkek çocukları arasında ayrım yapmazdı."
    },
    "updatedAt": "2026-10-05T19:08:37.366Z"
  },
  {
    "id": "sentence_p8jo7Z4fqVDN86bfhDlH_2",
    "type": "sentence",
    "topicId": "p8jo7Z4fqVDN86bfhDlH",
    "unitId": "cUF2X2vchdqDFkcWMNkj",
    "courseId": "OgnmTvY8rxVpEIP45iq4",
    "content": {
      "text": "İnancına bakmaksızın tüm çocuklara sevgisini gösterirdi."
    },
    "updatedAt": "2026-10-05T19:08:37.366Z"
  },
  {
    "id": "sentence_p8jo7Z4fqVDN86bfhDlH_3",
    "type": "sentence",
    "topicId": "p8jo7Z4fqVDN86bfhDlH",
    "unitId": "cUF2X2vchdqDFkcWMNkj",
    "courseId": "OgnmTvY8rxVpEIP45iq4",
    "content": {
      "text": "Çocuklar Peygamberimizi çok sever ve onun mescidinde toplanırlardı."
    },
    "updatedAt": "2026-10-05T19:08:37.366Z"
  },
  {
    "id": "sentence_p8jo7Z4fqVDN86bfhDlH_4",
    "type": "sentence",
    "topicId": "p8jo7Z4fqVDN86bfhDlH",
    "unitId": "cUF2X2vchdqDFkcWMNkj",
    "courseId": "OgnmTvY8rxVpEIP45iq4",
    "content": {
      "text": "Yetimlerin ve kadınların korunmasını önemserdi."
    },
    "updatedAt": "2026-10-05T19:08:37.366Z"
  },
  {
    "id": "sentence_p8jo7Z4fqVDN86bfhDlH_5",
    "type": "sentence",
    "topicId": "p8jo7Z4fqVDN86bfhDlH",
    "unitId": "cUF2X2vchdqDFkcWMNkj",
    "courseId": "OgnmTvY8rxVpEIP45iq4",
    "content": {
      "text": "Hz. Muhammed (sav) çocuklara sevgi ve merhametle yaklaşırdı."
    },
    "updatedAt": "2026-10-05T19:08:37.366Z"
  },
  {
    "id": "sentence_p8jo7Z4fqVDN86bfhDlH_6",
    "type": "sentence",
    "topicId": "p8jo7Z4fqVDN86bfhDlH",
    "unitId": "cUF2X2vchdqDFkcWMNkj",
    "courseId": "OgnmTvY8rxVpEIP45iq4",
    "content": {
      "text": "Peygamberimiz çocuklarla oyunlar oynar, onlara değer verirdi."
    },
    "updatedAt": "2026-10-05T19:08:37.366Z"
  },
  {
    "id": "sentence_p8jo7Z4fqVDN86bfhDlH_7",
    "type": "sentence",
    "topicId": "p8jo7Z4fqVDN86bfhDlH",
    "unitId": "cUF2X2vchdqDFkcWMNkj",
    "courseId": "OgnmTvY8rxVpEIP45iq4",
    "content": {
      "text": "Peygamberimiz çocuklara nasihatte bulunur, onlara iyi davranışlar öğretirdi."
    },
    "updatedAt": "2026-10-05T19:08:37.366Z"
  },
  {
    "id": "sentence_p8jo7Z4fqVDN86bfhDlH_8",
    "type": "sentence",
    "topicId": "p8jo7Z4fqVDN86bfhDlH",
    "unitId": "cUF2X2vchdqDFkcWMNkj",
    "courseId": "OgnmTvY8rxVpEIP45iq4",
    "content": {
      "text": "Peygamberimiz, çocukların mescide gelmelerine ve sohbetlere katılmalarına izin verirdi."
    },
    "updatedAt": "2026-10-05T19:08:37.366Z"
  },
  {
    "id": "sentence_p8jo7Z4fqVDN86bfhDlH_9",
    "type": "sentence",
    "topicId": "p8jo7Z4fqVDN86bfhDlH",
    "unitId": "cUF2X2vchdqDFkcWMNkj",
    "courseId": "OgnmTvY8rxVpEIP45iq4",
    "content": {
      "text": "Hz. Muhammed, çocuklara karşı anlayışlı ve hoşgörülüydü."
    },
    "updatedAt": "2026-10-05T19:08:37.366Z"
  }
]