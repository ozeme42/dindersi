  {
    "id": "def_iMXvYZESmR3700GLvsuj_0",
    "type": "definition",
    "topicId": "iMXvYZESmR3700GLvsuj",
    "unitId": "14Ox2maDLwQIYSUE3qmd",
    "courseId": "134DwgMfh8VYogm3gDyh",
    "content": {
      "term": "Gayb",
      "definition": "Duyu organları veya teknolojik araçlarla algılanamayan, hakkında yalnızca ilahi kaynaklardan bilgi edinilebilen gizli âlem ve gelecek zaman."
    },
    "updatedAt": "2026-09-16T18:36:39.758Z"
  },
  {
    "id": "def_iMXvYZESmR3700GLvsuj_1",
    "type": "definition",
    "topicId": "iMXvYZESmR3700GLvsuj",
    "unitId": "14Ox2maDLwQIYSUE3qmd",
    "courseId": "134DwgMfh8VYogm3gDyh",
    "content": {
      "term": "Melek",
      "definition": "Nurdan yaratılmış, yeme içme gibi insani ihtiyaçları olmayan, Allah'ın emirlerine eksiksiz itaat eden gözle görülmeyen varlık."
    },
    "updatedAt": "2026-09-16T18:36:39.758Z"
  },
  {
    "id": "def_iMXvYZESmR3700GLvsuj_2",
    "type": "definition",
    "topicId": "iMXvYZESmR3700GLvsuj",
    "unitId": "14Ox2maDLwQIYSUE3qmd",
    "courseId": "134DwgMfh8VYogm3gDyh",
    "content": {
      "term": "Cin",
      "definition": "Yalın ateşten yaratılmış, insanlar gibi Allah'a kulluk etmekle sorumlu, inananı ve inkâr edeni bulunan görünmez varlık."
    },
    "updatedAt": "2026-09-16T18:36:39.758Z"
  },
  {
    "id": "def_iMXvYZESmR3700GLvsuj_3",
    "type": "definition",
    "topicId": "iMXvYZESmR3700GLvsuj",
    "unitId": "14Ox2maDLwQIYSUE3qmd",
    "courseId": "134DwgMfh8VYogm3gDyh",
    "content": {
      "term": "Cebrail",
      "definition": "Allah'ın emir ve yasaklarını peygamberlere bildirmekle görevli olan vahiy getiren elçi."
    },
    "updatedAt": "2026-09-16T18:36:39.758Z"
  },
  {
    "id": "def_iMXvYZESmR3700GLvsuj_4",
    "type": "definition",
    "topicId": "iMXvYZESmR3700GLvsuj",
    "unitId": "14Ox2maDLwQIYSUE3qmd",
    "courseId": "134DwgMfh8VYogm3gDyh",
    "content": {
      "term": "Azrail",
      "definition": "Eceli gelen canlıların ruhunu teslim almakla görevli olan ölüm elçisi."
    },
    "updatedAt": "2026-09-16T18:36:39.758Z"
  },
  {
    "id": "def_iMXvYZESmR3700GLvsuj_5",
    "type": "definition",
    "topicId": "iMXvYZESmR3700GLvsuj",
    "unitId": "14Ox2maDLwQIYSUE3qmd",
    "courseId": "134DwgMfh8VYogm3gDyh",
    "content": {
      "term": "Mikâil",
      "definition": "Rızıkların dağıtılması, yağmur yağması ve tabiat olaylarının düzenlenmesiyle görevlendirilen varlık."
    },
    "updatedAt": "2026-09-16T18:36:39.758Z"
  },
  {
    "id": "def_iMXvYZESmR3700GLvsuj_6",
    "type": "definition",
    "topicId": "iMXvYZESmR3700GLvsuj",
    "unitId": "14Ox2maDLwQIYSUE3qmd",
    "courseId": "134DwgMfh8VYogm3gDyh",
    "content": {
      "term": "İsrafil",
      "definition": "Kıyametin kopması ve yeniden diriliş esnasında özel bir boruya üflemekle görevli olan varlık."
    },
    "updatedAt": "2026-09-16T18:36:39.758Z"
  },
  {
    "id": "def_iMXvYZESmR3700GLvsuj_7",
    "type": "definition",
    "topicId": "iMXvYZESmR3700GLvsuj",
    "unitId": "14Ox2maDLwQIYSUE3qmd",
    "courseId": "134DwgMfh8VYogm3gDyh",
    "content": {
      "term": "Kirâmen Kâtibîn",
      "definition": "İnsanın sağında ve solunda bulunarak onun yaptığı iyi ve kötü tüm davranışları amel defterine kaydeden yazıcılar."
    },
    "updatedAt": "2026-09-16T18:36:39.758Z"
  },
  {
    "id": "def_iMXvYZESmR3700GLvsuj_8",
    "type": "definition",
    "topicId": "iMXvYZESmR3700GLvsuj",
    "unitId": "14Ox2maDLwQIYSUE3qmd",
    "courseId": "134DwgMfh8VYogm3gDyh",
    "content": {
      "term": "Münker ve Nekir",
      "definition": "Ölümden sonra kabirde insanları iman ve amellerinden sorguya çekmekle görevli olan sorgu görevlileri."
    },
    "updatedAt": "2026-09-16T18:36:39.758Z"
  },
  {
    "id": "def_iMXvYZESmR3700GLvsuj_9",
    "type": "definition",
    "topicId": "iMXvYZESmR3700GLvsuj",
    "unitId": "14Ox2maDLwQIYSUE3qmd",
    "courseId": "134DwgMfh8VYogm3gDyh",
    "content": {
      "term": "Şeytan",
      "definition": "Kibri yüzünden Allah'ın emrine isyan edip cennetten kovulan ve insanları kötülüğe yöneltmeye çalışan varlık."
    },
    "updatedAt": "2026-09-16T18:36:39.758Z"
  },
  {
    "id": "sentence_iMXvYZESmR3700GLvsuj_0",
    "type": "sentence",
    "topicId": "iMXvYZESmR3700GLvsuj",
    "unitId": "14Ox2maDLwQIYSUE3qmd",
    "courseId": "134DwgMfh8VYogm3gDyh",
    "content": {
      "text": "Melekler nurdan yaratılmış gözle görülmeyen varlıklardır."
    },
    "updatedAt": "2026-09-16T18:36:39.758Z"
  },
  {
    "id": "sentence_iMXvYZESmR3700GLvsuj_1",
    "type": "sentence",
    "topicId": "iMXvYZESmR3700GLvsuj",
    "unitId": "14Ox2maDLwQIYSUE3qmd",
    "courseId": "134DwgMfh8VYogm3gDyh",
    "content": {
      "text": "Gaybın bilgisini yalnızca Yüce Allah bilir."
    },
    "updatedAt": "2026-09-16T18:36:39.758Z"
  },
  {
    "id": "sentence_iMXvYZESmR3700GLvsuj_2",
    "type": "sentence",
    "topicId": "iMXvYZESmR3700GLvsuj",
    "unitId": "14Ox2maDLwQIYSUE3qmd",
    "courseId": "134DwgMfh8VYogm3gDyh",
    "content": {
      "text": "Cebrail peygamberlere vahiy getirmekle görevli melektir."
    },
    "updatedAt": "2026-09-16T18:36:39.758Z"
  },
  {
    "id": "sentence_iMXvYZESmR3700GLvsuj_3",
    "type": "sentence",
    "topicId": "iMXvYZESmR3700GLvsuj",
    "unitId": "14Ox2maDLwQIYSUE3qmd",
    "courseId": "134DwgMfh8VYogm3gDyh",
    "content": {
      "text": "İnsanın tüm davranışları amel defterine yazılır."
    },
    "updatedAt": "2026-09-16T18:36:39.758Z"
  },
  {
    "id": "sentence_iMXvYZESmR3700GLvsuj_4",
    "type": "sentence",
    "topicId": "iMXvYZESmR3700GLvsuj",
    "unitId": "14Ox2maDLwQIYSUE3qmd",
    "courseId": "134DwgMfh8VYogm3gDyh",
    "content": {
      "text": "Cinler de insanlar gibi ibadetle yükümlüdür."
    },
    "updatedAt": "2026-09-16T18:36:39.758Z"
  },
  {
    "id": "sentence_iMXvYZESmR3700GLvsuj_5",
    "type": "sentence",
    "topicId": "iMXvYZESmR3700GLvsuj",
    "unitId": "14Ox2maDLwQIYSUE3qmd",
    "courseId": "134DwgMfh8VYogm3gDyh",
    "content": {
      "text": "Şeytan kibri yüzünden Allah'ın emrine karşı gelmiştir."
    },
    "updatedAt": "2026-09-16T18:36:39.758Z"
  },
  {
    "id": "sentence_iMXvYZESmR3700GLvsuj_6",
    "type": "sentence",
    "topicId": "iMXvYZESmR3700GLvsuj",
    "unitId": "14Ox2maDLwQIYSUE3qmd",
    "courseId": "134DwgMfh8VYogm3gDyh",
    "content": {
      "text": "Mikail doğa olaylarını idare etmekle görevlidir."
    },
    "updatedAt": "2026-09-16T18:36:39.758Z"
  },
  {
    "id": "sentence_iMXvYZESmR3700GLvsuj_7",
    "type": "sentence",
    "topicId": "iMXvYZESmR3700GLvsuj",
    "unitId": "14Ox2maDLwQIYSUE3qmd",
    "courseId": "134DwgMfh8VYogm3gDyh",
    "content": {
      "text": "İsrafil kıyamet günü sûra üflemekle görevlidir."
    },
    "updatedAt": "2026-09-16T18:36:39.758Z"
  },
  {
    "id": "sentence_iMXvYZESmR3700GLvsuj_8",
    "type": "sentence",
    "topicId": "iMXvYZESmR3700GLvsuj",
    "unitId": "14Ox2maDLwQIYSUE3qmd",
    "courseId": "134DwgMfh8VYogm3gDyh",
    "content": {
      "text": "Kabirdeki insanları Münker ve Nekir sorgular."
    },
    "updatedAt": "2026-09-16T18:36:39.758Z"
  },
  {
    "id": "sentence_iMXvYZESmR3700GLvsuj_9",
    "type": "sentence",
    "topicId": "iMXvYZESmR3700GLvsuj",
    "unitId": "14Ox2maDLwQIYSUE3qmd",
    "courseId": "134DwgMfh8VYogm3gDyh",
    "content": {
      "text": "Hz. Âdem topraktan yaratılan ilk insandır."
    },
    "updatedAt": "2026-09-16T18:36:39.758Z"
  }
]