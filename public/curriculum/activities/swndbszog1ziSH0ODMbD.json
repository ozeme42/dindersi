  {
    "id": "def_swndbszog1ziSH0ODMbD_0",
    "type": "definition",
    "topicId": "swndbszog1ziSH0ODMbD",
    "unitId": "jjotqKbHyi504QHH40ko",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "term": "Tevhit",
      "definition": "Allah'ın bir ve tek olduğuna, eşi ve benzerinin olmadığına inanmak"
    },
    "updatedAt": "2026-09-19T11:00:25.870Z"
  },
  {
    "id": "def_swndbszog1ziSH0ODMbD_1",
    "type": "definition",
    "topicId": "swndbszog1ziSH0ODMbD",
    "unitId": "jjotqKbHyi504QHH40ko",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "term": "Kâinat",
      "definition": "Allah'ın yarattığı tüm varlıkların ve olayların tamamı"
    },
    "updatedAt": "2026-09-19T11:00:25.870Z"
  },
  {
    "id": "def_swndbszog1ziSH0ODMbD_2",
    "type": "definition",
    "topicId": "swndbszog1ziSH0ODMbD",
    "unitId": "jjotqKbHyi504QHH40ko",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "term": "Kur'an-ı Kerim",
      "definition": "Allah'ın sözlerini içeren kutsal kitap"
    },
    "updatedAt": "2026-09-19T11:00:25.870Z"
  },
  {
    "id": "def_swndbszog1ziSH0ODMbD_3",
    "type": "definition",
    "topicId": "swndbszog1ziSH0ODMbD",
    "unitId": "jjotqKbHyi504QHH40ko",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "term": "İbadet",
      "definition": "Hiçbir şeyi ortak koşmadan sadece Allah için yapılan kulluk görevi."
    },
    "updatedAt": "2026-09-19T11:00:25.870Z"
  },
  {
    "id": "def_swndbszog1ziSH0ODMbD_4",
    "type": "definition",
    "topicId": "swndbszog1ziSH0ODMbD",
    "unitId": "jjotqKbHyi504QHH40ko",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "term": "Ahenk",
      "definition": "Gezegenlerden canlılara kadar her şeyin uyum içinde olması."
    },
    "updatedAt": "2026-09-19T11:00:25.870Z"
  },
  {
    "id": "def_swndbszog1ziSH0ODMbD_5",
    "type": "definition",
    "topicId": "swndbszog1ziSH0ODMbD",
    "unitId": "jjotqKbHyi504QHH40ko",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "term": "Peygamber",
      "definition": "Allah tarafından insanlara dini tebliğ etmek için gönderilen elçi."
    },
    "updatedAt": "2026-09-19T11:00:25.870Z"
  },
  {
    "id": "def_swndbszog1ziSH0ODMbD_6",
    "type": "definition",
    "topicId": "swndbszog1ziSH0ODMbD",
    "unitId": "jjotqKbHyi504QHH40ko",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "term": "Yaratma",
      "definition": "Bir şeyi örneksiz ve yoktan var etmek; sadece Allah’a ait özellik."
    },
    "updatedAt": "2026-09-19T11:00:25.870Z"
  },
  {
    "id": "def_swndbszog1ziSH0ODMbD_7",
    "type": "definition",
    "topicId": "swndbszog1ziSH0ODMbD",
    "unitId": "jjotqKbHyi504QHH40ko",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "term": "Şirk",
      "definition": "Allah'a inanmakla birlikte başka varlıkları da tanrı kabul etmek"
    },
    "updatedAt": "2026-09-19T11:00:25.870Z"
  },
  {
    "id": "def_swndbszog1ziSH0ODMbD_8",
    "type": "definition",
    "topicId": "swndbszog1ziSH0ODMbD",
    "unitId": "jjotqKbHyi504QHH40ko",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "term": "Dua",
      "definition": "Allah'a istek ve dileklerimizi iletmek için yaptığımız yalvarış."
    },
    "updatedAt": "2026-09-19T11:00:25.870Z"
  },
  {
    "id": "def_swndbszog1ziSH0ODMbD_9",
    "type": "definition",
    "topicId": "swndbszog1ziSH0ODMbD",
    "unitId": "jjotqKbHyi504QHH40ko",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "term": "Akıl",
      "definition": "İnsanı diğer varlıklardan ayıran, düşünmesini ve sorumluluk almasını sağlayan yetenek."
    },
    "updatedAt": "2026-09-19T11:00:25.870Z"
  },
  {
    "id": "def_swndbszog1ziSH0ODMbD_10",
    "type": "definition",
    "topicId": "swndbszog1ziSH0ODMbD",
    "unitId": "jjotqKbHyi504QHH40ko",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "term": "(cc)",
      "definition": "\"Yüceler Yücesi\""
    },
    "updatedAt": "2026-09-19T11:00:25.870Z"
  },
  {
    "id": "def_swndbszog1ziSH0ODMbD_11",
    "type": "definition",
    "topicId": "swndbszog1ziSH0ODMbD",
    "unitId": "jjotqKbHyi504QHH40ko",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "term": "Allah",
      "definition": "Evrendeki her şeyin yaratıcısı ve sahibi"
    },
    "updatedAt": "2026-09-19T11:00:25.870Z"
  },
  {
    "id": "def_swndbszog1ziSH0ODMbD_12",
    "type": "definition",
    "topicId": "swndbszog1ziSH0ODMbD",
    "unitId": "jjotqKbHyi504QHH40ko",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "term": "Celle Celâluhû (cc)",
      "definition": "Yüceler yücesi anlamına gelen saygı ifadesi."
    },
    "updatedAt": "2026-09-19T11:00:25.870Z"
  },
  {
    "id": "sentence_swndbszog1ziSH0ODMbD_0",
    "type": "sentence",
    "topicId": "swndbszog1ziSH0ODMbD",
    "unitId": "jjotqKbHyi504QHH40ko",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "text": "Rahman olan Allah’ın yaratışında hiçbir uygunsuzluk göremezsin. Gözünü çevir de bir bak, bir bozukluk görebiliyor musun?"
    },
    "updatedAt": "2026-09-19T11:00:25.870Z"
  },
  {
    "id": "sentence_swndbszog1ziSH0ODMbD_1",
    "type": "sentence",
    "topicId": "swndbszog1ziSH0ODMbD",
    "unitId": "jjotqKbHyi504QHH40ko",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "text": "O, gökleri ve yeri örneksiz yaratandır. Bir işe hükmetti mi ona sadece ‘Ol!’ der, o da hemen oluverir."
    },
    "updatedAt": "2026-09-19T11:00:25.870Z"
  },
  {
    "id": "sentence_swndbszog1ziSH0ODMbD_2",
    "type": "sentence",
    "topicId": "swndbszog1ziSH0ODMbD",
    "unitId": "jjotqKbHyi504QHH40ko",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "text": "Kur'an-ı Kerim, Allah'ın kelamıdır ve evrendeki düzene dikkat çeker."
    },
    "updatedAt": "2026-09-19T11:00:25.870Z"
  },
  {
    "id": "sentence_swndbszog1ziSH0ODMbD_3",
    "type": "sentence",
    "topicId": "swndbszog1ziSH0ODMbD",
    "unitId": "jjotqKbHyi504QHH40ko",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "text": "Tevhit, Allah'ın birliğine inanmak ve O'na hiçbir şeyi ortak koşmamaktır."
    },
    "updatedAt": "2026-09-19T11:00:25.870Z"
  },
  {
    "id": "sentence_swndbszog1ziSH0ODMbD_4",
    "type": "sentence",
    "topicId": "swndbszog1ziSH0ODMbD",
    "unitId": "jjotqKbHyi504QHH40ko",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "text": "O, yaratıp şekillendiren, ahenk veren ve düzene koyandır."
    },
    "updatedAt": "2026-09-19T11:00:25.870Z"
  },
  {
    "id": "sentence_swndbszog1ziSH0ODMbD_5",
    "type": "sentence",
    "topicId": "swndbszog1ziSH0ODMbD",
    "unitId": "jjotqKbHyi504QHH40ko",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "text": "Evrendeki mükemmel düzen, Allah'ın varlığına ve birliğine işaret eder."
    },
    "updatedAt": "2026-09-19T11:00:25.870Z"
  },
  {
    "id": "sentence_swndbszog1ziSH0ODMbD_6",
    "type": "sentence",
    "topicId": "swndbszog1ziSH0ODMbD",
    "unitId": "jjotqKbHyi504QHH40ko",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "text": "İnsan, akıl sahibi bir varlık olarak yaratılmıştır ve yeryüzünde sorumlulukları vardır."
    },
    "updatedAt": "2026-09-19T11:00:25.870Z"
  },
  {
    "id": "sentence_swndbszog1ziSH0ODMbD_7",
    "type": "sentence",
    "topicId": "swndbszog1ziSH0ODMbD",
    "unitId": "jjotqKbHyi504QHH40ko",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "text": "Şirk, Allah'a ortak koşmaktır ve İslam'da en büyük günahtır."
    },
    "updatedAt": "2026-09-19T11:00:25.870Z"
  },
  {
    "id": "sentence_swndbszog1ziSH0ODMbD_8",
    "type": "sentence",
    "topicId": "swndbszog1ziSH0ODMbD",
    "unitId": "jjotqKbHyi504QHH40ko",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "text": "Evrendeki birlik ve düzen, yalnızca bir ve tek olan Allah'ın eseridir."
    },
    "updatedAt": "2026-09-19T11:00:25.870Z"
  },
  {
    "id": "sentence_swndbszog1ziSH0ODMbD_9",
    "type": "sentence",
    "topicId": "swndbszog1ziSH0ODMbD",
    "unitId": "jjotqKbHyi504QHH40ko",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "text": "Gerçekten biz, her şeyi bir ölçü ve dengede yarattık."
    },
    "updatedAt": "2026-09-19T11:00:25.870Z"
  },
  {
    "id": "sentence_swndbszog1ziSH0ODMbD_10",
    "type": "sentence",
    "topicId": "swndbszog1ziSH0ODMbD",
    "unitId": "jjotqKbHyi504QHH40ko",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "text": "Her şeyin yaratıcısı Allah'tır ve O'nun eşi ve benzeri yoktur."
    },
    "updatedAt": "2026-09-19T11:00:25.870Z"
  },
  {
    "id": "sentence_swndbszog1ziSH0ODMbD_11",
    "type": "sentence",
    "topicId": "swndbszog1ziSH0ODMbD",
    "unitId": "jjotqKbHyi504QHH40ko",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "text": "İnsan vücudu, yaratılışın mükemmelliğini gösteren en güzel örneklerden biridir."
    },
    "updatedAt": "2026-09-19T11:00:25.870Z"
  },
  {
    "id": "sentence_swndbszog1ziSH0ODMbD_12",
    "type": "sentence",
    "topicId": "swndbszog1ziSH0ODMbD",
    "unitId": "jjotqKbHyi504QHH40ko",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "text": "Gece ve gündüz, mevsimler, canlıların özellikleri gibi her şey Allah'ın yaratma sanatının örnekleridir."
    },
    "updatedAt": "2026-09-19T11:00:25.870Z"
  },
  {
    "id": "sentence_swndbszog1ziSH0ODMbD_13",
    "type": "sentence",
    "topicId": "swndbszog1ziSH0ODMbD",
    "unitId": "jjotqKbHyi504QHH40ko",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "text": "Allah, her varlığa bulunduğu ortamda yaşamını sürdürebilecek özellikler vermiştir."
    },
    "updatedAt": "2026-09-19T11:00:25.870Z"
  }
]