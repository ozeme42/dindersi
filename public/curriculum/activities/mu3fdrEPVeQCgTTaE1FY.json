    "content": {
      "term": "Dua",
      "definition": "İstekleri doğrudan Rabbine ulaştırmaktır."
    },
    "updatedAt": "2026-10-05T18:54:09.243Z"
  },
  {
    "id": "def_mu3fdrEPVeQCgTTaE1FY_1",
    "type": "definition",
    "topicId": "mu3fdrEPVeQCgTTaE1FY",
    "unitId": "vjkkjfl8lYIiW2miv1RF",
