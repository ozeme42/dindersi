    "content": {
      "term": "Abdest",
      "definition": "İbadet öncesi yapılan maddi ve manevi temizliktir."
    },
    "updatedAt": "2026-10-05T18:54:09.243Z"
  },
  {
    "id": "def_mu3fdrEPVeQCgTTaE1FY_2",
    "type": "definition",
    "topicId": "mu3fdrEPVeQCgTTaE1FY",
    "unitId": "vjkkjfl8lYIiW2miv1RF",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "term": "Cami",
      "definition": "Müslümanların toplu ibadet edip kaynaştığı mekandır."
    },
    "updatedAt": "2026-10-05T18:54:09.243Z"
  },
  {
    "id": "def_mu3fdrEPVeQCgTTaE1FY_3",
    "type": "definition",
    "topicId": "mu3fdrEPVeQCgTTaE1FY",
    "unitId": "vjkkjfl8lYIiW2miv1RF",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "term": "Namaz",
      "definition": "Günde beş kez Yüce Allah'ın huzuruna çıkmaktır."
    },
    "updatedAt": "2026-10-05T18:54:09.243Z"
  },
  {
    "id": "def_mu3fdrEPVeQCgTTaE1FY_4",
    "type": "definition",
    "topicId": "mu3fdrEPVeQCgTTaE1FY",
    "unitId": "vjkkjfl8lYIiW2miv1RF",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "term": "Şükür",
      "definition": "Nimetlere karşılık Rabbine minnet duymaktır."
    },
    "updatedAt": "2026-10-05T18:54:09.243Z"
  },
  {
    "id": "def_mu3fdrEPVeQCgTTaE1FY_5",
    "type": "definition",
    "topicId": "mu3fdrEPVeQCgTTaE1FY",
    "unitId": "vjkkjfl8lYIiW2miv1RF",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "term": "Secde",
      "definition": "Kulun Rabbine en yakın olduğu andır."
    },
    "updatedAt": "2026-10-05T18:54:09.243Z"
  },
  {
    "id": "sentence_mu3fdrEPVeQCgTTaE1FY_0",
    "type": "sentence",
    "topicId": "mu3fdrEPVeQCgTTaE1FY",
    "unitId": "vjkkjfl8lYIiW2miv1RF",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "text": "Namaz insanı kötülüklerden alıkoyar."
    },
    "updatedAt": "2026-10-05T18:54:09.243Z"
  },
  {
    "id": "sentence_mu3fdrEPVeQCgTTaE1FY_1",
    "type": "sentence",
    "topicId": "mu3fdrEPVeQCgTTaE1FY",
    "unitId": "vjkkjfl8lYIiW2miv1RF",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "text": "Namaz, ırk ayrımlarını ortadan kaldırır."
    },
    "updatedAt": "2026-10-05T18:54:09.243Z"
  },
  {
    "id": "sentence_mu3fdrEPVeQCgTTaE1FY_2",
    "type": "sentence",
    "topicId": "mu3fdrEPVeQCgTTaE1FY",
    "unitId": "vjkkjfl8lYIiW2miv1RF",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "text": "Namaz Allah ile doğrudan iletişimdir."
    },
    "updatedAt": "2026-10-05T18:54:09.243Z"
  },
  {
    "id": "sentence_mu3fdrEPVeQCgTTaE1FY_3",
    "type": "sentence",
    "topicId": "mu3fdrEPVeQCgTTaE1FY",
    "unitId": "vjkkjfl8lYIiW2miv1RF",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "text": "Camiler Müslümanları birleştirir, kaynaştırır."
    },
    "updatedAt": "2026-10-05T18:54:09.243Z"
  },
  {
    "id": "sentence_mu3fdrEPVeQCgTTaE1FY_4",
    "type": "sentence",
    "topicId": "mu3fdrEPVeQCgTTaE1FY",
    "unitId": "vjkkjfl8lYIiW2miv1RF",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "text": "Namaz huzur ve sabır verir."
    },
    "updatedAt": "2026-10-05T18:54:09.243Z"
  },
  {
    "id": "sentence_mu3fdrEPVeQCgTTaE1FY_5",
    "type": "sentence",
    "topicId": "mu3fdrEPVeQCgTTaE1FY",
    "unitId": "vjkkjfl8lYIiW2miv1RF",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "text": "Namaz günahları siler, sevap kazandırır."
    },
    "updatedAt": "2026-10-05T18:54:09.243Z"
  },
  {
    "id": "sentence_mu3fdrEPVeQCgTTaE1FY_6",
    "type": "sentence",
    "topicId": "mu3fdrEPVeQCgTTaE1FY",
    "unitId": "vjkkjfl8lYIiW2miv1RF",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "text": "Namaz disiplinli yaşamayı öğretir."
    },
    "updatedAt": "2026-10-05T18:54:09.243Z"
  },
  {
    "id": "sentence_mu3fdrEPVeQCgTTaE1FY_7",
    "type": "sentence",
    "topicId": "mu3fdrEPVeQCgTTaE1FY",
    "unitId": "vjkkjfl8lYIiW2miv1RF",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "text": "Namaz Allah'a yakınlaşma vesilesidir."
    },
    "updatedAt": "2026-10-05T18:54:09.243Z"
  },
  {
    "id": "sentence_mu3fdrEPVeQCgTTaE1FY_8",
    "type": "sentence",
    "topicId": "mu3fdrEPVeQCgTTaE1FY",
    "unitId": "vjkkjfl8lYIiW2miv1RF",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "text": "Abdest maddi ve manevi temizliktir."
    },
    "updatedAt": "2026-10-05T18:54:09.243Z"
  },
  {
    "id": "sentence_mu3fdrEPVeQCgTTaE1FY_9",
    "type": "sentence",
    "topicId": "mu3fdrEPVeQCgTTaE1FY",
    "unitId": "vjkkjfl8lYIiW2miv1RF",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "text": "Namaz kulluk bilincini canlı tutar."
    },
    "updatedAt": "2026-10-05T18:54:09.243Z"
  }
]