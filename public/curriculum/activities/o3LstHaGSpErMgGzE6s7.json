  {
    "id": "def_o3LstHaGSpErMgGzE6s7_0",
    "type": "definition",
    "topicId": "o3LstHaGSpErMgGzE6s7",
    "unitId": "jjotqKbHyi504QHH40ko",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "term": "Samed",
      "definition": "Yüce Allah’ın hiçbir şeye muhtaç olmayıp bütün varlıkların kendisine\nmuhtaç olduğunu ifade eden güzel ismidir."
    },
    "updatedAt": "2026-09-26T10:06:48.833Z"
  },
  {
    "id": "def_o3LstHaGSpErMgGzE6s7_1",
    "type": "definition",
    "topicId": "o3LstHaGSpErMgGzE6s7",
    "unitId": "jjotqKbHyi504QHH40ko",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "term": "Rahim",
      "definition": "Allah'ın merhamet edici olduğunu ifade eden sıfatıdır."
    },
    "updatedAt": "2026-09-26T10:06:48.833Z"
  },
  {
    "id": "def_o3LstHaGSpErMgGzE6s7_2",
    "type": "definition",
    "topicId": "o3LstHaGSpErMgGzE6s7",
    "unitId": "jjotqKbHyi504QHH40ko",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "term": "Samimiyet",
      "definition": "Doğruluk, temizlik ve saflık anlamlarına gelir; iki yüzlülükten uzaktır."
    },
    "updatedAt": "2026-09-26T10:06:48.833Z"
  },
  {
    "id": "def_o3LstHaGSpErMgGzE6s7_3",
    "type": "definition",
    "topicId": "o3LstHaGSpErMgGzE6s7",
    "unitId": "jjotqKbHyi504QHH40ko",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "term": "Şirk",
      "definition": "Allah'a ortak koşmak anlamına gelir; İhlas suresi buna karşıdır."
    },
    "updatedAt": "2026-09-26T10:06:48.833Z"
  },
  {
    "id": "def_o3LstHaGSpErMgGzE6s7_4",
    "type": "definition",
    "topicId": "o3LstHaGSpErMgGzE6s7",
    "unitId": "jjotqKbHyi504QHH40ko",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "term": "İhlas",
      "definition": "Samimiyet, doğruluk, temizlik ve saflık demektir"
    },
    "updatedAt": "2026-09-26T10:06:48.833Z"
  },
  {
    "id": "def_o3LstHaGSpErMgGzE6s7_5",
    "type": "definition",
    "topicId": "o3LstHaGSpErMgGzE6s7",
    "unitId": "jjotqKbHyi504QHH40ko",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "term": "Tevhid",
      "definition": "Allah'ın birliğini vurgulayan temel İslam ilkesidir."
    },
    "updatedAt": "2026-09-26T10:06:48.833Z"
  },
  {
    "id": "def_o3LstHaGSpErMgGzE6s7_6",
    "type": "definition",
    "topicId": "o3LstHaGSpErMgGzE6s7",
    "unitId": "jjotqKbHyi504QHH40ko",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "term": "İhlas Suresi",
      "definition": "Kur'an-ı Kerim'de yer alan kısa bir suredir, samimiyeti vurgular."
    },
    "updatedAt": "2026-09-26T10:06:48.833Z"
  },
  {
    "id": "def_o3LstHaGSpErMgGzE6s7_7",
    "type": "definition",
    "topicId": "o3LstHaGSpErMgGzE6s7",
    "unitId": "jjotqKbHyi504QHH40ko",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "term": "Ehad",
      "definition": "Allah'ın bir ve tek olduğunu ifade eden isimdir."
    },
    "updatedAt": "2026-09-26T10:06:48.833Z"
  },
  {
    "id": "def_o3LstHaGSpErMgGzE6s7_8",
    "type": "definition",
    "topicId": "o3LstHaGSpErMgGzE6s7",
    "unitId": "jjotqKbHyi504QHH40ko",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "term": "Rahman",
      "definition": "Allah'ın merhametinin sonsuz olduğunu ifade eden sıfatıdır."
    },
    "updatedAt": "2026-09-26T10:06:48.833Z"
  },
  {
    "id": "sentence_o3LstHaGSpErMgGzE6s7_0",
    "type": "sentence",
    "topicId": "o3LstHaGSpErMgGzE6s7",
    "unitId": "jjotqKbHyi504QHH40ko",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "text": "İhlas, doğruluk ve saflıktır."
    },
    "updatedAt": "2026-09-26T10:06:48.833Z"
  },
  {
    "id": "sentence_o3LstHaGSpErMgGzE6s7_1",
    "type": "sentence",
    "topicId": "o3LstHaGSpErMgGzE6s7",
    "unitId": "jjotqKbHyi504QHH40ko",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "text": "İhlas suresi samimiyeti öğretir."
    },
    "updatedAt": "2026-09-26T10:06:48.833Z"
  },
  {
    "id": "sentence_o3LstHaGSpErMgGzE6s7_2",
    "type": "sentence",
    "topicId": "o3LstHaGSpErMgGzE6s7",
    "unitId": "jjotqKbHyi504QHH40ko",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "text": "Allah hiçbir şeye muhtaç değildir."
    },
    "updatedAt": "2026-09-26T10:06:48.834Z"
  },
  {
    "id": "sentence_o3LstHaGSpErMgGzE6s7_3",
    "type": "sentence",
    "topicId": "o3LstHaGSpErMgGzE6s7",
    "unitId": "jjotqKbHyi504QHH40ko",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "text": "Allah'ın dengi yoktur."
    },
    "updatedAt": "2026-09-26T10:06:48.834Z"
  },
  {
    "id": "sentence_o3LstHaGSpErMgGzE6s7_4",
    "type": "sentence",
    "topicId": "o3LstHaGSpErMgGzE6s7",
    "unitId": "jjotqKbHyi504QHH40ko",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "text": "Allah bir ve tektir."
    },
    "updatedAt": "2026-09-26T10:06:48.834Z"
  },
  {
    "id": "sentence_o3LstHaGSpErMgGzE6s7_5",
    "type": "sentence",
    "topicId": "o3LstHaGSpErMgGzE6s7",
    "unitId": "jjotqKbHyi504QHH40ko",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "text": "Her şey Allah'a muhtaçtır."
    },
    "updatedAt": "2026-09-26T10:06:48.834Z"
  }
]