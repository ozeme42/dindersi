  {
    "id": "def_2fA6SeR240eMZEKXr9Jh_0",
    "type": "definition",
    "topicId": "2fA6SeR240eMZEKXr9Jh",
    "unitId": "SxbbRsztz3FrWwzGVAoh",
    "courseId": "8dWTFfJd7fb2jTCVkXNb",
    "content": {
      "term": "Kur'an-ı Kerim",
      "definition": "Yüce Allah tarafından gönderilen ve günümüze kadar hiç değişmeden gelen ilahi kitaptır."
    },
    "updatedAt": "2026-09-19T11:14:00.962Z"
  },
  {
    "id": "def_2fA6SeR240eMZEKXr9Jh_1",
    "type": "definition",
    "topicId": "2fA6SeR240eMZEKXr9Jh",
    "unitId": "SxbbRsztz3FrWwzGVAoh",
    "courseId": "8dWTFfJd7fb2jTCVkXNb",
    "content": {
      "term": "İstiaze",
      "definition": "Her türlü kötülükten ve zarardan Yüce Allah'a sığınıp yalnızca O'ndan yardım istemektir."
    },
    "updatedAt": "2026-09-19T11:14:00.962Z"
  },
  {
    "id": "def_2fA6SeR240eMZEKXr9Jh_2",
    "type": "definition",
    "topicId": "2fA6SeR240eMZEKXr9Jh",
    "unitId": "SxbbRsztz3FrWwzGVAoh",
    "courseId": "8dWTFfJd7fb2jTCVkXNb",
    "content": {
      "term": "Besmele",
      "definition": "Rahman ve Rahim olan Allah'ın adıyla"
    },
    "updatedAt": "2026-09-19T11:14:00.962Z"
  },
  {
    "id": "def_2fA6SeR240eMZEKXr9Jh_3",
    "type": "definition",
    "topicId": "2fA6SeR240eMZEKXr9Jh",
    "unitId": "SxbbRsztz3FrWwzGVAoh",
    "courseId": "8dWTFfJd7fb2jTCVkXNb",
    "content": {
      "term": "Abdest",
      "definition": "Hem bedensel hem de manevi temizlik sağlayan ibadet hazırlığıdır."
    },
    "updatedAt": "2026-09-19T11:14:00.962Z"
  },
  {
    "id": "def_2fA6SeR240eMZEKXr9Jh_4",
    "type": "definition",
    "topicId": "2fA6SeR240eMZEKXr9Jh",
    "unitId": "SxbbRsztz3FrWwzGVAoh",
    "courseId": "8dWTFfJd7fb2jTCVkXNb",
    "content": {
      "term": "Eûzübesmele",
      "definition": "Kur'an-ı Kerim okumaya başlarken kovulmuş şeytandan Allah'a sığınma"
    },
    "updatedAt": "2026-09-19T11:14:00.962Z"
  },
  {
    "id": "def_2fA6SeR240eMZEKXr9Jh_5",
    "type": "definition",
    "topicId": "2fA6SeR240eMZEKXr9Jh",
    "unitId": "SxbbRsztz3FrWwzGVAoh",
    "courseId": "8dWTFfJd7fb2jTCVkXNb",
    "content": {
      "term": "Vahiy",
      "definition": "Yüce Allah'ın emir ve yasaklarını melek aracılığıyla peygamberlerine bildirmesidir."
    },
    "updatedAt": "2026-09-19T11:14:00.962Z"
  },
  {
    "id": "def_2fA6SeR240eMZEKXr9Jh_6",
    "type": "definition",
    "topicId": "2fA6SeR240eMZEKXr9Jh",
    "unitId": "SxbbRsztz3FrWwzGVAoh",
    "courseId": "8dWTFfJd7fb2jTCVkXNb",
    "content": {
      "term": "Şefaat",
      "definition": "Kıyamet gününde inananların bağışlanması için Allah katında bulunulacak yardım"
    },
    "updatedAt": "2026-09-19T11:14:00.962Z"
  },
  {
    "id": "def_2fA6SeR240eMZEKXr9Jh_7",
    "type": "definition",
    "topicId": "2fA6SeR240eMZEKXr9Jh",
    "unitId": "SxbbRsztz3FrWwzGVAoh",
    "courseId": "8dWTFfJd7fb2jTCVkXNb",
    "content": {
      "term": "Hareke",
      "definition": "Harflerin doğru okunmasını sağlayan üstün, esre ve ötre gibi sesli okuma işaretleridir."
    },
    "updatedAt": "2026-09-19T11:14:00.962Z"
  },
  {
    "id": "def_2fA6SeR240eMZEKXr9Jh_8",
    "type": "definition",
    "topicId": "2fA6SeR240eMZEKXr9Jh",
    "unitId": "SxbbRsztz3FrWwzGVAoh",
    "courseId": "8dWTFfJd7fb2jTCVkXNb",
    "content": {
      "term": "Dua",
      "definition": "İnsanın bütün benliğiyle Yüce Allah'a yönelerek isteklerini, arzularını ve şükranlarını O'na iletmesidir."
    },
    "updatedAt": "2026-09-19T11:14:00.962Z"
  },
  {
    "id": "def_2fA6SeR240eMZEKXr9Jh_9",
    "type": "definition",
    "topicId": "2fA6SeR240eMZEKXr9Jh",
    "unitId": "SxbbRsztz3FrWwzGVAoh",
    "courseId": "8dWTFfJd7fb2jTCVkXNb",
    "content": {
      "term": "İstiğfar",
      "definition": "İşlenen günah ve hatalardan dolayı Yüce Allah'tan bağışlanma dilemek ve af istemektir."
    },
    "updatedAt": "2026-09-19T11:14:00.962Z"
  },
  {
    "id": "sentence_2fA6SeR240eMZEKXr9Jh_0",
    "type": "sentence",
    "topicId": "2fA6SeR240eMZEKXr9Jh",
    "unitId": "SxbbRsztz3FrWwzGVAoh",
    "courseId": "8dWTFfJd7fb2jTCVkXNb",
    "content": {
      "text": "Kur'an okumaya eûzübesmele çekilerek başlanması gerekir."
    },
    "updatedAt": "2026-09-19T11:14:00.962Z"
  },
  {
    "id": "sentence_2fA6SeR240eMZEKXr9Jh_1",
    "type": "sentence",
    "topicId": "2fA6SeR240eMZEKXr9Jh",
    "unitId": "SxbbRsztz3FrWwzGVAoh",
    "courseId": "8dWTFfJd7fb2jTCVkXNb",
    "content": {
      "text": "En hayırlınız Kur'an'ı öğrenen ve öğretendir."
    },
    "updatedAt": "2026-09-19T11:14:00.962Z"
  },
  {
    "id": "sentence_2fA6SeR240eMZEKXr9Jh_2",
    "type": "sentence",
    "topicId": "2fA6SeR240eMZEKXr9Jh",
    "unitId": "SxbbRsztz3FrWwzGVAoh",
    "courseId": "8dWTFfJd7fb2jTCVkXNb",
    "content": {
      "text": "Kur'an okumak Müslümanlar için bir ibadettir."
    },
    "updatedAt": "2026-09-19T11:14:00.962Z"
  },
  {
    "id": "sentence_2fA6SeR240eMZEKXr9Jh_3",
    "type": "sentence",
    "topicId": "2fA6SeR240eMZEKXr9Jh",
    "unitId": "SxbbRsztz3FrWwzGVAoh",
    "courseId": "8dWTFfJd7fb2jTCVkXNb",
    "content": {
      "text": "Kur'an-ı Kerim İslam dininin temel kaynağıdır."
    },
    "updatedAt": "2026-09-19T11:14:00.962Z"
  },
  {
    "id": "sentence_2fA6SeR240eMZEKXr9Jh_4",
    "type": "sentence",
    "topicId": "2fA6SeR240eMZEKXr9Jh",
    "unitId": "SxbbRsztz3FrWwzGVAoh",
    "courseId": "8dWTFfJd7fb2jTCVkXNb",
    "content": {
      "text": "Kur'an okunurken onu saygıyla dinlememiz gerekir."
    },
    "updatedAt": "2026-09-19T11:14:00.962Z"
  },
  {
    "id": "sentence_2fA6SeR240eMZEKXr9Jh_5",
    "type": "sentence",
    "topicId": "2fA6SeR240eMZEKXr9Jh",
    "unitId": "SxbbRsztz3FrWwzGVAoh",
    "courseId": "8dWTFfJd7fb2jTCVkXNb",
    "content": {
      "text": "Abdest almak bedensel ve manevi temizlik sağlar."
    },
    "updatedAt": "2026-09-19T11:14:00.962Z"
  },
  {
    "id": "sentence_2fA6SeR240eMZEKXr9Jh_6",
    "type": "sentence",
    "topicId": "2fA6SeR240eMZEKXr9Jh",
    "unitId": "SxbbRsztz3FrWwzGVAoh",
    "courseId": "8dWTFfJd7fb2jTCVkXNb",
    "content": {
      "text": "Kur'an-ı Kerim yüz on dört sureden oluşur."
    },
    "updatedAt": "2026-09-19T11:14:00.962Z"
  },
  {
    "id": "sentence_2fA6SeR240eMZEKXr9Jh_7",
    "type": "sentence",
    "topicId": "2fA6SeR240eMZEKXr9Jh",
    "unitId": "SxbbRsztz3FrWwzGVAoh",
    "courseId": "8dWTFfJd7fb2jTCVkXNb",
    "content": {
      "text": "İstiaze her türlü kötülükten Allah'a sığınmaktır."
    },
    "updatedAt": "2026-09-19T11:14:00.962Z"
  }
]