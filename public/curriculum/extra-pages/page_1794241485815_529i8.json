  "id": "page_1794241485815_529i8",
  "title": "YS",
  "description": "",
  "htmlContent": "<!DOCTYPE html>\n<html lang=\"tr\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>5. Sınıf Din Kültürü ve Ahlak Bilgisi - 1. Dönem 1. Ortak Yazılı Sınavı</title>\n  <script src=\"https://cdn.tailwindcss.com/3.4.17\"></script>\n  <link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap\" rel=\"stylesheet\">\n  <style>\n    :root {\n      --q-font-size: 1.25rem;\n      --q-line-height: 1.7rem;\n      --a-font-size: 1.15rem;\n      --a-line-height: 1.55rem;\n    }\n    body {\n      font-family: 'Inter', system-ui, -apple-system, sans-serif;\n      transition: background-color 0.25s ease, color 0.25s ease;\n    }\n    .question-text {\n      font-size: var(--q-font-size);\n      line-height: var(--q-line-height);\n    }\n    .answer-text {\n      font-size: var(--a-font-size);\n      line-height: var(--a-line-height);\n    }\n    .answer-panel {\n      max-height: 0;\n      opacity: 0;\n      overflow: hidden;\n      transition: max-height 0.4s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.3s ease, margin-top 0.3s ease;\n    }\n    .answer-panel.open {\n      max-height: 1500px;\n      opacity: 1;\n      margin-top: 1.25rem;\n    }\n    .dark-theme {\n      background-color: #0f172a;\n      color: #f8fafc;\n    }\n    .dark-theme .card-surface {\n      background-color: #1e293b;\n      border-color: #334155;\n      color: #f8fafc;\n    }\n    .dark-theme .quote-box {\n      background-color: #0f172a;\n      border-color: #38bdf8;\n      color: #e2e8f0;\n    }\n    .dark-theme .header-bar {\n      background-color: #1e293b;\n      border-color: #334155;\n    }\n    .dark-theme .answer-box-primary {\n      background-color: #064e3b;\n      border-color: #10b981;\n      color: #ecfdf5;\n    }\n    .dark-theme .answer-box-secondary {\n      background-color: #1e3a8a;\n      border-color: #60a5fa;\n      color: #eff6ff;\n    }\n    .dark-theme .muted-text {\n      color: #94a3b8;\n    }\n  </style>\n</head>\n<body id=\"app-body\" class=\"bg-slate-100 text-slate-900 min-h-screen pb-4\">\n\n  <!-- Üst Bilgi ve Kontrol Çubuğu -->\n  <header class=\"header-bar sticky top-0 z-30 bg-white/95 backdrop-blur border-b border-slate-200 shadow-sm transition-colors\">\n    <div class=\"max-w-[1920px] mx-auto px-3 py-1.5 flex flex-wrap items-center justify-between gap-2\">\n      \n      <!-- Okul ve Sınav Başlığı -->\n      <div class=\"flex items-center gap-2.5\">\n        <div class=\"w-9 h-9 rounded-xl bg-emerald-600 text-white flex items-center justify-center font-extrabold text-base shadow-sm shrink-0\">\n          5.S\n        </div>\n        <div>\n          <div class=\"flex items-center gap-2 flex-wrap\">\n            <span class=\"text-[11px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800\">\n              1. Dönem 1. Yazılı\n            </span>\n            <span class=\"text-xs font-bold text-emerald-700\">\n              Açılan Cevap: <span id=\"revealed-counter\" class=\"font-extrabold\">0 / 6</span>\n            </span>\n          </div>\n          <h1 class=\"text-sm sm:text-base font-extrabold tracking-tight leading-tight\">\n            Mustafa Hotamışlı AİHL • 5. Sınıf DKAB\n          </h1>\n        </div>\n      </div>\n\n      <!-- Sınıfta Kullanım Araçları -->\n      <div class=\"flex flex-wrap items-center gap-1.5\">\n        <!-- 3'lü Ekran Sayfa Seçimi (1-3 / 4-6) ve Dizilim -->\n        <div id=\"triple-nav-group\" class=\"inline-flex items-center rounded-xl bg-emerald-100/90 p-1 text-emerald-950 gap-1\">\n          <button id=\"btn-page-1\" onclick=\"setTriplePage(0)\" class=\"px-3 py-1 rounded-lg text-xs sm:text-sm font-extrabold transition-all bg-emerald-600 text-white shadow-sm\">\n            1 - 2 - 3. Sorular\n          </button>\n          <button id=\"btn-page-2\" onclick=\"setTriplePage(1)\" class=\"px-3 py-1 rounded-lg text-xs sm:text-sm font-extrabold transition-all hover:bg-white/70\">\n            4 - 5 - 6. Sorular\n          </button>\n          <button id=\"btn-layout-toggle\" onclick=\"toggleTripleLayout()\" class=\"px-2.5 py-1 rounded-lg text-xs font-bold bg-white/80 hover:bg-white text-slate-800 border border-emerald-300 transition-all\" title=\"Yan Yana 3 Sütun veya Alt Alta 3 Satır\">\n            <span id=\"layout-toggle-text\">⊞ Yan Yana (3 Sütun)</span>\n          </button>\n        </div>\n\n        <!-- Görünüm Modu -->\n        <div class=\"inline-flex rounded-xl bg-slate-200/80 p-1 text-slate-800\">\n          <button id=\"btn-mode-triple\" onclick=\"setViewMode('triple')\" class=\"px-2.5 py-1 rounded-lg text-xs sm:text-sm font-bold transition-all bg-white shadow-sm text-emerald-700\">\n            3'lü Ekran\n          </button>\n          <button id=\"btn-mode-list\" onclick=\"setViewMode('list')\" class=\"px-2.5 py-1 rounded-lg text-xs sm:text-sm font-bold transition-all hover:bg-white/60\">\n            Tüm Sorular\n          </button>\n          <button id=\"btn-mode-slide\" onclick=\"setViewMode('slide')\" class=\"px-2.5 py-1 rounded-lg text-xs sm:text-sm font-bold transition-all hover:bg-white/60\">\n            Tek Tek (Sunum)\n          </button>\n        </div>\n\n        <!-- Yazı Boyutu Kontrolü -->\n        <div class=\"inline-flex items-center rounded-xl bg-slate-200/80 p-1 text-slate-800\" title=\"Yazı Boyutunu Ayarla\">\n          <button id=\"btn-font-down\" onclick=\"changeFontSize(-1)\" class=\"px-3 py-1.5 rounded-lg text-sm font-extrabold hover:bg-white transition-all\" aria-label=\"Yazıyı Küçült\">\n            A-\n          </button>\n          <span id=\"font-size-label\" class=\"px-2 text-xs font-bold uppercase tracking-wide\">\n            Büyük\n          </span>\n          <button id=\"btn-font-up\" onclick=\"changeFontSize(1)\" class=\"px-3 py-1.5 rounded-lg text-sm font-extrabold hover:bg-white transition-all\" aria-label=\"Yazıyı Büyüt\">\n            A+\n          </button>\n        </div>\n\n        <!-- Tüm Cevapları Aç/Kapat -->\n        <button id=\"btn-toggle-all\" onclick=\"toggleAllAnswers()\" class=\"px-4 py-2 rounded-xl text-sm font-bold bg-amber-500 hover:bg-amber-600 text-white shadow-sm transition-all flex items-center gap-1.5\">\n          <span id=\"toggle-all-text\">Tüm Cevapları Göster</span>\n        </button>\n\n        <!-- Gece / Gündüz Modu -->\n        <button id=\"btn-theme\" onclick=\"toggleTheme()\" class=\"p-2 rounded-xl bg-slate-200 hover:bg-slate-300 text-slate-800 font-bold text-sm transition-all\" title=\"Gece / Gündüz Modu\">\n          <span id=\"theme-icon\">🌙 Koyu Mod</span>\n        </button>\n      </div>\n    </div>\n\n    <!-- Sunum Modu Hızlı Soru Geçiş Barı -->\n    <div id=\"slide-nav-bar\" class=\"hidden border-t border-slate-200 bg-slate-50/90 px-4 py-2.5\">\n      <div class=\"max-w-6xl mx-auto flex flex-wrap items-center justify-between gap-2\">\n        <button id=\"btn-prev-q\" onclick=\"navigateSlide(-1)\" class=\"px-4 py-2 rounded-xl font-bold text-base bg-white border border-slate-300 text-slate-800 hover:bg-slate-100 disabled:opacity-40 transition-all\">\n          ← Önceki Soru\n        </button>\n        <div id=\"question-pills\" class=\"flex items-center gap-2 flex-wrap\"></div>\n        <button id=\"btn-next-q\" onclick=\"navigateSlide(1)\" class=\"px-4 py-2 rounded-xl font-bold text-base bg-emerald-600 text-white hover:bg-emerald-700 disabled:opacity-40 transition-all\">\n          Sonraki Soru →\n        </button>\n      </div>\n    </div>\n  </header>\n\n  <!-- Ana İçerik -->\n  <main class=\"max-w-[1920px] mx-auto px-3 pt-2.5\">\n    <!-- Sorular Konteyneri -->\n    <div id=\"questions-container\" class=\"grid grid-cols-1 lg:grid-cols-3 gap-3 items-start\"></div>\n  </main>\n\n  <script>\n    const questionsData = [\n      {\n        id: 1,\n        points: 15,\n        badge: \"1. Soru\",\n        topic: \"Evrendeki Mükemmel Düzen\",\n        icon: \"🔍\",\n        context: \"6 yaşındaki Musab, babasının cep telefonunu parmak iziyle açmaya çalışmaktadır. Annesi neden böyle yaptığını sorduğunda Musab, babasının telefonu bu şekilde açtığını söylemiştir. Annesi ise Musab’a insanların parmak izlerinin belirli çizgi ve desenlerden oluştuğunu, ancak bu desenlerin her insanda farklı olduğunu açıklamıştır.\",\n        prompt: \"Metindeki bilgilerden hareketle evrendeki düzen hakkında nasıl bir sonuca ulaşılabilir? Açıklayınız.\",\n        explanation: \"Öğrencilerden, insanların parmak izlerinin benzer bir yapıya sahip olmasına rağmen birbirinden farklı olmasını evrendeki mükemmel düzenle ilişkilendirerek bu farklılıkların da düzenin bir parçası olduğu sonucuna ulaşmaları beklenmektedir.\",\n        sampleAnswer: \"İnsanların parmak izlerinin benzer çizgi ve desenlerden oluşmasına rağmen birbirinden farklı olması, evrende mükemmel bir düzen bulunduğunu gösterir. Her insanın kendine özgü parmak izine sahip olması da bu düzenin bir parçasıdır.\"\n      },\n      {\n        id: 2,\n        points: 15,\n        badge: \"2. Soru\",\n        topic: \"Canlılardaki Ölçü ve Düzen\",\n        icon: \"🐻‍❄️\",\n        context: \"Elif, fen bilimleri dersinde kutup ayılarıyla ilgili bir video izledi. Kutup ayılarının derilerinin altında kalın bir yağ tabakasının bulunduğunu ve tüylerinin vücut ısısını korumaya yardımcı olduğunu öğrendi. Kutup ayılarının sahip olduğu bu özellikler sayesinde çok soğuk bölgelerde yaşayabildiğini fark etti.\",\n        prompt: \"Elif’in öğrendiklerinden hareketle, Allah’ın varlığı hakkında nasıl bir sonuca ulaşılır? Açıklayınız.\",\n        explanation: \"Öğrencilerden, kutup ayılarının yaşadıkları ortamın koşullarına uygun özelliklere sahip olmasından hareketle canlılardaki ölçü ve düzenin Allah’ın varlığına işaret ettiğini açıklamaları beklenmektedir.\",\n        sampleAnswer: \"Kutup ayısının kalın yağ tabakası, tüyleri ve siyah derisi, onun soğuk bölgelerde yaşayabilmesini sağlar. Bu özelliklerin birbiriyle uyumlu olması, kutup ayısının ihtiyaçlarının gözetilerek yaratıldığını düşündürür. Bu durum, Allah’ın varlığına işaret eder.\"\n      },\n      {\n        id: 3,\n        points: 15,\n        badge: \"3. Soru\",\n        topic: \"Doğadaki Uyum ve Yaratılış\",\n        icon: \"🌾\",\n        context: \"Kadir, tarlada buğdayların gelişimini gözlemler. Toprağa ekilen tohumların zamanla filizlendiğini, büyüyerek başak verdiğini ve bu süreçte su, güneş ışığı ve toprağın etkili olduğunu fark eder. Aynı gelişimin her yıl benzer şekilde gerçekleştiğini görür.\",\n        prompt: \"Bu bilgilerden hareketle Allah’ın varlığı hakkında nasıl bir sonuca ulaşılabilir? Açıklayınız.\",\n        explanation: \"Öğrencilerden, buğdayların gelişiminde su, güneş ışığı ve toprağın birbiriyle uyumlu şekilde etkili olmasından ve bu sürecin düzenli olarak tekrarlanmasından hareketle evrendeki ölçü ve düzenin Allah’ın varlığına işaret ettiğini açıklamaları beklenmektedir.\",\n        sampleAnswer: \"Buğdayların büyümesi için su, güneş ışığı ve toprağın uyum içinde etkili olması, doğadaki düzenin bir örneğidir. Bu düzen, evrenin bir yaratıcısı olduğunu ve bu yaratıcının Allah olduğunu gösterir.\"\n      },\n      {\n        id: 4,\n        points: 10,\n        badge: \"4. Soru\",\n        topic: \"Allah’ın Güzel İsimleri (Esmaül Hüsna)\",\n        icon: \"📖\",\n        context: \"“… Şüphesiz Allah bütün yaptıklarınızı görür.” (Bakara suresi, 110. ayet)\\n“… O; hakkıyla işitendir, hakkıyla bilendir.” (Bakara suresi, 137. ayet)\",\n        prompt: \"Bu ayetlerde Allah’ın güzel isimlerinden hangilerine değinildiğini açıklayınız.\",\n        explanation: \"Öğrencilerden, Allah’ın yapılan her şeyi görmesini Basir, her şeyi işitmesini Semi ve her şeyi bilmesini Âlim ismiyle ilişkilendirmeleri ve bu isimlerin anlamlarını açıklamaları beklenmektedir.\",\n        sampleAnswer: \"Ayetlerde Allah’ın Basir, Semi ve Âlim isimlerine değinilmektedir. Basir, Allah’ın her şeyi görmesi; Semi, her şeyi işitmesi; Âlim ise her şeyi bilmesi anlamına gelir.\"\n      },\n      {\n        id: 5,\n        points: 20,\n        badge: \"5. Soru\",\n        topic: \"Rahman ve Rahîm İsimleri\",\n        icon: \"🤲\",\n        context: \"“İlahınız bir tek Allah’tır. O’ndan başka ilah yoktur. O, Rahman’dır, Rahîm’dir.” ayetinde olduğu gibi Kur’an-ı Kerim’de Rahman ve Rahîm isimleri genellikle birlikte kullanılmıştır. Ayrıca günlük hayatımızda sıklıkla “Bismillâhirrahmânirrahîm” ifadesini kullanırız. Bu ifadenin içinde Rahman ve Rahîm isimleri yer almaktadır. Bizler de yemek yerken, ders çalışırken veya bir işe başlarken besmele çekerek Allah’ın (cc) Rahman ve Rahîm olduğunu ifade ederiz.\",\n        prompt: \"Verilen bilgilerden hareketle Rahman ve Rahim isimlerinin anlamını yazınız.\",\n        explanation: \"\",\n        sampleAnswer: \"RAHMAN: Yaratılmış bütün varlıklara şefkat gösteren, fark gözetmeksizin insanlara merhamet eden, sürekli nimetler veren, rahmeti sonsuz olan.\\n\\nRAHİM: Yarattığı bütün varlıklara karşılık beklemeden nimetler veren, onları koruyan, esirgeyen, bağışlayan ve onlara merhamet eden Allah’ın (cc), ahirette kendisine inanan kullarına şefkat etmesi ve onları ödüllendirmesi.\"\n      },\n      {\n        id: 6,\n        points: 25,\n        badge: \"6. Soru\",\n        topic: \"İhlas Suresi ve Anlamı\",\n        icon: \"🕌\",\n        context: \"İhlas suresinin anlamı:\\nRahman ve Rahîm olan Allah’ın adıyla\\n1. De ki: “O, Allah’tır, tektir.”\\n2. Allah Samed’dir. (Hiçbir şeye muhtaç olmayandır.)\\n3. O, doğurmamış ve doğmamıştır.\\n4. O’nun hiçbir dengi (eşi, benzeri) yoktur.\",\n        prompt: \"Bu surede verilmek istenen mesajları açıklayınız.\",\n        explanation: \"\",\n        sampleAnswer: \"Allah’ın tek olduğu, hiçbir şeye muhtaç olmadığı, öncesi ve sonrasının olmadığı, O’na benzeyen hiçbir şeyin bulunmadığı anlatılarak Allah’ın özellikleri belirtilmiştir.\"\n      }\n    ];\n\n    let viewMode = 'triple'; // 'triple' (3 soru bir ekranda), 'list' (tümü), 'slide' (tek tek)\n    let triplePage = 0; // 0: Soru 1-2-3, 1: Soru 4-5-6\n    let tripleColumns = true; // true: Yan Yana 3 Sütun, false: Alt Alta 3 Satır\n    let currentSlideIndex = 0;\n    let revealedMap = {};\n    let fontLevel = 1; // 3 soru aynı ekrana rahat sığsın diye ideal başlangıç boyutu\n    let isDark = false;\n\n    const fontPresets = [\n      { label: \"Kompakt\", qSize: \"1.05rem\", qLine: \"1.45rem\", aSize: \"1.0rem\",  aLine: \"1.4rem\" },\n      { label: \"Büyük\",   qSize: \"1.22rem\", qLine: \"1.68rem\", aSize: \"1.14rem\", aLine: \"1.55rem\" },\n      { label: \"Çok Büyük\", qSize: \"1.42rem\", qLine: \"1.95rem\", aSize: \"1.3rem\", aLine: \"1.8rem\" },\n      { label: \"Dev\",     qSize: \"1.68rem\", qLine: \"2.3rem\",  aSize: \"1.52rem\", aLine: \"2.1rem\" },\n      { label: \"Maksimum\", qSize: \"2.0rem\", qLine: \"2.7rem\",  aSize: \"1.8rem\",  aLine: \"2.45rem\" }\n    ];\n\n    function applyFontPreset() {\n      const preset = fontPresets[fontLevel];\n      document.documentElement.style.setProperty('--q-font-size', preset.qSize);\n      document.documentElement.style.setProperty('--q-line-height', preset.qLine);\n      document.documentElement.style.setProperty('--a-font-size', preset.aSize);\n      document.documentElement.style.setProperty('--a-line-height', preset.aLine);\n      const labelEl = document.getElementById('font-size-label');\n      if (labelEl) labelEl.textContent = preset.label;\n    }\n\n    function changeFontSize(delta) {\n      const next = fontLevel + delta;\n      if (next >= 0 && next < fontPresets.length) {\n        fontLevel = next;\n        applyFontPreset();\n      }\n    }\n\n    function toggleTheme() {\n      isDark = !isDark;\n      const body = document.getElementById('app-body');\n      const icon = document.getElementById('theme-icon');\n      if (isDark) {\n        body.classList.add('dark-theme');\n        icon.textContent = '☀️ Açık Mod';\n      } else {\n        body.classList.remove('dark-theme');\n        icon.textContent = '🌙 Koyu Mod';\n      }\n    }\n\n    function setTriplePage(pageIdx) {\n      triplePage = pageIdx;\n      if (viewMode !== 'triple') {\n        setViewMode('triple');\n        return;\n      }\n      updateTripleNavButtons();\n      renderQuestions();\n    }\n\n    function toggleTripleLayout() {\n      tripleColumns = !tripleColumns;\n      const txt = document.getElementById('layout-toggle-text');\n      if (txt) {\n        txt.textContent = tripleColumns ? '⊞ Yan Yana (3 Sütun)' : '☰ Alt Alta (3 Satır)';\n      }\n      renderQuestions();\n    }\n\n    function updateTripleNavButtons() {\n      const b1 = document.getElementById('btn-page-1');\n      const b2 = document.getElementById('btn-page-2');\n      if (!b1 || !b2) return;\n      if (triplePage === 0) {\n        b1.className = \"px-3 py-1 rounded-lg text-xs sm:text-sm font-extrabold transition-all bg-emerald-600 text-white shadow-sm\";\n        b2.className = \"px-3 py-1 rounded-lg text-xs sm:text-sm font-extrabold transition-all hover:bg-white/70\";\n      } else {\n        b2.className = \"px-3 py-1 rounded-lg text-xs sm:text-sm font-extrabold transition-all bg-emerald-600 text-white shadow-sm\";\n        b1.className = \"px-3 py-1 rounded-lg text-xs sm:text-sm font-extrabold transition-all hover:bg-white/70\";\n      }\n    }\n\n    function setViewMode(mode) {\n      viewMode = mode;\n      const btnTriple = document.getElementById('btn-mode-triple');\n      const btnList = document.getElementById('btn-mode-list');\n      const btnSlide = document.getElementById('btn-mode-slide');\n      const slideNav = document.getElementById('slide-nav-bar');\n      const tripleNav = document.getElementById('triple-nav-group');\n\n      const activeCls = \"px-2.5 py-1 rounded-lg text-xs sm:text-sm font-bold transition-all bg-white shadow-sm text-emerald-700\";\n      const idleCls = \"px-2.5 py-1 rounded-lg text-xs sm:text-sm font-bold transition-all hover:bg-white/60\";\n\n      if (btnTriple) btnTriple.className = mode === 'triple' ? activeCls : idleCls;\n      if (btnList) btnList.className = mode === 'list' ? activeCls : idleCls;\n      if (btnSlide) btnSlide.className = mode === 'slide' ? activeCls : idleCls;\n\n      if (mode === 'slide') {\n        slideNav.classList.remove('hidden');\n      } else {\n        slideNav.classList.add('hidden');\n      }\n\n      if (tripleNav) {\n        if (mode === 'triple') {\n          tripleNav.classList.remove('hidden');\n        } else {\n          tripleNav.classList.add('hidden');\n        }\n      }\n\n      renderQuestions();\n    }\n\n    function navigateSlide(dir) {\n      const next = currentSlideIndex + dir;\n      if (next >= 0 && next < questionsData.length) {\n        currentSlideIndex = next;\n        renderQuestions();\n        window.scrollTo({ top: 0, behavior: 'smooth' });\n      }\n    }\n\n    function goToQuestion(idx) {\n      currentSlideIndex = idx;\n      renderQuestions();\n      window.scrollTo({ top: 0, behavior: 'smooth' });\n    }\n\n    function toggleAnswer(qId) {\n      revealedMap[qId] = !revealedMap[qId];\n      renderQuestions();\n    }\n\n    function toggleAllAnswers() {\n      const allOpen = questionsData.every(q => revealedMap[q.id]);\n      questionsData.forEach(q => {\n        revealedMap[q.id] = !allOpen;\n      });\n      renderQuestions();\n    }\n\n    function formatMultiline(text) {\n      return text.split('\\n').map(line => `<p class=\"mb-2 last:mb-0\">${line}</p>`).join('');\n    }\n\n    function renderSlidePills() {\n      const pillsContainer = document.getElementById('question-pills');\n      if (!pillsContainer) return;\n      pillsContainer.innerHTML = questionsData.map((q, idx) => {\n        const isCurrent = idx === currentSlideIndex;\n        const isRevealed = !!revealedMap[q.id];\n        let cls = \"w-11 h-11 rounded-xl font-extrabold text-base transition-all flex items-center justify-center border-2 \";\n        if (isCurrent) {\n          cls += \"bg-emerald-600 text-white border-emerald-600 shadow-md scale-105\";\n        } else if (isRevealed) {\n          cls += \"bg-emerald-100 text-emerald-800 border-emerald-300\";\n        } else {\n          cls += \"bg-white text-slate-700 border-slate-300 hover:bg-slate-100\";\n        }\n        return `<button onclick=\"goToQuestion(${idx})\" class=\"${cls}\" title=\"${q.badge} (${q.points} Puan)\">${q.id}</button>`;\n      }).join('');\n\n      const prevBtn = document.getElementById('btn-prev-q');\n      const nextBtn = document.getElementById('btn-next-q');\n      if (prevBtn) prevBtn.disabled = currentSlideIndex === 0;\n      if (nextBtn) nextBtn.disabled = currentSlideIndex === questionsData.length - 1;\n    }\n\n    function updateCounters() {\n      const openCount = questionsData.filter(q => revealedMap[q.id]).length;\n      const counterEl = document.getElementById('revealed-counter');\n      if (counterEl) counterEl.textContent = `${openCount} / ${questionsData.length}`;\n\n      const toggleAllText = document.getElementById('toggle-all-text');\n      if (toggleAllText) {\n        toggleAllText.textContent = openCount === questionsData.length ? \"Tüm Cevapları Gizle\" : \"Tüm Cevapları Göster\";\n      }\n    }\n\n    function renderQuestions() {\n      const container = document.getElementById('questions-container');\n      let itemsToShow = questionsData;\n\n      if (viewMode === 'triple') {\n        const start = triplePage * 3;\n        itemsToShow = questionsData.slice(start, start + 3);\n        container.className = tripleColumns\n          ? \"grid grid-cols-1 lg:grid-cols-3 gap-3 items-stretch\"\n          : \"grid grid-cols-1 gap-2.5\";\n      } else if (viewMode === 'list') {\n        itemsToShow = questionsData;\n        container.className = \"grid grid-cols-1 lg:grid-cols-3 gap-3 items-stretch\";\n      } else {\n        itemsToShow = [questionsData[currentSlideIndex]];\n        container.className = \"max-w-5xl mx-auto space-y-4\";\n      }\n\n      container.innerHTML = itemsToShow.map(q => {\n        const isOpen = !!revealedMap[q.id];\n        return `\n          <section class=\"card-surface bg-white border-2 border-slate-200 rounded-2xl p-4 sm:p-5 shadow-sm transition-all flex flex-col justify-between\">\n            <div>\n              <!-- Soru Üst Başlık -->\n              <div class=\"flex items-center justify-between gap-2 pb-2.5 mb-3 border-b border-slate-100\">\n                <div class=\"flex items-center gap-2 min-w-0\">\n                  <span class=\"text-2xl select-none shrink-0\">${q.icon}</span>\n                  <span class=\"px-2.5 py-0.5 rounded-lg bg-emerald-600 text-white font-extrabold text-sm sm:text-base shrink-0\">\n                    ${q.badge}\n                  </span>\n                  <span class=\"text-xs sm:text-sm font-bold text-slate-500 muted-text truncate\">\n                    ${q.topic}\n                  </span>\n                </div>\n                <div class=\"px-2.5 py-0.5 rounded-lg bg-amber-100 text-amber-900 font-extrabold text-xs sm:text-sm border border-amber-300 shrink-0\">\n                  ${q.points} Puan\n                </div>\n              </div>\n\n              <!-- Soru Metni (Öncül / Ayet / Hikaye) -->\n              <div class=\"quote-box bg-slate-50 border-l-4 border-emerald-500 rounded-xl p-3 sm:p-3.5 mb-3 text-slate-800 question-text font-medium\">\n                ${formatMultiline(q.context)}\n              </div>\n\n              <!-- Soru Kökü -->\n              <div class=\"question-text font-extrabold mb-3.5 flex items-start gap-2\">\n                <span class=\"text-emerald-600 shrink-0\">➤</span>\n                <span>${q.prompt}</span>\n              </div>\n            </div>\n\n            <div>\n              <!-- Cevabı Göster / Gizle Butonu -->\n              <button onclick=\"toggleAnswer(${q.id})\" class=\"w-full px-4 py-2.5 rounded-xl font-extrabold text-base sm:text-lg transition-all shadow-sm flex items-center justify-center gap-2 ${\n                isOpen\n                  ? 'bg-rose-600 hover:bg-rose-700 text-white'\n                  : 'bg-emerald-600 hover:bg-emerald-700 text-white'\n              }\">\n                <span>${isOpen ? '🙈 Cevabı Gizle' : '👁️ Cevabı Göster (Tıkla)'}</span>\n              </button>\n\n              <!-- Açılır Cevap Alanı -->\n              <div class=\"answer-panel ${isOpen ? 'open' : ''}\">\n                <div class=\"space-y-2.5 pt-1\">\n                  <div class=\"answer-box-primary bg-emerald-50 border-2 border-emerald-400 rounded-xl p-3.5 text-emerald-950 shadow-sm\">\n                    <div class=\"flex items-center gap-1.5 font-extrabold text-xs sm:text-sm uppercase tracking-wider text-emerald-800 mb-1\">\n                      <span>✅ ${q.explanation ? 'Örnek Öğrenci Cevabı' : 'Cevap Anahtarı'}</span>\n                    </div>\n                    <div class=\"answer-text font-bold\">\n                      ${formatMultiline(q.sampleAnswer)}\n                    </div>\n                  </div>\n\n                  ${q.explanation ? `\n                    <div class=\"answer-box-secondary bg-blue-50 border border-blue-300 rounded-xl p-3 text-blue-950\">\n                      <div class=\"flex items-center gap-1.5 font-extrabold text-xs uppercase tracking-wider text-blue-700 mb-1\">\n                        <span>📌 Beklenen Kazanım</span>\n                      </div>\n                      <div class=\"answer-text font-medium\">\n                        ${formatMultiline(q.explanation)}\n                      </div>\n                    </div>\n                  ` : ''}\n                </div>\n              </div>\n            </div>\n          </section>\n        `;\n      }).join('');\n\n      renderSlidePills();\n      updateTripleNavButtons();\n      updateCounters();\n    }\n\n    // Klavye Kısayolları (Sunum modunda sağ/sol ok ve Boşluk tuşu)\n    window.addEventListener('keydown', function(e) {\n      if (viewMode === 'slide') {\n        if (e.key === 'ArrowRight') {\n          navigateSlide(1);\n        } else if (e.key === 'ArrowLeft') {\n          navigateSlide(-1);\n        } else if (e.key === ' ' || e.key === 'Enter') {\n          if (document.activeElement && document.activeElement.tagName === 'BUTTON') return;\n          e.preventDefault();\n          const currentQ = questionsData[currentSlideIndex];\n          if (currentQ) toggleAnswer(currentQ.id);\n        }\n      }\n    });\n\n    // Başlangıç Yüklemesi\n    applyFontPreset();\n    renderQuestions();\n  </script>\n</body>\n</html>",
