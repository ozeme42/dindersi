  "htmlContent": "<!DOCTYPE html>\n<html lang=\"tr\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>6. Sınıf Peygamberimizin Hayatı - 1. Dönem 1. Yazılı Sınavı</title>\n  <script src=\"https://cdn.tailwindcss.com/3.4.17\"></script>\n  <link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap\" rel=\"stylesheet\">\n  <style>\n    :root {\n      --q-font-size: 1.25rem;\n      --q-line-height: 1.7rem;\n      --a-font-size: 1.15rem;\n      --a-line-height: 1.55rem;\n    }\n    body {\n      font-family: 'Inter', system-ui, -apple-system, sans-serif;\n      transition: background-color 0.25s ease, color 0.25s ease;\n    }\n    .question-text {\n      font-size: var(--q-font-size);\n      line-height: var(--q-line-height);\n    }\n    .answer-text {\n      font-size: var(--a-font-size);\n      line-height: var(--a-line-height);\n    }\n    .answer-panel {\n      max-height: 0;\n      opacity: 0;\n      overflow: hidden;\n      transition: max-height 0.4s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.3s ease, margin-top 0.3s ease;\n    }\n    .answer-panel.open {\n      max-height: 1600px;\n      opacity: 1;\n      margin-top: 0.85rem;\n    }\n    .dark-theme {\n      background-color: #0f172a;\n      color: #f8fafc;\n    }\n    .dark-theme .card-surface {\n      background-color: #1e293b;\n      border-color: #334155;\n      color: #f8fafc;\n    }\n    .dark-theme .quote-box {\n      background-color: #0f172a;\n      border-color: #2dd4bf;\n      color: #e2e8f0;\n    }\n    .dark-theme .header-bar {\n      background-color: #1e293b;\n      border-color: #334155;\n    }\n    .dark-theme .answer-box-primary {\n      background-color: #064e3b;\n      border-color: #10b981;\n      color: #ecfdf5;\n    }\n    .dark-theme .answer-box-secondary {\n      background-color: #1e3a8a;\n      border-color: #60a5fa;\n      color: #eff6ff;\n    }\n    .dark-theme .muted-text {\n      color: #94a3b8;\n    }\n  </style>\n</head>\n<body id=\"app-body\" class=\"bg-slate-100 text-slate-900 min-h-screen pb-4\">\n\n  <!-- Üst Bilgi ve Kontrol Çubuğu -->\n  <header class=\"header-bar sticky top-0 z-30 bg-white/95 backdrop-blur border-b border-slate-200 shadow-sm transition-colors\">\n    <div class=\"max-w-[1920px] mx-auto px-3 py-1.5 flex flex-wrap items-center justify-between gap-2\">\n      \n      <!-- Okul ve Sınav Başlığı -->\n      <div class=\"flex items-center gap-2.5\">\n        <div class=\"w-9 h-9 rounded-xl bg-teal-700 text-white flex items-center justify-center font-extrabold text-sm shadow-sm shrink-0\">\n          6.S\n        </div>\n        <div>\n          <div class=\"flex items-center gap-2 flex-wrap\">\n            <span class=\"text-[11px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-full bg-teal-100 text-teal-800\">\n              2026-2027 • 1. Dönem 1. Yazılı\n            </span>\n            <span class=\"text-xs font-bold text-teal-700\">\n              Açılan Cevap: <span id=\"revealed-counter\" class=\"font-extrabold\">0 / 16</span>\n            </span>\n          </div>\n          <h1 class=\"text-sm sm:text-base font-extrabold tracking-tight leading-tight\">\n            Mustafa Hotamışlı İHO • 6. Sınıf Peygamberimizin Hayatı\n          </h1>\n        </div>\n      </div>\n\n      <!-- Sınıfta Kullanım Araçları -->\n      <div class=\"flex flex-wrap items-center gap-1.5\">\n        <!-- 3'lü Ekran Sayfa Seçimi (16 Soru) ve Dizilim -->\n        <div id=\"triple-nav-group\" class=\"inline-flex flex-wrap items-center rounded-xl bg-teal-100/90 p-1 text-teal-950 gap-1\">\n          <button id=\"btn-page-1\" onclick=\"setTriplePage(0)\" class=\"px-2 py-1 rounded-lg text-xs font-extrabold transition-all bg-teal-700 text-white shadow-sm\">\n            1 - 2 - 3. Sorular\n          </button>\n          <button id=\"btn-page-2\" onclick=\"setTriplePage(1)\" class=\"px-2 py-1 rounded-lg text-xs font-extrabold transition-all hover:bg-white/70\">\n            4 - 5 - 6. Sorular\n          </button>\n          <button id=\"btn-page-3\" onclick=\"setTriplePage(2)\" class=\"px-2 py-1 rounded-lg text-xs font-extrabold transition-all hover:bg-white/70\">\n            6 - 7 - 8. Sorular\n          </button>\n          <button id=\"btn-page-4\" onclick=\"setTriplePage(3)\" class=\"px-2 py-1 rounded-lg text-xs font-extrabold transition-all hover:bg-white/70\">\n            9 - 10 - 11. Sorular\n          </button>\n          <button id=\"btn-page-5\" onclick=\"setTriplePage(4)\" class=\"px-2 py-1 rounded-lg text-xs font-extrabold transition-all hover:bg-white/70\">\n            12 - 13 - 14. Sorular\n          </button>\n          <button id=\"btn-page-6\" onclick=\"setTriplePage(5)\" class=\"px-2 py-1 rounded-lg text-xs font-extrabold transition-all hover:bg-white/70\">\n            14 - 15 - 16. Sorular\n          </button>\n          <button id=\"btn-layout-toggle\" onclick=\"toggleTripleLayout()\" class=\"px-2.5 py-1 rounded-lg text-xs font-bold bg-white/80 hover:bg-white text-slate-800 border border-teal-300 transition-all\" title=\"Yan Yana 3 Sütun veya Alt Alta 3 Satır\">\n            <span id=\"layout-toggle-text\">⊞ Yan Yana (3 Sütun)</span>\n          </button>\n        </div>\n\n        <!-- Görünüm Modu -->\n        <div class=\"inline-flex rounded-xl bg-slate-200/80 p-1 text-slate-800\">\n          <button id=\"btn-mode-triple\" onclick=\"setViewMode('triple')\" class=\"px-2.5 py-1 rounded-lg text-xs sm:text-sm font-bold transition-all bg-white shadow-sm text-teal-700\">\n            3'lü Ekran\n          </button>\n          <button id=\"btn-mode-list\" onclick=\"setViewMode('list')\" class=\"px-2.5 py-1 rounded-lg text-xs sm:text-sm font-bold transition-all hover:bg-white/60\">\n            Tüm Sorular\n          </button>\n          <button id=\"btn-mode-slide\" onclick=\"setViewMode('slide')\" class=\"px-2.5 py-1 rounded-lg text-xs sm:text-sm font-bold transition-all hover:bg-white/60\">\n            Tek Tek (Sunum)\n          </button>\n        </div>\n\n        <!-- Yazı Boyutu Kontrolü -->\n        <div class=\"inline-flex items-center rounded-xl bg-slate-200/80 p-1 text-slate-800\" title=\"Yazı Boyutunu Ayarla\">\n          <button id=\"btn-font-down\" onclick=\"changeFontSize(-1)\" class=\"px-2.5 py-1 rounded-lg text-xs sm:text-sm font-extrabold hover:bg-white transition-all\" aria-label=\"Yazıyı Küçült\">\n            A-\n          </button>\n          <span id=\"font-size-label\" class=\"px-2 text-xs font-bold uppercase tracking-wide\">\n            Büyük\n          </span>\n          <button id=\"btn-font-up\" onclick=\"changeFontSize(1)\" class=\"px-2.5 py-1 rounded-lg text-xs sm:text-sm font-extrabold hover:bg-white transition-all\" aria-label=\"Yazıyı Büyüt\">\n            A+\n          </button>\n        </div>\n\n        <!-- Tüm Cevapları Aç/Kapat -->\n        <button id=\"btn-toggle-all\" onclick=\"toggleAllAnswers()\" class=\"px-3 py-1.5 rounded-xl text-xs sm:text-sm font-bold bg-amber-500 hover:bg-amber-600 text-white shadow-sm transition-all flex items-center gap-1\">\n          <span id=\"toggle-all-text\">Tüm Cevapları Göster</span>\n        </button>\n\n        <!-- Gece / Gündüz Modu -->\n        <button id=\"btn-theme\" onclick=\"toggleTheme()\" class=\"px-2.5 py-1.5 rounded-xl bg-slate-200 hover:bg-slate-300 text-slate-800 font-bold text-xs sm:text-sm transition-all\" title=\"Gece / Gündüz Modu\">\n          <span id=\"theme-icon\">🌙 Koyu Mod</span>\n        </button>\n      </div>\n    </div>\n\n    <!-- Sunum Modu Hızlı Soru Geçiş Barı -->\n    <div id=\"slide-nav-bar\" class=\"hidden border-t border-slate-200 bg-slate-50/90 px-4 py-2\">\n      <div class=\"max-w-6xl mx-auto flex flex-wrap items-center justify-between gap-2\">\n        <button id=\"btn-prev-q\" onclick=\"navigateSlide(-1)\" class=\"px-4 py-1.5 rounded-xl font-bold text-sm sm:text-base bg-white border border-slate-300 text-slate-800 hover:bg-slate-100 disabled:opacity-40 transition-all\">\n          ← Önceki Soru\n        </button>\n        <div id=\"question-pills\" class=\"flex items-center gap-2 flex-wrap\"></div>\n        <button id=\"btn-next-q\" onclick=\"navigateSlide(1)\" class=\"px-4 py-1.5 rounded-xl font-bold text-sm sm:text-base bg-teal-700 text-white hover:bg-teal-800 disabled:opacity-40 transition-all\">\n          Sonraki Soru →\n        </button>\n      </div>\n    </div>\n  </header>\n\n  <!-- Ana İçerik -->\n  <main class=\"max-w-[1920px] mx-auto px-3 pt-2.5\">\n    <!-- Sorular Konteyneri -->\n    <div id=\"questions-container\" class=\"grid grid-cols-1 lg:grid-cols-3 gap-3 items-stretch\"></div>\n  </main>\n\n  <script>\n    const questionsData = [\n      {\n        id: 1,\n        points: \"2 x 5 = 10\",\n        badge: \"Soru 1\",\n        topic: \"Peygamberimiz ve Hz. Hatice’nin Lakapları\",\n        icon: \"🌟\",\n        context: \"• Peygamberimizin Lakabı: ....................................................\\n• Hz. Hatice’nin Lakabı: ........................................................\",\n        prompt: \"Sevgili Peygamberimize emanetleri koruduğu ve çok güvenilir olduğu için Mekkeliler tarafından verilen lakap ile ilk eşi Hz. Hatice’ye güzel ahlakı ve iffetinden dolayı verilen lakabı yazınız.\",\n        explanation: \"Peygamberimizin lakabını doğru yazma: 5 Puan • Hz. Hatice’nin lakabını doğru yazma: 5 Puan.\",\n        sampleAnswer: \"• Peygamberimizin Lakabı: Muhammedülemin / el-Emin (Güvenilir Muhammed)\\n• Hz. Hatice’nin Lakabı: Tahire (Tertemiz kadın)\"\n      },\n      {\n        id: 2,\n        points: \"4 x 3 = 12\",\n        badge: \"Soru 2\",\n        topic: \"Peygamber Efendimizin Çocukları\",\n        icon: \"👨‍👩‍👧‍👦\",\n        context: \"1. ....................................................   3. ....................................................\\n2. ....................................................   4. ....................................................\",\n        prompt: \"Peygamber Efendimiz ile Hz. Hatice’nin evliliğinden dünyaya gelen çocuklarından dört tanesinin ismini yazınız.\",\n        explanation: \"Bu altı isimden herhangi dört tanesini doğru yazan öğrenciye tam puan verilir. Her doğru isim 3 puandır.\",\n        sampleAnswer: \"• Kasım\\n• Abdullah\\n• Zeyneb\\n• Rukiye\\n• Ümmü Gülsüm\\n• Fatıma\"\n      },\n      {\n        id: 3,\n        points: \"3 x 4 = 12\",\n        badge: \"Soru 3\",\n        topic: \"İlk Vahiy ve Hira Mağarası\",\n        icon: \"⛰️\",\n        context: \"• İlk Vahyin Geldiği Mağara: ................................................\\n• Vahiy Meleğinin Adı: ..........................................................\\n• İlk İnen Ayetlerin Suresi: ...................................................\",\n        prompt: \"Sevgili Peygamberimize ilk vahyin geldiği mağaranın adını, vahyi getiren meleğin adını ve ilk inen ayetlerin hangi sureye ait olduğunu yazınız.\",\n        explanation: \"Mağara adı: 4 Puan • Vahiy meleği: 4 Puan • İlk inen sure: 4 Puan.\",\n        sampleAnswer: \"• İlk Vahyin Geldiği Mağara: (Nur Dağı’ndaki) Hira Mağarası\\n• Vahiy Meleğinin Adı: Cebrail (a.s.)\\n• İlk İnen Ayetlerin Suresi: Alak Suresi (1-5. ayetler)\"\n      },\n      {\n        id: 4,\n        points: \"3 x 4 = 12\",\n        badge: \"Soru 4\",\n        topic: \"Müslümanların İlk Üç Savaşı\",\n        icon: \"🛡️\",\n        context: \"1. İlk Savaş (624): .............................................................\\n2. İkinci Savaş (625): ........................................................\\n3. Üçüncü Savaş (627): ......................................................\",\n        prompt: \"Müslümanların inançlarını özgürce yaşayabilmek için Mekkeli müşriklerle yaptıkları ilk üç savaşın ismini sırasıyla yazınız.\",\n        explanation: \"Sırasıyla her doğru savaş ismi 4 puandır (3 x 4 = 12 Puan).\",\n        sampleAnswer: \"1. İlk Savaş (624): Bedir Savaşı\\n2. İkinci Savaş (625): Uhud Savaşı\\n3. Üçüncü Savaş (627): Hendek Savaşı\"\n      },\n      {\n        id: 5,\n        points: \"4 x 4 = 16\",\n        badge: \"Soru 5\",\n        topic: \"Temel Kavramlar\",\n        icon: \"📖\",\n        context: \"a. Hilfülfudul: .....................................................................\\nb. Tefekkür: ........................................................................\\nc. Muhacir: ........................................................................\\nd. Ensar: ............................................................................\",\n        prompt: \"Yukarıda verilen kavramların tanımlarını kısaca yanlarına yazınız.\",\n        explanation: \"Her kavramın doğru açıklaması 4 puandır (4 x 4 = 16 Puan).\",\n        sampleAnswer: \"• a. Hilfülfudul: Mekke’de can ve mal güvenliğini sağlamak, güçsüzleri ve haksızlığa uğrayanları korumak amacıyla kurulan ve Hz. Peygamber’in de katıldığı barış cemiyeti / Erdemliler Birliği.\\n• b. Tefekkür: Allah’ın yarattığı varlıklar ve kâinat üzerinde derin düşünme, fikir yürütme, kavramaya çalışma.\\n• c. Muhacir: İnançlarını yaşamak için Mekke’den Medine’ye hicret (göç) eden Müslümanlar.\\n• d. Ensar: Mekkeli muhacirlere kucak açıp her konuda yardım eden Medineli Müslümanlar.\"\n      },\n      {\n        id: 6,\n        points: \"12\",\n        badge: \"Soru 6\",\n        topic: \"Hüzün Yılı (620)\",\n        icon: \"🕊️\",\n        context: \"Mekkeli müşriklerin uyguladığı üç yıllık ağır boykotun hemen ardından 620 yılında yaşanan acı olaylar Müslümanları derinden üzmüştür.\",\n        prompt: \"İslam tarihinde 620 yılına neden “Hüzün Yılı” adı verilmiştir? Kısaca açıklayınız.\",\n        explanation: \"Ebu Talib’in vefatını belirtme: 6 Puan • Hz. Hatice’nin vefatını belirtme: 6 Puan.\",\n        sampleAnswer: \"Boykot yıllarının hemen ardından (620 yılında), Peygamber Efendimiz’i her zaman koruyup destekleyen amcası Ebu Talib ve çok sevdiği eşi Hz. Hatice’nin art arda vefat etmesi Peygamberimizi derin bir üzüntüye boğmuştur. Bu yüzden bu yıla “Hüzün Yılı” denmiştir.\"\n      },\n      {\n        id: 7,\n        points: \"14\",\n        badge: \"Soru 7\",\n        topic: \"Kâbe Hakemliği Olayı\",\n        icon: \"🕋\",\n        context: \"Peygamber Efendimiz 35 yaşındayken Kâbe’nin onarımı sırasında Hacerülesved taşını yerine koyma konusunda kabileler arasında neredeyse savaşa yol açacak bir anlaşmazlık çıkmıştır.\",\n        prompt: \"Kâbe’nin onarımı sırasında Hacerülesved taşını yerine koyma konusunda kabileler arasında çıkan anlaşmazlığı Peygamber Efendimiz (Kâbe Hakemliği olayında) nasıl çözmüştür? Kısaca anlatınız.\",\n        explanation: \"Hırka/örtü yöntemini ve kabilelerin birlikte taşımasını açıklama: 10 Puan • Taşı bizzat yerine koyup uzlaşma sağlamasını belirtme: 4 Puan.\",\n        sampleAnswer: \"Peygamber Efendimiz hakemliği kabul etmiş, üzerindeki hırkasını (örtüyü) yere sererek Hacerülesved taşını ortasına koymuştur. Her kabilenin temsilcisinden hırkanın uçlarından tutarak taşı birlikte kaldırmalarını istemiş, taş yerine ulaşınca kendi mübarek elleriyle yerine yerleştirmiştir. Böylece kabileler arasında kan dökülmesini önleyip barışı sağlamıştır.\"\n      },\n      {\n        id: 8,\n        points: \"3 x 4 = 12\",\n        badge: \"Soru 8\",\n        topic: \"Müminlerin Kardeşliği ve Gençlik Ahlakı\",\n        icon: \"🤝\",\n        context: \"“Müminler birbirlerini sevip korumakta ve birbirlerine merhamet etmekte bir vücuda benzerler. Vücudun bir organı hasta olduğu zaman diğer organlar da bu sebeple uykusuz kalır ve ateşli hastalığa tutulurlar.” (Hadis-i Şerif)\",\n        prompt: \"Yukarıdaki hadis-i şerifi ve Peygamberimizin gençlik ahlakını örnek alan bir öğrencinin, çevresine ve arkadaşlarına karşı yapması gereken güzel davranışlardan üç tanesini maddeler halinde yazınız.\",\n        explanation: \"Öğrencinin yazdığı her anlamlı ve doğru madde 4 puandır (3 x 4 = 12 Puan).\",\n        sampleAnswer: \"• Arkadaşlarının üzüntüsünü ve sevincini paylaşmak, zor zamanlarında onlara destek olmak.\\n• Çevresindeki insanlara karşı merhametli, şefkatli, saygılı ve anlayışlı davranmak.\\n• Haksızlığa veya zorbalığa uğrayan arkadaşlarının yanında durmak, adaletli olmak.\\n• Tartışan veya küsen arkadaşlarını barıştırmak, uzlaştırıcı ve güvenilir olmak.\"\n      },\n      {\n        id: 9,\n        points: \"2 x 5 = 10\",\n        badge: \"Soru 9 • Ek\",\n        topic: \"Cahiliye Dönemi ve Hanif İnancı\",\n        icon: \"🏺\",\n        context: \"• İslam Öncesi Mekke’deki Karanlık Dönem: .......................................\\n• Hz. İbrahim’in Tevhit İnancını Sürdürenler: ....................................\",\n        prompt: \"İslamiyet öncesi Mekke’de putperestliğin, kan davalarının ve haksızlıkların yaygın olduğu döneme ne ad verilir? Bu dönemde putlardan uzak durup Hz. İbrahim’in tevhit inancını sürdüren kimselere ne denir?\",\n        explanation: \"Cahiliye Dönemi kavramını ve özelliklerini belirtme: 5 Puan • Hanif kavramını belirtme: 5 Puan.\",\n        sampleAnswer: \"• Cahiliye Dönemi: İslam öncesi Mekke’de putperestliğin, falcılığın, kumarın, kan davalarının; kadınlara, kız çocuklarına ve zayıflara zulmün yaygın olduğu dönemdir.\\n• Hanif: Hz. İbrahim’in (a.s.) tevhit (Allah’ın birliği) inancını sürdüren ve putlara tapmayan kimselerdir.\"\n      },\n      {\n        id: 10,\n        points: \"2 x 5 = 10\",\n        badge: \"Soru 10 • Ek\",\n        topic: \"Ahde Vefa ve Nebevi Nezaket\",\n        icon: \"🌿\",\n        context: \"“Ve sen, elbette yüce bir ahlak üzeresin.” (Kalem suresi, 4. ayet)\\nPeygamberimiz, Abdullah b. Ebu Hamsa ile yaptığı alışverişte sözleştiği yerde üç gün beklemiştir.\",\n        prompt: \"Peygamberimizin sözleştiği yerde üç gün beklemesi onun hangi özelliğini gösterir? Ayrıca Enes b. Malik’in anlattığına göre Peygamberimizin tokalaşırken ve otururken dikkat ettiği nezaket kurallarını yazınız.\",\n        explanation: \"Ahde vefa (sözünde durma) özelliğini yazma: 5 Puan • Nebevi nezaket kurallarını yazma: 5 Puan.\",\n        sampleAnswer: \"• Sözleştiği yerde üç gün beklemesi onun 'Ahde Vefa' (verdiği sözde durma) ve dürüstlük özelliğinin en güzel örneğidir.\\n• Nebevi Nezaketi: Tokalaştığı kişinin eli çekilmeden kendi elini çekmez, muhatabından yüzünü başka tarafa çevirmez ve insanların yanında asla ayak uzatıp oturmazdı.\"\n      },\n      {\n        id: 11,\n        points: \"2 x 6 = 12\",\n        badge: \"Soru 11 • Ek\",\n        topic: \"İlk Müslümanlar ve Darülerkâm\",\n        icon: \"🏠\",\n        context: \"• İlk İnanan Dört Kişi (İlk Müslümanlar): ...........................................\\n• Gizli Tebliğ Yıllarında Karargâh Olan Ev: ........................................\",\n        prompt: \"Sevgili Peygamberimize ilk vahiy geldikten sonra ona ilk inanan dört kişiyi ve İslam’ın gizli tebliğ yıllarında eğitim ve tebliğ merkezi yapılan evin adını yazınız.\",\n        explanation: \"İlk dört Müslümanı doğru yazma: 6 Puan • Darülerkâm’ı belirtme: 6 Puan.\",\n        sampleAnswer: \"• İlk Müslümanlar: Hz. Hatice (ilk kadın), Hz. Ali (ilk çocuk), Zeyd b. Harise (azatlı kölesi) ve Hz. Ebu Bekir (ilk hür erkek).\\n• Gizli Tebliğ Evi: Darülerkâm (Erkam bin Ebülerkam’ın Kâbe yakınındaki evi).\"\n      },\n      {\n        id: 12,\n        points: \"2 x 5 = 10\",\n        badge: \"Soru 12 • Ek\",\n        topic: \"İlk Hicret Yeri (Habeşistan - 615)\",\n        icon: \"⛵\",\n        context: \"⚠️ Dikkat Noktası: Mekkeli müşriklerin baskı ve işkenceleri artınca Müslümanların bir kısmı MS 615 yılında ilk hicreti gerçekleştirmiştir.\",\n        prompt: \"Müslümanların İslam tarihinde ilk hicret ettiği yer neresidir ve oradaki hükümdarın en belirgin özelliği nedir? Açıklayınız.\",\n        explanation: \"İlk hicret yerinin Medine değil Habeşistan olduğunu belirtme: 5 Puan • Adil hükümdar Necaşi’yi belirtme: 5 Puan.\",\n        sampleAnswer: \"• İlk Hicret Yeri: Müslümanların ilk hicret ettiği yer Medine değil, Habeşistan’dır (MS 615). (Medine’ye hicret 622’dedir.)\\n• Hükümdar: Habeşistan’da yanında kimseye zulmedilmeyen adil hükümdar Necaşi bulunmaktaydı.\"\n      },\n      {\n        id: 13,\n        points: \"3 x 4 = 12\",\n        badge: \"Soru 13 • Ek\",\n        topic: \"Hira ve Sevr Mağaraları ile Varaka b. Nevfel\",\n        icon: \"⛰️\",\n        context: \"• İlk Vahyin Alındığı Mağara: ...........................................................\\n• Hicret Sırasında Hz. Ebu Bekir ile Gizlenilen Mağara: ....................\\n• İlk Vahiyden Sonra Danışılan Bilge Akraba: ...................................\",\n        prompt: \"Sıkça karıştırılan iki mağarayı görevlerine göre ayırt ederek yazınız ve ilk vahiy sonrası Hz. Hatice’nin Peygamberimizi götürdüğü bilge akrabasının adını belirtiniz.\",\n        explanation: \"Hira Mağarası: 4 Puan • Sevr Mağarası: 4 Puan • Varaka b. Nevfel: 4 Puan.\",\n        sampleAnswer: \"• İlk Vahyin Alındığı Mağara: Nur Dağı’ndaki Hira Mağarası (610)\\n• Hicret Sırasında Gizlenilen Mağara: Sevr Mağarası (622)\\n• Bilge Akraba: Varaka b. Nevfel (Gelenin vahiy meleği Cebrail olduğunu müjdelemiştir.)\"\n      },\n      {\n        id: 14,\n        points: \"2 x 5 = 10\",\n        badge: \"Soru 14 • Ek\",\n        topic: \"Boykot Yılları (616-619) ve Taif Yolculuğu\",\n        icon: \"📜\",\n        context: \"• 616-619 Üç Yıllık Sosyal ve Ticari Ambargo: ..................................\\n• 620 Yılında İslam’ı Anlatmak İçin Gidilen Şehir: ...........................\",\n        prompt: \"Mekkeli müşriklerin Haşimoğulları ve Müslümanlara uyguladığı 3 yıllık ambargoya ne ad verilir? Ayrıca Hüzün Yılı’nda (620) Peygamberimiz İslam’ı yaymak için nereye gitmiştir?\",\n        explanation: \"Boykot Yılları’nı açıklama: 5 Puan • Taif Seferi’ni belirtme: 5 Puan.\",\n        sampleAnswer: \"• Boykot Yılları (616-619): Müşriklerin Müslümanlarla ve Haşimoğullarıyla konuşmama, alışveriş yapmama ve kız alıp vermeme şeklinde uyguladığı 3 yıllık ağır ambargodur.\\n• Gidilen Şehir: Taif (MS 620 Taif Seferi).\"\n      },\n      {\n        id: 15,\n        points: \"3 x 4 = 12\",\n        badge: \"Soru 15 • Ek\",\n        topic: \"Akabe Biatleri, Mescid-i Nebevi ve Suffe\",\n        icon: \"🕌\",\n        context: \"• Medinelilerle Yapılan Sözleşmeler: .................................................\\n• Medine’de İnşa Edilen Mescit ve Yanındaki Okul: .........................\\n• Ensar ve Muhacir Kardeşliği: ..........................................................\",\n        prompt: \"Medinelilerin Müslüman olup Peygamberimizi davet ettikleri biatlerin adını, Medine’de kimsesizler ve ilim öğrenenler için yapılan okul bölümünü ve Ensar-Muhacir kardeşlik uygulamasını yazınız.\",\n        explanation: \"Akabe Biatleri: 4 Puan • Mescid-i Nebevi ve Suffe: 4 Puan • Muâhât (Kardeşlik): 4 Puan.\",\n        sampleAnswer: \"• Medinelilerle Yapılan Sözleşmeler: I. ve II. Akabe Biatleri\\n• Mescit ve İlim Okulu: Mescid-i Nebevi ve yanındaki okul bölümü olan Suffe\\n• Kardeşlik Antlaşması: Muâhât (Ensar ile Muhacir arasında kurulan kardeşlik)\"\n      },\n      {\n        id: 16,\n        points: \"4 x 3 = 12\",\n        badge: \"Soru 16 • Ek\",\n        topic: \"Ünitenin Önemli Olaylar Kronolojisi\",\n        icon: \"⏳\",\n        context: \"• MS 580: .................................   • MS 622: .................................\\n• MS 630: .................................   • MS 632: .................................\",\n        prompt: \"Peygamber Efendimizin hayatındaki önemli dönüm noktalarından yukarıda verilen yıllarda gerçekleşen olayları sırasıyla yazınız.\",\n        explanation: \"Her tarihin karşısına doğru olayı yazma 3 puandır (4 x 3 = 12 Puan).\",\n        sampleAnswer: \"• MS 580: Hilfülfudul Antlaşması (Gençlik yıllarında Erdemliler Birliği kuruldu).\\n• MS 622: Hicret (Mekke’den Medine’ye göç edildi ve İslam devletinin temelleri atıldı).\\n• MS 630: Mekke’nin Fethi (Kan dökülmeden Mekke fethedildi ve genel af ilan edildi).\\n• MS 632: Veda Haccı yapıldı, Veda Hutbesi okundu ve 8 Haziran 632’de vefat etti.\"\n      }\n    ];\n\n    let viewMode = 'triple'; // 'triple' (ekranda 3 soru), 'list' (tümü), 'slide' (tek tek)\n    let triplePage = 0; // 0: Soru 1-2-3, 1: Soru 4-5-6, 2: Soru 6-7-8\n    let tripleColumns = true; // true: Yan Yana 3 Sütun, false: Alt Alta 3 Satır\n    let currentSlideIndex = 0;\n    let revealedMap = {};\n    let fontLevel = 1;\n    let isDark = false;\n\n    const fontPresets = [\n      { label: \"Kompakt\", qSize: \"1.05rem\", qLine: \"1.45rem\", aSize: \"1.0rem\",  aLine: \"1.4rem\" },\n      { label: \"Büyük\",   qSize: \"1.22rem\", qLine: \"1.68rem\", aSize: \"1.14rem\", aLine: \"1.55rem\" },\n      { label: \"Çok Büyük\", qSize: \"1.42rem\", qLine: \"1.95rem\", aSize: \"1.3rem\", aLine: \"1.8rem\" },\n      { label: \"Dev\",     qSize: \"1.68rem\", qLine: \"2.3rem\",  aSize: \"1.52rem\", aLine: \"2.1rem\" },\n      { label: \"Maksimum\", qSize: \"2.0rem\", qLine: \"2.7rem\",  aSize: \"1.8rem\",  aLine: \"2.45rem\" }\n    ];\n\n    function applyFontPreset() {\n      const preset = fontPresets[fontLevel];\n      document.documentElement.style.setProperty('--q-font-size', preset.qSize);\n      document.documentElement.style.setProperty('--q-line-height', preset.qLine);\n      document.documentElement.style.setProperty('--a-font-size', preset.aSize);\n      document.documentElement.style.setProperty('--a-line-height', preset.aLine);\n      const labelEl = document.getElementById('font-size-label');\n      if (labelEl) labelEl.textContent = preset.label;\n    }\n\n    function changeFontSize(delta) {\n      const next = fontLevel + delta;\n      if (next >= 0 && next < fontPresets.length) {\n        fontLevel = next;\n        applyFontPreset();\n      }\n    }\n\n    function toggleTheme() {\n      isDark = !isDark;\n      const body = document.getElementById('app-body');\n      const icon = document.getElementById('theme-icon');\n      if (isDark) {\n        body.classList.add('dark-theme');\n        icon.textContent = '☀️ Açık Mod';\n      } else {\n        body.classList.remove('dark-theme');\n        icon.textContent = '🌙 Koyu Mod';\n      }\n    }\n\n    function setTriplePage(pageIdx) {\n      triplePage = pageIdx;\n      if (viewMode !== 'triple') {\n        setViewMode('triple');\n        return;\n      }\n      updateTripleNavButtons();\n      renderQuestions();\n    }\n\n    function toggleTripleLayout() {\n      tripleColumns = !tripleColumns;\n      const txt = document.getElementById('layout-toggle-text');\n      if (txt) {\n        txt.textContent = tripleColumns ? '⊞ Yan Yana (3 Sütun)' : '☰ Alt Alta (3 Satır)';\n      }\n      renderQuestions();\n    }\n\n    function updateTripleNavButtons() {\n      const ids = ['btn-page-1', 'btn-page-2', 'btn-page-3', 'btn-page-4', 'btn-page-5', 'btn-page-6'];\n      ids.forEach((id, idx) => {\n        const btn = document.getElementById(id);\n        if (!btn) return;\n        if (idx === triplePage) {\n          btn.className = \"px-2 py-1 rounded-lg text-xs font-extrabold transition-all bg-teal-700 text-white shadow-sm\";\n        } else {\n          btn.className = \"px-2 py-1 rounded-lg text-xs font-extrabold transition-all hover:bg-white/70\";\n        }\n      });\n    }\n\n    function setViewMode(mode) {\n      viewMode = mode;\n      const btnTriple = document.getElementById('btn-mode-triple');\n      const btnList = document.getElementById('btn-mode-list');\n      const btnSlide = document.getElementById('btn-mode-slide');\n      const slideNav = document.getElementById('slide-nav-bar');\n      const tripleNav = document.getElementById('triple-nav-group');\n\n      const activeCls = \"px-2.5 py-1 rounded-lg text-xs sm:text-sm font-bold transition-all bg-white shadow-sm text-teal-700\";\n      const idleCls = \"px-2.5 py-1 rounded-lg text-xs sm:text-sm font-bold transition-all hover:bg-white/60\";\n\n      if (btnTriple) btnTriple.className = mode === 'triple' ? activeCls : idleCls;\n      if (btnList) btnList.className = mode === 'list' ? activeCls : idleCls;\n      if (btnSlide) btnSlide.className = mode === 'slide' ? activeCls : idleCls;\n\n      if (mode === 'slide') {\n        slideNav.classList.remove('hidden');\n      } else {\n        slideNav.classList.add('hidden');\n      }\n\n      if (tripleNav) {\n        if (mode === 'triple') {\n          tripleNav.classList.remove('hidden');\n        } else {\n          tripleNav.classList.add('hidden');\n        }\n      }\n\n      renderQuestions();\n    }\n\n    function navigateSlide(dir) {\n      const next = currentSlideIndex + dir;\n      if (next >= 0 && next < questionsData.length) {\n        currentSlideIndex = next;\n        renderQuestions();\n        window.scrollTo({ top: 0, behavior: 'smooth' });\n      }\n    }\n\n    function goToQuestion(idx) {\n      currentSlideIndex = idx;\n      renderQuestions();\n      window.scrollTo({ top: 0, behavior: 'smooth' });\n    }\n\n    function toggleAnswer(qId) {\n      revealedMap[qId] = !revealedMap[qId];\n      renderQuestions();\n    }\n\n    function toggleAllAnswers() {\n      const allOpen = questionsData.every(q => revealedMap[q.id]);\n      questionsData.forEach(q => {\n        revealedMap[q.id] = !allOpen;\n      });\n      renderQuestions();\n    }\n\n    function formatMultiline(text) {\n      return text.split('\\n').map(line => `<p class=\"mb-1.5 last:mb-0\">${line}</p>`).join('');\n    }\n\n    function renderSlidePills() {\n      const pillsContainer = document.getElementById('question-pills');\n      if (!pillsContainer) return;\n      pillsContainer.innerHTML = questionsData.map((q, idx) => {\n        const isCurrent = idx === currentSlideIndex;\n        const isRevealed = !!revealedMap[q.id];\n        let cls = \"w-10 h-10 rounded-xl font-extrabold text-sm sm:text-base transition-all flex items-center justify-center border-2 \";\n        if (isCurrent) {\n          cls += \"bg-teal-700 text-white border-teal-700 shadow-md scale-105\";\n        } else if (isRevealed) {\n          cls += \"bg-teal-100 text-teal-800 border-teal-300\";\n        } else {\n          cls += \"bg-white text-slate-700 border-slate-300 hover:bg-slate-100\";\n        }\n        return `<button onclick=\"goToQuestion(${idx})\" class=\"${cls}\" title=\"${q.badge} (${q.points} Puan)\">${q.id}</button>`;\n      }).join('');\n\n      const prevBtn = document.getElementById('btn-prev-q');\n      const nextBtn = document.getElementById('btn-next-q');\n      if (prevBtn) prevBtn.disabled = currentSlideIndex === 0;\n      if (nextBtn) nextBtn.disabled = currentSlideIndex === questionsData.length - 1;\n    }\n\n    function updateCounters() {\n      const openCount = questionsData.filter(q => revealedMap[q.id]).length;\n      const counterEl = document.getElementById('revealed-counter');\n      if (counterEl) counterEl.textContent = `${openCount} / ${questionsData.length}`;\n\n      const toggleAllText = document.getElementById('toggle-all-text');\n      if (toggleAllText) {\n        toggleAllText.textContent = openCount === questionsData.length ? \"Tüm Cevapları Gizle\" : \"Tüm Cevapları Göster\";\n      }\n    }\n\n    function renderQuestions() {\n      const container = document.getElementById('questions-container');\n      let itemsToShow = questionsData;\n\n      if (viewMode === 'triple') {\n        const startMap = [0, 3, 5, 8, 11, 13]; // Her ekranda tam 3 soru: 1-3, 4-6, 6-8, 9-11, 12-14, 14-16\n        const start = startMap[triplePage] !== undefined ? startMap[triplePage] : 0;\n        itemsToShow = questionsData.slice(start, start + 3);\n        if (tripleColumns) {\n          container.className = \"grid grid-cols-1 lg:grid-cols-3 gap-3 items-stretch\";\n        } else {\n          container.className = \"grid grid-cols-1 gap-2.5\";\n        }\n      } else if (viewMode === 'list') {\n        itemsToShow = questionsData;\n        container.className = \"grid grid-cols-1 lg:grid-cols-3 gap-3 items-stretch\";\n      } else {\n        itemsToShow = [questionsData[currentSlideIndex]];\n        container.className = \"max-w-5xl mx-auto space-y-4\";\n      }\n\n      container.innerHTML = itemsToShow.map(q => {\n        const isOpen = !!revealedMap[q.id];\n        return `\n          <section class=\"card-surface bg-white border-2 border-slate-200 rounded-2xl p-4 sm:p-5 shadow-sm transition-all flex flex-col justify-between\">\n            <div>\n              <!-- Soru Üst Başlık -->\n              <div class=\"flex items-center justify-between gap-2 pb-2.5 mb-3 border-b border-slate-100\">\n                <div class=\"flex items-center gap-2 min-w-0\">\n                  <span class=\"text-2xl select-none shrink-0\">${q.icon}</span>\n                  <span class=\"px-2.5 py-0.5 rounded-lg bg-teal-700 text-white font-extrabold text-sm sm:text-base shrink-0\">\n                    ${q.badge}\n                  </span>\n                  <span class=\"text-xs sm:text-sm font-bold text-slate-500 muted-text truncate\">\n                    ${q.topic}\n                  </span>\n                </div>\n                <div class=\"px-2.5 py-0.5 rounded-lg bg-amber-100 text-amber-900 font-extrabold text-xs sm:text-sm border border-amber-300 shrink-0\">\n                  ${q.points} Puan\n                </div>\n              </div>\n\n              <!-- Soru Kökü -->\n              <div class=\"question-text font-extrabold mb-3 flex items-start gap-2\">\n                <span class=\"text-teal-700 shrink-0\">➤</span>\n                <span>${q.prompt}</span>\n              </div>\n\n              <!-- Soru Öncülü / Boşluk Alanı -->\n              <div class=\"quote-box bg-slate-50 border-l-4 border-teal-600 rounded-xl p-3 sm:p-3.5 mb-3.5 text-slate-800 question-text font-medium\">\n                ${formatMultiline(q.context)}\n              </div>\n            </div>\n\n            <div>\n              <!-- Cevabı Göster / Gizle Butonu -->\n              <button onclick=\"toggleAnswer(${q.id})\" class=\"w-full px-4 py-2.5 rounded-xl font-extrabold text-base sm:text-lg transition-all shadow-sm flex items-center justify-center gap-2 ${\n                isOpen\n                  ? 'bg-rose-600 hover:bg-rose-700 text-white'\n                  : 'bg-teal-700 hover:bg-teal-800 text-white'\n              }\">\n                <span>${isOpen ? '🙈 Cevabı Gizle' : '👁️ Cevabı Göster (Tıkla)'}</span>\n              </button>\n\n              <!-- Açılır Cevap Alanı -->\n              <div class=\"answer-panel ${isOpen ? 'open' : ''}\">\n                <div class=\"space-y-2.5 pt-1\">\n                  <div class=\"answer-box-primary bg-emerald-50 border-2 border-emerald-400 rounded-xl p-3.5 text-emerald-950 shadow-sm\">\n                    <div class=\"flex items-center gap-1.5 font-extrabold text-xs sm:text-sm uppercase tracking-wider text-emerald-800 mb-1\">\n                      <span>✅ Beklenen Doğru Cevap</span>\n                    </div>\n                    <div class=\"answer-text font-bold\">\n                      ${formatMultiline(q.sampleAnswer)}\n                    </div>\n                  </div>\n\n                  ${q.explanation ? `\n                    <div class=\"answer-box-secondary bg-blue-50 border border-blue-300 rounded-xl p-3 text-blue-950\">\n                      <div class=\"flex items-center gap-1.5 font-extrabold text-xs uppercase tracking-wider text-blue-700 mb-1\">\n                        <span>📌 Puanlama Ölçütü</span>\n                      </div>\n                      <div class=\"answer-text font-medium\">\n                        ${formatMultiline(q.explanation)}\n                      </div>\n                    </div>\n                  ` : ''}\n                </div>\n              </div>\n            </div>\n          </section>\n        `;\n      }).join('');\n\n      renderSlidePills();\n      updateTripleNavButtons();\n      updateCounters();\n    }\n\n    // Klavye Kısayolları\n    window.addEventListener('keydown', function(e) {\n      if (viewMode === 'slide') {\n        if (e.key === 'ArrowRight') {\n          navigateSlide(1);\n        } else if (e.key === 'ArrowLeft') {\n          navigateSlide(-1);\n        } else if (e.key === ' ' || e.key === 'Enter') {\n          if (document.activeElement && document.activeElement.tagName === 'BUTTON') return;\n          e.preventDefault();\n          const currentQ = questionsData[currentSlideIndex];\n          if (currentQ) toggleAnswer(currentQ.id);\n        }\n      } else if (viewMode === 'triple') {\n        if (e.key === 'ArrowRight' && triplePage < 5) {\n          setTriplePage(triplePage + 1);\n        } else if (e.key === 'ArrowLeft' && triplePage > 0) {\n          setTriplePage(triplePage - 1);\n        }\n      }\n    });\n\n    // Başlangıç Yüklemesi\n    applyFontPreset();\n    renderQuestions();\n  </script>\n</body>\n</html>",
