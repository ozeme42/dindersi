{
  "id": "UIKngyqndpLK1LSw9tEG",
  "title": "Medler Etkinlik",
  "category": "Kur'an-ı Kerim/Tecvid",
  "description": "",
  "isPublished": true,
  "htmlContent": "<!DOCTYPE html>\n<html lang=\"tr\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Medler – Uygulama ve Etkinlik Merkezi</title>\n<link href=\"https://fonts.googleapis.com/css2?family=Amiri:wght@700&family=Nunito:wght@400;600;700;800;900&family=Playfair+Display:wght@900&display=swap\" rel=\"stylesheet\">\n<style>\n  :root {\n    --emerald:   #064e3b;\n    --emerald2:  #059669;\n    --gold:      #f59e0b;\n    --slate:     #1e293b;\n    --off-white: #f8fafc;\n    --white:     #ffffff;\n    --hl-red:    #dc2626;\n    --hl-blue:   #2563eb;\n    --f-scale:   1;\n  }\n\n  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }\n\n  body {\n    font-family: 'Nunito', sans-serif;\n    background: #0f172a;\n    color: var(--white);\n    overflow: hidden;\n    height: 100vh;\n    width: 100vw;\n  }\n\n  /* ── PRESENTATION SHELL ─────────────────────────────── */\n  .pres { width: 100vw; height: 100vh; position: relative; overflow: hidden; }\n  .slide { position: absolute; inset: 0; display: flex; flex-direction: column; opacity: 0; pointer-events: none; transition: opacity .5s ease, transform .5s ease; transform: translateX(60px); overflow-y: auto; overflow-x: hidden; padding-bottom: 100px; }\n  .slide.active { opacity: 1; pointer-events: all; transform: translateX(0); }\n  .slide.exit { opacity: 0; transform: translateX(-60px); pointer-events: none; }\n\n  /* ── NAVIGATION ─────────────────────────────────────── */\n  .nav { position: fixed; bottom: 20px; left: 50%; transform: translateX(-50%); display: flex; align-items: center; gap: 14px; background: rgba(0,0,0,.8); backdrop-filter: blur(12px); border: 1px solid rgba(255,255,255,.1); border-radius: 50px; padding: 10px 22px; z-index: 9999; box-shadow: 0 10px 30px rgba(0,0,0,0.5); }\n  .nav button { background: none; border: none; color: var(--gold); font-size: 24px; cursor: pointer; padding: 4px 10px; border-radius: 12px; transition: 0.2s; }\n  .nav button:hover:not(:disabled) { background: rgba(245,158,11,0.2); transform: scale(1.1); }\n  .nav button:disabled { color: #444; cursor: default; }\n  .slide-counter { font-size: 14px; font-weight: 800; min-width: 70px; text-align: center; color: var(--white); }\n\n  /* ── UI ELEMENTS ────────────────────────────────────── */\n  .section-title { font-family: 'Playfair Display', serif; font-size: calc(clamp(28px, 4vw, 50px) * var(--f-scale)); text-align: center; color: var(--gold); margin: 40px 20px 10px; }\n  .section-sub { font-size: calc(18px * var(--f-scale)); text-align: center; color: #cbd5e1; margin-bottom: 30px; font-weight: 600; }\n  \n  .container { max-width: 1200px; margin: 0 auto; width: 90%; }\n  \n  /* Kart Yapıları */\n  .card { background: #1e293b; border: 2px solid #334155; border-radius: 20px; padding: 30px; margin-bottom: 20px; transition: 0.3s; }\n  .card:hover { border-color: var(--emerald2); }\n\n  /* Eşleştirme Alanı */\n  .match-box { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 20px; }\n  .match-item { background: #334155; padding: 15px 20px; border-radius: 12px; cursor: pointer; border: 2px solid transparent; font-weight: 700; transition: 0.2s; display: flex; align-items: center; justify-content: space-between; }\n  .match-item:hover { background: #475569; }\n  .match-item.selected { border-color: var(--gold); background: #1e293b; }\n  .match-item.correct { background: #065f46 !important; border-color: #10b981 !important; pointer-events: none; }\n  \n  /* Soru Yapıları */\n  .q-text { font-size: calc(22px * var(--f-scale)); font-weight: 800; margin-bottom: 20px; color: var(--white); line-height: 1.4; }\n  .opt-list { display: grid; gap: 12px; }\n  .opt-btn { background: #334155; border: 2px solid #475569; padding: 15px 25px; border-radius: 12px; color: var(--white); font-weight: 700; cursor: pointer; text-align: left; transition: 0.2s; font-size: calc(18px * var(--f-scale)); }\n  .opt-btn:hover { background: #475569; border-color: var(--gold); }\n  .opt-btn.correct { background: #059669 !important; border-color: #10b981 !important; }\n  .opt-btn.wrong { background: #991b1b !important; border-color: #ef4444 !important; }\n\n  /* Tecvid Avcısı (Ayetler) */\n  .ayet-hunt { font-family: 'Amiri', serif; font-size: calc(45px * var(--f-scale)); direction: rtl; text-align: center; line-height: 2; padding: 30px; background: #f8fafc; color: #0f172a; border-radius: 20px; margin: 20px 0; border: 4px double var(--gold); }\n  .hunt-word { cursor: pointer; padding: 0 5px; border-radius: 5px; transition: 0.2s; display: inline-block; }\n  .hunt-word:hover { background: #e2e8f0; }\n  .hunt-word.found { background: var(--gold) !important; color: #000 !important; }\n\n  /* Geri Bildirim */\n  .feedback { margin-top: 15px; font-weight: 800; font-size: 18px; min-height: 27px; opacity: 0; transition: 0.3s; }\n  .feedback.show { opacity: 1; }\n  .feedback.success { color: #10b981; }\n  .feedback.error { color: #f87171; }\n\n  /* Mobil Uyumluluk */\n  @media (max-width: 768px) {\n    .match-box { grid-template-columns: 1fr; }\n    .ayet-hunt { font-size: calc(32px * var(--f-scale)); }\n    .slide-inner { padding: 20px; }\n    .section-title { font-size: 28px; }\n  }\n</style>\n</head>\n<body>\n\n<div class=\"pres\">\n\n  <!-- SLAYT 1: GİRİŞ -->\n  <div class=\"slide active\" id=\"s1\" style=\"background: radial-gradient(circle, #064e3b 0%, #022c22 100%);\">\n    <div style=\"margin: auto; text-align: center;\">\n      <div style=\"font-size: 80px; margin-bottom: 20px;\">🏰</div>\n      <h1 class=\"section-title\" style=\"margin:0\">MEDLER ÇALIŞMA ALANI</h1>\n      <p class=\"section-sub\">Tüm Kuralları Uygulama ve Oyunlarla Pekiştir</p>\n      <button onclick=\"go(1)\" style=\"background:var(--gold); border:none; padding:15px 40px; border-radius:50px; font-size:20px; font-weight:900; cursor:pointer; color:#000; box-shadow: 0 10px 20px rgba(0,0,0,0.3);\">Hadi Başlayalım! 🚀</button>\n    </div>\n  </div>\n\n  <!-- SLAYT 2: TANIM EŞLEŞTİRME -->\n  <div class=\"slide\" id=\"s2\">\n    <div class=\"container\">\n      <h2 class=\"section-title\">1. Tanım Eşleştirme</h2>\n      <p class=\"section-sub\">Med isimlerini açıklamalarıyla eşleştirin.</p>\n      \n      <div class=\"match-box\">\n        <div class=\"match-col\">\n          <div class=\"match-item\" onclick=\"selectMatch(this, 'L')\" data-key=\"1\">Med-i Muttasıl</div>\n          <div class=\"match-item\" onclick=\"selectMatch(this, 'L')\" data-key=\"2\">Med-i Tabii</div>\n          <div class=\"match-item\" onclick=\"selectMatch(this, 'L')\" data-key=\"3\">Med-i Lazım</div>\n          <div class=\"match-item\" onclick=\"selectMatch(this, 'L')\" data-key=\"4\">Med-i Arız</div>\n        </div>\n        <div class=\"match-col\">\n          <div class=\"match-item\" onclick=\"selectMatch(this, 'R')\" data-key=\"3\">Med + Şedde / Sükun</div>\n          <div class=\"match-item\" onclick=\"selectMatch(this, 'R')\" data-key=\"1\">Med + Hemze (Aynı Kelime)</div>\n          <div class=\"match-item\" onclick=\"selectMatch(this, 'R')\" data-key=\"4\">Duruşta oluşan geçici sükun</div>\n          <div class=\"match-item\" onclick=\"selectMatch(this, 'R')\" data-key=\"2\">Sebepsiz doğal uzatma</div>\n        </div>\n      </div>\n      <div id=\"match-fb\" class=\"feedback text-center\" style=\"text-align:center\"></div>\n    </div>\n  </div>\n\n  <!-- SLAYT 3: TECVİD AVCISI 1 -->\n  <div class=\"slide\" id=\"s3\">\n    <div class=\"container\">\n      <h2 class=\"section-title\">2. Tecvid Avcısı</h2>\n      <p class=\"section-sub\">Aşağıdaki ayette <b>Med-i Muttasıl</b> olan kelimeyi bulup üzerine tıkla!</p>\n      \n      <div class=\"ayet-hunt\" dir=\"rtl\">\n        إِذَا <span class=\"hunt-word\" onclick=\"checkHunt(this, true, 'Muttasıl')\">جَاءَ</span> نَصْرُ اللَّهِ وَالْفَتْحُ\n      </div>\n      \n      <div id=\"hunt-fb\" class=\"feedback\" style=\"text-align:center; font-size:24px\"></div>\n    </div>\n  </div>\n\n  <!-- SLAYT 4: ÇOKTAN SEÇMELİ 1 -->\n  <div class=\"slide\" id=\"s4\">\n    <div class=\"container\">\n      <h2 class=\"section-title\">3. Hızlı Test</h2>\n      <div class=\"card\">\n        <div class=\"q-text\">Aşağıdaki kelimelerin hangisinde \"Med-i Lin\" kuralı vardır?</div>\n        <div class=\"opt-list\">\n          <button class=\"opt-btn\" onclick=\"checkQ(this, false)\">A) قَالَ (Med-i Tabii)</button>\n          <button class=\"opt-btn\" onclick=\"checkQ(this, true)\">B) خَوْفٌ (Vav harfi ve sükun)</button>\n          <button class=\"opt-btn\" onclick=\"checkQ(this, false)\">C) جَاءَ (Med-i Muttasıl)</button>\n          <button class=\"opt-btn\" onclick=\"checkQ(this, false)\">D) يَقُولُ (Med-i Tabii)</button>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <!-- SLAYT 5: DOĞRU / YANLIŞ -->\n  <div class=\"slide\" id=\"s5\">\n    <div class=\"container\">\n      <h2 class=\"section-title\">4. Doğru mu? Yanlış mı?</h2>\n      <p class=\"section-sub\">Bilgileri hızlıca süzgeçten geçir!</p>\n      \n      <div class=\"card\">\n        <div class=\"q-text\">\"Med-i Munfasıl, med harfi ile sebeb-i med olan hemzenin ayrı kelimelerde bulunmasıdır.\"</div>\n        <div class=\"quiz-btns\" style=\"display:flex; gap:20px\">\n          <button class=\"btn-dogru\" style=\"background:#059669; flex:1; padding:20px; border-radius:15px; border:none; color:white; font-weight:900; cursor:pointer\" onclick=\"handleDY(this, true)\">✅ DOĞRU</button>\n          <button class=\"btn-yanlis\" style=\"background:#dc2626; flex:1; padding:20px; border-radius:15px; border:none; color:white; font-weight:900; cursor:pointer\" onclick=\"handleDY(this, false)\">❌ YANLIŞ</button>\n        </div>\n        <div class=\"dy-feedback feedback\" style=\"text-align:center; margin-top:20px\"></div>\n      </div>\n\n      <div class=\"card\">\n        <div class=\"q-text\">\"Med-i Lazım'ın ölçüsü 1 elif miktarıdır.\"</div>\n        <div class=\"quiz-btns\" style=\"display:flex; gap:20px\">\n          <button class=\"btn-dogru\" style=\"background:#059669; flex:1; padding:20px; border-radius:15px; border:none; color:white; font-weight:900; cursor:pointer\" onclick=\"handleDY(this, false)\">✅ DOĞRU</button>\n          <button class=\"btn-yanlis\" style=\"background:#dc2626; flex:1; padding:20px; border-radius:15px; border:none; color:white; font-weight:900; cursor:pointer\" onclick=\"handleDY(this, true)\">❌ YANLIŞ</button>\n        </div>\n        <div class=\"dy-feedback feedback\" style=\"text-align:center; margin-top:20px\"></div>\n      </div>\n    </div>\n  </div>\n\n  <!-- SLAYT 6: TECVİD AVCISI 2 -->\n  <div class=\"slide\" id=\"s6\">\n    <div class=\"container\">\n      <h2 class=\"section-title\">5. Uzun Med Avı</h2>\n      <p class=\"section-sub\">Aşağıdaki Fatiha suresi ayetinde <b>Med-i Lazım</b>'ı bul!</p>\n      \n      <div class=\"ayet-hunt\" dir=\"rtl\">\n        غَيْرِ الْمَغْضُوبِ عَلَيْهِمْ وَلَا <span class=\"hunt-word\" onclick=\"checkHunt(this, true, 'Lazım')\">الضَّالِّينَ</span>\n      </div>\n      \n      <div id=\"hunt-fb-2\" class=\"feedback\" style=\"text-align:center; font-size:24px\"></div>\n    </div>\n  </div>\n\n  <!-- SLAYT 7: UZATMA MİKTARLARI -->\n  <div class=\"slide\" id=\"s7\">\n    <div class=\"container\">\n      <h2 class=\"section-title\">6. Elif Ölçer</h2>\n      <p class=\"section-sub\">Hangisi <b>en uzun</b> uzatılan meddir?</p>\n      <div class=\"card\" style=\"display:grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap:20px\">\n        <button class=\"opt-btn\" onclick=\"checkQ(this, false)\" style=\"text-align:center\">Med-i Tabii<br>(1 Elif)</button>\n        <button class=\"opt-btn\" onclick=\"checkQ(this, false)\" style=\"text-align:center\">Med-i Munfasıl<br>(4 Elif - Caiz)</button>\n        <button class=\"opt-btn\" onclick=\"checkQ(this, true)\" style=\"text-align:center; border-color:var(--gold)\">Med-i Lazım<br>(4 Elif - Vacip)</button>\n      </div>\n      <p style=\"text-align:center; color:var(--gray); margin-top:20px\"><i>Not: Med-i Lazım her zaman 4 elif çekilmek zorundadır.</i></p>\n    </div>\n  </div>\n\n  <!-- SLAYT 8: SONUÇ -->\n  <div class=\"slide\" id=\"s8\">\n    <div style=\"margin: auto; text-align: center; padding: 40px;\">\n      <div style=\"font-size: 100px;\">🏆</div>\n      <h1 class=\"section-title\">TEBRİKLER ŞAMPİYON!</h1>\n      <p class=\"section-sub\">Medler konusundaki tüm engelleri aştın.</p>\n      <div class=\"card\" style=\"background:var(--emerald); border:none\">\n        <h3 style=\"font-size:30px\">Artık Kur'an okurken bu kuralları gözünle hemen fark edeceksin!</h3>\n      </div>\n      <button onclick=\"goTo(0)\" style=\"background:none; border:2px solid var(--gold); color:var(--gold); padding:10px 30px; border-radius:10px; cursor:pointer; font-weight:900\">Başa Dön</button>\n    </div>\n  </div>\n\n</div>\n\n<!-- NAV -->\n<div class=\"nav\">\n  <button id=\"prevBtn\" onclick=\"go(-1)\" disabled>◀</button>\n  <div class=\"slide-counter\" id=\"counter\">1 / 8</div>\n  <button id=\"nextBtn\" onclick=\"go(1)\">▶</button>\n</div>\n\n<script>\n  const TOTAL = 8;\n  let cur = 0;\n  let transitioning = false;\n\n  function getSlide(n) { return document.getElementById('s' + (n + 1)); }\n\n  function go(dir) { goTo(cur + dir); }\n\n  function goTo(n) {\n    if (n < 0 || n >= TOTAL || n === cur || transitioning) return;\n    transitioning = true;\n    const from = getSlide(cur);\n    const to = getSlide(n);\n    to.scrollTop = 0;\n    const toStartPos = n > cur ? '60px' : '-60px';\n    const fromEndPos = n > cur ? '-60px' : '60px';\n    to.style.transition = 'none';\n    to.style.transform = `translateX(${toStartPos})`;\n    to.style.opacity = '0';\n    to.classList.add('active');\n    requestAnimationFrame(() => {\n      from.style.transition = 'opacity .45s ease, transform .45s ease';\n      from.style.transform = `translateX(${fromEndPos})`;\n      from.style.opacity = '0';\n      to.style.transition = 'opacity .45s ease, transform .45s ease';\n      to.style.transform = 'translateX(0)';\n      to.style.opacity = '1';\n    });\n    setTimeout(() => {\n      from.classList.remove('active');\n      from.style.transform = '';\n      from.style.transition = '';\n      cur = n;\n      updateNav();\n      transitioning = false;\n    }, 480);\n  }\n\n  function updateNav() {\n    document.getElementById('counter').textContent = (cur + 1) + ' / ' + TOTAL;\n    document.getElementById('prevBtn').disabled = cur === 0;\n    document.getElementById('nextBtn').disabled = cur === TOTAL - 1;\n  }\n\n  // --- OYUN MANTIKLARI ---\n\n  // Eşleştirme\n  let selectedL = null;\n  let selectedR = null;\n  function selectMatch(elem, side) {\n    if(elem.classList.contains('correct')) return;\n    \n    if(side === 'L') {\n      if(selectedL) selectedL.classList.remove('selected');\n      selectedL = elem;\n    } else {\n      if(selectedR) selectedR.classList.remove('selected');\n      selectedR = elem;\n    }\n    elem.classList.add('selected');\n\n    if(selectedL && selectedR) {\n      const fb = document.getElementById('match-fb');\n      if(selectedL.dataset.key === selectedR.data.key) {\n        selectedL.classList.add('correct');\n        selectedR.classList.add('correct');\n        fb.textContent = \"✅ Harika Eşleşme!\";\n        fb.className = \"feedback show success\";\n      } else {\n        fb.textContent = \"❌ Tekrar Dene!\";\n        fb.className = \"feedback show error\";\n        const l = selectedL, r = selectedR;\n        setTimeout(() => {\n          l.classList.remove('selected');\n          r.classList.remove('selected');\n        }, 500);\n      }\n      selectedL = null; selectedR = null;\n    }\n  }\n\n  // Tecvid Avcısı\n  function checkHunt(elem, isCorrect, type) {\n    const fb = elem.closest('.slide').querySelector('.feedback');\n    if(isCorrect) {\n      elem.classList.add('found');\n      fb.textContent = \"🎯 Tebrikler! Doğru Kelime: \" + type;\n      fb.className = \"feedback show success\";\n    }\n  }\n\n  // Çoktan Seçmeli\n  function checkQ(btn, isCorrect) {\n    const all = btn.parentElement.querySelectorAll('.opt-btn');\n    all.forEach(b => b.classList.remove('correct', 'wrong'));\n    if(isCorrect) {\n      btn.classList.add('correct');\n    } else {\n      btn.classList.add('wrong');\n    }\n  }\n\n  // Doğru Yanlış\n  function handleDY(btn, isCorrect) {\n    const fb = btn.parentElement.nextElementSibling;\n    if(isCorrect) {\n      btn.style.boxShadow = \"0 0 20px #10b981\";\n      fb.textContent = \"✅ Bildin!\";\n      fb.className = \"dy-feedback feedback show success\";\n    } else {\n      btn.style.boxShadow = \"0 0 20px #ef4444\";\n      fb.textContent = \"❌ Yanlış Cevap!\";\n      fb.className = \"dy-feedback feedback show error\";\n    }\n  }\n\n  document.addEventListener('keydown', e => {\n    if (e.key === 'ArrowRight') go(1);\n    if (e.key === 'ArrowLeft') go(-1);\n  });\n</script>\n</body>\n</html>",
  "createdAt": "2026-05-03T11:47:56.471Z",
  "updatedAt": "2026-05-03T11:47:56.471Z"
}