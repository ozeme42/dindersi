{
  "htmlContent": "<!DOCTYPE html>\n<html lang=\"tr\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>6. Sınıf Din Kültürü - Allah’ın Güzel İsimleri: Hâdi, Selam, Vekîl</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css\" />\n    <link href=\"https://fonts.googleapis.com/css2?family=Amiri:ital,wght@0,400;0,700;1,400&family=Poppins:wght@300;400;500;600;700&display=swap\" rel=\"stylesheet\">\n    <style>\n        body { font-family: 'Poppins', sans-serif; }\n        .arabic-text { font-family: 'Amiri', serif; }\n    </style>\n</head>\n<body class=\"bg-gradient-to-br from-emerald-50 via-teal-50 to-cyan-100 min-h-screen text-slate-800 p-4 md:p-8\">\n\n    <div class=\"max-w-6xl mx-auto space-y-8\">\n\n        <!-- BAŞLIK KARTI -->\n        <header class=\"bg-white/90 backdrop-blur-md rounded-3xl p-6 md:p-8 shadow-xl border border-emerald-100 text-center relative overflow-hidden\">\n            <div class=\"absolute -right-10 -top-10 w-40 h-40 bg-emerald-200/50 rounded-full blur-2xl\"></div>\n            <div class=\"absolute -left-10 -bottom-10 w-40 h-40 bg-teal-200/50 rounded-full blur-2xl\"></div>\n            \n            <div class=\"inline-flex items-center gap-2 bg-emerald-100 text-emerald-800 px-4 py-1.5 rounded-full text-xs font-semibold uppercase tracking-wider mb-4\">\n                <i class=\"fa-solid fa-book-quran\"></i> 6. Sınıf • 1. Ünite: Dinimiz İslam\n            </div>\n            <h1 class=\"text-3xl md:text-5xl font-extrabold text-slate-900 tracking-tight mb-3\">\n                Allah’ın Güzel İsimleri: <span class=\"text-emerald-700\">Hâdi, Selam, Vekîl</span>\n            </h1>\n            <p class=\"text-slate-600 max-w-2xl mx-auto text-sm md:text-base\">\n                Yüce Allah’ı tanımanın yollarından biri de O’nun güzel isimlerini (Esma-i Hüsna) öğrenmek, anlamlarını kavramak ve hayatımıza yansıtmaktır.\n            </p>\n        </header>\n\n        <!-- KAZANIM / ÖNEMLİ MADDELER -->\n        <section class=\"grid grid-cols-1 md:grid-cols-3 gap-6\">\n            <div class=\"bg-white/80 backdrop-blur-md p-6 rounded-3xl shadow-lg border border-emerald-100 flex items-start gap-4 hover:shadow-xl transition-all\">\n                <div class=\"w-12 h-12 bg-emerald-500 text-white rounded-2xl flex items-center justify-center text-xl shrink-0 shadow-md shadow-emerald-500/30\">\n                    <i class=\"fa-solid fa-compass\"></i>\n                </div>\n                <div>\n                    <h3 class=\"font-bold text-slate-900 text-lg mb-1\">Hâdi</h3>\n                    <p class=\"text-slate-600 text-sm\">Doğru yolu gösteren, rehberlik eden ve gönülleri aydınlatan.</p>\n                </div>\n            </div>\n\n            <div class=\"bg-white/80 backdrop-blur-md p-6 rounded-3xl shadow-lg border border-teal-100 flex items-start gap-4 hover:shadow-xl transition-all\">\n                <div class=\"w-12 h-12 bg-teal-500 text-white rounded-2xl flex items-center justify-center text-xl shrink-0 shadow-md shadow-teal-500/30\">\n                    <i class=\"fa-solid fa-shield-heart\"></i>\n                </div>\n                <div>\n                    <h3 class=\"font-bold text-slate-900 text-lg mb-1\">Selam</h3>\n                    <p class=\"text-slate-600 text-sm\">Kusursuz olan, kullarına güvenlik, barış ve esenlik veren.</p>\n                </div>\n            </div>\n\n            <div class=\"bg-white/80 backdrop-blur-md p-6 rounded-3xl shadow-lg border border-cyan-100 flex items-start gap-4 hover:shadow-xl transition-all\">\n                <div class=\"w-12 h-12 bg-cyan-600 text-white rounded-2xl flex items-center justify-center text-xl shrink-0 shadow-md shadow-cyan-600/30\">\n                    <i class=\"fa-solid fa-hands-holding-child\"></i>\n                </div>\n                <div>\n                    <h3 class=\"font-bold text-slate-900 text-lg mb-1\">Vekîl</h3>\n                    <p class=\"text-slate-600 text-sm\">İşleri düzenleyen, koruyup gözeten ve rızıklara kefil olan.</p>\n                </div>\n            </div>\n        </section>\n\n        <!-- ESMA-İ HÜSNA DETAYLI KARTLARI -->\n        <div class=\"grid grid-cols-1 md:grid-cols-3 gap-6\">\n\n            <!-- HÂDİ -->\n            <div class=\"bg-white rounded-3xl p-6 shadow-xl border-t-4 border-emerald-500 flex flex-col justify-between\">\n                <div>\n                    <div class=\"flex justify-between items-center mb-4\">\n                        <span class=\"bg-emerald-100 text-emerald-800 text-xs font-bold px-3 py-1 rounded-full\">el-Hâdî</span>\n                        <i class=\"fa-solid fa-star text-emerald-500\"></i>\n                    </div>\n                    <h2 class=\"text-2xl font-bold text-slate-900 mb-2\">Hâdi</h2>\n                    <p class=\"text-slate-600 text-sm leading-relaxed mb-4\">\n                        İnsanlara doğru yolu gösteren, rehberlik eden, zihinlerini ve gönüllerini aydınlatarak hayır ve mutluluk veren demektir. İnsan doğru yolu bulabilmek için Yüce Allah’ın hidayetine muhtaçtır.\n                    </p>\n                </div>\n                <div class=\"bg-emerald-50/70 p-4 rounded-2xl border border-emerald-100 mt-4\">\n                    <p class=\"text-xs font-semibold text-emerald-900 uppercase mb-1\">Namazda Okunan Dua:</p>\n                    <p class=\"text-xs text-emerald-800 italic\">\"İhdinassırâtalmüstakîm. (Bizi dosdoğru yola ilet!)\"</p>\n                </div>\n            </div>\n\n            <!-- SELAM -->\n            <div class=\"bg-white rounded-3xl p-6 shadow-xl border-t-4 border-teal-500 flex flex-col justify-between\">\n                <div>\n                    <div class=\"flex justify-between items-center mb-4\">\n                        <span class=\"bg-teal-100 text-teal-800 text-xs font-bold px-3 py-1 rounded-full\">es-Selâm</span>\n                        <i class=\"fa-solid fa-dove text-teal-500\"></i>\n                    </div>\n                    <h2 class=\"text-2xl font-bold text-slate-900 mb-2\">Selam</h2>\n                    <p class=\"text-slate-600 text-sm leading-relaxed mb-4\">\n                        Her türlü eksiklikten uzak ve yaratmasında kusursuz olan, kullarına güvenlik, barış, esenlik ve sağlık veren anlamlarına gelir. Selam ismini bilen bir Müslüman çevresine güven verir.\n                    </p>\n                </div>\n                <div class=\"bg-teal-50/70 p-4 rounded-2xl border border-teal-100 mt-4\">\n                    <p class=\"text-xs font-semibold text-teal-900 uppercase mb-1\">Selamlaşmanın Anlamı:</p>\n                    <p class=\"text-xs text-teal-800 italic\">\"Allah sana sağlık, afiyet, esenlik, güven, huzur versin.\"</p>\n                </div>\n            </div>\n\n            <!-- VEKİL -->\n            <div class=\"bg-white rounded-3xl p-6 shadow-xl border-t-4 border-cyan-600 flex flex-col justify-between\">\n                <div>\n                    <div class=\"flex justify-between items-center mb-4\">\n                        <span class=\"bg-cyan-100 text-cyan-800 text-xs font-bold px-3 py-1 rounded-full\">el-Vekîl</span>\n                        <i class=\"fa-solid fa-shield text-cyan-600\"></i>\n                    </div>\n                    <h2 class=\"text-2xl font-bold text-slate-900 mb-2\">Vekîl</h2>\n                    <p class=\"text-slate-600 text-sm leading-relaxed mb-4\">\n                        Bütün varlıkların işlerini düzenleyen, sevk ve idare eden, yardımını esirgemeden koruyup gözeten demektir. Tevekkül kavramıyla yakından ilişkilidir (önce çaba, sonra Allah’a güven).\n                    </p>\n                </div>\n                <div class=\"bg-cyan-50/70 p-4 rounded-2xl border border-cyan-100 mt-4\">\n                    <p class=\"text-xs font-semibold text-cyan-900 uppercase mb-1\">Hz. Peygamber'in Duası:</p>\n                    <p class=\"text-xs text-cyan-800 italic\">\"Hasbünallah ve nimelvekîl. (Allah bize yeter, O ne güzel vekildir.)\"</p>\n                </div>\n            </div>\n\n        </div>\n\n        <!-- AYET VE HADİS KUTUSU -->\n        <section class=\"bg-white rounded-3xl p-6 md:p-8 shadow-xl border border-emerald-100\">\n            <div class=\"flex items-center gap-3 mb-6\">\n                <div class=\"w-10 h-10 bg-emerald-100 text-emerald-700 rounded-xl flex items-center justify-center font-bold\">\n                    <i class=\"fa-solid fa-quote-left text-lg\"></i>\n                </div>\n                <h3 class=\"text-xl font-bold text-slate-900\">Kur'an-ı Kerim ve Hadislerde Esma-i Hüsna</h3>\n            </div>\n\n            <div class=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n                <!-- Ayet -->\n                <div class=\"bg-slate-50 p-6 rounded-2xl border border-slate-200\">\n                    <span class=\"text-xs font-semibold text-emerald-700 uppercase tracking-wider mb-2 block\">Araf Suresi, 180. Ayet</span>\n                    <p class=\"arabic-text text-xl md:text-2xl text-emerald-900 text-right mb-3 leading-loose\" dir=\"rtl\">\n                        وَلِلّٰهِ الْاَسْمَاءُ الْحُسْنٰى فَادْعُوهُ بِهَاۖ\n                    </p>\n                    <p class=\"text-slate-700 text-sm italic\">\n                        \"En güzel isimler Allah’ındır. O’na o güzel isimleriyle dua edin...\"\n                    </p>\n                </div>\n\n                <!-- Hadis -->\n                <div class=\"bg-slate-50 p-6 rounded-2xl border border-slate-200\">\n                    <span class=\"text-xs font-semibold text-teal-700 uppercase tracking-wider mb-2 block\">Hadis-i Şerif</span>\n                    <p class=\"text-slate-800 font-medium text-sm mb-3\">\n                        “Allah’ın yüzden bir eksik, doksan dokuz ismi vardır. Kim bu isimleri (öğrenip gereğiyle amel ederek) sayarsa cennete girer.”\n                    </p>\n                    <p class=\"text-slate-500 text-xs\">\n                        (Bu hadis, Allah’ın isimlerini öğrenmenin ve hayatımıza yansıtmanın önemini gösterir.)\n                    </p>\n                </div>\n            </div>\n        </section>\n\n        <!-- AKILDA KALICI PÜF NOKTA / BİLGİ Kutusu -->\n        <section class=\"bg-gradient-to-r from-emerald-600 to-teal-700 text-white rounded-3xl p-6 md:p-8 shadow-2xl flex flex-col md:flex-row items-center justify-between gap-6\">\n            <div class=\"flex items-center gap-4\">\n                <div class=\"w-16 h-16 bg-white/10 backdrop-blur-md rounded-2xl flex items-center justify-center text-3xl shrink-0 border border-white/20\">\n                    <i class=\"fa-solid fa-lightbulb text-yellow-300 animate-pulse\"></i>\n                </div>\n                <div>\n                    <h4 class=\"text-xl font-bold mb-1\">💡 Unutmayalım! & 🎯 Sınav İpucu</h4>\n                    <p class=\"text-emerald-100 text-sm max-w-2xl\">\n                        Dinimize göre Yüce Allah’ı tanımak insanın en temel sorumluluklarındandır. Rabbimizin güzel isimleri <strong>Esma-i Hüsna</strong> (En güzel isimler) olarak adlandırılır. Tevekkül ise elimizden geleni yaptıktan sonra Vekîl olan Allah’a güvenmektir.\n                    </p>\n                </div>\n            </div>\n            <div class=\"shrink-0\">\n                <div class=\"bg-white/10 backdrop-blur-md border border-white/20 px-6 py-3 rounded-2xl text-center\">\n                    <span class=\"block text-xs uppercase tracking-widest text-emerald-200\">Mehmet Akif Ersoy</span>\n                    <span class=\"text-sm font-bold italic\">\"Allah’a dayan, sa’ye sarıl, hikmete râm ol...\"</span>\n                </div>\n            </div>\n        </section>\n\n        <!-- ALT BİLGİ -->\n        <footer class=\"text-center text-slate-500 text-xs py-4\">\n            <p>Din Kültürü ve Ahlak Bilgisi • Akıllı Tahta İnteraktif Ders Özeti</p>\n        </footer>\n\n    </div>\n\n</body>\n</html>",
  "updatedAt": "2026-10-02T16:29:11.022Z"
}