ss=\"py-3 px-4 text-slate-600\">\"Z\" harfinin ince ve vurgusuz söylenen hâli gibidir (Ze).</td>\n                </tr>\n\n                <!-- ر -->\n                <tr data-region=\"dil\" class=\"hover:bg-slate-50 transition-colors\">\n                  <td class=\"py-3 px-4 text-center font-quran text-2xl font-bold text-teal-800\">ر</td>\n                  <td class=\"py-3 px-4\"><span class=\"px-2 py-0.5 rounded bg-emerald-100 text-emerald-800 text-xs font-semibold\">Dil</span></td>\n                  <td class=\"py-3 px-4 font-medium text-slate-700\">Dil ucu ile ön dişlerin üstündeki damak</td>\n                  <td class=\"py-3 px-4 text-slate-600\">\"R\" harfi gibidir. (Harekelerine göre ince/kalın)</td>\n                </tr>\n\n                <!-- ز -->\n                <tr data-region=\"dil\" class=\"hover:bg-slate-50 transition-colors\">\n                  <td class=\"py-3 px-4 text-center font-quran text-2xl font-bold text-emerald-800\">ز</td>\n                  <td class=\"py-3 px-4\"><span class=\"px-2 py-0.5 rounded bg-emerald-100 text-emerald-800 text-xs font-semibold\">Dil</span></td>\n                  <td class=\"py-3 px-4 font-medium text-slate-700\">Dil ucu ile ön dişlerin üst yüzeyi</td>\n                  <td class=\"py-3 px-4 text-slate-600\">\"Z\" harfi gibidir.</td>\n                </tr>\n\n                <!-- س -->\n                <tr data-region=\"dil\" class=\"hover:bg-slate-50 transition-colors\">\n                  <td class=\"py-3 px-4 text-center font-quran text-2xl font-bold text-emerald-800\">س</td>\n                  <td class=\"py-3 px-4\"><span class=\"px-2 py-0.5 rounded bg-emerald-100 text-emerald-800 text-xs font-semibold\">Dil</span></td>\n                  <td class=\"py-3 px-4 font-medium text-slate-700\">Dil ucu ile ön dişlerin üst yüzeyi</td>\n                  <td class=\"py-3 px-4 text-slate-600\">\"S\" harfi gibidir.</td>\n                </tr>\n\n                <!-- ش -->\n                <tr data-region=\"dil\" class=\"hover:bg-slate-50 transition-colors\">\n                  <td class=\"py-3 px-4 text-center font-quran text-2xl font-bold text-emerald-800\">ش</td>\n                  <td class=\"py-3 px-4\"><span class=\"px-2 py-0.5 rounded bg-emerald-100 text-emerald-800 text-xs font-semibold\">Dil</span></td>\n                  <td class=\"py-3 px-4 font-medium text-slate-700\">Dil ve üst damak ortası</td>\n                  <td class=\"py-3 px-4 text-slate-600\">\"Ş\" harfi gibidir.</td>\n                </tr>\n\n                <!-- ص -->\n                <tr data-region=\"dil\" class=\"hover:bg-slate-50 transition-colors\">\n                  <td class=\"py-3 px-4 text-center font-quran text-2xl font-bold text-orange-700\">ص</td>\n                  <td class=\"py-3 px-4\"><span class=\"px-2 py-0.5 rounded bg-emerald-100 text-emerald-800 text-xs font-semibold\">Dil (Kalın)</span></td>\n                  <td class=\"py-3 px-4 font-medium text-slate-700\">Dil ucu ile ön dişlerin üst yüzeyi</td>\n                  <td class=\"py-3 px-4 text-slate-600\">\"S\" harfinin kalın söylenen hâli gibidir (Sa).</td>\n                </tr>\n\n                <!-- ض -->\n                <tr data-region=\"dil\" class=\"hover:bg-slate-50 transition-colors\">\n                  <td class=\"py-3 px-4 text-center font-quran text-2xl font-bold text-orange-700\">ض</td>\n                  <td class=\"py-3 px-4\"><span class=\"px-2 py-0.5 rounded bg-emerald-100 text-emerald-800 text-xs font-semibold\">Dil (Kalın)</span></td>\n                  <td class=\"py-3 px-4 font-medium text-slate-700\">Dil kenarı ile üst azı dişler</td>\n                  <td class=\"py-3 px-4 text-slate-600\">\"D\" ve \"Z\" harflerinin kalın hâlleri gibi söylenen iki tercihli bir harftir (Da-Za).</td>\n                </tr>\n\n                <!-- ط -->\n                <tr data-region=\"dil\" class=\"hover:bg-slate-50 transition-colors\">\n                  <td class=\"py-3 px-4 text-center font-quran text-2xl font