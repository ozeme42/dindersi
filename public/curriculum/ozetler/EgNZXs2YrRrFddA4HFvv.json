{
  "htmlContent": "<!DOCTYPE html>\n<html lang=\"tr\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>5. Sınıf Kur'an-ı Kerim: Harfler ve Özellikleri</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css\">\n  <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n  <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n  <link href=\"https://fonts.googleapis.com/css2?family=Amiri:wght@700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap\" rel=\"stylesheet\">\n  <style>\n    body {\n      font-family: 'Plus Jakarta Sans', sans-serif;\n      background-color: #f0fdf4;\n    }\n    .font-quran {\n      font-family: 'Amiri', serif;\n    }\n    .tab-btn.active {\n      background-color: #047857;\n      color: #ffffff;\n      box-shadow: 0 4px 12px rgba(4, 120, 87, 0.25);\n    }\n  </style>\n</head>\n<body class=\"text-slate-800 antialiased min-h-screen pb-16\">\n\n  <!-- Üst Başlık Banner -->\n  <header class=\"bg-gradient-to-r from-emerald-800 via-teal-700 to-emerald-900 text-white shadow-xl relative overflow-hidden\">\n    <div class=\"absolute inset-0 opacity-10 bg-[radial-gradient(#fff_1px,transparent_1px)] [background-size:16px_16px]\"></div>\n    <div class=\"max-w-6xl mx-auto px-4 py-8 relative z-10\">\n      <div class=\"flex flex-wrap items-center justify-between gap-4\">\n        <div>\n          <div class=\"flex items-center gap-2 mb-2\">\n            <span class=\"bg-emerald-600/60 border border-emerald-400/40 text-emerald-100 text-xs font-semibold px-3 py-1 rounded-full uppercase tracking-wider\">\n              5. Sınıf • 1. Ünite\n            </span>\n            <span class=\"bg-teal-600/60 border border-teal-400/40 text-teal-100 text-xs font-semibold px-3 py-1 rounded-full\">\n              1.2. Harfler ve Özellikleri\n            </span>\n          </div>\n          <h1 class=\"text-2xl sm:text-4xl font-extrabold tracking-tight text-white flex items-center gap-3\">\n            <i class=\"fa-solid fa-book-quran text-amber-300\"></i> Kur'an Harfleri ve Mahreçleri\n          </h1>\n          <p class=\"text-emerald-100 text-sm sm:text-base mt-1\">\n            Kur'an alfabesi, harflerin kalınlık-incelik durumları, peltek & boğaz harfleri ve mahreç tablosu\n          </p>\n        </div>\n        <div class=\"flex items-center gap-3 bg-white/10 backdrop-blur-md px-4 py-3 rounded-2xl border border-white/20\">\n          <div class=\"text-3xl font-bold text-amber-300 font-quran leading-none\">٢٨</div>\n          <div class=\"text-xs text-emerald-50 leading-tight font-medium\">\n            Toplam<br><strong class=\"text-white text-sm\">28 Harf</strong>\n          </div>\n        </div>\n      </div>\n    </div>\n  </header>\n\n  <!-- Ana İçerik Konteyneri -->\n  <main class=\"max-w-6xl mx-auto px-4 mt-8 space-y-8\">\n\n    <!-- KAZANIMLAR & KİLİT KAVRAMLAR BÖLÜMÜ -->\n    <div class=\"grid grid-cols-1 md:grid-cols-12 gap-6\">\n      \n      <!-- Kazanım Maddeleri (7 Kolon) -->\n      <div class=\"md:col-span-7 bg-white rounded-3xl p-6 shadow-sm border border-emerald-100 flex flex-col justify-between\">\n        <div>\n          <div class=\"flex items-center gap-2 mb-4 text-emerald-800 font-bold text-lg\">\n            <span class=\"w-8 h-8 rounded-xl bg-emerald-100 text-emerald-700 flex items-center justify-center\">\n              <i class=\"fa-solid fa-bullseye\"></i>\n            </span>\n            Öğrenme Hedefleri & Temel Kurallar\n          </div>\n          <ul class=\"space-y-3\">\n            <li class=\"flex items-start gap-3 text-sm text-slate-700\">\n              <i class=\"fa-solid fa-circle-check text-emerald-600 mt-1\"></i>\n              <span><strong>28 Harf ve Yön:</strong> Kur'an alfabesi yirmi sekiz harften meydana gelir; kelimeler <strong>sağdan sola doğru</strong> yazılır ve okunur.</span>\n            </li>\n            <li class=\"flex items-start gap-3 text-sm text-slate-700\">\n              <i class=\"fa-solid fa-circle-check text-emerald-600 mt-1\"></i>\n              <span><strong>Okunuş Özellikleri:</strong> Harfler ses yapılarına göre <strong>kalın ve ince</strong> olarak ayrılır; ayrıca <strong>peltek</strong> ve <strong>boğaz</strong> harfleri bulunur.</span>\n            </li>\n            <li class=\"flex items-start gap-3 text-sm text-slate-700\">\n              <i class=\"fa-solid fa-circle-check text-emerald-600 mt-1\"></i>\n              <span><strong>Mahreç Uyumu:</strong> Kur'an'ı doğru okumak için harfleri mahreçlerine (çıkış yerleri) uygun seslendirmek şarttır.</span>\n            </li>\n          </ul>\n        </div>\n        \n        <div class=\"mt-4 pt-4 border-t border-slate-100 flex items-center gap-2 text-xs text-slate-500\">\n          <i class=\"fa-solid fa-circle-info text-teal-600\"></i>\n          <span>Bir harfin yanlış seslendirilmesi kelimelerin anlamlarının değişmesine yol açabilir.</span>\n        </div>\n      </div>\n\n      <!-- Kilit Kavramlar Kartları (5 Kolon) -->\n      <div class=\"md:col-span-5 grid grid-cols-1 gap-4\">\n        <!-- Mahreç Tanımı -->\n        <div class=\"bg-gradient-to-br from-amber-50 to-orange-50 border border-amber-200 rounded-2xl p-4 flex gap-4 items-start shadow-sm\">\n          <div class=\"w-10 h-10 rounded-xl bg-amber-500 text-white flex items-center justify-center shrink-0 shadow-md shadow-amber-200\">\n            <i class=\"fa-solid fa-microphone-lines text-lg\"></i>\n          </div>\n          <div>\n            <span class=\"text-xs font-bold text-amber-700 uppercase tracking-wide\">Temel Kavram</span>\n            <h2 class=\"text-base font-bold text-amber-950\">Mahreç Nedir?</h2>\n            <p class=\"text-xs text-amber-900 mt-1 leading-relaxed\">\n              Harflerin ses yolundan çıktığı yerlere <strong>mahreç</strong> denir. Her dilin kendine özgü harf çıkış yerleri vardır.\n            </p>\n          </div>\n        </div>\n\n        <!-- Lâmelif Notu -->\n        <div class=\"bg-gradient-to-br from-blue-50 to-indigo-50 border border-blue-200 rounded-2xl p-4 flex gap-4 items-start shadow-sm\">\n          <div class=\"w-10 h-10 rounded-xl bg-blue-600 text-white flex items-center justify-center shrink-0 shadow-md shadow-blue-200 font-quran text-2xl\">\n            لا\n          </div>\n          <div>\n            <span class=\"text-xs font-bold text-blue-700 uppercase tracking-wide\">Önemli Bilgi Notu</span>\n            <h2 class=\"text-base font-bold text-blue-950\">Lâmelif (لا) Müstakil midir?</h2>\n            <p class=\"text-xs text-blue-900 mt-1 leading-relaxed\">\n              Lâmelif (لا), alfabede yer alan <strong>müstakil bir harf değildir</strong>. Lâm (ل) ve elif (ا) harflerinin bir araya gelmesiyle oluşur.\n            </p>\n          </div>\n        </div>\n      </div>\n\n    </div>\n\n    <!-- 1.2.2. OKUNUŞLARINA GÖRE HARFLER GRUPLAMASI -->\n    <div class=\"bg-white rounded-3xl p-6 sm:p-8 shadow-sm border border-emerald-100\">\n      <div class=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-slate-100\">\n        <div>\n          <span class=\"text-xs font-bold text-emerald-600 uppercase tracking-wider\">1.2.2. Seslendirme Özellikleri</span>\n          <h2 class=\"text-2xl font-bold text-slate-800 flex items-center gap-2\">\n            <i class=\"fa-solid fa-layer-group text-emerald-600\"></i> Okunuşlarına Göre Harfler\n          </h2>\n        </div>\n        <div class=\"flex flex-wrap gap-2 text-xs font-medium\">\n          <span class=\"px-3 py-1.5 rounded-xl bg-orange-100 text-orange-800 border border-orange-200 flex items-center gap-1.5\">\n            <span class=\"w-2 h-2 rounded-full bg-orange-500\"></span> Kalın Harfler (7)\n          </span>\n          <span class=\"px-3 py-1.5 rounded-xl bg-emerald-100 text-emerald-800 border border-emerald-200 flex items-center gap-1.5\">\n            <span class=\"w-2 h-2 rounded-full bg-emerald-500\"></span> İnce Harfler (21)\n          </span>\n          <span class=\"px-3 py-1.5 rounded-xl bg-pink-100 text-pink-800 border border-pink-200 flex items-center gap-1.5\">\n            <span class=\"w-2 h-2 rounded-full bg-pink-500\"></span> Peltek Harfler (3)\n          </span>\n        </div>\n      </div>\n\n      <!-- Kartlar Grid -->\n      <div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mt-6\">\n        \n        <!-- Kalın Harfler -->\n        <div class=\"bg-orange-50/60 border-2 border-orange-200 rounded-2xl p-5 flex flex-col justify-between hover:shadow-md transition-shadow\">\n          <div>\n            <div class=\"flex items-center justify-between mb-3\">\n              <span class=\"text-xs font-bold px-2.5 py-1 bg-orange-200 text-orange-900 rounded-lg\">7 Kalın Harf</span>\n              <i class=\"fa-solid fa-volume-high text-orange-600\"></i>\n            </div>\n            <h3 class=\"font-bold text-slate-800 text-base mb-1\">Kalın Harfler</h3>\n            <p class=\"text-xs text-slate-600 mb-3\">Tok ve kalın bir ses tonuyla seslendirilen harflerdir.</p>\n            <div class=\"bg-white rounded-xl p-3 border border-orange-100 text-center\">\n              <div class=\"text-2xl font-quran text-orange-800 tracking-widest flex justify-around items-center\">\n                <span>خ</span><span>ص</span><span>ض</span><span>ط</span><span>ظ</span><span>غ</span><span>ق</span>\n              </div>\n            </div>\n          </div>\n          <p class=\"text-[11px] text-orange-700 mt-3 font-semibold text-center\">Hı, Sad, Dad, Tı, Zı, Ğayn, Kaf</p>\n        </div>\n\n        <!-- İnce Harfler -->\n        <div class=\"bg-emerald-50/60 border-2 border-emerald-200 rounded-2xl p-5 flex flex-col justify-between hover:shadow-md transition-shadow\">\n          <div>\n            <div class=\"flex items-center justify-between mb-3\">\n              <span class=\"text-xs font-bold px-2.5 py-1 bg-emerald-200 text-emerald-900 rounded-lg\">21 İnce Harf</span>\n              <i class=\"fa-solid fa-feather text-emerald-600\"></i>\n            </div>\n            <h3 class=\"font-bold text-slate-800 text-base mb-1\">İnce Harfler</h3>\n            <p class=\"text-xs text-slate-600 mb-3\">Daha tiz ve ince seslendirilen temel harflerdir.</p>\n            <div class=\"bg-white rounded-xl p-2 border border-emerald-100 text-center\">\n              <div class=\"text-lg font-quran text-emerald-800 tracking-wider flex flex-wrap justify-center gap-1.5 leading-relaxed\">\n                <span>ا</span><span>ب</span><span>ت</span><span>ث</span><span>ج</span><span>ح</span><span>د</span><span>ذ</span><span>ر</span><span>ز</span><span>س</span><span>ش</span><span>ع</span><span>ف</span><span>ك</span><span>ل</span><span>م</span><span>ن</span><span>و</span><span>ه</span><span>ى</span>\n              </div>\n            </div>\n          </div>\n          <p class=\"text-[11px] text-emerald-700 mt-2 font-medium text-center\">Diğer 21 harf ince gruptadır.</p>\n        </div>\n\n        <!-- Peltek Harfler -->\n        <div class=\"bg-pink-50/60 border-2 border-pink-200 rounded-2xl p-5 flex flex-col justify-between hover:shadow-md transition-shadow\">\n          <div>\n            <div class=\"flex items-center justify-between mb-3\">\n              <span class=\"text-xs font-bold px-2.5 py-1 bg-pink-200 text-pink-900 rounded-lg\">3 Peltek Harf</span>\n              <i class=\"fa-solid fa-lips text-pink-600\"></i>\n            </div>\n            <h3 class=\"font-bold text-slate-800 text-base mb-1\">Peltek Harfler</h3>\n            <p class=\"text-xs text-slate-600 mb-3 leading-relaxed\">\n              Dil ucunun üst yüzeyi üst ön dişlerin ucuna getirilerek çıkarılır.\n            </p>\n            <div class=\"bg-white rounded-xl p-3 border border-pink-100 flex justify-around items-center\">\n              <div class=\"text-center\">\n                <span class=\"text-2xl font-quran text-pink-700 font-bold\">ث</span>\n                <span class=\"block text-[10px] text-slate-500 mt-1\">İnce</span>\n              </div>\n              <div class=\"text-center\">\n                <span class=\"text-2xl font-quran text-pink-700 font-bold\">ذ</span>\n                <span class=\"block text-[10px] text-slate-500 mt-1\">İnce</span>\n              </div>\n              <div class=\"text-center\">\n                <span class=\"text-2xl font-quran text-pink-700 font-bold\">ظ</span>\n                <span class=\"block text-[10px] text-pink-600 font-bold mt-1\">Kalın</span>\n              </div>\n            </div>\n          </div>\n          <p class=\"text-[11px] text-pink-700 mt-3 font-semibold text-center\">ث ve ذ ince, ظ kalındır.</p>\n        </div>\n\n        <!-- Boğaz Harfleri -->\n        <div class=\"bg-amber-50/60 border-2 border-amber-200 rounded-2xl p-5 flex flex-col justify-between hover:shadow-md transition-shadow\">\n          <div>\n            <div class=\"flex items-center justify-between mb-3\">\n              <span class=\"text-xs font-bold px-2.5 py-1 bg-amber-200 text-amber-900 rounded-lg\">Boğaz Sesleri</span>\n              <i class=\"fa-solid fa-head-side-cough text-amber-600\"></i>\n            </div>\n            <h3 class=\"font-bold text-slate-800 text-base mb-1\">Boğaz Harfleri</h3>\n            <p class=\"text-xs text-slate-600 mb-3 leading-relaxed\">\n              Boğazdan gelen belirgin bir titreşimle telaffuz edilir.\n            </p>\n            <div class=\"bg-white rounded-xl p-3 border border-amber-100 flex justify-around items-center\">\n              <div class=\"text-center\">\n                <div class=\"text-xl font-quran text-amber-800 space-x-1\">\n                  <span>ا</span> <span>ح</span> <span>ع</span>\n                </div>\n                <span class=\"block text-[10px] text-emerald-600 font-bold mt-1\">İnceler</span>\n              </div>\n              <div class=\"h-6 w-px bg-slate-200\"></div>\n              <div class=\"text-center\">\n                <div class=\"text-xl font-quran text-amber-800 space-x-1\">\n                  <span>خ</span> <span>غ</span>\n                </div>\n                <span class=\"block text-[10px] text-orange-600 font-bold mt-1\">Kalınlar</span>\n              </div>\n            </div>\n          </div>\n          <p class=\"text-[11px] text-amber-800 mt-3 font-semibold text-center\">ا, ح, ع ince; خ, غ kalındır.</p>\n        </div>\n\n      </div>\n\n      <!-- RA Harfi Özel Not Kutusu -->\n      <div class=\"mt-4 bg-gradient-to-r from-teal-50 to-emerald-50 border border-teal-200 rounded-2xl p-4 flex items-center gap-4\">\n        <div class=\"w-10 h-10 rounded-full bg-teal-600 text-white flex items-center justify-center shrink-0 font-quran text-2xl font-bold shadow-sm\">\n          ر\n        </div>\n        <div class=\"text-xs sm:text-sm text-teal-950\">\n          <strong>Önemli İstisna (Ra Harfi):</strong> <span class=\"font-quran font-bold text-base\">ر</span> harfi, aldığı hareke veya sakin (harekesiz) olması durumuna göre duruma bağlı olarak <strong>ince ya da kalın</strong> okunur.\n        </div>\n      </div>\n    </div>\n\n    <!-- 1.2.3. HARFLERİN MAHREÇLERİ VE 3 ANA BÖLGE -->\n    <div class=\"space-y-6\">\n      <div class=\"bg-white rounded-3xl p-6 sm:p-8 shadow-sm border border-emerald-100\">\n        \n        <div class=\"mb-6\">\n          <span class=\"text-xs font-bold text-emerald-600 uppercase tracking-wider\">1.2.3. Harflerin Çıkış Yerleri</span>\n          <h2 class=\"text-2xl font-bold text-slate-800 flex items-center gap-2\">\n            <i class=\"fa-solid fa-lungs text-emerald-600\"></i> Harflerin 3 Ana Mahreç Bölgesi\n          </h2>\n          <p class=\"text-slate-600 text-sm mt-1\">\n            Harflerin çıkış yerleri dil, dudak ve boğaz olmak üzere üçe ayrılır:\n          </p>\n        </div>\n\n        <div class=\"grid grid-cols-1 md:grid-cols-3 gap-4 mb-8\">\n          <!-- Dudak Harfleri -->\n          <div class=\"p-5 rounded-2xl bg-cyan-50/70 border border-cyan-200\">\n            <div class=\"flex items-center gap-3 mb-2\">\n              <span class=\"w-8 h-8 rounded-lg bg-cyan-600 text-white flex items-center justify-center text-sm font-bold\">1</span>\n              <div>\n                <h3 class=\"font-bold text-cyan-950 text-base\">Dudak Harfleri</h3>\n                <span class=\"text-[11px] text-cyan-700 font-semibold\">4 Harf</span>\n              </div>\n            </div>\n            <p class=\"text-xs text-slate-600 mb-3\">Alt ve üst dudakların birbirine veya dişlere temasıyla çıkar.</p>\n            <div class=\"bg-white p-3 rounded-xl border border-cyan-100 text-center font-quran text-2xl text-cyan-900 tracking-widest\">\n              ب • ف • م • و\n            </div>\n          </div>\n\n          <!-- Boğaz Harfleri -->\n          <div class=\"p-5 rounded-2xl bg-amber-50/70 border border-amber-200\">\n            <div class=\"flex items-center gap-3 mb-2\">\n              <span class=\"w-8 h-8 rounded-lg bg-amber-600 text-white flex items-center justify-center text-sm font-bold\">2</span>\n              <div>\n                <h3 class=\"font-bold text-amber-950 text-base\">Boğaz Harfleri</h3>\n                <span class=\"text-[11px] text-amber-700 font-semibold\">6 Harf</span>\n              </div>\n            </div>\n            <p class=\"text-xs text-slate-600 mb-3\">Boğazın sonu, ortası veya ağza en yakın kısmından çıkar.</p>\n            <div class=\"bg-white p-3 rounded-xl border border-amber-100 text-center font-quran text-2xl text-amber-900 tracking-widest\">\n              ا • ح • خ • ع • غ • ه\n            </div>\n          </div>\n\n          <!-- Dil (Diş/Damak) Harfleri -->\n          <div class=\"p-5 rounded-2xl bg-emerald-50/70 border border-emerald-200\">\n            <div class=\"flex items-center gap-3 mb-2\">\n              <span class=\"w-8 h-8 rounded-lg bg-emerald-600 text-white flex items-center justify-center text-sm font-bold\">3</span>\n              <div>\n                <h3 class=\"font-bold text-emerald-950 text-base\">Dil (Diş/Damak)</h3>\n                <span class=\"text-[11px] text-emerald-700 font-semibold\">18 Harf</span>\n              </div>\n            </div>\n            <p class=\"text-xs text-slate-600 mb-3\">Dilin uç, orta, kök veya kenarlarının damak ve dişlerle temasıyla çıkar.</p>\n            <div class=\"bg-white p-2 rounded-xl border border-emerald-100 text-center font-quran text-base text-emerald-900 leading-relaxed\">\n              ت • ث • ج • د • ذ • ر • ز • س • ش • ص • ض • ط • ظ • ق • ك • ل • ن • ى\n            </div>\n          </div>\n        </div>\n\n        <!-- İNTERAKTİF HARFLERİN MAHREÇ TABLOSU -->\n        <div>\n          <div class=\"flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-4\">\n            <h3 class=\"font-bold text-slate-800 text-lg flex items-center gap-2\">\n              <i class=\"fa-solid fa-table-list text-teal-600\"></i> Harflerin Mahreç Tablosu (28 Harf)\n            </h3>\n            <!-- Arama & Filtreleme Butonları -->\n            <div class=\"flex flex-wrap gap-1.5 bg-slate-100 p-1 rounded-xl text-xs font-semibold\">\n              <button onclick=\"filterTable('all')\" id=\"btn-all\" class=\"tab-btn active px-3 py-1.5 rounded-lg transition\">Tümü (28)</button>\n              <button onclick=\"filterTable('dil')\" id=\"btn-dil\" class=\"tab-btn px-3 py-1.5 rounded-lg text-slate-600 transition\">Dil (18)</button>\n              <button onclick=\"filterTable('bogaz')\" id=\"btn-bogaz\" class=\"tab-btn px-3 py-1.5 rounded-lg text-slate-600 transition\">Boğaz (6)</button>\n              <button onclick=\"filterTable('dudak')\" id=\"btn-dudak\" class=\"tab-btn px-3 py-1.5 rounded-lg text-slate-600 transition\">Dudak (4)</button>\n            </div>\n          </div>\n\n          <!-- Tablo Alanı -->\n          <div class=\"overflow-x-auto rounded-2xl border border-slate-200\">\n            <table class=\"w-full text-left border-collapse text-sm\" id=\"mahrec-table\">\n              <thead>\n                <tr class=\"bg-slate-800 text-white text-xs uppercase tracking-wider\">\n                  <th class=\"py-3.5 px-4 text-center w-16\">Harf</th>\n                  <th class=\"py-3.5 px-4\">Bölge</th>\n                  <th class=\"py-3.5 px-4\">Mahreç (Çıkış Yeri)</th>\n                  <th class=\"py-3.5 px-4\">Türkçedeki Karşılığı / Telaffuz Özelliği</th>\n                </tr>\n              </thead>\n              <tbody class=\"divide-y divide-slate-100 bg-white\" id=\"table-body\">\n                \n                <!-- ا -->\n                <tr data-region=\"bogaz\" class=\"hover:bg-slate-50 transition-colors\">\n                  <td class=\"py-3 px-4 text-center font-quran text-2xl font-bold text-emerald-800\">ا</td>\n                  <td class=\"py-3 px-4\"><span class=\"px-2 py-0.5 rounded bg-amber-100 text-amber-800 text-xs font-semibold\">Boğaz</span></td>\n                  <td class=\"py-3 px-4 font-medium text-slate-700\">Boğaz sonu</td>\n                  <td class=\"py-3 px-4 text-slate-600\">\"E\" harfi gibidir.</td>\n                </tr>\n\n                <!-- ب -->\n                <tr data-region=\"dudak\" class=\"hover:bg-slate-50 transition-colors\">\n                  <td class=\"py-3 px-4 text-center font-quran text-2xl font-bold text-emerald-800\">ب</td>\n                  <td class=\"py-3 px-4\"><span class=\"px-2 py-0.5 rounded bg-cyan-100 text-cyan-800 text-xs font-semibold\">Dudak</span></td>\n                  <td class=\"py-3 px-4 font-medium text-slate-700\">Alt ve üst dudak</td>\n                  <td class=\"py-3 px-4 text-slate-600\">\"B\" harfi gibidir.</td>\n                </tr>\n\n                <!-- ت -->\n                <tr data-region=\"dil\" class=\"hover:bg-slate-50 transition-colors\">\n                  <td class=\"py-3 px-4 text-center font-quran text-2xl font-bold text-emerald-800\">ت</td>\n                  <td class=\"py-3 px-4\"><span class=\"px-2 py-0.5 rounded bg-emerald-100 text-emerald-800 text-xs font-semibold\">Dil</span></td>\n                  <td class=\"py-3 px-4 font-medium text-slate-700\">Dil ucu ile ön diş dipleri</td>\n                  <td class=\"py-3 px-4 text-slate-600\">\"T\" harfi gibidir.</td>\n                </tr>\n\n                <!-- ث -->\n                <tr data-region=\"dil\" class=\"hover:bg-slate-50 transition-colors\">\n                  <td class=\"py-3 px-4 text-center font-quran text-2xl font-bold text-pink-700\">ث</td>\n                  <td class=\"py-3 px-4\"><span class=\"px-2 py-0.5 rounded bg-emerald-100 text-emerald-800 text-xs font-semibold\">Dil (Peltek)</span></td>\n                  <td class=\"py-3 px-4 font-medium text-slate-700\">Dil ucu ile ön diş uçları</td>\n                  <td class=\"py-3 px-4 text-slate-600\">\"S\" harfinin yumuşak söylenen hâli gibidir (Se).</td>\n                </tr>\n\n                <!-- ج -->\n                <tr data-region=\"dil\" class=\"hover:bg-slate-50 transition-colors\">\n                  <td class=\"py-3 px-4 text-center font-quran text-2xl font-bold text-emerald-800\">ج</td>\n                  <td class=\"py-3 px-4\"><span class=\"px-2 py-0.5 rounded bg-emerald-100 text-emerald-800 text-xs font-semibold\">Dil</span></td>\n                  <td class=\"py-3 px-4 font-medium text-slate-700\">Dil ve üst damak ortası</td>\n                  <td class=\"py-3 px-4 text-slate-600\">\"C\" harfinin yumuşatılmış şeklidir.</td>\n                </tr>\n\n                <!-- ح -->\n                <tr data-region=\"bogaz\" class=\"hover:bg-slate-50 transition-colors\">\n                  <td class=\"py-3 px-4 text-center font-quran text-2xl font-bold text-emerald-800\">ح</td>\n                  <td class=\"py-3 px-4\"><span class=\"px-2 py-0.5 rounded bg-amber-100