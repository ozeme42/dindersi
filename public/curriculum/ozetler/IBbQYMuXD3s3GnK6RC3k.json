  "htmlContent": "<!DOCTYPE html>\n<html lang=\"tr\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>6. Sınıf Temel Dini Bilgiler - Kelimeitevhit ve Kelimeişehadet Özet Sunumu</title>\n    <!-- Tailwind CSS CDN -->\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <!-- FontAwesome Icons -->\n    <link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css\" />\n    <style>\n        @import url('https://fonts.googleapis.com/css2?family=Fredoka:wght@300..700&family=Quicksand:wght@300..700&family=Amiri:ital,wght@0,400;0,700;1,400;1,700&display=swap');\n        \n        body {\n            font-family: 'Quicksand', sans-serif;\n            background-color: #f0fdf4;\n        }\n        .title-font {\n            font-family: 'Fredoka', sans-serif;\n        }\n        .arabic-font {\n            font-family: 'Amiri', serif;\n        }\n        .smart-tab-active {\n            background-color: #059669;\n            color: white;\n            box-shadow: 0 4px 14px 0 rgba(5, 150, 105, 0.3);\n            transform: translateY(-2px);\n        }\n    </style>\n</head>\n<body class=\"min-h-screen text-slate-800 flex flex-col justify-between selection:bg-emerald-200 selection:text-emerald-900\">\n\n    <!-- Üst Bilgi Barı (MEB Logolu & Ders Bilgili) -->\n    <header class=\"bg-gradient-to-r from-emerald-800 via-emerald-700 to-teal-800 text-white shadow-lg sticky top-0 z-50\">\n        <div class=\"max-w-7xl mx-auto px-4 py-3 flex flex-wrap justify-between items-center\">\n            <div class=\"flex items-center space-x-3\">\n                <div class=\"bg-white/10 p-2 rounded-xl backdrop-blur-sm border border-white/20\">\n                    <i class=\"fa-solid fa-book-open text-2xl text-amber-300\"></i>\n                </div>\n                <div>\n                    <h1 class=\"text-xs uppercase tracking-widest text-emerald-200 font-semibold\">T.C. MİLLÎ EĞİTİM BAKANLIĞI</h1>\n                    <p class=\"text-sm font-bold title-font\">6. Sınıf: Temel Dini Bilgiler 1</p>\n                </div>\n            </div>\n            <div class=\"text-center px-4 py-1.5 bg-white/10 rounded-full border border-white/10 text-xs font-semibold backdrop-blur-sm my-2 md:my-0\">\n                ÜNİTE 1: İMAN VE İNSAN\n            </div>\n            <div class=\"flex items-center space-x-2\">\n                <span class=\"text-xs bg-amber-500 text-slate-900 px-3 py-1 rounded-full font-bold animate-pulse\">AKILLI TAHTA MODU</span>\n            </div>\n        </div>\n    </header>\n\n    <!-- Ana İçerik Alanı -->\n    <main class=\"max-w-7xl w-full mx-auto px-4 py-6 flex-grow\">\n        \n        <!-- Ünite Konu Başlığı -->\n        <div class=\"text-center mb-8 bg-white p-6 rounded-3xl shadow-sm border border-emerald-100/50\">\n            <span class=\"text-emerald-600 font-bold uppercase tracking-wider text-xs\">Ders Kitabı Ünite Konusu</span>\n            <h2 class=\"text-3xl font-extrabold text-slate-800 title-font mt-1\">2. Kelimeitevhit ve Kelimeişehadet</h2>\n            <p class=\"text-slate-500 max-w-2xl mx-auto mt-2 text-sm\">\n                İslam inancının özünü oluşturan, Allah'ın birliğini ve Peygamberimiz Hz. Muhammed’in (sav) elçiliğini ilan eden iki eşsiz tevhit düsturu.\n            </p>\n        </div>\n\n        <!-- Akıllı Tahta İnteraktif Sekme Menüsü -->\n        <div class=\"grid grid-cols-2 md:grid-cols-4 gap-2 mb-8\">\n            <button onclick=\"switchTab('kelimeitevhit-tab', this)\" class=\"tab-btn smart-tab-active flex items-center justify-center space-x-2 py-4 px-4 rounded-2xl font-bold transition-all duration-300 text-sm md:text-base border border-emerald-100\">\n                <i class=\"fa-solid fa-star-and-crescent\"></i>\n                <span>Kelimeitevhit</span>\n            </button>\n            <button onclick=\"switchTab('kelimeisehadet-tab', this)\" class=\"tab-btn bg-white hover:bg-emerald-50 text-slate-700 flex items-center justify-center space-x-2 py-4 px-4 rounded-2xl font-bold transition-all duration-300 text-sm md:text-base border border-emerald-100 shadow-sm\">\n                <i class=\"fa-solid fa-hands-praying\"></i>\n                <span>Kelimeişehadet</span>\n            </button>\n            <button onclick=\"switchTab('kavramlar-tab', this)\" class=\"tab-btn bg-white hover:bg-emerald-50 text-slate-700 flex items-center justify-center space-x-2 py-4 px-4 rounded-2xl font-bold transition-all duration-300 text-sm md:text-base border border-emerald-100 shadow-sm\">\n                <i class=\"fa-solid fa-lightbulb\"></i>\n                <span>Kavram Kelimeleri</span>\n            </button>\n            <button onclick=\"switchTab('etkinlikler-tab', this)\" class=\"tab-btn bg-white hover:bg-emerald-50 text-slate-700 flex items-center justify-center space-x-2 py-4 px-4 rounded-2xl font-bold transition-all duration-300 text-sm md:text-base border border-emerald-100 shadow-sm text-center\">\n                <i class=\"fa-solid fa-gamepad\"></i>\n                <span>Tahta Etkinlikleri</span>\n            </button>\n        </div>\n\n        <!-- SEKMELİ İÇERİK ALANLARI -->\n        \n        <!-- 1. KELİMEİTEVHİT SEKMESİ -->\n        <div id=\"kelimeitevhit-tab\" class=\"tab-content block space-y-6 animate-fade-in\">\n            <div class=\"grid grid-cols-1 lg:grid-cols-3 gap-6\">\n                <!-- Sol: Ana Bilgi Kartı -->\n                <div class=\"lg:col-span-2 bg-white rounded-3xl p-6 md:p-8 shadow-md border border-emerald-50 space-y-6\">\n                    <div class=\"flex items-center space-x-3 border-b border-slate-100 pb-4\">\n                        <span class=\"w-10 h-10 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center font-bold\">1</span>\n                        <div>\n                            <h3 class=\"text-xl font-bold text-slate-800\">Kelimeitevhit Nedir ve Nasıl Okunur?</h3>\n                            <p class=\"text-xs text-slate-400\">İslam’ı kabul etmenin ilk şartı, inanarak dil ile söylemektir.</p>\n                        </div>\n                    </div>\n\n                    <!-- Okunuşu ve Meali Kutusu -->\n                    <div class=\"bg-gradient-to-br from-emerald-50 to-teal-50 border-l-4 border-emerald-600 rounded-2xl p-6 space-y-4\">\n                        <div>\n                            <span class=\"text-xs font-bold text-emerald-800 uppercase tracking-wider bg-emerald-100 px-2.5 py-1 rounded-md\">OKUNUŞU</span>\n                            <p class=\"text-xl md:text-2xl font-bold text-emerald-950 mt-2 italic tracking-wide\">\n                                “Lâ ilâhe illallah / Muḥammedürrasulüllâh”\n                            </p>\n                        </div>\n                        <hr class=\"border-emerald-100\" />\n                        <div>\n                            <span class=\"text-xs font-bold text-emerald-800 uppercase tracking-wider bg-emerald-100 px-2.5 py-1 rounded-md\">ANLAMI</span>\n                            <p class=\"text-lg md:text-xl font-medium text-slate-800 mt-2\">\n                                “Allah’tan (cc) başka ilah yoktur. Muhammed (sav) Allah’ın (cc) elçisidir.”\n                            </p>\n                        </div>\n                    </div>\n\n                    <!-- Kelimeitevhit Detay Analizi -->\n                    <div class=\"grid grid-cols-1 md:grid-cols-2 gap-4 mt-6\">\n                        <div class=\"bg-slate-50 p-5 rounded-2xl border border-slate-100\">\n                            <h4 class=\"font-bold text-emerald-800 mb-2 flex items-center space-x-2\">\n                                <i class=\"fa-solid fa-dharmachakra\"></i>\n                                <span>“Lâ ilâhe illallah”</span>\n                            </h4>\n                            <p class=\"text-sm text-slate-600 leading-relaxed\">\n                                Allah’ın (cc) var ve bir olduğunu belirtir. O’ndan başka ilahın olmadığını ifade eder. Allah’ın (cc) ortağı ve dengi yoktur. O hiçbir varlığa ihtiyaç duymaz, eşsiz özelliklere sahiptir.\n                            </p>\n                        </div>\n                        <div class=\"bg-slate-50 p-5 rounded-2xl border border-slate-100\">\n                            <h4 class=\"font-bold text-emerald-800 mb-2 flex items-center space-x-2\">\n                                <i class=\"fa-solid fa-user-tie\"></i>\n                                <span>“Muḥammedürrasulüllâh”</span>\n                            </h4>\n                            <p class=\"text-sm text-slate-600 leading-relaxed\">\n                                Hz. Muhammed’in (sav) Allah’ın (cc) peygamberi olduğunu belirtir. Allah (cc) her topluma emir ve yasaklarını bildirmesi için peygamber göndermiştir. Hz. Muhammed (sav) bu elçilerin sonuncusudur.\n                            </p>\n                        </div>\n                    </div>\n                </div>\n\n                <!-- Sağ: Ayet ve Kaynak Kutusu -->\n                <div class=\"space-y-6\">\n                    <!-- Kur'an-ı Kerim Ayetleri Kutusu -->\n                    <div class=\"bg-gradient-to-b from-teal-900 to-emerald-950 text-white rounded-3xl p-6 shadow-lg space-y-6 relative overflow-hidden\">\n                        <div class=\"absolute right-0 bottom-0 opacity-10 text-9xl\">\n                            <i class=\"fa-solid fa-book-quran\"></i>\n                        </div>\n                        <div class=\"flex items-center space-x-2 border-b border-white/10 pb-3\">\n                            <i class=\"fa-solid fa-quote-left text-amber-400 text-xl\"></i>\n                            <h4 class=\"font-bold text-amber-300\">İlgili Ayet-i Kerimeler</h4>\n                        </div>\n                        \n                        <div class=\"space-y-4 text-sm leading-relaxed\">\n                            <div class=\"bg-white/5 p-4 rounded-xl border border-white/10\">\n                                <p class=\"italic text-emerald-100\">\n                                    “Allah kendisinden başka hiçbir ilah bulunmayandır...”\n                                </p>\n                                <span class=\"block text-right text-xs text-amber-300 mt-1 font-semibold\">— Taha suresi, 8. ayet</span>\n                            </div>\n\n                            <div class=\"bg-white/5 p-4 rounded-xl border border-white/10\">\n                                <p class=\"italic text-emerald-100\">\n                                    “De ki: O, Allah’tır, bir tektir. Allah Samed’dir. (Her şey O’na muhtaçtır, O, hiçbir şeye muhtaç değildir.) O’ndan çocuk olmamıştır (Kimsenin babası değildir). Kendisi de doğmamıştır (kimsenin çocuğu değildir). Hiçbir şey O’na denk ve benzer değildir.”\n                                </p>\n                                <span class=\"block text-right text-xs text-amber-300 mt-1 font-semibold\">— İhlas suresi, 1-4. ayetler</span>\n                            </div>\n\n                            <div class=\"bg-white/5 p-4 rounded-xl border border-white/10\">\n                                <p class=\"italic text-emerald-100\">\n                                    “… Fakat O, Allah’ın Resulü ve nebilerin sonuncusudur…”\n                                </p>\n                                <span class=\"block text-right text-xs text-amber-300 mt-1 font-semibold\">— Ahzab suresi, 40. ayet</span>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n\n        <!-- 2. KELİMEİŞEHADET SEKMESİ -->\n        <div id=\"kelimeisehadet-tab\" class=\"tab-content hidden space-y-6 animate-fade-in\">\n            <div class=\"grid grid-cols-1 lg:grid-cols-3 gap-6\">\n                <!-- Sol: Ana Bilgi Kartı -->\n                <div class=\"lg:col-span-2 bg-white rounded-3xl p-6 md:p-8 shadow-md border border-emerald-50 space-y-6\">\n                    <div class=\"flex items-center space-x-3 border-b border-slate-100 pb-4\">\n                        <span class=\"w-10 h-10 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center font-bold\">2</span>\n                        <div>\n                            <h3 class=\"text-xl font-bold text-slate-800\">Kelimeişehadet Nedir ve Nasıl Okunur?</h3>\n                            <p class=\"text-xs text-slate-400\">Allah'ın varlığına, birliğine ve Hz. Muhammed'in elçiliğine şahitlik etmektir.</p>\n                        </div>\n                    </div>\n\n                    <!-- Okunuşu ve Meali Kutusu -->\n                    <div class=\"bg-gradient-to-br from-emerald-50 to-teal-50 border-l-4 border-emerald-600 rounded-2xl p-6 space-y-4\">\n                        <div>\n                            <span class=\"text-xs font-bold text-emerald-800 uppercase tracking-wider bg-emerald-100 px-2.5 py-1 rounded-md\">OKUNUŞU</span>\n                            <p class=\"text-xl md:text-2xl font-bold text-emerald-950 mt-2 italic tracking-wide\">\n                                “Eşhedü ellâ ilâhe illallah / Ve eşhedü enne Muḥammeden abdühû ve rasûlüh.”\n                            </p>\n                        </div>\n                        <hr class=\"border-emerald-100\" />\n                        <div>\n                            <span class=\"text-xs font-bold text-emerald-800 uppercase tracking-wider bg-emerald-100 px-2.5 py-1 rounded-md\">ANLAMI</span>\n                            <p class=\"text-lg md:text-xl font-medium text-slate-800 mt-2\">\n                                “Ben şahitlik ederim ki Allah’tan (cc) başka bir ilah yoktur. Ben yine şahitlik ederim ki Hz. Muhammed (sav) Allah’ın (cc) kulu ve resulüdür.”\n                            </p>\n                        </div>\n                    </div>\n\n                    <!-- Kelimeişehadeti Farklı Kılan İki Özel İfade -->\n                    <div>\n                        <h4 class=\"font-bold text-slate-800 mb-3 text-base\">Kelimeişehadette Yer Alan Farklı Kavramlar:</h4>\n                        <div class=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n                            <div class=\"bg-amber-50/50 p-5 rounded-2xl border border-amber-100 space-y-2\">\n                                <h5 class=\"font-bold text-amber-800 flex items-center space-x-2\">\n                                    <i class=\"fa-solid fa-eye\"></i>\n                                    <span>“Eşhedü” Ne Demektir?</span>\n                                </h5>\n                                <p class=\"text-sm text-slate-600 leading-relaxed\">\n                                    Şahitlik yapmak, tanıklık etmek anlamına gelir. Allah’ın (cc) birliğine, emir ve yasaklarının doğruluğuna inanmak ve Hz. Muhammed’in (sav) peygamberliğini kabul etmektir. Kişi bunu söyleyerek İslam'ı kabul ettiğini insanlara duyurmuş olur.\n                                </p>\n                            </div>\n                            <div class=\"bg-emerald-50/50 p-5 rounded-2xl border border-emerald-100 space-y-2\">\n                                <h5 class=\"font-bold text-emerald-800 flex items-center space-x-2\">\n                                    <i class=\"fa-solid fa-user-astronaut\"></i>\n                                    <span>“Abdühû” Ne Demektir?</span>\n                                </h5>\n                                <p class=\"text-sm text-slate-600 leading-relaxed\">\n                                    “O’nun kulu” anlamına gelir. Bu ifadeyle Hz. Muhammed’in (sav) Allah’ın (cc) kulu olduğu belirtilerek <strong class=\"text-emerald-950\">insani yönüne</strong> dikkat çekilir. O, insanlar arasından seçilmiş özel bir elçidir.\n                                </p>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n\n                <!-- Sağ: Ayet ve İnanç Esası -->\n                <div class=\"space-y-6\">\n                    <!-- Ayet Kutusu -->\n                    <div class=\"bg-gradient-to-b from-teal-900 to-emerald-950 text-white rounded-3xl p-6 shadow-lg space-y-4\">\n                        <div class=\"flex items-center space-x-2 border-b border-white/10 pb-3\">\n                            <i class=\"fa-solid fa-quote-left text-amber-400 text-xl\"></i>\n                            <h4 class=\"font-bold text-amber-300\">Efendimizin İnsani Yönü</h4>\n                        </div>\n                        <div class=\"bg-white/5 p-4 rounded-xl border border-white/10 text-sm\">\n                            <p class=\"italic text-emerald-100 leading-relaxed\">\n                                “De ki: Ben, yalnızca sizin gibi bir insanım. Şu var ki bana, ilahınızın, sadece bir ilah olduğu vahyolunuyor...”\n                            </p>\n                            <span class=\"block text-right text-xs text-amber-300 mt-2 font-semibold\">— Kehf suresi, 110. ayet</span>\n                        </div>\n                    </div>\n\n                    <!-- Önemli Not -->\n                    <div class=\"bg-amber-50 border border-amber-200 rounded-3xl p-6 space-y-3\">\n                        <h4 class=\"font-bold text-amber-900 flex items-center space-x-2\">\n                            <i class=\"fa-solid fa-circle-exclamation text-amber-600\"></i>\n                            <span>İman ve Samimiyet İlişkisi</span>\n                        </h4>\n                        <p class=\"text-xs text-amber-950 leading-relaxed\">\n                            Kişinin kalbinde olanı sadece Allah (cc) bilir <em class=\"text-xs text-slate-500\">(bk. Fatır suresi, 38. ayet)</em>. Bir kimsenin Müslüman olduğunu söylemesi ve davranışlarıyla göstermesi yeterlidir. Ancak gerçek anlamda mümin olmak için dili ile söylemesi yetmez, ona <strong>kalpten de inanması</strong> gerekir. Ayrıca bu ifadeleri ömürde bir kez değil, anlamını düşünerek sık sık tekrar etmelidir.\n                        </p>\n                    </div>\n                </div>\n            </div>\n        </div>\n\n        <!-- 3. KAVRAM KELİMELERİ SEKMESİ -->\n        <div id=\"kavramlar-tab\" class=\"tab-content hidden space-y-6 animate-fade-in\">\n            <div class=\"bg-white rounded-3xl p-6 md:p-8 shadow-md border border-emerald-50\">\n                <h3 class=\"text-2xl font-bold text-slate-800 title-font mb-6 flex items-center space-x-2\">\n                    <i class=\"fa-solid fa-tags text-emerald-600\"></i>\n                    <span>Ünitenin Temel Kavramları</span>\n                </h3>\n\n                <div class=\"grid grid-cols-1 md:grid-cols-3 gap-6\">\n                    <!-- Kavram 1 -->\n                    <div class=\"bg-gradient-to-br from-emerald-50 to-emerald-100/50 p-6 rounded-3xl border border-emerald-200/50 relative overflow-hidden group hover:shadow-md transition-all\">\n                        <span class=\"absolute right-4 top-4 text-emerald-300 text-3xl font-bold opacity-30\">01</span>\n                        <h4 class=\"text-xl font-bold text-emerald-900 mb-3\">Tevhit</h4>\n                        <p class=\"text-sm text-emerald-950 leading-relaxed\">\n                            İslam’ın en temel ilkesidir. Allah’ın (cc) varlığına ve birliğine inanmak, O’nun eşi, ortağı ve dengi olmadığını kabul etmektir.\n                        </p>\n                    </div>\n\n                    <!-- Kavram 2 -->\n                    <div class=\"bg-gradient-to-br from-teal-50 to-teal-100/50 p-6 rounded-3xl border border-teal-200/50 relative overflow-hidden group hover:shadow-md transition-all\">\n                        <span class=\"absolute right-4 top-4 text-teal-300 text-3xl font-bold opacity-30\">02</span>\n                        <h4 class=\"text-xl font-bold text-teal-900 mb-3\">İlah</h4>\n                        <p class=\"text-sm text-teal-950 leading-relaxed\">\n                            Duyularla idrak edilemeyen, varlığı kabul edilen ve kendisine ibadet edilen yüce varlıktır. İslam'a göre ibadete layık tek ilah Allah'tır.\n                        </p>\n                    </div>\n\n                    <!-- Kavram 3 -->\n                    <div class=\"bg-gradient-to-br from-amber-50 to-amber-100/50 p-6 rounded-3xl border border-amber-200/50 relative overflow-hidden group hover:shadow-md transition-all\">\n                        <span class=\"absolute right-4 top-4 text-amber-300 text-3xl font-bold opacity-30\">03</span>\n                        <h4 class=\"text-xl font-bold text-amber-900 mb-3\">Resul</h4>\n                        <p class=\"text-sm text-amber-950 leading-relaxed\">\n                            Allah (cc) tarafından kendisine yeni bir ilahi kitap gönderilen ve insanları uyarmakla görevlendirilen peygamberlerdir.\n                        </p>\n                    </div>\n                </div>\n\n                <!-- Kitap İçi Bilmece (Sıra Sizde) -->\n                <div class=\"mt-8 bg-slate-50 p-6 rounded-2xl border border-slate-100\">\n                    <h4 class=\"font-bold text-slate-800 mb-3 flex items-center space-x-2\">\n                        <i class=\"fa-solid fa-puzzle-piece text-amber-500\"></i>\n                        <span>Sıra Sizde: Karışık Harfler Etkinliği</span>\n                    </h4>\n                    <p class=\"text-xs text-slate-500 mb-4\">Aşağıdaki tabloda ders kitabında verilen karışık harflerin doğru sıralanışını butona basarak kontrol edebilirsiniz.</p>\n                    <div class=\"grid grid-cols-1 md:grid-cols-3 gap-4\">\n                        <div class=\"bg-white p-4 rounded-xl border border-slate-200 flex justify-between items-center\">\n                            <div>\n                                <span class=\"text-xs text-slate-400\">V H T İ E T</span>\n                                <p class=\"text-sm font-bold text-slate-700\">İnancın temeli</p>\n                            </div>\n                            <button onclick=\"revealWord(this, 'TEVHİT')\" class=\"bg-emerald-600 hover:bg-emerald-700 text-white text-xs px-3 py-1.5 rounded-lg font-bold transition\">Göster</button>\n                        </div>\n                        <div class=\"bg-white p-4 rounded-xl border border-slate-200 flex justify-between items-center\">\n                            <div>\n                                <span class=\"text-xs text-slate-400\">A İ H L</span>\n                                <p class=\"text-sm font-bold text-slate-700\">İbadet edilen varlık</p>\n                            </div>\n                            <button onclick=\"revealWord(this, 'İLAH')\" class=\"bg-emerald-600 hover:bg-emerald-700 text-white text-xs px-3 py-1.5 rounded-lg font-bold transition\">Göster</button>\n                        </div>\n                        <div class=\"bg-white p-4 rounded-xl border border-slate-200 flex justify-between items-center\">\n                            <div>\n                                <span class=\"text-xs text-slate-400\">E U S R L</span>\n                                <p class=\"text-sm font-bold text-slate-700\">Kitap verilen elçi</p>\n                            </div>\n                            <button onclick=\"revealWord(this, 'RESUL')\" class=\"bg-emerald-600 hover:bg-emerald-700 text-white text-xs px-3 py-1.5 rounded-lg font-bold transition\">Göster</button>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n\n        <!-- 4. TAHTA ETKİNLİKLERİ SEKMESİ -->\n        <div id=\"etkinlikler-tab\" class=\"tab-content hidden space-y-6 animate-fade-in\">\n            <!-- Oyun 1: Kelime İnşa Etmece -->\n            <div class=\"bg-white rounded-3xl p-6 md:p-8 shadow-md border border-emerald-50\">\n                <div class=\"flex items-center space-x-2 mb-4\">\n                    <i class=\"fa-solid fa-cubes text-emerald-600 text-xl\"></i>\n                    <h3 class=\"text-xl font-bold text-slate-800 title-font\">Etkinlik 1: Kelime Yerleştirme Oyunu</h3>\n                </div>\n                <p class=\"text-sm text-slate-500 mb-6\">\n                    Aşağıda verilen kelimeleri kullanarak Kelimeitevhit ve Kelimeişehadeti doğru sırayla oluşturunuz. Üzerine tıklayarak kelimeleri aşağıya ekleyebilirsiniz.\n                </p>\n\n                <!-- Kelime Havuzu -->\n                <div class=\"bg-slate-50 p-4 rounded-2xl border border-slate-200 mb-6\">\n                    <span class=\"text-xs font-bold text-slate-500 block mb-2\">KELİME HAVUZU (Tıkla ve Ekle):</span>\n                    <div id=\"word-pool\" class=\"flex flex-wrap gap-2\">\n                        <!-- JS dinamik dolduracak -->\n                    </div>\n                </div>\n\n                <!-- Çalışma Alanı -->\n                <div class=\"space-y-4\">\n                    <!-- Kelimeitevhit Alanı -->\n                    <div class=\"bg-emerald-50/50 p-4 rounded-2xl border border-emerald-200\">\n                        <div class=\"flex justify-between items-center mb-2\">\n                            <span class=\"text-xs font-bold text-emerald-800\">Hedef: Kelimeitevhit'i Yazınız</span>\n                            <button onclick=\"clearPhrase('itevhit')\" class=\"text-xs text-red-600 hover:underline\"><i class=\"fa-solid fa-trash\"></i> Temizle</button>\n                        </div>\n                        <div id=\"itevhit-zone\" class=\"min-h-[50px] bg-white rounded-xl border border-dashed border-emerald-300 p-2 flex flex-wrap gap-2 items-center\">\n                            <!-- Dragged words go here -->\n                        </div>\n                    </div>\n\n                    <!-- Kelimeişehadet Alanı -->\n                    <div class=\"bg-teal-50/50 p-4 rounded-2xl border border-teal-200\">\n                        <div class=\"flex justify-between items-center mb-2\">\n                            <span class=\"text-xs font-bold text-teal-800\">Hedef: Kelimeişehadet'i Yazınız</span>\n                            <button onclick=\"clearPhrase('isehadet')\" class=\"text-xs text-red-600 hover:underline\"><i class=\"fa-solid fa-trash\"></i> Temizle</button>\n                        </div>\n                        <div id=\"isehadet-zone\" class=\"min-h-[50px] bg-white rounded-xl border border-dashed border-teal-300 p-2 flex flex-wrap gap-2 items-center\">\n                            <!-- Dragged words go here -->\n                        </div>\n                    </div>\n                </div>\n\n                <div class=\"mt-6 flex justify-end space-x-3\">\n                    <button onclick=\"checkGameAnswers()\" class=\"bg-emerald-600 hover:bg-emerald-700 text-white font-bold px-6 py-3 rounded-xl shadow transition\">Cevapları Kontrol Et</button>\n                </div>\n            </div>\n\n            <!-- Etkinlik 2: 5N1K Akıllı Soru Kartları -->\n            <div class=\"bg-white rounded-3xl p-6 md:p-8 shadow-md border border-emerald-50\">\n                <div class=\"flex items-center space-x-2 mb-4\">\n                    <i class=\"fa-solid fa-circle-question text-teal-600 text-xl\"></i>\n                    <h3 class=\"text-xl font-bold text-slate-800 title-font\">Etkinlik 2: 5N1K Akıllı Kartları</h3>\n                </div>\n                <p class=\"text-sm text-slate-500 mb-6\">Sorunun cevabını tahmin edin ve ardından tahtada cevabı açmak için karta tıklayın!</p>\n\n                <div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6\">\n                    <!-- Kart 1: KİM -->\n                    <div onclick=\"toggleCard(this)\" class=\"bg-slate-50 border border-slate-200 p-6 rounded-2xl cursor-pointer hover:shadow-md transition duration-200 group relative\">\n                        <div class=\"text-amber-500 font-bold text-lg mb-1\">KİM</div>\n                        <div class=\"font-bold text-slate-800 text-sm mb-4\">Kelimeitevhit ve kelimeişehadeti kimlerin getirmesi gerekir?</div>\n                        <div class=\"card-answer hidden text-xs text-emerald-800 border-t border-emerald-100 pt-3 leading-relaxed\">\n                            İslam’ı kabul etmek isteyen, Allah’a (cc) ve Hz. Muhammed’e (sav) inanıp Müslüman olmak isteyen herkesin bunu kalpten inanarak ve diliyle söyleyerek getirmesi gerekir.\n                        </div>\n                        <span class=\"absolute bottom-2 right-4 text-[10px] text-slate-400 group-hover:text-emerald-600\">Cevabı Göster <i class=\"fa-solid fa-arrow-pointer\"></i></span>\n                    </div>\n\n                    <!-- Kart 2: NE ZAMAN -->\n                    <div onclick=\"toggleCard(this)\" class=\"bg-slate-50 border border-slate-200 p-6 rounded-2xl cursor-pointer hover:shadow-md transition duration-200 group relative\">\n                        <div class=\"text-amber-500 font-bold text-lg mb-1\">NE ZAMAN</div>\n                        <div class=\"font-bold text-slate-800 text-sm mb-4\">Kelimeitevhit ve kelimeişehadet ne zaman söylenir?</div>\n                        <div class=\"card-answer hidden text-xs text-emerald-800 border-t border-emerald-100 pt-3 leading-relaxed\">\n                            İslam’a girerken ilk şart olarak, ayrıca bir mümin olarak günlük yaşamda, ibadetlerde, dualarda ve ömür boyunca sık sık anlamı düşünülerek tekrarlanır.\n                        </div>\n                        <span class=\"absolute bottom-2 right-4 text-[10px] text-slate-400 group-hover:text-emerald-600\">Cevabı Göster <i class=\"fa-solid fa-arrow-pointer\"></i></span>\n                    </div>\n\n                    <!-- Kart 3: NİÇİN -->\n                    <div onclick=\"toggleCard(this)\" class=\"bg-slate-50 border border-slate-200 p-6 rounded-2xl cursor-pointer hover:shadow-md transition duration-200 group relative\">\n                        <div class=\"text-amber-500 font-bold text-lg mb-1\">NİÇİN</div>\n                        <div class=\"font-bold text-slate-800 text-sm mb-4\">Kelimeitevhit ve kelimeişehadeti niçin söylemek gerekir?</div>\n                        <div class=\"card-answer hidden text-xs text-emerald-800 border-t border-emerald-100 pt-3 leading-relaxed\">\n                            Allah'a (cc) ve O'nun elçisi Hz. Muhammed'e (sav) olan içten inancımızı kalbimizden dilimize taşımak ve Müslümanlığımızı ikrar etmek için söylemek gerekir.\n                        </div>\n                        <span class=\"absolute bottom-2 right-4 text-[10px] text-slate-400 group-hover:text-emerald-600\">Cevabı Göster <i class=\"fa-solid fa-arrow-pointer\"></i></span>\n                    </div>\n\n                    <!-- Kart 4: NASIL -->\n                    <div onclick=\"toggleCard(this)\" class=\"bg-slate-50 border border-slate-200 p-6 rounded-2xl cursor-pointer hover:shadow-md transition duration-200 group relative\">\n                        <div class=\"text-amber-500 font-bold text-lg mb-1\">NASIL</div>\n                        <div class=\"font-bold text-slate-800 text-sm mb-4\">Kelimeitevhit ve kelimeişehadeti nasıl okumak gerekir?</div>\n                        <div class=\"card-answer hidden text-xs text-emerald-800 border-t border-emerald-100 pt-3 leading-relaxed\">\n                            Sadece dille söylenmesi yetmez; gerçek anlamda mümin olmak için anlamını düşünerek, gönülden ve kalpten tam bir inanmışlıkla okumak gerekir.\n                        </div>\n                        <span class=\"absolute bottom-2 right-4 text-[10px] text-slate-400 group-hover:text-emerald-600\">Cevabı Göster <i class=\"fa-solid fa-arrow-pointer\"></i></span>\n                    </div>\n\n                    <!-- Kart 5: NEDEN -->\n                    <div onclick=\"toggleCard(this)\" class=\"bg-slate-50 border border-slate-200 p-6 rounded-2xl cursor-pointer hover:shadow-md transition duration-200 group relative\">\n                        <div class=\"text-amber-500 font-bold text-lg mb-1\">NEDEN</div>\n                        <div class=\"font-bold text-slate-800 text-sm mb-4\">Kelimeitevhit ve kelimeişehadette neden bahsedilir?</div>\n                        <div class=\"card-answer hidden text-xs text-emerald-800 border-t border-emerald-100 pt-3 leading-relaxed\">\n                            Allah'ın tek, benzersiz ve eşsiz olduğundan (tevhit inancı) ve Hz. Muhammed'in (sav) Allah'ın bir kulu ve elçisi (resulü) olduğundan bahsedilir.\n                        </div>\n                        <span class=\"absolute bottom-2 right-4 text-[10px] text-slate-400 group-hover:text-emerald-600\">Cevabı Göster <i class=\"fa-solid fa-arrow-pointer\"></i></span>\n                    </div>\n\n                    <!-- Kart 6: NEREDE -->\n                    <div onclick=\"toggleCard(this)\" class=\"bg-slate-50 border border-slate-200 p-6 rounded-2xl cursor-pointer hover:shadow-md transition duration-200 group relative\">\n                        <div class=\"text-amber-500 font-bold text-lg mb-1\">NEREDE</div>\n                        <div class=\"font-bold text-slate-800 text-sm mb-4\">Kelimeitevhit ve kelimeişehadet nerede söylenmelidir?</div>\n                        <div class=\"card-answer hidden text-xs text-emerald-800 border-t border-emerald-100 pt-3 leading-relaxed\">\n                            Her an, her temiz mekanda söylenebilir. Kişinin kelimeişehadeti dili ile söylemesi, çevresindeki insanların onun Müslüman olduğuna tanık olması için yeterlidir.\n                        </div>\n                        <span class=\"absolute bottom-2 right-4 text-[10px] text-slate-400 group-hover:text-emerald-600\">Cevabı Göster <i class=\"fa-solid fa-arrow-pointer\"></i></span>\n                    </div>\n                </div>\n            </div>\n        </div>\n\n        <!-- Alt Sabit Özet ve Sınav İpucu Kutusu -->\n        <div class=\"mt-8 bg-gradient-to-r from-amber-50 to-orange-50 border border-amber-200 rounded-3xl p-6 md:p-8 flex flex-col md:flex-row items-center justify-between space-y-4 md:space-y-0 md:space-x-6\">\n            <div class=\"flex items-center space-x-4\">\n                <div class=\"bg-amber-100 text-amber-800 p-4 rounded-2xl text-2xl\">\n                    <i class=\"fa-solid fa-graduation-cap\"></i>\n                </div>\n                <div>\n                    <h4 class=\"font-bold text-slate-800 text-base\">💡 Sınav Hazırlık & Önemli Püf Noktası</h4>\n                    <p class=\"text-xs text-slate-600 max-w-xl mt-1 leading-relaxed\">\n                        Kelimeitevhit ile Kelimeişehadet arasındaki farka dikkat edin! Kelimeişehadet'te ek olarak şahitlik anlamına gelen <strong>\"Eşhedü\"</strong> ve peygamberimizin insani yönünü vurgulayan <strong>\"abdühû (kulu)\"</strong> kelimeleri bulunur.\n                    </p>\n                </div>\n            </div>\n            <div class=\"flex-shrink-0\">\n                <span class=\"bg-amber-200 text-amber-900 text-xs font-bold px-4 py-2 rounded-xl\">6. Sınıf %100 MEB Uyumlu</span>\n            </div>\n        </div>\n\n    </main>\n\n    <!-- MEB Lisans ve Bilgi Footer -->\n    <footer class=\"bg-slate-900 text-slate-400 text-xs py-6 border-t border-slate-800\">\n        <div class=\"max-w-7xl mx-auto px-4 flex flex-col md:flex-row justify-between items-center space-y-3 md:space-y-0\">\n            <p>© 2024 MEB Din Öğretimi Genel Müdürlüğü Kaynaklarına ve Ders Kitabına %100 Sadık Kalınarak Tasarlanmıştır.</p>\n            <div class=\"flex space-x-4\">\n                <span>Konu: 2. Kelimeitevhit ve Kelimeişehadet</span>\n                <span>Sürüm: 1.2 (Akıllı Tahta Sunumu)</span>\n            </div>\n        </div>\n    </footer>\n\n    <!-- İnteraktif JavaScript Kodları -->\n    <script>\n        // Sekme Değiştirme Fonksiyonu\n        function switchTab(tabId, button) {\n            // Tüm içerikleri gizle\n            const contents = document.querySelectorAll('.tab-content');\n            contents.forEach(content => content.classList.add('hidden'));\n\n            // Tıklanan içeriği göster\n            document.getElementById(tabId).classList.remove('hidden');\n\n            // Tüm buton stillerini sıfırla\n            const buttons = document.querySelectorAll('.tab-btn');\n            buttons.forEach(btn => {\n                btn.className = \"tab-btn bg-white hover:bg-emerald-50 text-slate-700 flex items-center justify-center space-x-2 py-4 px-4 rounded-2xl font-bold transition-all duration-300 text-sm md:text-base border border-emerald-100 shadow-sm\";\n            });\n\n            // Aktif buton stilini ekle\n            button.className = \"tab-btn smart-tab-active flex items-center justify-center space-x-2 py-4 px-4 rounded-2xl font-bold transition-all duration-300 text-sm md:text-base border border-emerald-100\";\n        }\n\n        // Harf Karıştırma Cevap Gösterici\n        function revealWord(btn, originalWord) {\n            if (btn.innerText === \"Göster\") {\n                btn.innerText = originalWord;\n                btn.classList.replace('bg-emerald-600', 'bg-amber-500');\n            } else {\n                btn.innerText = \"Göster\";\n                btn.classList.replace('bg-amber-500', 'bg-emerald-600');\n            }\n        }\n\n        // 5N1K Kart Tıklama Göster/Gizle\n        function toggleCard(card) {\n            const answer = card.querySelector('.card-answer');\n            answer.classList.toggle('hidden');\n        }\n\n        // --- Kelime İnşa Etme Oyunu Kodları ---\n        const gameWords = [\n            \"Muhammeden\", \"Lâ ilâhe\", \"ellâ\", \"illallah\", \"Elḥamdülillâhi\", \n            \"Ve lâ ilâhe\", \"Eşhedü\", \"ve rasûlüh\", \"ilâhe\", \"Allâhümme\", \n            \"illallah\", \"enne\", \"abdühû\", \"Ve eşhedü\", \"Muhammedürrasulüllâh\"\n        ];\n\n        // Kelime Havuzunu Karıştırarak Oluştur\n        function initGame() {\n            const pool = document.getElementById('word-pool');\n            pool.innerHTML = '';\n            \n            // Şık bir görünüm için kelimeleri dağıtalım\n            gameWords.forEach((word, index) => {\n                const btn = document.createElement('button');\n                btn.className = \"bg-white hover:bg-slate-100 text-slate-700 font-semibold px-3 py-1.5 rounded-lg border border-slate-300 text-xs shadow-sm transition-all transform hover:-translate-y-0.5 active:translate-y-0 m-1\";\n                btn.innerText = word;\n                btn.onclick = () => addWordToZones(word, btn);\n                pool.appendChild(btn);\n            });\n        }\n\n        let selectedTevhit = [];\n        let selectedSehadet = [];\n\n        function addWordToZones(word, btnElement) {\n            // Basit bir modal ya da akıllı seçim: Önce hangisinin boş olduğuna bakalım\n            // Öğretmen tahtada tıkladığında sırayla veya seçtiği hedefe gitsin.\n            // Kolaylık olması açısından: Kelimeitevhit bittiyse şehadete eklesin.\n            if (selectedTevhit.length < 3) { // Basit kontrol\n                selectedTevhit.push(word);\n                renderZone('itevhit');\n            } else {\n                selectedSehadet.push(word);\n                renderZone('isehadet');\n            }\n            btnElement.classList.add('opacity-40', 'pointer-events-none');\n        }\n\n        function renderZone(type) {\n            const zone = document.getElementById(`${type}-zone`);\n            zone.innerHTML = '';\n            const targetArray = type === 'itevhit' ? selectedTevhit : selectedSehadet;\n\n            targetArray.forEach((word, idx) => {\n                const span = document.createElement('span');\n                span.className = \"bg-emerald-100 text-emerald-900 font-bold px-3 py-1 rounded-md text-xs flex items-center space-x-1\";\n                span.innerHTML = `<span>${word}</span> <i onclick=\"removeWord('${type}', ${idx}, '${word}')\" class=\"fa-solid fa-circle-xmark cursor-pointer text-red-500 ml-1\"></i>`;\n                zone.appendChild(span);\n            });\n        }\n\n        window.removeWord = function(type, index, word) {\n            const targetArray = type === 'itevhit' ? selectedTevhit : selectedSehadet;\n            targetArray.splice(index, 1);\n            renderZone(type);\n\n            // Havuzdaki kelimenin kilidini aç\n            const buttons = document.getElementById('word-pool').getElementsByTagName('button');\n            for (let btn of buttons) {\n                if (btn.innerText === word && btn.classList.contains('opacity-40')) {\n                    btn.classList.remove('opacity-40', 'pointer-events-none');\n                    break;\n                }\n            }\n        }\n\n        window.clearPhrase = function(type) {\n            if (type === 'itevhit') {\n                selectedTevhit.forEach(w => reactivateWordInPool(w));\n                selectedTevhit = [];\n                renderZone('itevhit');\n            } else {\n                selectedSehadet.forEach(w => reactivateWordInPool(w));\n                selectedSehadet = [];\n                renderZone('isehadet');\n            }\n        }\n\n        function reactivateWordInPool(word) {\n            const buttons = document.getElementById('word-pool').getElementsByTagName('button');\n            for (let btn of buttons) {\n                if (btn.innerText === word && btn.classList.contains('opacity-40')) {\n                    btn.classList.remove('opacity-40', 'pointer-events-none');\n                }\n            }\n        }\n\n        // Doğru cevapları test etme\n        window.checkGameAnswers = function() {\n            // Kelimeitevhit kontrolü: Lâ ilâhe illallah Muhammedürrasulüllâh\n            const tevhitStr = selectedTevhit.join(' ');\n            const correctTevhit = \"Lâ ilâhe illallah Muhammedürrasulüllâh\";\n            \n            // Kelimeişehadet kontrolü: Eşhedü ellâ ilâhe illallah Ve eşhedü enne Muhammeden abdühû ve rasûlüh\n            const sehadetStr = selectedSehadet.join(' ');\n            const correctSehadet = \"Eşhedü ellâ ilâhe illallah Ve eşhedü enne Muhammeden abdühû ve rasûlüh\";\n\n            let message = \"\";\n            if (tevhitStr.trim() === correctTevhit && sehadetStr.trim() === correctSehadet) {\n                message = \"🎉 Tebrikler! Her iki ifadeyi de doğru sırayla yerleştirdiniz.\";\n                alert(message);\n            } else {\n                message = \"Bazı kelimeler yanlış sırada veya eksik yerleştirilmiş olabilir.\\n\\nİpuçları:\\n- Kelimeitevhit: Lâ ilâhe illallah Muhammedürrasulüllâh\\n- Kelimeişehadet: Eşhedü ellâ ilâhe illallah Ve eşhedü enne Muhammeden abdühû ve rasûlüh\";\n                alert(message);\n            }\n        }\n\n        // Sayfa ilk yüklendiğinde oyunu hazırla\n        window.onload = function() {\n            initGame();\n        };\n    </script>\n</body>\n</html>",
  "updatedAt": "2026-09-12T10:09:39.138Z"
}