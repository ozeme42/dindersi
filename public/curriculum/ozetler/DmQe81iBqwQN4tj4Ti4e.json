  "htmlContent": "<!DOCTYPE html>\n<html lang=\"tr\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>6. Sınıf Kur'an-ı Kerim - Salli ve Barik Duaları</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css\">\n    <link href=\"https://fonts.googleapis.com/css2?family=Amiri:ital,wght@0,400;0,700;1,400&family=Inter:wght@300;400;500;600;700;800&display=swap\" rel=\"stylesheet\">\n    <style>\n        body { font-family: 'Inter', sans-serif; background-color: #f8fafc; }\n        .font-arabic { font-family: 'Amiri', serif; }\n        .tab-btn.active { background-color: #0d9488; color: white; border-color: #0d9488; shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1); }\n    </style>\n</head>\n<body class=\"text-slate-800 antialiased min-h-screen flex flex-col justify-between\">\n\n    <!-- ÜST BİLGİ DOKUSU / HEADER -->\n    <header class=\"bg-emerald-900 text-white shadow-xl border-b-4 border-amber-400 sticky top-0 z-50\">\n        <div class=\"max-w-7xl mx-auto px-4 py-4 sm:px-6 lg:px-8 flex flex-col md:flex-row justify-between items-center gap-4\">\n            <div class=\"flex items-center space-x-4\">\n                <div class=\"bg-amber-400 text-emerald-950 p-3 rounded-2xl shadow-lg font-black text-xl flex items-center justify-center w-12 h-12\">\n                    6\n                </div>\n                <div>\n                    <div class=\"flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-amber-300\">\n                        <span>1. TEMA: KUR'AN-I KERİM'İ TANIYORUM</span>\n                        <span>•</span>\n                        <span>DERS ÖZETİ</span>\n                    </div>\n                    <h1 class=\"text-2xl font-extrabold text-white tracking-tight\">1.4. Salli ve Barik Duaları ile Anlamları</h1>\n                </div>\n            </div>\n            \n            <div class=\"flex items-center bg-emerald-800/80 px-4 py-2 rounded-xl border border-emerald-700/50 text-xs font-medium text-emerald-100\">\n                <i class=\"fa-solid fa-graduation-cap text-amber-300 mr-2 text-base\"></i>\n                MEB Akıllı Tahta İnteraktif Ders Materyali\n            </div>\n        </div>\n    </header>\n\n    <!-- ANA İÇERİK KONTROL PANELİ (TABS) -->\n    <main class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 flex-grow w-full\">\n        \n        <!-- NAVİGASYON SEKMELERİ -->\n        <div class=\"grid grid-cols-2 md:grid-cols-4 gap-2 mb-6 bg-slate-200/80 p-1.5 rounded-2xl border border-slate-300\">\n            <button onclick=\"switchTab('ozet')\" id=\"tab-ozet\" class=\"tab-btn active py-3 px-4 rounded-xl font-bold text-sm sm:text-base transition-all duration-200 flex items-center justify-center gap-2\">\n                <i class=\"fa-solid fa-book-open\"></i>\n                <span>Konu Özet & Kavramlar</span>\n            </button>\n            <button onclick=\"switchTab('dualar')\" id=\"tab-dualar\" class=\"tab-btn py-3 px-4 bg-white text-slate-700 rounded-xl font-bold text-sm sm:text-base hover:bg-slate-50 transition-all duration-200 flex items-center justify-center gap-2 border border-slate-200\">\n                <i class=\"fa-solid fa-hands-praying\"></i>\n                <span>Dualar ve Okunuşları</span>\n            </button>\n            <button onclick=\"switchTab('grafik')\" id=\"tab-grafik\" class=\"tab-btn py-3 px-4 bg-white text-slate-700 rounded-xl font-bold text-sm sm:text-base hover:bg-slate-50 transition-all duration-200 flex items-center justify-center gap-2 border border-slate-200\">\n                <i class=\"fa-solid fa-chart-pie\"></i>\n                <span>Okunduğu Yerler</span>\n            </button>\n            <button onclick=\"switchTab('etkinlik')\" id=\"tab-etkinlik\" class=\"tab-btn py-3 px-4 bg-white text-slate-700 rounded-xl font-bold text-sm sm:text-base hover:bg-slate-50 transition-all duration-200 flex items-center justify-center gap-2 border border-slate-200\">\n                <i class=\"fa-solid fa-list-check\"></i>\n                <span>Etkinlik ve Ölçme</span>\n            </button>\n        </div>\n\n        <!-- SEKME 1: KONU ÖZETİ VE KAVRAMLAR -->\n        <div id=\"content-ozet\" class=\"tab-content space-y-6\">\n            \n            <!-- KAVRAM KUTULARI -->\n            <div class=\"grid grid-cols-1 md:grid-cols-3 gap-4\">\n                <div class=\"bg-gradient-to-br from-emerald-50 to-teal-50 border-2 border-emerald-200 rounded-2xl p-5 shadow-sm\">\n                    <div class=\"flex items-center gap-3 mb-2\">\n                        <div class=\"w-10 h-10 rounded-xl bg-emerald-600 text-white flex items-center justify-center text-lg font-bold shadow-md\">\n                            <i class=\"fa-solid fa-heart\"></i>\n                        </div>\n                        <h3 class=\"font-extrabold text-lg text-emerald-900\">Salavat Nedir?</h3>\n                    </div>\n                    <p class=\"text-sm text-slate-700 leading-relaxed\">\n                        Sözlükte <strong>Hz. Muhammed'e (sav) saygı bildirmek</strong> için okunan dua anlamına gelir. Peygamber'i sevme, onun için rahmet ve bereket dilemeyi, manevi şahsiyetini selamlamayı ifade eder.\n                    </p>\n                </div>\n\n                <div class=\"bg-gradient-to-br from-amber-50 to-orange-50 border-2 border-amber-200 rounded-2xl p-5 shadow-sm\">\n                    <div class=\"flex items-center gap-3 mb-2\">\n                        <div class=\"w-10 h-10 rounded-xl bg-amber-500 text-white flex items-center justify-center text-lg font-bold shadow-md\">\n                            <i class=\"fa-solid fa-hand-holding-heart\"></i>\n                        </div>\n                        <h3 class=\"font-extrabold text-lg text-amber-900\">Dua Nedir?</h3>\n                    </div>\n                    <p class=\"text-sm text-slate-700 leading-relaxed\">\n                        Kavram kutusu tanımına göre dua; <strong>saygı gösterme, önem verme ve rahmet</strong> gibi anlamlara gelmektedir. (bk. Mertoğlu, \"Salâtü Selâm\")\n                    </p>\n                </div>\n\n                <div class=\"bg-gradient-to-br from-blue-50 to-indigo-50 border-2 border-blue-200 rounded-2xl p-5 shadow-sm\">\n                    <div class=\"flex items-center gap-3 mb-2\">\n                        <div class=\"w-10 h-10 rounded-xl bg-blue-600 text-white flex items-center justify-center text-lg font-bold shadow-md\">\n                            <i class=\"fa-solid fa-users text-base\"></i>\n                        </div>\n                        <h3 class=\"font-extrabold text-lg text-blue-900\">Salli & Barik Duaları</h3>\n                    </div>\n                    <p class=\"text-sm text-slate-700 leading-relaxed\">\n                        Yüce Allah'tan Peygamber Efendimiz ve ailesine <strong>rahmet ve bereket</strong> verilmesi istenir. Müslümanlar bu dualarla <strong>Hz. İbrahim ve ailesini</strong> de hatırlar.\n                    </p>\n                </div>\n            </div>\n\n            <!-- AYET VE HADİSLER KUTUSU -->\n            <div class=\"bg-white rounded-3xl border border-slate-200 shadow-md overflow-hidden\">\n                <div class=\"bg-slate-900 text-white px-6 py-4 flex items-center justify-between\">\n                    <div class=\"flex items-center gap-3\">\n                        <i class=\"fa-solid fa-quran text-amber-400 text-xl\"></i>\n                        <h2 class=\"font-extrabold text-lg tracking-wide\">Ayet ve Hadis-i Şerifler</h2>\n                    </div>\n                    <span class=\"text-xs bg-slate-800 text-amber-300 px-3 py-1 rounded-full font-semibold border border-amber-400/30\">Metinde Geçen Kaynaklar</span>\n                </div>\n\n                <div class=\"p-6 space-y-6\">\n                    <!-- Kur'an Ayeti -->\n                    <div class=\"p-5 bg-emerald-50/70 border-l-4 border-emerald-600 rounded-r-2xl\">\n                        <div class=\"flex items-center gap-2 text-emerald-800 font-bold text-xs uppercase tracking-wider mb-2\">\n                            <i class=\"fa-solid fa-book-quran\"></i> Kur'an-ı Kerim\n                        </div>\n                        <p class=\"text-slate-800 font-medium text-base sm:text-lg italic leading-relaxed\">\n                            \"Şüphesiz Allah (cc) ve melekleri Hz. Peygamber'e salat ediyorlar. Ey iman edenler! Siz de ona salat edin, selam edin.\"\n                        </p>\n                    </div>\n\n                    <!-- Hadisler Grid -->\n                    <div class=\"grid grid-cols-1 md:grid-cols-3 gap-4\">\n                        <div class=\"p-4 bg-slate-50 border border-slate-200 rounded-2xl flex flex-col justify-between\">\n                            <div>\n                                <span class=\"inline-block text-xs font-bold text-teal-700 bg-teal-100 px-2 py-0.5 rounded mb-2\">Hadis-i Şerif (Yakınlık)</span>\n                                <p class=\"text-xs text-slate-700 italic\">\"Kıyamet günü insanların bana en yakını, bana en çok salavat getirendir.\"</p>\n                            </div>\n                            <span class=\"text-[10px] text-slate-400 mt-3 font-semibold\">— Hz. Muhammed (sav)</span>\n                        </div>\n\n                        <div class=\"p-4 bg-slate-50 border border-slate-200 rounded-2xl flex flex-col justify-between\">\n                            <div>\n                                <span class=\"inline-block text-xs font-bold text-amber-700 bg-amber-100 px-2 py-0.5 rounded mb-2\">Hadis-i Şerif (Dua Adabı)</span>\n                                <p class=\"text-xs text-slate-700 italic\">\"Biriniz dua edeceği zaman önce Yüce Rabb'ine hamd ve sena etmekle başlasın, sonra Hz. Peygamber'e salat getirsin. Daha sonra da dilediği şekilde dua etsin.\"</p>\n                            </div>\n                            <span class=\"text-[10px] text-slate-400 mt-3 font-semibold\">— Hz. Muhammed (sav)</span>\n                        </div>\n\n                        <div class=\"p-4 bg-slate-50 border border-slate-200 rounded-2xl flex flex-col justify-between\">\n                            <div>\n                                <span class=\"inline-block text-xs font-bold text-indigo-700 bg-indigo-100 px-2 py-0.5 rounded mb-2\">Hadis-i Şerif (Cuma Günü)</span>\n                                <p class=\"text-xs text-slate-700 italic\">\"...O günde bana çok salavat getirin çünkü sizin salavatınız bana arz olunur.\"</p>\n                            </div>\n                            <span class=\"text-[10px] text-slate-400 mt-3 font-semibold\">— Hz. Muhammed (sav)</span>\n                        </div>\n                    </div>\n                </div>\n            </div>\n\n            <!-- AKILDA KALICI PÜF NOKTA -->\n            <div class=\"bg-gradient-to-r from-amber-500 to-orange-500 rounded-2xl p-5 text-white shadow-lg flex items-center gap-4\">\n                <div class=\"bg-white/20 p-4 rounded-xl text-2xl flex-shrink-0\">\n                    <i class=\"fa-solid fa-lightbulb text-amber-200\"></i>\n                </div>\n                <div>\n                    <h4 class=\"font-extrabold text-lg text-amber-100\">🎯 Sınav & Ders İpucu: Hz. Peygamber’in Örnekliği</h4>\n                    <p class=\"text-sm text-white/90 leading-relaxed\">\n                        Sahabe nasıl salavat getireceklerini sorduğunda Peygamberimiz onlara <strong>Salli ve Barik dualarını</strong> öğretmiştir. Ayrıca mescide girerken ve çıkarken salavat getirerek <em>\"Rabbim günahlarımı bağışla, bana rahmet kapılarını aç.\"</em> diye dua etmiş ve ümmetine örnek olmuştur.\n                    </p>\n                </div>\n            </div>\n\n        </div>\n\n        <!-- SEKME 2: DUALAR VE OKUNUŞLARI (EZBER ETKİNLİKLİ) -->\n        <div id=\"content-dualar\" class=\"tab-content hidden space-y-6\">\n            \n            <!-- ALLAHÜMME SALLİ -->\n            <div class=\"bg-white rounded-3xl border-2 border-emerald-300 shadow-md overflow-hidden\">\n                <div class=\"bg-emerald-700 text-white px-6 py-4 flex justify-between items-center\">\n                    <h2 class=\"font-extrabold text-xl flex items-center gap-2\">\n                        <i class=\"fa-solid fa-star-and-crescent text-amber-300\"></i> Allahümme Salli Duası\n                    </h2>\n                    <span class=\"text-xs bg-emerald-800 px-3 py-1 rounded-full text-emerald-200 border border-emerald-600\">Kaynak: Müslim, \"Salât\", 65</span>\n                </div>\n                \n                <div class=\"p-6 space-y-6\">\n                    <!-- Arapça Metin -->\n                    <div class=\"bg-emerald-50/50 p-6 rounded-2xl text-center border border-emerald-100\">\n                        <p class=\"font-arabic text-2xl sm:text-3xl md:text-4xl text-emerald-950 font-bold leading-loose tracking-wide dir-rtl\" dir=\"rtl\">\n                            اَللَّهُمَّ صَلِّ عَلٰى مُحَمَّدٍ وَعَلٰى اٰلِ مُحَمَّدٍ كَمَا صَلَّيْتَ عَلٰى اِبْرَاهِيمَ وَعَلٰى اٰلِ اِبْرَاهِيمَ اِنَّكَ حَمِيدٌ مَجِيدٌ\n                        </p>\n                    </div>\n\n                    <!-- Türkçe Anlamı -->\n                    <div class=\"bg-slate-50 p-4 rounded-xl border border-slate-200\">\n                        <h4 class=\"text-xs font-bold text-slate-500 uppercase tracking-wider mb-1\">Türkçe Anlamı:</h4>\n                        <p class=\"text-slate-800 font-medium text-base\">\n                            \"Allah'ım! Hz. Muhammed'e ve ailesine, Hz. İbrahim'e ve ailesine rahmet eylediğin gibi rahmet et. Şüphesiz sen, övgüye en layık ve şanı en yüce olansın.\"\n                        </p>\n                    </div>\n\n                    <!-- Ezber Etkinliği 3 Bölüm -->\n                    <div class=\"border-t border-slate-200 pt-4\">\n                        <h4 class=\"text-sm font-bold text-emerald-800 mb-3 flex items-center gap-2\">\n                            <i class=\"fa-solid fa-layer-group\"></i> Etkinlik 9: Adım Adım Ezberleme Yöntemi\n                        </h4>\n                        <div class=\"grid grid-cols-1 md:grid-cols-3 gap-3\">\n                            <div class=\"p-3 bg-white border border-slate-200 rounded-xl\">\n                                <span class=\"text-[11px] font-bold text-emerald-600 bg-emerald-100 px-2 py-0.5 rounded\">1. Bölüm</span>\n                                <p class=\"font-arabic text-lg text-right text-slate-800 my-2\" dir=\"rtl\">اَللَّهُمَّ صَلِّ عَلٰى مُحَمَّدٍ وَعَلٰى اٰلِ مُحَمَّدٍ</p>\n                            </div>\n                            <div class=\"p-3 bg-white border border-slate-200 rounded-xl\">\n                                <span class=\"text-[11px] font-bold text-emerald-600 bg-emerald-100 px-2 py-0.5 rounded\">2. Bölüm</span>\n                                <p class=\"font-arabic text-lg text-right text-slate-800 my-2\" dir=\"rtl\">كَمَا صَلَّيْتَ عَلٰى اِبْرَاهِيمَ وَعَلٰى اٰلِ اِبْرَاهِيمَ</p>\n                            </div>\n                            <div class=\"p-3 bg-white border border-slate-200 rounded-xl\">\n                                <span class=\"text-[11px] font-bold text-emerald-600 bg-emerald-100 px-2 py-0.5 rounded\">3. Bölüm</span>\n                                <p class=\"font-arabic text-lg text-right text-slate-800 my-2\" dir=\"rtl\">اِنَّكَ حَمِيدٌ مَجِيدٌ</p>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n\n            <!-- ALLAHÜMME BARİK -->\n            <div class=\"bg-white rounded-3xl border-2 border-teal-300 shadow-md overflow-hidden\">\n                <div class=\"bg-teal-700 text-white px-6 py-4 flex justify-between items-center\">\n                    <h2 class=\"font-extrabold text-xl flex items-center gap-2\">\n                        <i class=\"fa-solid fa-star-and-crescent text-amber-300\"></i> Allahümme Barik Duası\n                    </h2>\n                    <span class=\"text-xs bg-teal-800 px-3 py-1 rounded-full text-teal-200 border border-teal-600\">Kaynak: Müslim, \"Salât\", 65</span>\n                </div>\n                \n                <div class=\"p-6 space-y-6\">\n                    <!-- Arapça Metin -->\n                    <div class=\"bg-teal-50/50 p-6 rounded-2xl text-center border border-teal-100\">\n                        <p class=\"font-arabic text-2xl sm:text-3xl md:text-4xl text-teal-950 font-bold leading-loose tracking-wide dir-rtl\" dir=\"rtl\">\n                            اَللَّهُمَّ بَارِكْ عَلٰى مُحَمَّدٍ وَعَلٰى اٰلِ مُحَمَّدٍ كَمَا بَارَكْتَ عَلٰى اِبْرَاهِيمَ وَعَلٰى اٰلِ اِبْرَاهِيمَ اِنَّكَ حَمِيدٌ مَجِيدٌ\n                        </p>\n                    </div>\n\n                    <!-- Türkçe Anlamı -->\n                    <div class=\"bg-slate-50 p-4 rounded-xl border border-slate-200\">\n                        <h4 class=\"text-xs font-bold text-slate-500 uppercase tracking-wider mb-1\">Türkçe Anlamı:</h4>\n                        <p class=\"text-slate-800 font-medium text-base\">\n                            \"Allah'ım! Hz. Muhammed'e ve ailesine, Hz. İbrahim'in ailesine bereket ihsan ettiğin gibi bereket ihsan eyle! Şüphesiz sen, övgüye en layık ve şanı en yüce olansın.\"\n                        </p>\n                    </div>\n\n                    <!-- Ezber Etkinliği 3 Bölüm -->\n                    <div class=\"border-t border-slate-200 pt-4\">\n                        <h4 class=\"text-sm font-bold text-teal-800 mb-3 flex items-center gap-2\">\n                            <i class=\"fa-solid fa-layer-group\"></i> Etkinlik 9: Adım Adım Ezberleme Yöntemi\n                        </h4>\n                        <div class=\"grid grid-cols-1 md:grid-cols-3 gap-3\">\n                            <div class=\"p-3 bg-white border border-slate-200 rounded-xl\">\n                                <span class=\"text-[11px] font-bold text-teal-600 bg-teal-100 px-2 py-0.5 rounded\">1. Bölüm</span>\n                                <p class=\"font-arabic text-lg text-right text-slate-800 my-2\" dir=\"rtl\">اَللَّهُمَّ بَارِكْ عَلٰى مُحَمَّدٍ وَعَلٰى اٰلِ مُحَمَّدٍ</p>\n                            </div>\n                            <div class=\"p-3 bg-white border border-slate-200 rounded-xl\">\n                                <span class=\"text-[11px] font-bold text-teal-600 bg-teal-100 px-2 py-0.5 rounded\">2. Bölüm</span>\n                                <p class=\"font-arabic text-lg text-right text-slate-800 my-2\" dir=\"rtl\">كَمَا بَارَكْتَ عَلٰى اِبْرَاهِيمَ وَعَلٰى اٰلِ اِبْرَاهِيمَ</p>\n                            </div>\n                            <div class=\"p-3 bg-white border border-slate-200 rounded-xl\">\n                                <span class=\"text-[11px] font-bold text-teal-600 bg-teal-100 px-2 py-0.5 rounded\">3. Bölüm</span>\n                                <p class=\"font-arabic text-lg text-right text-slate-800 my-2\" dir=\"rtl\">اِنَّكَ حَمِيدٌ مَجِيدٌ</p>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n\n        </div>\n\n        <!-- SEKME 3: BİLGİ GRAFİĞİ - OKUNDUĞU YERLER -->\n        <div id=\"content-grafik\" class=\"tab-content hidden space-y-6\">\n            <div class=\"bg-white rounded-3xl border border-slate-200 p-6 shadow-md\">\n                <div class=\"text-center max-w-2xl mx-auto mb-8\">\n                    <span class=\"text-xs font-bold bg-amber-100 text-amber-800 px-3 py-1 rounded-full uppercase tracking-wider\">Bilgi Grafiği 1.2</span>\n                    <h2 class=\"text-2xl font-black text-slate-900 mt-2\">Salli ve Barik Dualarının Okunduğu Bazı Yerler</h2>\n                    <p class=\"text-sm text-slate-600 mt-1\">Ders kitabında belirtilen salavat ve Salli-Barik dualarının okunduğu özel anlar:</p>\n                </div>\n\n                <div class=\"grid grid-cols-2 md:grid-cols-3 gap-4 sm:gap-6\">\n                    <!-- Kart 1 -->\n                    <div class=\"bg-gradient-to-br from-emerald-50 to-white border-2 border-emerald-200 p-5 rounded-2xl flex flex-col items-center text-center hover:shadow-lg transition-shadow\">\n                        <div class=\"w-14 h-14 rounded-2xl bg-emerald-600 text-white flex items-center justify-center text-2xl mb-3 shadow-md\">\n                            <i class=\"fa-solid fa-person-praying\"></i>\n                        </div>\n                        <h4 class=\"font-bold text-base text-slate-800\">Vakit Namazlarında</h4>\n                        <p class=\"text-xs text-slate-500 mt-1\">Namazların son oturuşunda Tahiyyat'tan sonra</p>\n                    </div>\n\n                    <!-- Kart 2 -->\n                    <div class=\"bg-gradient-to-br from-teal-50 to-white border-2 border-teal-200 p-5 rounded-2xl flex flex-col items-center text-center hover:shadow-lg transition-shadow\">\n                        <div class=\"w-14 h-14 rounded-2xl bg-teal-600 text-white flex items-center justify-center text-2xl mb-3 shadow-md\">\n                            <i class=\"fa-solid fa-mosque\"></i>\n                        </div>\n                        <h4 class=\"font-bold text-base text-slate-800\">Mescide Girerken / Çıkarken</h4>\n                        <p class=\"text-xs text-slate-500 mt-1\">Mescide giriş ve çıkış dualarında</p>\n                    </div>\n\n                    <!-- Kart 3 -->\n                    <div class=\"bg-gradient-to-br from-blue-50 to-white border-2 border-blue-200 p-5 rounded-2xl flex flex-col items-center text-center hover:shadow-lg transition-shadow\">\n                        <div class=\"w-14 h-14 rounded-2xl bg-blue-600 text-white flex items-center justify-center text-2xl mb-3 shadow-md\">\n                            <i class=\"fa-solid fa-bullhorn\"></i>\n                        </div>\n                        <h4 class=\"font-bold text-base text-slate-800\">Ezan Dinlerken</h4>\n                        <p class=\"text-xs text-slate-500 mt-1\">Ezan okunduktan sonra veya dinlerken</p>\n                    </div>\n\n                    <!-- Kart 4 -->\n                    <div class=\"bg-gradient-to-br from-purple-50 to-white border-2 border-purple-200 p-5 rounded-2xl flex flex-col items-center text-center hover:shadow-lg transition-shadow\">\n                        <div class=\"w-14 h-14 rounded-2xl bg-purple-600 text-white flex items-center justify-center text-2xl mb-3 shadow-md\">\n                            <i class=\"fa-solid fa-hands-holding\"></i>\n                        </div>\n                        <h4 class=\"font-bold text-base text-slate-800\">Cenaze Namazında</h4>\n                        <p class=\"text-xs text-slate-500 mt-1\">Cenaze namazı ibadeti esnasında</p>\n                    </div>\n\n                    <!-- Kart 5 -->\n                    <div class=\"bg-gradient-to-br from-amber-50 to-white border-2 border-amber-200 p-5 rounded-2xl flex flex-col items-center text-center hover:shadow-lg transition-shadow\">\n                        <div class=\"w-14 h-14 rounded-2xl bg-amber-500 text-white flex items-center justify-center text-2xl mb-3 shadow-md\">\n                            <i class=\"fa-solid fa-comment-dots\"></i>\n                        </div>\n                        <h4 class=\"font-bold text-base text-slate-800\">Hz. Muhammed'in (sav) Adı Anılınca</h4>\n                        <p class=\"text-xs text-slate-500 mt-1\">İsmi her geçtiğinde sevgi ve saygı ile</p>\n                    </div>\n\n                    <!-- Kart 6 -->\n                    <div class=\"bg-gradient-to-br from-rose-50 to-white border-2 border-rose-200 p-5 rounded-2xl flex flex-col items-center text-center hover:shadow-lg transition-shadow\">\n                        <div class=\"w-14 h-14 rounded-2xl bg-rose-600 text-white flex items-center justify-center text-2xl mb-3 shadow-md\">\n                            <i class=\"fa-solid fa-calendar-day\"></i>\n                        </div>\n                        <h4 class=\"font-bold text-base text-slate-800\">Cuma Günlerinde</h4>\n                        <p class=\"text-xs text-slate-500 mt-1\">Mübarek cuma gününde bolca</p>\n                    </div>\n                </div>\n            </div>\n        </div>\n\n        <!-- SEKME 4: ÖLÇME & ETKİNLİK DOKUMANI -->\n        <div id=\"content-etkinlik\" class=\"tab-content hidden space-y-6\">\n            \n            <!-- ÖLÇME DEĞERLENDİRME ŞEMA ETKİNLİĞİ -->\n            <div class=\"bg-white rounded-3xl border border-slate-200 p-6 shadow-md\">\n                <div class=\"mb-4 pb-3 border-b border-slate-200 flex items-center justify-between\">\n                    <div>\n                        <span class=\"text-xs font-bold text-emerald-700 bg-emerald-100 px-2.5 py-1 rounded-md\">Ölçme ve Değerlendirme</span>\n                        <h3 class=\"text-lg font-extrabold text-slate-800 mt-1\">Şemaya Göre Ulaşılabilecek İfadeler</h3>\n                    </div>\n                    <button onclick=\"checkQuiz()\" class=\"bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold px-4 py-2 rounded-xl transition-all shadow-sm\">\n                        Cevapları Kontrol Et\n                    </button>\n                </div>\n\n                <p class=\"text-xs text-slate-600 mb-4\">\n                    Salli ve Barik dualarının içeriği ve mesajlarına göre aşağıdaki yargılardan hangilerine ulaşılabilir? Doğru olanları işaretleyiniz:\n                </p>\n\n                <div class=\"space-y-3\" id=\"quiz-list\">\n                    <!-- Soru 1 -->\n                    <label class=\"flex items-start gap-3 p-3 rounded-xl border border-slate-200 bg-slate-50 hover:bg-slate-100 cursor-pointer transition-colors\">\n                        <input type=\"checkbox\" data-correct=\"true\" class=\"quiz-check mt-1 w-4 h-4 text-emerald-600 rounded border-slate-300 focus:ring-emerald-500\">\n                        <span class=\"text-sm font-medium text-slate-800\">1. Salli ve Barik duaları salavat cümlelerinden oluşur.</span>\n                    </label>\n\n                    <!-- Soru 2 -->\n                    <label class=\"flex items-start gap-3 p-3 rounded-xl border border-slate-200 bg-slate-50 hover:bg-slate-100 cursor-pointer transition-colors\">\n                        <input type=\"checkbox\" data-correct=\"false\" class=\"quiz-check mt-1 w-4 h-4 text-emerald-600 rounded border-slate-300 focus:ring-emerald-500\">\n                        <span class=\"text-sm font-medium text-slate-800\">2. Salli ve Barik dualarında Allah’ın (cc) tek ilah olduğu vurgulanır.</span>\n                    </label>\n\n                    <!-- Soru 3 -->\n                    <label class=\"flex items-start gap-3 p-3 rounded-xl border border-slate-200 bg-slate-50 hover:bg-slate-100 cursor-pointer transition-colors\">\n                        <input type=\"checkbox\" data-correct=\"true\" class=\"quiz-check mt-1 w-4 h-4 text-emerald-600 rounded border-slate-300 focus:ring-emerald-500\">\n                        <span class=\"text-sm font-medium text-slate-800\">3. Salli ve Barik dualarında övgüye en layık olanın Allah (cc) olduğu belirtilir.</span>\n                    </label>\n\n                    <!-- Soru 4 -->\n                    <label class=\"flex items-start gap-3 p-3 rounded-xl border border-slate-200 bg-slate-50 hover:bg-slate-100 cursor-pointer transition-colors\">\n                        <input type=\"checkbox\" data-correct=\"true\" class=\"quiz-check mt-1 w-4 h-4 text-emerald-600 rounded border-slate-300 focus:ring-emerald-500\">\n                        <span class=\"text-sm font-medium text-slate-800\">4. Salli ve Barik dualarıyla Hz. Muhammed’e (sav) olan sevgi, saygı ve bağlılık ifade edilir.</span>\n                    </label>\n\n                    <!-- Soru 5 -->\n                    <label class=\"flex items-start gap-3 p-3 rounded-xl border border-slate-200 bg-slate-50 hover:bg-slate-100 cursor-pointer transition-colors\">\n                        <input type=\"checkbox\" data-correct=\"false\" class=\"quiz-check mt-1 w-4 h-4 text-emerald-600 rounded border-slate-300 focus:ring-emerald-500\">\n                        <span class=\"text-sm font-medium text-slate-800\">5. Salli ve Barik dualarında Müslümanlar kendileri için rahmet ve bereket dilerler.</span>\n                    </label>\n                </div>\n\n                <div id=\"quiz-result\" class=\"hidden mt-4 p-4 rounded-xl text-xs font-bold text-center\"></div>\n            </div>\n\n            <!-- KONTROL NOKTASI SORULARI -->\n            <div class=\"bg-emerald-950 text-white rounded-3xl p-6 shadow-md\">\n                <h3 class=\"text-lg font-black text-amber-300 mb-4 flex items-center gap-2\">\n                    <i class=\"fa-solid fa-circle-question\"></i> Kontrol Noktası Soruları\n                </h3>\n                <div class=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n                    <div class=\"bg-emerald-900/60 border border-emerald-800 p-4 rounded-2xl\">\n                        <span class=\"text-xs font-bold text-amber-300\">Soru 1</span>\n                        <p class=\"text-sm font-semibold text-white mt-1\">Salli ve Barik duaları namazın hangi bölümünde okunur?</p>\n                        <p class=\"text-xs text-emerald-200 mt-2 border-t border-emerald-800 pt-2\"><strong>Cevap:</strong> Namazların son oturuşunda Tahiyyat duasından sonra okunur.</p>\n                    </div>\n\n                    <div class=\"bg-emerald-900/60 border border-emerald-800 p-4 rounded-2xl\">\n                        <span class=\"text-xs font-bold text-amber-300\">Soru 2</span>\n                        <p class=\"text-sm font-semibold text-white mt-1\">Hangi durumlarda Hz. Peygamber'e salavat getirilir?</p>\n                        <p class=\"text-xs text-emerald-200 mt-2 border-t border-emerald-800 pt-2\"><strong>Cevap:</strong> Namazda, mescide girip çıkarken, ezan dinlerken, cenaze namazında, ismi anılınca ve cuma günlerinde.</p>\n                    </div>\n\n                    <div class=\"bg-emerald-900/60 border border-emerald-800 p-4 rounded-2xl\">\n                        <span class=\"text-xs font-bold text-amber-300\">Soru 3</span>\n                        <p class=\"text-sm font-semibold text-white mt-1\">Müslümanlar neden Hz. Peygamber'e salavat getirirler?</p>\n                        <p class=\"text-xs text-emerald-200 mt-2 border-t border-emerald-800 pt-2\"><strong>Cevap:</strong> Onu sevmek, ona saygı ve bağlılıklarını ifade etmek, onun için rahmet ve bereket dilemek amacıyla.</p>\n                    </div>\n\n                    <div class=\"bg-emerald-900/60 border border-emerald-800 p-4 rounded-2xl\">\n                        <span class=\"text-xs font-bold text-amber-300\">Soru 4</span>\n                        <p class=\"text-sm font-semibold text-white mt-1\">Salavatın anlamını bilerek okumak ne kazandırır?</p>\n                        <p class=\"text-xs text-emerald-200 mt-2 border-t border-emerald-800 pt-2\"><strong>Cevap:</strong> Okunan duanın mesajını hissetmeyi, Hz. Peygamber ve Hz. İbrahim'in hâtırasını daha bilinçli anmayı sağlar.</p>\n                    </div>\n                </div>\n            </div>\n\n        </div>\n\n    </main>\n\n    <!-- ALT BİLGİ / FOOTER -->\n    <footer class=\"bg-slate-900 text-slate-400 border-t border-slate-800 py-4 mt-8\">\n        <div class=\"max-w-7xl mx-auto px-4 text-center text-xs flex flex-col md:flex-row justify-between items-center gap-2\">\n            <span>MEB Kur'an-ı Kerim Ders Kitabı Metnine %100 Sadık Kalınarak Hazırlanmıştır.</span>\n            <span class=\"text-slate-500\">6. Sınıf • 1. Tema: Kur'an-ı Kerim'i Tanıyorum</span>\n        </div>\n    </footer>\n\n    <!-- INTERAKTIF MANTIKSAL SCRIPT -->\n    <script>\n        function switchTab(tabId) {\n            // Hide all tab contents\n            const contents = document.querySelectorAll('.tab-content');\n            contents.forEach(content => content.classList.add('hidden'));\n\n            // Deactivate all tab buttons\n            const buttons = document.querySelectorAll('.tab-btn');\n            buttons.forEach(btn => {\n                btn.classList.remove('active', 'bg-emerald-600', 'text-white');\n                btn.classList.add('bg-white', 'text-slate-700');\n            });\n\n            // Show selected tab content\n            const activeContent = document.getElementById('content-' + tabId);\n            if (activeContent) {\n                activeContent.classList.remove('hidden');\n            }\n\n            // Activate selected tab button\n            const activeBtn = document.getElementById('tab-' + tabId);\n            if (activeBtn) {\n                activeBtn.classList.add('active');\n                activeBtn.classList.remove('bg-white', 'text-slate-700');\n            }\n        }\n\n        function checkQuiz() {\n            const checkboxes = document.querySelectorAll('.quiz-check');\n            let isCorrect = true;\n\n            checkboxes.forEach(cb => {\n                const correct = cb.getAttribute('data-correct') === 'true';\n                const parent = cb.closest('label');\n\n                if (cb.checked === correct) {\n                    parent.classList.remove('border-red-300', 'bg-red-50');\n                    parent.classList.add('border-emerald-300', 'bg-emerald-50');\n                } else {\n                    isCorrect = false;\n                    parent.classList.remove('border-emerald-300', 'bg-emerald-50');\n                    parent.classList.add('border-red-300', 'bg-red-50');\n                }\n            });\n\n            const resultDiv = document.getElementById('quiz-result');\n            resultDiv.classList.remove('hidden', 'bg-emerald-100', 'text-emerald-800', 'bg-rose-100', 'text-rose-800');\n\n            if (isCorrect) {\n                resultDiv.classList.add('bg-emerald-100', 'text-emerald-800');\n                resultDiv.innerHTML = '<i class=\"fa-solid fa-circle-check mr-2\"></i> Tebrikler! Tüm seçimler kitaptaki şemaya tam uygun.';\n            } else {\n                resultDiv.classList.add('bg-rose-100', 'text-rose-800');\n                resultDiv.innerHTML = '<i class=\"fa-solid fa-circle-xmark mr-2\"></i> Bazı seçimler hatalı. Lütfen kırmızı ile işaretlenen maddeleri kontrol ediniz. (Doğru Maddeler: 1, 3 ve 4)';\n            }\n        }\n    </script>\n</body>\n</html>",
