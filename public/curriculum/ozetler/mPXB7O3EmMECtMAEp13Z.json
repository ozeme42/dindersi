{
  "htmlContent": "<!DOCTYPE html>\n<html lang=\"tr\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>5. Sınıf Kur'an-ı Kerim - Harfleri Harekelerle Telaffuz Etme</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css\" />\n  <link href=\"https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&family=Inter:wght@400;500;600;700;800&display=swap\" rel=\"stylesheet\">\n  <style>\n    .font-arabic { font-family: 'Amiri', serif; }\n    body { font-family: 'Inter', sans-serif; background-color: #f8fafc; }\n    .tab-btn.active { background-color: #0d9488; color: white; border-color: #0d9488; }\n    .arabic-card { transition: all 0.2s ease-in-out; }\n    .arabic-card:hover { transform: translateY(-2px); }\n  </style>\n</head>\n<body class=\"text-slate-800 p-3 md:p-6\">\n\n  <!-- ANA KONTAYNER -->\n  <div class=\"max-w-6xl mx-auto space-y-6\">\n\n    <!-- ÜST BAŞLIK BARI -->\n    <header class=\"bg-gradient-to-r from-emerald-800 via-teal-700 to-emerald-900 text-white p-6 rounded-3xl shadow-xl flex flex-col md:flex-row justify-between items-center gap-4\">\n      <div class=\"space-y-1 text-center md:text-left\">\n        <div class=\"flex items-center justify-center md:justify-start gap-2 text-emerald-200 text-sm font-semibold tracking-wider uppercase\">\n          <span>1. TEMA: KUR'AN-I KERİM'İ TANIYORUM</span>\n          <span>•</span>\n          <span>5. SINIF</span>\n        </div>\n        <h1 class=\"text-2xl md:text-4xl font-extrabold tracking-tight\">1.4. Harfleri Harekelerle Telaffuz Etme</h1>\n        <p class=\"text-emerald-100 text-sm\">İnteraktif Akıllı Tahta Özet ve Uygulama Paneli</p>\n      </div>\n      <div class=\"flex items-center gap-3 bg-white/10 backdrop-blur-md px-4 py-3 rounded-2xl border border-white/20\">\n        <i class=\"fa-solid fa-book-quran text-3xl text-emerald-300\"></i>\n        <div class=\"text-xs\">\n          <p class=\"font-bold text-white\">MEB DERS KİTABI</p>\n          <p class=\"text-emerald-200\">Tam Uyumlu Ders Materyali</p>\n        </div>\n      </div>\n    </header>\n\n    <!-- KAVRAM VE TANIM KARTI -->\n    <section class=\"bg-white rounded-3xl p-6 shadow-md border border-slate-100 flex flex-col md:flex-row items-center gap-6\">\n      <div class=\"w-full md:w-1/3 bg-emerald-50 rounded-2xl p-6 border border-emerald-100 text-center\">\n        <span class=\"inline-block px-3 py-1 bg-emerald-600 text-white text-xs font-bold rounded-full uppercase tracking-wider mb-2\">Temel Kavram</span>\n        <h2 class=\"text-3xl font-extrabold text-emerald-900 mb-2\">HAREKE</h2>\n        <p class=\"text-emerald-700 text-sm font-medium\">Harfleri Okutan Yardımcı İşaretler</p>\n      </div>\n      <div class=\"w-full md:w-2/3 space-y-3\">\n        <div class=\"flex items-start gap-3\">\n          <div class=\"w-8 h-8 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center font-bold shrink-0 mt-1\">📌</div>\n          <p class=\"text-base leading-relaxed text-slate-700\">\n            <strong class=\"text-emerald-900 font-bold\">Tanım:</strong> Harflerin ünlü olarak seslendirilmesine yardımcı olan işaretlere <strong class=\"text-emerald-700 underline decoration-emerald-300\">hareke</strong> denir.\n          </p>\n        </div>\n        <div class=\"flex items-start gap-3\">\n          <div class=\"w-8 h-8 rounded-full bg-teal-100 text-teal-700 flex items-center justify-center font-bold shrink-0 mt-1\">✨</div>\n          <p class=\"text-base leading-relaxed text-slate-700\">\n            Kur'an-ı Kerim'de harfleri seslendiren <strong>3 temel hareke</strong> bulunur: <span class=\"inline-block px-2 py-0.5 bg-amber-100 text-amber-800 rounded font-semibold text-sm\">Üstün ( َ )</span>, <span class=\"inline-block px-2 py-0.5 bg-blue-100 text-blue-800 rounded font-semibold text-sm\">Esre ( ِ )</span> ve <span class=\"inline-block px-2 py-0.5 bg-purple-100 text-purple-800 rounded font-semibold text-sm\">Ötre ( ُ )</span>.\n          </p>\n        </div>\n      </div>\n    </section>\n\n    <!-- AKILDA KALICI PÜF NOKTA KUTUSU -->\n    <section class=\"bg-gradient-to-r from-amber-500 to-orange-500 text-white rounded-3xl p-6 shadow-lg\">\n      <div class=\"flex items-center gap-3 mb-4\">\n        <div class=\"w-10 h-10 bg-white/20 rounded-xl flex items-center justify-center text-2xl\">💡</div>\n        <h2 class=\"text-xl font-bold\">Unutmayalım! / Sınav İpucu</h2>\n      </div>\n      <div class=\"grid grid-cols-1 md:grid-cols-3 gap-4\">\n        <div class=\"bg-white/10 backdrop-blur-md p-4 rounded-2xl border border-white/20\">\n          <div class=\"flex justify-between items-center mb-2\">\n            <h3 class=\"font-bold text-lg\">Üstün ( َ )</h3>\n            <span class=\"text-xs bg-white/20 px-2 py-0.5 rounded\">Harfin Üstünde</span>\n          </div>\n          <p class=\"text-sm text-amber-100\">İnce harfleri <strong class=\"text-white text-base\">\"e\"</strong>, kalın harfleri <strong class=\"text-white text-base\">\"a\"</strong> sesiyle okutur.</p>\n        </div>\n        <div class=\"bg-white/10 backdrop-blur-md p-4 rounded-2xl border border-white/20\">\n          <div class=\"flex justify-between items-center mb-2\">\n            <h3 class=\"font-bold text-lg\">Esre ( ِ )</h3>\n            <span class=\"text-xs bg-white/20 px-2 py-0.5 rounded\">Harfin Altında</span>\n          </div>\n          <p class=\"text-sm text-amber-100\">İnce harfleri <strong class=\"text-white text-base\">\"i\"</strong>, kalın harfleri <strong class=\"text-white text-base\">\"ı-i\"</strong> arası bir sesle okutur.</p>\n        </div>\n        <div class=\"bg-white/10 backdrop-blur-md p-4 rounded-2xl border border-white/20\">\n          <div class=\"flex justify-between items-center mb-2\">\n            <h3 class=\"font-bold text-lg\">Ötre ( ُ )</h3>\n            <span class=\"text-xs bg-white/20 px-2 py-0.5 rounded\">Harfin Üstünde ( Küçük  و )</span>\n          </div>\n          <p class=\"text-sm text-amber-100\">İnce harfleri <strong class=\"text-white text-base\">\"u-ü\"</strong> arası, kalın harfleri <strong class=\"text-white text-base\">\"u\"</strong> sesiyle okutur.</p>\n        </div>\n      </div>\n    </section>\n\n    <!-- İNTERAKTİF HAREKE SEKMELERİ (TABS) -->\n    <section class=\"bg-white rounded-3xl p-6 shadow-md border border-slate-100 space-y-6\">\n      <div class=\"flex flex-col md:flex-row justify-between items-start md:items-center gap-4 border-b border-slate-100 pb-4\">\n        <div>\n          <h2 class=\"text-2xl font-bold text-slate-800\">Harekeler ve Okunuş Örnekleri</h2>\n          <p class=\"text-sm text-slate-500\">Sekmelere tıklayarak ilgili harekenin harf ve kelime okunuşlarını inceleyiniz.</p>\n        </div>\n        <div class=\"flex flex-wrap gap-2 w-full md:w-auto\">\n          <button onclick=\"openTab('ustun')\" id=\"btn-ustun\" class=\"tab-btn active px-5 py-2.5 rounded-xl font-bold text-sm border transition-all flex items-center gap-2\">\n            <span class=\"font-arabic text-xl\">َ</span> 1.4.1. Üstün\n          </button>\n          <button onclick=\"openTab('esre')\" id=\"btn-esre\" class=\"tab-btn px-5 py-2.5 rounded-xl font-bold text-sm border transition-all flex items-center gap-2 text-slate-600 bg-slate-50 hover:bg-slate-100\">\n            <span class=\"font-arabic text-xl\">ِ</span> 1.4.2. Esre\n          </button>\n          <button onclick=\"openTab('otre')\" id=\"btn-otre\" class=\"tab-btn px-5 py-2.5 rounded-xl font-bold text-sm border transition-all flex items-center gap-2 text-slate-600 bg-slate-50 hover:bg-slate-100\">\n            <span class=\"font-arabic text-xl\">ُ</span> 1.4.3. Ötre\n          </button>\n        </div>\n      </div>\n\n      <!-- TAB 1: ÜSTÜN -->\n      <div id=\"tab-ustun\" class=\"tab-content space-y-6\">\n        <div class=\"bg-amber-50 p-4 rounded-2xl border border-amber-200 text-amber-900 flex items-center gap-3\">\n          <i class=\"fa-solid fa-circle-info text-2xl text-amber-600\"></i>\n          <div>\n            <h3 class=\"font-bold text-base\">Üstün ( َ ) Özellikleri:</h3>\n            <p class=\"text-sm\">Harfin üstünde bulunan yatık bir çizgidir. İnce harfleri <strong>\"e\"</strong>, kalın harfleri ise <strong>\"a\"</strong> sesi ile okutur.</p>\n          </div>\n        </div>\n\n        <div>\n          <h4 class=\"font-bold text-slate-700 mb-3 flex items-center gap-2\">\n            <i class=\"fa-solid fa-font text-emerald-600\"></i> Harf Örnekleri (8. Etkinlik):\n          </h4>\n          <div class=\"grid grid-cols-4 md:grid-cols-4 gap-3\" dir=\"rtl\">\n            <div class=\"arabic-card bg-slate-50 border p-4 rounded-2xl text-center font-arabic text-3xl text-slate-800 shadow-sm\">جَ حَ خَ</div>\n            <div class=\"arabic-card bg-slate-50 border p-4 rounded-2xl text-center font-arabic text-3xl text-slate-800 shadow-sm\">سَ شَ صَ</div>\n            <div class=\"arabic-card bg-slate-50 border p-4 rounded-2xl text-center font-arabic text-3xl text-slate-800 shadow-sm\">غَ فَ قَ</div>\n            <div class=\"arabic-card bg-slate-50 border p-4 rounded-2xl text-center font-arabic text-3xl text-slate-800 shadow-sm\">كَ لَ مَ نَ وَ يَ</div>\n          </div>\n        </div>\n\n        <div class=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n          <div class=\"bg-slate-50 p-5 rounded-2xl border border-slate-200 space-y-3\">\n            <h4 class=\"font-bold text-slate-700 flex items-center justify-between\">\n              <span><i class=\"fa-solid fa-[#]\"></i> Kelime Örnekleri</span>\n              <span class=\"text-xs bg-emerald-100 text-emerald-800 px-2 py-1 rounded\">8. Etkinlik</span>\n            </h4>\n            <div class=\"grid grid-cols-3 gap-3\" dir=\"rtl\">\n              <div class=\"arabic-card bg-white p-3 rounded-xl border text-center font-arabic text-2xl font-bold text-emerald-900 shadow-sm\">كَتَبَ</div>\n              <div class=\"arabic-card bg-white p-3 rounded-xl border text-center font-arabic text-2xl font-bold text-emerald-900 shadow-sm\">دَرَسَ</div>\n              <div class=\"arabic-card bg-white p-3 rounded-xl border text-center font-arabic text-2xl font-bold text-emerald-900 shadow-sm\">زَرَعَ</div>\n              <div class=\"arabic-card bg-white p-3 rounded-xl border text-center font-arabic text-2xl font-bold text-emerald-900 shadow-sm\">غَفَرَ</div>\n              <div class=\"arabic-card bg-white p-3 rounded-xl border text-center font-arabic text-2xl font-bold text-emerald-900 shadow-sm\">نَظَرَ</div>\n              <div class=\"arabic-card bg-white p-3 rounded-xl border text-center font-arabic text-2xl font-bold text-emerald-900 shadow-sm\">طَلَبَ</div>\n            </div>\n          </div>\n\n          <div class=\"bg-slate-50 p-5 rounded-2xl border border-slate-200 space-y-3\">\n            <h4 class=\"font-bold text-slate-700 flex items-center justify-between\">\n              <span><i class=\"fa-solid fa-note-sticky text-amber-600\"></i> Çalışma Yaprağı Kelimeleri</span>\n              <span class=\"text-xs bg-amber-100 text-amber-800 px-2 py-1 rounded\">Okuma İnceleme</span>\n            </h4>\n            <div class=\"grid grid-cols-3 gap-3\" dir=\"rtl\">\n              <div class=\"arabic-card bg-white p-3 rounded-xl border text-center font-arabic text-2xl font-bold text-teal-900 shadow-sm\">رَفَعَ</div>\n              <div class=\"arabic-card bg-white p-3 rounded-xl border text-center font-arabic text-2xl font-bold text-teal-900 shadow-sm\">سَجَدَ</div>\n              <div class=\"arabic-card bg-white p-3 rounded-xl border text-center font-arabic text-2xl font-bold text-teal-900 shadow-sm\">وَجَدَ</div>\n              <div class=\"arabic-card bg-white p-3 rounded-xl border text-center font-arabic text-2xl font-bold text-teal-900 shadow-sm\">جَمَعَ</div>\n              <div class=\"arabic-card bg-white p-3 rounded-xl border text-center font-arabic text-2xl font-bold text-teal-900 shadow-sm\">كَسَبَ</div>\n              <div class=\"arabic-card bg-white p-3 rounded-xl border text-center font-arabic text-2xl font-bold text-teal-900 shadow-sm\">خَلَقَ</div>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <!-- TAB 2: ESRE -->\n      <div id=\"tab-esre\" class=\"tab-content hidden space-y-6\">\n        <div class=\"bg-blue-50 p-4 rounded-2xl border border-blue-200 text-blue-900 flex items-center gap-3\">\n          <i class=\"fa-solid fa-circle-info text-2xl text-blue-600\"></i>\n          <div>\n            <h3 class=\"font-bold text-base\">Esre ( ِ ) Özellikleri:</h3>\n            <p class=\"text-sm\">Harfin altında bulunan yatık bir çizgidir. İnce harfleri <strong>\"i\"</strong> sesiyle, kalın harfleri ise <strong>\"ı-i\"</strong> arası bir sesle okutur.</p>\n          </div>\n        </div>\n\n        <div>\n          <h4 class=\"font-bold text-slate-700 mb-3 flex items-center gap-2\">\n            <i class=\"fa-solid fa-font text-blue-600\"></i> Harf Örnekleri (9. Etkinlik):\n          </h4>\n          <div class=\"grid grid-cols-3 md:grid-cols-6 gap-3\" dir=\"rtl\">\n            <div class=\"arabic-card bg-slate-50 border p-3 rounded-xl text-center font-arabic text-2xl text-slate-800 shadow-sm\">ِا ِب ِت ِث</div>\n            <div class=\"arabic-card bg-slate-50 border p-3 rounded-xl text-center font-arabic text-2xl text-slate-800 shadow-sm\">ِج ِح ِخ</div>\n            <div class=\"arabic-card bg-slate-50 border p-3 rounded-xl text-center font-arabic text-2xl text-slate-800 shadow-sm\">ِد ِذ ِر ِز</div>\n            <div class=\"arabic-card bg-slate-50 border p-3 rounded-xl text-center font-arabic text-2xl text-slate-800 shadow-sm\">ِس ِش ِص ِض</div>\n            <div class=\"arabic-card bg-slate-50 border p-3 rounded-xl text-center font-arabic text-2xl text-slate-800 shadow-sm\">ِط ِظ ِع ِغ ِف ِق</div>\n            <div class=\"arabic-card bg-slate-50 border p-3 rounded-xl text-center font-arabic text-2xl text-slate-800 shadow-sm\">ِك ِل ِم ِن ِو ِه ِي</div>\n          </div>\n        </div>\n\n        <div class=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n          <div class=\"bg-slate-50 p-5 rounded-2xl border border-slate-200 space-y-3\">\n            <h4 class=\"font-bold text-slate-700 flex items-center justify-between\">\n              <span><i class=\"fa-solid fa-[#]\"></i> Kelime Örnekleri</span>\n              <span class=\"text-xs bg-blue-100 text-blue-800 px-2 py-1 rounded\">9. Etkinlik</span>\n            </h4>\n            <div class=\"grid grid-cols-3 gap-3\" dir=\"rtl\">\n              <div class=\"arabic-card bg-white p-3 rounded-xl border text-center font-arabic text-2xl font-bold text-blue-900 shadow-sm\">حَفِظَ</div>\n              <div class=\"arabic-card bg-white p-3 rounded-xl border text-center font-arabic text-2xl font-bold text-blue-900 shadow-sm\">رَحِمَ</div>\n              <div class=\"arabic-card bg-white p-3 rounded-xl border text-center font-arabic text-2xl font-bold text-blue-900 shadow-sm\">بَخِلَ</div>\n              <div class=\"arabic-card bg-white p-3 rounded-xl border text-center font-arabic text-2xl font-bold text-blue-900 shadow-sm\">صَغِرَ</div>\n              <div class=\"arabic-card bg-white p-3 rounded-xl border text-center font-arabic text-2xl font-bold text-blue-900 shadow-sm\">عَوِجَ</div>\n              <div class=\"arabic-card bg-white p-3 rounded-xl border text-center font-arabic text-2xl font-bold text-blue-900 shadow-sm\">حَمِدَ</div>\n            </div>\n          </div>\n\n          <div class=\"bg-slate-50 p-5 rounded-2xl border border-slate-200 space-y-3\">\n            <h4 class=\"font-bold text-slate-700 flex items-center justify-between\">\n              <span><i class=\"fa-solid fa-note-sticky text-blue-600\"></i> Çalışma Yaprağı Kelimeleri</span>\n              <span class=\"text-xs bg-blue-100 text-blue-800 px-2 py-1 rounded\">Okuma İnceleme</span>\n            </h4>\n            <div class=\"grid grid-cols-3 gap-3\" dir=\"rtl\">\n              <div class=\"arabic-card bg-white p-3 rounded-xl border text-center font-arabic text-2xl font-bold text-indigo-900 shadow-sm\">أَذِنَ</div>\n              <div class=\"arabic-card bg-white p-3 rounded-xl border text-center font-arabic text-2xl font-bold text-indigo-900 shadow-sm\">شَهِدَ</div>\n              <div class=\"arabic-card bg-white p-3 rounded-xl border text-center font-arabic text-2xl font-bold text-indigo-900 shadow-sm\">عَلِمَ</div>\n              <div class=\"arabic-card bg-white p-3 rounded-xl border text-center font-arabic text-2xl font-bold text-indigo-900 shadow-sm\">سَمِعَ</div>\n              <div class=\"arabic-card bg-white p-3 rounded-xl border text-center font-arabic text-2xl font-bold text-indigo-900 shadow-sm\">وَثِقَ</div>\n              <div class=\"arabic-card bg-white p-3 rounded-xl border text-center font-arabic text-2xl font-bold text-indigo-900 shadow-sm\">غَضِبَ</div>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <!-- TAB 3: ÖTRE -->\n      <div id=\"tab-otre\" class=\"tab-content hidden space-y-6\">\n        <div class=\"bg-purple-50 p-4 rounded-2xl border border-purple-200 text-purple-900 flex items-center gap-3\">\n          <i class=\"fa-solid fa-circle-info text-2xl text-purple-600\"></i>\n          <div>\n            <h3 class=\"font-bold text-base\">Ötre ( ُ ) Özellikleri:</h3>\n            <p class=\"text-sm\">Harfin üstünde bulunan ve küçük bir vav (و) harfine benzeyen harekedir. İnce harfleri <strong>\"u-ü\"</strong> arası bir sesle, kalın harfleri ise <strong>\"u\"</strong> sesi ile okutur.</p>\n          </div>\n        </div>\n\n        <div>\n          <h4 class=\"font-bold text-slate-700 mb-3 flex items-center gap-2\">\n            <i class=\"fa-solid fa-font text-purple-600\"></i> Harf Örnekleri (10. Etkinlik):\n          </h4>\n          <div class=\"grid grid-cols-3 md:grid-cols-5 gap-3\" dir=\"rtl\">\n            <div class=\"arabic-card bg-slate-50 border p-3 rounded-xl text-center font-arabic text-2xl text-slate-800 shadow-sm\">ُج ُح ُخ</div>\n            <div class=\"arabic-card bg-slate-50 border p-3 rounded-xl text-center font-arabic text-2xl text-slate-800 shadow-sm\">ُس ُش ُص</div>\n            <div class=\"arabic-card bg-slate-50 border p-3 rounded-xl text-center font-arabic text-2xl text-slate-800 shadow-sm\">ُض ُط ُظ ُع</div>\n            <div class=\"arabic-card bg-slate-50 border p-3 rounded-xl text-center font-arabic text-2xl text-slate-800 shadow-sm\">ُغ ُف ُق</div>\n            <div class=\"arabic-card bg-slate-50 border p-3 rounded-xl text-center font-arabic text-2xl text-slate-800 shadow-sm\">ُو ُي</div>\n          </div>\n        </div>\n\n        <div class=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n          <div class=\"bg-slate-50 p-5 rounded-2xl border border-slate-200 space-y-3\">\n            <h4 class=\"font-bold text-slate-700 flex items-center justify-between\">\n              <span><i class=\"fa-solid fa-[#]\"></i> Kelime Örnekleri</span>\n              <span class=\"text-xs bg-purple-100 text-purple-800 px-2 py-1 rounded\">10. Etkinlik</span>\n            </h4>\n            <div class=\"grid grid-cols-3 gap-3\" dir=\"rtl\">\n              <div class=\"arabic-card bg-white p-3 rounded-xl border text-center font-arabic text-2xl font-bold text-purple-900 shadow-sm\">كُتِبَ</div>\n              <div class=\"arabic-card bg-white p-3 rounded-xl border text-center font-arabic text-2xl font-bold text-purple-900 shadow-sm\">ظُلِمَ</div>\n              <div class=\"arabic-card bg-white p-3 rounded-xl border text-center font-arabic text-2xl font-bold text-purple-900 shadow-sm\">طُلِعَ</div>\n              <div class=\"arabic-card bg-white p-3 rounded-xl border text-center font-arabic text-2xl font-bold text-purple-900 shadow-sm\">فُعِلَ</div>\n              <div class=\"arabic-card bg-white p-3 rounded-xl border text-center font-arabic text-2xl font-bold text-purple-900 shadow-sm\">جُعِلَ</div>\n              <div class=\"arabic-card bg-white p-3 rounded-xl border text-center font-arabic text-2xl font-bold text-purple-900 shadow-sm\">قُرِئَ</div>\n            </div>\n          </div>\n\n          <div class=\"bg-slate-50 p-5 rounded-2xl border border-slate-200 space-y-3\">\n            <h4 class=\"font-bold text-slate-700 flex items-center justify-between\">\n              <span><i class=\"fa-solid fa-note-sticky text-purple-600\"></i> Çalışma Yaprağı Kelimeleri</span>\n              <span class=\"text-xs bg-purple-100 text-purple-800 px-2 py-1 rounded\">Okuma İnceleme</span>\n            </h4>\n            <div class=\"grid grid-cols-3 gap-3\" dir=\"rtl\">\n              <div class=\"arabic-card bg-white p-3 rounded-xl border text-center font-arabic text-2xl font-bold text-purple-950 shadow-sm\">رُسُلُ</div>\n              <div class=\"arabic-card bg-white p-3 rounded-xl border text-center font-arabic text-2xl font-bold text-purple-950 shadow-sm\">كُتُبُ</div>\n              <div class=\"arabic-card bg-white p-3 rounded-xl border text-center font-arabic text-2xl font-bold text-purple-950 shadow-sm\">حُسِنَ</div>\n              <div class=\"arabic-card bg-white p-3 rounded-xl border text-center font-arabic text-2xl font-bold text-purple-950 shadow-sm\">عُلِمَ</div>\n              <div class=\"arabic-card bg-white p-3 rounded-xl border text-center font-arabic text-2xl font-bold text-purple-950 shadow-sm\">نُصِرَ</div>\n              <div class=\"arabic-card bg-white p-3 rounded-xl border text-center font-arabic text-2xl font-bold text-purple-950 shadow-sm\">خُلِقَ</div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <!-- ETKİNLİK 11 VE GÖZLEM FORMU -->\n    <section class=\"bg-white rounded-3xl p-6 shadow-md border border-slate-100 space-y-6\">\n      <div class=\"flex items-center gap-3 border-b pb-4\">\n        <div class=\"w-10 h-10 rounded-xl bg-teal-100 text-teal-700 flex items-center justify-center font-bold text-lg\">11</div>\n        <div>\n          <h2 class=\"text-xl font-bold text-slate-800\">Etkinlik: Harekeleri Öğreniyorum (Görsel Tasarım & Telaffuz)</h2>\n          <p class=\"text-xs text-slate-500\">Öğrenci Rehberliğinde Harf ve Hareke Eşleştirme Becerisi</p>\n        </div>\n      </div>\n\n      <!-- Etkinlik Adımları Görsel Kartları -->\n      <div class=\"grid grid-cols-1 md:grid-cols-3 gap-4\">\n        <div class=\"bg-emerald-50/60 p-4 rounded-2xl border border-emerald-100 space-y-2\">\n          <span class=\"text-xs font-bold text-emerald-700 bg-emerald-100 px-2 py-0.5 rounded\">1. Adım</span>\n          <h3 class=\"font-bold text-slate-800\">Harf Seçimi</h3>\n          <p class=\"text-xs text-slate-600\">Kutucuklara <strong>Kalın</strong>, <strong>İnce</strong> ve <strong>Peltek</strong> harflerden birer tane Kur'an harfi yazınız.</p>\n          <div class=\"flex gap-2 justify-center pt-2\">\n            <span class=\"px-3 py-1 bg-white border rounded-lg text-xs font-bold text-slate-700\">Kalın Harf</span>\n            <span class=\"px-3 py-1 bg-white border rounded-lg text-xs font-bold text-slate-700\">İnce Harf</span>\n            <span class=\"px-3 py-1 bg-white border rounded-lg text-xs font-bold text-slate-700\">Peltek Harf</span>\n          </div>\n        </div>\n\n        <div class=\"bg-teal-50/60 p-4 rounded-2xl border border-teal-100 space-y-2\">\n          <span class=\"text-xs font-bold text-teal-700 bg-teal-100 px-2 py-0.5 rounded\">2. & 3. Adım</span>\n          <h3 class=\"font-bold text-slate-800\">Renkli Harekelendirme</h3>\n          <p class=\"text-xs text-slate-600\">Üstün, esre ve ötre harekelerini ekleyip isimlerini altına farklı renkli kalemlerle yazınız.</p>\n        </div>\n\n        <div class=\"bg-sky-50/60 p-4 rounded-2xl border border-sky-100 space-y-2\">\n          <span class=\"text-xs font-bold text-sky-700 bg-sky-100 px-2 py-0.5 rounded\">4. & 5. Adım</span>\n          <h3 class=\"font-bold text-slate-800\">Telaffuz ve Kontrol</h3>\n          <p class=\"text-xs text-slate-600\">Harfleri harekeleriyle birlikte doğru telaffuz ediniz ve öğretmeninize kontrol ettiriniz.</p>\n        </div>\n      </div>\n\n      <!-- Gözlem Formu Tablosu -->\n      <div class=\"space-y-3\">\n        <h3 class=\"font-bold text-slate-700 text-sm flex items-center gap-2\">\n          <i class=\"fa-solid fa-[#]\"></i> Gözlem Formu Değerlendirme Ölçütleri\n        </h3>\n        <div class=\"overflow-x-auto\">\n          <table class=\"w-full text-sm text-left text-slate-600 border border-slate-200 rounded-xl overflow-hidden\">\n            <thead class=\"text-xs text-slate-700 uppercase bg-slate-100\">\n              <tr>\n                <th scope=\"col\" class=\"px-4 py-3\">Ölçütler</th>\n                <th scope=\"col\" class=\"px-4 py-3 text-center w-28\">Geliştirilebilir</th>\n                <th scope=\"col\" class=\"px-4 py-3 text-center w-28\">İyi</th>\n                <th scope=\"col\" class=\"px-4 py-3 text-center w-28\">Çok İyi</th>\n              </tr>\n            </thead>\n            <tbody class=\"divide-y divide-slate-200 bg-white\">\n              <tr class=\"hover:bg-slate-50\">\n                <td class=\"px-4 py-3 font-medium text-slate-800\">1. Kur'an harflerini (kalın, ince, peltek) doğru seçip kutucuklara yazabilme</td>\n                <td class=\"text-center\"><input type=\"radio\" name=\"o1\" class=\"w-4 h-4 text-emerald-600\"></td>\n                <td class=\"text-center\"><input type=\"radio\" name=\"o1\" class=\"w-4 h-4 text-emerald-600\"></td>\n                <td class=\"text-center\"><input type=\"radio\" name=\"o1\" class=\"w-4 h-4 text-emerald-600\"></td>\n              </tr>\n              <tr class=\"hover:bg-slate-50\">\n                <td class=\"px-4 py-3 font-medium text-slate-800\">2. Harflere üstün, esre ve ötre harekelerinden birini ekleyebilme</td>\n                <td class=\"text-center\"><input type=\"radio\" name=\"o2\" class=\"w-4 h-4 text-emerald-600\"></td>\n                <td class=\"text-center\"><input type=\"radio\" name=\"o2\" class=\"w-4 h-4 text-emerald-600\"></td>\n                <td class=\"text-center\"><input type=\"radio\" name=\"o2\" class=\"w-4 h-4 text-emerald-600\"></td>\n              </tr>\n              <tr class=\"hover:bg-slate-50\">\n                <td class=\"px-4 py-3 font-medium text-slate-800\">3. Harekeler için farklı renkte kalemler kullanabilme</td>\n                <td class=\"text-center\"><input type=\"radio\" name=\"o3\" class=\"w-4 h-4 text-emerald-600\"></td>\n                <td class=\"text-center\"><input type=\"radio\" name=\"o3\" class=\"w-4 h-4 text-emerald-600\"></td>\n                <td class=\"text-center\"><input type=\"radio\" name=\"o3\" class=\"w-4 h-4 text-emerald-600\"></td>\n              </tr>\n              <tr class=\"hover:bg-slate-50\">\n                <td class=\"px-4 py-3 font-medium text-slate-800\">4. Kullandığı harekelerin isimlerini harflerin altına doğru yazabilme</td>\n                <td class=\"text-center\"><input type=\"radio\" name=\"o4\" class=\"w-4 h-4 text-emerald-600\"></td>\n                <td class=\"text-center\"><input type=\"radio\" name=\"o4\" class=\"w-4 h-4 text-emerald-600\"></td>\n                <td class=\"text-center\"><input type=\"radio\" name=\"o4\" class=\"w-4 h-4 text-emerald-600\"></td>\n              </tr>\n              <tr class=\"hover:bg-slate-50\">\n                <td class=\"px-4 py-3 font-medium text-slate-800\">5. Yazdığı harfleri harekeleriyle birlikte doğru telaffuz edebilme</td>\n                <td class=\"text-center\"><input type=\"radio\" name=\"o5\" class=\"w-4 h-4 text-emerald-600\"></td>\n                <td class=\"text-center\"><input type=\"radio\" name=\"o5\" class=\"w-4 h-4 text-emerald-600\"></td>\n                <td class=\"text-center\"><input type=\"radio\" name=\"o5\" class=\"w-4 h-4 text-emerald-600\"></td>\n              </tr>\n            </tbody>\n          </table>\n        </div>\n      </div>\n    </section>\n\n    <!-- KONTROL NOKTASI (ETKİLEŞİMLİ SORULAR VE CEVAPLAR) -->\n    <section class=\"bg-gradient-to-br from-slate-900 to-slate-800 text-white rounded-3xl p-6 shadow-xl space-y-6\">\n      <div class=\"flex items-center justify-between border-b border-slate-700 pb-4\">\n        <div class=\"flex items-center gap-3\">\n          <div class=\"w-10 h-10 rounded-xl bg-emerald-500 text-white flex items-center justify-center font-bold text-xl\">\n            <i class=\"fa-solid fa-circle-question\"></i>\n          </div>\n          <h2 class=\"text-2xl font-bold\">Kontrol Noktası</h2>\n        </div>\n        <span class=\"text-xs bg-slate-700 text-slate-300 px-3 py-1 rounded-full\">Akıllı Tahta İnceleme</span>\n      </div>\n\n      <div class=\"space-y-4\">\n        <!-- Soru 1 -->\n        <div class=\"bg-slate-800/80 p-5 rounded-2xl border border-slate-700 space-y-3\">\n          <p class=\"font-bold text-emerald-400 text-lg\">1. Hareke nedir? Örneklerle açıklayınız.</p>\n          <button onclick=\"toggleAnswer('ans-1')\" class=\"text-xs bg-emerald-600 hover:bg-emerald-500 text-white font-semibold px-4 py-2 rounded-lg transition-all\">\n            Cevabı Göster / Gizle\n          </button>\n          <div id=\"ans-1\" class=\"hidden mt-2 p-3 bg-slate-900/90 rounded-xl text-slate-300 text-sm border border-emerald-500/30\">\n            <strong>Cevap:</strong> Harflerin ünlü olarak seslendirilmesine yardımcı olan işaretlere <strong>hareke</strong> denir. <br>\n            <em>Örnekler:</em> Üstün ( َ ), Esre ( ِ ), Ötre ( ُ ).\n          </div>\n        </div>\n\n        <!-- Soru 2 -->\n        <div class=\"bg-slate-800/80 p-5 rounded-2xl border border-slate-700 space-y-3\">\n          <p class=\"font-bold text-emerald-400 text-lg\">2. Aşağıdaki harekelerin isimlerini yazınız.</p>\n          <div class=\"grid grid-cols-3 gap-4 text-center\">\n            <div class=\"bg-slate-900 p-3 rounded-xl border border-slate-700\">\n              <span class=\"font-arabic text-4xl text-amber-400 block mb-1\">َ</span>\n              <span class=\"text-xs text-slate-400\">İşaret 1</span>\n            </div>\n            <div class=\"bg-slate-900 p-3 rounded-xl border border-slate-700\">\n              <span class=\"font-arabic text-4xl text-blue-400 block mb-1\">ِ</span>\n              <span class=\"text-xs text-slate-400\">İşaret 2</span>\n            </div>\n            <div class=\"bg-slate-900 p-3 rounded-xl border border-slate-700\">\n              <span class=\"font-arabic text-4xl text-purple-400 block mb-1\">ُ</span>\n              <span class=\"text-xs text-slate-400\">İşaret 3</span>\n            </div>\n          </div>\n          <button onclick=\"toggleAnswer('ans-2')\" class=\"text-xs bg-emerald-600 hover:bg-emerald-500 text-white font-semibold px-4 py-2 rounded-lg transition-all\">\n            Cevabı Göster / Gizle\n          </button>\n          <div id=\"ans-2\" class=\"hidden mt-2 p-3 bg-slate-900/90 rounded-xl text-slate-300 text-sm border border-emerald-500/30\">\n            <strong>Cevap:</strong> <br>\n            َ : <strong>Üstün</strong> <br>\n            ِ : <strong>Esre</strong> <br>\n            ُ : <strong>Ötre</strong>\n          </div>\n        </div>\n\n        <!-- Soru 3 -->\n        <div class=\"bg-slate-800/80 p-5 rounded-2xl border border-slate-700 space-y-3\">\n          <p class=\"font-bold text-emerald-400 text-lg\">3. Aşağıdaki kelimelerde hangi harekelerin kullanıldığını yazınız.</p>\n          <div class=\"grid grid-cols-1 md:grid-cols-3 gap-3\" dir=\"rtl\">\n            <div class=\"bg-slate-900 p-3 rounded-xl border border-slate-700 text-center\">\n              <span class=\"font-arabic text-3xl text-emerald-300 block\">َكَتَبَ</span>\n              <span class=\"text-xs text-slate-400\">Örnek: Üstün - Üstün - Üstün</span>\n            </div>\n            <div class=\"bg-slate-900 p-3 rounded-xl border border-slate-700 text-center\">\n              <span class=\"font-arabic text-3xl text-blue-300 block\">حَفِظَ</span>\n              <span class=\"text-xs text-slate-400\">Soruluyor...</span>\n            </div>\n            <div class=\"bg-slate-900 p-3 rounded-xl border border-slate-700 text-center\">\n              <span class=\"font-arabic text-3xl text-purple-300 block\">كُتِبَ</span>\n              <span class=\"text-xs text-slate-400\">Soruluyor...</span>\n            </div>\n          </div>\n          <button onclick=\"toggleAnswer('ans-3')\" class=\"text-xs bg-emerald-600 hover:bg-emerald-500 text-white font-semibold px-4 py-2 rounded-lg transition-all\">\n            Cevabı Göster / Gizle\n          </button>\n          <div id=\"ans-3\" class=\"hidden mt-2 p-3 bg-slate-900/90 rounded-xl text-slate-300 text-sm border border-emerald-500/30\" dir=\"ltr\">\n            <strong>Cevap Anahtarı:</strong> <br>\n            • <span class=\"font-arabic text-lg text-emerald-400\">َكَتَبَ</span> : Üstün - Üstün - Üstün <br>\n            • <span class=\"font-arabic text-lg text-blue-400\">حَفِظَ</span> : <strong>Üstün - Esre - Üstün</strong> <br>\n            • <span class=\"font-arabic text-lg text-purple-400\">كُتِبَ</span> : <strong>Ötre - Esre - Üstün</strong>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <!-- ALT BİLGİ (FOOTER) -->\n    <footer class=\"text-center text-xs text-slate-400 py-4\">\n      <p>Milli Eğitim Bakanlığı Din Kültürü ve Ahlak Bilgisi 5. Sınıf Kur'an-ı Kerim Ders Kitabı Metinlerine %100 Sadık Kalınarak Tasarlanmıştır.</p>\n    </footer>\n\n  </div>\n\n  <!-- JS KODLARI (ETKİLEŞİM İÇİN) -->\n  <script>\n    function openTab(tabName) {\n      // Tüm sekme içeriklerini gizle\n      const contents = document.querySelectorAll('.tab-content');\n      contents.forEach(content => content.classList.add('hidden'));\n\n      // Tüm sekme buton aktifliklerini kaldır\n      const buttons = document.querySelectorAll('.tab-btn');\n      buttons.forEach(btn => {\n        btn.classList.remove('active');\n        btn.classList.add('text-slate-600', 'bg-slate-50');\n      });\n\n      // Seçilen sekmeyi göster\n      document.getElementById('tab-' + tabName).classList.remove('hidden');\n\n      // Seçilen butona aktif sınıfı ekle\n      const activeBtn = document.getElementById('btn-' + tabName);\n      activeBtn.classList.add('active');\n      activeBtn.classList.remove('text-slate-600', 'bg-slate-50');\n    }\n\n    function toggleAnswer(id) {\n      const el = document.getElementById(id);\n      if (el.classList.contains('hidden')) {\n        el.classList.remove('hidden');\n      } else {\n        el.classList.add('hidden');\n      }\n    }\n  </script>\n</body>\n</html>",
