{
  "htmlContent": "<!DOCTYPE html>\n<html lang=\"tr\" class=\"scroll-smooth\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>7. Sınıf Din Kültürü - Melek ve Ahiret İnancının İnsana Kazandırdıkları</title>\n    <!-- Tailwind CSS CDN -->\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <!-- FontAwesome CDN -->\n    <link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css\" />\n    <!-- Google Fonts -->\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n    <link href=\"https://fonts.googleapis.com/css2?family=Amiri:ital,wght@0,400;0,700;1,400&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap\" rel=\"stylesheet\">\n    <script>\n        tailwind.config = {\n            theme: {\n                extend: {\n                    fontFamily: {\n                        sans: ['Plus Jakarta Sans', 'sans-serif'],\n                        arabic: ['Amiri', 'serif'],\n                    },\n                    colors: {\n                        meb: {\n                            blue: '#003366',\n                            red: '#e30613',\n                            gold: '#d4af37',\n                            emerald: '#059669',\n                            teal: '#0d9488',\n                            slate: '#0f172a'\n                        }\n                    }\n                }\n            }\n        }\n    </script>\n    <style>\n        .glass-card {\n            background: rgba(255, 255, 255, 0.95);\n            backdrop-filter: blur(10px);\n            border: 1px solid rgba(226, 232, 240, 0.8);\n        }\n        .active-tab {\n            background-color: #0d9488 !important;\n            color: #ffffff !important;\n            box-shadow: 0 4px 12px rgba(13, 148, 136, 0.3);\n        }\n    </style>\n</head>\n<body class=\"bg-slate-50 text-slate-800 font-sans antialiased min-h-screen flex flex-col justify-between selection:bg-teal-500 selection:text-white\">\n\n    <!-- HEADER / AKILLI TAHTA ÜST BARI -->\n    <header class=\"bg-gradient-to-r from-teal-900 via-teal-800 to-slate-900 text-white shadow-xl sticky top-0 z-50 border-b border-teal-600/30\">\n        <div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4\">\n            <div class=\"flex flex-col md:flex-row md:items-center md:justify-between gap-4\">\n                <div class=\"flex items-center space-x-4\">\n                    <div class=\"w-12 h-12 rounded-2xl bg-teal-500/20 border border-teal-400/30 flex items-center justify-center text-teal-300 text-2xl shadow-inner\">\n                        <i class=\"fa-solid font-bold fa-book-quran\"></i>\n                    </div>\n                    <div>\n                        <div class=\"flex items-center space-x-2 text-xs font-semibold tracking-wider text-teal-300 uppercase\">\n                            <span>MEB 7. Sınıf</span>\n                            <span>•</span>\n                            <span>1. Ünite: Melek ve Ahiret İnancı</span>\n                        </div>\n                        <h1 class=\"text-xl sm:text-2xl font-extrabold tracking-tight text-white\">\n                            1.3. Melek ve Ahiret İnancının İnsana Kazandırdıkları\n                        </h1>\n                    </div>\n                </div>\n                \n                <!-- Hızlı Bilgi Rozetleri -->\n                <div class=\"flex items-center gap-2 text-xs font-medium\">\n                    <span class=\"px-3 py-1.5 rounded-xl bg-teal-950/80 border border-teal-700/50 text-teal-200 flex items-center gap-1.5\">\n                        <i class=\"fa-solid fa-chalkboard-user text-teal-400\"></i> Akıllı Tahta Modu\n                    </span>\n                    <span class=\"px-3 py-1.5 rounded-xl bg-amber-500/20 border border-amber-500/40 text-amber-200 flex items-center gap-1.5\">\n                        <i class=\"fa-solid fa-star text-amber-400\"></i> DERS ÖZETİ\n                    </span>\n                </div>\n            </div>\n        </div>\n    </header>\n\n    <!-- ANA İÇERİK KONTEYNERİ -->\n    <main class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 flex-grow space-y-8\">\n\n        <!-- NAVİGASYON SEKMELERİ -->\n        <div class=\"flex flex-wrap gap-2 p-1.5 bg-slate-200/80 rounded-2xl border border-slate-300/70 shadow-inner\">\n            <button onclick=\"switchTab('ozet')\" id=\"tab-ozet\" class=\"tab-btn active-tab flex-1 min-w-[140px] sm:min-w-0 py-3 px-4 rounded-xl font-bold text-sm transition-all duration-200 flex items-center justify-center gap-2 text-slate-700\">\n                <i class=\"fa-solid fa-layer-group\"></i> 1. Konu Özeti\n            </button>\n            <button onclick=\"switchTab('ayet-hadis')\" id=\"tab-ayet-hadis\" class=\"tab-btn flex-1 min-w-[140px] sm:min-w-0 py-3 px-4 rounded-xl font-bold text-sm transition-all duration-200 flex items-center justify-center gap-2 text-slate-700 hover:bg-white/60\">\n                <i class=\"fa-solid fa-quote-left\"></i> 2. Ayet & Hadis Kutusu\n            </button>\n            <button onclick=\"switchTab('ornek-olay')\" id=\"tab-ornek-olay\" class=\"tab-btn flex-1 min-w-[140px] sm:min-w-0 py-3 px-4 rounded-xl font-bold text-sm transition-all duration-200 flex items-center justify-center gap-2 text-slate-700 hover:bg-white/60\">\n                <i class=\"fa-solid fa-newspaper\"></i> 3. Örnek Olay (Almanya)\n            </button>\n            <button onclick=\"switchTab('etkinlikler')\" id=\"tab-etkinlikler\" class=\"tab-btn flex-1 min-w-[140px] sm:min-w-0 py-3 px-4 rounded-xl font-bold text-sm transition-all duration-200 flex items-center justify-center gap-2 text-slate-700 hover:bg-white/60\">\n                <i class=\"fa-solid fa-pen-to-square\"></i> 4. Akıl Yürütme & Tamamlama\n            </button>\n        </div>\n\n        <!-- TAB 1: KONU ÖZETİ (MELEK VE AHİRET İNANCININ ETKİLERİ) -->\n        <section id=\"sec-ozet\" class=\"tab-content space-y-6\">\n            \n            <!-- Üst Banner: Ana Kazanımlar -->\n            <div class=\"bg-gradient-to-r from-teal-600 to-emerald-700 rounded-3xl p-6 sm:p-8 text-white shadow-xl relative overflow-hidden\">\n                <div class=\"absolute -right-10 -bottom-10 opacity-10 text-9xl\">\n                    <i class=\"fa-solid fa-hands-holding-child\"></i>\n                </div>\n                <h2 class=\"text-xl sm:text-2xl font-bold mb-3 flex items-center gap-3\">\n                    <i class=\"fa-solid fa-bullseye text-amber-300\"></i> Konunun Temel Kazanımı\n                </h2>\n                <p class=\"text-teal-50 text-base sm:text-lg leading-relaxed max-w-4xl\">\n                    Melek ve ahiret inancı, insanın davranışlarını güzelleştiren, ona sorumluluk yükleyen, hayatını anlamlandıran ve zorluklar karşısında ona manevi güç ile huzur veren en temel inanç esaslarındandır.\n                </p>\n            </div>\n\n            <!-- 2 Sütunlu Karşılaştırmalı Kart Yapısı -->\n            <div class=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n                \n                <!-- MELEK İNANCININ İNSANA KAZANDIRDIKLARI -->\n                <div class=\"glass-card rounded-3xl p-6 sm:p-8 shadow-lg border-t-4 border-t-teal-500 hover:shadow-xl transition\">\n                    <div class=\"flex items-center space-x-4 mb-6\">\n                        <div class=\"w-14 h-14 rounded-2xl bg-teal-100 text-teal-700 flex items-center justify-center text-2xl font-bold\">\n                            <i class=\"fa-solid fa-feather-pointed\"></i>\n                        </div>\n                        <div>\n                            <span class=\"text-xs font-bold text-teal-600 uppercase tracking-wider\">Metin Özeti 1</span>\n                            <h3 class=\"text-xl font-bold text-slate-900\">Meleklere İmanın Etkileri</h3>\n                        </div>\n                    </div>\n\n                    <ul class=\"space-y-4\">\n                        <li class=\"flex items-start gap-3 p-3 rounded-xl bg-teal-50/60 border border-teal-100\">\n                            <i class=\"fa-solid fa-circle-check text-teal-600 mt-1\"></i>\n                            <div>\n                                <strong class=\"text-slate-900 block\">Kötülükten Kaçınma ve İyiliğe Yönelme:</strong>\n                                <span class=\"text-sm text-slate-600\">Davranışlarının melekler tarafından kaydedildiğini bilen insan yalandan ve haksızlıktan uzak durur.</span>\n                            </div>\n                        </li>\n                        <li class=\"flex items-start gap-3 p-3 rounded-xl bg-teal-50/60 border border-teal-100\">\n                            <i class=\"fa-solid fa-circle-check text-teal-600 mt-1\"></i>\n                            <div>\n                                <strong class=\"text-slate-900 block\">Güzel Ahlak Sahibi Olma:</strong>\n                                <span class=\"text-sm text-slate-600\">Doğruluk, yardımseverlik, sevgi ve merhamet gibi değerleri benimser.</span>\n                            </div>\n                        </li>\n                        <li class=\"flex items-start gap-3 p-3 rounded-xl bg-teal-50/60 border border-teal-100\">\n                            <i class=\"fa-solid fa-circle-check text-teal-600 mt-1\"></i>\n                            <div>\n                                <strong class=\"text-slate-900 block\">Manevi Destek ve Güç:</strong>\n                                <span class=\"text-sm text-slate-600\">Meleklerin Allah'ın izniyle kendisini koruduğunu, onun için dua ettiğini ve güzel işlerde desteklediğini bilerek manevi güç kazanır.</span>\n                            </div>\n                        </li>\n                        <li class=\"flex items-start gap-3 p-3 rounded-xl bg-teal-50/60 border border-teal-100\">\n                            <i class=\"fa-solid fa-circle-check text-teal-600 mt-1\"></i>\n                            <div>\n                                <strong class=\"text-slate-900 block\">Allah'ın Sevgisine Layık Olma:</strong>\n                                <span class=\"text-sm text-slate-600\">Allah'ın sevgisini hisseder ve bu sevgiye layık olmaya çalışır.</span>\n                            </div>\n                        </li>\n                    </ul>\n                </div>\n\n                <!-- AHİRET İNANCININ İNSANA KAZANDIRDIKLARI -->\n                <div class=\"glass-card rounded-3xl p-6 sm:p-8 shadow-lg border-t-4 border-t-emerald-500 hover:shadow-xl transition\">\n                    <div class=\"flex items-center space-x-4 mb-6\">\n                        <div class=\"w-14 h-14 rounded-2xl bg-emerald-100 text-emerald-700 flex items-center justify-center text-2xl font-bold\">\n                            <i class=\"fa-solid fa-scale-balanced\"></i>\n                        </div>\n                        <div>\n                            <span class=\"text-xs font-bold text-emerald-600 uppercase tracking-wider\">Metin Özeti 2</span>\n                            <h3 class=\"text-xl font-bold text-slate-900\">Ahirete İmanın Etkileri</h3>\n                        </div>\n                    </div>\n\n                    <ul class=\"space-y-4\">\n                        <li class=\"flex items-start gap-3 p-3 rounded-xl bg-emerald-50/60 border border-emerald-100\">\n                            <i class=\"fa-solid fa-circle-check text-emerald-600 mt-1\"></i>\n                            <div>\n                                <strong class=\"text-slate-900 block\">Hayatı Anlamlandırma:</strong>\n                                <span class=\"text-sm text-slate-600\">Dünyanın bir imtihan yeri olduğunu kavrar; kainattaki her şeyin bir yaratılış amacı olduğunu anlar.</span>\n                            </div>\n                        </li>\n                        <li class=\"flex items-start gap-3 p-3 rounded-xl bg-emerald-50/60 border border-emerald-100\">\n                            <i class=\"fa-solid fa-circle-check text-emerald-600 mt-1\"></i>\n                            <div>\n                                <strong class=\"text-slate-900 block\">Sorumluluk ve Görev Bilinci:</strong>\n                                <span class=\"text-sm text-slate-600\">Ailesine, çevresine ve tüm canlılara karşı sorumluluk taşır. Sorumluluk, çalışkanlık ve görev bilinci kazanır.</span>\n                            </div>\n                        </li>\n                        <li class=\"flex items-start gap-3 p-3 rounded-xl bg-emerald-50/60 border border-emerald-100\">\n                            <i class=\"fa-solid fa-circle-check text-emerald-600 mt-1\"></i>\n                            <div>\n                                <strong class=\"text-slate-900 block\">Yok Olma Endişesinden Kurtulma & Huzur:</strong>\n                                <span class=\"text-sm text-slate-600\">Hayatın ölümle son bulmayacağını, ahirette sevdikleriyle birlikte olacağını bilerek huzur bulur.</span>\n                            </div>\n                        </li>\n                        <li class=\"flex items-start gap-3 p-3 rounded-xl bg-emerald-50/60 border border-emerald-100\">\n                            <i class=\"fa-solid fa-circle-check text-emerald-600 mt-1\"></i>\n                            <div>\n                                <strong class=\"text-slate-900 block\">Sabır ve Mücadele:</strong>\n                                <span class=\"text-sm text-slate-600\">Başına gelen musibetlere karşı sabırla mücadele eder, zorlukların üstesinden gelmeye çalışır.</span>\n                            </div>\n                        </li>\n                    </ul>\n                </div>\n            </div>\n\n            <!-- PIN KUTUSU: UNUTMAYALIM -->\n            <div class=\"bg-amber-50 border-2 border-amber-300 rounded-2xl p-6 flex flex-col sm:flex-row items-center gap-5 shadow-sm\">\n                <div class=\"w-16 h-16 rounded-2xl bg-amber-400 text-amber-900 flex-shrink-0 flex items-center justify-center text-3xl shadow-md\">\n                    <i class=\"fa-solid fa-lightbulb\"></i>\n                </div>\n                <div>\n                    <h4 class=\"text-lg font-bold text-amber-950 flex items-center gap-2\">\n                        🎯 Sınav İpucu & Unutmayalım!\n                    </h4>\n                    <p class=\"text-amber-900 text-sm sm:text-base leading-relaxed mt-1\">\n                        <strong>Melek ve Ahiret İnancı</strong> insanda yalnızlık hissini yok eder. İnsanın <em>doğruluk, dürüstlük, adalet, yardımseverlik, akraba ve komşu ilişkilerine özen gösterme, sorumluluk ve çalışkanlık</em> gibi temel ahlaki değerleri hayatına yansıtmasını sağlar.\n                    </p>\n                </div>\n            </div>\n\n        </section>\n\n        <!-- TAB 2: AYET VE HADİS KUTUSU -->\n        <section id=\"sec-ayet-hadis\" class=\"tab-content hidden space-y-6\">\n            \n            <div class=\"text-center max-w-2xl mx-auto mb-4\">\n                <h2 class=\"text-2xl font-bold text-slate-900\">Ders Kitabındaki Ayet-i Kerimeler ve Hadis-i Şerif</h2>\n                <p class=\"text-slate-600 text-sm\">Bu deliller meleklerin dualarını, adil olmayı, iyilik yapmayı ve toplumsal ahlakı vurgulamaktadır.</p>\n            </div>\n\n            <!-- AYET 1: Mümin Suresi 7. Ayet (Kitaptaki Özel Ayet Kutusu) -->\n            <div class=\"glass-card rounded-3xl p-6 sm:p-8 border-l-8 border-l-teal-600 shadow-lg relative overflow-hidden\">\n                <div class=\"flex items-center justify-between mb-4\">\n                    <span class=\"px-3 py-1 rounded-full bg-teal-100 text-teal-800 text-xs font-bold uppercase tracking-wide\">\n                        <i class=\"fa-solid fa-book-open\"></i> Ayet Kutusu (Sayfa 34)\n                    </span>\n                    <span class=\"text-xs text-slate-500 font-semibold\">Mümin suresi 7. ayet</span>\n                </div>\n                \n                <div class=\"bg-teal-50/50 p-4 rounded-2xl mb-4 text-right\">\n                    <p class=\"font-arabic text-2xl sm:text-3xl text-teal-950 leading-loose\">\n                        الَّذِينَ يَحْمِلُونَ الْعَرْشَ وَمَنْ حَوْلَهُ يُسَبِّحُونَ بِحَمْدِ رَبِّهِمْ وَيُؤْمِنُونَ بِهِ وَيَسْتَغْفِرُونَ لِلَّذِينَ آمَنُوا رَبَّنَا وَسِعْتَ كُلَّ شَيْءٍ رَحْمَةً وَعِلْمًا فَاغْفِرْ لِلَّذِينَ تَابُوا وَاتَّبَعُوا سَبِيلَكَ وَقِهِمْ عَذَابَ الْجَحِيمِ\n                    </p>\n                </div>\n\n                <div class=\"text-slate-800 leading-relaxed text-base sm:text-lg italic font-medium\">\n                    “Arş’ı taşıyanlar ve onun çevresinde bulunanlar (melekler) Rablerini hamd ederek tespih ederler, O’na inanırlar ve inananlar için (şöyle diyerek) bağışlanma dilerler: <strong class=\"text-teal-800 font-semibold\">‘Ey Rabbimiz! Senin rahmetin ve ilmin her şeyi kuşatmıştır. O hâlde tövbe eden ve senin yoluna uyanları bağışla ve onları cehennem azâbından koru.’</strong>”\n                </div>\n            </div>\n\n            <div class=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n                <!-- AYET 2: Bakara 195 -->\n                <div class=\"glass-card rounded-3xl p-6 border-l-8 border-l-emerald-600 shadow-md\">\n                    <div class=\"flex items-center justify-between mb-3\">\n                        <span class=\"px-3 py-1 rounded-full bg-emerald-100 text-emerald-800 text-xs font-bold\">Bakara Suresi 195. Ayet</span>\n                        <i class=\"fa-solid fa-kaaba text-emerald-600\"></i>\n                    </div>\n                    <blockquote class=\"text-slate-800 text-base italic leading-relaxed\">\n                        “… İyi ve yararlı işleri en güzel şekilde yapın. Şüphesiz, Allah iyi ve yararlı işleri en güzel şekilde yapanları sever.”\n                    </blockquote>\n                </div>\n\n                <!-- AYET 3: Maide 8 -->\n                <div class=\"glass-card rounded-3xl p-6 border-l-8 border-l-blue-600 shadow-md\">\n                    <div class=\"flex items-center justify-between mb-3\">\n                        <span class=\"px-3 py-1 rounded-full bg-blue-100 text-blue-800 text-xs font-bold\">Maide Suresi 8. Ayet</span>\n                        <i class=\"fa-solid fa-scale-balanced text-blue-600\"></i>\n                    </div>\n                    <blockquote class=\"text-slate-800 text-base italic leading-relaxed\">\n                        “Ey iman edenler! Allah için hakkı titizlikle ayakta tutan, adalet ile şahitlik eden kimseler olun. Bir topluma olan kininiz, sakın ha sizi adaletsizliğe itmesin. Âdil olun. Bu, Allah’a karşı gelmekten sakınmaya daha yakındır. Allah’a karşı gelmekten sakının. Şüphesiz Allah, yaptıklarınızdan hakkıyla haberdardır.”\n                    </blockquote>\n                </div>\n            </div>\n\n            <!-- HADİS KUTUSU -->\n            <div class=\"glass-card rounded-3xl p-6 sm:p-8 border-l-8 border-l-amber-500 shadow-lg bg-gradient-to-r from-amber-50/30 to-white\">\n                <div class=\"flex items-center justify-between mb-4\">\n                    <span class=\"px-3 py-1 rounded-full bg-amber-100 text-amber-900 text-xs font-bold uppercase tracking-wider flex items-center gap-2\">\n                        <i class=\"fa-solid fa-scroll\"></i> Hadis-i Şerif\n                    </span>\n                    <span class=\"text-xs text-slate-500 font-medium\">Ebu Davud, “Edeb”, 122-123</span>\n                </div>\n                <div class=\"text-slate-900 text-lg sm:text-xl font-medium leading-relaxed italic\">\n                    “Allah’a ve ahiret gününe iman eden kişi misafirine ikram etsin. Allah’a ve ahiret gününe iman eden kişi komşusunu rahatsız etmesin. Allah’a ve ahiret gününe iman eden kişi ya hayır söylesin ya da sussun.”\n                </div>\n                <div class=\"mt-4 pt-4 border-t border-amber-200/60 flex flex-wrap gap-2 text-xs font-semibold text-amber-900\">\n                    <span class=\"bg-amber-100/80 px-3 py-1 rounded-lg\"># Misafire İkram</span>\n                    <span class=\"bg-amber-100/80 px-3 py-1 rounded-lg\"># Komşu Hakkı</span>\n                    <span class=\"bg-amber-100/80 px-3 py-1 rounded-lg\"># Dilin Korunması (Hayır Söylemek)</span>\n                </div>\n            </div>\n\n        </section>\n\n        <!-- TAB 3: ÖRNEK OLAY (ALMANYA GURBETÇİ H.E.) -->\n        <section id=\"sec-ornek-olay\" class=\"tab-content hidden space-y-6\">\n            \n            <div class=\"glass-card rounded-3xl p-6 sm:p-8 shadow-xl border border-slate-200\">\n                <div class=\"flex flex-col md:flex-row gap-6 items-start\">\n                    \n                    <div class=\"w-full md:w-1/3 bg-slate-900 text-white rounded-2xl p-6 flex flex-col justify-between min-h-[240px] relative overflow-hidden\">\n                        <div class=\"absolute -right-6 -top-6 text-slate-800 text-8xl opacity-40\">\n                            <i class=\"fa-solid fa-hand-holding-dollar\"></i>\n                        </div>\n                        <div>\n                            <span class=\"px-2.5 py-1 rounded bg-teal-500/30 text-teal-300 text-xs font-bold uppercase tracking-wider\">Gerçek Yaşam Öyküsü</span>\n                            <h3 class=\"text-2xl font-bold mt-2 text-white\">Örnek Davranış: Dürüstlük Örneği</h3>\n                            <p class=\"text-slate-400 text-sm mt-1\">Almanya'da Yaşayan Gurbetçi H.E.</p>\n                        </div>\n                        <div class=\"mt-6 pt-4 border-t border-slate-800 text-xs text-slate-300\">\n                            <i class=\"fa-solid fa-location-dot text-teal-400\"></i> Sinop'tan Almanya'ya (24 yıllık gurbetçi)\n                        </div>\n                    </div>\n\n                    <div class=\"w-full md:w-2/3 space-y-4\">\n                        <div class=\"bg-slate-50 p-5 rounded-2xl border border-slate-200\">\n                            <h4 class=\"font-bold text-slate-900 mb-2 flex items-center gap-2\">\n                                <i class=\"fa-solid fa-circle-info text-teal-600\"></i> Olayın Özeti:\n                            </h4>\n                            <p class=\"text-slate-700 text-sm sm:text-base leading-relaxed\">\n                                Almanya'da ölen insanların evlerini boşaltma işi yapan H.E., e-posta ile aldığı bir sipariş üzerine vefat eden bir adamın evini boşaltırken dolapta içi para dolu bir çanta buldu. Gurbetçi H.E., parayı sahibine (ölen adamın kızına) ulaştırarak teslim etti. Bu para, Avrupa'da bulunup iade edilen en yüksek miktarda para oldu.\n                            </p>\n                        </div>\n\n                        <!-- Altın Cümle Kutusu -->\n                        <div class=\"bg-teal-900 text-white p-5 rounded-2xl shadow-md border-l-4 border-l-amber-400\">\n                            <span class=\"text-amber-300 text-xs font-bold uppercase tracking-widest block mb-1\">Gurbetçinin Açıklaması:</span>\n                            <p class=\"text-base sm:text-lg font-serif italic\">\n                                “Bizi buraya getiren gücün adının İslam olduğunu ve sahibinin rızası olmadan paranın bir kuruşuna dahi dokunamayacağımızı ona söyledim.”\n                            </p>\n                        </div>\n\n                        <!-- Vurgulanan Değerler -->\n                        <div>\n                            <h4 class=\"text-xs font-bold text-slate-500 uppercase tracking-wider mb-2\">Örnek Olayda Vurgulanan Temel Değerler:</h4>\n                            <div class=\"flex flex-wrap gap-2\">\n                                <span class=\"px-3 py-1.5 rounded-xl bg-teal-100 text-teal-900 text-xs font-bold flex items-center gap-1.5\">\n                                    <i class=\"fa-solid fa-shield-halved text-teal-600\"></i> Dürüstlük & Doğruluk\n                                </span>\n                                <span class=\"px-3 py-1.5 rounded-xl bg-emerald-100 text-emerald-900 text-xs font-bold flex items-center gap-1.5\">\n                                    <i class=\"fa-solid fa-balance-scale text-emerald-600\"></i> Kul Hakkı Bilinci\n                                </span>\n                                <span class=\"px-3 py-1.5 rounded-xl bg-amber-100 text-amber-900 text-xs font-bold flex items-center gap-1.5\">\n                                    <i class=\"fa-solid fa-heart text-amber-600\"></i> İslam Ahlakı & Sorumluluk\n                                </span>\n                                <span class=\"px-3 py-1.5 rounded-xl bg-blue-100 text-blue-900 text-xs font-bold flex items-center gap-1.5\">\n                                    <i class=\"fa-solid fa-eye text-blue-600\"></i> Allah'ın Görüp Kaydettiği Bilinci\n                                </span>\n                            </div>\n                        </div>\n\n                    </div>\n                </div>\n            </div>\n\n        </section>\n\n        <!-- TAB 4: ETKİNLİKLER VE AKIL YÜRÜTME -->\n        <section id=\"sec-etkinlikler\" class=\"tab-content hidden space-y-8\">\n            \n            <!-- ETKİNLİK 7: YAZMAN SORUSU KARTI -->\n            <div class=\"glass-card rounded-3xl p-6 sm:p-8 shadow-lg border-t-4 border-t-teal-600\">\n                <div class=\"flex items-center justify-between mb-4\">\n                    <span class=\"px-3 py-1 rounded-full bg-teal-100 text-teal-800 text-xs font-bold\">7. Etkinlik • İnanç ve Hayat</span>\n                    <span class=\"text-xs text-slate-400 font-semibold\"><i class=\"fa-regular fa-clock\"></i> 20 dk</span>\n                </div>\n                <h3 class=\"text-lg sm:text-xl font-bold text-slate-900 mb-3\">\n                    ❓ Tartışma Sorusu: “Yaptığı her şeyin kaydedildiği ve bunların hesabını vereceği bilincine sahip olan biri nasıl yaşar?”\n                </h3>\n                \n                <p class=\"text-sm text-slate-600 mb-4\">Aşağıdaki kartlara tıklayarak derste tahtaya yazılacak uygun cevapları inceleyebilirsiniz:</p>\n\n                <div class=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4\">\n                    <div class=\"p-4 rounded-2xl bg-white border border-slate-200 shadow-sm hover:border-teal-500 transition cursor-default\">\n                        <div class=\"text-teal-600 mb-2\"><i class=\"fa-solid fa-user-check text-xl\"></i></div>\n                        <h4 class=\"font-bold text-slate-800 text-sm\">Adil ve Dürüst Olur</h4>\n                        <p class=\"text-xs text-slate-500 mt-1\">Yalandan, hileden ve insanların hakkını yemekten titizlikle kaçınır.</p>\n                    </div>\n\n                    <div class=\"p-4 rounded-2xl bg-white border border-slate-200 shadow-sm hover:border-teal-500 transition cursor-default\">\n                        <div class=\"text-emerald-600 mb-2\"><i class=\"fa-solid fa-hand-holding-heart text-xl\"></i></div>\n                        <h4 class=\"font-bold text-slate-800 text-sm\">İyilik ve Yardımseverlik Yapar</h4>\n                        <p class=\"text-xs text-slate-500 mt-1\">Yaptığı güzel işlerin karşılığını Allah'tan bekleyerek topluma faydalı olur.</p>\n                    </div>\n\n                    <div class=\"p-4 rounded-2xl bg-white border border-slate-200 shadow-sm hover:border-teal-500 transition cursor-default\">\n                        <div class=\"text-amber-600 mb-2\"><i class=\"fa-solid fa-clipboard-check text-xl\"></i></div>\n                        <h4 class=\"font-bold text-slate-800 text-sm\">Sorumluluk Bilinciyle Hareket Eder</h4>\n                        <p class=\"text-xs text-slate-500 mt-1\">Ailesine, çevresine ve canlılara karşı görevlerini aksatmaz.</p>\n                    </div>\n                </div>\n            </div>\n\n            <!-- ETKİNLİK 9: İNANIYORUM ÇÜNKÜ... (CÜMLE TAMAMLAMA) -->\n            <div class=\"glass-card rounded-3xl p-6 sm:p-8 shadow-lg border-t-4 border-t-emerald-600\">\n                <div class=\"flex items-center justify-between mb-4\">\n                    <span class=\"px-3 py-1 rounded-full bg-emerald-100 text-emerald-800 text-xs font-bold\">9. Etkinlik • İnanıyorum Çünkü</span>\n                    <span class=\"text-xs text-slate-400 font-semibold\"><i class=\"fa-regular fa-clock\"></i> 20 dk</span>\n                </div>\n                <h3 class=\"text-lg font-bold text-slate-900 mb-6\">Cümle Tamamlama ve Gerekçe Belirleme</h3>\n\n                <div class=\"space-y-4\">\n                    <!-- Cümle 1 -->\n                    <div class=\"bg-slate-50 p-4 sm:p-5 rounded-2xl border border-slate-200\">\n                        <p class=\"font-bold text-slate-800 text-base mb-2\">\n                            1. Meleklerin varlığına inanmak davranışlarımı düzeltmemde motivasyon sağlar. <span class=\"text-emerald-700 font-extrabold\">Çünkü;</span>\n                        </p>\n                        <div class=\"p-3 bg-white rounded-xl border border-emerald-200 text-sm text-slate-700\">\n                            <i class=\"fa-solid fa-pen text-emerald-600 mr-2\"></i> Davranışlarımın melekler tarafından kaydedildiğini ve Allah'ın beni her an desteklediğini bilmek beni iyiliğe yöneltir.\n                        </div>\n                    </div>\n\n                    <!-- Cümle 2 -->\n                    <div class=\"bg-slate-50 p-4 sm:p-5 rounded-2xl border border-slate-200\">\n                        <p class=\"font-bold text-slate-800 text-base mb-2\">\n                            2. Ahiret inancı hayatıma anlam katar. <span class=\"text-emerald-700 font-extrabold\">Çünkü;</span>\n                        </p>\n                        <div class=\"p-3 bg-white rounded-xl border border-emerald-200 text-sm text-slate-700\">\n                            <i class=\"fa-solid fa-pen text-emerald-600 mr-2\"></i> Dünya hayatının bir imtihan olduğunu, yok olup gitmeyeceğimi ve sevdiklerimle ahirette buluşacağımı kavramamı sağlar.\n                        </div>\n                    </div>\n\n                    <!-- Cümle 3 -->\n                    <div class=\"bg-slate-50 p-4 sm:p-5 rounded-2xl border border-slate-200\">\n                        <p class=\"font-bold text-slate-800 text-base mb-2\">\n                            3. Ahiret inancı bana sorumluluk ve hesap verme bilinci kazandırır. <span class=\"text-emerald-700 font-extrabold\">Çünkü;</span>\n                        </p>\n                        <div class=\"p-3 bg-white rounded-xl border border-emerald-200 text-sm text-slate-700\">\n                            <i class=\"fa-solid fa-pen text-emerald-600 mr-2\"></i> Dünyada yaptığım her güzel işin veya kötülüğün ahirette bir karşılığı olacağını bilirim.\n                        </div>\n                    </div>\n                </div>\n            </div>\n\n            <!-- KONTROL NOKTASI: BİLGİ HARİTASI -->\n            <div class=\"bg-slate-900 text-white rounded-3xl p-6 sm:p-8 shadow-xl\">\n                <div class=\"flex items-center justify-between mb-6\">\n                    <div>\n                        <span class=\"px-3 py-1 rounded-full bg-amber-400/20 text-amber-300 text-xs font-bold\">Sayfa 36 • Kontrol Noktası</span>\n                        <h3 class=\"text-xl font-bold text-white mt-1\">Meleklere ve Ahirete İman Eden İnsanın Özellikleri</h3>\n                    </div>\n                    <i class=\"fa-solid fa-sitemap text-3xl text-amber-400\"></i>\n                </div>\n\n                <div class=\"grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3\">\n                    <div class=\"bg-slate-800/80 p-3.5 rounded-xl border border-slate-700 text-xs font-medium text-slate-200 flex items-center gap-2\">\n                        <i class=\"fa-solid fa-check text-amber-400\"></i> Arkadaşlarına iyi davranır.\n                    </div>\n                    <div class=\"bg-slate-800/80 p-3.5 rounded-xl border border-slate-700 text-xs font-medium text-slate-200 flex items-center gap-2\">\n                        <i class=\"fa-solid fa-check text-amber-400\"></i> Yalandan ve haksızlıktan uzak durur.\n                    </div>\n                    <div class=\"bg-slate-800/80 p-3.5 rounded-xl border border-slate-700 text-xs font-medium text-slate-200 flex items-center gap-2\">\n                        <i class=\"fa-solid fa-check text-amber-400\"></i> Komşularını rahatsız etmez.\n                    </div>\n                    <div class=\"bg-slate-800/80 p-3.5 rounded-xl border border-slate-700 text-xs font-medium text-slate-200 flex items-center gap-2\">\n                        <i class=\"fa-solid fa-check text-amber-400\"></i> Ya hayır söyler ya da susar.\n                    </div>\n                    <div class=\"bg-slate-800/80 p-3.5 rounded-xl border border-slate-700 text-xs font-medium text-slate-200 flex items-center gap-2\">\n                        <i class=\"fa-solid fa-check text-amber-400\"></i> Zorluklara karşı sabreder.\n                    </div>\n                    <div class=\"bg-slate-800/80 p-3.5 rounded-xl border border-slate-700 text-xs font-medium text-slate-200 flex items-center gap-2\">\n                        <i class=\"fa-solid fa-check text-amber-400\"></i> Kul hakkına özen gösterir.\n                    </div>\n                    <div class=\"bg-slate-800/80 p-3.5 rounded-xl border border-slate-700 text-xs font-medium text-slate-200 flex items-center gap-2\">\n                        <i class=\"fa-solid fa-check text-amber-400\"></i> İhtiyaç sahiplerine yardım eder.\n                    </div>\n                    <div class=\"bg-slate-800/80 p-3.5 rounded-xl border border-slate-700 text-xs font-medium text-slate-200 flex items-center gap-2\">\n                        <i class=\"fa-solid fa-check text-amber-400\"></i> Sorumluluk bilinciyle çalışır.\n                    </div>\n                </div>\n\n                <!-- Etkinlik Değerlendirme Sözü -->\n                <div class=\"mt-6 pt-4 border-t border-slate-800 flex items-center justify-between text-xs text-slate-400\">\n                    <span>Örnek Özlü Söz: <em>“Meleklere iman, huzur ve mutluluk verir inan.”</em></span>\n                </div>\n            </div>\n\n        </section>\n\n    </main>\n\n    <!-- FOOTER -->\n    <footer class=\"bg-slate-900 text-slate-400 text-xs py-6 border-t border-slate-800 mt-12\">\n        <div class=\"max-w-7xl mx-auto px-4 text-center space-y-2\">\n            <p>Milli Eğitim Bakanlığı (MEB) 7. Sınıf Din Kültürü ve Ahlak Bilgisi Ders Kitabı Kaynak Alınarak Hazırlanmıştır.</p>\n            <p class=\"text-slate-500\">%100 Müfredata Sadık Akıllı Tahta İnteraktif Ders Özeti</p>\n        </div>\n    </footer>\n\n    <!-- INTERACTIVITY JAVASCRIPT -->\n    <script>\n        function switchTab(tabId) {\n            // Hide all tab contents\n            const contents = document.querySelectorAll('.tab-content');\n            contents.forEach(content => content.classList.add('hidden'));\n\n            // Deactivate all tab buttons\n            const buttons = document.querySelectorAll('.tab-btn');\n            buttons.forEach(btn => {\n                btn.classList.remove('active-tab');\n                btn.classList.add('hover:bg-white/60');\n            });\n\n            // Show selected tab content\n            const targetSection = document.getElementById('sec-' + tabId);\n            if(targetSection) {\n                targetSection.classList.remove('hidden');\n            }\n\n            // Activate selected tab button\n            const targetBtn = document.getElementById('tab-' + tabId);\n            if(targetBtn) {\n                targetBtn.classList.add('active-tab');\n                targetBtn.classList.remove('hover:bg-white/60');\n            }\n        }\n    </script>\n</body>\n</html>",
