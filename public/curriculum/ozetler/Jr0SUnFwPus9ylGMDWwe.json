{
  "htmlContent": "<!DOCTYPE html>\n<html lang=\"tr\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>7. Sınıf Peygamberimizin Hayatı - Hicret Yolculuğu</title>\n    <!-- Tailwind CSS CDN -->\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <!-- FontAwesome CDN -->\n    <link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css\" />\n    <!-- Google Fonts -->\n    <link href=\"https://fonts.googleapis.com/css2?family=Amiri:ital,wght@0,400;0,700;1,400&family=Outfit:wght@300;400;500;600;700&display=swap\" rel=\"stylesheet\">\n    <style>\n        body { font-family: 'Outfit', sans-serif; }\n        .arabic-text { font-family: 'Amiri', serif; }\n    </style>\n</head>\n<body class=\"bg-slate-50 text-slate-800 min-h-screen p-4 md:p-8\">\n\n    <div class=\"max-w-6xl mx-auto space-y-8\">\n\n        <!-- BAŞLIK KARTI -->\n        <header class=\"bg-gradient-to-r from-emerald-800 via-emerald-700 to-teal-800 text-white p-6 md:p-8 rounded-3xl shadow-xl flex flex-col md:flex-row justify-between items-center gap-6\">\n            <div class=\"space-y-2 text-center md:text-left\">\n                <span class=\"bg-emerald-600/60 text-emerald-100 text-xs font-semibold px-3 py-1 rounded-full uppercase tracking-wider border border-emerald-500/30\">\n                    7. Sınıf • Peygamberimizin Hayatı • 1. Ünite\n                </span>\n                <h1 class=\"text-3xl md:text-4xl font-bold tracking-tight\">1.5. Hicret Yolculuğu</h1>\n                <p class=\"text-emerald-100 text-sm md:text-base max-w-xl\">\n                    Mekke'den Medine'ye uzanan kutlu yolculuk, fedakârlık ve kardeşliğin yeniden doğuşu.\n                </p>\n            </div>\n            <div class=\"bg-white/10 backdrop-blur-md p-4 rounded-2xl border border-white/20 text-center min-w-[140px]\">\n                <span class=\"block text-3xl font-bold\">622</span>\n                <span class=\"text-xs uppercase tracking-widest text-emerald-200\">Hicri Milat</span>\n            </div>\n        </header>\n\n        <!-- KAVRAMLAR KARTI -->\n        <section class=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n            <div class=\"bg-white p-6 rounded-3xl shadow-md border border-slate-100 flex items-start gap-4 transition hover:shadow-lg\">\n                <div class=\"bg-emerald-100 text-emerald-700 p-4 rounded-2xl text-xl\">\n                    <i class=\"fa-solid fa-people-carry-box\"></i>\n                </div>\n                <div>\n                    <span class=\"text-xs font-bold text-emerald-600 uppercase tracking-wider\">Kritik Kavram</span>\n                    <h3 class=\"text-xl font-bold text-slate-900 mt-1\">Muhacir</h3>\n                    <p class=\"text-slate-600 text-sm mt-2 leading-relaxed\">\n                        Mekkeli müşriklerin baskılarına rağmen zor şartlar altında İslam'ı yaşayan ve Mekke'den Medine'ye göç eden Müslümanlara denir.\n                    </p>\n                </div>\n            </div>\n\n            <div class=\"bg-white p-6 rounded-3xl shadow-md border border-slate-100 flex items-start gap-4 transition hover:shadow-lg\">\n                <div class=\"bg-amber-100 text-amber-700 p-4 rounded-2xl text-xl\">\n                    <i class=\"fa-solid fa-hands-holding-child\"></i>\n                </div>\n                <div>\n                    <span class=\"text-xs font-bold text-amber-600 uppercase tracking-wider\">Kritik Kavram</span>\n                    <h3 class=\"text-xl font-bold text-slate-900 mt-1\">Ensar</h3>\n                    <p class=\"text-slate-600 text-sm mt-2 leading-relaxed\">\n                        Muhacirlere kucak açan, onlara her konuda destek olan, Medine'den önce bu yurda yerleşmiş ve gönülden inanmış Medineli Müslümanlara denir.\n                    </p>\n                </div>\n            </div>\n        </section>\n\n        <!-- ANA KAZANIMLAR / HİCRETİN AŞAMALARI -->\n        <section class=\"bg-white p-6 md:p-8 rounded-3xl shadow-md border border-slate-100 space-y-6\">\n            <h2 class=\"text-2xl font-bold text-slate-900 flex items-center gap-3\">\n                <i class=\"fa-solid fa-route text-emerald-600\"></i> Hicret Yolculuğunun Aşamaları ve Önemli Olaylar\n            </h2>\n            \n            <div class=\"grid grid-cols-1 md:grid-cols-3 gap-6\">\n                <!-- Adım 1 -->\n                <div class=\"bg-slate-50 p-5 rounded-2xl border border-slate-200/60 space-y-3\">\n                    <div class=\"w-10 h-10 rounded-xl bg-emerald-600 text-white flex items-center justify-center font-bold\">1</div>\n                    <h4 class=\"font-bold text-slate-900 text-lg\">Hazırlık ve Suikast Planı</h4>\n                    <p class=\"text-sm text-slate-600 leading-relaxed\">\n                        İkinci Akabe Biati'nden sonra Müslümanlar gruplar hâlinde Medine'ye göç etti. Mekkeliler suikast planı yaptı. Hz. Muhammed (sav), Hz. Ali'yi yatağına yatırdı ve emanetleri sahiplerine vermesini istedi.\n                    </p>\n                </div>\n\n                <!-- Adım 2 -->\n                <div class=\"bg-slate-50 p-5 rounded-2xl border border-slate-200/60 space-y-3\">\n                    <div class=\"w-10 h-10 rounded-xl bg-emerald-600 text-white flex items-center justify-center font-bold\">2</div>\n                    <h4 class=\"font-bold text-slate-900 text-lg\">Sevr Mağarası</h4>\n                    <p class=\"text-sm text-slate-600 leading-relaxed\">\n                        Hz. Muhammed (sav) ve Hz. Ebubekir, Medine'nin ters istikametine giderek Sevr Dağı'ndaki Sevr Mağarası'nda 3 gün kaldılar. Müşrikler mağaranın önüne kadar gelse de Allah'ın yardımıyla onları fark edemediler.\n                    </p>\n                </div>\n\n                <!-- Adım 3 -->\n                <div class=\"bg-slate-50 p-5 rounded-2xl border border-slate-200/60 space-y-3\">\n                    <div class=\"w-10 h-10 rounded-xl bg-emerald-600 text-white flex items-center justify-center font-bold\">3</div>\n                    <h4 class=\"font-bold text-slate-900 text-lg\">Kuba ve Medine'ye Varış</h4>\n                    <p class=\"text-sm text-slate-600 leading-relaxed\">\n                        Medine yakınlarındaki Kuba köyünde ilk mescit (Kuba Mescidi) inşa edildi. Ranuna Vadisi'nde ilk cuma namazı kılındı. 12 Rebiyülevvel 622 Cuma günü Medine'ye ulaşıldı.\n                    </p>\n                </div>\n            </div>\n        </section>\n\n        <!-- AYET VE HADİS KUTULARI -->\n        <div class=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n            \n            <!-- Ayet Kutusu 1 -->\n            <div class=\"bg-emerald-900 text-white p-6 md:p-8 rounded-3xl shadow-xl flex flex-col justify-between space-y-6 relative overflow-hidden\">\n                <div class=\"absolute right-[-20px] bottom-[-20px] text-white/5 text-9xl font-bold pointer-events-none\">\n                    <i class=\"fa-solid fa-book-quran\"></i>\n                </div>\n                <div class=\"space-y-4\">\n                    <span class=\"bg-emerald-800 text-emerald-200 text-xs font-semibold px-3 py-1 rounded-full uppercase tracking-wider border border-emerald-700\">\n                        İlahi Müjde (Tevbe Suresi / Benzeri Ayetler Bağlamı)\n                    </span>\n                    <p class=\"arabic-text text-2xl md:text-3xl text-emerald-100 text-right leading-loose\">\n                        \"...Tasalanma! Allah bizimle beraberdir...\"\n                    </p>\n                    <p class=\"text-sm text-emerald-200 italic border-l-2 border-emerald-500 pl-4\">\n                        Hz. Muhammed'in (sav) Sevr Mağarası'nda telaşlanan Hz. Ebubekir'e söylediği kutlu söz ve Kur'an'da övülen muhacirlerin durumu.\n                    </p>\n                </div>\n            </div>\n\n            <!-- Hadis Kutusu -->\n            <div class=\"bg-teal-900 text-white p-6 md:p-8 rounded-3xl shadow-xl flex flex-col justify-between space-y-6 relative overflow-hidden\">\n                <div class=\"absolute right-[-20px] bottom-[-20px] text-white/5 text-9xl font-bold pointer-events-none\">\n                    <i class=\"fa-solid fa-comment-dots\"></i>\n                </div>\n                <div class=\"space-y-4\">\n                    <span class=\"bg-teal-800 text-teal-200 text-xs font-semibold px-3 py-1 rounded-full uppercase tracking-wider border border-teal-700\">\n                        Bir Hadis Öğreniyorum (Buhârî, \"Temennî\", 9)\n                    </span>\n                    <p class=\"text-base md:text-lg text-teal-100 leading-relaxed font-medium\">\n                        \"Eğer hicret olmasaydı ben mutlaka ensardan biri olurdum. Eğer insanlar bir dere ya da dağ yoluna girseler, ben ensarın gittiği dere veya dağ yoluna girerdim.\"\n                    </p>\n                    <p class=\"text-xs text-teal-300 uppercase tracking-widest font-semibold\">\n                        Peygamber Efendimiz (sav)\n                    </p>\n                </div>\n            </div>\n\n        </div>\n\n        <!-- PÜF NOKTA VE SINIF İÇİ ETKİNLİK ÖZETİ -->\n        <section class=\"bg-amber-50 border border-amber-200/80 p-6 md:p-8 rounded-3xl shadow-sm flex flex-col md:flex-row items-center gap-6\">\n            <div class=\"bg-amber-500 text-white p-4 rounded-2xl text-2xl shrink-0\">\n                <i class=\"fa-solid fa-lightbulb\"></i>\n            </div>\n            <div class=\"space-y-2\">\n                <h3 class=\"text-lg font-bold text-amber-900\">💡 Unutmayalım! / Sınav İpucu</h3>\n                <p class=\"text-amber-800 text-sm md:text-base leading-relaxed\">\n                    Hicret; sadece bir yer değiştirme değil, İslam'ın yayılması, özgürlüğe kavuşulması ve Medine'de medeniyetin inşasıdır. Hz. Ali emanetleri teslim ederek sorumluluk ve görev bilincinin en güzel örneğini sergilemiştir. Ensar ve muhacir kardeşliği ise İslam toplumundaki yardımlaşma ve fedakârlığın zirvesidir.\n                </p>\n            </div>\n        </section>\n\n        <!-- FOOTER / BİLGİLENDİRME -->\n        <footer class=\"text-center text-slate-400 text-xs py-4\">\n            MEB Din Kültürü ve Ahlak Bilgisi • 7. Sınıf Peygamberimizin Hayatı Ders Kitabı Kaynak Metnine Sadık Kalınarak Hazırlanmıştır.\n        </footer>\n\n    </div>\n\n</body>\n</html>",
  "updatedAt": "2026-10-05T15:07:26.911Z"
}