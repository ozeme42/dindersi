{
  "htmlContent": "<!DOCTYPE html>\n<html lang=\"tr\" class=\"h-full bg-slate-50\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>İsra ve Miraç - Interaktif Ders Özeti</title>\n    <!-- Tailwind CSS CDN -->\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <!-- FontAwesome CDN -->\n    <link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css\" />\n    <!-- Google Fonts for Arabic & Modern Typography -->\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n    <link href=\"https://fonts.googleapis.com/css2?family=Amiri:ital,wght@0,400;0,700;1,400&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap\" rel=\"stylesheet\">\n    <script>\n        tailwind.config = {\n            theme: {\n                extend: {\n                    fontFamily: {\n                        sans: ['Plus Jakarta Sans', 'sans-serif'],\n                        arabic: ['Amiri', 'serif'],\n                    },\n                    colors: {\n                        meb: {\n                            50: '#f0fdf4',\n                            100: '#dcfce7',\n                            600: '#16a34a',\n                            700: '#15803d',\n                            800: '#166534',\n                            900: '#14532d',\n                        }\n                    }\n                }\n            }\n        }\n    </script>\n</head>\n<body class=\"font-sans antialiased text-slate-800 bg-slate-100 min-h-full flex flex-col justify-between\">\n\n    <!-- ÜST BİLGİ BARI (SMARTBOARD HEADER) -->\n    <header class=\"bg-emerald-900 text-white shadow-lg sticky top-0 z-50 border-b-4 border-amber-400\">\n        <div class=\"max-w-7xl mx-auto px-4 py-3 sm:px-6 lg:px-8 flex flex-wrap justify-between items-center gap-2\">\n            <div class=\"flex items-center space-x-3\">\n                <div class=\"bg-amber-400 text-emerald-950 p-2.5 rounded-xl font-extrabold text-xl flex items-center justify-center w-10 h-10 shadow\">\n                    <i class=\"fa-solid font-bold\">7</i>\n                </div>\n                <div>\n                    <span class=\"text-xs font-semibold uppercase tracking-widest text-emerald-300 block\">Peygamberimizin Hayatı • 1. Ünite</span>\n                    <h1 class=\"text-xl sm:text-2xl font-bold tracking-tight text-white flex items-center gap-2\">\n                        <span>1.3. İSRA VE MİRAÇ</span>\n                    </h1>\n                </div>\n            </div>\n            \n            <div class=\"flex items-center gap-2\">\n                <span class=\"bg-emerald-800/80 text-emerald-200 text-xs px-3 py-1.5 rounded-lg font-medium border border-emerald-700/50\">\n                    <i class=\"fa-solid text-amber-300 fa-book-open mr-1\"></i> MEB Ders Kitabı Birebir Uyumlu\n                </span>\n            </div>\n        </div>\n    </header>\n\n    <!-- ANA İÇERİK KONTEYNERİ -->\n    <main class=\"max-w-7xl mx-auto px-4 py-6 sm:px-6 lg:px-8 flex-grow w-full\">\n\n        <!-- AKILLI TAHTA TAB GEZİNTİSİ -->\n        <div class=\"flex flex-wrap gap-2 mb-6 bg-white p-2 rounded-2xl shadow-sm border border-slate-200\">\n            <button onclick=\"switchTab('tab-kavramlar')\" id=\"btn-tab-kavramlar\" class=\"tab-btn active-tab flex-1 min-w-[140px] py-3 px-4 rounded-xl font-bold text-sm sm:text-base transition-all duration-200 flex items-center justify-center gap-2 bg-emerald-700 text-white shadow-sm\">\n                <i class=\"fa-solid fa-key text-amber-300\"></i> Temel Kavramlar\n            </button>\n            <button onclick=\"switchTab('tab-nass')\" id=\"btn-tab-nass\" class=\"tab-btn flex-1 min-w-[140px] py-3 px-4 rounded-xl font-bold text-sm sm:text-base text-slate-600 hover:bg-slate-100 transition-all duration-200 flex items-center justify-center gap-2\">\n                <i class=\"fa-solid fa-book-quran text-emerald-600\"></i> Ayet ve Hadis\n            </button>\n            <button onclick=\"switchTab('tab-olay')\" id=\"btn-tab-olay\" class=\"tab-btn flex-1 min-w-[140px] py-3 px-4 rounded-xl font-bold text-sm sm:text-base text-slate-600 hover:bg-slate-100 transition-all duration-200 flex items-center justify-center gap-2\">\n                <i class=\"fa-solid fa-route text-emerald-600\"></i> Olayın Gelişimi\n            </button>\n            <button onclick=\"switchTab('tab-anlam')\" id=\"btn-tab-anlam\" class=\"tab-btn flex-1 min-w-[140px] py-3 px-4 rounded-xl font-bold text-sm sm:text-base text-slate-600 hover:bg-slate-100 transition-all duration-200 flex items-center justify-center gap-2\">\n                <i class=\"fa-solid fa-heart-pulse text-emerald-600\"></i> Önemi ve Mesajı\n            </button>\n            <button onclick=\"switchTab('tab-etkilesim')\" id=\"btn-tab-etkilesim\" class=\"tab-btn flex-1 min-w-[140px] py-3 px-4 rounded-xl font-bold text-sm sm:text-base text-slate-600 hover:bg-slate-100 transition-all duration-200 flex items-center justify-center gap-2\">\n                <i class=\"fa-solid fa-gamepad text-emerald-600\"></i> Bilmece ve Etkinlik\n            </button>\n        </div>\n\n        <!-- SEKMELERİN İÇERİKLERİ -->\n\n        <!-- TAB 1: KAVRAMLAR -->\n        <div id=\"tab-kavramlar\" class=\"tab-content block space-y-6\">\n            <div class=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n                <!-- İSRA KARTI -->\n                <div class=\"bg-white rounded-3xl p-6 shadow-sm border border-emerald-100 hover:shadow-md transition flex flex-col justify-between\">\n                    <div>\n                        <div class=\"flex items-center justify-between mb-4\">\n                            <span class=\"bg-emerald-100 text-emerald-800 font-extrabold text-xs px-3 py-1 rounded-full uppercase tracking-wider\">Kavram 1</span>\n                            <span class=\"text-xs text-slate-500 font-medium\">Lügat: Gece Yürüyüşü</span>\n                        </div>\n                        <h2 class=\"text-2xl font-extrabold text-emerald-950 mb-3 flex items-center gap-2\">\n                            <i class=\"fa-solid fa-moon text-amber-500\"></i> İSRA\n                        </h2>\n                        <p class=\"text-slate-700 leading-relaxed text-lg\">\n                            Hz. Muhammed’in (sav) Mekke’de bulunan <strong class=\"text-emerald-900 font-bold\">Mescid-i Haram’dan</strong> Kudüs’teki <strong class=\"text-emerald-900 font-bold\">Mescid-i Aksa’ya</strong> Allah’ın (cc) izniyle götürülmesi olayıdır.\n                        </p>\n                    </div>\n                    <div class=\"mt-6 pt-4 border-t border-slate-100 flex items-center gap-3 text-sm text-slate-500\">\n                        <i class=\"fa-solid fa-map-marker-alt text-emerald-600 text-lg\"></i>\n                        <span>Mekke (Mescid-i Haram) ➔ Kudüs (Mescid-i Aksa)</span>\n                    </div>\n                </div>\n\n                <!-- MİRAÇ KARTI -->\n                <div class=\"bg-white rounded-3xl p-6 shadow-sm border border-emerald-100 hover:shadow-md transition flex flex-col justify-between\">\n                    <div>\n                        <div class=\"flex items-center justify-between mb-4\">\n                            <span class=\"bg-amber-100 text-amber-800 font-extrabold text-xs px-3 py-1 rounded-full uppercase tracking-wider\">Kavram 2</span>\n                            <span class=\"text-xs text-slate-500 font-medium\">Lügat: Göğe Çıkma, Yükselme</span>\n                        </div>\n                        <h2 class=\"text-2xl font-extrabold text-emerald-950 mb-3 flex items-center gap-2\">\n                            <i class=\"fa-solid fa-angles-up text-amber-500\"></i> MİRAÇ\n                        </h2>\n                        <p class=\"text-slate-700 leading-relaxed text-lg\">\n                            İsra olayının gerçekleştiği <strong class=\"text-emerald-900 font-bold\">Recep ayının 27. gecesinde</strong>, Hz. Muhammed’in (sav) Mescid-i Aksa’dan göklere yükseltilerek kendisine Allah’ın (cc) ayetlerinin ve olağanüstü nimetlerinin gösterilmesi olayıdır.\n                        </p>\n                    </div>\n                    <div class=\"mt-6 pt-4 border-t border-slate-100 flex items-center gap-3 text-sm text-slate-500\">\n                        <i class=\"fa-solid fa-calendar-alt text-emerald-600 text-lg\"></i>\n                        <span>Zaman: Recep Ayının 27. Gecesi</span>\n                    </div>\n                </div>\n            </div>\n\n            <!-- MEKÂN BİLGİ KUTUSU -->\n            <div class=\"bg-gradient-to-r from-emerald-900 to-teal-800 rounded-3xl p-6 text-white shadow-md flex flex-col sm:flex-row items-center gap-6\">\n                <div class=\"bg-white/10 p-4 rounded-2xl text-amber-300 text-3xl sm:text-4xl text-center shrink-0\">\n                    <i class=\"fa-solid fa-mosque\"></i>\n                </div>\n                <div>\n                    <h3 class=\"font-bold text-lg text-amber-300 mb-1\">Mescid-i Aksa ve Mescid-i Haram Bağlantısı</h3>\n                    <p class=\"text-emerald-100 text-sm sm:text-base leading-relaxed\">\n                        İsra ve Miraç, Mekke'deki Mescid-i Haram ile Kudüs'teki Mescid-i Aksa arasında gerçekleşmiş mucizelerdir. İsra olayının Mescid-i Aksa’da noktalanması, Müslümanlar ile önceki peygamberlerin ümmetleri arasındaki ortak bağa işaret eder.\n                    </p>\n                </div>\n            </div>\n        </div>\n\n        <!-- TAB 2: AYET VE HADİS -->\n        <div id=\"tab-nass\" class=\"tab-content hidden space-y-6\">\n            <!-- AYET KUTUSU -->\n            <div class=\"bg-white rounded-3xl p-6 sm:p-8 shadow-sm border border-emerald-200\">\n                <div class=\"flex items-center gap-3 mb-4\">\n                    <span class=\"bg-emerald-700 text-white p-2 rounded-xl text-lg\"><i class=\"fa-solid fa-quran\"></i></span>\n                    <div>\n                        <h3 class=\"font-bold text-lg text-emerald-950\">İsra Suresi, 1. Ayet</h3>\n                        <span class=\"text-xs text-slate-500\">Kur'an-ı Kerim'de İsra Mucizesi</span>\n                    </div>\n                </div>\n\n                <!-- ARAPÇA YAZI -->\n                <div class=\"bg-emerald-50/60 p-6 rounded-2xl border border-emerald-100 text-right mb-4\">\n                    <p class=\"font-arabic text-2xl sm:text-3xl text-emerald-950 leading-loose\">\n                        سُبْحَانَ الَّذِي أَسْرَىٰ بِعَبْدِهِ لَيْلًا مِّنَ الْمَسْجِدِ الْحَرَامِ إِلَى الْمَسْجِدِ الْأَقْصَى الَّذِي بَارَكْنَا حَوْلَهُ لِنُرِيَهُ مِنْ آيَاتِنَا ۚ إِنَّهُ هُوَ السَّمِيعُ الْبَصِيرُ\n                    </p>\n                </div>\n\n                <!-- TÜRKÇE MEAL -->\n                <div class=\"bg-slate-50 p-5 rounded-2xl border-l-4 border-emerald-600 text-slate-800 text-base sm:text-lg italic leading-relaxed\">\n                    \"Bir gece, kendisine bazı ayetlerimizi gösterelim diye kulunu Mescid-i Haram’dan çevresini mübarek kıldığımız Mescid-i Aksa’ya götüren Allah eksikliklerden münezzehtir. O, gerçekten her şeyi işitmekte ve görmektedir.\"\n                </div>\n            </div>\n\n            <!-- HADİS KUTUSU (MİRAÇ HEDİYELERİ) -->\n            <div class=\"bg-white rounded-3xl p-6 sm:p-8 shadow-sm border border-amber-200\">\n                <div class=\"flex items-center justify-between mb-4\">\n                    <div class=\"flex items-center gap-3\">\n                        <span class=\"bg-amber-500 text-white p-2 rounded-xl text-lg\"><i class=\"fa-solid fa-gift\"></i></span>\n                        <div>\n                            <h3 class=\"font-bold text-lg text-slate-900\">Bir Hadis Öğreniyorum: Miraç Hediyeleri</h3>\n                            <span class=\"text-xs text-slate-500\">Kaynak: Müslim, \"İman\", 279</span>\n                        </div>\n                    </div>\n                </div>\n\n                <blockquote class=\"text-slate-700 text-base sm:text-lg mb-6 leading-relaxed\">\n                    \"Miraç olayı gerçekleştiğinde Hz. Peygamber’e üç şey verilmiştir:\"\n                </blockquote>\n\n                <div class=\"grid grid-cols-1 md:grid-cols-3 gap-4\">\n                    <div class=\"bg-amber-50 p-4 rounded-2xl border border-amber-200 text-center flex flex-col items-center justify-center\">\n                        <div class=\"w-10 h-10 bg-amber-500 text-white rounded-full flex items-center justify-center font-bold text-lg mb-2\">1</div>\n                        <h4 class=\"font-extrabold text-amber-950 mb-1\">Beş Vakit Namaz</h4>\n                        <p class=\"text-xs text-amber-800\">Dinin direği kabul edilen namaz ibadeti emredilmiştir.</p>\n                    </div>\n\n                    <div class=\"bg-amber-50 p-4 rounded-2xl border border-amber-200 text-center flex flex-col items-center justify-center\">\n                        <div class=\"w-10 h-10 bg-amber-500 text-white rounded-full flex items-center justify-center font-bold text-lg mb-2\">2</div>\n                        <h4 class=\"font-extrabold text-amber-950 mb-1\">Amenerresulü</h4>\n                        <p class=\"text-xs text-amber-800\">Bakara suresinin son iki ayeti hediye edilmiştir.</p>\n                    </div>\n\n                    <div class=\"bg-amber-50 p-4 rounded-2xl border border-amber-200 text-center flex flex-col items-center justify-center\">\n                        <div class=\"w-10 h-10 bg-amber-500 text-white rounded-full flex items-center justify-center font-bold text-lg mb-2\">3</div>\n                        <h4 class=\"font-extrabold text-amber-950 mb-1\">Bağışlanma Müjdesi</h4>\n                        <p class=\"text-xs text-amber-800\">Allah'a şirk koşmadan ölenlerin günahlarının bağışlanacağı müjdesi.</p>\n                    </div>\n                </div>\n            </div>\n        </div>\n\n        <!-- TAB 3: OLAYIN GELİŞİMİ VE MÜŞRİKLER -->\n        <div id=\"tab-olay\" class=\"tab-content hidden space-y-6\">\n            <div class=\"bg-white rounded-3xl p-6 sm:p-8 shadow-sm border border-slate-200 space-y-6\">\n                <h3 class=\"text-xl font-extrabold text-emerald-950 flex items-center gap-2 border-b pb-3\">\n                    <i class=\"fa-solid fa-comments text-emerald-600\"></i>\n                    Mucize Sonrası Mekke'de Yaşananlar\n                </h3>\n\n                <div class=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n                    <div class=\"bg-emerald-50 p-5 rounded-2xl border border-emerald-200\">\n                        <h4 class=\"font-bold text-emerald-900 text-lg mb-2 flex items-center gap-2\">\n                            <i class=\"fa-solid fa-circle-check text-emerald-600\"></i> Müslümanların Tutumu\n                        </h4>\n                        <p class=\"text-slate-700 text-sm leading-relaxed\">\n                            Peygamber Efendimiz (sav), yaşadıklarını sabah Mekkelilere anlattığında Mekkeli Müslümanlar tereddüt etmeden Peygamber Efendimiz'i <strong>tasdik ettiler</strong>.\n                        </p>\n                    </div>\n\n                    <div class=\"bg-rose-50 p-5 rounded-2xl border border-rose-200\">\n                        <h4 class=\"font-bold text-rose-900 text-lg mb-2 flex items-center gap-2\">\n                            <i class=\"fa-solid fa-circle-xmark text-rose-600\"></i> Müşriklerin Tutumu\n                        </h4>\n                        <p class=\"text-slate-700 text-sm leading-relaxed\">\n                            Müşrikler ise inkâr ettiler. Bir gecede Kudüs’e gidip gelmenin imkânsız olduğunu iddia ettiler ve Peygamberimizi sınamak istediler.\n                        </p>\n                    </div>\n                </div>\n\n                <!-- MÜŞRİKLERİN SORULARI VE CEVAP -->\n                <div class=\"bg-slate-50 p-6 rounded-2xl border border-slate-200 space-y-4\">\n                    <h4 class=\"font-bold text-slate-900 text-base flex items-center gap-2\">\n                        <i class=\"fa-solid fa-circle-question text-amber-500\"></i>\n                        Müşriklerin Mescid-i Aksa İmtihanı ve Hz. Peygamber'in Yanıtı\n                    </h4>\n                    <p class=\"text-slate-700 text-sm leading-relaxed\">\n                        Müşriklerden daha önce Kudüs’e gitmiş ve Mescid-i Aksa’yı görmüş olanlar: <em>\"Mescid-i Aksa’nın kaç kapısı var? Şurası nasıl, burasında ne var?\"</em> gibi detaylı sorular sordular.\n                    </p>\n\n                    <div class=\"bg-white p-4 rounded-xl border-l-4 border-amber-400 text-slate-800 text-sm sm:text-base italic\">\n                        <strong>Hz. Muhammed (sav) bu durum hakkında şöyle buyurmuştur:</strong><br>\n                        \"Kureyşliler seyahat ettiğim yerler, özellikle Mescid-i Aksa ile ilgili öyle sorular sordular ki, İsra Gecesi bunlara hiç dikkat etmemiştim. Fakat Cenab-ı Hak, benimle Beytülmakdis (Mescid-i Aksa) arasındaki mesafeyi kaldırdı. Ne sordularsa, oraya bakarak cevap verdim.\"\n                    </div>\n                </div>\n            </div>\n        </div>\n\n        <!-- TAB 4: HİKMETİ VE ANLAMI -->\n        <div id=\"tab-anlam\" class=\"tab-content hidden space-y-6\">\n            <div class=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n                <!-- MORAL VE DESTEK -->\n                <div class=\"bg-white p-6 rounded-3xl shadow-sm border border-slate-200\">\n                    <div class=\"w-12 h-12 bg-emerald-100 text-emerald-800 rounded-2xl flex items-center justify-center text-xl font-bold mb-4\">\n                        <i class=\"fa-solid fa-hand-holding-heart\"></i>\n                    </div>\n                    <h3 class=\"font-extrabold text-lg text-emerald-950 mb-2\">Hüzün Yılı ve Manevi Destek</h3>\n                    <p class=\"text-slate-600 text-sm leading-relaxed\">\n                        İsra ve Miraç mucizesi, <strong class=\"text-emerald-900\">Hüzün Yılı ve Taif’te yaşanan zorluklardan sonra</strong> Hz. Muhammed’e (sav) büyük bir moral ve manevi destek olmuştur. Mekkeli müşriklerin eziyetlerine karşı Allah (cc), bu olayla kulunu şereflendirmiş; Müslümanların da Allah'ın lütfunu hissederek bağlılıklarını artırmıştır.\n                    </p>\n                </div>\n\n                <!-- ORTAK BAĞ VE TEVHİD MESAJI -->\n                <div class=\"bg-white p-6 rounded-3xl shadow-sm border border-slate-200\">\n                    <div class=\"w-12 h-12 bg-teal-100 text-teal-800 rounded-2xl flex items-center justify-center text-xl font-bold mb-4\">\n                        <i class=\"fa-solid fa-link\"></i>\n                    </div>\n                    <h3 class=\"font-extrabold text-lg text-emerald-950 mb-2\">Peygamberler Arası Ortak Bağ</h3>\n                    <p class=\"text-slate-600 text-sm leading-relaxed\">\n                        İsra olayının Mescid-i Haram’dan başlayıp Kudüs’te Mescid-i Aksa’da noktalanması, <strong class=\"text-emerald-900\">Müslümanlar ile önceki peygamberlerin ümmetleri arasındaki ortak bağa</strong> işaret eder. Bu durum, Allah’ın (cc) tüm insanlığa aynı kaynaktan mesajlar gönderdiğini hatırlatır.\n                    </p>\n                </div>\n            </div>\n\n            <!-- MİRAÇ KANDİLİ İHYASI -->\n            <div class=\"bg-amber-50 border border-amber-200 p-6 rounded-3xl flex flex-col sm:flex-row items-center gap-4\">\n                <div class=\"text-amber-600 text-4xl shrink-0\">\n                    <i class=\"fa-solid fa-star-and-crescent\"></i>\n                </div>\n                <div>\n                    <h4 class=\"font-extrabold text-amber-950 text-base mb-1\">Görsel / Kültürel Not: Miraç Kandili</h4>\n                    <p class=\"text-amber-900 text-sm leading-relaxed\">\n                        Müslümanlar, isra ve miraç mucizelerinin gerçekleştiği geceyi her yıl <strong>Miraç Kandili</strong> olarak kutlar. Kandil gecelerinde Müslümanlar ibadetlerini camilerde yapmaya özel bir özen gösterirler.\n                    </p>\n                </div>\n            </div>\n\n            <!-- AKILDA KALICI PÜF NOKTA -->\n            <div class=\"bg-slate-900 text-white p-6 rounded-3xl shadow-md border-l-8 border-amber-400 flex items-start gap-4\">\n                <div class=\"text-amber-400 text-2xl shrink-0 mt-1\">\n                    <i class=\"fa-solid fa-lightbulb\"></i>\n                </div>\n                <div>\n                    <h4 class=\"font-bold text-amber-400 text-base mb-1\">💡 Unutmayalım! (Sınav İpucu)</h4>\n                    <p class=\"text-slate-300 text-sm leading-relaxed\">\n                        İsra ve Miraç, Allah'ın kudretini ve Hz. Peygamber'e manevi desteğini gösterir. Bu gecede hediye edilen <strong>5 vakit namaz</strong>, müminin miracı olarak kabul edilir. Ayrıca Bakara suresinin son iki ayeti (Amenerresulü) ve şirk koşmayanların bağışlanacağı müjdesi bu mucizede verilmiştir.\n                    </p>\n                </div>\n            </div>\n        </div>\n\n        <!-- TAB 5: ETKİLEŞİMLİ ALAN (BİLMECE & KONTROL NOKTASI) -->\n        <div id=\"tab-etkilesim\" class=\"tab-content hidden space-y-6\">\n            <div class=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n                <!-- BİLMECE KÖŞESİ (KİTAPTAKİ BİLMECE) -->\n                <div class=\"bg-gradient-to-br from-amber-50 to-amber-100/60 p-6 rounded-3xl border border-amber-200 shadow-sm flex flex-col justify-between\">\n                    <div>\n                        <div class=\"flex items-center gap-2 text-amber-800 font-extrabold text-sm mb-4\">\n                            <i class=\"fa-solid fa-puzzle-piece text-amber-600\"></i> BİLMECE KÖŞESİ\n                        </div>\n                        <div class=\"bg-white/80 p-5 rounded-2xl border border-amber-200 text-amber-950 font-serif text-lg leading-relaxed mb-4 italic text-center\">\n                            \"Hüzün yılındaydı,<br>\n                            Yedi kat göğü aştı,<br>\n                            En yüksek makama ulaştı,<br>\n                            Hediyesi namazdı.\"\n                        </div>\n                    </div>\n                    \n                    <div class=\"text-center\">\n                        <div id=\"bilmece-cevap\" class=\"hidden bg-emerald-700 text-white font-bold text-xl py-3 px-6 rounded-2xl shadow-inner mb-3 transition-all duration-300\">\n                            Cevap: İsra ve Miraç\n                        </div>\n                        <button onclick=\"toggleBilmece()\" id=\"bilmece-btn\" class=\"w-full bg-amber-500 hover:bg-amber-600 text-white font-bold py-3 px-4 rounded-2xl transition duration-200 shadow\">\n                            Cevabı Göster / Gizle\n                        </button>\n                    </div>\n                </div>\n\n                <!-- ÖZ DEĞERLENDİRME CHECKLIST -->\n                <div class=\"bg-white p-6 rounded-3xl border border-slate-200 shadow-sm space-y-4\">\n                    <h3 class=\"font-extrabold text-emerald-950 text-base flex items-center gap-2\">\n                        <i class=\"fa-solid fa-list-check text-emerald-600\"></i> Kendini Kontrol Et (Öz Değerlendirme)\n                    </h3>\n                    <p class=\"text-xs text-slate-500\">Öğrendiklerinizi kontrol etmek için kutucuklara tıklayınız:</p>\n\n                    <div class=\"space-y-3\">\n                        <label class=\"flex items-start gap-3 p-3 rounded-xl bg-slate-50 hover:bg-emerald-50 cursor-pointer transition border border-slate-100\">\n                            <input type=\"checkbox\" class=\"mt-1 w-5 h-5 text-emerald-600 rounded border-slate-300 focus:ring-emerald-500\">\n                            <span class=\"text-sm text-slate-700 font-medium\">İsra ve Miraç kavramlarının anlamlarını açıklayabilirim.</span>\n                        </label>\n\n                        <label class=\"flex items-start gap-3 p-3 rounded-xl bg-slate-50 hover:bg-emerald-50 cursor-pointer transition border border-slate-100\">\n                            <input type=\"checkbox\" class=\"mt-1 w-5 h-5 text-emerald-600 rounded border-slate-300 focus:ring-emerald-500\">\n                            <span class=\"text-sm text-slate-700 font-medium\">Miraç gecesinde Peygamberimize verilen üç hediyeyi sayabilirim.</span>\n                        </label>\n\n                        <label class=\"flex items-start gap-3 p-3 rounded-xl bg-slate-50 hover:bg-emerald-50 cursor-pointer transition border border-slate-100\">\n                            <input type=\"checkbox\" class=\"mt-1 w-5 h-5 text-emerald-600 rounded border-slate-300 focus:ring-emerald-500\">\n                            <span class=\"text-sm text-slate-700 font-medium\">Bu mucizenin Hüzün Yılı sonrası Peygamberimiz için ne anlam ifade ettiğini bilirim.</span>\n                        </label>\n                    </div>\n                </div>\n            </div>\n        </div>\n\n    </main>\n\n    <!-- ALT BİLGİ (FOOTER) -->\n    <footer class=\"bg-slate-800 text-slate-400 text-center py-4 text-xs border-t border-slate-700 mt-6\">\n        <div class=\"max-w-7xl mx-auto px-4 flex flex-col sm:flex-row justify-between items-center gap-2\">\n            <span>Milli Eğitim Bakanlığı (MEB) 7. Sınıf Peygamberimizin Hayatı Müfredatı</span>\n            <span>Akıllı Tahta İntaktik Özet Tasarımı</span>\n        </div>\n    </footer>\n\n    <!-- INTERACTIVE JAVASCRIPT LOGIC -->\n    <script>\n        function switchTab(tabId) {\n            // Hide all contents\n            const contents = document.querySelectorAll('.tab-content');\n            contents.forEach(content => content.classList.add('hidden'));\n\n            // Reset active states on buttons\n            const buttons = document.querySelectorAll('.tab-btn');\n            buttons.forEach(btn => {\n                btn.classList.remove('bg-emerald-700', 'text-white', 'shadow-sm');\n                btn.classList.add('text-slate-600', 'hover:bg-slate-100');\n            });\n\n            // Show selected content\n            document.getElementById(tabId).classList.remove('hidden');\n\n            // Set active state on clicked tab button\n            const activeBtn = document.getElementById('btn-' + tabId);\n            activeBtn.classList.remove('text-slate-600', 'hover:bg-slate-100');\n            activeBtn.classList.add('bg-emerald-700', 'text-white', 'shadow-sm');\n        }\n\n        function toggleBilmece() {\n            const cevap = document.getElementById('bilmece-cevap');\n            if (cevap.classList.contains('hidden')) {\n                cevap.classList.remove('hidden');\n            } else {\n                cevap.classList.add('hidden');\n            }\n        }\n    </script>\n</body>\n</html>",
