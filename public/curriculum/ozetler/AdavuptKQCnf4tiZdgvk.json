{
  "htmlContent": "<!DOCTYPE html>\n<html lang=\"tr\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>6. Sınıf Temel Dini Bilgiler - İman ve İslam</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css\">\n    <style>\n        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');\n        body {\n            font-family: 'Plus Jakarta Sans', sans-serif;\n            background-color: #f8fafc;\n        }\n        .tab-btn.active {\n            background-color: #059669;\n            color: #ffffff;\n            box-shadow: 0 4px 12px rgba(5, 150, 105, 0.25);\n        }\n        .glass-card {\n            background: rgba(255, 255, 255, 0.9);\n            backdrop-filter: blur(10px);\n            border: 1px solid rgba(226, 232, 240, 0.8);\n        }\n    </style>\n</head>\n<body class=\"text-slate-800 antialiased min-h-screen pb-12\">\n\n    <!-- ÜST BİLGİ VE BAŞLIK BAR (Akıllı Tahta Uyumlu) -->\n    <header class=\"bg-emerald-800 text-white shadow-lg sticky top-0 z-50\">\n        <div class=\"max-w-7xl mx-auto px-4 py-4 sm:px-6 lg:px-8\">\n            <div class=\"flex flex-col md:flex-row md:items-center md:justify-between gap-4\">\n                <div class=\"flex items-center space-x-3\">\n                    <div class=\"bg-emerald-700 p-3 rounded-2xl flex items-center justify-center shadow-inner\">\n                        <i class=\"fa-solid fa-book-quran text-2xl text-amber-300\"></i>\n                    </div>\n                    <div>\n                        <div class=\"flex items-center space-x-2 text-xs font-semibold text-emerald-200 uppercase tracking-wider\">\n                            <span>6. Sınıf</span>\n                            <span>•</span>\n                            <span>Temel Dini Bilgiler 1</span>\n                            <span>•</span>\n                            <span>1. Ünite</span>\n                        </div>\n                        <h1 class=\"text-2xl font-extrabold tracking-tight text-white\">İMAN VE İSLAM</h1>\n                    </div>\n                </div>\n                <!-- Kısaltmalar Bilgilendirme Kutusu -->\n                <div class=\"flex flex-wrap gap-2 text-xs bg-emerald-900/60 p-2.5 rounded-xl border border-emerald-700/50\">\n                    <span class=\"text-amber-200 font-semibold\">(cc):</span> Celle celalüh | \n                    <span class=\"text-amber-200 font-semibold\">(sav):</span> Sallallahü aleyhi vesellem | \n                    <span class=\"text-amber-200 font-semibold\">(as):</span> Aleyhisselam\n                </div>\n            </div>\n        </div>\n    </header>\n\n    <!-- ANA İÇERİK KONTROL PANELİ -->\n    <main class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-6\">\n\n        <!-- İNTERAKTİF SEÇME MENÜSÜ -->\n        <div class=\"grid grid-cols-2 md:grid-cols-5 gap-3 mb-8\">\n            <button onclick=\"switchTab('tab-kavramlar')\" id=\"btn-tab-kavramlar\" class=\"tab-btn active p-3.5 rounded-2xl text-sm font-bold flex items-center justify-center space-x-2 transition-all duration-200 border border-slate-200\">\n                <i class=\"fa-solid fa-key\"></i>\n                <span>Temel Kavramlar</span>\n            </button>\n            <button onclick=\"switchTab('tab-fitrat')\" id=\"btn-tab-fitrat\" class=\"tab-btn p-3.5 rounded-2xl text-sm font-bold flex items-center justify-center space-x-2 transition-all duration-200 border border-slate-200 bg-white text-slate-700 hover:bg-slate-100\">\n                <i class=\"fa-solid fa-heart-pulse\"></i>\n                <span>İhtiyaçlar & Fıtrat</span>\n            </button>\n            <button onclick=\"switchTab('tab-iliski')\" id=\"btn-tab-iliski\" class=\"tab-btn p-3.5 rounded-2xl text-sm font-bold flex items-center justify-center space-x-2 transition-all duration-200 border border-slate-200 bg-white text-slate-700 hover:bg-slate-100\">\n                <i class=\"fa-solid fa-link\"></i>\n                <span>İman - İslam Bağı</span>\n            </button>\n            <button onclick=\"switchTab('tab-hadis')\" id=\"btn-tab-hadis\" class=\"tab-btn p-3.5 rounded-2xl text-sm font-bold flex items-center justify-center space-x-2 transition-all duration-200 border border-slate-200 bg-white text-slate-700 hover:bg-slate-100\">\n                <i class=\"fa-solid fa-scroll\"></i>\n                <span>Cibril Hadisi</span>\n            </button>\n            <button onclick=\"switchTab('tab-etkinlik')\" id=\"btn-tab-etkinlik\" class=\"tab-btn p-3.5 rounded-2xl text-sm font-bold flex items-center justify-center space-x-2 transition-all duration-200 border border-slate-200 bg-amber-50 text-amber-900 hover:bg-amber-100\">\n                <i class=\"fa-solid fa-pen-to-square\"></i>\n                <span>İnteraktif Etkinlik</span>\n            </button>\n        </div>\n\n        <!-- 1. SEKME: TEMEL KAVRAMLAR -->\n        <section id=\"tab-kavramlar\" class=\"tab-content block space-y-6\">\n            <div class=\"grid md:grid-cols-2 gap-6\">\n                <!-- İman Kartı -->\n                <div class=\"glass-card rounded-3xl p-6 shadow-sm hover:shadow-md transition-shadow border-l-8 border-emerald-600\">\n                    <div class=\"flex items-center justify-between mb-4\">\n                        <span class=\"bg-emerald-100 text-emerald-800 text-xs font-bold px-3 py-1 rounded-full uppercase\">Kavram 1</span>\n                        <i class=\"fa-solid fa-shield-halved text-emerald-600 text-2xl\"></i>\n                    </div>\n                    <h2 class=\"text-2xl font-bold text-slate-900 mb-3\">İMAN</h2>\n                    <div class=\"space-y-3\">\n                        <div class=\"bg-slate-50 p-3.5 rounded-xl\">\n                            <h3 class=\"text-xs font-bold text-slate-500 uppercase\">Sözlük Anlamı:</h3>\n                            <p class=\"text-slate-700 font-medium\">İnanma, tasdik etme, güvende olma, güven verme.</p>\n                        </div>\n                        <div class=\"bg-emerald-50/50 p-3.5 rounded-xl border border-emerald-100\">\n                            <h3 class=\"text-xs font-bold text-emerald-700 uppercase\">Dinî Terim Anlamı:</h3>\n                            <p class=\"text-emerald-950 font-semibold\">Hz. Muhammed’in (sav) Allah’tan (cc) getirdiği ve insanlara haber verdiği bütün bilgilerin doğru olduğuna <span class=\"underline decoration-emerald-500 font-bold\">gönülden inanmaktır.</span></p>\n                        </div>\n                        <div class=\"bg-emerald-600 text-white p-3 rounded-xl flex items-center justify-between\">\n                            <span class=\"text-sm font-medium\">İman eden kişiye ne denir?</span>\n                            <span class=\"font-extrabold text-amber-300 text-lg\">MÜMİN</span>\n                        </div>\n                    </div>\n                </div>\n\n                <!-- İslam Kartı -->\n                <div class=\"glass-card rounded-3xl p-6 shadow-sm hover:shadow-md transition-shadow border-l-8 border-teal-600\">\n                    <div class=\"flex items-center justify-between mb-4\">\n                        <span class=\"bg-teal-100 text-teal-800 text-xs font-bold px-3 py-1 rounded-full uppercase\">Kavram 2</span>\n                        <i class=\"fa-solid fa-hand-holding-heart text-teal-600 text-2xl\"></i>\n                    </div>\n                    <h2 class=\"text-2xl font-bold text-slate-900 mb-3\">İSLAM</h2>\n                    <div class=\"space-y-3\">\n                        <div class=\"bg-slate-50 p-3.5 rounded-xl\">\n                            <h3 class=\"text-xs font-bold text-slate-500 uppercase\">Sözlük Anlamı:</h3>\n                            <p class=\"text-slate-700 font-medium\">Kurtuluşa erme, emniyette olma, itaat ve teslimiyet gösterme.</p>\n                        </div>\n                        <div class=\"bg-teal-50/50 p-3.5 rounded-xl border border-teal-100\">\n                            <h3 class=\"text-xs font-bold text-teal-700 uppercase\">Dinî Terim Anlamı:</h3>\n                            <p class=\"text-teal-950 font-semibold\">Allah’a (cc) itaat etmek ve Hz. Muhammed’in (sav) din adına bildirdiklerini <span class=\"underline decoration-teal-500 font-bold\">kalp ile onaylayıp dil ile söylemektir.</span> İnandıklarını sözleriyle ifade etmek, davranışlarıyla yaşadığını göstermektir.</p>\n                        </div>\n                        <div class=\"bg-teal-700 text-white p-3 rounded-xl flex items-center justify-between\">\n                            <span class=\"text-sm font-medium\">İslam’ı kabul eden kişiye ne denir?</span>\n                            <span class=\"font-extrabold text-amber-300 text-lg\">MÜSLÜMAN</span>\n                        </div>\n                    </div>\n                </div>\n            </div>\n\n            <!-- AYET KUTULARI -->\n            <div class=\"bg-gradient-to-r from-amber-500/10 via-emerald-500/10 to-teal-500/10 p-6 rounded-3xl border border-amber-200/60 shadow-sm\">\n                <div class=\"flex items-center space-x-3 mb-4\">\n                    <div class=\"bg-amber-500 text-white p-2 rounded-xl\">\n                        <i class=\"fa-solid fa-book-open\"></i>\n                    </div>\n                    <h3 class=\"text-lg font-bold text-slate-900\">Kur'an-ı Kerim'den Ayetler</h3>\n                </div>\n                <div class=\"grid md:grid-cols-2 gap-4\">\n                    <div class=\"bg-white p-4 rounded-2xl shadow-sm border border-slate-100\">\n                        <p class=\"text-emerald-950 font-bold text-lg mb-2\">“Şüphesiz Allah katında din İslam’dır…”</p>\n                        <span class=\"text-xs font-semibold text-slate-500\">(Âl-i İmran suresi, 19. ayet)</span>\n                    </div>\n                    <div class=\"bg-white p-4 rounded-2xl shadow-sm border border-slate-100\">\n                        <p class=\"text-emerald-950 font-bold text-lg mb-2\">“… Sizin için din olarak İslam’ı seçtim...”</p>\n                        <span class=\"text-xs font-semibold text-slate-500\">(Maide suresi, 3. ayet)</span>\n                    </div>\n                </div>\n                <p class=\"mt-3 text-xs text-slate-600 italic font-medium\">* İslam, Allah (cc) tarafından insanlar için seçilmiş dindir ve Hz. Âdem’den (as) Hz. Muhammed’e (sav) kadar tüm peygamberlere gönderilen dinin ortak adıdır.</p>\n            </div>\n        </section>\n\n        <!-- 2. SEKME: İHTİYAÇLAR & FITRAT -->\n        <section id=\"tab-fitrat\" class=\"tab-content hidden space-y-6\">\n            <div class=\"grid md:grid-cols-3 gap-6\">\n                <!-- Bedensel İhtiyaçlar -->\n                <div class=\"glass-card rounded-3xl p-6 border-t-4 border-amber-500\">\n                    <div class=\"w-12 h-12 bg-amber-100 text-amber-600 rounded-2xl flex items-center justify-center mb-4 text-xl\">\n                        <i class=\"fa-solid fa-utensils\"></i>\n                    </div>\n                    <h3 class=\"text-lg font-bold text-slate-900 mb-2\">Bedensel İhtiyaçlar</h3>\n                    <p class=\"text-sm text-slate-600 leading-relaxed mb-4\">İnsanın fiziksel varlığını sürdürmesi için gerekli olan ihtiyaçlardır.</p>\n                    <ul class=\"space-y-2 text-sm font-semibold text-slate-700\">\n                        <li class=\"flex items-center space-x-2\"><i class=\"fa-solid fa-check text-amber-500\"></i><span>Yemek yemek</span></li>\n                        <li class=\"flex items-center space-x-2\"><i class=\"fa-solid fa-check text-amber-500\"></i><span>Su içmek</span></li>\n                        <li class=\"flex items-center space-x-2\"><i class=\"fa-solid fa-check text-amber-500\"></i><span>Uyumak</span></li>\n                        <li class=\"flex items-center space-x-2\"><i class=\"fa-solid fa-check text-amber-500\"></i><span>Yorulunca dinlenmek</span></li>\n                    </ul>\n                </div>\n\n                <!-- Ruhsal İhtiyaç: İman -->\n                <div class=\"glass-card rounded-3xl p-6 border-t-4 border-emerald-500\">\n                    <div class=\"w-12 h-12 bg-emerald-100 text-emerald-600 rounded-2xl flex items-center justify-center mb-4 text-xl\">\n                        <i class=\"fa-solid fa-brain\"></i>\n                    </div>\n                    <h3 class=\"text-lg font-bold text-slate-900 mb-2\">Ruhsal İhtiyaç: İMAN</h3>\n                    <p class=\"text-sm text-slate-600 leading-relaxed mb-4\">İman, insanın doğuştan getirdiği ruhsal bir ihtiyaçtır.</p>\n                    <div class=\"bg-emerald-50 p-3 rounded-xl border border-emerald-100 text-sm text-emerald-900\">\n                        <p class=\"font-medium\">İnsanın özünde harekete geçirilmeyi bekleyen bir güçtür. Peygamberimiz (sav), doğan her çocuğun inanmaya uygun özelliklerde yaratıldığını bildirmiştir.</p>\n                    </div>\n                </div>\n\n                <!-- Aklınızda Bulunsun: Fıtrat -->\n                <div class=\"bg-slate-900 text-white rounded-3xl p-6 relative overflow-hidden\">\n                    <div class=\"absolute -right-4 -bottom-4 opacity-10 text-white text-9xl\">\n                        <i class=\"fa-solid fa-lightbulb\"></i>\n                    </div>\n                    <div class=\"flex items-center space-x-2 text-amber-400 font-bold text-sm mb-3\">\n                        <i class=\"fa-solid fa-lightbulb\"></i>\n                        <span>AKLINIZDA BULUNSUN</span>\n                    </div>\n                    <h3 class=\"text-xl font-extrabold text-amber-300 mb-2\">FITRAT</h3>\n                    <p class=\"text-slate-300 text-sm leading-relaxed mb-4\">\n                        İnsanın yaratılıştan (doğuştan) sahip olduğu ahlak, huy, karakter, tabiat gibi özellikleridir.\n                    </p>\n                    <div class=\"bg-slate-800 p-3.5 rounded-xl border border-slate-700 text-xs text-slate-300\">\n                         Allah (cc) tüm varlıkları kendi varlığını ve birliğini tanıyabilme gücü ve yeteneğiyle yaratmıştır.\n                    </div>\n                </div>\n            </div>\n\n            <!-- TEVHİD ŞİİRİ ALANI -->\n            <div class=\"bg-white rounded-3xl p-6 border border-slate-200 shadow-sm\">\n                <div class=\"flex items-center justify-between mb-4 border-b border-slate-100 pb-3\">\n                    <div class=\"flex items-center space-x-3\">\n                        <i class=\"fa-solid fa-feather-pointed text-emerald-600 text-xl\"></i>\n                        <h3 class=\"text-lg font-bold text-slate-900\">Paylaşalım: TEVHİD ŞİİRİ</h3>\n                    </div>\n                    <span class=\"text-xs bg-slate-100 text-slate-600 font-medium px-2.5 py-1 rounded-lg\">Hasan Akay (Cenab Şahabeddin)</span>\n                </div>\n                <div class=\"bg-slate-50 p-5 rounded-2xl font-serif text-slate-800 space-y-2 italic text-center text-lg\">\n                    <p>“Varsın sen ey Rabbim, yine varsın, yine varsın</p>\n                    <p>Aklımda, hayalimde ve duygumda yaşarsın!</p>\n                    <p>Varlığınla, sıfatlarınla her yer dopdoludur</p>\n                    <p>Varlığın da sıfatların da senin sonsuzdur…</p>\n                    <p>…</p>\n                    <p>Güç bir elindedir, ögeler bir elinde</p>\n                    <p>Mimarı senin elindir, ezelin de ebedin de!</p>\n                    <p>...</p>\n                    <p>Ruhumda, beynimde ve kalbimde yaşarsın;</p>\n                    <p>Varsın sen ey Rabbim, yine varsın, yine varsın.”</p>\n                </div>\n            </div>\n        </section>\n\n        <!-- 3. SEKME: İMAN VE İSLAM İLİŞKİSİ -->\n        <section id=\"tab-iliski\" class=\"tab-content hidden space-y-6\">\n            <div class=\"bg-white rounded-3xl p-8 border border-slate-200 shadow-sm text-center\">\n                <h2 class=\"text-2xl font-extrabold text-slate-900 mb-4\">İman ve İslam Bir Bir bütündür</h2>\n                <p class=\"text-slate-600 max-w-3xl mx-auto mb-8\">İman ve İslam birbirini tamamlayan iki kavramdır. Tek başlarına değil, birlikte anlam kazanırlar.</p>\n                \n                <div class=\"grid md:grid-cols-2 gap-6 text-left\">\n                    <div class=\"bg-emerald-50 p-6 rounded-2xl border border-emerald-200\">\n                        <div class=\"flex items-center space-x-3 text-emerald-800 font-bold text-lg mb-2\">\n                            <i class=\"fa-solid fa-heart text-emerald-600\"></i>\n                            <h3>1. İMAN (İçsel Tasdik)</h3>\n                        </div>\n                        <p class=\"text-slate-700 font-medium text-sm\">İnandığımız esasların <span class=\"text-emerald-900 font-bold\">gönülden tasdik edilmesidir.</span> Kalpte gerçekleşen inançtır.</p>\n                    </div>\n\n                    <div class=\"bg-teal-50 p-6 rounded-2xl border border-teal-200\">\n                        <div class=\"flex items-center space-x-3 text-teal-800 font-bold text-lg mb-2\">\n                            <i class=\"fa-solid fa-person-walking text-teal-600\"></i>\n                            <h3>2. İSLAM (Dışsal Yansıma)</h3>\n                        </div>\n                        <p class=\"text-slate-700 font-medium text-sm\">İmanın <span class=\"text-teal-900 font-bold\">hayata yansımasıdır.</span> İslam'ı bir din olarak benimsemek ve onun emirlerine teslim olmaktır.</p>\n                    </div>\n                </div>\n\n                <div class=\"mt-8 bg-slate-50 p-6 rounded-2xl border border-slate-200 text-left\">\n                    <h4 class=\"font-bold text-slate-800 mb-3 flex items-center space-x-2\">\n                        <i class=\"fa-solid fa-circle-check text-emerald-600\"></i>\n                        <span>İman Eden Bir Kişinin Hayatı Nasıl Şekillenir?</span>\n                    </h4>\n                    <ul class=\"grid md:grid-cols-3 gap-3 text-sm text-slate-700 font-medium\">\n                        <li class=\"bg-white p-3 rounded-xl border border-slate-200 shadow-sm\">İslam’ın emir ve yasaklarını yerine getirir.</li>\n                        <li class=\"bg-white p-3 rounded-xl border border-slate-200 shadow-sm\">Ailesi, komşuları ve arkadaşlarıyla ilişkilerine dikkat eder.</li>\n                        <li class=\"bg-white p-3 rounded-xl border border-slate-200 shadow-sm\">Hayatının her aşamasını İslam kurallarına göre düzenler.</li>\n                    </ul>\n                </div>\n            </div>\n        </section>\n\n        <!-- 4. SEKME: CİBRİL HADİSİ -->\n        <section id=\"tab-hadis\" class=\"tab-content hidden space-y-6\">\n            <div class=\"bg-emerald-950 text-white rounded-3xl p-6 md:p-8 shadow-xl relative overflow-hidden\">\n                <div class=\"flex items-center space-x-3 mb-6 border-b border-emerald-800 pb-4\">\n                    <div class=\"bg-emerald-600 p-3 rounded-2xl\">\n                        <i class=\"fa-solid fa-scroll text-amber-300 text-2xl\"></i>\n                    </div>\n                    <div>\n                        <h2 class=\"text-2xl font-bold text-amber-300\">CİBRİL (CEBRAİL) HADİSİ</h2>\n                        <p class=\"text-emerald-300 text-xs\">Müslim, İman, 1.</p>\n                    </div>\n                </div>\n\n                <div class=\"space-y-4 text-emerald-100 text-sm leading-relaxed\">\n                    <p class=\"italic bg-emerald-900/40 p-4 rounded-xl border border-emerald-800\">\n                        \"Bir gün Hz. Muhammed (sav) arkadaşlarıyla otururken beyaz kıyafetli bir adam geldi. Onun yanına oturdu...\"\n                    </p>\n\n                    <!-- Hadisteki Soru-Cevaplar -->\n                    <div class=\"grid md:grid-cols-2 gap-4 mt-6\">\n                        <!-- İslam Sorusu -->\n                        <div class=\"bg-emerald-900/80 p-5 rounded-2xl border border-emerald-700 space-y-3\">\n                            <span class=\"bg-amber-400 text-emerald-950 font-extrabold text-xs px-2.5 py-1 rounded-full uppercase\">1. Soru</span>\n                            <p class=\"font-bold text-white text-base\">“Ey Muhammed (sav)! Bana İslam’ı anlat.”</p>\n                            <div class=\"bg-emerald-950/60 p-3.5 rounded-xl border border-emerald-800/80 text-xs space-y-2\">\n                                <p class=\"text-amber-200 font-bold text-sm\">Hz. Muhammed (sav) cevabı (İslam'ın Şartları):</p>\n                                <ul class=\"space-y-1.5 text-emerald-100\">\n                                    <li class=\"flex items-center space-x-2\"><i class=\"fa-solid fa-check text-amber-400\"></i><span>Allah'tan başka ilah olmadığına ve Muhammed'in Allah'ın elçisi olduğuna şahitlik etmek</span></li>\n                                    <li class=\"flex items-center space-x-2\"><i class=\"fa-solid fa-check text-amber-400\"></i><span>Namazı kılmak</span></li>\n                                    <li class=\"flex items-center space-x-2\"><i class=\"fa-solid fa-check text-amber-400\"></i><span>Zekâtı vermek</span></li>\n                                    <li class=\"flex items-center space-x-2\"><i class=\"fa-solid fa-check text-amber-400\"></i><span>Ramazan orucunu tutmak</span></li>\n                                    <li class=\"flex items-center space-x-2\"><i class=\"fa-solid fa-check text-amber-400\"></i><span>Gücün yetiyorsa haccı yerine getirmek</span></li>\n                                </ul>\n                            </div>\n                        </div>\n\n                        <!-- İman Sorusu -->\n                        <div class=\"bg-emerald-900/80 p-5 rounded-2xl border border-emerald-700 space-y-3\">\n                            <span class=\"bg-amber-400 text-emerald-950 font-extrabold text-xs px-2.5 py-1 rounded-full uppercase\">2. Soru</span>\n                            <p class=\"font-bold text-white text-base\">“Ey Muhammed (sav)! Bana imanı anlat.”</p>\n                            <div class=\"bg-emerald-950/60 p-3.5 rounded-xl border border-emerald-800/80 text-xs space-y-2\">\n                                <p class=\"text-amber-200 font-bold text-sm\">Hz. Muhammed (sav) cevabı (İmanın Şartları):</p>\n                                <ul class=\"space-y-1.5 text-emerald-100\">\n                                    <li class=\"flex items-center space-x-2\"><i class=\"fa-solid fa-check text-amber-400\"></i><span>Allah’a inanmak</span></li>\n                                    <li class=\"flex items-center space-x-2\"><i class=\"fa-solid fa-check text-amber-400\"></i><span>Meleklerine inanmak</span></li>\n                                    <li class=\"flex items-center space-x-2\"><i class=\"fa-solid fa-check text-amber-400\"></i><span>Kitaplarına inanmak</span></li>\n                                    <li class=\"flex items-center space-x-2\"><i class=\"fa-solid fa-check text-amber-400\"></i><span>Peygamberlerine inanmak</span></li>\n                                    <li class=\"flex items-center space-x-2\"><i class=\"fa-solid fa-check text-amber-400\"></i><span>Ahiret gününe inanmak</span></li>\n                                    <li class=\"flex items-center space-x-2\"><i class=\"fa-solid fa-check text-amber-400\"></i><span>İyisi ve kötüsüyle kadere inanmak</span></li>\n                                </ul>\n                            </div>\n                        </div>\n                    </div>\n\n                    <div class=\"bg-amber-500/20 border border-amber-500/40 p-4 rounded-xl mt-4\">\n                        <p class=\"text-amber-200 font-medium text-xs\">\n                            <span class=\"font-bold text-amber-300\">Hadisin Sonucu:</span> Adam gittikten sonra Hz. Muhammed (sav) şöyle buyurdu: \n                            <span class=\"italic\">“O, Cibril (Cebrail) idi. Size dininizi öğretmeye gelmişti.”</span>\n                            <br>👉 Cebrail'in (as) iman ve İslam kavramlarını peş peşe sorması bu iki kavramın birbiriyle olan sıkı bağını gösterir.\n                        </p>\n                    </div>\n                </div>\n            </div>\n        </section>\n\n        <!-- 5. SEKME: İNTERAKTİF ETKİNLİK (YAZALIM) -->\n        <section id=\"tab-etkinlik\" class=\"tab-content hidden space-y-6\">\n            <div class=\"bg-white rounded-3xl p-6 border border-slate-200 shadow-sm\">\n                <div class=\"flex items-center justify-between mb-6\">\n                    <div>\n                        <h2 class=\"text-xl font-extrabold text-slate-900\">Yazalım / Kavram Eşleştirme Etkinliği</h2>\n                        <p class=\"text-sm text-slate-500\">Aşağıdaki ifadelerin <strong>İman</strong> mı yoksa <strong>İslam</strong> mı olduğunu öğrenmek için kartlara tıklayınız.</p>\n                    </div>\n                    <span class=\"bg-amber-100 text-amber-800 font-bold text-xs px-3 py-1.5 rounded-xl\">Akıllı Tahta Etkinliği</span>\n                </div>\n\n                <div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4\" id=\"activity-grid\">\n                    <!-- Kartlar JS ile dynamic veya static render -->\n                </div>\n            </div>\n        </section>\n\n    </main>\n\n    <!-- PÜF NOKTA / KONTROL FOOTER -->\n    <footer class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-12\">\n        <div class=\"bg-gradient-to-r from-emerald-800 to-teal-900 rounded-3xl p-6 text-white flex flex-col md:flex-row items-center justify-between gap-4 shadow-xl\">\n            <div class=\"flex items-center space-x-4\">\n                <div class=\"bg-white/10 p-3 rounded-2xl\">\n                    <i class=\"fa-solid fa-lightbulb text-amber-300 text-2xl\"></i>\n                </div>\n                <div>\n                    <h4 class=\"font-bold text-amber-300\">🎯 Sınav İpucu / Özet</h4>\n                    <p class=\"text-xs text-emerald-100\">İman = Kalp ile tasdik (İnanç esasları) | İslam = Dil ile ikrar ve ameller (İbadet ve davranışlar)</p>\n                </div>\n            </div>\n            <div class=\"text-xs text-emerald-300 font-mono bg-emerald-950/60 px-4 py-2 rounded-xl border border-emerald-700/50\">\n                MEB Ders Kitabı %100 Uyumlu Özet\n            </div>\n        </div>\n    </footer>\n\n    <!-- INTERACTIVE JAVASCRIPT -->\n    <script>\n        // SEKME DEĞİŞTİRME FONKSİYONU\n        function switchTab(tabId) {\n            // Tüm içerikleri gizle\n            document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));\n            // Tüm buton pasif yap\n            document.querySelectorAll('.tab-btn').forEach(btn => {\n                btn.classList.remove('active');\n                btn.classList.add('bg-white', 'text-slate-700');\n            });\n\n            // Seçilen içeriği göster\n            document.getElementById(tabId).classList.remove('hidden');\n            \n            // Seçilen butonu aktif yap\n            const activeBtn = document.getElementById('btn-' + tabId);\n            activeBtn.classList.add('active');\n            activeBtn.classList.remove('bg-white', 'text-slate-700');\n        }\n\n        // ETKİNLİK KARTLARI VERİSİ (Metinden %100 sadık)\n        const activityItems = [\n            { text: \"Gönülden inanıp kabul etmek\", category: \"İman\", icon: \"fa-heart\" },\n            { text: \"Namaz kılmak\", category: \"İslam\", icon: \"fa-person-praying\" },\n            { text: \"Peygamberlere inanmak\", category: \"İman\", icon: \"fa-hands-holding\" },\n            { text: \"Allah’a (cc) inanmak\", category: \"İman\", icon: \"fa-star-and-crescent\" },\n            { text: \"Ahiret gününe inanmak\", category: \"İman\", icon: \"fa-clock\" },\n            { text: \"İnancı hayata yansıtmak\", category: \"İslam\", icon: \"fa-person-walking\" },\n            { text: \"Meleklere inanmak\", category: \"İman\", icon: \"fa-feather\" },\n            { text: \"Oruç tutmak\", category: \"İslam\", icon: \"fa-moon\" },\n            { text: \"Hacca gitmek\", category: \"İslam\", icon: \"fa-kaaba\" },\n            { text: \"Zekât vermek\", category: \"İslam\", icon: \"fa-hand-holding-dollar\" },\n            { text: \"Kelimeişehadet getirmek\", category: \"İslam\", icon: \"fa-comment\" },\n            { text: \"İlahi kitaplara inanmak\", category: \"İman\", icon: \"fa-book\" }\n        ];\n\n        // ETKİNLİK KARTLARINI OLUŞTURMA\n        const gridContainer = document.getElementById('activity-grid');\n        activityItems.forEach((item, index) => {\n            const card = document.createElement('div');\n            card.className = \"bg-slate-50 border border-slate-200 p-4 rounded-2xl flex flex-col justify-between hover:border-emerald-500 transition-all cursor-pointer group\";\n            card.onclick = () => toggleAnswer(index);\n            \n            card.innerHTML = `\n                <div class=\"flex items-center justify-between mb-3\">\n                    <span class=\"w-8 h-8 bg-white border border-slate-200 rounded-xl flex items-center justify-center text-slate-600 text-sm\">\n                        <i class=\"fa-solid ${item.icon}\"></i>\n                    </span>\n                    <span id=\"badge-${index}\" class=\"text-xs font-extrabold px-2.5 py-1 rounded-lg opacity-0 transition-opacity duration-200\"></span>\n                </div>\n                <p class=\"font-semibold text-slate-800 text-sm mb-3\">${item.text}</p>\n                <button id=\"btn-ans-${index}\" class=\"w-full text-xs font-bold py-2 bg-slate-200 text-slate-700 rounded-xl group-hover:bg-emerald-600 group-hover:text-white transition-colors\">\n                    Cevabı Göster\n                </button>\n            `;\n            gridContainer.appendChild(card);\n        });\n\n        function toggleAnswer(index) {\n            const item = activityItems[index];\n            const badge = document.getElementById(`badge-${index}`);\n            const btn = document.getElementById(`btn-ans-${index}`);\n\n            if (badge.classList.contains('opacity-0')) {\n                badge.classList.remove('opacity-0');\n                badge.innerText = item.category;\n                if (item.category === 'İman') {\n                    badge.className = \"text-xs font-extrabold px-2.5 py-1 rounded-lg bg-emerald-100 text-emerald-800 opacity-100\";\n                } else {\n                    badge.className = \"text-xs font-extrabold px-2.5 py-1 rounded-lg bg-teal-100 text-teal-800 opacity-100\";\n                }\n                btn.innerText = `Kategori: ${item.category}`;\n                btn.className = \"w-full text-xs font-bold py-2 bg-slate-900 text-white rounded-xl\";\n            } else {\n                badge.classList.add('opacity-0');\n                btn.innerText = \"Cevabı Göster\";\n                btn.className = \"w-full text-xs font-bold py-2 bg-slate-200 text-slate-700 rounded-xl\";\n            }\n        }\n    </script>\n</body>\n</html>",
