{
  "htmlContent": "<!DOCTYPE html>\n<html lang=\"tr\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>5. Sınıf Kur'an-ı Kerim - Özet ve Akıllı Tahta Sunumu</title>\n    <!-- Tailwind CSS CDN -->\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <!-- FontAwesome CDN -->\n    <link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css\" />\n    <!-- Google Fonts for Arabic & Modern Typography -->\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n    <link href=\"https://fonts.googleapis.com/css2?family=Amiri:ital,wght@0,400;0,700;1,400&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap\" rel=\"stylesheet\">\n    \n    <style>\n        body {\n            font-family: 'Plus Jakarta Sans', sans-serif;\n            background-color: #f8fafc;\n        }\n        .font-arabic {\n            font-family: 'Amiri', serif;\n            line-height: 2.2;\n        }\n        .tab-btn.active {\n            background-color: #047857;\n            color: #ffffff;\n            box-shadow: 0 4px 14px 0 rgba(4, 120, 87, 0.39);\n        }\n    </style>\n</head>\n<body class=\"text-slate-800 antialiased min-h-screen pb-12\">\n\n    <!-- ÜST BAŞLIK / HEADER (Akıllı Tahta Uyumlu) -->\n    <header class=\"bg-emerald-800 text-white shadow-lg border-b-4 border-emerald-600 sticky top-0 z-50\">\n        <div class=\"max-w-7xl mx-auto px-4 py-4 sm:px-6 lg:px-8 flex flex-col md:flex-row justify-between items-center gap-4\">\n            <div class=\"flex items-center space-x-4\">\n                <div class=\"bg-emerald-700/80 p-3 rounded-2xl border border-emerald-500/30\">\n                    <i class=\"fa-solid fa-book-quran text-3xl text-amber-300\"></i>\n                </div>\n                <div>\n                    <div class=\"flex items-center space-x-2 text-xs font-semibold text-emerald-200 tracking-wider uppercase\">\n                        <span>5. Sınıf</span>\n                        <span>•</span>\n                        <span>1. Ünite: Kur'an-ı Kerim'i Tanıyorum</span>\n                    </div>\n                    <h1 class=\"text-xl md:text-2xl font-bold tracking-tight text-white\">\n                        1.1. Kur'an-ı Kerim'i Öğrenmenin Önemi ve Okumanın Adabı\n                    </h1>\n                </div>\n            </div>\n            <!-- Mod Değiştirici / Tab Butonları -->\n            <div class=\"flex bg-emerald-900/60 p-1.5 rounded-2xl border border-emerald-700/50 text-sm font-medium\">\n                <button onclick=\"switchTab('tab1')\" id=\"btn-tab1\" class=\"tab-btn active px-4 py-2 rounded-xl transition-all duration-200 flex items-center space-x-2\">\n                    <i class=\"fa-solid fa-compass\"></i>\n                    <span>1. Tanım ve Kavramlar</span>\n                </button>\n                <button onclick=\"switchTab('tab2')\" id=\"btn-tab2\" class=\"tab-btn px-4 py-2 rounded-xl text-emerald-200 hover:text-white transition-all duration-200 flex items-center space-x-2\">\n                    <i class=\"fa-solid fa-heart\"></i>\n                    <span>2. Öğrenmenin Önemi</span>\n                </button>\n                <button onclick=\"switchTab('tab3')\" id=\"btn-tab3\" class=\"tab-btn px-4 py-2 rounded-xl text-emerald-200 hover:text-white transition-all duration-200 flex items-center space-x-2\">\n                    <i class=\"fa-solid fa-hands-praying\"></i>\n                    <span>3. Okuma Adabı</span>\n                </button>\n            </div>\n        </div>\n    </header>\n\n    <!-- ANA İÇERİK KONTAYNERİ -->\n    <main class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-6\">\n\n        <!-- ================= TAB 1: TANIM VE KAVRAMLAR ================= -->\n        <section id=\"tab1\" class=\"space-y-6\">\n            \n            <!-- Kazanım Özeti Kartı -->\n            <div class=\"bg-white rounded-3xl p-6 shadow-sm border border-slate-200/80\">\n                <h2 class=\"text-lg font-bold text-emerald-900 mb-4 flex items-center gap-2\">\n                    <i class=\"fa-solid fa-bullseye text-emerald-600\"></i> Konunun Temel Kazanımları\n                </h2>\n                <div class=\"grid grid-cols-1 md:grid-cols-3 gap-4\">\n                    <div class=\"flex items-start gap-3 p-4 bg-emerald-50/50 rounded-2xl border border-emerald-100\">\n                        <i class=\"fa-solid fa-book-open text-emerald-600 text-xl mt-1\"></i>\n                        <div>\n                            <h3 class=\"font-bold text-slate-800 text-sm\">Kur'an-ı Kerim'i Tanıma</h3>\n                            <p class=\"text-xs text-slate-600 mt-1\">İslam'ın temel kaynağı olan vahyolunmuş son ilahi kitabı tüm özellikleriyle kavrama.</p>\n                        </div>\n                    </div>\n                    <div class=\"flex items-start gap-3 p-4 bg-emerald-50/50 rounded-2xl border border-emerald-100\">\n                        <i class=\"fa-solid fa-graduation-cap text-emerald-600 text-xl mt-1\"></i>\n                        <div>\n                            <h3 class=\"font-bold text-slate-800 text-sm\">Öğrenmenin Değeri</h3>\n                            <p class=\"text-xs text-slate-600 mt-1\">Kur'an'ı okumanın, anlamanın ve hayata geçirmenin ibadet değerini açıklayabilme.</p>\n                        </div>\n                    </div>\n                    <div class=\"flex items-start gap-3 p-4 bg-emerald-50/50 rounded-2xl border border-emerald-100\">\n                        <i class=\"fa-solid fa-hands-holding text-emerald-600 text-xl mt-1\"></i>\n                        <div>\n                            <h3 class=\"font-bold text-slate-800 text-sm\">Saygı ve Edep</h3>\n                            <p class=\"text-xs text-slate-600 mt-1\">Kur'an-ı Kerim okurken ve dinlerken uyulması gereken edap kurallarını uygulama.</p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n\n            <!-- İnteraktif Ön Bilgi Hazırlık (Ders Kitabı Hazırlık Etkinliği) -->\n            <div class=\"bg-gradient-to-br from-amber-50 to-orange-50 rounded-3xl p-6 shadow-sm border border-amber-200/70\">\n                <div class=\"flex items-center justify-between mb-3\">\n                    <span class=\"text-xs font-bold uppercase tracking-wider text-amber-700 bg-amber-200/60 px-3 py-1 rounded-full\">Konuya Başlarken - İnteraktif Kontrol</span>\n                    <span class=\"text-xs text-amber-800 font-medium\">Bilgisini kontrol etmek istediğin kavramın üzerine tıkla!</span>\n                </div>\n                <p class=\"text-sm text-slate-700 mb-4 font-medium\">Aşağıda Kur'an-ı Kerim ile ilgili kavramlardan bildiklerinizi işaretleyiniz:</p>\n                <div class=\"grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-3\">\n                    <button onclick=\"toggleConcept(this)\" class=\"p-3 bg-white rounded-xl border border-amber-200 text-slate-700 font-semibold text-sm shadow-sm hover:border-amber-400 flex items-center justify-between transition-all\">\n                        <span>Mahreç</span>\n                        <i class=\"fa-regular fa-square text-amber-500 text-lg icon-check\"></i>\n                    </button>\n                    <button onclick=\"toggleConcept(this)\" class=\"p-3 bg-white rounded-xl border border-amber-200 text-slate-700 font-semibold text-sm shadow-sm hover:border-amber-400 flex items-center justify-between transition-all\">\n                        <span>Eûzübesmele</span>\n                        <i class=\"fa-regular fa-square text-amber-500 text-lg icon-check\"></i>\n                    </button>\n                    <button onclick=\"toggleConcept(this)\" class=\"p-3 bg-white rounded-xl border border-amber-200 text-slate-700 font-semibold text-sm shadow-sm hover:border-amber-400 flex items-center justify-between transition-all\">\n                        <span>Hareke</span>\n                        <i class=\"fa-regular fa-square text-amber-500 text-lg icon-check\"></i>\n                    </button>\n                    <button onclick=\"toggleConcept(this)\" class=\"p-3 bg-white rounded-xl border border-amber-200 text-slate-700 font-semibold text-sm shadow-sm hover:border-amber-400 flex items-center justify-between transition-all\">\n                        <span>Dua</span>\n                        <i class=\"fa-regular fa-square text-amber-500 text-lg icon-check\"></i>\n                    </button>\n                    <button onclick=\"toggleConcept(this)\" class=\"p-3 bg-white rounded-xl border border-amber-200 text-slate-700 font-semibold text-sm shadow-sm hover:border-amber-400 flex items-center justify-between transition-all\">\n                        <span>İstiğfar</span>\n                        <i class=\"fa-regular fa-square text-amber-500 text-lg icon-check\"></i>\n                    </button>\n                </div>\n            </div>\n\n            <!-- Ana Kavram Kartları -->\n            <div class=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n                <!-- Kur'an-ı Kerim Kavram Kutusu -->\n                <div class=\"bg-white rounded-3xl p-6 shadow-sm border border-emerald-100 hover:shadow-md transition-shadow\">\n                    <div class=\"flex items-center gap-3 mb-4\">\n                        <div class=\"w-10 h-10 rounded-2xl bg-emerald-100 text-emerald-700 flex items-center justify-center font-bold\">\n                            <i class=\"fa-solid fa-book\"></i>\n                        </div>\n                        <div>\n                            <span class=\"text-xs font-bold text-emerald-600 uppercase tracking-wider\">Kavram Kutusu</span>\n                            <h3 class=\"text-xl font-bold text-slate-900\">Kur'an-ı Kerim Nedir?</h3>\n                        </div>\n                    </div>\n                    <ul class=\"space-y-3 text-sm text-slate-600\">\n                        <li class=\"flex items-start gap-2\">\n                            <i class=\"fa-solid fa-angle-right text-emerald-500 mt-1\"></i>\n                            <span><strong>Kelime Anlamı:</strong> Arapçada \"okumak\" anlamına gelen <em>\"karae\"</em> fiilinden türemiş bir isimdir.</span>\n                        </li>\n                        <li class=\"flex items-start gap-2\">\n                            <i class=\"fa-solid fa-angle-right text-emerald-500 mt-1\"></i>\n                            <span><strong>Tanımı:</strong> Yüce Allah tarafından Cebrail (as) aracılığıyla Hz. Muhammed'e (sav) gönderilen vahiylerden oluşan ilahi kitaptır.</span>\n                        </li>\n                        <li class=\"flex items-start gap-2\">\n                            <i class=\"fa-solid fa-angle-right text-emerald-500 mt-1\"></i>\n                            <span><strong>Sure Yapısı:</strong> 114 sureden oluşur. Fâtiha suresi ile başlayıp Nâs suresiyle biter.</span>\n                        </li>\n                        <li class=\"flex items-start gap-2\">\n                            <i class=\"fa-solid fa-angle-right text-emerald-500 mt-1\"></i>\n                            <span><strong>İndiriliş Süreci:</strong> 610 yılı Ramazan ayının Kadir Gecesi'nde indirilmeye başlanmış, yaklaşık 23 yılda tamamlanmıştır.</span>\n                        </li>\n                        <li class=\"flex items-start gap-2 text-emerald-800 font-medium bg-emerald-50 p-2.5 rounded-xl\">\n                            <i class=\"fa-solid fa-shield-halved text-emerald-600 mt-0.5\"></i>\n                            <span>Kur'an-ı Kerim, hiçbir değişikliğe uğramadan günümüze kadar gelmiştir.</span>\n                        </li>\n                    </ul>\n                </div>\n\n                <!-- Dil & Ezan İlişkisi Kutusu (Başlarken Sorusu) -->\n                <div class=\"bg-white rounded-3xl p-6 shadow-sm border border-emerald-100 hover:shadow-md transition-shadow flex flex-col justify-between\">\n                    <div>\n                        <div class=\"flex items-center gap-3 mb-4\">\n                            <div class=\"w-10 h-10 rounded-2xl bg-teal-100 text-teal-700 flex items-center justify-center font-bold\">\n                                <i class=\"fa-solid fa-language\"></i>\n                            </div>\n                            <div>\n                                <span class=\"text-xs font-bold text-teal-600 uppercase tracking-wider\">Başlarken Düşünelim</span>\n                                <h3 class=\"text-xl font-bold text-slate-900\">Ezan ve Kur'an Dili</h3>\n                            </div>\n                        </div>\n                        <p class=\"text-sm text-slate-600 leading-relaxed mb-4\">\n                            Yüce Allah tarafından tüm insanlığa gönderilen Kur'an-ı Kerim, İslam'ın kutsal kitabıdır. Arapça olarak indirilen Kur'an, Yüce Allah'ın sözleri ve kullarına hitabıdır.\n                        </p>\n                        <div class=\"bg-teal-50/70 p-4 rounded-2xl border border-teal-100\">\n                            <h4 class=\"font-bold text-teal-900 text-sm mb-1 flex items-center gap-2\">\n                                <i class=\"fa-solid fa-circle-question text-teal-600\"></i> Derse Katılım Sorusu:\n                            </h4>\n                            <p class=\"text-xs text-teal-800 italic\">\n                                \"Namaz vaktinin geldiğini insanlara bildiren ezanın dili ile Kur'an-ı Kerim'in indirildiği dilin aynı (Arapça) olmasının sebepleri neler olabilir?\"\n                            </p>\n                        </div>\n                    </div>\n                    <div class=\"mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-xs text-slate-500\">\n                        <span><i class=\"fa-solid fa-circle-info text-emerald-500\"></i> İslam'ın Evrensel Dili ve Orijinal Metnin Korunması</span>\n                    </div>\n                </div>\n            </div>\n        </section>\n\n        <!-- ================= TAB 2: ÖĞRENMENİN ÖNEMİ ================= -->\n        <section id=\"tab2\" class=\"space-y-6 hidden\">\n\n            <!-- Hadis-i Şerif Kartları -->\n            <div class=\"bg-gradient-to-r from-emerald-900 to-teal-900 text-white rounded-3xl p-6 md:p-8 shadow-md\">\n                <div class=\"flex items-center gap-3 mb-6\">\n                    <i class=\"fa-solid fa-quote-left text-3xl text-emerald-400\"></i>\n                    <div>\n                        <h2 class=\"text-xl font-bold\">Peygamber Efendimizin (s.a.v.) Teşvik ve Müjdeleri</h2>\n                        <p class=\"text-xs text-emerald-200\">Kur'an-ı Kerim'i Öğrenmenin ve Okumanın Değeri</p>\n                    </div>\n                </div>\n\n                <div class=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n                    <!-- Hadis 1 -->\n                    <div class=\"bg-emerald-800/60 p-5 rounded-2xl border border-emerald-700/60 flex flex-col justify-between\">\n                        <div>\n                            <p class=\"font-arabic text-right text-xl text-amber-200 mb-3\" dir=\"rtl\">\n                                اِقْرَءُوا الْقُرْاٰنَ فَاِنَّهُ يَأْت۪ي يَوْمَ الْقِيَامَةِ شَف۪يعًا لِاَصْحَابِه۪\n                            </p>\n                            <p class=\"text-sm text-emerald-50 italic\">\n                                \"Kur'an okuyun! Çünkü Kur'an, kıyamet gününde okuyucusuna şefaatçi olacaktır.\"\n                            </p>\n                        </div>\n                        <span class=\"mt-4 inline-block text-xs text-amber-300 font-semibold uppercase tracking-wider\">\n                            <i class=\"fa-solid fa-star text-xs\"></i> Okuma Teşviki & Şefaat Müjdesi\n                        </span>\n                    </div>\n\n                    <!-- Hadis 2 -->\n                    <div class=\"bg-emerald-800/60 p-5 rounded-2xl border border-emerald-700/60 flex flex-col justify-between\">\n                        <div>\n                            <p class=\"font-arabic text-right text-xl text-amber-200 mb-3\" dir=\"rtl\">\n                                خَيْرُكُمْ مَنْ تَعَلَّمَ الْقُرْاٰنَ وَعَلَّمَهُ\n                            </p>\n                            <p class=\"text-sm text-emerald-50 italic\">\n                                \"Sizin en hayırlınız, Kur'an'ı öğrenen ve öğretendir.\"\n                            </p>\n                        </div>\n                        <span class=\"mt-4 inline-block text-xs text-amber-300 font-semibold uppercase tracking-wider\">\n                            <i class=\"fa-solid fa-award text-xs\"></i> En Hayırlı İnsan\n                        </span>\n                    </div>\n                </div>\n            </div>\n\n            <!-- Kur'an Neler Öğretir? (Metin Bazlı Detay Kartı) -->\n            <div class=\"bg-white rounded-3xl p-6 shadow-sm border border-slate-200\">\n                <h3 class=\"text-lg font-bold text-slate-900 mb-4 flex items-center gap-2\">\n                    <i class=\"fa-solid fa-compass text-emerald-600\"></i> Kur'an-ı Kerim İnsanlara Neleri Öğretir ve Öğütler?\n                </h3>\n                <div class=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4\">\n                    <div class=\"p-4 bg-slate-50 rounded-2xl border border-slate-100\">\n                        <div class=\"w-8 h-8 rounded-lg bg-emerald-100 text-emerald-700 flex items-center justify-center font-bold mb-2\">1</div>\n                        <h4 class=\"font-bold text-slate-800 text-sm\">Rehberlik & Ahlak</h4>\n                        <p class=\"text-xs text-slate-600 mt-1\">Tüm insanlara doğru yolu gösterir. Adaleti, doğruluğu ve iyiliği öğütler.</p>\n                    </div>\n                    <div class=\"p-4 bg-slate-50 rounded-2xl border border-slate-100\">\n                        <div class=\"w-8 h-8 rounded-lg bg-emerald-100 text-emerald-700 flex items-center justify-center font-bold mb-2\">2</div>\n                        <h4 class=\"font-bold text-slate-800 text-sm\">Sorumluluklar</h4>\n                        <p class=\"text-xs text-slate-600 mt-1\">Allah'a, Hz. Peygamber'e, topluma ve kendine karşı görevleri bildirir.</p>\n                    </div>\n                    <div class=\"p-4 bg-slate-50 rounded-2xl border border-slate-100\">\n                        <div class=\"w-8 h-8 rounded-lg bg-emerald-100 text-emerald-700 flex items-center justify-center font-bold mb-2\">3</div>\n                        <h4 class=\"font-bold text-slate-800 text-sm\">Güzel Davranışlar</h4>\n                        <p class=\"text-xs text-slate-600 mt-1\">Anne-babaya iyi davranmayı ve insanlara güzel sözle hitap etmeyi emreder.</p>\n                    </div>\n                    <div class=\"p-4 bg-slate-50 rounded-2xl border border-slate-100\">\n                        <div class=\"w-8 h-8 rounded-lg bg-emerald-100 text-emerald-700 flex items-center justify-center font-bold mb-2\">4</div>\n                        <h4 class=\"font-bold text-slate-800 text-sm\">Ahiret Bilgisi</h4>\n                        <p class=\"text-xs text-slate-600 mt-1\">Yaptığımız iyilik ve kötülüklerin karşılığı olacağını bildirerek hayırlara yönlendirir.</p>\n                    </div>\n                </div>\n            </div>\n\n            <!-- Ders Kitabındaki Ayet-i Kerimeler -->\n            <div class=\"space-y-4\">\n                <h3 class=\"text-lg font-bold text-slate-900 flex items-center gap-2\">\n                    <i class=\"fa-solid fa-scroll text-amber-600\"></i> Konu İle İlgili Ayet-i Kerimeler (Kitap Kaynağı)\n                </h3>\n\n                <!-- Ayet 1: Bakara 46 -->\n                <div class=\"bg-white rounded-2xl p-5 shadow-sm border border-emerald-100\">\n                    <div class=\"flex flex-col md:flex-row justify-between md:items-center gap-4\">\n                        <div class=\"space-y-2\">\n                            <span class=\"text-xs font-bold text-emerald-700 bg-emerald-100 px-2.5 py-1 rounded-md\">Bakara suresi, 46. ayet</span>\n                            <p class=\"text-sm font-medium text-slate-700\">\n                                \"Onlar, Rablerine kavuşacaklarını ve gerçekten O'na döneceklerini çok iyi bilirler.\"\n                            </p>\n                            <p class=\"text-xs text-slate-500\">💡 <strong>Açıklama:</strong> Ahirete inananlar yaptıklarının karşılığı olduğunu bilir, iyi işler yapıp kötülükten kaçınırlar.</p>\n                        </div>\n                        <div class=\"font-arabic text-right text-xl text-emerald-900 bg-emerald-50/50 p-3 rounded-xl min-w-[280px]\" dir=\"rtl\">\n                            اَلَّذ۪ينَ يَظُنُّونَ اَنَّهُمْ مُلَاقُوا رَبِّهِمْ وَاَنَّهُمْ اِلَيْهِ رَاجِعُونَ\n                        </div>\n                    </div>\n                </div>\n\n                <!-- Ayet 2: Fâtır 29 -->\n                <div class=\"bg-white rounded-2xl p-5 shadow-sm border border-emerald-100\">\n                    <div class=\"flex flex-col md:flex-row justify-between md:items-center gap-4\">\n                        <div class=\"space-y-2\">\n                            <span class=\"text-xs font-bold text-emerald-700 bg-emerald-100 px-2.5 py-1 rounded-md\">Fâtır suresi, 29. ayet</span>\n                            <p class=\"text-sm font-medium text-slate-700\">\n                                \"Şüphesiz, Allah'ın kitabını okuyanlar, namazı kılanlar ve kendilerine rızık olarak verdiğimiz şeylerden gizlice ve açıktan Allah yolunda harcayanlar, asla zarar etmeyecek bir ticaret umabilirler.\"\n                            </p>\n                            <p class=\"text-xs text-slate-500\">💡 <strong>Açıklama:</strong> Kur'an okumak Müslümanlar için ibadettir ve sevap kazandırır.</p>\n                        </div>\n                        <div class=\"font-arabic text-right text-xl text-emerald-900 bg-emerald-50/50 p-3 rounded-xl min-w-[280px]\" dir=\"rtl\">\n                            اِنَّ الَّذ۪ينَ يَتْلُونَ كِتَابَ اللّٰهِ وَاَقَامُوا الصَّلٰوةَ وَاَنْفَقُوا مِمَّا رَزَقْنَاهُمْ سِرًّا وَعَلَانِيَةً يَرْجُونَ تِجَارَةً لَنْ تَبُورَ\n                        </div>\n                    </div>\n                </div>\n\n                <!-- Ayet 3: Sâd 29 -->\n                <div class=\"bg-white rounded-2xl p-5 shadow-sm border border-emerald-100\">\n                    <div class=\"flex flex-col md:flex-row justify-between md:items-center gap-4\">\n                        <div class=\"space-y-2\">\n                            <span class=\"text-xs font-bold text-amber-700 bg-amber-100 px-2.5 py-1 rounded-md\">Sâd suresi, 29. ayet (2. Etkinlik)</span>\n                            <p class=\"text-sm font-medium text-slate-700\">\n                                \"Bu Kur'an, âyetlerini düşünsünler ve akıl sahipleri öğüt alsınlar diye sana indirdiğimiz mübarek bir kitaptır.\"\n                            </p>\n                            <p class=\"text-xs text-slate-500\">🎯 <strong>Ana Fikir:</strong> Kur'an sadece okunmak için değil, üzerinde düşünülmek ve öğüt alınmak için indirilmiştir.</p>\n                        </div>\n                        <div class=\"font-arabic text-right text-xl text-emerald-900 bg-emerald-50/50 p-3 rounded-xl min-w-[280px]\" dir=\"rtl\">\n                            كِتَابٌ اَنْزَلْنَاهُ اِلَيْكَ مُبَارَكٌ لِيَدَّبَّرُوٓا اٰيَاتِه۪ وَلِيَتَذَكَّرَ اُو۬لُوا الْاَلْبَابِ\n                        </div>\n                    </div>\n                </div>\n            </div>\n\n        </section>\n\n        <!-- ================= TAB 3: OKUMA ADABI ================= -->\n        <section id=\"tab3\" class=\"space-y-6 hidden\">\n\n            <div class=\"bg-white rounded-3xl p-6 shadow-sm border border-slate-200\">\n                <div class=\"max-w-3xl mb-6\">\n                    <h2 class=\"text-xl font-bold text-slate-900 flex items-center gap-2\">\n                        <i class=\"fa-solid fa-hands-praying text-emerald-600\"></i> Kur'an-ı Kerim Okumanın Adabı\n                    </h2>\n                    <p class=\"text-sm text-slate-600 mt-1\">\n                        Müslümanlar, Kur'an-ı Kerim'e duydukları saygının bir göstergesi olarak bazı adab ve kurallara özen gösterirler.\n                    </p>\n                </div>\n\n                <!-- Adab Maddeleri Grid -->\n                <div class=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n\n                    <!-- 1. Abdestli Olmak -->\n                    <div class=\"p-5 rounded-2xl bg-emerald-50/60 border border-emerald-100 space-y-3\">\n                        <div class=\"flex items-center space-x-3\">\n                            <div class=\"w-9 h-9 rounded-xl bg-emerald-600 text-white flex items-center justify-center font-bold\">1</div>\n                            <h3 class=\"font-bold text-slate-900 text-base\">Abdestli Olmaya Özen Göstermek</h3>\n                        </div>\n                        <p class=\"text-xs text-slate-600 leading-relaxed\">\n                            Kur'an-ı Kerim'i okurken ve ona dokunurken abdestli olmaya özen gösterilir. Bu durum, Kur'an-ı Kerim'e duyulan saygının bir gereğidir. Abdest aynı zamanda bedensel ve manevi temizlik sağlar.\n                        </p>\n                    </div>\n\n                    <!-- 2. Eûzübesmele İle Başlamak -->\n                    <div class=\"p-5 rounded-2xl bg-emerald-50/60 border border-emerald-100 space-y-3\">\n                        <div class=\"flex items-center space-x-3\">\n                            <div class=\"w-9 h-9 rounded-xl bg-emerald-600 text-white flex items-center justify-center font-bold\">2</div>\n                            <h3 class=\"font-bold text-slate-900 text-base\">Eûzübesmele Çekmek</h3>\n                        </div>\n                        <p class=\"text-xs text-slate-600 leading-relaxed\">\n                            Kur'an okumaya istiaze cümleleriyle (Eûzübesmele) başlanır. Nahl suresi 98. ayette Allah (cc): <em>\"Kur'an okuduğun zaman kovulmuş şeytandan Allah'a sığın.\"</em> buyurmaktadır.\n                        </p>\n                    </div>\n\n                </div>\n            </div>\n\n            <!-- İstiaze & Besmele Kavram Kutuları (Önemli) -->\n            <div class=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n\n                <!-- İstiaze Kutusu -->\n                <div class=\"bg-white rounded-3xl p-6 shadow-sm border border-slate-200 flex flex-col justify-between\">\n                    <div>\n                        <div class=\"flex items-center justify-between mb-3\">\n                            <span class=\"text-xs font-bold text-emerald-600 bg-emerald-100 px-3 py-1 rounded-full uppercase\">Kavram Kutusu</span>\n                            <span class=\"text-xs text-slate-400\">Nahl Suresi, 98. Ayet Gereği</span>\n                        </div>\n                        <h3 class=\"text-lg font-bold text-slate-900 mb-2\">İstiaze Nedir?</h3>\n                        <p class=\"text-xs text-slate-600 mb-4\">\n                            <strong>Sözlük Anlamı:</strong> Sığınma, bağlanma, korunma ve güvenme.<br>\n                            <strong>Terim Anlamı:</strong> Her türlü kötülükten Yüce Allah'a sığınıp yalnızca O'ndan yardım istemektir.\n                        </p>\n\n                        <!-- İstiaze Arapça ve Türkçe -->\n                        <div class=\"bg-amber-50/80 p-4 rounded-2xl border border-amber-200/60 text-center space-y-2\">\n                            <p class=\"font-arabic text-2xl text-emerald-900\" dir=\"rtl\">\n                                اَعُوذُ بِاللّٰهِ مِنَ الشَّيْطَانِ الرَّج۪يمِ\n                            </p>\n                            <p class=\"text-xs font-semibold text-amber-900\">\n                                \"Eûzü billâhi mineşşeytânirracîm\"\n                            </p>\n                            <p class=\"text-xs text-slate-600 italic\">\n                                <strong>Anlamı:</strong> \"Kovulmuş şeytanın şerrinden Allah'a (cc) sığınırım.\"\n                            </p>\n                        </div>\n                    </div>\n                </div>\n\n                <!-- Besmele Kutusu -->\n                <div class=\"bg-white rounded-3xl p-6 shadow-sm border border-slate-200 flex flex-col justify-between\">\n                    <div>\n                        <div class=\"flex items-center justify-between mb-3\">\n                            <span class=\"text-xs font-bold text-teal-600 bg-teal-100 px-3 py-1 rounded-full uppercase\">Başlangıç İfadesi</span>\n                            <span class=\"text-xs text-slate-400\">İstiazeden Sonra Okunur</span>\n                        </div>\n                        <h3 class=\"text-lg font-bold text-slate-900 mb-2\">Besmele</h3>\n                        <p class=\"text-xs text-slate-600 mb-4\">\n                            İstiazenin ardından Allah'ın merhamet ve bağışlamasını anarak okumaya başlamak için söylenir.\n                        </p>\n\n                        <!-- Besmele Arapça ve Türkçe -->\n                        <div class=\"bg-teal-50/80 p-4 rounded-2xl border border-teal-200/60 text-center space-y-2\">\n                            <p class=\"font-arabic text-2xl text-teal-900\" dir=\"rtl\">\n                                بِسْمِ اللّٰهِ الرَّحْمٰنِ الرَّح۪يمِ\n                            </p>\n                            <p class=\"text-xs font-semibold text-teal-900\">\n                                \"Bismillahirrahmanirrahim\"\n                            </p>\n                            <p class=\"text-xs text-slate-600 italic\">\n                                <strong>Anlamı:</strong> \"Esirgeyen ve bağışlayan Allah'ın (cc) adıyla\"\n                            </p>\n                        </div>\n                    </div>\n                </div>\n\n            </div>\n\n            <!-- Saygı ile Dinleme (A'râf 204) -->\n            <div class=\"bg-white rounded-3xl p-6 shadow-sm border border-emerald-200\">\n                <div class=\"flex flex-col md:flex-row items-center justify-between gap-6\">\n                    <div class=\"space-y-3 flex-1\">\n                        <div class=\"flex items-center space-x-2\">\n                            <i class=\"fa-solid fa-ear-listen text-emerald-600 text-xl\"></i>\n                            <h3 class=\"text-lg font-bold text-slate-900\">Kur'an Okunurken Saygıyla Dinlemek</h3>\n                        </div>\n                        <p class=\"text-xs text-slate-600 leading-relaxed\">\n                            Müslümanlar, Kur'an-ı Kerim okunurken onu saygı ve ilgiyle dinlerler. Göstermiş oldukları bu saygılı davranışların karşılığını Allah'ın vereceğini bilirler.\n                        </p>\n                        <div class=\"p-3 bg-slate-50 rounded-xl border border-slate-100 text-xs\">\n                            <span class=\"font-bold text-emerald-800\">A'râf suresi, 204. ayet:</span>\n                            <span class=\"italic text-slate-700\">\"Kur'an okunduğu zaman onu dinleyin ve susun ki size merhamet edilsin.\"</span>\n                        </div>\n                    </div>\n                    \n                    <div class=\"font-arabic text-right text-xl text-emerald-900 bg-emerald-50 p-4 rounded-2xl border border-emerald-100 min-w-[300px]\" dir=\"rtl\">\n                        وَاِذَا قُرِئَ الْقُرْاٰنُ فَاسْتَمِعُوا لَهُ وَاَنْصِتُوا لَعَلَّكُمْ تُرْحَمُونَ\n                    </div>\n                </div>\n            </div>\n\n        </section>\n\n        <!-- UNUTMAYALIM / SINAV İPUCU KUTUSU (Sabit Alt Bilgi Özeti) -->\n        <section class=\"mt-8\">\n            <div class=\"bg-gradient-to-r from-amber-400 via-amber-500 to-orange-500 text-slate-900 rounded-3xl p-6 shadow-md relative overflow-hidden\">\n                <div class=\"absolute -right-6 -bottom-6 opacity-20 text-white\">\n                    <i class=\"fa-solid fa-lightbulb text-9xl\"></i>\n                </div>\n                <div class=\"relative z-10 flex flex-col md:flex-row items-start md:items-center justify-between gap-4\">\n                    <div class=\"flex items-center space-x-4\">\n                        <div class=\"w-12 h-12 rounded-2xl bg-white/30 backdrop-blur-md flex items-center justify-center text-slate-900 text-2xl font-bold\">\n                            💡\n                        </div>\n                        <div>\n                            <h3 class=\"font-extrabold text-lg text-slate-950\">UNUTMAYALIM! (Sınav İpucu)</h3>\n                            <p class=\"text-xs text-slate-900/90 font-medium\">\n                                Kur'an-ı Kerim <strong>610 yılı Kadir Gecesi'nde</strong> indirilmeye başlanmış, <strong>23 yılda</strong> tamamlanmış <strong>114 surelik</strong> ilahi kitaptır. Okumaya <strong>İstiaze</strong> (Eûzü) ve <strong>Besmele</strong> ile başlanır; okunurken <strong>abdestli olmaya</strong> ve <strong>saygıyla dinlemeye</strong> özen gösterilir!\n                            </p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n\n    </main>\n\n    <!-- FOOTER / MEB SADAKAT İMZASI -->\n    <footer class=\"max-w-7xl mx-auto px-4 mt-8 text-center text-xs text-slate-400\">\n        <p>MEB Din Kültürü ve Ahlak Bilgisi 5. Sınıf Ders Kitabı Kaynak Metnine %100 Sadık Kalınarak Hazırlanmıştır.</p>\n    </footer>\n\n    <!-- INTERACTIVITY SCRIPT -->\n    <script>\n        // Tab Değiştirme Fonksiyonu\n        function switchTab(tabId) {\n            // Tüm içerikleri gizle\n            document.getElementById('tab1').classList.add('hidden');\n            document.getElementById('tab2').classList.add('hidden');\n            document.getElementById('tab3').classList.add('hidden');\n\n            // Tüm buton pasifleşti\n            document.getElementById('btn-tab1').classList.remove('active');\n            document.getElementById('btn-tab2').classList.remove('active');\n            document.getElementById('btn-tab3').classList.remove('active');\n\n            // Aktif olanı göster\n            document.getElementById(tabId).classList.remove('hidden');\n            document.getElementById('btn-' + tabId).classList.add('active');\n        }\n\n        // İnteraktif Kavram Seçim Etkinliği\n        function toggleConcept(btn) {\n            const icon = btn.querySelector('.icon-check');\n            if (icon.classList.contains('fa-square')) {\n                icon.classList.remove('fa-square', 'fa-regular');\n                icon.classList.add('fa-square-check', 'fa-solid', 'text-emerald-600');\n                btn.classList.add('bg-emerald-50', 'border-emerald-300', 'text-emerald-900');\n            } else {\n                icon.classList.remove('fa-square-check', 'fa-solid', 'text-emerald-600');\n                icon.classList.add('fa-square', 'fa-regular');\n                btn.classList.remove('bg-emerald-50', 'border-emerald-300', 'text-emerald-900');\n            }\n        }\n    </script>\n</body>\n</html>",
