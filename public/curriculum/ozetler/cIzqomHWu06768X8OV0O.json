{
  "htmlContent": "<!DOCTYPE html>\n<html lang=\"tr\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>5. Sınıf DKAB - Sübhaneke ve Rabbena Duaları</title>\n  <!-- Tailwind CSS CDN -->\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <!-- FontAwesome CDN -->\n  <link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css\" />\n  <!-- Google Fonts -->\n  <link href=\"https://fonts.googleapis.com/css2?family=Amiri:ital,wght@0,400;0,700;1,400&family=Outfit:wght@300;400;500;600;700;800&display=swap\" rel=\"stylesheet\">\n  \n  <script>\n    tailwind.config = {\n      theme: {\n        extend: {\n          colors: {\n            meb: {\n              green: '#0D6EFD',\n              emerald: '#059669',\n              dark: '#064E3B',\n              gold: '#D97706',\n              accent: '#10B981',\n              bg: '#F0FDF4'\n            }\n          },\n          fontFamily: {\n            sans: ['Outfit', 'sans-serif'],\n            arabic: ['Amiri', 'serif']\n          }\n        }\n      }\n    }\n  </script>\n  <style>\n    .arabic-text {\n      font-family: 'Amiri', serif;\n      direction: rtl;\n    }\n    .custom-scrollbar::-webkit-scrollbar {\n      width: 6px;\n    }\n    .custom-scrollbar::-webkit-scrollbar-track {\n      background: #f1f1f1;\n      border-radius: 10px;\n    }\n    .custom-scrollbar::-webkit-scrollbar-thumb {\n      background: #059669;\n      border-radius: 10px;\n    }\n  </style>\n</head>\n<body class=\"bg-slate-50 text-slate-800 font-sans antialiased min-h-screen selection:bg-emerald-500 selection:text-white pb-12\">\n\n  <!-- AKILLI TAHTA ÜST BİLGİ VE BAŞLIK BARI -->\n  <header class=\"bg-gradient-to-r from-emerald-900 via-emerald-800 to-teal-900 text-white shadow-xl sticky top-0 z-50 border-b-4 border-amber-400\">\n    <div class=\"max-w-7xl mx-auto px-4 py-3 flex flex-wrap justify-between items-center gap-2\">\n      <div class=\"flex items-center space-x-3\">\n        <span class=\"bg-amber-400 text-emerald-950 px-3 py-1 rounded-full text-xs font-extrabold tracking-wider uppercase shadow-md\">MEB Müfredatı</span>\n        <span class=\"bg-emerald-700/80 text-emerald-100 text-xs px-3 py-1 rounded-full font-medium\">5. Sınıf • Kur'an-ı Kerim</span>\n      </div>\n      <h1 class=\"text-lg md:text-xl font-bold tracking-tight text-amber-200\">1. TEMA: Sübhaneke Duası ve Rabbena Duaları ile Anlamları</h1>\n      <div class=\"flex items-center space-x-2 text-xs\">\n        <span class=\"bg-emerald-950/60 px-3 py-1.5 rounded-lg border border-emerald-600/40 text-emerald-200\"><i class=\"fa-solid fa-chalkboard-user mr-1 text-amber-400\"></i> Akıllı Tahta İnteraktif Özet</span>\n      </div>\n    </div>\n  </header>\n\n  <main class=\"max-w-7xl mx-auto px-4 py-6 space-y-8\">\n\n    <!-- 1. KAZANIMLAR VE TEMEL KAVRAMLAR SEKSİYONU -->\n    <section class=\"grid grid-cols-1 md:grid-cols-4 gap-4\">\n      \n      <!-- Kavram 1: Dua -->\n      <div class=\"bg-white rounded-2xl p-5 shadow-sm border border-emerald-100 hover:shadow-md transition-all duration-300 relative overflow-hidden group\">\n        <div class=\"absolute -right-3 -top-3 w-16 h-16 bg-emerald-50 rounded-full group-hover:scale-125 transition-transform duration-500\"></div>\n        <div class=\"flex items-center space-x-3 mb-2 relative z-10\">\n          <div class=\"w-10 h-10 rounded-xl bg-emerald-600 text-white flex items-center justify-center font-bold shadow-md shadow-emerald-200\">\n            <i class=\"fa-solid fa-hands-praying\"></i>\n          </div>\n          <div>\n            <h3 class=\"font-bold text-emerald-900\">Dua</h3>\n            <span class=\"text-[10px] text-emerald-600 font-semibold uppercase tracking-wider\">Temel Kavram</span>\n          </div>\n        </div>\n        <p class=\"text-xs text-slate-600 leading-relaxed relative z-10\">\n          <strong class=\"text-slate-800\">Sözlük:</strong> Çağırmak, seslenmek, istemek ve yardım talep etmek.<br>\n          <strong class=\"text-slate-800\">Terim:</strong> Müminlerin sevgi ve saygıyla Yüce Allah'a isteklerini ileterek O'ndan yardım dilemesidir.\n        </p>\n      </div>\n\n      <!-- Kavram 2: Tespih -->\n      <div class=\"bg-white rounded-2xl p-5 shadow-sm border border-emerald-100 hover:shadow-md transition-all duration-300 relative overflow-hidden group\">\n        <div class=\"absolute -right-3 -top-3 w-16 h-16 bg-teal-50 rounded-full group-hover:scale-125 transition-transform duration-500\"></div>\n        <div class=\"flex items-center space-x-3 mb-2 relative z-10\">\n          <div class=\"w-10 h-10 rounded-xl bg-teal-600 text-white flex items-center justify-center font-bold shadow-md shadow-teal-200\">\n            <i class=\"fa-solid fa-sparkles\"></i>\n          </div>\n          <div>\n            <h3 class=\"font-bold text-teal-900\">Tespih</h3>\n            <span class=\"text-[10px] text-teal-600 font-semibold uppercase tracking-wider\">İnanç Kavramı</span>\n          </div>\n        </div>\n        <p class=\"text-xs text-slate-600 leading-relaxed relative z-10\">\n          Allah'ı (cc) her türlü eksiklikten uzak tutmak; O'nun yüceliğine layık olmayan kusur ve noksanlıklardan uzak olduğuna kalpten inanmak ve bunu söz ile ifade etmektir.\n        </p>\n      </div>\n\n      <!-- Kavram 3: Tevhit -->\n      <div class=\"bg-white rounded-2xl p-5 shadow-sm border border-emerald-100 hover:shadow-md transition-all duration-300 relative overflow-hidden group\">\n        <div class=\"absolute -right-3 -top-3 w-16 h-16 bg-amber-50 rounded-full group-hover:scale-125 transition-transform duration-500\"></div>\n        <div class=\"flex items-center space-x-3 mb-2 relative z-10\">\n          <div class=\"w-10 h-10 rounded-xl bg-amber-500 text-white flex items-center justify-center font-bold shadow-md shadow-amber-200\">\n            <i class=\"fa-solid fa-kaaba\"></i>\n          </div>\n          <div>\n            <h3 class=\"font-bold text-amber-900\">Tevhit</h3>\n            <span class=\"text-[10px] text-amber-600 font-semibold uppercase tracking-wider\">Temel İnanç Esası</span>\n          </div>\n        </div>\n        <p class=\"text-xs text-slate-600 leading-relaxed relative z-10\">\n          Allah'tan (cc) başka hiçbir ilahın olmadığını kabul etmektir. Sübhaneke duasının sonundaki <em class=\"text-amber-800 font-medium\">\"Ve lâ ilâhe ğayruk\"</em> cümlesi tevhidi vurgular.\n        </p>\n      </div>\n\n      <!-- Kavram 4: İstiğfar -->\n      <div class=\"bg-white rounded-2xl p-5 shadow-sm border border-emerald-100 hover:shadow-md transition-all duration-300 relative overflow-hidden group\">\n        <div class=\"absolute -right-3 -top-3 w-16 h-16 bg-indigo-50 rounded-full group-hover:scale-125 transition-transform duration-500\"></div>\n        <div class=\"flex items-center space-x-3 mb-2 relative z-10\">\n          <div class=\"w-10 h-10 rounded-xl bg-indigo-600 text-white flex items-center justify-center font-bold shadow-md shadow-indigo-200\">\n            <i class=\"fa-solid fa-heart-shield\"></i>\n          </div>\n          <div>\n            <h3 class=\"font-bold text-indigo-900\">İstiğfar</h3>\n            <span class=\"text-[10px] text-indigo-600 font-semibold uppercase tracking-wider\">Bağışlanma</span>\n          </div>\n        </div>\n        <p class=\"text-xs text-slate-600 leading-relaxed relative z-10\">\n          <strong class=\"text-slate-800\">Sözlük:</strong> Örtme, perdeleme, kirden-pastan korunma, bağışlanma ve af isteğinde bulunma. (Örn: Rabbenağfirli duası).\n        </p>\n      </div>\n\n    </section>\n\n    <!-- 2. AYET Spotlight (KAYNAK METİNDEKİ AYETLER) -->\n    <section class=\"bg-gradient-to-br from-emerald-900 to-teal-950 text-white rounded-3xl p-6 shadow-xl border border-emerald-700/50 relative overflow-hidden\">\n      <div class=\"absolute -right-10 -bottom-10 opacity-10 text-9xl\">\n        <i class=\"fa-solid fa-quran\"></i>\n      </div>\n      \n      <div class=\"flex flex-col md:flex-row items-center justify-between gap-6 relative z-10\">\n        <div class=\"space-y-3 md:w-2/3\">\n          <div class=\"inline-flex items-center space-x-2 bg-amber-400/20 text-amber-300 px-3 py-1 rounded-full text-xs font-semibold\">\n            <i class=\"fa-solid fa-book-quran text-amber-400\"></i>\n            <span>Kur'an-ı Kerim'den Dua İlkeleri</span>\n          </div>\n          <h2 class=\"text-xl font-bold text-emerald-100\">Yüce Allah Kullarına Çok Yakındır</h2>\n          <blockquote class=\"italic text-slate-200 text-sm md:text-base border-l-4 border-amber-400 pl-4 py-1\">\n            \"Kullarım sana, beni sorduğunda (söyle onlara): Ben çok yakınım. Bana dua ettiği vakit dua edenin dileğine karşılık veririm...\"\n          </blockquote>\n          <div class=\"flex flex-wrap gap-2 text-xs text-emerald-300 pt-2\">\n            <span class=\"bg-emerald-800/80 px-2.5 py-1 rounded-lg border border-emerald-600\"><i class=\"fa-solid fa-check mr-1 text-amber-400\"></i> Zor zamanda ve hayatın her anında dua edilir.</span>\n            <span class=\"bg-emerald-800/80 px-2.5 py-1 rounded-lg border border-emerald-600\"><i class=\"fa-solid fa-check mr-1 text-amber-400\"></i> Allah dualara mutlaka karşılık verir.</span>\n          </div>\n        </div>\n\n        <div class=\"bg-emerald-800/50 backdrop-blur-sm p-4 rounded-2xl border border-emerald-600/50 md:w-1/3 w-full\">\n          <h4 class=\"text-xs font-bold text-amber-300 uppercase tracking-wider mb-2 flex items-center\">\n            <i class=\"fa-solid fa-scale-balanced mr-2\"></i> Dünya - Ahiret Dengesi\n          </h4>\n          <p class=\"text-xs text-emerald-100 italic leading-relaxed\">\n            \"Allah’ın sana verdiği şeylerde ahiret yurdunu ara. Dünyadan da nasibini unutma...\"\n          </p>\n          <p class=\"text-[11px] text-emerald-300 mt-2 font-medium\">\n            💡 Müslümanlar dünya ile ahiret arasında tam bir denge kurmalıdır.\n          </p>\n        </div>\n      </div>\n    </section>\n\n    <!-- 3. INTERAKTİF SEKMELER: SÜBHANEKE VE RABBENA DUALARI -->\n    <section class=\"bg-white rounded-3xl shadow-lg border border-slate-200/80 overflow-hidden\">\n      <!-- Sekme Butonları -->\n      <div class=\"flex border-b border-slate-200 bg-slate-100/70 p-1.5 gap-1 overflow-x-auto\">\n        <button id=\"tab-subhaneke-btn\" onclick=\"switchTab('subhaneke')\" class=\"flex-1 py-3 px-4 rounded-2xl font-bold text-sm transition-all duration-300 flex items-center justify-center space-x-2 bg-white text-emerald-800 shadow-sm border border-slate-200\">\n          <i class=\"fa-solid fa-star text-amber-500\"></i>\n          <span>1.5.1. Sübhaneke Duası</span>\n        </button>\n        <button id=\"tab-rabbena-btn\" onclick=\"switchTab('rabbena')\" class=\"flex-1 py-3 px-4 rounded-2xl font-bold text-sm transition-all duration-300 flex items-center justify-center space-x-2 text-slate-600 hover:text-emerald-800\">\n          <i class=\"fa-solid fa-hands-holding-child text-emerald-600\"></i>\n          <span>1.5.2. Rabbena Duaları</span>\n        </button>\n      </div>\n\n      <div class=\"p-6\">\n        <!-- SEKME 1: SÜBHANEKE DUASI -->\n        <div id=\"tab-subhaneke\" class=\"space-y-6\">\n          \n          <div class=\"bg-emerald-50/60 rounded-2xl p-6 border border-emerald-100\">\n            <div class=\"flex flex-col md:flex-row justify-between items-center mb-4 pb-4 border-b border-emerald-200/60 gap-4\">\n              <div>\n                <span class=\"bg-emerald-600 text-white text-[10px] uppercase font-bold px-2.5 py-1 rounded-md\">Hz. Peygamber'in (sav) Öğrettiği Dua</span>\n                <h3 class=\"text-xl font-bold text-emerald-950 mt-1\">Sübhaneke Duası</h3>\n              </div>\n              <div class=\"text-xs text-slate-500 italic bg-white px-3 py-1.5 rounded-lg border border-emerald-200\">\n                <i class=\"fa-solid fa-info-circle text-emerald-600 mr-1\"></i> Namazda ilk tekbirden sonra okunan ilk duadır.\n              </div>\n            </div>\n\n            <!-- Arapça Metin -->\n            <div class=\"bg-white p-6 rounded-2xl shadow-inner border border-emerald-100 text-center space-y-3\">\n              <p class=\"text-xs font-bold text-emerald-600 tracking-wider\">ARAPÇA OKUNUŞU</p>\n              <p class=\"arabic-text text-2xl md:text-3xl text-emerald-950 font-bold leading-loose py-2\">\n                سُبْحَانَكَ اللّٰهُمَّ وَبِحَمْدِكَ وَتَبَارَكَ اسْمُكَ وَتَعَالٰى جَدُّكَ <span class=\"text-amber-600\">(وَجَلَّ ثَنَٓاؤُكَ)</span> وَلَا اِلٰهَ غَيْرُكَ\n              </p>\n            </div>\n\n            <!-- Türkçe Anlamı -->\n            <div class=\"mt-4 bg-white p-5 rounded-2xl border border-emerald-100\">\n              <h4 class=\"text-xs font-bold text-emerald-700 uppercase tracking-wider mb-2 flex items-center\">\n                <i class=\"fa-solid fa-language mr-1.5\"></i> Türkçe Anlamı\n              </h4>\n              <p class=\"text-sm text-slate-700 font-medium leading-relaxed\">\n                \"Sen eksik sıfatlardan uzaksın Allah’ım! Seni daima böyle tenzih eder ve sana hamdederim. Senin adın mübarektir. İzzet ve celalin yücedir. <span class=\"text-amber-700 font-bold\">(Senin şanın yücedir.)</span> Senden başka ilah yoktur.\"\n              </p>\n            </div>\n          </div>\n\n          <!-- BİLGİ GÖRSELİ 1.1: SÜBHANEKE'NİN OKUNDUĞU YERLER -->\n          <div class=\"bg-gradient-to-r from-slate-900 to-emerald-950 text-white rounded-2xl p-6 shadow-md\">\n            <h4 class=\"text-base font-bold text-amber-300 mb-4 flex items-center\">\n              <i class=\"fa-solid fa-clock-rotate-left text-amber-400 mr-2\"></i> Bilgi Görseli 1.1: Sübhaneke Duasının Okunduğu Yerler\n            </h4>\n            <div class=\"grid grid-cols-1 md:grid-cols-5 gap-3\">\n              \n              <div class=\"bg-emerald-900/60 p-3.5 rounded-xl border border-emerald-700/50 flex flex-col justify-between hover:bg-emerald-800/60 transition-colors\">\n                <div class=\"text-amber-400 text-lg font-bold mb-1\">1</div>\n                <p class=\"text-xs text-emerald-100\">Namazların **ilk rekâtında** Fatiha suresinden önce okunur.</p>\n              </div>\n\n              <div class=\"bg-emerald-900/60 p-3.5 rounded-xl border border-emerald-700/50 flex flex-col justify-between hover:bg-emerald-800/60 transition-colors\">\n                <div class=\"text-amber-400 text-lg font-bold mb-1\">2</div>\n                <p class=\"text-xs text-emerald-100\">İkindi namazının **sünnetinde**, 3. rekâtın başında Fatiha'dan önce okunur.</p>\n              </div>\n\n              <div class=\"bg-emerald-900/60 p-3.5 rounded-xl border border-emerald-700/50 flex flex-col justify-between hover:bg-emerald-800/60 transition-colors\">\n                <div class=\"text-amber-400 text-lg font-bold mb-1\">3</div>\n                <p class=\"text-xs text-emerald-100\">Yatsı namazının **ilk sünnetinde**, 3. rekâtın başında Fatiha'dan önce okunur.</p>\n              </div>\n\n              <div class=\"bg-emerald-900/60 p-3.5 rounded-xl border border-emerald-700/50 flex flex-col justify-between hover:bg-emerald-800/60 transition-colors\">\n                <div class=\"text-amber-400 text-lg font-bold mb-1\">4</div>\n                <p class=\"text-xs text-emerald-100\">Teravih 4 rekâtta bir selam veriliyorsa, **3. rekâtın başında** Fatiha'dan önce okunur.</p>\n              </div>\n\n              <div class=\"bg-amber-900/40 p-3.5 rounded-xl border border-amber-600/50 flex flex-col justify-between hover:bg-amber-800/50 transition-colors\">\n                <div class=\"text-amber-300 text-lg font-bold mb-1\"><i class=\"fa-solid fa-plus text-xs\"></i> Özel</div>\n                <p class=\"text-xs text-amber-100\">Cenaze namazında 1. tekbirden sonra <strong class=\"text-amber-300\">\"Ve celle senâük\"</strong> eklenerek okunur.</p>\n              </div>\n\n            </div>\n          </div>\n\n        </div>\n\n        <!-- SEKME 2: RABBENA DUALARI -->\n        <div id=\"tab-rabbena\" class=\"hidden space-y-6\">\n          \n          <div class=\"bg-slate-50 p-4 rounded-2xl border border-slate-200 text-xs text-slate-600 flex items-center space-x-3\">\n            <i class=\"fa-solid fa-circle-info text-emerald-600 text-lg\"></i>\n            <span><strong>Önemli Bilgi:</strong> Rabbena Âtina ve Rabbenağfirli duaları namazların <strong>son oturuş kısmında</strong> Tahiyyat, Salli ve Barik dualarından sonra okunur.</span>\n          </div>\n\n          <div class=\"grid grid-cols-1 lg:grid-cols-3 gap-6\">\n            \n            <!-- 1. Rabbena Âtina -->\n            <div class=\"bg-white rounded-2xl border border-teal-100 shadow-sm overflow-hidden flex flex-col justify-between\">\n              <div class=\"p-5 space-y-3\">\n                <div class=\"flex justify-between items-center border-b pb-2 border-slate-100\">\n                  <h4 class=\"font-bold text-teal-900\">Rabbena Âtina Duası</h4>\n                  <span class=\"text-[10px] bg-teal-100 text-teal-800 font-bold px-2 py-0.5 rounded-full\">Bakara Suresi 201</span>\n                </div>\n                <div class=\"bg-teal-50/50 p-3 rounded-xl text-center\">\n                  <p class=\"arabic-text text-xl text-teal-950 font-bold leading-relaxed\">\n                    رَبَّنَٓا اٰتِنَا فِي الدُّنْيَا حَسَنَةً وَفِي الْاٰخِرَةِ حَسَنَةً وَقِنَا عَذَابَ النَّارِ\n                  </p>\n                </div>\n                <p class=\"text-xs text-slate-700 leading-relaxed\">\n                  <strong>Anlamı:</strong> \"Rabbimiz! Bize dünyada da iyilik ver, ahirette de iyilik ver ve bizi ateş azabından koru.\"\n                </p>\n              </div>\n              <div class=\"bg-teal-50 p-3 text-[11px] text-teal-800 border-t border-teal-100\">\n                <i class=\"fa-solid fa-check text-emerald-600 mr-1\"></i> Hz. Muhammed'in (sav) sık sık tekrar ettiği, dünya-ahiret dengesini kuran duadır.\n              </div>\n            </div>\n\n            <!-- 2. Rabbicalni -->\n            <div class=\"bg-white rounded-2xl border border-emerald-100 shadow-sm overflow-hidden flex flex-col justify-between\">\n              <div class=\"p-5 space-y-3\">\n                <div class=\"flex justify-between items-center border-b pb-2 border-slate-100\">\n                  <h4 class=\"font-bold text-emerald-900\">Rabbicalni Duası</h4>\n                  <span class=\"text-[10px] bg-emerald-100 text-emerald-800 font-bold px-2 py-0.5 rounded-full\">İbrahim Suresi 40</span>\n                </div>\n                <div class=\"bg-emerald-50/50 p-3 rounded-xl text-center\">\n                  <p class=\"arabic-text text-xl text-emerald-950 font-bold leading-relaxed\">\n                    رَبِّ اجْعَلْن۪ي مُق۪يمَ الصَّلٰوةِ وَمِنْ ذُرِّيَّت۪ي رَبَّنَا وَتَقَبَّلْ دُعَٓاءِ\n                  </p>\n                </div>\n                <p class=\"text-xs text-slate-700 leading-relaxed\">\n                  <strong>Anlamı:</strong> \"Rabbim! Beni ve soyumdan gelecek olanları namazı devamlı kılanlardan eyle. Rabbimiz, duamı kabul et.\"\n                </p>\n              </div>\n              <div class=\"bg-emerald-50 p-3 text-[11px] text-emerald-800 border-t border-emerald-100\">\n                <i class=\"fa-solid fa-check text-emerald-600 mr-1\"></i> Hz. İbrahim'in kendisi ve nesli için ettiği namaz ve ibadet duasıdır.\n              </div>\n            </div>\n\n            <!-- 3. Rabbenağfirli -->\n            <div class=\"bg-white rounded-2xl border border-indigo-100 shadow-sm overflow-hidden flex flex-col justify-between\">\n              <div class=\"p-5 space-y-3\">\n                <div class=\"flex justify-between items-center border-b pb-2 border-slate-100\">\n                  <h4 class=\"font-bold text-indigo-900\">Rabbenağfirli Duası</h4>\n                  <span class=\"text-[10px] bg-indigo-100 text-indigo-800 font-bold px-2 py-0.5 rounded-full\">İbrahim Suresi 41</span>\n                </div>\n                <div class=\"bg-indigo-50/50 p-3 rounded-xl text-center\">\n                  <p class=\"arabic-text text-xl text-indigo-950 font-bold leading-relaxed\">\n                    رَبَّنَا اغْفِرْ ل۪ي وَلِوَالِدَيَّ وَلِلْمُؤْمِن۪ينَ يَوْمَ يَقُومُ الْحِسَابُ\n                  </p>\n                </div>\n                <p class=\"text-xs text-slate-700 leading-relaxed\">\n                  <strong>Anlamı:</strong> \"Rabbimiz! Hesap görülecek günde beni, ana babamı ve inananları bağışla.\"\n                </p>\n              </div>\n              <div class=\"bg-indigo-50 p-3 text-[11px] text-indigo-800 border-t border-indigo-100\">\n                <i class=\"fa-solid fa-check text-indigo-600 mr-1\"></i> Manevi değeri yüksek bir <strong>istiğfar duasıdır</strong> (Anne-baba ve müminler için).\n              </div>\n            </div>\n\n          </div>\n\n        </div>\n      </div>\n    </section>\n\n    <!-- 4. İNTERAKTİF KONTROL NOKTASI (EŞLEŞTİRME ETKİNLİĞİ) -->\n    <section class=\"bg-white rounded-3xl p-6 shadow-md border border-slate-200\">\n      <div class=\"flex items-center justify-between mb-4 pb-3 border-b border-slate-100\">\n        <div>\n          <span class=\"text-xs font-bold text-emerald-600 uppercase tracking-wider\">İnteraktif Sınıf Etkinliği</span>\n          <h3 class=\"text-lg font-bold text-slate-900\">Kontrol Noktası: Cümle-Kavram Eşleştirme</h3>\n        </div>\n        <button onclick=\"resetMatching()\" class=\"text-xs bg-slate-100 text-slate-600 hover:bg-slate-200 px-3 py-1.5 rounded-lg transition-colors font-semibold\">\n          <i class=\"fa-solid fa-rotate-left mr-1\"></i> Sıfırla\n        </button>\n      </div>\n\n      <p class=\"text-xs text-slate-500 mb-4\">Cümlelerin karşısındaki doğru kavramı seçiniz ve cevabınızı kontrol ediniz.</p>\n\n      <div class=\"space-y-3\" id=\"matching-container\">\n\n        <!-- Cümle 1 -->\n        <div class=\"flex flex-col sm:flex-row sm:items-center justify-between p-3 rounded-xl bg-slate-50 border border-slate-200/70 gap-2\" data-answer=\"E\">\n          <span class=\"text-xs font-medium text-slate-800 flex-1\">1. Müslümanların dünya ve ahiret iyiliğini istediği duadır.</span>\n          <div class=\"flex items-center space-x-2\">\n            <select class=\"match-select text-xs p-2 rounded-lg border border-slate-300 bg-white font-semibold text-slate-700 focus:outline-none focus:ring-2 focus:ring-emerald-500\">\n              <option value=\"\">Kavram Seçin...</option>\n              <option value=\"A\">A) Rabbenağfirli</option>\n              <option value=\"B\">B) Dua</option>\n              <option value=\"C\">C) Rabbicalni</option>\n              <option value=\"Ç\">Ç) Sübhaneke</option>\n              <option value=\"D\">D) Tespih</option>\n              <option value=\"E\">E) Rabbena Âtina</option>\n              <option value=\"F\">F) İstiğfar</option>\n            </select>\n            <span class=\"result-icon text-sm\"></span>\n          </div>\n        </div>\n\n        <!-- Cümle 2 -->\n        <div class=\"flex flex-col sm:flex-row sm:items-center justify-between p-3 rounded-xl bg-slate-50 border border-slate-200/70 gap-2\" data-answer=\"Ç\">\n          <span class=\"text-xs font-medium text-slate-800 flex-1\">2. Namazların ilk rekâtında Fatiha suresinden önce okunan duadır.</span>\n          <div class=\"flex items-center space-x-2\">\n            <select class=\"match-select text-xs p-2 rounded-lg border border-slate-300 bg-white font-semibold text-slate-700 focus:outline-none focus:ring-2 focus:ring-emerald-500\">\n              <option value=\"\">Kavram Seçin...</option>\n              <option value=\"A\">A) Rabbenağfirli</option>\n              <option value=\"B\">B) Dua</option>\n              <option value=\"C\">C) Rabbicalni</option>\n              <option value=\"Ç\">Ç) Sübhaneke</option>\n              <option value=\"D\">D) Tespih</option>\n              <option value=\"E\">E) Rabbena Âtina</option>\n              <option value=\"F\">F) İstiğfar</option>\n            </select>\n            <span class=\"result-icon text-sm\"></span>\n          </div>\n        </div>\n\n        <!-- Cümle 3 -->\n        <div class=\"flex flex-col sm:flex-row sm:items-center justify-between p-3 rounded-xl bg-slate-50 border border-slate-200/70 gap-2\" data-answer=\"B\">\n          <span class=\"text-xs font-medium text-slate-800 flex-1\">3. Yüce Allah'a isteklerin iletilerek O'ndan yardım istenmesidir.</span>\n          <div class=\"flex items-center space-x-2\">\n            <select class=\"match-select text-xs p-2 rounded-lg border border-slate-300 bg-white font-semibold text-slate-700 focus:outline-none focus:ring-2 focus:ring-emerald-500\">\n              <option value=\"\">Kavram Seçin...</option>\n              <option value=\"A\">A) Rabbenağfirli</option>\n              <option value=\"B\">B) Dua</option>\n              <option value=\"C\">C) Rabbicalni</option>\n              <option value=\"Ç\">Ç) Sübhaneke</option>\n              <option value=\"D\">D) Tespih</option>\n              <option value=\"E\">E) Rabbena Âtina</option>\n              <option value=\"F\">F) İstiğfar</option>\n            </select>\n            <span class=\"result-icon text-sm\"></span>\n          </div>\n        </div>\n\n        <!-- Cümle 4 -->\n        <div class=\"flex flex-col sm:flex-row sm:items-center justify-between p-3 rounded-xl bg-slate-50 border border-slate-200/70 gap-2\" data-answer=\"C\">\n          <span class=\"text-xs font-medium text-slate-800 flex-1\">4. Hz. İbrahim'in Yüce Allah'tan kendisi ve sonraki nesillerinin namaz kılanlardan olması için ettiği duadır.</span>\n          <div class=\"flex items-center space-x-2\">\n            <select class=\"match-select text-xs p-2 rounded-lg border border-slate-300 bg-white font-semibold text-slate-700 focus:outline-none focus:ring-2 focus:ring-emerald-500\">\n              <option value=\"\">Kavram Seçin...</option>\n              <option value=\"A\">A) Rabbenağfirli</option>\n              <option value=\"B\">B) Dua</option>\n              <option value=\"C\">C) Rabbicalni</option>\n              <option value=\"Ç\">Ç) Sübhaneke</option>\n              <option value=\"D\">D) Tespih</option>\n              <option value=\"E\">E) Rabbena Âtina</option>\n              <option value=\"F\">F) İstiğfar</option>\n            </select>\n            <span class=\"result-icon text-sm\"></span>\n          </div>\n        </div>\n\n        <!-- Cümle 5 -->\n        <div class=\"flex flex-col sm:flex-row sm:items-center justify-between p-3 rounded-xl bg-slate-50 border border-slate-200/70 gap-2\" data-answer=\"A\">\n          <span class=\"text-xs font-medium text-slate-800 flex-1\">5. Müslümanların başta anne ve babaları olmak üzere tüm sevdikleri için ettikleri duadır.</span>\n          <div class=\"flex items-center space-x-2\">\n            <select class=\"match-select text-xs p-2 rounded-lg border border-slate-300 bg-white font-semibold text-slate-700 focus:outline-none focus:ring-2 focus:ring-emerald-500\">\n              <option value=\"\">Kavram Seçin...</option>\n              <option value=\"A\">A) Rabbenağfirli</option>\n              <option value=\"B\">B) Dua</option>\n              <option value=\"C\">C) Rabbicalni</option>\n              <option value=\"Ç\">Ç) Sübhaneke</option>\n              <option value=\"D\">D) Tespih</option>\n              <option value=\"E\">E) Rabbena Âtina</option>\n              <option value=\"F\">F) İstiğfar</option>\n            </select>\n            <span class=\"result-icon text-sm\"></span>\n          </div>\n        </div>\n\n        <!-- Cümle 6 -->\n        <div class=\"flex flex-col sm:flex-row sm:items-center justify-between p-3 rounded-xl bg-slate-50 border border-slate-200/70 gap-2\" data-answer=\"D\">\n          <span class=\"text-xs font-medium text-slate-800 flex-1\">6. Allah'ı (cc) her türlü eksiklikten uzak tutarak O'nun yüceliğini ifade eden kavramdır.</span>\n          <div class=\"flex items-center space-x-2\">\n            <select class=\"match-select text-xs p-2 rounded-lg border border-slate-300 bg-white font-semibold text-slate-700 focus:outline-none focus:ring-2 focus:ring-emerald-500\">\n              <option value=\"\">Kavram Seçin...</option>\n              <option value=\"A\">A) Rabbenağfirli</option>\n              <option value=\"B\">B) Dua</option>\n              <option value=\"C\">C) Rabbicalni</option>\n              <option value=\"Ç\">Ç) Sübhaneke</option>\n              <option value=\"D\">D) Tespih</option>\n              <option value=\"E\">E) Rabbena Âtina</option>\n              <option value=\"F\">F) İstiğfar</option>\n            </select>\n            <span class=\"result-icon text-sm\"></span>\n          </div>\n        </div>\n\n        <!-- Cümle 7 -->\n        <div class=\"flex flex-col sm:flex-row sm:items-center justify-between p-3 rounded-xl bg-slate-50 border border-slate-200/70 gap-2\" data-answer=\"F\">\n          <span class=\"text-xs font-medium text-slate-800 flex-1\">7. Yüce Allah'tan bağışlanma ve af isteğinde bulunma anlamına gelen kavramdır.</span>\n          <div class=\"flex items-center space-x-2\">\n            <select class=\"match-select text-xs p-2 rounded-lg border border-slate-300 bg-white font-semibold text-slate-700 focus:outline-none focus:ring-2 focus:ring-emerald-500\">\n              <option value=\"\">Kavram Seçin...</option>\n              <option value=\"A\">A) Rabbenağfirli</option>\n              <option value=\"B\">B) Dua</option>\n              <option value=\"C\">C) Rabbicalni</option>\n              <option value=\"Ç\">Ç) Sübhaneke</option>\n              <option value=\"D\">D) Tespih</option>\n              <option value=\"E\">E) Rabbena Âtina</option>\n              <option value=\"F\">F) İstiğfar</option>\n            </select>\n            <span class=\"result-icon text-sm\"></span>\n          </div>\n        </div>\n\n      </div>\n\n      <div class=\"mt-4 text-center\">\n        <button onclick=\"checkAnswers()\" class=\"bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs px-6 py-2.5 rounded-xl shadow-md transition-transform active:scale-95\">\n          <i class=\"fa-solid fa-square-check mr-2\"></i> Cevapları Kontrol Et\n        </button>\n      </div>\n    </section>\n\n    <!-- 5. AKILDA KALICI PÜF NOKTA VE İPUÇLARI -->\n    <section class=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n      \n      <!-- Kutucuk 1: Unutmayalım -->\n      <div class=\"bg-gradient-to-r from-amber-500 to-orange-500 text-white rounded-2xl p-5 shadow-lg flex items-start space-x-4\">\n        <div class=\"w-12 h-12 bg-white/20 rounded-xl flex items-center justify-center shrink-0 text-2xl text-white\">\n          <i class=\"fa-solid fa-lightbulb\"></i>\n        </div>\n        <div>\n          <h4 class=\"font-extrabold text-white text-sm uppercase tracking-wider mb-1\">🎯 Unutmayalım! (Sınav İpucu)</h4>\n          <p class=\"text-xs text-amber-50 leading-relaxed\">\n            • <strong>Sübhaneke:</strong> Sadece Cenaze namazında <span class=\"bg-amber-700/50 px-1 rounded\">\"Ve celle senâük\"</span> eklenerek okunur.<br>\n            • <strong>Rabbena Duaları:</strong> Namazın <u>son oturuşunda</u> Tahiyyat, Salli ve Barik dualarından sonra okunur.<br>\n            • <strong>Hz. İbrahim'in Duaları:</strong> Rabbicalni ve Rabbenağfirli duaları Kur'an-ı Kerim'de Hz. İbrahim'in (as) dualarıdır.\n          </p>\n        </div>\n      </div>\n\n      <!-- Kutucuk 2: Özet Hatırlatma -->\n      <div class=\"bg-gradient-to-r from-emerald-600 to-teal-700 text-white rounded-2xl p-5 shadow-lg flex items-start space-x-4\">\n        <div class=\"w-12 h-12 bg-white/20 rounded-xl flex items-center justify-center shrink-0 text-2xl text-white\">\n          <i class=\"fa-solid fa-bookmark\"></i>\n        </div>\n        <div>\n          <h4 class=\"font-extrabold text-white text-sm uppercase tracking-wider mb-1\">📌 Farklı Kaydet (Not Alanı)</h4>\n          <p class=\"text-xs text-emerald-50 leading-relaxed\">\n            Dua sadece istek bildirmek değil; Allah'ı anmak, O'na teslimiyet göstermek, af dilemek (istiğfar) ve O'nu eksikliklerden uzak tutmaktır (tespih).\n          </p>\n        </div>\n      </div>\n\n    </section>\n\n  </main>\n\n  <footer class=\"max-w-7xl mx-auto px-4 text-center text-xs text-slate-400 mt-6\">\n    MEB Din Kültürü ve Ahlak Bilgisi 5. Sınıf Ders Kitabı Kaynak Alınarak Hazırlanmıştır.\n  </footer>\n\n  <!-- İNTERAKTİF JS KODLARI -->\n  <script>\n    // Sekme Değiştirme Fonksiyonu\n    function switchTab(tabName) {\n      const subhanekeTab = document.getElementById('tab-subhaneke');\n      const rabbenaTab = document.getElementById('tab-rabbena');\n      const subhanekeBtn = document.getElementById('tab-subhaneke-btn');\n      const rabbenaBtn = document.getElementById('tab-rabbena-btn');\n\n      if (tabName === 'subhaneke') {\n        subhanekeTab.classList.remove('hidden');\n        rabbenaTab.classList.add('hidden');\n        \n        subhanekeBtn.className = \"flex-1 py-3 px-4 rounded-2xl font-bold text-sm transition-all duration-300 flex items-center justify-center space-x-2 bg-white text-emerald-800 shadow-sm border border-slate-200\";\n        rabbenaBtn.className = \"flex-1 py-3 px-4 rounded-2xl font-bold text-sm transition-all duration-300 flex items-center justify-center space-x-2 text-slate-600 hover:text-emerald-800\";\n      } else {\n        rabbenaTab.classList.remove('hidden');\n        subhanekeTab.classList.add('hidden');\n\n        rabbenaBtn.className = \"flex-1 py-3 px-4 rounded-2xl font-bold text-sm transition-all duration-300 flex items-center justify-center space-x-2 bg-white text-emerald-800 shadow-sm border border-slate-200\";\n        subhanekeBtn.className = \"flex-1 py-3 px-4 rounded-2xl font-bold text-sm transition-all duration-300 flex items-center justify-center space-x-2 text-slate-600 hover:text-emerald-800\";\n      }\n    }\n\n    // Eşleştirme Etkinliği Kontrol Fonksiyonu\n    function checkAnswers() {\n      const rows = document.querySelectorAll('#matching-container > div');\n      \n      rows.forEach(row => {\n        const expected = row.getAttribute('data-answer');\n        const select = row.querySelector('.match-select');\n        const iconSpan = row.querySelector('.result-icon');\n        const userSelect = select.value;\n\n        if (userSelect === \"\") {\n          iconSpan.innerHTML = '<i class=\"fa-solid fa-circle-minus text-slate-400\"></i>';\n          row.className = \"flex flex-col sm:flex-row sm:items-center justify-between p-3 rounded-xl bg-slate-50 border border-slate-200/70 gap-2\";\n        } else if (userSelect === expected) {\n          iconSpan.innerHTML = '<i class=\"fa-solid fa-circle-check text-emerald-600 text-lg\"></i>';\n          row.className = \"flex flex-col sm:flex-row sm:items-center justify-between p-3 rounded-xl bg-emerald-50 border border-emerald-300 gap-2\";\n        } else {\n          iconSpan.innerHTML = '<i class=\"fa-solid fa-circle-xmark text-rose-500 text-lg\"></i>';\n          row.className = \"flex flex-col sm:flex-row sm:items-center justify-between p-3 rounded-xl bg-rose-50 border border-rose-200 gap-2\";\n        }\n      });\n    }\n\n    // Sıfırlama\n    function resetMatching() {\n      const selects = document.querySelectorAll('.match-select');\n      const icons = document.querySelectorAll('.result-icon');\n      const rows = document.querySelectorAll('#matching-container > div');\n\n      selects.forEach(select => select.value = \"\");\n      icons.forEach(icon => icon.innerHTML = \"\");\n      rows.forEach(row => {\n        row.className = \"flex flex-col sm:flex-row sm:items-center justify-between p-3 rounded-xl bg-slate-50 border border-slate-200/70 gap-2\";\n      });\n    }\n  </script>\n\n</body>\n</html>",
