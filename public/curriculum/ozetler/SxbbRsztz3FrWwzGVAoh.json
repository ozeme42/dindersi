  "htmlContent": "<!DOCTYPE html>\n<html lang=\"tr\" class=\"scroll-smooth\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>5. Sınıf Kur'an-ı Kerim 1. Ünite Genel Tekrar ve Kavram Haritası</title>\n    <!-- Tailwind CSS CDN -->\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <!-- FontAwesome CDN -->\n    <link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css\">\n    <!-- Google Fonts -->\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n    <link href=\"https://fonts.googleapis.com/css2?family=Amiri:ital,wght@0,400;0,700;1,400&family=Inter:wght@300;400;500;600;700&display=swap\" rel=\"stylesheet\">\n    <style>\n        body { font-family: 'Inter', sans-serif; }\n        .font-arabic { font-family: 'Amiri', serif; }\n    </style>\n</head>\n<body class=\"bg-slate-50 text-slate-800 antialiased leading-relaxed min-h-screen\">\n\n    <!-- Üst Başlık & Header -->\n    <header class=\"bg-gradient-to-r from-emerald-800 via-teal-700 to-emerald-900 text-white shadow-xl sticky top-0 z-50\">\n        <div class=\"max-w-7xl mx-auto px-4 py-4 sm:px-6 lg:px-8 flex flex-col md:flex-row justify-between items-center gap-4\">\n            <div class=\"flex items-center space-x-3\">\n                <div class=\"w-12 h-12 rounded-xl bg-amber-400/20 border border-amber-300/40 flex items-center justify-center text-amber-300 text-2xl shadow-inner\">\n                    <i class=\"fa-solid font-bold fa-book-quran\"></i>\n                </div>\n                <div>\n                    <span class=\"text-xs font-semibold uppercase tracking-wider text-emerald-200\">MEB Din Kültürü ve İmam Hatip Müfredatı</span>\n                    <h1 class=\"text-xl sm:text-2xl font-bold tracking-tight\">1. TEMA: KUR'AN-I KERİM'İ TANIYORUM</h1>\n                </div>\n            </div>\n            <div class=\"flex items-center gap-2\">\n                <span class=\"px-3 py-1 rounded-full bg-emerald-700/60 border border-emerald-500/40 text-xs font-medium text-emerald-100\"><i class=\"fa-solid fa-graduation-cap mr-1\"></i> 5. Sınıf Ders Kitabı</span>\n                <span class=\"px-3 py-1 rounded-full bg-amber-500/20 border border-amber-400/40 text-xs font-medium text-amber-200\"><i class=\"fa-solid fa-chalkboard-user mr-1\"></i> Ünite Genel Tekrarı</span>\n            </div>\n        </div>\n    </header>\n\n    <!-- Ana İçerik Konteyneri -->\n    <main class=\"max-w-7xl mx-auto px-4 py-8 sm:px-6 lg:px-8 space-y-12\">\n\n        <!-- 1. HIZLI ERİŞİM VE ÜNİTE KAVRAM HARİTASI (VISUAL FLOW) -->\n        <section class=\"bg-white rounded-2xl p-6 sm:p-8 shadow-sm border border-slate-200/80\">\n            <div class=\"flex items-center space-x-3 mb-6 border-b border-slate-100 pb-4\">\n                <div class=\"w-10 h-10 rounded-lg bg-emerald-100 text-emerald-700 flex items-center justify-center text-lg font-bold\">\n                    <i class=\"fa-solid fa-sitemap\"></i>\n                </div>\n                <div>\n                    <h2 class=\"text-lg font-bold text-slate-900\">Ünite Genel Şeması & Kavram Haritası</h2>\n                    <p class=\"text-xs text-slate-500\">Ünitenin 5 temel konusunun birbiriyle olan hiyerarşik bağı</p>\n                </div>\n            </div>\n\n            <div class=\"grid grid-cols-1 md:grid-cols-5 gap-4\">\n                <!-- Konu 1 Card -->\n                <div class=\"bg-gradient-to-br from-emerald-50 to-teal-50/50 p-4 rounded-xl border border-emerald-200/60 hover:shadow-md transition\">\n                    <div class=\"text-xs font-bold text-emerald-700 uppercase tracking-wider mb-1\">1. KONU</div>\n                    <h3 class=\"font-bold text-slate-800 text-sm mb-2\"><i class=\"fa-solid fa-heart-pulse text-emerald-600 mr-1\"></i> Önemi & Adabı</h3>\n                    <ul class=\"text-xs text-slate-600 space-y-1\">\n                        <li>• İbadet Olarak Okuma</li>\n                        <li>• Abdestli Olmak</li>\n                        <li>• Eûzübesmele Çekmek</li>\n                        <li>• Saygıyla Dinlemek</li>\n                    </ul>\n                </div>\n                <!-- Konu 2 Card -->\n                <div class=\"bg-gradient-to-br from-teal-50 to-cyan-50/50 p-4 rounded-xl border border-teal-200/60 hover:shadow-md transition\">\n                    <div class=\"text-xs font-bold text-teal-700 uppercase tracking-wider mb-1\">2. KONU</div>\n                    <h3 class=\"font-bold text-slate-800 text-sm mb-2\"><i class=\"fa-solid fa-spell-check text-teal-600 mr-1\"></i> Harfler & Özellikleri</h3>\n                    <ul class=\"text-xs text-slate-600 space-y-1\">\n                        <li>• 28 Temel Harf</li>\n                        <li>• İnce & Kalın Harfler</li>\n                        <li>• Peltek Harfler (ث, ذ, ظ)</li>\n                        <li>• Mahreçler (Çıkış Yerleri)</li>\n                    </ul>\n                </div>\n                <!-- Konu 3 Card -->\n                <div class=\"bg-gradient-to-br from-cyan-50 to-sky-50/50 p-4 rounded-xl border border-cyan-200/60 hover:shadow-md transition\">\n                    <div class=\"text-xs font-bold text-cyan-700 uppercase tracking-wider mb-1\">3. KONU</div>\n                    <h3 class=\"font-bold text-slate-800 text-sm mb-2\"><i class=\"fa-solid fa-pen-nib text-cyan-600 mr-1\"></i> Harfleri Yazma</h3>\n                    <ul class=\"text-xs text-slate-600 space-y-1\">\n                        <li>• Başta, Ortada, Sonda</li>\n                        <li>• Birleşmeyen 6 Harf</li>\n                        <li>• Hemze (أ) & Yuvarlak Te (ة)</li>\n                        <li>• Sağdan Sola Yazım</li>\n                    </ul>\n                </div>\n                <!-- Konu 4 Card -->\n                <div class=\"bg-gradient-to-br from-indigo-50 to-blue-50/50 p-4 rounded-xl border border-indigo-200/60 hover:shadow-md transition\">\n                    <div class=\"text-xs font-bold text-indigo-700 uppercase tracking-wider mb-1\">4. KONU</div>\n                    <h3 class=\"font-bold text-slate-800 text-sm mb-2\"><i class=\"fa-solid fa-language text-indigo-600 mr-1\"></i> Harekeler</h3>\n                    <ul class=\"text-xs text-slate-600 space-y-1\">\n                        <li>• Üstün ( َ ) : e / a</li>\n                        <li>• Esre ( ِ ) : i / ı-i</li>\n                        <li>• Ötre ( ُ ) : u-ü / u</li>\n                        <li>• Ünlü Okutucu İşaretler</li>\n                    </ul>\n                </div>\n                <!-- Konu 5 Card -->\n                <div class=\"bg-gradient-to-br from-amber-50 to-orange-50/50 p-4 rounded-xl border border-amber-200/60 hover:shadow-md transition\">\n                    <div class=\"text-xs font-bold text-amber-700 uppercase tracking-wider mb-1\">5. KONU</div>\n                    <h3 class=\"font-bold text-slate-800 text-sm mb-2\"><i class=\"fa-solid fa-hands-praying text-amber-600 mr-1\"></i> Sure ve Dualar</h3>\n                    <ul class=\"text-xs text-slate-600 space-y-1\">\n                        <li>• Sübhaneke Duası</li>\n                        <li>• Rabbena Âtina</li>\n                        <li>• Rabbicalni Duası</li>\n                        <li>• Rabbenağfirli Duası</li>\n                    </ul>\n                </div>\n            </div>\n        </section>\n\n        <!-- 2. KAVRAMLAR KUTUSU (DICTIONARY CARDS) -->\n        <section class=\"space-y-4\">\n            <div class=\"flex items-center space-x-3\">\n                <div class=\"w-10 h-10 rounded-lg bg-amber-500 text-white flex items-center justify-center text-lg font-bold shadow-md\">\n                    <i class=\"fa-solid fa-key\"></i>\n                </div>\n                <div>\n                    <h2 class=\"text-xl font-bold text-slate-900\">Kavram Kutusu</h2>\n                    <p class=\"text-xs text-slate-500\">Ders kitabında geçen temel terimler ve anlamları</p>\n                </div>\n            </div>\n\n            <div class=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4\">\n                <!-- Kur'an -->\n                <div class=\"bg-white p-4 rounded-xl border border-slate-200 shadow-sm hover:border-emerald-400 transition\">\n                    <span class=\"px-2 py-0.5 rounded bg-emerald-100 text-emerald-800 text-xs font-bold\">Kur'an</span>\n                    <p class=\"text-xs text-slate-600 mt-2\">Arapçada \"okumak\" anlamına gelen \"karae\" fiilinden türemiştir. Yüce Allah tarafından Cebrail (as) aracılığıyla Hz. Muhammed'e (sav) gönderilen vahiylerden oluşan ilahi kitaptır. 114 sureden oluşur, Fâtiha ile başlayıp Nâs ile biter. 610 yılı Kadir Gecesi'nde indirilmeye başlanmış, yaklaşık 23 yılda tamamlanmıştır.</p>\n                </div>\n                <!-- İstiaze -->\n                <div class=\"bg-white p-4 rounded-xl border border-slate-200 shadow-sm hover:border-emerald-400 transition\">\n                    <span class=\"px-2 py-0.5 rounded bg-emerald-100 text-emerald-800 text-xs font-bold\">İstiaze</span>\n                    <p class=\"text-xs text-slate-600 mt-2\">Sözlükte sığınma, bağlanma, korunma ve güvenme demektir. Terim olarak: Her türlü kötülükten Allah'a sığınıp yalnız O'ndan yardım istemektir. \"Eûzü billâhi mineşşeytânirracîm\" (\"Kovulmuş şeytanın şerrinden Allah'a sığınırım\") ifadesidir.</p>\n                </div>\n                <!-- Mahreç -->\n                <div class=\"bg-white p-4 rounded-xl border border-slate-200 shadow-sm hover:border-emerald-400 transition\">\n                    <span class=\"px-2 py-0.5 rounded bg-emerald-100 text-emerald-800 text-xs font-bold\">Mahreç</span>\n                    <p class=\"text-xs text-slate-600 mt-2\">Harflerin ses yolundan çıktığı yerlere denir. Kur'an-ı Kerim'i doğru okuyabilmek için harflerin mahreçlerine uygun seslendirilmesi gerekir. Çıkış yerleri dil, dudak ve boğaz olmak üzere üçe ayrılır.</p>\n                </div>\n                <!-- Hareke -->\n                <div class=\"bg-white p-4 rounded-xl border border-slate-200 shadow-sm hover:border-emerald-400 transition\">\n                    <span class=\"px-2 py-0.5 rounded bg-emerald-100 text-emerald-800 text-xs font-bold\">Hareke</span>\n                    <p class=\"text-xs text-slate-600 mt-2\">Harflerin ünlü olarak seslendirilmesine yardımcı olan işaretlerdir. Kur'an'daki temel harekeler üstün ( َ ), esre ( ِ ) ve ötre ( ُ )'dir.</p>\n                </div>\n                <!-- Tespih -->\n                <div class=\"bg-white p-4 rounded-xl border border-slate-200 shadow-sm hover:border-emerald-400 transition\">\n                    <span class=\"px-2 py-0.5 rounded bg-emerald-100 text-emerald-800 text-xs font-bold\">Tespih</span>\n                    <p class=\"text-xs text-slate-600 mt-2\">Allah'ı (cc) her türlü eksiklikten uzak tutmak; O'nun, yüceliğine layık olmayan kusur ve noksanlıklardan uzak olduğuna kalpten inanmak ve bunu söz ile ifade etmektir (Sübhaneke duasında vurgulanır).</p>\n                </div>\n                <!-- Dua -->\n                <div class=\"bg-white p-4 rounded-xl border border-slate-200 shadow-sm hover:border-emerald-400 transition\">\n                    <span class=\"px-2 py-0.5 rounded bg-emerald-100 text-emerald-800 text-xs font-bold\">Dua</span>\n                    <p class=\"text-xs text-slate-600 mt-2\">Sözlükte çağırmak, seslenmek, istemek ve yardım talep etmek demektir. Terim olarak: Müminlerin sevgi ve saygıyla Yüce Allah'a isteklerini ileterek O'ndan yardım dilemesidir.</p>\n                </div>\n                <!-- İstiğfar -->\n                <div class=\"bg-white p-4 rounded-xl border border-slate-200 shadow-sm hover:border-emerald-400 transition\">\n                    <span class=\"px-2 py-0.5 rounded bg-emerald-100 text-emerald-800 text-xs font-bold\">İstiğfar</span>\n                    <p class=\"text-xs text-slate-600 mt-2\">Sözlükte örtme, perdeleme, kirden-pastan korunma, bağışlanma ve af isteğinde bulunma demektir. Müslümanların Allah'a samimi şekilde af ve bağışlanma dilemesidir (Rabbenağfirli duası bir istiğfar duasıdır).</p>\n                </div>\n                <!-- Tevhit -->\n                <div class=\"bg-white p-4 rounded-xl border border-slate-200 shadow-sm hover:border-emerald-400 transition\">\n                    <span class=\"px-2 py-0.5 rounded bg-emerald-100 text-emerald-800 text-xs font-bold\">Tevhit</span>\n                    <p class=\"text-xs text-slate-600 mt-2\">Allah'ın bir ve tek olduğuna, O'ndan başka ilah bulunmadığına inanmaktır. Sübhaneke duasının sonundaki \"ve lâ ilâhe ġayruk\" ifadesi tevhit inancını vurgular.</p>\n                </div>\n            </div>\n        </section>\n\n        <!-- 3. DETAYLI KONU ÖZETLERİ -->\n        <section class=\"space-y-8\">\n            <div class=\"flex items-center space-x-3\">\n                <div class=\"w-10 h-10 rounded-lg bg-teal-600 text-white flex items-center justify-center text-lg font-bold shadow-md\">\n                    <i class=\"fa-solid fa-book-open text-white\"></i>\n                </div>\n                <div>\n                    <h2 class=\"text-xl font-bold text-slate-900\">Konu Konu Özet ve Kazanım Rehberi</h2>\n                    <p class=\"text-xs text-slate-500\">Kitaptaki 5 ana konunun detaylı açıklamaları</p>\n                </div>\n            </div>\n\n            <!-- Konu 1 -->\n            <div class=\"bg-white rounded-2xl p-6 shadow-sm border border-slate-200 space-y-4\">\n                <h3 class=\"text-lg font-bold text-emerald-800 flex items-center border-b pb-2\">\n                    <span class=\"w-7 h-7 bg-emerald-100 text-emerald-800 rounded-full flex items-center justify-center text-xs mr-2 font-black\">1</span>\n                    1. Kur'an-ı Kerim'i Öğrenmenin Önemi ve Okumanın Adabı\n                </h3>\n                <div class=\"grid grid-cols-1 md:grid-cols-2 gap-6 text-sm\">\n                    <div class=\"space-y-2 text-slate-700\">\n                        <h4 class=\"font-bold text-slate-900\"><i class=\"fa-solid fa-star text-amber-500 mr-1\"></i> Kur'an-ı Kerim'in Özellikleri ve İndiriliş Amacı:</h4>\n                        <ul class=\"list-disc pl-5 space-y-1 text-xs\">\n                            <li>Kur'an, İslam'ın temel kaynağıdır. Bilinçli her Müslüman onu okumayı öğrenir.</li>\n                            <li>Tüm insanlara doğru yolu gösterir; adaleti, doğruluğu, iyiliği öğütler.</li>\n                            <li>Anne babaya iyi davranmayı, insanlara güzel söz söylemeyi emreder.</li>\n                            <li>Ahiret hayatının varlığını ve dünya işlerinin bir karşılığı olacağını bildirir.</li>\n                            <li>Sadece \"okunması\" değil, **\"üzerinde düşünülmesi ve öğüt alınması\"** için indirilmiştir (Sâd suresi, 29).</li>\n                        </ul>\n                    </div>\n                    <div class=\"space-y-2 text-slate-700\">\n                        <h4 class=\"font-bold text-slate-900\"><i class=\"fa-solid fa-hands-holding-circle text-teal-600 mr-1\"></i> Kur'an-ı Kerim Okumanın Adabı:</h4>\n                        <ol class=\"list-decimal pl-5 space-y-1 text-xs\">\n                            <li><strong>Abdestli Olmak:</strong> Okurken ve dokunurken abdestli olmaya özen gösterilir. Bu saygının gereğidir, bedensel ve manevi temizlik sağlar.</li>\n                            <li><strong>Eûzübesmele Çekmek:</strong> Okumaya \"İstiaze\" (Eûzü...) ve ardından \"Besmele\" (Bismillahirrahmanirrahim) ile başlanır (Nahl suresi, 98).</li>\n                            <li><strong>Saygı ve İlgiyle Dinlemek:</strong> Kur'an okunduğunda susup dikkatle dinlenmelidir (A'râf suresi, 204).</li>\n                        </ol>\n                    </div>\n                </div>\n            </div>\n\n            <!-- Konu 2 -->\n            <div class=\"bg-white rounded-2xl p-6 shadow-sm border border-slate-200 space-y-4\">\n                <h3 class=\"text-lg font-bold text-teal-800 flex items-center border-b pb-2\">\n                    <span class=\"w-7 h-7 bg-teal-100 text-teal-800 rounded-full flex items-center justify-center text-xs mr-2 font-black\">2</span>\n                    2. Harfler ve Özellikleri\n                </h3>\n                <p class=\"text-xs text-slate-600\">Kur'an alfabesi <strong>28 harften</strong> oluşur. Kelimeler <strong>sağdan sola</strong> doğru yazılır ve okunur. (Lâmelif - لا müstakil harf değildir, Lâm ve Elif'in birleşimidir).</p>\n\n                <!-- Harf Sınıflandırma Tablosu -->\n                <div class=\"grid grid-cols-1 md:grid-cols-3 gap-4\">\n                    <!-- Kalın & İnce -->\n                    <div class=\"bg-slate-50 p-4 rounded-xl border border-slate-200\">\n                        <h4 class=\"font-bold text-xs uppercase tracking-wider text-slate-700 mb-2 border-b pb-1\">Ses Kalınlığına Göre</h4>\n                        <div class=\"space-y-2 text-xs\">\n                            <div>\n                                <span class=\"font-semibold text-red-700\">Kalın Harfler (7 Adet):</span>\n                                <p class=\"font-arabic text-xl text-red-800 tracking-wide mt-1\">خ , ص , ض , ط , ظ , غ , ق</p>\n                            </div>\n                            <div>\n                                <span class=\"font-semibold text-emerald-700\">İnce Harfler (21 Adet):</span>\n                                <p class=\"font-arabic text-lg text-emerald-800 tracking-wide mt-1\">ا , ب , ت , ث , ج , ح , د , ذ , ر , ز , س , ش , ع , ف , ك , ل , م , ن , و , ه , ى</p>\n                            </div>\n                            <p class=\"text-[11px] text-slate-500 italic mt-1\">* <strong>ر (Ra) harfi:</strong> Hareke ve sakinlik durumuna göre ince veya kalın okunur.</p>\n                        </div>\n                    </div>\n\n                    <!-- Peltek & Boğaz -->\n                    <div class=\"bg-slate-50 p-4 rounded-xl border border-slate-200\">\n                        <h4 class=\"font-bold text-xs uppercase tracking-wider text-slate-700 mb-2 border-b pb-1\">Özel Ses Veren Harfler</h4>\n                        <div class=\"space-y-2 text-xs\">\n                            <div>\n                                <span class=\"font-semibold text-pink-700\">Peltek Harfler (3 Adet):</span>\n                                <p class=\"text-[11px] text-slate-600\">Dil ucu üst ön dişlerin ucuna getirilerek okunur.</p>\n                                <p class=\"font-arabic text-xl text-pink-800 mt-1\">ث (ince), ذ (ince), ظ (kalın)</p>\n                            </div>\n                            <div>\n                                <span class=\"font-semibold text-amber-700\">Boğaz Harfleri (6 Adet):</span>\n                                <p class=\"text-[11px] text-slate-600\">Boğazdan gelen titreşimle telaffuz edilir.</p>\n                                <p class=\"font-arabic text-xl text-amber-800 mt-1\">ا , ح , ع <span class=\"text-xs text-slate-500\">(İnce)</span> | خ , غ <span class=\"text-xs text-slate-500\">(Kalın)</span> | ه</p>\n                            </div>\n                        </div>\n                    </div>\n\n                    <!-- Mahreç Bölgeleri -->\n                    <div class=\"bg-slate-50 p-4 rounded-xl border border-slate-200\">\n                        <h4 class=\"font-bold text-xs uppercase tracking-wider text-slate-700 mb-2 border-b pb-1\">Mahreç Bölgeleri (Çıkış Yerleri)</h4>\n                        <ul class=\"text-xs space-y-2\">\n                            <li><strong class=\"text-cyan-700\">1. Dil (Diş/Damak) Harfleri:</strong> <span class=\"font-arabic text-base\">ت, ث, ج, د, ذ, ر, ز, س, ش, ص, ض, ط, ظ, ق, ك, ل, ن, ى</span></li>\n                            <li><strong class=\"text-cyan-700\">2. Dudak Harfleri:</strong> <span class=\"font-arabic text-base text-cyan-900\">ب , ف , م , و</span></li>\n                            <li><strong class=\"text-cyan-700\">3. Boğaz Harfleri:</strong> <span class=\"font-arabic text-base text-cyan-900\">ا , ح , خ , ع , غ , ه</span></li>\n                        </ul>\n                    </div>\n                </div>\n            </div>\n\n            <!-- Konu 3 -->\n            <div class=\"bg-white rounded-2xl p-6 shadow-sm border border-slate-200 space-y-4\">\n                <h3 class=\"text-lg font-bold text-cyan-800 flex items-center border-b pb-2\">\n                    <span class=\"w-7 h-7 bg-cyan-100 text-cyan-800 rounded-full flex items-center justify-center text-xs mr-2 font-black\">3</span>\n                    3. Harfleri Yazma ve Bitişme Kuralları\n                </h3>\n                <div class=\"grid grid-cols-1 md:grid-cols-2 gap-6 text-xs\">\n                    <div class=\"bg-amber-50/60 p-4 rounded-xl border border-amber-200 space-y-2\">\n                        <h4 class=\"font-bold text-amber-900 text-sm\"><i class=\"fa-solid fa-triangle-exclamation text-amber-600 mr-1\"></i> Kendinden Sonra Gelen Harfle BİRLEŞMEYEN 6 Harf:</h4>\n                        <p class=\"text-slate-700\">Bu harfler kendinden önceki harfe birleşebilir fakat kendinden sonraki harfle asla birleşmezler:</p>\n                        <div class=\"font-arabic text-3xl text-center text-amber-900 py-2 tracking-widest bg-white rounded-lg border border-amber-200\">\n                            ا  ,  د  ,  ذ  ,  ر  ,  ز  ,  و\n                        </div>\n                    </div>\n\n                    <div class=\"bg-slate-50 p-4 rounded-xl border border-slate-200 space-y-2\">\n                        <h4 class=\"font-bold text-slate-800 text-sm\"><i class=\"fa-solid fa-pen-ruler text-teal-600 mr-1\"></i> Özel Yazılış Durumları:</h4>\n                        <ul class=\"space-y-1 text-slate-600\">\n                            <li>• <strong>Hemze:</strong> Harekeli Elif (ا) harfi hemze olarak adlandırılır. Yazılış şekilleri: <span class=\"font-arabic text-lg text-slate-800\">أ , إ , ؤ , ئ , ء</span></li>\n                            <li>• <strong>Yuvarlak Te (ة):</strong> Kelime sonunda yer alır. Önceki harfe birleşirse <span class=\"font-arabic text-lg\">ـة</span>, birleşmezse <span class=\"font-arabic text-lg\">ة</span> şeklinde yazılır.</li>\n                            <li>• <strong>Harf Konumları:</strong> Bağımsız (ب), Başta (بـ), Ortada (ـبـ), Sonda (ـب)</li>\n                        </ul>\n                    </div>\n                </div>\n            </div>\n\n            <!-- Konu 4 -->\n            <div class=\"bg-white rounded-2xl p-6 shadow-sm border border-slate-200 space-y-4\">\n                <h3 class=\"text-lg font-bold text-indigo-800 flex items-center border-b pb-2\">\n                    <span class=\"w-7 h-7 bg-indigo-100 text-indigo-800 rounded-full flex items-center justify-center text-xs mr-2 font-black\">4</span>\n                    4. Harfleri Harekelerle Telaffuz Etme\n                </h3>\n                <p class=\"text-xs text-slate-600\">Hareke, harflerin ünlü ses (sesli harf) alarak okunmasını sağlayan işaretlerdir.</p>\n\n                <div class=\"grid grid-cols-1 md:grid-cols-3 gap-4 text-xs\">\n                    <!-- Üstün -->\n                    <div class=\"p-4 rounded-xl border border-slate-200 bg-emerald-50/40\">\n                        <div class=\"flex justify-between items-center mb-2\">\n                            <span class=\"font-bold text-emerald-900 text-sm\">ÜSTÜN ( َ )</span>\n                            <span class=\"px-2 py-0.5 rounded bg-emerald-200 text-emerald-800 font-mono text-[10px]\">Harfin Üstünde</span>\n                        </div>\n                        <p class=\"text-slate-700\">İnce harfleri <strong>\"e\"</strong>, kalın harfleri <strong>\"a\"</strong> sesiyle okutur.</p>\n                        <div class=\"mt-3 bg-white p-2 rounded text-center border border-emerald-200\">\n                            <span class=\"text-slate-500\">Örnek Kelimeler:</span>\n                            <p class=\"font-arabic text-xl text-emerald-800 mt-1\">كَتَبَ | دَرَسَ | زَرَعَ | غَفَرَ</p>\n                        </div>\n                    </div>\n\n                    <!-- Esre -->\n                    <div class=\"p-4 rounded-xl border border-slate-200 bg-blue-50/40\">\n                        <div class=\"flex justify-between items-center mb-2\">\n                            <span class=\"font-bold text-blue-900 text-sm\">ESRE ( ِ )</span>\n                            <span class=\"px-2 py-0.5 rounded bg-blue-200 text-blue-800 font-mono text-[10px]\">Harfin Altında</span>\n                        </div>\n                        <p class=\"text-slate-700\">İnce harfleri <strong>\"i\"</strong>, kalın harfleri <strong>\"ı-i\"</strong> arası bir sesle okutur.</p>\n                        <div class=\"mt-3 bg-white p-2 rounded text-center border border-blue-200\">\n                            <span class=\"text-slate-500\">Örnek Kelimeler:</span>\n                            <p class=\"font-arabic text-xl text-blue-800 mt-1\">حَفِظَ | رَحِمَ | بَخِلَ | حَمِدَ</p>\n                        </div>\n                    </div>\n\n                    <!-- Ötre -->\n                    <div class=\"p-4 rounded-xl border border-slate-200 bg-purple-50/40\">\n                        <div class=\"flex justify-between items-center mb-2\">\n                            <span class=\"font-bold text-purple-900 text-sm\">ÖTRE ( ُ )</span>\n                            <span class=\"px-2 py-0.5 rounded bg-purple-200 text-purple-800 font-mono text-[10px]\">Harfin Üstünde (Vav şeklinde)</span>\n                        </div>\n                        <p class=\"text-slate-700\">İnce harfleri <strong>\"u-ü\"</strong> arası, kalın harfleri <strong>\"u\"</strong> sesiyle okutur.</p>\n                        <div class=\"mt-3 bg-white p-2 rounded text-center border border-purple-200\">\n                            <span class=\"text-slate-500\">Örnek Kelimeler:</span>\n                            <p class=\"font-arabic text-xl text-purple-800 mt-1\">كُتِبَ | ظُلِمَ | طُلِعَ | قُرِئَ</p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n\n            <!-- Konu 5 -->\n            <div class=\"bg-white rounded-2xl p-6 shadow-sm border border-slate-200 space-y-4\">\n                <h3 class=\"text-lg font-bold text-amber-800 flex items-center border-b pb-2\">\n                    <span class=\"w-7 h-7 bg-amber-100 text-amber-800 rounded-full flex items-center justify-center text-xs mr-2 font-black\">5</span>\n                    5. Sübhaneke Duası ve Rabbena Duaları ile Anlamları\n                </h3>\n\n                <div class=\"space-y-6\">\n                    <!-- Sübhaneke -->\n                    <div class=\"bg-amber-50/30 p-5 rounded-xl border border-amber-200/70 space-y-3\">\n                        <div class=\"flex justify-between items-center\">\n                            <h4 class=\"font-bold text-amber-900\"><i class=\"fa-solid fa-hands-praying text-amber-600 mr-2\"></i>Sübhaneke Duası</h4>\n                            <span class=\"text-xs bg-amber-200 text-amber-900 px-2 py-0.5 rounded font-medium\">Namaz Başlangıç Duası</span>\n                        </div>\n                        <div class=\"bg-white p-3 rounded-lg border border-amber-100 text-right\">\n                            <p class=\"font-arabic text-2xl text-slate-800 leading-loose\" dir=\"rtl\">\n                                سُبْحَانَكَ اللّٰهُمَّ وَبِحَمْدِكَ وَتَبَارَكَ اسْمُكَ وَتَعَالٰى جَدُّكَ (وَجَلَّ ثَنَٓاؤُكَ) وَلَا اِلٰهَ غَيْرُكَ\n                            </p>\n                        </div>\n                        <p class=\"text-xs text-slate-700\"><strong>Türkçe Anlamı:</strong> \"Sen eksik sıfatlardan uzaksın Allah’ım! Seni daima böyle tenzih eder ve sana hamdederim. Senin adın mübarektir. İzzet ve celalin yücedir. (Senin şanın yücedir.) Senden başka ilah yoktur.\"</p>\n                        \n                        <!-- Sübhaneke Okunduğu Yerler -->\n                        <div class=\"bg-white p-3 rounded-lg border border-slate-200 text-xs space-y-1\">\n                            <strong class=\"text-slate-900 block border-b pb-1 mb-1\">📌 Sübhaneke Duasının Okunduğu Yerler:</strong>\n                            <ul class=\"list-disc pl-5 space-y-0.5 text-slate-600\">\n                                <li>Her namazın ilk rekâtında Fatiha'dan önce.</li>\n                                <li>İkindi namazının sünnetinde 3. rekâtın başında Fatiha'dan önce.</li>\n                                <li>Yatsı namazının ilk sünnetinde 3. rekâtın başında Fatiha'dan önce.</li>\n                                <li>Teravih 4 rekâtta bir kılınıyorsa 3. rekâtın başında Fatiha'dan önce.</li>\n                                <li>Cenaze namazında 1. tekbirden sonra <em>\"(Ve celle senâük)\"</em> cümlesi eklenerek.</li>\n                            </ul>\n                        </div>\n                    </div>\n\n                    <!-- Rabbena Duaları -->\n                    <div class=\"grid grid-cols-1 md:grid-cols-3 gap-4 text-xs\">\n                        <!-- Rabbena Atina -->\n                        <div class=\"bg-slate-50 p-4 rounded-xl border border-slate-200 flex flex-col justify-between space-y-2\">\n                            <div>\n                                <div class=\"flex justify-between items-center mb-1\">\n                                    <strong class=\"text-slate-900 font-bold\">Rabbena Âtina Duası</strong>\n                                    <span class=\"text-[10px] text-emerald-700 bg-emerald-100 px-1.5 py-0.5 rounded\">Bakara 201</span>\n                                </div>\n                                <p class=\"font-arabic text-lg text-right text-slate-800 my-2\" dir=\"rtl\">رَبَّنَٓا اٰتِنَا فِي الدُّنْيَا حَسَنَةً وَفِي الْاٰخِرَةِ حَسَنَةً وَقِنَا عَذَابَ النَّارِ</p>\n                                <p class=\"text-slate-600\"><strong>Anlamı:</strong> \"Rabbimiz! Bize dünyada da iyilik ver, ahirette de iyilik ver ve bizi ateş azabından koru.\"</p>\n                            </div>\n                            <span class=\"text-[11px] text-amber-800 bg-amber-50 p-1.5 rounded border border-amber-200 block\">💡 Dünya ve ahiret dengesini vurgular.</span>\n                        </div>\n\n                        <!-- Rabbicalni -->\n                        <div class=\"bg-slate-50 p-4 rounded-xl border border-slate-200 flex flex-col justify-between space-y-2\">\n                            <div>\n                                <div class=\"flex justify-between items-center mb-1\">\n                                    <strong class=\"text-slate-900 font-bold\">Rabbicalni Duası</strong>\n                                    <span class=\"text-[10px] text-emerald-700 bg-emerald-100 px-1.5 py-0.5 rounded\">İbrahim 40</span>\n                                </div>\n                                <p class=\"font-arabic text-lg text-right text-slate-800 my-2\" dir=\"rtl\">رَبِّ اجْعَلْن۪ي مُق۪يمَ الصَّلٰوةِ وَمِنْ ذُرِّيَّت۪ي رَبَّنَا وَتَقَبَّلْ دُعَٓاءِ</p>\n                                <p class=\"text-slate-600\"><strong>Anlamı:</strong> \"Rabbim! Beni ve soyumdan gelecek olanları namazı devamlı kılanlardan eyle. Rabbimiz, duamı kabul et.\"</p>\n                            </div>\n                            <span class=\"text-[11px] text-amber-800 bg-amber-50 p-1.5 rounded border border-amber-200 block\">💡 Hz. İbrahim'in namaz devamlılığı duasıdır.</span>\n                        </div>\n\n                        <!-- Rabbenağfirli -->\n                        <div class=\"bg-slate-50 p-4 rounded-xl border border-slate-200 flex flex-col justify-between space-y-2\">\n                            <div>\n                                <div class=\"flex justify-between items-center mb-1\">\n                                    <strong class=\"text-slate-900 font-bold\">Rabbenağfirli Duası</strong>\n                                    <span class=\"text-[10px] text-emerald-700 bg-emerald-100 px-1.5 py-0.5 rounded\">İbrahim 41</span>\n                                </div>\n                                <p class=\"font-arabic text-lg text-right text-slate-800 my-2\" dir=\"rtl\">رَبَّنَا اغْفِرْ ل۪ي وَلِوَالِدَيَّ وَلِلْمُؤْمِن۪ينَ يَوْمَ يَقُومُ الْحِسَابُ</p>\n                                <p class=\"text-slate-600\"><strong>Anlamı:</strong> \"Rabbimiz! Hesap görülecek günde beni, ana babamı ve inananları bağışla.\"</p>\n                            </div>\n                            <span class=\"text-[11px] text-amber-800 bg-amber-50 p-1.5 rounded border border-amber-200 block\">💡 İstiğfar duasıdır; ana-baba ve tüm müminler için bağışlanma istenir.</span>\n                        </div>\n                    </div>\n                    \n                    <p class=\"text-xs text-slate-500 italic bg-slate-100 p-2 rounded text-center\">\n                        * <strong>Rabbena Âtina ve Rabbenağfirli duaları</strong>, namazların son oturuşunda Tahiyyat, Salli ve Barik dualarından sonra okunur.\n                    </p>\n                </div>\n            </div>\n        </section>\n\n        <!-- 4. KİLİT AYET VE HADİSLER KARTLARI -->\n        <section class=\"space-y-4\">\n            <div class=\"flex items-center space-x-3\">\n                <div class=\"w-10 h-10 rounded-lg bg-emerald-700 text-white flex items-center justify-center text-lg font-bold shadow-md\">\n                    <i class=\"fa-solid fa-quote-left\"></i>\n                </div>\n                <div>\n                    <h2 class=\"text-xl font-bold text-slate-900\">Ünitede Geçen Kilit Ayet ve Hadisler</h2>\n                    <p class=\"text-xs text-slate-500\">Sınavlarda soru olarak çıkabilecek temel naslar</p>\n                </div>\n            </div>\n\n            <div class=\"grid grid-cols-1 md:grid-cols-2 gap-4 text-xs\">\n                <!-- Hadis 1 -->\n                <div class=\"bg-white p-5 rounded-xl border-l-4 border-emerald-600 shadow-sm space-y-2\">\n                    <span class=\"px-2 py-0.5 rounded bg-emerald-100 text-emerald-800 font-bold text-[10px]\">HADİS-İ ŞERİF</span>\n                    <p class=\"font-arabic text-xl text-right text-slate-800 leading-relaxed\" dir=\"rtl\">اِقْرَءُوا الْقُرْاٰنَ فَاِنَّهُ يَأْت۪ي يَوْمَ الْقِيَامَةِ شَف۪يعًا لِاَصْحَابِه۪</p>\n                    <p class=\"text-slate-700 font-medium\">\"Kur'an okuyun! Çünkü Kur'an, kıyamet gününde okuyucusuna şefaatçi olacaktır.\"</p>\n                </div>\n\n                <!-- Hadis 2 -->\n                <div class=\"bg-white p-5 rounded-xl border-l-4 border-emerald-600 shadow-sm space-y-2\">\n                    <span class=\"px-2 py-0.5 rounded bg-emerald-100 text-emerald-800 font-bold text-[10px]\">HADİS-İ ŞERİF</span>\n                    <p class=\"font-arabic text-xl text-right text-slate-800 leading-relaxed\" dir=\"rtl\">خَيْرُكُمْ مَنْ تَعَلَّمَ الْقُرْاٰنَ وَعَلَّمَهُ</p>\n                    <p class=\"text-slate-700 font-medium\">\"Sizin en hayırlınız, Kur'an'ı öğrenen ve öğretendir.\"</p>\n                </div>\n\n                <!-- Ayet Sad 29 -->\n                <div class=\"bg-white p-5 rounded-xl border-l-4 border-teal-600 shadow-sm space-y-2\">\n                    <div class=\"flex justify-between\">\n                        <span class=\"px-2 py-0.5 rounded bg-teal-100 text-teal-800 font-bold text-[10px]\">AYET-İ KERİME</span>\n                        <span class=\"text-slate-400\">Sâd suresi, 29. ayet</span>\n                    </div>\n                    <p class=\"font-arabic text-lg text-right text-slate-800 leading-relaxed\" dir=\"rtl\">كِتَابٌ اَنْزَلْنَاهُ اِلَيْكَ مُبَارَكٌ لِيَدَّبَّرُوٓا اٰيَاتِه۪ وَلِيَتَذَكَّرَ اُو۬لُوا الْاَلْبَابِ</p>\n                    <p class=\"text-slate-700\">\"Bu Kur'an, âyetlerini düşünsünler ve akıl sahipleri öğüt alsınlar diye sana indirdiğimiz mübarek bir kitaptır.\"</p>\n                </div>\n\n                <!-- Ayet Nahl 98 -->\n                <div class=\"bg-white p-5 rounded-xl border-l-4 border-teal-600 shadow-sm space-y-2\">\n                    <div class=\"flex justify-between\">\n                        <span class=\"px-2 py-0.5 rounded bg-teal-100 text-teal-800 font-bold text-[10px]\">AYET-İ KERİME (İstiaze)</span>\n                        <span class=\"text-slate-400\">Nahl suresi, 98. ayet</span>\n                    </div>\n                    <p class=\"font-arabic text-lg text-right text-slate-800 leading-relaxed\" dir=\"rtl\">فَاِذَا قَرَاْتَ الْقُرْاٰنَ فَاسْتَعِذْ بِاللّٰهِ مِنَ الشَّيْطَانِ الرَّج۪يمِ</p>\n                    <p class=\"text-slate-700\">\"Kur'an okuduğun zaman kovulmuş şeytandan Allah'a sığın.\"</p>\n                </div>\n\n                <!-- Ayet A'raf 204 -->\n                <div class=\"bg-white p-5 rounded-xl border-l-4 border-teal-600 shadow-sm space-y-2\">\n                    <div class=\"flex justify-between\">\n                        <span class=\"px-2 py-0.5 rounded bg-teal-100 text-teal-800 font-bold text-[10px]\">AYET-İ KERİME (Dinleme Adabı)</span>\n                        <span class=\"text-slate-400\">A'râf suresi, 204. ayet</span>\n                    </div>\n                    <p class=\"font-arabic text-lg text-right text-slate-800 leading-relaxed\" dir=\"rtl\">وَاِذَا قُرِئَ الْقُرْاٰنُ فَاسْتَمِعُوا لَهُ وَاَنْصِتُوا لَعَلَّكُمْ تُرْحَمُونَ</p>\n                    <p class=\"text-slate-700\">\"Kur'an okunduğu zaman onu dinleyin ve susun ki size merhamet edilsin.\"</p>\n                </div>\n\n                <!-- Ayet Bakara 46 -->\n                <div class=\"bg-white p-5 rounded-xl border-l-4 border-teal-600 shadow-sm space-y-2\">\n                    <div class=\"flex justify-between\">\n                        <span class=\"px-2 py-0.5 rounded bg-teal-100 text-teal-800 font-bold text-[10px]\">AYET-İ KERİME (Ahiret Bilgisi)</span>\n                        <span class=\"text-slate-400\">Bakara suresi, 46. ayet</span>\n                    </div>\n                    <p class=\"font-arabic text-lg text-right text-slate-800 leading-relaxed\" dir=\"rtl\">اَلَّذ۪ينَ يَظُنُّونَ اَنَّهُمْ مُلَاقُوا رَبِّهِمْ وَاَنَّهُمْ اِلَيْهِ رَاجِعُونَ</p>\n                    <p class=\"text-slate-700\">\"Onlar, Rablerine kavuşacaklarını ve gerçekten O'na döneceklerini çok iyi bilirler.\"</p>\n                </div>\n            </div>\n        </section>\n\n        <!-- 5. 📌 ÜNİTEYİ BİTİRİRKEN UNUTMA! (GOLD EXAM TIPS) -->\n        <section class=\"bg-gradient-to-r from-amber-500 via-amber-600 to-orange-600 rounded-2xl p-6 sm:p-8 text-white shadow-xl relative overflow-hidden\">\n            <div class=\"absolute -right-6 -bottom-6 text-amber-400/20 text-9xl font-bold\">\n                <i class=\"fa-solid fa-graduation-cap\"></i>\n            </div>\n            \n            <div class=\"relative z-10 space-y-4\">\n                <div class=\"flex items-center space-x-3\">\n                    <div class=\"w-10 h-10 rounded-xl bg-white/20 backdrop-blur-sm flex items-center justify-center text-white text-xl\">\n                        <i class=\"fa-solid fa-lightbulb\"></i>\n                    </div>\n                    <h2 class=\"text-2xl font-black tracking-tight\">📌 Üniteyi Bitirirken Unutma! (Altın Notlar)</h2>\n                </div>\n\n                <div class=\"grid grid-cols-1 md:grid-cols-2 gap-4 text-xs sm:text-sm\">\n                    <div class=\"bg-white/10 backdrop-blur-md p-4 rounded-xl border border-white/20 space-y-1\">\n                        <h3 class=\"font-bold text-amber-100 flex items-center\"><i class=\"fa-solid fa-check mr-2\"></i> Kendinden Sonra Bitişmeyen Harfler:</h3>\n                        <p class=\"text-amber-50\">Toplam 6 tanedir: <strong>Elif (ا), Dal (د), Zel (ذ), Ra (ر), Ze (ز), Vav (و)</strong>. Sınavda bu harflerin kelime ortasında sonrasıyla birleşmediğini unutma!</p>\n                    </div>\n\n                    <div class=\"bg-white/10 backdrop-blur-md p-4 rounded-xl border border-white/20 space-y-1\">\n                        <h3 class=\"font-bold text-amber-100 flex items-center\"><i class=\"fa-solid fa-check mr-2\"></i> Peltek ve Boğaz Harfleri Ayırımı:</h3>\n                        <p class=\"text-amber-50\">Peltekler 3 tanedir: <strong>ث, ذ, ظ</strong>. Peltek ظ kalın, ث ve ذ incedir. Boğaz harfleri 6 tanedir: <strong>ا, ح, خ, ع, غ, ه</strong>.</p>\n                    </div>\n\n                    <div class=\"bg-white/10 backdrop-blur-md p-4 rounded-xl border border-white/20 space-y-1\">\n                        <h3 class=\"font-bold text-amber-100 flex items-center\"><i class=\"fa-solid fa-check mr-2\"></i> Sübhaneke Farkı:</h3>\n                        <p class=\"text-amber-50\">Sübhaneke duası sadece <strong>Cenaze Namazında</strong> 1. tekbirden sonra <strong>\"(Ve celle senâük)\"</strong> cümlesi eklenerek okunur. Diğer namazlarda bu kısım okunmaz.</p>\n                    </div>\n\n                    <div class=\"bg-white/10 backdrop-blur-md p-4 rounded-xl border border-white/20 space-y-1\">\n                        <h3 class=\"font-bold text-amber-100 flex items-center\"><i class=\"fa-solid fa-check mr-2\"></i> Rabbena Duaları İnce Ayrımı:</h3>\n                        <p class=\"text-amber-50\"><strong>Rabbena Âtina:</strong> Dünya-ahiret iyiliği ister. <strong>Rabbicalni:</strong> Namazı devamlı kılma duasıdır (Hz. İbrahim). <strong>Rabbenağfirli:</strong> Anne-baba ve tüm müminler için istiğfar/bağışlanma duasıdır.</p>\n                    </div>\n                </div>\n            </div>\n        </section>\n\n    </main>\n\n    <!-- Footer -->\n    <footer class=\"bg-slate-900 text-slate-400 py-6 border-t border-slate-800 mt-12 text-center text-xs\">\n        <div class=\"max-w-7xl mx-auto px-4 space-y-2\">\n            <p class=\"font-medium text-slate-300\">MEB 5. Sınıf Kur'an-ı Kerim Ders Kitabı Müfredatına Uygun Olarak Hazırlanmıştır.</p>\n            <p class=\"text-slate-500\">Akıllı Tahta, Tablet ve Bireysel Tekrar Çalışmalarına Tam Uyumlu Eğitim Materyali</p>\n        </div>\n    </footer>\n\n</body>\n</html>",
