{
  "htmlContent": "<!DOCTYPE html>\n<html lang=\"tr\" class=\"h-full bg-slate-50\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>5. Esmayıhüsnayı Tanıyorum - Akıllı Tahta İnteraktif Ders Özeti</title>\n    <!-- Tailwind CSS CDN -->\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <!-- FontAwesome CDN -->\n    <link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css\" />\n    <!-- Google Fonts (Amiri for Arabic text & Plus Jakarta Sans for UI) -->\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n    <link href=\"https://fonts.googleapis.com/css2?family=Amiri:ital,wght@0,400;0,700;1,400&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap\" rel=\"stylesheet\">\n    <style>\n        body { font-family: 'Plus Jakarta Sans', sans-serif; }\n        .font-arabic { font-family: 'Amiri', serif; }\n        .tab-btn.active {\n            background-color: #047857;\n            color: #ffffff;\n            box-shadow: 0 4px 12px rgba(4, 120, 87, 0.25);\n        }\n    </style>\n</head>\n<body class=\"h-full text-slate-800 flex flex-col justify-between\">\n\n    <!-- HEADER / ÜST BİLGİ ALANI -->\n    <header class=\"bg-gradient-to-r from-emerald-900 via-teal-800 to-emerald-950 text-white shadow-xl\">\n        <div class=\"max-w-7xl mx-auto px-4 py-5 sm:px-6 lg:px-8\">\n            <div class=\"flex flex-col md:flex-row md:items-center md:justify-between gap-4\">\n                <div class=\"flex items-center space-x-4\">\n                    <div class=\"w-14 h-14 bg-emerald-500/20 border border-emerald-400/30 rounded-2xl flex items-center justify-center backdrop-blur-md\">\n                        <i class=\"fa-solid fa-book-quran text-emerald-300 text-2xl\"></i>\n                    </div>\n                    <div>\n                        <div class=\"flex items-center gap-2 text-xs font-semibold tracking-wider text-emerald-300 uppercase\">\n                            <span>6. Sınıf</span> • <span>Temel Dinî Bilgiler 1</span> • <span>1. Ünite: İman ve İnsan</span>\n                        </div>\n                        <h1 class=\"text-2xl sm:text-3xl font-extrabold tracking-tight text-white mt-1\">\n                            5. Esmayıhüsnayı Tanıyorum\n                        </h1>\n                    </div>\n                </div>\n                <div class=\"flex items-center space-x-2 bg-emerald-950/60 backdrop-blur-md px-4 py-2.5 rounded-xl border border-emerald-500/30 text-xs sm:text-sm text-emerald-200\">\n                    <i class=\"fa-solid fa-graduation-cap text-amber-400 text-lg\"></i>\n                    <span>MEB Ders Kitabı %100 Sadık Akıllı Tahta Sunumu</span>\n                </div>\n            </div>\n        </div>\n    </header>\n\n    <!-- ANA İÇERİK SEKTÖRÜ (SEKMELİ YAPI) -->\n    <main class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 flex-grow w-full\">\n\n        <!-- MENÜ SEKMELERİ -->\n        <div class=\"flex flex-wrap gap-2 mb-8 bg-white p-2 rounded-2xl shadow-sm border border-slate-200/80\">\n            <button onclick=\"switchTab('tab-genel')\" id=\"btn-tab-genel\" class=\"tab-btn active flex-1 min-w-[140px] px-4 py-3 rounded-xl font-bold text-sm text-slate-600 hover:text-emerald-700 hover:bg-emerald-50 transition-all duration-200 flex items-center justify-center gap-2\">\n                <i class=\"fa-solid fa-compass\"></i>\n                <span>Giriş & Esmayıhüsna</span>\n            </button>\n            <button onclick=\"switchTab('tab-allah')\" id=\"btn-tab-allah\" class=\"tab-btn flex-1 min-w-[140px] px-4 py-3 rounded-xl font-bold text-sm text-slate-600 hover:text-emerald-700 hover:bg-emerald-50 transition-all duration-200 flex items-center justify-center gap-2\">\n                <i class=\"fa-solid fa-kaaba\"></i>\n                <span>Allah (c.c.) İsmi</span>\n            </button>\n            <button onclick=\"switchTab('tab-vahid-ehad')\" id=\"btn-tab-vahid-ehad\" class=\"tab-btn flex-1 min-w-[140px] px-4 py-3 rounded-xl font-bold text-sm text-slate-600 hover:text-emerald-700 hover:bg-emerald-50 transition-all duration-200 flex items-center justify-center gap-2\">\n                <i class=\"fa-solid fa-sun\"></i>\n                <span>el-Vahid ve el-Ehad</span>\n            </button>\n            <button onclick=\"switchTab('tab-mumin')\" id=\"btn-tab-mumin\" class=\"tab-btn flex-1 min-w-[140px] px-4 py-3 rounded-xl font-bold text-sm text-slate-600 hover:text-emerald-700 hover:bg-emerald-50 transition-all duration-200 flex items-center justify-center gap-2\">\n                <i class=\"fa-solid fa-shield-halved\"></i>\n                <span>el-Mümin</span>\n            </button>\n            <button onclick=\"switchTab('tab-ayet-hadis')\" id=\"btn-tab-ayet-hadis\" class=\"tab-btn flex-1 min-w-[140px] px-4 py-3 rounded-xl font-bold text-sm text-slate-600 hover:text-emerald-700 hover:bg-emerald-50 transition-all duration-200 flex items-center justify-center gap-2\">\n                <i class=\"fa-solid fa-quote-left\"></i>\n                <span>Ayet & Hadisler</span>\n            </button>\n            <button onclick=\"switchTab('tab-etkinlik')\" id=\"btn-tab-etkinlik\" class=\"tab-btn flex-1 min-w-[140px] px-4 py-3 rounded-xl font-bold text-sm text-slate-600 hover:text-emerald-700 hover:bg-emerald-50 transition-all duration-200 flex items-center justify-center gap-2\">\n                <i class=\"fa-solid fa-puzzle-piece\"></i>\n                <span>İnteraktif Alıştırma</span>\n            </button>\n        </div>\n\n        <!-- SEKTÖR 1: GİRİŞ VE ESMAYIHÜSNA -->\n        <div id=\"tab-genel\" class=\"tab-content block space-y-6\">\n            <!-- Özet Kartlar Grid -->\n            <div class=\"grid grid-cols-1 md:grid-cols-3 gap-6\">\n                <!-- Tanım Kartı -->\n                <div class=\"bg-white p-6 rounded-3xl shadow-sm border border-slate-200/80 hover:shadow-md transition-shadow\">\n                    <div class=\"w-12 h-12 bg-emerald-100 text-emerald-800 rounded-2xl flex items-center justify-center text-xl mb-4 font-bold\">\n                        <i class=\"fa-solid fa-book-open\"></i>\n                    </div>\n                    <h3 class=\"text-xl font-bold text-slate-900 mb-2\">Esmayıhüsna Nedir?</h3>\n                    <p class=\"text-slate-600 text-sm leading-relaxed\">\n                        Allah’ı (c.c.) <strong class=\"text-emerald-800\">en güzel şekilde tanımlayan</strong> Allah’a (c.c.) ait isimler anlamına gelir. Kendisinin güzel isimlerinin olduğunu bizzat Allah (c.c.) bildirmiştir.\n                    </p>\n                </div>\n\n                <!-- Allah'ı Tanıma Kartı -->\n                <div class=\"bg-white p-6 rounded-3xl shadow-sm border border-slate-200/80 hover:shadow-md transition-shadow\">\n                    <div class=\"w-12 h-12 bg-teal-100 text-teal-800 rounded-2xl flex items-center justify-center text-xl mb-4 font-bold\">\n                        <i class=\"fa-solid fa-eye-slash\"></i>\n                    </div>\n                    <h3 class=\"text-xl font-bold text-slate-900 mb-2\">Allah (c.c.) Nasıl Tanınır?</h3>\n                    <p class=\"text-slate-600 text-sm leading-relaxed\">\n                        Allah (c.c.) için <strong class=\"text-teal-800\">yer, şekil ve zaman söz konusu değildir.</strong> O, gözle görülemediği gibi diğer duyu organlarıyla da algılanamaz. Allah (c.c.) ancak kâinat ve insanlarla olan ilişkisi bakımından tanınabilir.\n                    </p>\n                </div>\n\n                <!-- Bilmenin Faydaları Kartı -->\n                <div class=\"bg-white p-6 rounded-3xl shadow-sm border border-slate-200/80 hover:shadow-md transition-shadow\">\n                    <div class=\"w-12 h-12 bg-amber-100 text-amber-800 rounded-2xl flex items-center justify-center text-xl mb-4 font-bold\">\n                        <i class=\"fa-solid fa-heart\"></i>\n                    </div>\n                    <h3 class=\"text-xl font-bold text-slate-900 mb-2\">Esmayıhüsnayı Bilmenin Faydaları</h3>\n                    <ul class=\"text-slate-600 text-sm space-y-1.5 list-disc list-inside\">\n                        <li>Allah’ın (c.c.) yüceliğini kavramaya yardım eder.</li>\n                        <li>Kalplere huzur ve mutluluk verir.</li>\n                        <li>Yapılan duaların kabul olmasına vesile olur.</li>\n                        <li>Allah'ı daha yakından tanımamızı sağlar.</li>\n                    </ul>\n                </div>\n            </div>\n\n            <!-- Ayet ve Unutmayalım Kutuları -->\n            <div class=\"grid grid-cols-1 lg:grid-cols-2 gap-6\">\n                <!-- Ayet Kutusu -->\n                <div class=\"bg-gradient-to-br from-emerald-900 to-teal-900 text-white p-6 rounded-3xl shadow-md relative overflow-hidden\">\n                    <div class=\"absolute -right-6 -bottom-6 opacity-10 text-9xl\">\n                        <i class=\"fa-solid fa-quote-right\"></i>\n                    </div>\n                    <div class=\"flex items-center gap-2 text-amber-300 font-bold text-xs uppercase tracking-wider mb-3\">\n                        <i class=\"fa-solid fa-scroll\"></i> Bir Ayet (A’râf Suresi, 180. Ayet)\n                    </div>\n                    <blockquote class=\"text-lg font-medium leading-relaxed italic text-emerald-50\">\n                        “En güzel isimler Allah’ındır. O’na o güzel isimleriyle dua edin…”\n                    </blockquote>\n                </div>\n\n                <!-- Püf Nokta / Unutmayalım -->\n                <div class=\"bg-amber-50 border border-amber-200 p-6 rounded-3xl flex items-start space-x-4\">\n                    <div class=\"w-12 h-12 bg-amber-500 text-white rounded-2xl flex-shrink-0 flex items-center justify-center text-2xl shadow-md shadow-amber-200\">\n                        <i class=\"fa-solid fa-lightbulb\"></i>\n                    </div>\n                    <div>\n                        <h4 class=\"text-lg font-bold text-amber-900 mb-1\">💡 Önemli Sünnet Bilgisi</h4>\n                        <p class=\"text-amber-800 text-sm leading-relaxed\">\n                            Hz. Muhammed (s.a.v.) dualarına her zaman <strong>Allah’ın (c.c.) güzel isimleriyle</strong> başlamıştır. Esmayıhüsnada geçen isimleri bilmek ve anlamları hakkında düşünmek gerekir.\n                        </p>\n                    </div>\n                </div>\n            </div>\n        </div>\n\n        <!-- SEKTÖR 2: ALLAH (C.C.) İSMİ -->\n        <div id=\"tab-allah\" class=\"tab-content hidden space-y-6\">\n            <div class=\"bg-white p-6 sm:p-8 rounded-3xl shadow-sm border border-slate-200/80\">\n                <div class=\"flex flex-col lg:flex-row gap-8 items-center\">\n                    <div class=\"lg:w-2/3 space-y-4\">\n                        <div class=\"inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-100 text-emerald-800 text-xs font-bold\">\n                            <i class=\"fa-solid fa-star\"></i> En Özel İsim\n                        </div>\n                        <h2 class=\"text-3xl font-extrabold text-slate-900\">Allah (c.c.)</h2>\n                        <p class=\"text-slate-700 leading-relaxed\">\n                            <strong>Esmayıhüsnanın içerdiği tüm isimlerin anlamlarını kendisinde toplayan yaratıcının en özel ismidir.</strong>\n                        </p>\n                        \n                        <div class=\"grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2\">\n                            <div class=\"bg-slate-50 p-4 rounded-2xl border border-slate-200\">\n                                <h4 class=\"font-bold text-emerald-900 text-sm mb-1\"><i class=\"fa-solid fa-ban text-red-500 mr-2\"></i>Özel ve Tekil Yapısı</h4>\n                                <ul class=\"text-xs text-slate-600 space-y-1\">\n                                    <li>• Sadece O’na ait bir isimdir, başka varlığa verilemez.</li>\n                                    <li>• <strong>Çoğulu olmaz.</strong></li>\n                                    <li>• Başka dillere çevirisi yapılamaz, her dilde aynı okunur.</li>\n                                </ul>\n                            </div>\n                            <div class=\"bg-slate-50 p-4 rounded-2xl border border-slate-200\">\n                                <h4 class=\"font-bold text-emerald-900 text-sm mb-1\"><i class=\"fa-solid fa-infinity text-blue-500 mr-2\"></i>Yaratma ve İdare</h4>\n                                <ul class=\"text-xs text-slate-600 space-y-1\">\n                                    <li>• Bir şeyi yaratmak için <strong>maddeye, alete ve süreye ihtiyacı yoktur.</strong></li>\n                                    <li>• Yarattığı tüm varlıkları idare edendir.</li>\n                                    <li>• Kâinatın yöneticisidir ve mükemmel bir varlıktır.</li>\n                                </ul>\n                            </div>\n                        </div>\n\n                        <div class=\"bg-emerald-50 border-l-4 border-emerald-600 p-4 rounded-r-2xl\">\n                            <p class=\"text-xs text-emerald-900\">\n                                <strong>Kur’an-ı Kerim Bilgisi:</strong> Kur'an-ı Kerim'de Allah (c.c.) ismi ile beraber <em>ilah, mevla, Rab</em> gibi isimler de Allah (c.c.) için kullanılmıştır.\n                            </p>\n                        </div>\n                    </div>\n\n                    <!-- Hat Görsel Temsili -->\n                    <div class=\"lg:w-1/3 w-full bg-gradient-to-b from-emerald-800 to-teal-900 text-white rounded-3xl p-6 text-center shadow-lg border-4 border-amber-400/30\">\n                        <div class=\"text-amber-300 font-arabic text-6xl my-4 font-bold tracking-wide\">\n                            اللّٰه\n                        </div>\n                        <p class=\"text-emerald-200 font-semibold text-sm\">Görsel Hat Temsili</p>\n                        <p class=\"text-xs text-emerald-300/80 mt-2\">\"O'na benzer hiçbir varlık yoktur. İnsanlar tarafından doğrudan doğruya görülmesi mümkün değildir.\"</p>\n                    </div>\n                </div>\n            </div>\n\n            <!-- Ayetler Kutusu -->\n            <div class=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n                <div class=\"bg-white p-6 rounded-3xl border border-slate-200 shadow-sm\">\n                    <span class=\"text-xs font-bold text-emerald-600 uppercase\">A’râf Suresi, 54. Ayet</span>\n                    <blockquote class=\"mt-2 text-slate-700 italic text-sm\">\n                        “… Yaratmak da emretmek de yalnız O’na mahsustur. Âlemlerin Rabbi olan Allah’ın şanı yücedir.”\n                    </blockquote>\n                </div>\n                <div class=\"bg-white p-6 rounded-3xl border border-slate-200 shadow-sm\">\n                    <span class=\"text-xs font-bold text-emerald-600 uppercase\">İsrâ Suresi, 110. Ayet</span>\n                    <blockquote class=\"mt-2 text-slate-700 italic text-sm\">\n                        “De ki: (Rabbinizi) ister Allah diye çağırın ister Rahman diye çağırın. Hangisiyle çağırırsanız çağırın, nihayet en güzel isimler O’nundur…”\n                    </blockquote>\n                </div>\n            </div>\n        </div>\n\n        <!-- SEKTÖR 3: VAHİD VE EHAD -->\n        <div id=\"tab-vahid-ehad\" class=\"tab-content hidden space-y-6\">\n            <div class=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n                <!-- el-VAHİD -->\n                <div class=\"bg-white p-6 sm:p-8 rounded-3xl shadow-sm border border-slate-200/80 flex flex-col justify-between\">\n                    <div>\n                        <div class=\"flex items-center justify-between mb-4\">\n                            <span class=\"px-3 py-1 bg-teal-100 text-teal-800 rounded-full font-bold text-xs\">İsim 1</span>\n                            <span class=\"font-arabic text-3xl text-teal-800 font-bold\">الواحد</span>\n                        </div>\n                        <h3 class=\"text-2xl font-extrabold text-slate-900 mb-3\">el-Vahid</h3>\n                        <p class=\"text-slate-600 text-sm leading-relaxed mb-4\">\n                            Zatında, isim ve sıfatlarında <strong class=\"text-slate-900\">eşi ve benzeri bulunmayan, tek olan</strong> anlamına gelir. Allah (c.c.) dışında hiçbir varlık Vahid olma özelliğine sahip değildir. O’nun benzeri olmadığı gibi ortağı (şeriki) da yoktur.\n                        </p>\n                    </div>\n                    \n                    <div class=\"bg-slate-50 p-4 rounded-2xl border border-slate-200 mt-4 space-y-2\">\n                        <div class=\"text-xs font-bold text-teal-800\">Bakara Suresi, 163. Ayet:</div>\n                        <p class=\"text-xs text-slate-700 italic\">\n                            “Sizin ilahınız, bir tek ilahtır. O’ndan başka ilah yoktur. O, Rahman’dır, Rahîm’dir.”\n                        </p>\n                    </div>\n                </div>\n\n                <!-- el-EHAD -->\n                <div class=\"bg-white p-6 sm:p-8 rounded-3xl shadow-sm border border-slate-200/80 flex flex-col justify-between\">\n                    <div>\n                        <div class=\"flex items-center justify-between mb-4\">\n                            <span class=\"px-3 py-1 bg-emerald-100 text-emerald-800 rounded-full font-bold text-xs\">İsim 2</span>\n                            <span class=\"font-arabic text-3xl text-emerald-800 font-bold\">الأحد</span>\n                        </div>\n                        <h3 class=\"text-2xl font-extrabold text-slate-900 mb-3\">el-Ehad</h3>\n                        <p class=\"text-slate-600 text-sm leading-relaxed mb-4\">\n                            <strong class=\"text-slate-900\">Bir ve tek olan, benzeri ve dengi bulunmayan</strong> anlamlarına gelir. Allah'ın (c.c.) her zaman var olduğu gerçeğinin ifadesidir. Kâinatı tek başına yaratmış ve tek başına idare etmektedir.\n                        </p>\n                    </div>\n\n                    <div class=\"bg-slate-50 p-4 rounded-2xl border border-slate-200 mt-4 space-y-2\">\n                        <div class=\"text-xs font-bold text-emerald-800\">İhlâs Suresi, 1. Ayet:</div>\n                        <p class=\"text-xs text-slate-700 italic\">\n                            “De ki: O, Allah’tır, bir tektir.”\n                        </p>\n                    </div>\n                </div>\n            </div>\n\n            <!-- İki İsim Arasındaki Ortak Nokta -->\n            <div class=\"bg-gradient-to-r from-teal-900 to-emerald-900 text-white p-6 rounded-3xl shadow-md\">\n                <div class=\"flex items-start space-x-4\">\n                    <div class=\"w-10 h-10 bg-amber-400 text-slate-900 rounded-xl flex-shrink-0 flex items-center justify-center font-bold text-xl\">\n                        <i class=\"fa-solid fa-link\"></i>\n                    </div>\n                    <div>\n                        <h4 class=\"text-lg font-bold text-amber-300 mb-1\">Vahid ve Ehad İsimlerinin Ortak Vurgusu</h4>\n                        <p class=\"text-emerald-100 text-sm leading-relaxed\">\n                            Her iki isim de Allah’ın (c.c.) <strong>birliğine ve tek ilah olduğuna</strong> vurgu yapar. Bu isimler Allah’ın (c.c.) <strong>ezelî ve ebedî</strong> yönüne işaret eder (Başlangıcı bulunmadığı gibi sonunun da olmadığını belirtir).\n                        </p>\n                    </div>\n                </div>\n            </div>\n        </div>\n\n        <!-- SEKTÖR 4: EL-MÜMİN -->\n        <div id=\"tab-mumin\" class=\"tab-content hidden space-y-6\">\n            <div class=\"bg-white p-6 sm:p-8 rounded-3xl shadow-sm border border-slate-200/80\">\n                <div class=\"flex flex-col md:flex-row gap-8 items-center\">\n                    <div class=\"md:w-2/3 space-y-4\">\n                        <div class=\"flex items-center gap-3\">\n                            <span class=\"px-3 py-1 bg-amber-100 text-amber-900 rounded-full font-bold text-xs\">Güven & Huzur Kaynağı</span>\n                            <span class=\"font-arabic text-3xl text-amber-800 font-bold\">المؤمن</span>\n                        </div>\n                        <h2 class=\"text-3xl font-extrabold text-slate-900\">el-Mümin</h2>\n                        \n                        <div class=\"bg-slate-50 p-5 rounded-2xl border border-slate-200 space-y-2\">\n                            <h4 class=\"font-bold text-slate-900 text-sm\">Üç Temel Anlamı:</h4>\n                            <ol class=\"list-decimal list-inside text-sm text-slate-700 space-y-1\">\n                                <li>Kullarına verdiği sözde <strong>sadık olan</strong>,</li>\n                                <li>Kalplere <strong>iman nurunu veren</strong>,</li>\n                                <li>Kullarını her türlü korkudan kurtarıp <strong>güvenliğe kavuşturan</strong>.</li>\n                            </ol>\n                        </div>\n\n                        <p class=\"text-slate-600 text-sm leading-relaxed\">\n                            Mümin olan Allah (c.c.) yarattığı kullarına güven veren, onların emniyette olmasını sağlayandır. Kendisine sığınan kullarını daima koruyup kollar. Kullarının hem bu dünyada hem de ahirette en büyük yardımcıdır. O kullarını hiçbir zaman yalnız bırakmaz.\n                        </p>\n                    </div>\n\n                    <div class=\"md:w-1/3 w-full bg-amber-50 border-2 border-amber-200 rounded-3xl p-6 text-center\">\n                        <div class=\"w-16 h-16 bg-amber-500 text-white rounded-2xl flex items-center justify-center text-3xl mx-auto mb-4 shadow-lg shadow-amber-200\">\n                            <i class=\"fa-solid fa-user-shield\"></i>\n                        </div>\n                        <h4 class=\"font-bold text-amber-950 text-base mb-2\">Müminin Sorumluluğu</h4>\n                        <p class=\"text-xs text-amber-800 leading-relaxed\">\n                            Allah’ın (c.c.) her zaman yanında olduğunu bilen müminler, yalnızca O’na güvenmeli ve her durumda O'na sığınmalıdır.\n                        </p>\n                    </div>\n                </div>\n            </div>\n        </div>\n\n        <!-- SEKTÖR 5: TÜM AYET VE HADİSLER -->\n        <div id=\"tab-ayet-hadis\" class=\"tab-content hidden space-y-6\">\n            <h3 class=\"text-2xl font-bold text-slate-900 mb-4 flex items-center gap-2\">\n                <i class=\"fa-solid fa-book-bookmark text-emerald-700\"></i>\n                Ders Kitabında Geçen Ayet ve Hadis-i Şerifler\n            </h3>\n\n            <!-- Ayetler Grubu -->\n            <div class=\"space-y-4\">\n                <h4 class=\"text-lg font-bold text-emerald-900 border-b border-emerald-200 pb-2\">Ayet-i Kerimeler</h4>\n                \n                <div class=\"bg-white p-5 rounded-2xl border border-slate-200 shadow-sm space-y-2\">\n                    <div class=\"flex justify-between items-center text-xs font-bold text-emerald-700\">\n                        <span>A'RÂF SURESİ 180. AYET</span>\n                        <i class=\"fa-solid fa-quran\"></i>\n                    </div>\n                    <p class=\"text-slate-800 font-medium\">“En güzel isimler Allah’ındır. O’na o güzel isimleriyle dua edin…”</p>\n                </div>\n\n                <div class=\"bg-white p-5 rounded-2xl border border-slate-200 shadow-sm space-y-2\">\n                    <div class=\"flex justify-between items-center text-xs font-bold text-emerald-700\">\n                        <span>A'RÂF SURESİ 54. AYET</span>\n                        <i class=\"fa-solid fa-quran\"></i>\n                    </div>\n                    <p class=\"text-slate-800 font-medium\">“… Yaratmak da emretmek de yalnız O’na mahsustur. Âlemlerin Rabbi olan Allah’ın şanı yücedir.”</p>\n                </div>\n\n                <div class=\"bg-white p-5 rounded-2xl border border-slate-200 shadow-sm space-y-2\">\n                    <div class=\"flex justify-between items-center text-xs font-bold text-emerald-700\">\n                        <span>İSRÂ SURESİ 110. AYET</span>\n                        <i class=\"fa-solid fa-quran\"></i>\n                    </div>\n                    <p class=\"text-slate-800 font-medium\">“De ki: (Rabbinizi) ister Allah diye çağırın ister Rahman diye çağırın. Hangisiyle çağırırsanız çağırın, nihayet en güzel isimler O’nundur...”</p>\n                </div>\n\n                <div class=\"bg-white p-5 rounded-2xl border border-slate-200 shadow-sm space-y-2\">\n                    <div class=\"flex justify-between items-center text-xs font-bold text-emerald-700\">\n                        <span>BAKARA SURESİ 163. AYET</span>\n                        <i class=\"fa-solid fa-quran\"></i>\n                    </div>\n                    <p class=\"text-slate-800 font-medium\">“Sizin ilahınız, bir tek ilahtır. O’ndan başka ilah yoktur. O, Rahman’dır, Rahîm’dir.”</p>\n                </div>\n\n                <div class=\"bg-white p-5 rounded-2xl border border-slate-200 shadow-sm space-y-2\">\n                    <div class=\"flex justify-between items-center text-xs font-bold text-emerald-700\">\n                        <span>İHLÂS SURESİ 1. AYET</span>\n                        <i class=\"fa-solid fa-quran\"></i>\n                    </div>\n                    <p class=\"text-slate-800 font-medium\">“De ki: O, Allah’tır, bir tektir.”</p>\n                </div>\n            </div>\n\n            <!-- Hadisler Grubu -->\n            <div class=\"space-y-4 pt-4\">\n                <h4 class=\"text-lg font-bold text-teal-900 border-b border-teal-200 pb-2\">Hadis-i Şerifler</h4>\n                \n                <div class=\"bg-white p-5 rounded-2xl border border-slate-200 shadow-sm space-y-2\">\n                    <div class=\"flex justify-between items-center text-xs font-bold text-teal-700\">\n                        <span>EBU DAVUD, EDEB, 97-98</span>\n                        <i class=\"fa-solid fa-hands-praying\"></i>\n                    </div>\n                    <p class=\"text-slate-800 font-medium\">“Bana yeten, beni barındıran, beni yediren ve içiren, bana iyilik edip (iyiliğini) arttıran, bana nimet verip (nimetini) bollaştıran Allah’a hamdolsun. Her hâl ve durumda Allah’a hamdolsun. Her şeyin Rabbi, hükümdarı ve ilahı olan Allah’ım!...”</p>\n                </div>\n\n                <div class=\"bg-white p-5 rounded-2xl border border-slate-200 shadow-sm space-y-2\">\n                    <div class=\"flex justify-between items-center text-xs font-bold text-teal-700\">\n                        <span>BUHARİ, TEHECCÜD, 21</span>\n                        <i class=\"fa-solid fa-hands-praying\"></i>\n                    </div>\n                    <p class=\"text-slate-800 font-medium\">“Allah’tan başka ilah yok, yalnız O vardır. Şeriki (ortağı) yoktur. Mülk O’nundur. Hamd da O’na mahsustur ve O her şeye kadirdir. Allah’a hamd eder, Allah’ı tespih ederim. Allah’tan başka ilah yok ve Allah en büyüktür, Allah’a dayanmaktan başka kuvvet ve kudret yoktur...”</p>\n                </div>\n\n                <div class=\"bg-white p-5 rounded-2xl border border-slate-200 shadow-sm space-y-2\">\n                    <div class=\"flex justify-between items-center text-xs font-bold text-teal-700\">\n                        <span>TİRMİZİ, DEAVAT, 19; MÜSLİM, ZİKİR, 61</span>\n                        <i class=\"fa-solid fa-hands-praying\"></i>\n                    </div>\n                    <p class=\"text-slate-800 font-medium\">“... Sen Evvelsin, senden önce hiçbir şey yoktur. Sen Ahirsin, senden sonra da hiçbir şey olmayacaktır. Zahir (varlığı delillerle apaçık olan) sensin, varlığı seninkinden daha aşikâr hiçbir şey yoktur...”</p>\n                </div>\n            </div>\n        </div>\n\n        <!-- SEKTÖR 6: İNTERAKTİF ALIŞTIRMA & KAVRAM EŞLEŞTİRME -->\n        <div id=\"tab-etkinlik\" class=\"tab-content hidden space-y-6\">\n            <div class=\"bg-white p-6 sm:p-8 rounded-3xl shadow-sm border border-slate-200/80\">\n                <h3 class=\"text-2xl font-bold text-slate-900 mb-2\">Akıllı Tahta Etkileşimli Eşleştirme Uygulaması</h3>\n                <p class=\"text-slate-600 text-sm mb-6\">Tanımı okuyunuz ve doğru Esmayıhüsna kavramını seçiniz.</p>\n\n                <div class=\"space-y-4\" id=\"quiz-container\">\n                    <!-- Soru 1 -->\n                    <div class=\"p-4 bg-slate-50 rounded-2xl border border-slate-200 flex flex-col sm:flex-row sm:items-center justify-between gap-4\">\n                        <span class=\"text-sm font-semibold text-slate-800\">1. \"En güzel isimler demektir.\"</span>\n                        <div class=\"flex gap-2\">\n                            <button onclick=\"checkAnswer(this, false)\" class=\"px-3 py-1.5 bg-white border rounded-xl text-xs font-bold hover:bg-slate-100\">Allah</button>\n                            <button onclick=\"checkAnswer(this, true)\" class=\"px-3 py-1.5 bg-white border rounded-xl text-xs font-bold hover:bg-slate-100\">Esmayıhüsna</button>\n                            <button onclick=\"checkAnswer(this, false)\" class=\"px-3 py-1.5 bg-white border rounded-xl text-xs font-bold hover:bg-slate-100\">Vahid</button>\n                        </div>\n                    </div>\n\n                    <!-- Soru 2 -->\n                    <div class=\"p-4 bg-slate-50 rounded-2xl border border-slate-200 flex flex-col sm:flex-row sm:items-center justify-between gap-4\">\n                        <span class=\"text-sm font-semibold text-slate-800\">2. \"Zatında, isim ve sıfatlarında eşi ve benzeri bulunmayan, tek olan.\"</span>\n                        <div class=\"flex gap-2\">\n                            <button onclick=\"checkAnswer(this, true)\" class=\"px-3 py-1.5 bg-white border rounded-xl text-xs font-bold hover:bg-slate-100\">Vahid</button>\n                            <button onclick=\"checkAnswer(this, false)\" class=\"px-3 py-1.5 bg-white border rounded-xl text-xs font-bold hover:bg-slate-100\">Mümin</button>\n                            <button onclick=\"checkAnswer(this, false)\" class=\"px-3 py-1.5 bg-white border rounded-xl text-xs font-bold hover:bg-slate-100\">Ehad</button>\n                        </div>\n                    </div>\n\n                    <!-- Soru 3 -->\n                    <div class=\"p-4 bg-slate-50 rounded-2xl border border-slate-200 flex flex-col sm:flex-row sm:items-center justify-between gap-4\">\n                        <span class=\"text-sm font-semibold text-slate-800\">3. \"Vaadini yerine getiren, güven veren, emniyete kavuşturan.\"</span>\n                        <div class=\"flex gap-2\">\n                            <button onclick=\"checkAnswer(this, false)\" class=\"px-3 py-1.5 bg-white border rounded-xl text-xs font-bold hover:bg-slate-100\">Allah</button>\n                            <button onclick=\"checkAnswer(this, false)\" class=\"px-3 py-1.5 bg-white border rounded-xl text-xs font-bold hover:bg-slate-100\">Vahid</button>\n                            <button onclick=\"checkAnswer(this, true)\" class=\"px-3 py-1.5 bg-white border rounded-xl text-xs font-bold hover:bg-slate-100\">Mümin</button>\n                        </div>\n                    </div>\n\n                    <!-- Soru 4 -->\n                    <div class=\"p-4 bg-slate-50 rounded-2xl border border-slate-200 flex flex-col sm:flex-row sm:items-center justify-between gap-4\">\n                        <span class=\"text-sm font-semibold text-slate-800\">4. \"Bir ve tek olan, ezelî ve ebedî, kâinatı tek başına idare eden.\"</span>\n                        <div class=\"flex gap-2\">\n                            <button onclick=\"checkAnswer(this, true)\" class=\"px-3 py-1.5 bg-white border rounded-xl text-xs font-bold hover:bg-slate-100\">Ehad</button>\n                            <button onclick=\"checkAnswer(this, false)\" class=\"px-3 py-1.5 bg-white border rounded-xl text-xs font-bold hover:bg-slate-100\">Mümin</button>\n                            <button onclick=\"checkAnswer(this, false)\" class=\"px-3 py-1.5 bg-white border rounded-xl text-xs font-bold hover:bg-slate-100\">Esmayıhüsna</button>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n\n    </main>\n\n    <!-- ALT BİLGİ / FOOTER -->\n    <footer class=\"bg-slate-900 text-slate-400 py-6 border-t border-slate-800 mt-12\">\n        <div class=\"max-w-7xl mx-auto px-4 text-center text-xs space-y-1\">\n            <p class=\"font-semibold text-slate-300\">Millî Eğitim Bakanlığı (MEB) Din Kültürü ve Ahlak Bilgisi Ders Kitabı Esas Alınmıştır.</p>\n            <p>© Akıllı Tahta Uyumlu İnteraktif Ders Özet Sistemi</p>\n        </div>\n    </footer>\n\n    <!-- INTERFAZ SCRIPT -->\n    <script>\n        function switchTab(tabId) {\n            // Gizle tüm içerikleri\n            const contents = document.querySelectorAll('.tab-content');\n            contents.forEach(c => c.classList.add('hidden'));\n            contents.forEach(c => c.classList.remove('block'));\n\n            // Deaktif yap tüm butonları\n            const buttons = document.querySelectorAll('.tab-btn');\n            buttons.forEach(b => b.classList.remove('active'));\n\n            // Göster seçilen içerik ve aktif buton\n            document.getElementById(tabId).classList.remove('hidden');\n            document.getElementById(tabId).classList.add('block');\n            document.getElementById('btn-' + tabId).classList.add('active');\n        }\n\n        function checkAnswer(btn, isCorrect) {\n            const parent = btn.parentElement;\n            const buttons = parent.querySelectorAll('button');\n            buttons.forEach(b => {\n                b.classList.remove('bg-emerald-600', 'bg-red-600', 'text-white');\n                b.classList.add('bg-white', 'text-slate-800');\n            });\n\n            if (isCorrect) {\n                btn.classList.remove('bg-white', 'text-slate-800');\n                btn.classList.add('bg-emerald-600', 'text-white');\n            } else {\n                btn.classList.remove('bg-white', 'text-slate-800');\n                btn.classList.add('bg-red-600', 'text-white');\n            }\n        }\n    </script>\n</body>\n</html>",
