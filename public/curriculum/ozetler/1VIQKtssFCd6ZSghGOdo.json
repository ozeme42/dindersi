{
  "htmlContent": "<!DOCTYPE html>\n<html lang=\"tr\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>MEB 5. Sınıf Kur'an-ı Kerim - Harfleri Yazma Özet Pano</title>\n    <!-- Tailwind CSS CDN -->\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <!-- FontAwesome CDN -->\n    <link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css\" />\n    <!-- Google Fonts: Amiri & Outfit -->\n    <link href=\"https://fonts.googleapis.com/css2?family=Amiri:ital,wght@0,400;0,700;1,400&family=Outfit:wght@300;400;500;600;700;800&display=swap\" rel=\"stylesheet\">\n    \n    <script>\n        tailwind.config = {\n            theme: {\n                extend: {\n                    fontFamily: {\n                        sans: ['Outfit', 'sans-serif'],\n                        arabic: ['Amiri', 'serif'],\n                    },\n                    colors: {\n                        mora: {\n                            50: '#f5f3ff',\n                            100: '#ede9fe',\n                            500: '#8b5cf6',\n                            700: '#6d28d9',\n                            900: '#4c1d95',\n                        },\n                        emeraldCustom: {\n                            50: '#ecfdf5',\n                            100: '#d1fae5',\n                            600: '#059669',\n                            800: '#065f46',\n                        }\n                    }\n                }\n            }\n        }\n    </script>\n    <style>\n        .arabic-text {\n            font-family: 'Amiri', serif;\n            direction: rtl;\n        }\n        .custom-scrollbar::-webkit-scrollbar {\n            width: 8px;\n            height: 8px;\n        }\n        .custom-scrollbar::-webkit-scrollbar-track {\n            background: #f1f5f9;\n            border-radius: 8px;\n        }\n        .custom-scrollbar::-webkit-scrollbar-thumb {\n            background: #cbd5e1;\n            border-radius: 8px;\n        }\n        .custom-scrollbar::-webkit-scrollbar-thumb:hover {\n            background: #94a3b8;\n        }\n    </style>\n</head>\n<body class=\"bg-slate-50 text-slate-800 font-sans min-h-screen antialiased p-3 md:p-6\">\n\n    <div class=\"max-w-7xl mx-auto space-y-6\">\n        \n        <!-- HEADER / UST BİLGİ PANOSU -->\n        <header class=\"bg-gradient-to-r from-emerald-800 via-teal-700 to-cyan-800 text-white rounded-3xl p-6 shadow-xl relative overflow-hidden\">\n            <div class=\"absolute -right-10 -bottom-10 w-48 h-48 bg-white/10 rounded-full blur-2xl pointer-events-none\"></div>\n            <div class=\"relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-4\">\n                <div>\n                    <div class=\"flex items-center gap-2 text-emerald-200 text-xs md:text-sm font-semibold tracking-wider uppercase mb-1\">\n                        <span class=\"bg-emerald-900/60 px-3 py-1 rounded-full border border-emerald-400/30\">MEB 5. Sınıf Kur'an-ı Kerim</span>\n                        <span>•</span>\n                        <span>1. Tema: Kur'an-ı Kerim'i Tanıyorum</span>\n                    </div>\n                    <h1 class=\"text-2xl md:text-4xl font-extrabold tracking-tight flex items-center gap-3\">\n                        <i class=\"fa-solid font-arabic text-amber-300\">1.3. Harfleri Yazma</i>\n                    </h1>\n                    <p class=\"text-emerald-100 text-sm md:text-base mt-1 max-w-2xl\">\n                        Arap harflerinin kelime içindeki konumları (başta, ortada, sonda), birleşme kuralları ve yazım özellikleri.\n                    </p>\n                </div>\n                <div class=\"flex items-center gap-2 bg-white/10 backdrop-blur-md px-4 py-3 rounded-2xl border border-white/20 self-start md:self-auto\">\n                    <i class=\"fa-solid fa-desktop text-amber-300 text-2xl\"></i>\n                    <div>\n                        <div class=\"text-xs text-emerald-100 font-medium\">Akıllı Tahta Modu</div>\n                        <div class=\"text-xs font-bold text-white\">İnteraktif Ders Özet Modülü</div>\n                    </div>\n                </div>\n            </div>\n        </header>\n\n        <!-- KAZANIM ÖZETİ & PÜF NOKTALAR GRID -->\n        <div class=\"grid grid-cols-1 lg:grid-cols-3 gap-6\">\n\n            <!-- KAZANIM MADDELERİ -->\n            <div class=\"bg-white rounded-3xl p-6 shadow-sm border border-slate-200 flex flex-col justify-between\">\n                <div>\n                    <div class=\"flex items-center gap-3 mb-4\">\n                        <div class=\"w-10 h-10 rounded-xl bg-teal-100 text-teal-700 flex items-center justify-center text-lg font-bold\">\n                            <i class=\"fa-solid fa-list-check\"></i>\n                        </div>\n                        <h2 class=\"text-lg font-bold text-slate-900\">Konu Kazanım Maddeleri</h2>\n                    </div>\n                    <ul class=\"space-y-3 text-sm text-slate-600\">\n                        <li class=\"flex items-start gap-3\">\n                            <i class=\"fa-solid fa-circle-check text-emerald-600 mt-1 flex-shrink-0\"></i>\n                            <span>Arapçada harflerin yazılışları kelimede bulundukları yere göre (başta, ortada, sonda) farklılık gösterir.</span>\n                        </li>\n                        <li class=\"flex items-start gap-3\">\n                            <i class=\"fa-solid fa-circle-check text-emerald-600 mt-1 flex-shrink-0\"></i>\n                            <span>Kendinden sonra gelen harfle birleşmeyen özel 6 Kur'an harfi bulunur.</span>\n                        </li>\n                        <li class=\"flex items-start gap-3\">\n                            <i class=\"fa-solid fa-circle-check text-emerald-600 mt-1 flex-shrink-0\"></i>\n                            <span>Harekeli Elif (ا) harfi <strong>Hemze</strong> olarak adlandırılır ve farklı biçimlerde yazılabilir.</span>\n                        </li>\n                        <li class=\"flex items-start gap-3\">\n                            <i class=\"fa-solid fa-circle-check text-emerald-600 mt-1 flex-shrink-0\"></i>\n                            <span>Kelime sonundaki <strong>Yuvarlak Te (ة)</strong> bitişip bitişmeme durumuna göre iki farklı şekil alır.</span>\n                        </li>\n                    </ul>\n                </div>\n                <div class=\"mt-4 pt-4 border-t border-slate-100 text-xs text-slate-500 flex items-center gap-2\">\n                    <i class=\"fa-solid fa-pen-nib text-teal-600\"></i>\n                    <span>Harfleri ok yönüne dikkat ederek doğru formda yazmak esastır.</span>\n                </div>\n            </div>\n\n            <!-- UNUTMAYALIM / KRİTİK PÜF NOKTA: BİRLEŞMEYEN HARFLER -->\n            <div class=\"bg-gradient-to-br from-amber-500 to-orange-600 text-white rounded-3xl p-6 shadow-md flex flex-col justify-between relative overflow-hidden\">\n                <div class=\"absolute -right-6 -top-6 w-32 h-32 bg-white/10 rounded-full blur-xl\"></div>\n                <div>\n                    <div class=\"flex items-center justify-between mb-3\">\n                        <span class=\"bg-black/20 text-amber-100 text-xs px-3 py-1 rounded-full font-bold uppercase tracking-wider\">\n                            💡 Sınav İpucu / Unutmayalım!\n                        </span>\n                        <i class=\"fa-solid fa-lightbulb text-amber-200 text-2xl\"></i>\n                    </div>\n                    <h3 class=\"text-xl font-extrabold mb-2\">Kendinden Sonra Birleşmeyen Harfler</h3>\n                    <p class=\"text-amber-100 text-sm mb-4\">\n                        Aşağıdaki <strong>6 harf</strong>, kendinden sonra gelen harflerle <u>birleşmez</u>:\n                    </p>\n                    \n                    <!-- 6 Harf Kutusu -->\n                    <div class=\"bg-white/10 backdrop-blur-md rounded-2xl p-4 border border-white/20 grid grid-cols-6 gap-2 text-center dir-rtl\">\n                        <div class=\"bg-white text-orange-900 font-arabic text-3xl font-bold py-2 rounded-xl shadow-sm\">ا</div>\n                        <div class=\"bg-white text-orange-900 font-arabic text-3xl font-bold py-2 rounded-xl shadow-sm\">د</div>\n                        <div class=\"bg-white text-orange-900 font-arabic text-3xl font-bold py-2 rounded-xl shadow-sm\">ذ</div>\n                        <div class=\"bg-white text-orange-900 font-arabic text-3xl font-bold py-2 rounded-xl shadow-sm\">ر</div>\n                        <div class=\"bg-white text-orange-900 font-arabic text-3xl font-bold py-2 rounded-xl shadow-sm\">ز</div>\n                        <div class=\"bg-white text-orange-900 font-arabic text-3xl font-bold py-2 rounded-xl shadow-sm\">و</div>\n                    </div>\n                </div>\n                <div class=\"mt-4 text-xs text-amber-100 bg-black/10 p-2.5 rounded-xl border border-white/10\">\n                    <i class=\"fa-solid fa-circle-info mr-1\"></i> Bu harfler sadece kendinden önceki harfle birleşebilir, sonraki harfle birleşmez.\n                </div>\n            </div>\n\n            <!-- KAVRAM KARTLARI (HEMZE & YUVARLAK TE) -->\n            <div class=\"bg-white rounded-3xl p-6 shadow-sm border border-slate-200 space-y-4\">\n                <div class=\"flex items-center gap-3\">\n                    <div class=\"w-10 h-10 rounded-xl bg-indigo-100 text-indigo-700 flex items-center justify-center text-lg font-bold\">\n                        <i class=\"fa-solid fa-bookmark\"></i>\n                    </div>\n                    <h2 class=\"text-lg font-bold text-slate-900\">Özel Kavramlar & Biçimler</h2>\n                </div>\n\n                <!-- Hemze Kartı -->\n                <div class=\"bg-indigo-50/70 border border-indigo-100 rounded-2xl p-3.5\">\n                    <div class=\"flex items-center justify-between mb-1\">\n                        <span class=\"font-bold text-indigo-900 text-sm\">Harekeli Elif (Hemze)</span>\n                        <span class=\"text-xs bg-indigo-200 text-indigo-800 font-semibold px-2 py-0.5 rounded\">1.3.1</span>\n                    </div>\n                    <p class=\"text-xs text-indigo-700 mb-2\">\n                        Harekeli <span class=\"font-arabic font-bold text-sm\">ا</span> (Elif) harfi <strong>hemze</strong> olarak isimlendirilir ve şu şekillerde de yazılır:\n                    </p>\n                    <div class=\"flex justify-around items-center bg-white rounded-xl p-2 border border-indigo-100 text-indigo-950 font-arabic text-2xl font-bold\">\n                        <span>أ</span>\n                        <span>إ</span>\n                        <span>ؤ</span>\n                        <span>ئ</span>\n                        <span>ء</span>\n                    </div>\n                </div>\n\n                <!-- Yuvarlak Te Kartı -->\n                <div class=\"bg-rose-50/70 border border-rose-100 rounded-2xl p-3.5\">\n                    <div class=\"flex items-center justify-between mb-1\">\n                        <span class=\"font-bold text-rose-900 text-sm\">Yuvarlak Te (ة)</span>\n                        <span class=\"text-xs bg-rose-200 text-rose-800 font-semibold px-2 py-0.5 rounded\">1.3.1</span>\n                    </div>\n                    <p class=\"text-xs text-rose-700 mb-2\">\n                        Kelime sonunda yer alır. Kendinden önceki harfe:\n                    </p>\n                    <div class=\"grid grid-cols-2 gap-2 text-center text-xs\">\n                        <div class=\"bg-white p-2 rounded-xl border border-rose-100\">\n                            <span class=\"block text-slate-500 mb-0.5\">Birleşirse</span>\n                            <span class=\"font-arabic text-2xl font-bold text-rose-900\">ـة</span>\n                        </div>\n                        <div class=\"bg-white p-2 rounded-xl border border-rose-100\">\n                            <span class=\"block text-slate-500 mb-0.5\">Birleşmezse</span>\n                            <span class=\"font-arabic text-2xl font-bold text-rose-900\">ة</span>\n                        </div>\n                    </div>\n                </div>\n            </div>\n\n        </div>\n\n        <!-- 1.3.2 HARFLERİN KELİME İÇİNDEKİ YAZILIŞ ŞEKİLLERİ MANTIĞI (ÖRN: BÂ HARFİ) -->\n        <section class=\"bg-white rounded-3xl p-6 shadow-sm border border-slate-200\">\n            <div class=\"flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-4 pb-4 border-b border-slate-100\">\n                <div class=\"flex items-center gap-3\">\n                    <div class=\"w-10 h-10 rounded-xl bg-cyan-100 text-cyan-700 flex items-center justify-center text-lg font-bold\">\n                        <i class=\"fa-solid fa-layer-group\"></i>\n                    </div>\n                    <div>\n                        <h2 class=\"text-lg font-bold text-slate-900\">1.3.2. Harfin Konumuna Göre Şekil Değişimi Örneği</h2>\n                        <p class=\"text-xs text-slate-500\">Kitap Kaynak Metni Konum Modelı (Örnek Harf: ب)</p>\n                    </div>\n                </div>\n                <span class=\"text-xs font-semibold bg-cyan-50 text-cyan-700 border border-cyan-200 px-3 py-1 rounded-full self-start sm:self-auto\">\n                    Konum Rehberi\n                </span>\n            </div>\n\n            <div class=\"grid grid-cols-2 md:grid-cols-4 gap-4\">\n                <!-- Bağımsız -->\n                <div class=\"bg-slate-50 border border-slate-200 rounded-2xl p-4 text-center hover:border-cyan-400 transition\">\n                    <span class=\"text-xs font-bold text-slate-400 uppercase tracking-wider block mb-1\">Bağımsız Yazım</span>\n                    <div class=\"font-arabic text-4xl text-cyan-900 font-bold my-2\">ب</div>\n                    <span class=\"text-xs text-slate-600 bg-white px-2 py-1 rounded-md border border-slate-200 block\">Yalın Hali</span>\n                </div>\n                <!-- Başta -->\n                <div class=\"bg-slate-50 border border-slate-200 rounded-2xl p-4 text-center hover:border-cyan-400 transition\">\n                    <span class=\"text-xs font-bold text-slate-400 uppercase tracking-wider block mb-1\">Başta</span>\n                    <div class=\"font-arabic text-4xl text-cyan-900 font-bold my-2\">بـ</div>\n                    <span class=\"text-xs text-slate-600 bg-white px-2 py-1 rounded-md border border-slate-200 block\">Sonraki ile bitişik</span>\n                </div>\n                <!-- Ortada -->\n                <div class=\"bg-slate-50 border border-slate-200 rounded-2xl p-4 text-center hover:border-cyan-400 transition\">\n                    <span class=\"text-xs font-bold text-slate-400 uppercase tracking-wider block mb-1\">Ortada</span>\n                    <div class=\"font-arabic text-4xl text-cyan-900 font-bold my-2\">ـبـ</div>\n                    <span class=\"text-xs text-slate-600 bg-white px-2 py-1 rounded-md border border-slate-200 block\">Hem önceki hem sonraki</span>\n                </div>\n                <!-- Sonda -->\n                <div class=\"bg-slate-50 border border-slate-200 rounded-2xl p-4 text-center hover:border-cyan-400 transition\">\n                    <span class=\"text-xs font-bold text-slate-400 uppercase tracking-wider block mb-1\">Sonda</span>\n                    <div class=\"font-arabic text-4xl text-cyan-900 font-bold my-2\">ـب</div>\n                    <span class=\"text-xs text-slate-600 bg-white px-2 py-1 rounded-md border border-slate-200 block\">Önceki ile bitişik</span>\n                </div>\n            </div>\n        </section>\n\n        <!-- INTERAKTIF TABLO: HARFLERIN KELIME ICINDEKI YAZILISLARI (7. ETKİNLİK FULL TABLO) -->\n        <section class=\"bg-white rounded-3xl p-6 shadow-sm border border-slate-200\">\n            <div class=\"flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6\">\n                <div>\n                    <div class=\"flex items-center gap-2\">\n                        <span class=\"bg-emerald-100 text-emerald-800 text-xs font-extrabold px-2.5 py-1 rounded-md uppercase\">7. Etkinlik</span>\n                        <h2 class=\"text-xl font-bold text-slate-900\">Harflerin Kelime İçindeki Yazılış Tablosu</h2>\n                    </div>\n                    <p class=\"text-xs text-slate-500 mt-1\">Ders kitabındaki tüm Kur'an harflerinin konumlarına göre biçim tablosu.</p>\n                </div>\n\n                <!-- Filtre Butonları (İnteraktif Akıllı Tahta) -->\n                <div class=\"flex items-center gap-2 bg-slate-100 p-1.5 rounded-2xl self-start md:self-auto text-xs font-semibold\">\n                    <button id=\"filter-all\" onclick=\"filterLetters('all')\" class=\"px-3 py-1.5 rounded-xl bg-white shadow-sm text-slate-800 font-bold transition\">\n                        Tüm Harfler (28)\n                    </button>\n                    <button id=\"filter-nonjoin\" onclick=\"filterLetters('nonjoin')\" class=\"px-3 py-1.5 rounded-xl text-slate-600 hover:text-slate-900 transition\">\n                        🔥 Birleşmeyenler (6 Harf)\n                    </button>\n                </div>\n            </div>\n\n            <!-- TABLO KONTEYNERİ -->\n            <div class=\"overflow-x-auto custom-scrollbar border border-slate-200 rounded-2xl\">\n                <table class=\"w-full text-center border-collapse\">\n                    <thead>\n                        <tr class=\"bg-slate-100 text-slate-700 text-sm font-bold border-b border-slate-200\">\n                            <th class=\"p-3\">Harf Kökü / Yalın</th>\n                            <th class=\"p-3\">Başta (Kelime Başı)</th>\n                            <th class=\"p-3\">Ortada (Kelime Ortası)</th>\n                            <th class=\"p-3\">Sonda (Kelime Sonu)</th>\n                            <th class=\"p-3 text-xs text-slate-500\">Özellik</th>\n                        </tr>\n                    </thead>\n                    <tbody id=\"letters-tbody\" class=\"divide-y divide-slate-100 text-lg\">\n                        <!-- JS Dynamic Insert / Fallback static rows from textbook -->\n                    </tbody>\n                </table>\n            </div>\n        </section>\n\n        <!-- ETKİNLİKLER VE DERS NOTLARI (6. VE 7. ETKİNLİK DETAYLARI) -->\n        <div class=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n\n            <!-- 6. ETKİNLİK KUTUSU -->\n            <div class=\"bg-white rounded-3xl p-6 shadow-sm border border-slate-200 flex flex-col justify-between\">\n                <div>\n                    <div class=\"flex items-center justify-between mb-3\">\n                        <span class=\"bg-teal-100 text-teal-800 text-xs font-extrabold px-3 py-1 rounded-full uppercase\">\n                            6. Etkinlik\n                        </span>\n                        <i class=\"fa-solid fa-qrcode text-slate-400 text-xl\"></i>\n                    </div>\n                    <h3 class=\"text-base font-bold text-slate-900 mb-1\">Kur'an Harflerini Yazıyorum</h3>\n                    <p class=\"text-xs text-slate-500 mb-3\"><strong>Amaç:</strong> Kur'an harflerini yazabilme.</p>\n                    <div class=\"bg-slate-50 p-3 rounded-2xl border border-slate-200 text-xs text-slate-600 space-y-2\">\n                        <p><strong>Yönerge:</strong> Koyu olarak verilen kılavuz harflerden yararlanarak noktalı şekilleri tamamlayınız. Harfleri ok yönüne dikkat ederek yazınız.</p>\n                        <div class=\"flex items-center justify-between text-slate-400 pt-2 border-t border-slate-200\">\n                            <span><i class=\"fa-solid fa-mobile-screen-button mr-1\"></i> Karekod E-İçerik Desteği</span>\n                            <span><i class=\"fa-solid fa-clipboard-check mr-1\"></i> Gözlem Formu</span>\n                        </div>\n                    </div>\n                </div>\n            </div>\n\n            <!-- 7. ETKİNLİK VE DEĞERLENDİRME KUTUSU -->\n            <div class=\"bg-white rounded-3xl p-6 shadow-sm border border-slate-200 flex flex-col justify-between\">\n                <div>\n                    <div class=\"flex items-center justify-between mb-3\">\n                        <span class=\"bg-purple-100 text-purple-800 text-xs font-extrabold px-3 py-1 rounded-full uppercase\">\n                            7. Etkinlik & Değerlendirme\n                        </span>\n                        <i class=\"fa-solid fa-square-poll-vertical text-slate-400 text-xl\"></i>\n                    </div>\n                    <h3 class=\"text-base font-bold text-slate-900 mb-1\">Harfleri Kelime İçindeki Yerine Göre Yazıyorum</h3>\n                    <p class=\"text-xs text-slate-500 mb-3\"><strong>Amaç:</strong> Harfleri kelime içindeki yerlerine göre (başta, ortada, sonda) yazabilme.</p>\n                    <div class=\"bg-slate-50 p-3 rounded-2xl border border-slate-200 text-xs text-slate-600 space-y-2\">\n                        <p><strong>Yönerge:</strong> Tabloda boş bırakılan yerlere harflerin kelime içindeki kullanımını verilen örneklerdeki gibi yazınız.</p>\n                        <div class=\"flex items-center justify-between text-purple-700 font-semibold pt-2 border-t border-slate-200\">\n                            <span><i class=\"fa-solid fa-pen-to-square mr-1\"></i> Değerlendirme:</span>\n                            <span>Gözlem Formu'nu Doldurunuz (Karekod)</span>\n                        </div>\n                    </div>\n                </div>\n            </div>\n\n        </div>\n\n        <!-- FOOTER -->\n        <footer class=\"text-center text-xs text-slate-400 py-4 border-t border-slate-200\">\n            MEB Din Kültürü ve Ahlak Bilgisi / Kur'an-ı Kerim 5. Sınıf Ders Kitabı Metnine %100 Sadık İnteraktif Ders Özet Pano\n        </footer>\n\n    </div>\n\n    <!-- JAVASCRIPT FOR INTERACTIVE TABLE -->\n    <script>\n        // Data strictly based on 7. Etkinlik Table in textbook\n        const alphabetData = [\n            { letter: 'ا', basta: 'ا', ortada: 'ـا', sonda: 'ـا', nonJoiner: true },\n            { letter: 'ب', basta: 'بـ', ortada: 'ـبـ', sonda: 'ـب', nonJoiner: false },\n            { letter: 'ت', basta: 'تـ', ortada: 'ـتـ', sonda: 'ـت', nonJoiner: false },\n            { letter: 'ث', basta: 'ثـ', ortada: 'ـثـ', sonda: 'ـث', nonJoiner: false },\n            { letter: 'ج', basta: 'جـ', ortada: 'ـجـ', sonda: 'ـج', nonJoiner: false },\n            { letter: 'ح', basta: 'حـ', ortada: 'ـحـ', sonda: 'ـح', nonJoiner: false },\n            { letter: 'خ', basta: 'خـ', ortada: 'ـخـ', sonda: 'ـخ', nonJoiner: false },\n            { letter: 'د', basta: 'د', ortada: 'ـد', sonda: 'ـد', nonJoiner: true },\n            { letter: 'ذ', basta: 'ذ', ortada: 'ـذ', sonda: 'ـذ', nonJoiner: true },\n            { letter: 'ر', basta: 'ر', ortada: 'ـر', sonda: 'ـر', nonJoiner: true },\n            { letter: 'ز', basta: 'ز', ortada: 'ـز', sonda: 'ـز', nonJoiner: true },\n            { letter: 'س', basta: 'سـ', ortada: 'ـسـ', sonda: 'ـس', nonJoiner: false },\n            { letter: 'ش', basta: 'شـ', ortada: 'ـشـ', sonda: 'ـش', nonJoiner: false },\n            { letter: 'ص', basta: 'صـ', ortada: 'ـصـ', sonda: 'ـص', nonJoiner: false },\n            { letter: 'ض', basta: 'ضـ', ortada: 'ـضـ', sonda: 'ـض', nonJoiner: false },\n            { letter: 'ط', basta: 'طـ', ortada: 'ـطـ', sonda: 'ـط', nonJoiner: false },\n            { letter: 'ظ', basta: 'ظـ', ortada: 'ـظـ', sonda: 'ـظ', nonJoiner: false },\n            { letter: 'ع', basta: 'عـ', ortada: 'ـعـ', sonda: 'ـع', nonJoiner: false },\n            { letter: 'غ', basta: 'غـ', ortada: 'ـغـ', sonda: 'ـغ', nonJoiner: false },\n            { letter: 'ف', basta: 'فـ', ortada: 'ـفـ', sonda: 'ـف', nonJoiner: false },\n            { letter: 'ق', basta: 'قـ', ortada: 'ـقـ', sonda: 'ـق', nonJoiner: false },\n            { letter: 'ك', basta: 'كـ', ortada: 'ـكـ', sonda: 'ـك', nonJoiner: false },\n            { letter: 'ل', basta: 'لـ', ortada: 'ـلـ', sonda: 'ـل', nonJoiner: false },\n            { letter: 'م', basta: 'مـ', ortada: 'ـمـ', sonda: 'ـم', nonJoiner: false },\n            { letter: 'ن', basta: 'نـ', ortada: 'ـنـ', sonda: 'ـن', nonJoiner: false },\n            { letter: 'و', basta: 'و', ortada: 'ـو', sonda: 'ـو', nonJoiner: true },\n            { letter: 'هـ', basta: 'هـ', ortada: 'ـهـ', sonda: 'ـه', nonJoiner: false },\n            { letter: 'ي', basta: 'يـ', ortada: 'ـيـ', sonda: 'ـي', nonJoiner: false }\n        ];\n\n        function renderTable(data) {\n            const tbody = document.getElementById('letters-tbody');\n            tbody.innerHTML = '';\n\n            data.forEach((item, index) => {\n                const tr = document.createElement('tr');\n                tr.className = index % 2 === 0 ? 'bg-white hover:bg-slate-50 transition' : 'bg-slate-50/50 hover:bg-slate-50 transition';\n\n                if (item.nonJoiner) {\n                    tr.classList.add('bg-amber-50/40');\n                }\n\n                tr.innerHTML = `\n                    <td class=\"p-3 font-arabic text-3xl font-bold text-slate-800\">${item.letter}</td>\n                    <td class=\"p-3 font-arabic text-3xl text-teal-700\">${item.basta}</td>\n                    <td class=\"p-3 font-arabic text-3xl text-indigo-700\">${item.ortada}</td>\n                    <td class=\"p-3 font-arabic text-3xl text-purple-700\">${item.sonda}</td>\n                    <td class=\"p-3 text-xs\">\n                        ${item.nonJoiner \n                            ? '<span class=\"bg-amber-100 text-amber-800 font-bold px-2.5 py-1 rounded-full inline-block\">Sonrakiyle Birleşmez</span>' \n                            : '<span class=\"text-slate-400\">Çift Yönlü Birleşir</span>'}\n                    </td>\n                `;\n                tbody.appendChild(tr);\n            });\n        }\n\n        function filterLetters(type) {\n            const btnAll = document.getElementById('filter-all');\n            const btnNonjoin = document.getElementById('filter-nonjoin');\n\n            if (type === 'all') {\n                btnAll.className = \"px-3 py-1.5 rounded-xl bg-white shadow-sm text-slate-800 font-bold transition\";\n                btnNonjoin.className = \"px-3 py-1.5 rounded-xl text-slate-600 hover:text-slate-900 transition\";\n                renderTable(alphabetData);\n            } else if (type === 'nonjoin') {\n                btnNonjoin.className = \"px-3 py-1.5 rounded-xl bg-amber-500 text-white shadow-sm font-bold transition\";\n                btnAll.className = \"px-3 py-1.5 rounded-xl text-slate-600 hover:text-slate-900 transition\";\n                const filtered = alphabetData.filter(item => item.nonJoiner);\n                renderTable(filtered);\n            }\n        }\n\n        // Initialize table on load\n        document.addEventListener('DOMContentLoaded', () => {\n            renderTable(alphabetData);\n        });\n    </script>\n</body>\n</html>",
