{
  "htmlContent": "<!DOCTYPE html>\n<html lang=\"tr\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>6. Sınıf Kur'an-ı Kerim - Peltek Harfler İnteraktif Ders Özeti</title>\n    <!-- Tailwind CSS -->\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <!-- FontAwesome Icons -->\n    <link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css\" />\n    <!-- Google Fonts (Amiri for Arabic, Inter for Turkish) -->\n    <link href=\"https://fonts.googleapis.com/css2?family=Amiri:ital,wght@0,400;0,700;1,400;1,700&family=Inter:wght@300;400;500;600;700;800&display=swap\" rel=\"stylesheet\">\n    <script>\n        tailwind.config = {\n            theme: {\n                extend: {\n                    fontFamily: {\n                        sans: ['Inter', 'sans-serif'],\n                        arabic: ['Amiri', 'serif'],\n                    }\n                }\n            }\n        }\n    </script>\n    <style>\n        .custom-scrollbar::-webkit-scrollbar {\n            width: 6px;\n            height: 6px;\n        }\n        .custom-scrollbar::-webkit-scrollbar-track {\n            background: #f1f5f9;\n        }\n        .custom-scrollbar::-webkit-scrollbar-thumb {\n            background: #cbd5e1;\n            border-radius: 4px;\n        }\n        .custom-scrollbar::-webkit-scrollbar-thumb:hover {\n            background: #94a3b8;\n        }\n    </style>\n</head>\n<body class=\"bg-slate-50 font-sans antialiased text-slate-800 selection:bg-emerald-500 selection:text-white\">\n\n    <!-- ÜST BİLGİ VE AKILLI TAHTA BAŞLIĞI -->\n    <header class=\"bg-gradient-to-r from-emerald-800 to-teal-700 text-white shadow-xl\">\n        <div class=\"max-w-7xl mx-auto px-4 py-6 md:py-8 flex flex-col md:flex-row justify-between items-center gap-4\">\n            <div class=\"flex items-center gap-4\">\n                <div class=\"bg-white/10 p-3 rounded-2xl backdrop-blur-sm border border-white/20\">\n                    <i class=\"fa-solid fa-book-quran text-3xl text-emerald-300\"></i>\n                </div>\n                <div>\n                    <span class=\"text-xs font-semibold tracking-wider uppercase text-emerald-200 bg-emerald-900/50 px-2.5 py-1 rounded-full border border-emerald-500/30\">\n                        MEB 6. SINIF | KUR'AN-I KERİM\n                    </span>\n                    <h1 class=\"text-2xl md:text-3xl font-extrabold tracking-tight mt-1\">\n                        1. Ünite: Peltek Harfler (Konu Özeti)\n                    </h1>\n                </div>\n            </div>\n            <div class=\"flex items-center gap-3 bg-white/10 px-4 py-2 rounded-xl backdrop-blur-sm text-sm\">\n                <span class=\"flex h-3 w-3 relative\">\n                    <span class=\"animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75\"></span>\n                    <span class=\"relative inline-flex rounded-full h-3 w-3 bg-emerald-500\"></span>\n                </span>\n                <span>Akıllı Tahta Etkin Modu</span>\n            </div>\n        </div>\n    </header>\n\n    <main class=\"max-w-7xl mx-auto px-4 py-8 space-y-8\">\n\n        <!-- 1. BÖLÜM: TEMEL KAVRAMLAR VE GİRİŞ -->\n        <section class=\"grid grid-cols-1 lg:grid-cols-3 gap-6\">\n            <!-- Önem Kutus -->\n            <div class=\"lg:col-span-2 bg-white rounded-3xl p-6 shadow-sm border border-slate-100 flex flex-col justify-between\">\n                <div>\n                    <div class=\"flex items-center gap-3 mb-4\">\n                        <span class=\"p-2.5 bg-emerald-50 text-emerald-600 rounded-xl\">\n                            <i class=\"fa-solid fa-circle-exclamation text-xl\"></i>\n                        </span>\n                        <h2 class=\"text-xl font-bold text-slate-900\">Doğru Telaffuz Neden Önemlidir?</h2>\n                    </div>\n                    <p class=\"text-slate-600 leading-relaxed text-base\">\n                        Kur'an-ı Kerim'i okurken harflerin çıkış yerlerine (mahreçlerine), üstünde veya altında bulunan hareke ve işaretlere dikkat etmek gerekir. Çünkü <span class=\"font-semibold text-emerald-600 underline decoration-2 decoration-emerald-300\">harfin hatalı seslendirilmesi, kelimenin anlamını değiştirir ve cümlenin anlamını bozar</span>. Bu sebeple peltek harflerin mahrecine son derece dikkat edilmeli ve doğru seslendirilmelidir.\n                    </p>\n                </div>\n                \n                <!-- Anlam Değişimi Örnekleri (İnteraktif Görsel Kartlar) -->\n                <div class=\"grid grid-cols-1 md:grid-cols-2 gap-4 mt-6\">\n                    <div class=\"bg-amber-50/50 border border-amber-100 rounded-2xl p-4 transition-all hover:shadow-md\">\n                        <div class=\"flex justify-between items-center mb-2\">\n                            <span class=\"text-xs font-bold text-amber-800 uppercase tracking-wider\">Örnek 1</span>\n                            <span class=\"text-xs bg-amber-100 text-amber-800 px-2 py-0.5 rounded-full font-medium\">Anlam Değişimi</span>\n                        </div>\n                        <div class=\"flex justify-around items-center py-2\">\n                            <div class=\"text-center\">\n                                <span class=\"font-arabic text-3xl text-slate-800 block\">نَذَرَ</span>\n                                <span class=\"text-xs text-slate-500 mt-1 block\">\"adadı\"</span>\n                            </div>\n                            <div class=\"text-slate-400 font-bold\">⇄</div>\n                            <div class=\"text-center\">\n                                <span class=\"font-arabic text-3xl text-red-600 block\">نَظَرَ</span>\n                                <span class=\"text-xs text-red-500 mt-1 block\">\"baktı\"</span>\n                            </div>\n                        </div>\n                        <p class=\"text-xs text-slate-500 mt-2 border-t border-amber-100/50 pt-2\">\n                            Peltek <span class=\"font-bold\">ذ</span> harfi yerine kalın <span class=\"font-bold\">ظ</span> okunursa anlam tamamen değişir.\n                        </p>\n                    </div>\n\n                    <div class=\"bg-teal-50/50 border border-teal-100 rounded-2xl p-4 transition-all hover:shadow-md\">\n                        <div class=\"flex justify-between items-center mb-2\">\n                            <span class=\"text-xs font-bold text-teal-800 uppercase tracking-wider\">Örnek 2</span>\n                            <span class=\"text-xs bg-teal-100 text-teal-800 px-2 py-0.5 rounded-full font-medium\">Anlam Değişimi</span>\n                        </div>\n                        <div class=\"flex justify-around items-center py-2\">\n                            <div class=\"text-center\">\n                                <span class=\"font-arabic text-3xl text-slate-800 block\">ثَبَتَ</span>\n                                <span class=\"text-xs text-slate-500 mt-1 block\">\"saçmak\"</span>\n                            </div>\n                            <div class=\"text-slate-400 font-bold\">⇄</div>\n                            <div class=\"text-center\">\n                                <span class=\"font-arabic text-3xl text-red-600 block\">سَبَتَ</span>\n                                <span class=\"text-xs text-red-500 mt-1 block\">\"kazanmak\"</span>\n                            </div>\n                        </div>\n                        <p class=\"text-xs text-slate-500 mt-2 border-t border-teal-100/50 pt-2\">\n                            Peltek <span class=\"font-bold\">ث</span> harfi yerine keskin <span class=\"font-bold\">س</span> okunursa kelime bambaşka bir anlama bürünür.\n                        </p>\n                    </div>\n                </div>\n            </div>\n\n            <!-- Mahreç Bölgeleri Kartı -->\n            <div class=\"bg-white rounded-3xl p-6 shadow-sm border border-slate-100 flex flex-col justify-between\">\n                <div>\n                    <div class=\"flex items-center gap-3 mb-4\">\n                        <span class=\"p-2.5 bg-blue-50 text-blue-600 rounded-xl\">\n                            <i class=\"fa-solid fa-bullseye text-xl\"></i>\n                        </span>\n                        <h2 class=\"text-xl font-bold text-slate-900\">Mahreç Bölgeleri</h2>\n                    </div>\n                    <p class=\"text-slate-600 text-sm leading-relaxed mb-4\">\n                        Kur'an alfabesindeki harfler çıkış yerlerine (mahreçlerine) göre temel olarak <span class=\"font-semibold text-slate-800\">üçe ayrılır</span>:\n                    </p>\n                    <div class=\"space-y-3\">\n                        <div class=\"flex items-center gap-3 p-3 bg-slate-50 rounded-xl border border-slate-100\">\n                            <span class=\"w-8 h-8 rounded-lg bg-emerald-100 text-emerald-700 flex items-center justify-center font-bold text-sm\">1</span>\n                            <span class=\"font-semibold text-slate-700 text-sm\">Dudak Harfleri</span>\n                        </div>\n                        <div class=\"flex items-center gap-3 p-3 bg-emerald-50 rounded-xl border border-emerald-100\">\n                            <span class=\"w-8 h-8 rounded-lg bg-emerald-500 text-white flex items-center justify-center font-bold text-sm\">2</span>\n                            <div>\n                                <span class=\"font-bold text-emerald-800 text-sm block\">Dil (Diş-Damak) Harfleri</span>\n                                <span class=\"text-xs text-emerald-600\">Peltek harfler bu gruba girer.</span>\n                            </div>\n                        </div>\n                        <div class=\"flex items-center gap-3 p-3 bg-slate-50 rounded-xl border border-slate-100\">\n                            <span class=\"w-8 h-8 rounded-lg bg-emerald-100 text-emerald-700 flex items-center justify-center font-bold text-sm\">3</span>\n                            <span class=\"font-semibold text-slate-700 text-sm\">Boğaz Harfleri</span>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"mt-4 pt-3 border-t border-slate-100 text-xs text-slate-500 text-center\">\n                    <span class=\"font-semibold text-emerald-600\">Peltek harflerin mahreci:</span> Dil ucunun üst yüzeyi ile üst ön dişlerin uçlarıdır.\n                </div>\n            </div>\n        </section>\n\n        <!-- 2. BÖLÜM: İNTERAKTİF PELTEK HARF AKORDİYONU VE AYRINTILARI -->\n        <section class=\"bg-white rounded-3xl p-6 md:p-8 shadow-sm border border-slate-100\">\n            <div class=\"flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-8\">\n                <div>\n                    <h2 class=\"text-2xl font-bold text-slate-900 flex items-center gap-3\">\n                        <span class=\"w-2.5 h-7 bg-emerald-600 rounded-full inline-block\"></span>\n                        Peltek Harfleri Tanıyalım (ث , ذ , ظ)\n                    </h2>\n                    <p class=\"text-slate-500 text-sm mt-1\">Özelliklerini, mahreçlerini ve ses tonlarını incelemek için harflere tıklayınız.</p>\n                </div>\n                <div class=\"flex gap-2 bg-slate-100 p-1.5 rounded-2xl w-full md:w-auto\">\n                    <button onclick=\"switchLetterTab('se')\" id=\"tab-se\" class=\"flex-1 md:flex-initial px-6 py-2.5 rounded-xl font-bold transition-all text-sm bg-emerald-600 text-white shadow-sm\">ث (Se)</button>\n                    <button onclick=\"switchLetterTab('zel')\" id=\"tab-zel\" class=\"flex-1 md:flex-initial px-6 py-2.5 rounded-xl font-bold transition-all text-sm text-slate-600 hover:bg-slate-50\">ذ (Zel)</button>\n                    <button onclick=\"switchLetterTab('zi')\" id=\"tab-zi\" class=\"flex-1 md:flex-initial px-6 py-2.5 rounded-xl font-bold transition-all text-sm text-slate-600 hover:bg-slate-50\">ظ (Zı)</button>\n                </div>\n            </div>\n\n            <!-- HARF DETAY PANELLERİ -->\n            <div id=\"panel-se\" class=\"space-y-6\">\n                <div class=\"grid grid-cols-1 lg:grid-cols-12 gap-6 items-center\">\n                    <div class=\"lg:col-span-4 bg-gradient-to-tr from-emerald-50 to-teal-50 rounded-3xl p-8 border border-emerald-100/50 text-center relative overflow-hidden\">\n                        <div class=\"absolute -right-8 -bottom-8 opacity-5 font-arabic text-9xl\">ث</div>\n                        <span class=\"text-7xl font-arabic font-extrabold text-emerald-800 drop-shadow-sm\">ث</span>\n                        <h3 class=\"text-xl font-bold text-slate-900 mt-4\">ث Harfi (Se)</h3>\n                        <div class=\"flex justify-center gap-2 mt-3\">\n                            <span class=\"bg-emerald-100 text-emerald-800 px-3 py-1 rounded-full text-xs font-semibold\">İnce</span>\n                            <span class=\"bg-emerald-100 text-emerald-800 px-3 py-1 rounded-full text-xs font-semibold\">Yumuşak</span>\n                        </div>\n                    </div>\n                    <div class=\"lg:col-span-8 space-y-4\">\n                        <div class=\"bg-slate-50 rounded-2xl p-5 border border-slate-100\">\n                            <h4 class=\"font-bold text-slate-900 mb-2 flex items-center gap-2\">\n                                <i class=\"fa-solid fa-microphone-lines text-emerald-600\"></i> Mahreç ve Telaffuz Tanımı\n                            </h4>\n                            <p class=\"text-slate-600 text-sm leading-relaxed\">\n                                Dil ucunun üst kısmı üst ön dişlerin başlarına değdirilerek söylenir. <span class=\"font-semibold text-emerald-700\">Bu esnada dil ucu biraz dışarı çıkarılır.</span> İnce ve yumuşak bir sestir.\n                            </p>\n                        </div>\n                        <div class=\"grid grid-cols-1 md:grid-cols-3 gap-4\">\n                            <div class=\"bg-slate-50 rounded-xl p-4 border border-slate-100 text-center\">\n                                <span class=\"text-xs text-slate-500 block\">Üstünlü Okunuşu</span>\n                                <span class=\"font-arabic text-2xl text-slate-800 font-bold block mt-1\">ثَ</span>\n                                <span class=\"text-xs text-emerald-700 font-semibold mt-1 block\">S̱e</span>\n                            </div>\n                            <div class=\"bg-slate-50 rounded-xl p-4 border border-slate-100 text-center\">\n                                <span class=\"text-xs text-slate-500 block\">Esreli Okunuşu</span>\n                                <span class=\"font-arabic text-2xl text-slate-800 font-bold block mt-1\">ثِ</span>\n                                <span class=\"text-xs text-emerald-700 font-semibold mt-1 block\">S̱i</span>\n                            </div>\n                            <div class=\"bg-slate-50 rounded-xl p-4 border border-slate-100 text-center\">\n                                <span class=\"text-xs text-slate-500 block\">Ötreli Okunuşu</span>\n                                <span class=\"font-arabic text-2xl text-slate-800 font-bold block mt-1\">ثُ</span>\n                                <span class=\"text-xs text-emerald-700 font-semibold mt-1 block\">S̱u</span>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n\n            <div id=\"panel-zel\" class=\"space-y-6 hidden\">\n                <div class=\"grid grid-cols-1 lg:grid-cols-12 gap-6 items-center\">\n                    <div class=\"lg:col-span-4 bg-gradient-to-tr from-emerald-50 to-teal-50 rounded-3xl p-8 border border-emerald-100/50 text-center relative overflow-hidden\">\n                        <div class=\"absolute -right-8 -bottom-8 opacity-5 font-arabic text-9xl\">ذ</div>\n                        <span class=\"text-7xl font-arabic font-extrabold text-emerald-800 drop-shadow-sm\">ذ</span>\n                        <h3 class=\"text-xl font-bold text-slate-900 mt-4\">ذ Harfi (Zel)</h3>\n                        <div class=\"flex justify-center gap-2 mt-3\">\n                            <span class=\"bg-emerald-100 text-emerald-800 px-3 py-1 rounded-full text-xs font-semibold\">İnce</span>\n                            <span class=\"bg-emerald-100 text-emerald-800 px-3 py-1 rounded-full text-xs font-semibold\">Yumuşak</span>\n                        </div>\n                    </div>\n                    <div class=\"lg:col-span-8 space-y-4\">\n                        <div class=\"bg-slate-50 rounded-2xl p-5 border border-slate-100\">\n                            <h4 class=\"font-bold text-slate-900 mb-2 flex items-center gap-2\">\n                                <i class=\"fa-solid fa-microphone-lines text-emerald-600\"></i> Mahreç ve Telaffuz Tanımı\n                            </h4>\n                            <p class=\"text-slate-600 text-sm leading-relaxed\">\n                                Dil ucunun üst kısmı üst ön dişlerin başlarına değdirilerek seslendirilir. <span class=\"font-semibold text-emerald-700\">Bu esnada dil ucu, ث harfine göre daha az dışarı çıkarılır.</span> İnce ve yumuşak bir sestir.\n                            </p>\n                        </div>\n                        <div class=\"grid grid-cols-1 md:grid-cols-3 gap-4\">\n                            <div class=\"bg-slate-50 rounded-xl p-4 border border-slate-100 text-center\">\n                                <span class=\"text-xs text-slate-500 block\">Üstünlü Okunuşu</span>\n                                <span class=\"font-arabic text-2xl text-slate-800 font-bold block mt-1\">ذَ</span>\n                                <span class=\"text-xs text-emerald-700 font-semibold mt-1 block\">Ẕe</span>\n                            </div>\n                            <div class=\"bg-slate-50 rounded-xl p-4 border border-slate-100 text-center\">\n                                <span class=\"text-xs text-slate-500 block\">Esreli Okunuşu</span>\n                                <span class=\"font-arabic text-2xl text-slate-800 font-bold block mt-1\">ذِ</span>\n                                <span class=\"text-xs text-emerald-700 font-semibold mt-1 block\">Ẕi</span>\n                            </div>\n                            <div class=\"bg-slate-50 rounded-xl p-4 border border-slate-100 text-center\">\n                                <span class=\"text-xs text-slate-500 block\">Ötreli Okunuşu</span>\n                                <span class=\"font-arabic text-2xl text-slate-800 font-bold block mt-1\">ذُ</span>\n                                <span class=\"text-xs text-emerald-700 font-semibold mt-1 block\">Ẕu</span>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n\n            <div id=\"panel-zi\" class=\"space-y-6 hidden\">\n                <div class=\"grid grid-cols-1 lg:grid-cols-12 gap-6 items-center\">\n                    <div class=\"lg:col-span-4 bg-gradient-to-tr from-emerald-50 to-teal-50 rounded-3xl p-8 border border-emerald-100/50 text-center relative overflow-hidden\">\n                        <div class=\"absolute -right-8 -bottom-8 opacity-5 font-arabic text-9xl\">ظ</div>\n                        <span class=\"text-7xl font-arabic font-extrabold text-emerald-800 drop-shadow-sm\">ظ</span>\n                        <h3 class=\"text-xl font-bold text-slate-900 mt-4\">ظ Harfi (Zı)</h3>\n                        <div class=\"flex justify-center gap-2 mt-3\">\n                            <span class=\"bg-amber-100 text-amber-800 px-3 py-1 rounded-full text-xs font-semibold\">Kalın</span>\n                            <span class=\"bg-amber-100 text-amber-800 px-3 py-1 rounded-full text-xs font-semibold\">Kuvvetli</span>\n                        </div>\n                    </div>\n                    <div class=\"lg:col-span-8 space-y-4\">\n                        <div class=\"bg-slate-50 rounded-2xl p-5 border border-slate-100\">\n                            <h4 class=\"font-bold text-slate-900 mb-2 flex items-center gap-2\">\n                                <i class=\"fa-solid fa-microphone-lines text-emerald-600\"></i> Mahreç ve Telaffuz Tanımı\n                            </h4>\n                            <p class=\"text-slate-600 text-sm leading-relaxed\">\n                                Dil ucunun üst kısmı üst ön dişlerin başlarına değdirilerek söylenir. <span class=\"font-semibold text-amber-700\">ظ harfinde dil, ث ve ذ harflerine göre daha az dışarı çıkarılır.</span> Kalın ve kuvvetli bir sestir.\n                            </p>\n                        </div>\n                        <div class=\"grid grid-cols-1 md:grid-cols-3 gap-4\">\n                            <div class=\"bg-slate-50 rounded-xl p-4 border border-slate-100 text-center\">\n                                <span class=\"text-xs text-slate-500 block\">Üstünlü Okunuşu</span>\n                                <span class=\"font-arabic text-2xl text-slate-800 font-bold block mt-1\">ظَ</span>\n                                <span class=\"text-xs text-amber-700 font-semibold mt-1 block\">Ẓa</span>\n                            </div>\n                            <div class=\"bg-slate-50 rounded-xl p-4 border border-slate-100 text-center\">\n                                <span class=\"text-xs text-slate-500 block\">Esreli Okunuşu</span>\n                                <span class=\"font-arabic text-2xl text-slate-800 font-bold block mt-1\">ظِ</span>\n                                <span class=\"text-xs text-amber-700 font-semibold mt-1 block\">Ẓı</span>\n                            </div>\n                            <div class=\"bg-slate-50 rounded-xl p-4 border border-slate-100 text-center\">\n                                <span class=\"text-xs text-slate-500 block\">Ötreli Okunuşu</span>\n                                <span class=\"font-arabic text-2xl text-slate-800 font-bold block mt-1\">ظُ</span>\n                                <span class=\"text-xs text-amber-700 font-semibold mt-1 block\">Ẓu</span>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n\n        <!-- 3. BÖLÜM: DERS KİTABINDAN ÖRNEK KELİMELER SESLENDİRME PANELİ -->\n        <section class=\"bg-white rounded-3xl p-6 md:p-8 shadow-sm border border-slate-100\">\n            <div class=\"flex items-center justify-between mb-6 border-b border-slate-100 pb-4\">\n                <div>\n                    <h2 class=\"text-xl font-bold text-slate-900 flex items-center gap-2\">\n                        <i class=\"fa-solid fa-volume-high text-emerald-600\"></i> Kelime Okuma Pratiği\n                    </h2>\n                    <p class=\"text-slate-500 text-xs mt-0.5\">Müfredat kitabında yer alan peltek harfli kelimeler ve okunuş egzersizleri.</p>\n                </div>\n                <span class=\"text-xs bg-emerald-50 text-emerald-700 px-3 py-1.5 rounded-xl font-medium\">Kitap Etkinlik 2-3-4</span>\n            </div>\n\n            <div class=\"grid grid-cols-1 md:grid-cols-3 gap-6\">\n                <!-- THA (ث) Sütunu -->\n                <div class=\"bg-slate-50/50 rounded-2xl p-4 border border-slate-100\">\n                    <div class=\"flex items-center justify-between mb-3 border-b border-slate-200/60 pb-2\">\n                        <span class=\"font-bold text-emerald-800 text-sm\">ث Örnekleri</span>\n                        <span class=\"text-xs bg-emerald-100 text-emerald-800 px-2 py-0.5 rounded-md font-semibold\">İnce</span>\n                    </div>\n                    <div class=\"space-y-2\">\n                        <div class=\"flex items-center justify-between p-3 bg-white rounded-xl shadow-xs border border-slate-100 hover:border-emerald-200 transition-all\">\n                            <span class=\"text-xs text-slate-500 font-medium\">mabthūthah</span>\n                            <span class=\"font-arabic text-2xl text-slate-850 font-bold\">مَبْثُوثَة</span>\n                        </div>\n                        <div class=\"flex items-center justify-between p-3 bg-white rounded-xl shadow-xs border border-slate-100 hover:border-emerald-200 transition-all\">\n                            <span class=\"text-xs text-slate-500 font-medium\">haythu</span>\n                            <span class=\"font-arabic text-2xl text-slate-850 font-bold\">حَيْثُ</span>\n                        </div>\n                        <div class=\"flex items-center justify-between p-3 bg-white rounded-xl shadow-xs border border-slate-100 hover:border-emerald-200 transition-all\">\n                            <span class=\"text-xs text-slate-500 font-medium\">thulātha</span>\n                            <span class=\"font-arabic text-2xl text-slate-850 font-bold\">ثُلَاثَ</span>\n                        </div>\n                    </div>\n                </div>\n\n                <!-- ZAL (ذ) Sütunu -->\n                <div class=\"bg-slate-50/50 rounded-2xl p-4 border border-slate-100\">\n                    <div class=\"flex items-center justify-between mb-3 border-b border-slate-200/60 pb-2\">\n                        <span class=\"font-bold text-emerald-800 text-sm\">ذ Örnekleri</span>\n                        <span class=\"text-xs bg-emerald-100 text-emerald-800 px-2 py-0.5 rounded-md font-semibold\">İnce</span>\n                    </div>\n                    <div class=\"space-y-2\">\n                        <div class=\"flex items-center justify-between p-3 bg-white rounded-xl shadow-xs border border-slate-100 hover:border-emerald-200 transition-all\">\n                            <span class=\"text-xs text-slate-500 font-medium\">hādhā</span>\n                            <span class=\"font-arabic text-2xl text-slate-850 font-bold\">هٰذَا</span>\n                        </div>\n                        <div class=\"flex items-center justify-between p-3 bg-white rounded-xl shadow-xs border border-slate-100 hover:border-emerald-200 transition-all\">\n                            <span class=\"text-xs text-slate-500 font-medium\">dhürriyyetün</span>\n                            <span class=\"font-arabic text-2xl text-slate-850 font-bold\">ذُرِّيَّةٌ</span>\n                        </div>\n                        <div class=\"flex items-center justify-between p-3 bg-white rounded-xl shadow-xs border border-slate-100 hover:border-emerald-200 transition-all\">\n                            <span class=\"text-xs text-slate-500 font-medium\">yükezzibü</span>\n                            <span class=\"font-arabic text-2xl text-slate-850 font-bold\">يُكَذِّبُ</span>\n                        </div>\n                    </div>\n                </div>\n\n                <!-- ZI (ظ) Sütunu -->\n                <div class=\"bg-slate-50/50 rounded-2xl p-4 border border-slate-100\">\n                    <div class=\"flex items-center justify-between mb-3 border-b border-slate-200/60 pb-2\">\n                        <span class=\"font-bold text-emerald-800 text-sm\">ظ Örnekleri</span>\n                        <span class=\"text-xs bg-amber-100 text-amber-800 px-2 py-0.5 rounded-md font-semibold\">Kalın</span>\n                    </div>\n                    <div class=\"space-y-2\">\n                        <div class=\"flex items-center justify-between p-3 bg-white rounded-xl shadow-xs border border-slate-100 hover:border-emerald-200 transition-all\">\n                            <span class=\"text-xs text-slate-500 font-medium\">'aẓīm</span>\n                            <span class=\"font-arabic text-2xl text-slate-850 font-bold\">عَظِيمٌ</span>\n                        </div>\n                        <div class=\"flex items-center justify-between p-3 bg-white rounded-xl shadow-xs border border-slate-100 hover:border-emerald-200 transition-all\">\n                            <span class=\"text-xs text-slate-500 font-medium\">tanẓuru</span>\n                            <span class=\"font-arabic text-2xl text-slate-850 font-bold\">تَنْظُرُ</span>\n                        </div>\n                        <div class=\"flex items-center justify-between p-3 bg-white rounded-xl shadow-xs border border-slate-100 hover:border-emerald-200 transition-all\">\n                            <span class=\"text-xs text-slate-500 font-medium\">ẓale-mū</span>\n                            <span class=\"font-arabic text-2xl text-slate-850 font-bold\">ظَلَمُوا</span>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n\n        <!-- 4. BÖLÜM: AYET SÜZGECİ (AYETLERDEKİ HARFLERİ BULMA) -->\n        <section class=\"bg-white rounded-3xl p-6 md:p-8 shadow-sm border border-slate-100\">\n            <div class=\"flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-6 border-b border-slate-100 pb-4\">\n                <div>\n                    <h2 class=\"text-xl font-bold text-slate-900 flex items-center gap-2\">\n                        <i class=\"fa-solid fa-wand-magic-sparkles text-emerald-600\"></i> Ayet Süzgeci ve Keşif Alanı\n                    </h2>\n                    <p class=\"text-slate-500 text-xs mt-0.5\">Ayetlerde geçen peltek harfleri inceleyin. Renklendirilmiş harflerin mahrecine dikkat edin.</p>\n                </div>\n                <div class=\"flex gap-2\">\n                    <span class=\"inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-bold bg-amber-50 text-amber-700 border border-amber-200\">\n                        <span class=\"w-2 h-2 rounded-full bg-amber-500\"></span> ث (Se)\n                    </span>\n                    <span class=\"inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-bold bg-blue-50 text-blue-750 border border-blue-200\">\n                        <span class=\"w-2 h-2 rounded-full bg-blue-500\"></span> ذ (Zel)\n                    </span>\n                    <span class=\"inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-bold bg-red-50 text-red-700 border border-red-200\">\n                        <span class=\"w-2 h-2 rounded-full bg-red-500\"></span> ظ (Zı)\n                    </span>\n                </div>\n            </div>\n\n            <!-- Ayet Listesi -->\n            <div class=\"space-y-4\">\n                <!-- Ayet 1 -->\n                <div class=\"p-5 bg-slate-50 rounded-2xl border border-slate-100/80 flex flex-col md:flex-row justify-between items-center gap-4\">\n                    <div class=\"text-left w-full md:w-1/2\">\n                        <span class=\"text-xs font-bold text-emerald-700 block mb-1\">Müddessir Suresi, 21. Ayet</span>\n                        <p class=\"text-slate-650 text-sm italic\">\"Sonra baktı.\"</p>\n                    </div>\n                    <div class=\"text-right w-full md:w-1/2\">\n                        <span class=\"font-arabic text-3xl leading-loose text-slate-900 block tracking-wide\">\n                            ثُ<span class=\"text-amber-500 font-bold\">مَّ</span> نَ<span class=\"text-red-500 font-bold\">ظَ</span>رَ\n                        </span>\n                    </div>\n                </div>\n\n                <!-- Ayet 2 -->\n                <div class=\"p-5 bg-slate-50 rounded-2xl border border-slate-100/80 flex flex-col md:flex-row justify-between items-center gap-4\">\n                    <div class=\"text-left w-full md:w-1/2\">\n                        <span class=\"text-xs font-bold text-emerald-700 block mb-1\">Leyl Suresi, 14. Ayet</span>\n                        <p class=\"text-slate-650 text-sm italic\">\"Ben de sizi alev alev yanan bir ateşe karşı uyardım.\"</p>\n                    </div>\n                    <div class=\"text-right w-full md:w-1/2\">\n                        <span class=\"font-arabic text-3xl leading-loose text-slate-900 block tracking-wide\">\n                            فَأَ<span class=\"text-blue-500 font-bold\">نْذَ</span>رْتُكُمْ نَارًا تَلَ<span class=\"text-amber-500 font-bold\">ظَّ</span>ى\n                        </span>\n                    </div>\n                </div>\n\n                <!-- Ayet 3 -->\n                <div class=\"p-5 bg-slate-50 rounded-2xl border border-slate-100/80 flex flex-col md:flex-row justify-between items-center gap-4\">\n                    <div class=\"text-left w-full md:w-1/2\">\n                        <span class=\"text-xs font-bold text-emerald-700 block mb-1\">Zilzal Suresi, 7-8. Ayet Meali</span>\n                        <p class=\"text-slate-650 text-sm italic\">\"Kim zerre miktarı hayır yapmışsa onu görür. Kim de zerre miktarı şer yapmışsa onu görür.\"</p>\n                    </div>\n                    <div class=\"text-right w-full md:w-1/2\">\n                        <span class=\"font-arabic text-3xl leading-loose text-slate-900 block tracking-wide\">\n                            مِ<span class=\"text-amber-500 font-bold\">ثْ</span>قَالَ <span class=\"text-blue-500 font-bold\">ذَ</span>رَّةٍ شَرًّا يَرَهُ\n                        </span>\n                    </div>\n                </div>\n            </div>\n        </section>\n\n        <!-- 5. BÖLÜM: KONTROL NOKTASI (İNTERAKTİF SORULAR) -->\n        <section class=\"bg-white rounded-3xl p-6 md:p-8 shadow-sm border border-slate-100\">\n            <div class=\"flex items-center gap-3 mb-6\">\n                <span class=\"p-2.5 bg-rose-50 text-rose-600 rounded-xl\">\n                    <i class=\"fa-solid fa-clipboard-question text-xl\"></i>\n                </span>\n                <div>\n                    <h2 class=\"text-xl font-bold text-slate-900\">Kontrol Noktası</h2>\n                    <p class=\"text-slate-500 text-xs\">Cevapları görmek için kartların üzerine tıklayınız.</p>\n                </div>\n            </div>\n\n            <div class=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n                <!-- Soru 1 -->\n                <div onclick=\"toggleAnswer(1)\" class=\"cursor-pointer p-5 bg-slate-50 hover:bg-slate-100/70 rounded-2xl border border-slate-100 transition-all flex flex-col justify-between\">\n                    <div>\n                        <span class=\"text-xs font-bold text-slate-400 uppercase\">Soru 1</span>\n                        <h3 class=\"font-bold text-slate-800 text-sm mt-1\">Peltek harfler hangileridir?</h3>\n                    </div>\n                    <div id=\"answer-1\" class=\"hidden mt-4 pt-3 border-t border-slate-200 text-sm text-emerald-700 font-medium\">\n                        Peltek harfler üç tanedir: <span class=\"font-bold\">ث (Se)</span>, <span class=\"font-bold\">ذ (Zel)</span> ve <span class=\"font-bold\">ظ (Zı)</span>.\n                    </div>\n                </div>\n\n                <!-- Soru 2 -->\n                <div onclick=\"toggleAnswer(2)\" class=\"cursor-pointer p-5 bg-slate-50 hover:bg-slate-100/70 rounded-2xl border border-slate-100 transition-all flex flex-col justify-between\">\n                    <div>\n                        <span class=\"text-xs font-bold text-slate-400 uppercase\">Soru 2</span>\n                        <h3 class=\"font-bold text-slate-800 text-sm mt-1\">Peltek harflerin çıkış bölgesi (mahreci) neresidir?</h3>\n                    </div>\n                    <div id=\"answer-2\" class=\"hidden mt-4 pt-3 border-t border-slate-200 text-sm text-emerald-700 font-medium\">\n                        Dil ucu ve ön dişlerin uçlarıdır. Dil ucunun üst yüzeyi üst ön dişlerin ucuna değdirilerek seslendirilir.\n                    </div>\n                </div>\n\n                <!-- Soru 3 -->\n                <div onclick=\"toggleAnswer(3)\" class=\"cursor-pointer p-5 bg-slate-50 hover:bg-slate-100/70 rounded-2xl border border-slate-100 transition-all flex flex-col justify-between\">\n                    <div>\n                        <span class=\"text-xs font-bold text-slate-400 uppercase\">Soru 3</span>\n                        <h3 class=\"font-bold text-slate-800 text-sm mt-1\">Peltek harflerden hangileri ince seslidir?</h3>\n                    </div>\n                    <div id=\"answer-3\" class=\"hidden mt-4 pt-3 border-t border-slate-200 text-sm text-emerald-700 font-medium\">\n                        <span class=\"font-bold\">ث (Se)</span> ve <span class=\"font-bold\">ذ (Zel)</span> harfleri ince ve yumuşak seslidir.\n                    </div>\n                </div>\n\n                <!-- Soru 4 -->\n                <div onclick=\"toggleAnswer(4)\" class=\"cursor-pointer p-5 bg-slate-50 hover:bg-slate-100/70 rounded-2xl border border-slate-100 transition-all flex flex-col justify-between\">\n                    <div>\n                        <span class=\"text-xs font-bold text-slate-400 uppercase\">Soru 4</span>\n                        <h3 class=\"font-bold text-slate-800 text-sm mt-1\">Hangi peltek harf kalın seslidir?</h3>\n                    </div>\n                    <div id=\"answer-4\" class=\"hidden mt-4 pt-3 border-t border-slate-200 text-sm text-emerald-700 font-medium\">\n                        <span class=\"font-bold\">ظ (Zı)</span> harfi kalın ve kuvvetli seslidir.\n                    </div>\n                </div>\n            </div>\n        </section>\n\n        <!-- 6. BÖLÜM: BİLGİ KUTUSU VE PÜF NOKTA -->\n        <section class=\"grid grid-cols-1 lg:grid-cols-12 gap-6\">\n            <!-- 💡 Unutmayalım! -->\n            <div class=\"lg:col-span-8 bg-amber-50 rounded-3xl p-6 border border-amber-200/60 shadow-sm flex items-start gap-4\">\n                <div class=\"p-3 bg-amber-500 text-white rounded-2xl\">\n                    <i class=\"fa-solid fa-lightbulb text-2xl\"></i>\n                </div>\n                <div>\n                    <h3 class=\"text-lg font-bold text-amber-900\">💡 Unutmayalım!</h3>\n                    <p class=\"text-sm text-amber-800 leading-relaxed mt-1\">\n                        Türkçede peltek seslendirilen harf bulunmamaktadır. Bu nedenle bizim konuşma alışkanlığımıza yabancı olan bu harflerin (ث, ذ, ظ) doğru seslendirilmesine ve telaffuzlarına ekstra özen gösterilmelidir.\n                    </p>\n                </div>\n            </div>\n\n            <!-- Sınav İpucu -->\n            <div class=\"lg:col-span-4 bg-teal-50 rounded-3xl p-6 border border-teal-200/60 shadow-sm flex items-start gap-4\">\n                <div class=\"p-3 bg-teal-500 text-white rounded-2xl\">\n                    <i class=\"fa-solid fa-graduation-cap text-2xl\"></i>\n                </div>\n                <div>\n                    <h3 class=\"text-lg font-bold text-teal-900\">🎯 Sınav İpucu</h3>\n                    <p class=\"text-sm text-teal-800 leading-relaxed mt-1\">\n                        Harfin seslendirilme derecelerini unutma! Dil dışarıya en çok <span class=\"font-bold\">ث</span> harfinde, biraz daha az <span class=\"font-bold\">ذ</span> harfinde, en az ise <span class=\"font-bold\">ظ</span> harfinde çıkarılır.\n                    </p>\n                </div>\n            </div>\n        </section>\n\n    </main>\n\n    <footer class=\"bg-slate-900 text-slate-400 py-8 border-t border-slate-800 text-center mt-12\">\n        <p class=\"text-sm\">Milli Eğitim Bakanlığı Din Kültürü ve Ahlak Bilgisi Öğretim Programı Müfredatına %100 Uyumludur.</p>\n        <p class=\"text-xs text-slate-500 mt-2\">© Tasarım: Kıdemli Eğitim Teknolojileri Birimi</p>\n    </footer>\n\n    <!-- INTERACTIVITY JAVASCRIPT -->\n    <script>\n        function switchLetterTab(letter) {\n            // Hide all panels\n            document.getElementById('panel-se').classList.add('hidden');\n            document.getElementById('panel-zel').classList.add('hidden');\n            document.getElementById('panel-zi').classList.add('hidden');\n\n            // Reset tab styles\n            const tabs = ['tab-se', 'tab-zel', 'tab-zi'];\n            tabs.forEach(tabId => {\n                const el = document.getElementById(tabId);\n                el.className = \"flex-1 md:flex-initial px-6 py-2.5 rounded-xl font-bold transition-all text-sm text-slate-600 hover:bg-slate-50\";\n            });\n\n            // Activate chosen panel & style active tab\n            if (letter === 'se') {\n                document.getElementById('panel-se').classList.remove('hidden');\n                document.getElementById('tab-se').className = \"flex-1 md:flex-initial px-6 py-2.5 rounded-xl font-bold transition-all text-sm bg-emerald-600 text-white shadow-sm\";\n            } else if (letter === 'zel') {\n                document.getElementById('panel-zel').classList.remove('hidden');\n                document.getElementById('tab-zel').className = \"flex-1 md:flex-initial px-6 py-2.5 rounded-xl font-bold transition-all text-sm bg-emerald-600 text-white shadow-sm\";\n            } else if (letter === 'zi') {\n                document.getElementById('panel-zi').classList.remove('hidden');\n                document.getElementById('tab-zi').className = \"flex-1 md:flex-initial px-6 py-2.5 rounded-xl font-bold transition-all text-sm bg-emerald-600 text-white shadow-sm\";\n            }\n        }\n\n        function toggleAnswer(id) {\n            const el = document.getElementById(`answer-${id}`);\n            if (el.classList.contains('hidden')) {\n                el.classList.remove('hidden');\n            } else {\n                el.classList.add('hidden');\n            }\n        }\n    </script>\n\n</body>\n</html>",
