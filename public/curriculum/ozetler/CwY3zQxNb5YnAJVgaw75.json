{
  "htmlContent": "<!DOCTYPE html>\n<html lang=\"tr\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>7. Sınıf Din Kültürü - Nâs Suresi İnteraktif Ders Özeti</title>\n    <!-- Tailwind CSS CDN -->\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <!-- FontAwesome Icons CDN -->\n    <link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css\" />\n    <!-- Google Fonts Arabic & Inter -->\n    <link href=\"https://fonts.googleapis.com/css2?family=Amiri:wght@700&family=Inter:wght@400;500;600;700&display=swap\" rel=\"stylesheet\">\n    <style>\n        .font-arabic { font-family: 'Amiri', serif; }\n        body { font-family: 'Inter', sans-serif; }\n    </style>\n</head>\n<body class=\"bg-gradient-to-br from-emerald-50 via-teal-50 to-cyan-100 min-t-screen text-slate-800 p-4 md:p-8\">\n\n    <div class=\"max-w-5xl mx-auto space-y-8\">\n\n        <!-- BAŞLIK KARTI -->\n        <header class=\"bg-white/80 backdrop-blur-md border border-emerald-100 shadow-xl rounded-3xl p-6 md:p-8 text-center relative overflow-hidden\">\n            <div class=\"absolute -right-10 -top-10 w-40 h-40 bg-emerald-200 rounded-full blur-3xl opacity-50\"></div>\n            <div class=\"absolute -left-10 -bottom-10 w-40 h-40 bg-teal-200 rounded-full blur-3xl opacity-50\"></div>\n            \n            <div class=\"inline-flex items-center gap-2 bg-emerald-100 text-emerald-800 px-4 py-1.5 rounded-full text-sm font-semibold mb-4\">\n                <i class=\"fa-solid fa-book-open\"></i> 7. Sınıf | 1. Ünite: Melek ve Ahiret İnancı\n            </div>\n            <h1 class=\"text-3xl md:text-4xl font-extrabold text-slate-900 tracking-tight\">\n                4. Bir Sure Öğreniyorum: <span class=\"text-emerald-700\">Nâs Suresi</span>\n            </h1>\n            <p class=\"text-slate-600 mt-2 max-w-2xl mx-auto\">\n                Kur'an-ı Kerim'in son suresi olan Nâs suresinin anlamı, fazileti ve hayatımızdaki yeri.\n            </p>\n        </header>\n\n        <!-- KİLİT KAVRAMLAR (GRID) -->\n        <div class=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n            \n            <!-- Kavram 1 -->\n            <div class=\"bg-white rounded-2xl p-6 shadow-md border-l-4 border-emerald-500 hover:shadow-lg transition-shadow\">\n                <div class=\"flex items-center gap-3 mb-2\">\n                    <div class=\"w-10 h-10 rounded-xl bg-emerald-100 flex items-center justify-center text-emerald-600 font-bold\">\n                        <i class=\"fa-solid fa-book\"></i>\n                    </div>\n                    <h3 class=\"text-lg font-bold text-slate-800\">Nâs Suresi Adını Nereden Alır?</h3>\n                </div>\n                <p class=\"text-slate-600 text-sm leading-relaxed\">\n                    Sure, adını ayetlerinde geçen ve <strong>\"insanlar\"</strong> anlamına gelen <strong>\"nâs\"</strong> kelimesinden alır. Namazlarda okunan kısa surelerden biridir.\n                </p>\n            </div>\n\n            <!-- Kavram 2 -->\n            <div class=\"bg-white rounded-2xl p-6 shadow-md border-l-4 border-teal-500 hover:shadow-lg transition-shadow\">\n                <div class=\"flex items-center gap-3 mb-2\">\n                    <div class=\"w-10 h-10 rounded-xl bg-teal-100 flex items-center justify-center text-teal-600 font-bold\">\n                        <i class=\"fa-solid fa-shield-halved\"></i>\n                    </div>\n                    <h3 class=\"text-lg font-bold text-slate-800\">Muavvizeteyn Sureleri</h3>\n                </div>\n                <p class=\"text-slate-600 text-sm leading-relaxed\">\n                    Nâs suresi, <strong>Felak suresiyle</strong> birlikte her türlü kötülüğün şerrinden Allah’a (cc) sığınmak için okunan ortak ad olan <strong>\"Muavvizeteyn\"</strong> olarak adlandırılır.\n                </p>\n            </div>\n\n        </div>\n\n        <!-- ANA FİKİR VE KAZANIM MADDELERİ -->\n        <section class=\"bg-white rounded-3xl p-6 md:p-8 shadow-md border border-slate-100\">\n            <h2 class=\"text-2xl font-bold text-slate-800 mb-6 flex items-center gap-3\">\n                <i class=\"fa-solid fa-lightbulb text-amber-500\"></i> Nâs Suresinin Temel Mesajı ve Kazandırdıkları\n            </h2>\n            <div class=\"grid grid-cols-1 md:grid-cols-3 gap-4\">\n                <div class=\"bg-emerald-50/60 p-5 rounded-2xl border border-emerald-100\">\n                    <div class=\"text-emerald-600 text-xl mb-2\"><i class=\"fa-solid fa-hands-praying\"></i></div>\n                    <h4 class=\"font-bold text-slate-800 mb-1\">Allah'a Sığınma</h4>\n                    <p class=\"text-xs text-slate-600 leading-relaxed\">İnsanları doğrudan, güzelden ve iyiden saptırmak isteyen şeytanın şerrinden yalnızca Allah’a (cc) sığınılması tavsiye edilir.</p>\n                </div>\n                <div class=\"bg-teal-50/60 p-5 rounded-2xl border border-teal-100\">\n                    <div class=\"text-teal-600 text-xl mb-2\"><i class=\"fa-solid fa-triangle-exclamation\"></i></div>\n                    <h4 class=\"font-bold text-slate-800 mb-1\">Vesveseye Karşı Önlem</h4>\n                    <p class=\"text-xs text-slate-600 leading-relaxed\">Vesvesenin insanın anlayışını ve davranışlarını etkileyen bir alışkanlık hâline gelmesinden önce Müslümanların önlem alması önerilir.</p>\n                </div>\n                <div class=\"bg-cyan-50/60 p-5 rounded-2xl border border-cyan-100\">\n                    <div class=\"text-cyan-600 text-xl mb-2\"><i class=\"fa-solid fa-moon\"></i></div>\n                    <h4 class=\"font-bold text-slate-800 mb-1\">Sünnete Uygunluk</h4>\n                    <p class=\"text-xs text-slate-600 leading-relaxed\">Hz. Muhammed (sav) her gün yatmadan önce Felak ve Nâs surelerini okuyarak Allah’a sığınmış ve her namazdan sonra okunmasını tavsiye etmiştir.</p>\n                </div>\n            </div>\n        </section>\n\n        <!-- AYET VE MEAL BÖLÜMÜ -->\n        <section class=\"bg-gradient-to-r from-emerald-900 to-teal-900 text-white rounded-3xl p-6 md:p-8 shadow-xl\">\n            <div class=\"flex items-center justify-between mb-6 border-b border-emerald-800 pb-4\">\n                <h2 class=\"text-xl md:text-2xl font-bold flex items-center gap-3\">\n                    <i class=\"fa-solid fa-quran text-amber-400\"></i> Nâs Suresi Okunuşu ve Anlamı\n                </h2>\n                <span class=\"bg-emerald-800 text-amber-300 text-xs px-3 py-1 rounded-full font-medium\">Kur'an-ı Kerim</span>\n            </div>\n\n            <!-- Arapça Metin -->\n            <div class=\"bg-emerald-950/50 p-6 rounded-2xl mb-6 text-center border border-emerald-800/50\">\n                <p class=\"font-arabic text-2xl md:text-3xl leading-loose text-amber-100\" dir=\"rtl\">\n                    بِسْمِ اللَّهِ الرَّحْمٰنِ الرَّحِيمِ<br>\n                    قُلْ أَعُوذُ بِرَبِّ النَّاسِ ﴿١﴾ مَلِكِ النَّاسِ ﴿٢﴾ إِلٰهِ النَّاسِ ﴿٣﴾ مِنْ شَرِّ الْوَسْوَاسِ الْخَنَّاسِ ﴿٤﴾ الَّذِي يُوَسْوِسُ فِي صُدُورِ النَّاسِ ﴿٥﴾ مِنَ الْجِنَّةِ وَالنَّاسِ ﴿٦﴾\n                </p>\n            </div>\n\n            <!-- Türkçe Meali -->\n            <div class=\"grid grid-cols-1 md:grid-cols-2 gap-4 text-sm bg-emerald-950/30 p-6 rounded-2xl border border-emerald-800/50\">\n                <div>\n                    <span class=\"text-amber-400 font-bold block mb-1\">Rahman ve Rahîm olan Allah’ın adıyla</span>\n                    <p class=\"text-emerald-100 leading-relaxed\">\n                        1-6. De ki: “Cinlerden ve insanlardan; insanların kalplerine vesvese veren sinsi vesvesecinin kötülüğünden, insanların Rabbine, insanların Melik’ine, insanların İlah’ına sığınırım.”\n                    </p>\n                </div>\n                <div class=\"border-t md:border-t-0 md:border-l border-emerald-800 pt-4 md:pt-0 md:pl-4\">\n                    <span class=\"text-amber-400 font-bold block mb-1\">Suredeki Temel Kavramlar:</span>\n                    <ul class=\"space-y-1 text-emerald-100 text-xs\">\n                        <li><strong>Rab:</strong> Eğitip geliştiren, koruyan, sahibi.</li>\n                        <li><strong>Melik:</strong> Mülkün sahibi, mutlak hükümdarı.</li>\n                        <li><strong>İlah:</strong> Kendisine ibadet edilen tek gerçek mabut.</li>\n                        <li><strong>Vesvese:</strong> İnsanın içine atılan kötü düşünce, şüphe.</li>\n                    </ul>\n                </div>\n            </div>\n        </section>\n\n        <!-- PÜF NOKTA / SINIF İPUCU -->\n        <div class=\"bg-amber-50 border-2 border-amber-300/60 rounded-3xl p-6 shadow-sm flex flex-col md:flex-row items-center gap-5\">\n            <div class=\"w-14 h-14 rounded-2xl bg-amber-400 text-white flex items-center justify-center text-2xl shrink-0 shadow-md\">\n                <i class=\"fa-solid fa-star\"></i>\n            </div>\n            <div>\n                <h3 class=\"text-lg font-bold text-amber-900 mb-1\">💡 Unutmayalım! Peygamberimizin Tavsiyesi</h3>\n                <p class=\"text-amber-800/90 text-sm leading-relaxed\">\n                    Hz. Muhammed (sav) Felak ve Nâs sureleri hakkında: <em>“İnsanlar bu iki duadan daha faziletli başka bir dua ile Allah’a sığınmış olmazlar.”</em> buyurmuş ve her namazdan sonra okunmasını tavsiye etmiştir.\n                </p>\n            </div>\n        </div>\n\n        <!-- FOOTER / BİLGİLENDİRME -->\n        <footer class=\"text-center text-xs text-slate-500 py-4\">\n            <p>MEB Din Kültürü ve Ahlak Bilgisi 7. Sınıf Ders Kitabı Kaynak Metnine Sadık Kalınarak Hazırlanmıştır.</p>\n        </footer>\n\n    </div>\n\n</body>\n</html>",
  "updatedAt": "2026-09-15T20:09:23.204Z"
}