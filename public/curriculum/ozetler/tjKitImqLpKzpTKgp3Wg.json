  "htmlContent": "<!DOCTYPE html>\n<html lang=\"tr\" class=\"scroll-smooth\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>7. Sınıf Taif Yolculuğu - Akıllı Tahta Ders Özeti</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css\" />\n    <link href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Amiri:wght@400;700&display=swap\" rel=\"stylesheet\">\n    <script>\n        tailwind.config = {\n            theme: {\n                extend: {\n                    fontFamily: {\n                        sans: ['Plus Jakarta Sans', 'sans-serif'],\n                        arabic: ['Amiri', 'serif'],\n                    },\n                    colors: {\n                        meb: {\n                            50: '#f0f9ff',\n                            100: '#e0f2fe',\n                            500: '#0284c7',\n                            700: '#0369a1',\n                            900: '#0c4a6e',\n                        },\n                        emeraldCustom: {\n                            50: '#ecfdf5',\n                            100: '#d1fae5',\n                            600: '#059669',\n                            800: '#065f46',\n                            900: '#064e3b',\n                        }\n                    }\n                }\n            }\n        }\n    </script>\n    <style>\n        .custom-scrollbar::-webkit-scrollbar {\n            width: 6px;\n            height: 6px;\n        }\n        .custom-scrollbar::-webkit-scrollbar-track {\n            background: #f1f5f9;\n            border-radius: 8px;\n        }\n        .custom-scrollbar::-webkit-scrollbar-thumb {\n            background: #cbd5e1;\n            border-radius: 8px;\n        }\n        .custom-scrollbar::-webkit-scrollbar-thumb:hover {\n            background: #94a3b8;\n        }\n    </style>\n</head>\n<body class=\"bg-slate-50 text-slate-800 font-sans antialiased min-h-screen flex flex-col justify-between selection:bg-sky-500 selection:text-white\">\n\n    <!-- Üst Header / Navigasyon -->\n    <header class=\"bg-gradient-to-r from-sky-900 via-indigo-900 to-slate-900 text-white shadow-xl sticky top-0 z-50 border-b border-sky-500/30\">\n        <div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3.5 flex flex-wrap justify-between items-center gap-4\">\n            <div class=\"flex items-center gap-3\">\n                <div class=\"bg-sky-500/20 p-2.5 rounded-2xl border border-sky-400/30 text-sky-300\">\n                    <i class=\"fa-solid font-bold fa-book-quran text-2xl\"></i>\n                </div>\n                <div>\n                    <div class=\"flex items-center gap-2 text-xs font-semibold text-sky-300 uppercase tracking-wider\">\n                        <span>7. Sınıf</span>\n                        <span>•</span>\n                        <span>Peygamberimizin Hayatı</span>\n                        <span>•</span>\n                        <span>1. Ünite</span>\n                    </div>\n                    <h1 class=\"text-xl sm:text-2xl font-extrabold tracking-tight text-white flex items-center gap-2\">\n                        1.2. TAİF YOLCULUĞU\n                        <span class=\"text-xs bg-emerald-500/20 text-emerald-300 border border-emerald-500/40 px-2.5 py-0.5 rounded-full font-medium\">M. 620</span>\n                    </h1>\n                </div>\n            </div>\n\n            <!-- İnteraktif Sekme Butonları -->\n            <nav class=\"flex bg-slate-800/80 p-1 rounded-xl border border-slate-700/60 text-sm font-medium\">\n                <button onclick=\"switchTab('ozet')\" id=\"btn-ozet\" class=\"tab-btn px-4 py-2 rounded-lg transition-all text-white bg-sky-600 shadow-md flex items-center gap-2\">\n                    <i class=\"fa-solid fa-compass\"></i> <span>Ders Özeti</span>\n                </button>\n                <button onclick=\"switchTab('addas')\" id=\"btn-addas\" class=\"tab-btn px-4 py-2 rounded-lg transition-all text-slate-300 hover:text-white flex items-center gap-2\">\n                    <i class=\"fa-solid fa-seedling\"></i> <span>Üzüm Bahçesi & Addas</span>\n                </button>\n                <button onclick=\"switchTab('hadis')\" id=\"btn-hadis\" class=\"tab-btn px-4 py-2 rounded-lg transition-all text-slate-300 hover:text-white flex items-center gap-2\">\n                    <i class=\"fa-solid fa-quote-left\"></i> <span>Hadis & Hikmet</span>\n                </button>\n                <button onclick=\"switchTab('etkinlik')\" id=\"btn-etkinlik\" class=\"tab-btn px-4 py-2 rounded-lg transition-all text-slate-300 hover:text-white flex items-center gap-2\">\n                    <i class=\"fa-solid fa-pen-to-square\"></i> <span>Sıra Sizde / D-Y</span>\n                </button>\n            </nav>\n        </div>\n    </header>\n\n    <!-- Ana İçerik Konteyneri -->\n    <main class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 flex-grow w-full\">\n\n        <!-- KAVRAM VE BİLGİ KARTLARI HIZLI BAKIŞ -->\n        <section class=\"grid grid-cols-2 md:grid-cols-4 gap-4 mb-6\">\n            <div class=\"bg-white p-4 rounded-2xl border border-slate-200/80 shadow-sm flex items-center gap-3.5 hover:shadow-md transition\">\n                <div class=\"w-12 h-12 rounded-xl bg-amber-100 text-amber-700 flex items-center justify-center text-xl font-bold flex-shrink-0\">\n                    <i class=\"fa-solid fa-user-shield\"></i>\n                </div>\n                <div>\n                    <p class=\"text-xs text-slate-500 font-semibold uppercase\">Yol Arkadaşı</p>\n                    <p class=\"text-sm font-bold text-slate-800\">Zeyd bin Harise (ra)</p>\n                </div>\n            </div>\n\n            <div class=\"bg-white p-4 rounded-2xl border border-slate-200/80 shadow-sm flex items-center gap-3.5 hover:shadow-md transition\">\n                <div class=\"w-12 h-12 rounded-xl bg-sky-100 text-sky-700 flex items-center justify-center text-xl font-bold flex-shrink-0\">\n                    <i class=\"fa-solid fa-clock\"></i>\n                </div>\n                <div>\n                    <p class=\"text-xs text-slate-500 font-semibold uppercase\">Taif'te Kalış Süresi</p>\n                    <p class=\"text-sm font-bold text-slate-800\">10 Gün</p>\n                </div>\n            </div>\n\n            <div class=\"bg-white p-4 rounded-2xl border border-slate-200/80 shadow-sm flex items-center gap-3.5 hover:shadow-md transition\">\n                <div class=\"w-12 h-12 rounded-xl bg-emerald-100 text-emerald-700 flex items-center justify-center text-xl font-bold flex-shrink-0\">\n                    <i class=\"fa-solid fa-bullhorn\"></i>\n                </div>\n                <div>\n                    <p class=\"text-xs text-slate-500 font-semibold uppercase\">Temel Amacı</p>\n                    <p class=\"text-sm font-bold text-slate-800\">Tebliğ & Yeni Yurt Arayışı</p>\n                </div>\n            </div>\n\n            <div class=\"bg-white p-4 rounded-2xl border border-slate-200/80 shadow-sm flex items-center gap-3.5 hover:shadow-md transition\">\n                <div class=\"w-12 h-12 rounded-xl bg-indigo-100 text-indigo-700 flex items-center justify-center text-xl font-bold flex-shrink-0\">\n                    <i class=\"fa-solid fa-mosque\"></i>\n                </div>\n                <div>\n                    <p class=\"text-xs text-slate-500 font-semibold uppercase\">Önemli Eser / Yer</p>\n                    <p class=\"text-sm font-bold text-slate-800\">Mescid-i Addas (Mesna)</p>\n                </div>\n            </div>\n        </section>\n\n\n        <!-- SEKME 1: DERS ÖZETİ VE KRONOLOJİ -->\n        <div id=\"tab-ozet\" class=\"tab-content space-y-6\">\n            <!-- Kazanım Maddeleri -->\n            <div class=\"bg-white p-6 rounded-3xl border border-slate-200/80 shadow-sm\">\n                <h2 class=\"text-lg font-bold text-slate-900 mb-4 flex items-center gap-2\">\n                    <i class=\"fa-solid fa-list-check text-sky-600\"></i> Konunun Ana Fikri ve Önemli Adımları\n                </h2>\n                <div class=\"grid md:grid-cols-3 gap-4\">\n                    <div class=\"bg-slate-50 p-4 rounded-2xl border border-slate-200/60\">\n                        <div class=\"text-sky-600 font-bold text-lg mb-1 flex items-center gap-2\">\n                            <span class=\"w-7 h-7 rounded-full bg-sky-100 text-sky-700 text-xs flex items-center justify-center font-black\">1</span>\n                            Yolculuğun Sebebi\n                        </div>\n                        <p class=\"text-sm text-slate-600 leading-relaxed\">\n                            Ebu Talib’in vefatından sonra Mekkeli müşriklerin Hz. Muhammed’e (sav) karşı baskıları arttı. Efendimiz, İslam’ı Mekke dışında anlatmak ve yeni bir yurt aramak amacıyla 620'de Zeyd bin Harise (ra) ile Taif’e gitti.\n                        </p>\n                    </div>\n\n                    <div class=\"bg-slate-50 p-4 rounded-2xl border border-slate-200/60\">\n                        <div class=\"text-amber-600 font-bold text-lg mb-1 flex items-center gap-2\">\n                            <span class=\"w-7 h-7 rounded-full bg-amber-100 text-amber-700 text-xs flex items-center justify-center font-black\">2</span>\n                            Taif Halkının Tavrı\n                        </div>\n                        <p class=\"text-sm text-slate-600 leading-relaxed\">\n                            Taif'te 10 gün kalan Peygamberimiz şehrin önde gelenleriyle görüştü. Gençlerin Müslüman olmasından korkan Taifliler daveti reddedip şehri terk etmesini istediler. Ziyaretin gizli kalması ricasını da kabul etmeyip Resulullah'ı taşlattılar.\n                        </p>\n                    </div>\n\n                    <div class=\"bg-slate-50 p-4 rounded-2xl border border-slate-200/60\">\n                        <div class=\"text-emerald-600 font-bold text-lg mb-1 flex items-center gap-2\">\n                            <span class=\"w-7 h-7 rounded-full bg-emerald-100 text-emerald-700 text-xs flex items-center justify-center font-black\">3</span>\n                            Sadakat ve Sığınma\n                        </div>\n                        <p class=\"text-sm text-slate-600 leading-relaxed\">\n                            Zeyd bin Harise (ra) Resulullah’ı taşlardan korumak için kendini siper etti fakat yine de Efendimiz yaralandı. Yol üzerindeki bir üzüm bahçesine sığınarak dinlendikten sonra üzgün bir şekilde Mekke’ye döndüler.\n                        </p>\n                    </div>\n                </div>\n            </div>\n\n            <!-- Akılda Kalıcı Püf Nokta / Sınav İpucu -->\n            <div class=\"bg-gradient-to-r from-amber-500/10 via-orange-500/10 to-amber-500/10 border-2 border-amber-400/40 p-5 rounded-2xl flex items-start gap-4\">\n                <div class=\"bg-amber-500 text-white p-3 rounded-xl text-xl flex-shrink-0\">\n                    <i class=\"fa-solid fa-lightbulb\"></i>\n                </div>\n                <div>\n                    <h3 class=\"font-bold text-amber-900 text-base\">🎯 Unutmayalım! (Sınav ve Ders İpucu)</h3>\n                    <p class=\"text-sm text-amber-900/90 leading-relaxed mt-0.5\">\n                        Hz. Muhammed (sav) Taiflilerden ziyaretinin Mekkelilere duyurulmamasını rica etmiştir. Bunun sebebi: <strong>Ziyareti duyan Mekkeli müşriklerin Müslümanlara olan baskılarını daha da artıracaklarını düşünmesidir.</strong>\n                    </p>\n                </div>\n            </div>\n        </div>\n\n\n        <!-- SEKME 2: ÜZÜM BAHÇESİ VE ADDAS (OKUYALIM METNİ) -->\n        <div id=\"tab-addas\" class=\"tab-content hidden space-y-6\">\n            <div class=\"bg-white p-6 rounded-3xl border border-slate-200/80 shadow-sm\">\n                <div class=\"flex items-center justify-between border-b pb-4 mb-6\">\n                    <div>\n                        <span class=\"text-xs font-bold text-emerald-600 uppercase tracking-widest\">Ders Kitabı Okuma Metni</span>\n                        <h2 class=\"text-xl font-extrabold text-slate-900\">Taif’in Üzüm Bahçesinde İslam’a Davet</h2>\n                    </div>\n                    <span class=\"bg-emerald-100 text-emerald-800 text-xs font-semibold px-3 py-1 rounded-full\">\n                        <i class=\"fa-solid fa-location-dot\"></i> Mesna Bölgesi\n                    </span>\n                </div>\n\n                <!-- Diyalog ve Olay Akışı -->\n                <div class=\"grid md:grid-cols-2 gap-6\">\n                    <div class=\"space-y-4\">\n                        <div class=\"bg-slate-50 p-4 rounded-2xl border border-slate-200\">\n                            <h3 class=\"font-bold text-slate-800 mb-2 flex items-center gap-2\">\n                                <i class=\"fa-solid fa-tree text-emerald-600\"></i> Bağ Sahipleri ve İkram\n                            </h3>\n                            <p class=\"text-sm text-slate-600 leading-relaxed\">\n                                Saldırıdan kurtulmak için sığınılan bağ, Hz. Muhammed’e (sav) uzaktan akraba sayılan <strong>Utbe bin Rebia</strong> ve <strong>Şeybe bin Rebia</strong> adındaki iki kardeşe aitti. Efendimizi bağlarında görünce köleleri <strong>Addas</strong> ile iki salkım üzüm gönderdiler.\n                            </p>\n                        </div>\n\n                        <div class=\"bg-emerald-50 border border-emerald-200 p-4 rounded-2xl\">\n                            <h3 class=\"font-bold text-emerald-900 mb-2 flex items-center gap-2\">\n                                <i class=\"fa-solid fa-heart text-emerald-600\"></i> Mescid-i Addas\n                            </h3>\n                            <p class=\"text-sm text-emerald-800 leading-relaxed\">\n                                Addas’ın Hz. Muhammed’e (sav) ikramda bulunduğu bu bahçeye sonraki dönemlerde bir mescit yapılmıştır. <strong>Mescid-i Addas</strong>, Taif’in <strong>Mesna</strong> bölgesinde bulunmaktadır.\n                            </p>\n                        </div>\n                    </div>\n\n                    <!-- İletişim / Konuşma Kartı -->\n                    <div class=\"bg-sky-50/60 p-5 rounded-2xl border border-sky-100 space-y-3 font-medium text-sm\">\n                        <div class=\"text-xs font-bold text-sky-800 uppercase tracking-wider mb-2 border-b border-sky-200 pb-1\">\n                            💬 Bahçedeki Unutulmaz Diyalog\n                        </div>\n\n                        <div class=\"p-2.5 bg-white rounded-xl shadow-sm\">\n                            <span class=\"text-xs font-bold text-slate-400 block\">Peygamber Efendimiz (sav):</span>\n                            <span class=\"text-slate-700 italic\">Üzümü yemeden önce <strong>\"Besmele\"</strong> çekti.</span>\n                        </div>\n\n                        <div class=\"p-2.5 bg-sky-100/70 rounded-xl\">\n                            <span class=\"text-xs font-bold text-sky-900 block\">Addas (Hristiyan Köle):</span>\n                            <span class=\"text-sky-950\">\"Yıllarca buralardayım. Kimseden böyle bir söz duymadım. Bu nasıl sözdür?\"</span>\n                        </div>\n\n                        <div class=\"p-2.5 bg-white rounded-xl shadow-sm\">\n                            <span class=\"text-xs font-bold text-slate-400 block\">Peygamber Efendimiz (sav):</span>\n                            <span class=\"text-slate-700\">\"Sen neredensin? Yunus’un (as) memleketindenmişsin.\"</span>\n                        </div>\n\n                        <div class=\"p-2.5 bg-sky-100/70 rounded-xl\">\n                            <span class=\"text-xs font-bold text-sky-900 block\">Addas:</span>\n                            <span class=\"text-sky-950\">\"Ninovalıyım. Sen Yunus’u (as) nereden tanıyorsun? Onu buralarda kimse bilmez.\"</span>\n                        </div>\n\n                        <div class=\"p-2.5 bg-white rounded-xl shadow-sm\">\n                            <span class=\"text-xs font-bold text-slate-400 block\">Peygamber Efendimiz (sav):</span>\n                            <span class=\"text-slate-700\">\"O benim kardeşimdir. O da benim gibi peygamberdi.\"</span>\n                        </div>\n\n                        <div class=\"p-3 bg-emerald-600 text-white rounded-xl shadow-md font-semibold\">\n                            <span class=\"text-xs font-bold text-emerald-200 block\">Addas Müslüman Oluyor:</span>\n                            \"Bu güzel yüzün, bu tatlı sözlerin sahibi yalancı olamaz. Ben inandım ki, sen Allah’ın (cc) Resulüsün.\"\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n\n\n        <!-- SEKME 3: HADİS VE HİKMET (AYET/HADİS KUTUSU) -->\n        <div id=\"tab-hadis\" class=\"tab-content hidden space-y-6\">\n            \n            <!-- Melek Teklifi ve Hz. Muhammed'in Rahmeti -->\n            <div class=\"bg-white p-6 rounded-3xl border border-slate-200/80 shadow-sm\">\n                <div class=\"flex items-center gap-3 mb-4\">\n                    <div class=\"w-10 h-10 rounded-xl bg-indigo-100 text-indigo-700 flex items-center justify-center font-bold\">\n                        <i class=\"fa-solid fa-mountain text-lg\"></i>\n                    </div>\n                    <div>\n                        <h2 class=\"text-lg font-bold text-slate-900\">Taif Dönüşü Meleğin Teklifi ve Peygamberimizin Cevabı</h2>\n                        <p class=\"text-xs text-slate-500\">Kaynak: Buhari, \"Bed'ü'l-Halk\", 7</p>\n                    </div>\n                </div>\n\n                <div class=\"grid md:grid-cols-2 gap-4\">\n                    <div class=\"bg-slate-50 p-4 rounded-2xl border border-slate-200\">\n                        <span class=\"text-xs font-bold text-slate-500 uppercase tracking-wider block mb-1\">Meleğin Seslenişi</span>\n                        <p class=\"text-sm font-medium text-slate-800 italic\">\n                            \"Ey Muhammed, emret! Şu iki dağı onların üstüne yıkayım.\"\n                        </p>\n                    </div>\n\n                    <div class=\"bg-indigo-50 border border-indigo-200 p-4 rounded-2xl\">\n                        <span class=\"text-xs font-bold text-indigo-700 uppercase tracking-wider block mb-1\">Peygamber Efendimiz'in (sav) Cevabı</span>\n                        <p class=\"text-sm font-bold text-indigo-950\">\n                            \"Hayır, ümit ediyorum ki Allah (cc) onların soyundan sadece Allah’a ibadet eden ve O’na hiçbir şeyi ortak koşmayan bir nesil çıkartacaktır.\"\n                        </p>\n                    </div>\n                </div>\n            </div>\n\n            <!-- HADİS-İ ŞERİF KUTUSU -->\n            <div class=\"bg-gradient-to-br from-emerald-900 via-emerald-800 to-slate-900 text-white p-6 sm:p-8 rounded-3xl shadow-xl relative overflow-hidden border border-emerald-500/30\">\n                <div class=\"absolute -right-10 -bottom-10 text-emerald-700/20 text-9xl font-arabic select-none pointer-events-none\">\n                    حديث\n                </div>\n\n                <div class=\"relative z-10 space-y-4\">\n                    <div class=\"flex justify-between items-center\">\n                        <span class=\"bg-emerald-500/30 text-emerald-200 border border-emerald-400/30 text-xs px-3 py-1 rounded-full font-semibold\">\n                            <i class=\"fa-solid fa-book-open\"></i> Bir Hadis Öğreniyorum\n                        </span>\n                        <span class=\"text-xs text-emerald-300 font-mono\">Tirmizi, \"Birr\", 63</span>\n                    </div>\n\n                    <!-- Arapça Metin -->\n                    <div class=\"text-right font-arabic text-2xl sm:text-3xl text-emerald-100 leading-loose py-2 border-b border-emerald-700/50\">\n                        «لَا تَكُونُوا إِمَّعَةً، تَقُولُونَ: إِنْ أَحْسَنَ النَّاسُ أَحْسَنَّا، وَإِنْ ظَلَمُوا ظَلَمْنَا، وَلَكِنْ وَطِّنُوا أَنْفُسَكُمْ، إِنْ أَحْسَنَ النَّاسُ أَنْ تُحْسِنُوا، وَإِنْ أَسَاءُوا فَلَا تَظْلِمُوا»\n                    </div>\n\n                    <!-- Türkçe Meal -->\n                    <p class=\"text-base sm:text-lg text-emerald-50 leading-relaxed font-light italic\">\n                        Peygamber Efendimiz bir hadis-i şerifinde şöyle buyurmuştur:\n                        <br>\n                        <span class=\"font-semibold text-white\">\n                            \"‘İnsanlar iyilik yaparsa biz de iyilik yaparız, kötülük yaparsa biz de kötülük yaparız.’ diyen sıradan kimseler gibi olmayınız. Bilakis iyilik yaptıklarında insanlara iyilikle karşılık vermeyi, kötülük yaptıklarında ise onlara zulmetmemeyi alışkanlık hâline getiriniz.\"\n                        </span>\n                    </p>\n                </div>\n            </div>\n        </div>\n\n\n        <!-- SEKME 4: AKILLI TAHTA ETKİNLİĞİ (D/Y VE DEĞERLENDİRME) -->\n        <div id=\"tab-etkinlik\" class=\"tab-content hidden space-y-6\">\n            <div class=\"bg-white p-6 rounded-3xl border border-slate-200/80 shadow-sm\">\n                <div class=\"flex items-center justify-between mb-4\">\n                    <div>\n                        <h2 class=\"text-lg font-bold text-slate-900 flex items-center gap-2\">\n                            <i class=\"fa-solid fa-list-check text-sky-600\"></i> Etkileşimli Doğru / Yanlış Etkinliği\n                        </h2>\n                        <p class=\"text-xs text-slate-500\">Cevabı görmek için kutuların üzerine veya \"Cevabı Göster\" butonuna tıklayınız.</p>\n                    </div>\n                    <button onclick=\"checkAllDY()\" class=\"text-xs bg-sky-100 text-sky-800 font-bold px-3 py-1.5 rounded-xl hover:bg-sky-200 transition\">\n                        Tümünü Göster\n                    </button>\n                </div>\n\n                <div class=\"space-y-4\">\n                    <!-- Soru 1 -->\n                    <div class=\"p-4 rounded-2xl bg-slate-50 border border-slate-200 flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n                        <div class=\"space-y-1\">\n                            <p class=\"text-sm font-semibold text-slate-800\">1. Hz. Muhammed (sav), halkını İslam’a davet etmek için Taif’e gitmiştir.</p>\n                            <p id=\"ans-1\" class=\"text-xs font-bold text-emerald-600 hidden\">DOĞRU ✔️ (İslam'ı Mekke dışında anlatmak ve yeni yurt arayışı için gitmiştir.)</p>\n                        </div>\n                        <button onclick=\"toggleAnswer('ans-1')\" class=\"self-start sm:self-auto text-xs bg-slate-200 hover:bg-slate-300 font-bold px-3 py-1.5 rounded-lg transition\">\n                            Cevap\n                        </button>\n                    </div>\n\n                    <!-- Soru 2 -->\n                    <div class=\"p-4 rounded-2xl bg-slate-50 border border-slate-200 flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n                        <div class=\"space-y-1\">\n                            <p class=\"text-sm font-semibold text-slate-800\">2. Taifliler Hz. Muhammed’in (sav) peygamberliğini kabul etmiştir.</p>\n                            <p id=\"ans-2\" class=\"text-xs font-bold text-rose-600 hidden\">YANLIŞ ❌ (Doğrusu: Taifliler daveti reddetmiş, şehri terk etmesini istemiş ve taşlatmışlardır.)</p>\n                        </div>\n                        <button onclick=\"toggleAnswer('ans-2')\" class=\"self-start sm:self-auto text-xs bg-slate-200 hover:bg-slate-300 font-bold px-3 py-1.5 rounded-lg transition\">\n                            Cevap\n                        </button>\n                    </div>\n\n                    <!-- Soru 3 -->\n                    <div class=\"p-4 rounded-2xl bg-slate-50 border border-slate-200 flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n                        <div class=\"space-y-1\">\n                            <p class=\"text-sm font-semibold text-slate-800\">3. Taif’teki zorluklar, Müslümanların inanç ve sabrını güçlendiren bir deneyim olmuştur.</p>\n                            <p id=\"ans-3\" class=\"text-xs font-bold text-emerald-600 hidden\">DOĞRU ✔️ (Zorluklar karşısında sabır gösterilmiş ve iman güçlenmiştir.)</p>\n                        </div>\n                        <button onclick=\"toggleAnswer('ans-3')\" class=\"self-start sm:self-auto text-xs bg-slate-200 hover:bg-slate-300 font-bold px-3 py-1.5 rounded-lg transition\">\n                            Cevap\n                        </button>\n                    </div>\n\n                    <!-- Soru 4 -->\n                    <div class=\"p-4 rounded-2xl bg-slate-50 border border-slate-200 flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n                        <div class=\"space-y-1\">\n                            <p class=\"text-sm font-semibold text-slate-800\">4. Bu yolculukta Hz. Muhammed (sav) sabır ve tevekkül örneği göstermiştir.</p>\n                            <p id=\"ans-4\" class=\"text-xs font-bold text-emerald-600 hidden\">DOĞRU ✔️ (Ağır hakaret ve taşlanmaya rağmen Beddua etmeyip hidayetleri için dua etmiştir.)</p>\n                        </div>\n                        <button onclick=\"toggleAnswer('ans-4')\" class=\"self-start sm:self-auto text-xs bg-slate-200 hover:bg-slate-300 font-bold px-3 py-1.5 rounded-lg transition\">\n                            Cevap\n                        </button>\n                    </div>\n                </div>\n            </div>\n\n            <!-- Ders Kitabı Sınıf İçi Düşünme Soruları -->\n            <div class=\"bg-slate-900 text-white p-6 rounded-3xl border border-slate-800 shadow-md space-y-3\">\n                <h3 class=\"font-bold text-base text-sky-400 flex items-center gap-2\">\n                    <i class=\"fa-solid fa-comments\"></i> Sınıf İçi Değerlendirme Soruları (Sıra Sizde)\n                </h3>\n                <ol class=\"list-decimal list-inside text-sm text-slate-300 space-y-2 leading-relaxed\">\n                    <li>Taiflilerin olumsuz tavrına rağmen Hz. Muhammed’in (sav) göstermiş olduğu tutum onun hangi ahlaki özelliklerini yansıtmaktadır? (Sabır, affedicilik, merhamet, hoşgörü, azim).</li>\n                    <li>Hz. Muhammed’in (sav) Taiflilere karşı sergilemiş olduğu tutumu nasıl değerlendiriyorsunuz?</li>\n                    <li>Haksızlığa uğradığınız bir durum yaşasaydınız nasıl davranırdınız? Hadis-i şerifi de dikkate alarak düşüncelerinizi paylaşınız.</li>\n                </ol>\n            </div>\n        </div>\n\n    </main>\n\n    <!-- Alt Bilgi / Footer -->\n    <footer class=\"bg-white border-t border-slate-200 py-4 mt-8\">\n        <div class=\"max-w-7xl mx-auto px-4 text-center text-xs text-slate-500 font-medium flex flex-wrap justify-between items-center gap-2\">\n            <span>MEB Din Kültürü ve Ahlak Bilgisi - 7. Sınıf Akıllı Tahta Materyali</span>\n            <span>%100 Ders Kitabı Kaynaklı Sadık Özet</span>\n        </div>\n    </footer>\n\n    <!-- JS İnteraktif Kodlar -->\n    <script>\n        function switchTab(tabName) {\n            // Hide all tab contents\n            const contents = document.querySelectorAll('.tab-content');\n            contents.forEach(content => content.classList.add('hidden'));\n\n            // Reset tab button styles\n            const buttons = document.querySelectorAll('.tab-btn');\n            buttons.forEach(btn => {\n                btn.classList.remove('bg-sky-600', 'text-white', 'shadow-md');\n                btn.classList.add('text-slate-300');\n            });\n\n            // Show target content\n            document.getElementById('tab-' + tabName).classList.remove('hidden');\n\n            // Highlight active button\n            const activeBtn = document.getElementById('btn-' + tabName);\n            activeBtn.classList.remove('text-slate-300');\n            activeBtn.classList.add('bg-sky-600', 'text-white', 'shadow-md');\n        }\n\n        function toggleAnswer(id) {\n            const el = document.getElementById(id);\n            if (el.classList.contains('hidden')) {\n                el.classList.remove('hidden');\n            } else {\n                el.classList.add('hidden');\n            }\n        }\n\n        function checkAllDY() {\n            for (let i = 1; i <= 4; i++) {\n                const el = document.getElementById('ans-' + i);\n                if (el) el.classList.remove('hidden');\n            }\n        }\n    </script>\n</body>\n</html>",
