  "htmlContent": "<!DOCTYPE html>\n<html lang=\"tr\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>6. Sınıf Kur'an-ı Kerim'in İç Düzeni - İnteraktif Ders Özeti</title>\n    <!-- Tailwind CSS CDN -->\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <!-- FontAwesome Icons -->\n    <link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css\" />\n    <!-- Google Fonts -->\n    <link href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Amiri:ital,wght@0,400;0,700;1,400&display=swap\" rel=\"stylesheet\">\n    <script>\n        tailwind.config = {\n            theme: {\n                extend: {\n                    fontFamily: {\n                        sans: ['Plus Jakarta Sans', 'sans-serif'],\n                        arabic: ['Amiri', 'serif'],\n                    },\n                    colors: {\n                        emerald: {\n                            50: '#f0fdf4',\n                            100: '#dcfce7',\n                            200: '#bbf7d0',\n                            600: '#16a34a',\n                            700: '#15803d',\n                            800: '#166534',\n                            900: '#14532d',\n                        },\n                        amber: {\n                            50: '#fffbeb',\n                            100: '#fef3c7',\n                            500: '#f59e0b',\n                            600: '#d97706',\n                        }\n                    }\n                }\n            }\n        }\n    </script>\n    <style>\n        .custom-scrollbar::-webkit-scrollbar {\n            width: 6px;\n        }\n        .custom-scrollbar::-webkit-scrollbar-track {\n            background: transparent;\n        }\n        .custom-scrollbar::-webkit-scrollbar-thumb {\n            background: #cbd5e1;\n            border-radius: 3px;\n        }\n        .custom-scrollbar::-webkit-scrollbar-thumb:hover {\n            background: #94a3b8;\n        }\n    </style>\n</head>\n<body class=\"bg-gradient-to-br from-emerald-50 via-slate-50 to-amber-50/30 min-h-screen font-sans text-slate-800 antialiased selection:bg-emerald-200\">\n\n    <!-- Üst Bar / Navigasyon -->\n    <header class=\"bg-white/80 backdrop-blur-md border-b border-emerald-100 sticky top-0 z-50 transition-all duration-300\">\n        <div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between\">\n            <div class=\"flex items-center space-x-4\">\n                <div class=\"bg-emerald-600 text-white p-3 rounded-2xl shadow-lg shadow-emerald-600/20 flex items-center justify-center transform hover:rotate-6 transition-transform\">\n                    <i class=\"fa-solid fa-book-quran text-2xl\"></i>\n                </div>\n                <div>\n                    <span class=\"text-xs font-bold text-emerald-700 tracking-wider uppercase bg-emerald-100/70 px-2.5 py-1 rounded-full\">1. ÜNİTE: KUR'AN-I KERİM'İ TANIYORUM</span>\n                    <h1 class=\"text-lg sm:text-xl font-extrabold text-slate-900 tracking-tight mt-0.5\">1.1. Kur'an-ı Kerim'in İç Düzenini Öğreniyorum</h1>\n                </div>\n            </div>\n            <div class=\"flex items-center space-x-3\">\n                <span class=\"hidden md:inline-flex items-center px-3 py-1.5 rounded-full text-sm font-semibold bg-amber-100 text-amber-800 border border-amber-200\">\n                    <i class=\"fa-solid fa-graduation-cap mr-1.5\"></i> 6. Sınıf Kur'an-ı Kerim\n                </span>\n                <span class=\"inline-flex items-center px-3 py-1.5 rounded-full text-sm font-semibold bg-emerald-600 text-white shadow-md\">\n                    <i class=\"fa-solid fa-desktop mr-1.5 animate-pulse\"></i> Akıllı Tahta Modu\n                </span>\n            </div>\n        </div>\n    </header>\n\n    <main class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8\">\n        \n        <!-- Giriş ve Vahiy Tanımı -->\n        <section class=\"grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch\">\n            <!-- Vahiy Nedir? Kartı -->\n            <div class=\"lg:col-span-7 bg-white rounded-3xl p-6 sm:p-8 shadow-sm border border-slate-100 flex flex-col justify-between hover:shadow-md transition-shadow\">\n                <div>\n                    <div class=\"flex items-center space-x-3 mb-6\">\n                        <span class=\"p-2.5 bg-emerald-50 rounded-xl text-emerald-600\"><i class=\"fa-solid fa-feather-pointed text-xl\"></i></span>\n                        <h2 class=\"text-2xl font-bold text-slate-900\">Vahiy Kavramı</h2>\n                    </div>\n                    <p class=\"text-slate-600 leading-relaxed mb-6\">\n                        İlahi kitapların sonuncusu olan Kur'an-ı Kerim, Allah (cc) tarafından Hz. Muhammed'e (sav) vahyedilmiştir. Vahiy kelimesinin anlam boyutu şu şekildedir:\n                    </p>\n                    <div class=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n                        <div class=\"bg-gradient-to-br from-slate-50 to-slate-100/50 p-5 rounded-2xl border border-slate-200\">\n                            <span class=\"text-xs font-bold text-slate-500 uppercase tracking-widest block mb-1\">Sözlük Anlamı</span>\n                            <p class=\"font-bold text-slate-800 text-lg flex flex-wrap gap-1.5\">\n                                <span class=\"bg-white px-2 py-0.5 rounded border text-sm\">Gizli konuşmak</span>\n                                <span class=\"bg-white px-2 py-0.5 rounded border text-sm\">Seslenmek</span>\n                                <span class=\"bg-white px-2 py-0.5 rounded border text-sm\">İlham etmek</span>\n                                <span class=\"bg-white px-2 py-0.5 rounded border text-sm\">İşaret etmek</span>\n                            </p>\n                        </div>\n                        <div class=\"bg-gradient-to-br from-emerald-50 to-emerald-100/20 p-5 rounded-2xl border border-emerald-100\">\n                            <span class=\"text-xs font-bold text-emerald-700 uppercase tracking-widest block mb-1\">Terim Anlamı</span>\n                            <p class=\"text-slate-800 font-medium text-sm leading-relaxed\">\n                                Allah'ın (cc) buyruk, yasak ve öğütlerini özel yollarla peygamberlerine iletmesi demektir.\n                            </p>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"mt-6 pt-5 border-t border-slate-100 flex items-center justify-between text-xs text-slate-500\">\n                    <span><i class=\"fa-solid fa-clock mr-1\"></i> Yirmi Üç Yılda İndirilmiştir</span>\n                    <span><i class=\"fa-solid fa-shield-halved mr-1\"></i> İlahi Koruma Altındadır</span>\n                </div>\n            </div>\n\n            <!-- Vahiy Süreci & İlahi Koruma -->\n            <div class=\"lg:col-span-5 bg-gradient-to-br from-emerald-900 to-emerald-950 text-white rounded-3xl p-6 sm:p-8 shadow-xl relative overflow-hidden flex flex-col justify-between\">\n                <div class=\"absolute -right-16 -top-16 w-48 h-48 bg-emerald-800/30 rounded-full blur-3xl\"></div>\n                <div class=\"relative\">\n                    <div class=\"flex items-center justify-between mb-6\">\n                        <span class=\"text-xs font-bold bg-emerald-800 text-emerald-200 px-3 py-1 rounded-full uppercase tracking-wider\">Vahiy Meleği</span>\n                        <span class=\"text-sm font-semibold text-amber-400\"><i class=\"fa-solid fa-circle-check\"></i> 23 Yıl</span>\n                    </div>\n                    <p class=\"text-emerald-100/90 text-sm leading-relaxed mb-4\">\n                        Kur'an-ı Kerim'in tamamı bir defada gönderilmemiştir. Vahiy Meleği <strong>Hz. Cebrail (as)</strong> aracılığıyla Sevgili Peygamberimiz <strong>Hz. Muhammed'e (sav)</strong> parça parça indirilmiştir.\n                    </p>\n                    <p class=\"text-emerald-200/80 text-sm leading-relaxed\">\n                        Peygamberimiz, ayet ve sureleri vahiy kâtiplerine yazdırırken Allah'ın (cc) Cebrail (as) vasıtasıyle bildirdiği düzene harfiyen uymuştur.\n                    </p>\n                </div>\n                <div class=\"mt-8 border-t border-emerald-800/60 pt-4 flex items-center space-x-4\">\n                    <div class=\"p-2.5 bg-emerald-800 rounded-xl text-amber-400\"><i class=\"fa-solid fa-scroll text-xl\"></i></div>\n                    <div>\n                        <h4 class=\"text-sm font-bold text-white\">Vahiy Kâtipleri</h4>\n                        <p class=\"text-xs text-emerald-300\">Gelen vahiyleri özenle kaydeden sahabeler.</p>\n                    </div>\n                </div>\n            </div>\n        </section>\n\n        <!-- Ayetler Kutusu (Arapça ve Meal) -->\n        <section class=\"grid grid-cols-1 lg:grid-cols-2 gap-8\">\n            <!-- Ayet 1: Furkan Suresi -->\n            <div class=\"bg-white rounded-3xl p-6 sm:p-8 border border-slate-100 shadow-sm relative overflow-hidden flex flex-col justify-between\">\n                <div class=\"absolute right-0 top-0 w-24 h-24 bg-amber-50 rounded-bl-full -z-0\"></div>\n                <div class=\"relative z-10\">\n                    <div class=\"flex items-center space-x-3 mb-4\">\n                        <span class=\"text-amber-600 bg-amber-50 px-2.5 py-1 rounded-md text-xs font-bold\">Furkan Suresi 32. Ayet</span>\n                    </div>\n                    <!-- Arapça Metin -->\n                    <div class=\"font-arabic text-3xl text-emerald-900 leading-loose text-right my-4 dir-rtl tracking-wide select-none\" dir=\"rtl\">\n                        كٰذٰلِكَ لِنُثَبِّتَ بِه۪ فُؤَادَكَ وَرَتَّلْنَاهُ تَرْت۪يلًا\n                    </div>\n                    <!-- Türkçe Meal -->\n                    <div class=\"text-slate-600 italic text-sm leading-relaxed border-l-4 border-emerald-500 pl-4 py-1 mt-4\">\n                        \"... Biz onu senin kalbine iyice yerleştirmek için böyle yaptık (Parça parça indirdik.) ve onu tane tane (ayırarak) okuduk.\"\n                    </div>\n                </div>\n            </div>\n\n            <!-- Ayet 2: Hicr Suresi -->\n            <div class=\"bg-white rounded-3xl p-6 sm:p-8 border border-slate-100 shadow-sm relative overflow-hidden flex flex-col justify-between\">\n                <div class=\"absolute right-0 top-0 w-24 h-24 bg-emerald-50 rounded-bl-full -z-0\"></div>\n                <div class=\"relative z-10\">\n                    <div class=\"flex items-center space-x-3 mb-4\">\n                        <span class=\"text-emerald-600 bg-emerald-50 px-2.5 py-1 rounded-md text-xs font-bold\">Hicr Suresi 9. Ayet</span>\n                    </div>\n                    <!-- Arapça Metin -->\n                    <div class=\"font-arabic text-3xl text-emerald-900 leading-loose text-right my-4 dir-rtl tracking-wide select-none\" dir=\"rtl\">\n                        اِنَّا نَحْنُ نَزَّلْنَا الذِّكْرَ وَاِنَّا لَهُ لَحٰفِظُونَ\n                    </div>\n                    <!-- Türkçe Meal -->\n                    <div class=\"text-slate-600 italic text-sm leading-relaxed border-l-4 border-emerald-500 pl-4 py-1 mt-4\">\n                        \"Şüphesiz o zikri (Kur'an'ı) biz indirdik biz! Onun koruyucusu da elbette biziz.\"\n                    </div>\n                </div>\n            </div>\n        </section>\n\n        <!-- Kur'an-ı Kerim'in İç Düzeni (4 Temel Kavram) -->\n        <section class=\"space-y-6\">\n            <div class=\"flex items-center justify-between\">\n                <div>\n                    <h2 class=\"text-2xl font-bold text-slate-900\">Kur'an-ı Kerim'in İç Düzeni ile İlgili Kavramlar</h2>\n                    <p class=\"text-slate-500 text-sm mt-1\">Cümle, konu ve sayfa sayısı bakımından bölümlenme terimleri</p>\n                </div>\n                <span class=\"text-xs bg-slate-200 text-slate-700 px-3 py-1 rounded-full font-semibold\">Bilgi Grafiği 1.1</span>\n            </div>\n\n            <div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6\">\n                <!-- AYET -->\n                <div class=\"bg-white rounded-3xl p-6 border border-emerald-100 hover:border-emerald-300 transition-all shadow-sm flex flex-col justify-between relative group\">\n                    <div class=\"absolute top-4 right-4 text-emerald-200 group-hover:text-emerald-400 transition-colors\">\n                        <i class=\"fa-solid fa-star-and-crescent text-2xl\"></i>\n                    </div>\n                    <div>\n                        <div class=\"bg-emerald-50 text-emerald-700 text-xs font-bold w-fit px-3 py-1 rounded-full mb-4\">Metin Birimi</div>\n                        <h3 class=\"text-xl font-extrabold text-slate-900 mb-2\">Ayet</h3>\n                        <p class=\"text-slate-600 text-xs leading-relaxed\">\n                            Surelerin içinde yer alan, özel işaretlerle ayrılan ve uzunlukları birbirinden farklı olabilen vahiy cümleleridir.\n                        </p>\n                    </div>\n                    <div class=\"mt-6 pt-4 border-t border-slate-100 text-xs text-slate-400 font-semibold flex justify-between items-center\">\n                        <span>Ayet Durağı ile Ayrılır</span>\n                        <i class=\"fa-solid fa-circle text-[8px] text-emerald-500\"></i>\n                    </div>\n                </div>\n\n                <!-- SURE -->\n                <div class=\"bg-white rounded-3xl p-6 border border-emerald-100 hover:border-emerald-300 transition-all shadow-sm flex flex-col justify-between relative group\">\n                    <div class=\"absolute top-4 right-4 text-amber-200 group-hover:text-amber-400 transition-colors\">\n                        <i class=\"fa-solid fa-tags text-2xl\"></i>\n                    </div>\n                    <div>\n                        <div class=\"bg-amber-50 text-amber-700 text-xs font-bold w-fit px-3 py-1 rounded-full mb-4\">Bölüm Birimi</div>\n                        <h3 class=\"text-xl font-extrabold text-slate-900 mb-2\">Sure</h3>\n                        <p class=\"text-slate-600 text-xs leading-relaxed\">\n                            Ayetlerin bir araya getirilmesiyle oluşan bölümlerdir. Kur'an-ı Kerim'de toplam 114 sure bulunur.\n                        </p>\n                    </div>\n                    <div class=\"mt-6 pt-4 border-t border-slate-100 text-xs text-slate-400 font-semibold flex justify-between items-center\">\n                        <span>114 Sure Vardır</span>\n                        <i class=\"fa-solid fa-circle text-[8px] text-amber-500\"></i>\n                    </div>\n                </div>\n\n                <!-- CÜZ -->\n                <div class=\"bg-white rounded-3xl p-6 border border-emerald-100 hover:border-emerald-300 transition-all shadow-sm flex flex-col justify-between relative group\">\n                    <div class=\"absolute top-4 right-4 text-sky-200 group-hover:text-sky-400 transition-colors\">\n                        <i class=\"fa-solid fa-bookmark text-2xl\"></i>\n                    </div>\n                    <div>\n                        <div class=\"bg-sky-50 text-sky-700 text-xs font-bold w-fit px-3 py-1 rounded-full mb-4\">Sayfa Birimi (20 Sayfa)</div>\n                        <h3 class=\"text-xl font-extrabold text-slate-900 mb-2\">Cüz</h3>\n                        <p class=\"text-slate-600 text-xs leading-relaxed\">\n                            Kur'an-ı Kerim'in yirmi sayfadan oluşan her bir bölümüdür. Kur'an'da toplam 30 cüz bulunur.\n                        </p>\n                    </div>\n                    <div class=\"mt-6 pt-4 border-t border-slate-100 text-xs text-slate-400 font-semibold flex justify-between items-center\">\n                        <span>30 Cüz Vardır</span>\n                        <i class=\"fa-solid fa-circle text-[8px] text-sky-500\"></i>\n                    </div>\n                </div>\n\n                <!-- HİZİP -->\n                <div class=\"bg-white rounded-3xl p-6 border border-emerald-100 hover:border-emerald-300 transition-all shadow-sm flex flex-col justify-between relative group\">\n                    <div class=\"absolute top-4 right-4 text-purple-200 group-hover:text-purple-400 transition-colors\">\n                        <i class=\"fa-solid fa-indent text-2xl\"></i>\n                    </div>\n                    <div>\n                        <div class=\"bg-purple-50 text-purple-700 text-xs font-bold w-fit px-3 py-1 rounded-full mb-4\">Sayfa Birimi (5 Sayfa)</div>\n                        <h3 class=\"text-xl font-extrabold text-slate-900 mb-2\">Hizip</h3>\n                        <p class=\"text-slate-600 text-xs leading-relaxed\">\n                            Kur'an-ı Kerim'in beş sayfalık her bir bölümüdür. Her cüzde dört hizip bulunur. Kur'an toplamda 120 hizipten oluşur.\n                        </p>\n                    </div>\n                    <div class=\"mt-6 pt-4 border-t border-slate-100 text-xs text-slate-400 font-semibold flex justify-between items-center\">\n                        <span>120 Hizip Vardır</span>\n                        <i class=\"fa-solid fa-circle text-[8px] text-purple-500\"></i>\n                    </div>\n                </div>\n            </div>\n        </section>\n\n        <!-- Akıllı Tahta Bilgi & Sayfa Düzeni İnceleme Bölümü -->\n        <section class=\"grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch\">\n            <!-- Sayfa Bileşenleri Keşif Aracı -->\n            <div class=\"lg:col-span-8 bg-white rounded-3xl p-6 sm:p-8 border border-slate-100 shadow-sm flex flex-col justify-between\">\n                <div>\n                    <h3 class=\"text-xl font-bold text-slate-900 mb-2 flex items-center\">\n                        <span class=\"mr-2.5 p-1.5 bg-emerald-50 text-emerald-600 rounded-lg\"><i class=\"fa-solid fa-magnifying-glass-chart text-lg\"></i></span>\n                        Kur'an-ı Kerim Sayfa Düzeni Bileşenleri\n                    </h3>\n                    <p class=\"text-slate-500 text-sm mb-6\">\n                        Basılı veya dijital bir Kur'an-ı Kerim sayfasında yer alan anahtar düzenleyici kavramlar aşağıda listelenmiştir. Dokunarak işlevini gör:\n                    </p>\n                    \n                    <div class=\"grid grid-cols-2 sm:grid-cols-3 gap-3\">\n                        <div onclick=\"gosterBilgi('Sayfa Numarası', 'Sayfanın en üstünde veya en altında yer alan ve okuma sırasını belirleyen sayıdır. Kur\\'an-ı Kerim 604 sayfadır.')\" class=\"cursor-pointer p-4 bg-slate-50 rounded-2xl border border-slate-200/60 hover:bg-emerald-50 hover:border-emerald-300 transition-all text-center\">\n                            <i class=\"fa-solid fa-hashtag text-slate-400 mb-2 block text-lg\"></i>\n                            <span class=\"text-xs font-bold text-slate-800\">Sayfa Numarası</span>\n                        </div>\n                        <div onclick=\"gosterBilgi('Cüz Numarası', 'Sayfanın hangi 20 sayfalık bölüme (cüz) ait olduğunu gösteren numaradır.')\" class=\"cursor-pointer p-4 bg-slate-50 rounded-2xl border border-slate-200/60 hover:bg-emerald-50 hover:border-emerald-300 transition-all text-center\">\n                            <i class=\"fa-solid fa-book-open text-slate-400 mb-2 block text-lg\"></i>\n                            <span class=\"text-xs font-bold text-slate-800\">Cüz Numarası</span>\n                        </div>\n                        <div onclick=\"gosterBilgi('Hizip Numarası', 'Sayfanın hangi 5 sayfalık bölüme (hizip) ait olduğunu gösteren özel işaretli numaradır.')\" class=\"cursor-pointer p-4 bg-slate-50 rounded-2xl border border-slate-200/60 hover:bg-emerald-50 hover:border-emerald-300 transition-all text-center\">\n                            <i class=\"fa-solid fa-bookmark text-slate-400 mb-2 block text-lg\"></i>\n                            <span class=\"text-xs font-bold text-slate-800\">Hizip Numarası</span>\n                        </div>\n                        <div onclick=\"gosterBilgi('Sure Adı', 'Sayfada başlayan veya devam eden surenin ismidir. (Örn: Fatiha Suresi)')\" class=\"cursor-pointer p-4 bg-slate-50 rounded-2xl border border-slate-200/60 hover:bg-emerald-50 hover:border-emerald-300 transition-all text-center\">\n                            <i class=\"fa-solid fa-align-left text-slate-400 mb-2 block text-lg\"></i>\n                            <span class=\"text-xs font-bold text-slate-800\">Sure Adı</span>\n                        </div>\n                        <div onclick=\"gosterBilgi('Surenin İndirildiği Dönem', 'Surenin Mekke\\'de mi (Mekki) yoksa Medine\\'de mi (Medeni) indirildiğini belirten ifadedir.')\" class=\"cursor-pointer p-4 bg-slate-50 rounded-2xl border border-slate-200/60 hover:bg-emerald-50 hover:border-emerald-300 transition-all text-center\">\n                            <i class=\"fa-solid fa-calendar-day text-slate-400 mb-2 block text-lg\"></i>\n                            <span class=\"text-xs font-bold text-slate-800\">İndirildiği Dönem</span>\n                        </div>\n                        <div onclick=\"gosterBilgi('Surenin Ayet Sayısı', 'Sure başlığında o surenin toplam kaç ayetten oluştuğunu gösteren rakamdır.')\" class=\"cursor-pointer p-4 bg-slate-50 rounded-2xl border border-slate-200/60 hover:bg-emerald-50 hover:border-emerald-300 transition-all text-center\">\n                            <i class=\"fa-solid fa-list-ol text-slate-400 mb-2 block text-lg\"></i>\n                            <span class=\"text-xs font-bold text-slate-800\">Surenin Ayet Sayısı</span>\n                        </div>\n                        <div onclick=\"gosterBilgi('Besmele', 'Surelerin başında yer alan \\'Bismillahirrahmanirrahim\\' (Rahman ve Rahim olan Allah\\'ın adıyla) cümlesidir.')\" class=\"cursor-pointer p-4 bg-slate-50 rounded-2xl border border-slate-200/60 hover:bg-emerald-50 hover:border-emerald-300 transition-all text-center col-span-1\">\n                            <i class=\"fa-solid fa-pen-nib text-slate-400 mb-2 block text-lg\"></i>\n                            <span class=\"text-xs font-bold text-slate-800\">Besmele</span>\n                        </div>\n                        <div onclick=\"gosterBilgi('Ayet Durağı', 'Ayetlerin bittiğini ve diğer ayetin başladığını belirten yuvarlak, süslü özel işaretlerdir.')\" class=\"cursor-pointer p-4 bg-slate-50 rounded-2xl border border-slate-200/60 hover:bg-emerald-50 hover:border-emerald-300 transition-all text-center col-span-2\">\n                            <i class=\"fa-regular fa-circle-dot text-slate-400 mb-2 block text-lg\"></i>\n                            <span class=\"text-xs font-bold text-slate-800\">Ayet Durağı / İşareti</span>\n                        </div>\n                    </div>\n                </div>\n\n                <!-- Dinamik Bilgi Paneli -->\n                <div id=\"bilgiPaneli\" class=\"mt-6 p-4 bg-emerald-900 text-white rounded-2xl hidden transition-all duration-300\">\n                    <h4 id=\"bilgiBaslik\" class=\"font-extrabold text-amber-400 text-sm tracking-wide uppercase\"></h4>\n                    <p id=\"bilgiIcerik\" class=\"text-xs mt-1.5 text-emerald-100 leading-relaxed\"></p>\n                </div>\n            </div>\n\n            <!-- Hz. Peygamber'in Sahabe ile Sohbeti & Hadis-i Şerif -->\n            <div class=\"lg:col-span-4 bg-gradient-to-br from-amber-50 to-amber-100/50 rounded-3xl p-6 sm:p-8 border border-amber-200 flex flex-col justify-between\">\n                <div>\n                    <div class=\"flex items-center space-x-2 text-amber-800 mb-4\">\n                        <i class=\"fa-solid fa-quote-left text-2xl\"></i>\n                        <span class=\"text-xs font-bold uppercase tracking-wider\">Tarihi Hatıra / Sohbet</span>\n                    </div>\n                    <blockquote class=\"text-slate-700 text-sm leading-relaxed mb-6 italic\">\n                        \"Hz. Muhammed (sav), yatsı namazından sonra yanımıza gelir ve bizimle sohbet ederdi. Allah Resulü, bir gece yanımıza biraz geç geldi. 'Gecikmenizin sebebi nedir?' diye kendisine sorduğumuzda o, <strong class=\"text-slate-900\">‘Kur'an'dan her gün okuduğum kadarını (hizbimi) bitirmeden çıkmak istemedim.’</strong> buyurmuştur.\"\n                    </blockquote>\n                </div>\n                <div>\n                    <span class=\"text-[11px] block text-slate-500 font-bold tracking-wider uppercase mb-1\">Ravi (Anlatan):</span>\n                    <div class=\"flex items-center space-x-3 bg-white p-3 rounded-2xl border border-amber-200/80\">\n                        <div class=\"w-8 h-8 rounded-full bg-amber-200 text-amber-800 flex items-center justify-center font-bold text-xs\">EH</div>\n                        <div>\n                            <p class=\"text-xs font-bold text-slate-800\">Evs bin Huzeyfe (ra)</p>\n                            <p class=\"text-[10px] text-slate-400\">Peygamberimizin Sahabesi</p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n\n        <!-- Akılda Kalıcı Sınav İpucu & Osmanlı Geleneği -->\n        <section class=\"bg-gradient-to-r from-emerald-600 to-teal-700 text-white rounded-3xl p-6 sm:p-8 shadow-md grid grid-cols-1 md:grid-cols-12 gap-6 items-center\">\n            <div class=\"md:col-span-8 space-y-3\">\n                <span class=\"bg-emerald-800 text-emerald-200 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest\"><i class=\"fa-solid fa-lightbulb mr-1.5 text-amber-300\"></i> Unutmayalım!</span>\n                <h3 class=\"text-xl sm:text-2xl font-bold\">Osmanlı Dönemi Yazım Geleneği & Sayı Düzeni</h3>\n                <p class=\"text-emerald-100 text-sm leading-relaxed\">\n                    Osmanlı Dönemi'nde yazımı ve basımı gerçekleştirilen Kur'an-ı Kerimlere bu hizipleri ve diğer durakları belirtmek amacıyla özel sanatsal işaretler (güller) konulmuştur. Cüzü oluşturan hiziplerden birincisi, cüz başı olduğu için numaralandırılmaz. Ancak diğer hizipler 2, 3 ve 4 şeklinde yazılır.\n                </p>\n            </div>\n            <div class=\"md:col-span-4 bg-emerald-800/50 backdrop-blur-sm p-5 rounded-2xl border border-emerald-500/30 text-center space-y-2\">\n                <span class=\"text-xs text-emerald-300 uppercase font-bold tracking-wider block\">Toplam Hizip Formülü</span>\n                <div class=\"text-3xl font-extrabold text-amber-300\">30 Cüz × 4 Hizip</div>\n                <div class=\"text-lg font-bold text-white\">= 120 Hizip</div>\n            </div>\n        </section>\n\n        <!-- İnteraktif Etkinlik-1: Öğrenci Açıklamaları Eşleştirme Oyunu -->\n        <section class=\"bg-white rounded-3xl p-6 sm:p-8 border border-slate-100 shadow-sm space-y-6\">\n            <div>\n                <span class=\"text-xs font-bold text-emerald-700 bg-emerald-50 px-3 py-1 rounded-full uppercase\">Akıllı Tahta Etkinliği</span>\n                <h3 class=\"text-xl font-extrabold text-slate-900 mt-2\">Öğrenci Açıklamaları Eşleştirme Oyunu</h3>\n                <p class=\"text-slate-500 text-sm mt-1\">Öğrencilerin konuşma balonlarında tarif ettikleri kavramları bulunuz ve doğru kutuya dokunarak atayınız.</p>\n            </div>\n\n            <!-- Öğrenciler (Sorular) -->\n            <div class=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6\">\n                <!-- Ali -->\n                <div class=\"bg-slate-50 p-5 rounded-2xl border border-slate-200 flex flex-col justify-between space-y-4\">\n                    <div class=\"flex items-center space-x-3\">\n                        <div class=\"w-10 h-10 rounded-full bg-emerald-600 text-white flex items-center justify-center font-bold text-sm\">A</div>\n                        <div>\n                            <h4 class=\"font-bold text-slate-800 text-sm\">Ali</h4>\n                            <p class=\"text-[10px] text-slate-400\">Kur'an Okuyor</p>\n                        </div>\n                    </div>\n                    <p class=\"text-xs text-slate-600 leading-relaxed italic bg-white p-3 rounded-xl border border-slate-100\">\n                        \"Kur’an-ı Kerim’in her cüzünde yer alan beş sayfalık bölümdür.\"\n                    </p>\n                    <div class=\"space-y-1\">\n                        <span class=\"text-[10px] uppercase font-bold text-slate-400 block\">Kavram Seçin:</span>\n                        <select id=\"select-ali\" onchange=\"kontrolEt('ali', 'Hizip')\" class=\"w-full text-xs bg-white border border-slate-300 rounded-lg p-2 focus:ring-emerald-500 focus:border-emerald-500\">\n                            <option value=\"\">Seçiniz...</option>\n                            <option value=\"Ayet\">Ayet</option>\n                            <option value=\"Sure\">Sure</option>\n                            <option value=\"Cüz\">Cüz</option>\n                            <option value=\"Hizip\">Hizip</option>\n                        </select>\n                        <p id=\"sonuc-ali\" class=\"text-[11px] font-bold mt-1 hidden\"></p>\n                    </div>\n                </div>\n\n                <!-- Osman -->\n                <div class=\"bg-slate-50 p-5 rounded-2xl border border-slate-200 flex flex-col justify-between space-y-4\">\n                    <div class=\"flex items-center space-x-3\">\n                        <div class=\"w-10 h-10 rounded-full bg-amber-500 text-white flex items-center justify-center font-bold text-sm\">O</div>\n                        <div>\n                            <h4 class=\"font-bold text-slate-800 text-sm\">Osman</h4>\n                            <p class=\"text-[10px] text-slate-400\">Yazı Yazıyor</p>\n                        </div>\n                    </div>\n                    <p class=\"text-xs text-slate-600 leading-relaxed italic bg-white p-3 rounded-xl border border-slate-100\">\n                        \"Kur’an-ı Kerim’deki sureleri oluşturan kelime ve cümlelerin her biridir.\"\n                    </p>\n                    <div class=\"space-y-1\">\n                        <span class=\"text-[10px] uppercase font-bold text-slate-400 block\">Kavram Seçin:</span>\n                        <select id=\"select-osman\" onchange=\"kontrolEt('osman', 'Ayet')\" class=\"w-full text-xs bg-white border border-slate-300 rounded-lg p-2 focus:ring-emerald-500 focus:border-emerald-500\">\n                            <option value=\"\">Seçiniz...</option>\n                            <option value=\"Ayet\">Ayet</option>\n                            <option value=\"Sure\">Sure</option>\n                            <option value=\"Cüz\">Cüz</option>\n                            <option value=\"Hizip\">Hizip</option>\n                        </select>\n                        <p id=\"sonuc-osman\" class=\"text-[11px] font-bold mt-1 hidden\"></p>\n                    </div>\n                </div>\n\n                <!-- Sevim -->\n                <div class=\"bg-slate-50 p-5 rounded-2xl border border-slate-200 flex flex-col justify-between space-y-4\">\n                    <div class=\"flex items-center space-x-3\">\n                        <div class=\"w-10 h-10 rounded-full bg-pink-500 text-white flex items-center justify-center font-bold text-sm\">S</div>\n                        <div>\n                            <h4 class=\"font-bold text-slate-800 text-sm\">Sevim</h4>\n                            <p class=\"text-[10px] text-slate-400\">İnceleme Yapıyor</p>\n                        </div>\n                    </div>\n                    <p class=\"text-xs text-slate-600 leading-relaxed italic bg-white p-3 rounded-xl border border-slate-100\">\n                        \"Kur’an-ı Kerim’in yüz on dört bölümünden her biridir.\"\n                    </p>\n                    <div class=\"space-y-1\">\n                        <span class=\"text-[10px] uppercase font-bold text-slate-400 block\">Kavram Seçin:</span>\n                        <select id=\"select-sevim\" onchange=\"kontrolEt('sevim', 'Sure')\" class=\"w-full text-xs bg-white border border-slate-300 rounded-lg p-2 focus:ring-emerald-500 focus:border-emerald-500\">\n                            <option value=\"\">Seçiniz...</option>\n                            <option value=\"Ayet\">Ayet</option>\n                            <option value=\"Sure\">Sure</option>\n                            <option value=\"Cüz\">Cüz</option>\n                            <option value=\"Hizip\">Hizip</option>\n                        </select>\n                        <p id=\"sonuc-sevim\" class=\"text-[11px] font-bold mt-1 hidden\"></p>\n                    </div>\n                </div>\n\n                <!-- Zeynep -->\n                <div class=\"bg-slate-50 p-5 rounded-2xl border border-slate-200 flex flex-col justify-between space-y-4\">\n                    <div class=\"flex items-center space-x-3\">\n                        <div class=\"w-10 h-10 rounded-full bg-sky-500 text-white flex items-center justify-center font-bold text-sm\">Z</div>\n                        <div>\n                            <h4 class=\"font-bold text-slate-800 text-sm\">Zeynep</h4>\n                            <p class=\"text-[10px] text-slate-400\">Ezber Yapıyor</p>\n                        </div>\n                    </div>\n                    <p class=\"text-xs text-slate-600 leading-relaxed italic bg-white p-3 rounded-xl border border-slate-100\">\n                        \"Kur’an-ı Kerim’in otuz bölümünden her biridir.\"\n                    </p>\n                    <div class=\"space-y-1\">\n                        <span class=\"text-[10px] uppercase font-bold text-slate-400 block\">Kavram Seçin:</span>\n                        <select id=\"select-zeynep\" onchange=\"kontrolEt('zeynep', 'Cüz')\" class=\"w-full text-xs bg-white border border-slate-300 rounded-lg p-2 focus:ring-emerald-500 focus:border-emerald-500\">\n                            <option value=\"\">Seçiniz...</option>\n                            <option value=\"Ayet\">Ayet</option>\n                            <option value=\"Sure\">Sure</option>\n                            <option value=\"Cüz\">Cüz</option>\n                            <option value=\"Hizip\">Hizip</option>\n                        </select>\n                        <p id=\"sonuc-zeynep\" class=\"text-[11px] font-bold mt-1 hidden\"></p>\n                    </div>\n                </div>\n            </div>\n        </section>\n\n        <!-- Akıllı Tahta Hızlı Sınav / Kontrol Noktası -->\n        <section class=\"bg-white rounded-3xl p-6 sm:p-8 border border-slate-100 shadow-sm space-y-6\">\n            <div class=\"flex items-center justify-between border-b border-slate-100 pb-4\">\n                <div>\n                    <span class=\"text-xs font-bold text-amber-700 bg-amber-50 px-3 py-1 rounded-full uppercase\">Akıllı Tahta Bulmacası</span>\n                    <h3 class=\"text-xl font-extrabold text-slate-900 mt-2\">Kontrol Noktası Soruları</h3>\n                </div>\n                <button onclick=\"resetSoruGosterimi()\" class=\"text-xs text-slate-400 hover:text-emerald-600 font-semibold\"><i class=\"fa-solid fa-rotate-left mr-1\"></i> Temizle</button>\n            </div>\n\n            <div class=\"grid grid-cols-1 lg:grid-cols-2 gap-8\">\n                <!-- Yukarıdan Aşağıya -->\n                <div class=\"space-y-4\">\n                    <h4 class=\"font-extrabold text-slate-800 text-sm tracking-wider uppercase border-l-4 border-amber-500 pl-2\">Yukarıdan Aşağıya</h4>\n                    \n                    <div class=\"space-y-2\">\n                        <!-- Soru 1 -->\n                        <div class=\"bg-slate-50 p-4 rounded-2xl border border-slate-200/60 flex items-center justify-between\">\n                            <div class=\"text-xs text-slate-700 font-medium pr-2\">\n                                <span class=\"font-bold text-slate-900 mr-1\">1.</span> Kur'an-ı Kerim'deki sure sayısı kaçtır?\n                            </div>\n                            <button onclick=\"toggleCevap('c1', '114')\" id=\"btn-c1\" class=\"text-xs bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-1.5 px-3 rounded-lg shrink-0\">Cevabı Gör</button>\n                        </div>\n                        <!-- Soru 3 -->\n                        <div class=\"bg-slate-50 p-4 rounded-2xl border border-slate-200/60 flex items-center justify-between\">\n                            <div class=\"text-xs text-slate-700 font-medium pr-2\">\n                                <span class=\"font-bold text-slate-900 mr-1\">3.</span> Her cüzde bulunan dört bölümden her birine ne ad verilir?\n                            </div>\n                            <button onclick=\"toggleCevap('c3', 'Hizip')\" id=\"btn-c3\" class=\"text-xs bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-1.5 px-3 rounded-lg shrink-0\">Cevabı Gör</button>\n                        </div>\n                        <!-- Soru 4 -->\n                        <div class=\"bg-slate-50 p-4 rounded-2xl border border-slate-200/60 flex items-center justify-between\">\n                            <div class=\"text-xs text-slate-700 font-medium pr-2\">\n                                <span class=\"font-bold text-slate-900 mr-1\">4.</span> Ayet bitimini ifade eden süslü daire işarete ne ad verilir?\n                            </div>\n                            <button onclick=\"toggleCevap('c4', 'Ayet Durağı')\" id=\"btn-c4\" class=\"text-xs bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-1.5 px-3 rounded-lg shrink-0\">Cevabı Gör</button>\n                        </div>\n                        <!-- Soru 7 -->\n                        <div class=\"bg-slate-50 p-4 rounded-2xl border border-slate-200/60 flex items-center justify-between\">\n                            <div class=\"text-xs text-slate-700 font-medium pr-2\">\n                                <span class=\"font-bold text-slate-900 mr-1\">7.</span> Başı ve sonu belli olan, farklı sayılarda ayetler içeren Kur'an bölümleri?\n                            </div>\n                            <button onclick=\"toggleCevap('c7', 'Sure')\" id=\"btn-c7\" class=\"text-xs bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-1.5 px-3 rounded-lg shrink-0\">Cevabı Gör</button>\n                        </div>\n                    </div>\n                </div>\n\n                <!-- Soldan Sağa -->\n                <div class=\"space-y-4\">\n                    <h4 class=\"font-extrabold text-slate-800 text-sm tracking-wider uppercase border-l-4 border-emerald-500 pl-2\">Soldan Sağa</h4>\n                    \n                    <div class=\"space-y-2\">\n                        <!-- Soru 2 -->\n                        <div class=\"bg-slate-50 p-4 rounded-2xl border border-slate-200/60 flex items-center justify-between\">\n                            <div class=\"text-xs text-slate-700 font-medium pr-2\">\n                                <span class=\"font-bold text-slate-900 mr-1\">2.</span> Kur'an-ı Kerim'in yirmi sayfadan oluşan her bir bölümü?\n                            </div>\n                            <button onclick=\"toggleCevap('c2', 'Cüz')\" id=\"btn-c2\" class=\"text-xs bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-1.5 px-3 rounded-lg shrink-0\">Cevabı Gör</button>\n                        </div>\n                        <!-- Soru 5 -->\n                        <div class=\"bg-slate-50 p-4 rounded-2xl border border-slate-200/60 flex items-center justify-between\">\n                            <div class=\"text-xs text-slate-700 font-medium pr-2\">\n                                <span class=\"font-bold text-slate-900 mr-1\">5.</span> Hz. Muhammed'e (sav) gönderilen ilahi kitabın adı nedir?\n                            </div>\n                            <button onclick=\"toggleCevap('c5', 'Kur\\'an-ı Kerim')\" id=\"btn-c5\" class=\"text-xs bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-1.5 px-3 rounded-lg shrink-0\">Cevabı Gör</button>\n                        </div>\n                        <!-- Soru 6 -->\n                        <div class=\"bg-slate-50 p-4 rounded-2xl border border-slate-200/60 flex items-center justify-between\">\n                            <div class=\"text-xs text-slate-700 font-medium pr-2\">\n                                <span class=\"font-bold text-slate-900 mr-1\">6.</span> Kur'an-ı Kerim'deki surelerin her bir cümlesine ne denir?\n                            </div>\n                            <button onclick=\"toggleCevap('c6', 'Ayet')\" id=\"btn-c6\" class=\"text-xs bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-1.5 px-3 rounded-lg shrink-0\">Cevabı Gör</button>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n    </main>\n\n    <!-- Alt Bilgi / Footer -->\n    <footer class=\"bg-white border-t border-slate-200 mt-12 py-8\">\n        <div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-500 space-y-4 sm:space-y-0\">\n            <div class=\"flex items-center space-x-2\">\n                <span class=\"font-bold text-emerald-700\">Milli Eğitim Bakanlığı (MEB) Müfredatı</span>\n                <span>•</span>\n                <span>Din Kültürü ve Ahlak Bilgisi Eğitim Tasarımı</span>\n            </div>\n            <p>© Kur'an-ı Kerim Dersi İnteraktif Akıllı Tahta Materyali</p>\n        </div>\n    </footer>\n\n    <!-- JS Mantık / Etkinlik Kontrolleri -->\n    <script>\n        // Keşif Aracı Fonksiyonu\n        function gosterBilgi(baslik, icerik) {\n            const panel = document.getElementById('bilgiPaneli');\n            const baslikElem = document.getElementById('bilgiBaslik');\n            const icerikElem = document.getElementById('bilgiIcerik');\n            \n            baslikElem.innerText = baslik;\n            icerikElem.innerText = icerik;\n            \n            panel.classList.remove('hidden');\n            panel.classList.add('animate-fadeIn');\n        }\n\n        // Eşleştirme Oyunu Kontrolü\n        function kontrolEt(ogrenci, dogruCevap) {\n            const selectBox = document.getElementById('select-' + ogrenci);\n            const sonucText = document.getElementById('sonuc-' + ogrenci);\n            const secilen = selectBox.value;\n\n            if (secilen === \"\") {\n                sonucText.classList.add('hidden');\n                return;\n            }\n\n            sonucText.classList.remove('hidden');\n            if (secilen === dogruCevap) {\n                sonucText.innerText = \"✓ Doğru Eşleşti!\";\n                sonucText.className = \"text-[11px] font-bold mt-1 text-emerald-600\";\n                selectBox.className = \"w-full text-xs bg-emerald-50 border border-emerald-400 rounded-lg p-2 focus:ring-emerald-500 focus:border-emerald-500\";\n            } else {\n                sonucText.innerText = \"✗ Tekrar Deneyin.\";\n                sonucText.className = \"text-[11px] font-bold mt-1 text-red-500\";\n                selectBox.className = \"w-full text-xs bg-red-50 border border-red-300 rounded-lg p-2 focus:ring-red-500 focus:border-red-500\";\n            }\n        }\n\n        // Akıllı Tahta Soru Göster/Gizle Fonksiyonu\n        function toggleCevap(id, cevap) {\n            const btn = document.getElementById('btn-' + id);\n            if (btn.innerText === \"Cevabı Gör\") {\n                btn.innerText = cevap;\n                btn.className = \"text-xs bg-amber-500 text-slate-900 font-extrabold py-1.5 px-3 rounded-lg shrink-0 shadow-sm\";\n            } else {\n                btn.innerText = \"Cevabı Gör\";\n                btn.className = \"text-xs bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-1.5 px-3 rounded-lg shrink-0\";\n            }\n        }\n\n        // Tüm Soruları Resetleme\n        function resetSoruGosterimi() {\n            const buttons = document.querySelectorAll(\"[id^='btn-c']\");\n            buttons.forEach(btn => {\n                btn.innerText = \"Cevabı Gör\";\n                btn.className = \"text-xs bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-1.5 px-3 rounded-lg shrink-0\";\n            });\n        }\n    </script>\n</body>\n</html>",
  "updatedAt": "2026-09-17T15:33:25.483Z"
}