{
  "htmlContent": "<!DOCTYPE html>\n<html lang=\"tr\" class=\"h-full bg-slate-50\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>İman Bakımından İnsanlar - MEB 6. Sınıf TDB</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css\">\n    <link href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Amiri:wght@400;700&display=swap\" rel=\"stylesheet\">\n    <style>\n        body { font-family: 'Plus Jakarta Sans', sans-serif; }\n        .font-arabic { font-family: 'Amiri', serif; }\n        .tab-btn.active {\n            background-color: #0d9488;\n            color: white;\n            box-shadow: 0 10px 15px -3px rgba(13, 148, 136, 0.3);\n        }\n    </style>\n</head>\n<body class=\"h-full flex flex-col text-slate-800 antialiased selection:bg-teal-500 selection:text-white\">\n\n    <!-- HEADER / BAŞLIK -->\n    <header class=\"bg-gradient-to-r from-emerald-800 via-teal-700 to-cyan-800 text-white shadow-xl shrink-0\">\n        <div class=\"max-w-7xl mx-auto px-4 py-4 sm:px-6 lg:px-8\">\n            <div class=\"flex flex-wrap items-center justify-between gap-4\">\n                <div class=\"flex items-center gap-3\">\n                    <div class=\"bg-white/10 p-3 rounded-2xl backdrop-blur-md border border-white/20\">\n                        <i class=\"fa-solid font-book-quran text-3xl text-teal-200\"></i>\n                    </div>\n                    <div>\n                        <div class=\"flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-teal-200\">\n                            <span>6. SINIF</span> • <span>TEMEL DİNİ BİLGİLER</span> • <span>1. ÜNİTE: İMAN VE İNSAN</span>\n                        </div>\n                        <h1 class=\"text-2xl sm:text-3xl font-extrabold tracking-tight\">4. İman Bakımından İnsanlar</h1>\n                    </div>\n                </div>\n                <div class=\"flex items-center gap-2 bg-emerald-900/50 backdrop-blur-md px-4 py-2 rounded-xl border border-emerald-500/30 text-sm\">\n                    <i class=\"fa-solid fa-desktop text-emerald-400\"></i>\n                    <span class=\"font-medium text-emerald-100\">Akıllı Tahta İntro Etkileşim Modu</span>\n                </div>\n            </div>\n        </div>\n    </header>\n\n    <!-- ANA İÇERİK (TAB SİSTEMİ) -->\n    <main class=\"flex-1 max-w-7xl w-full mx-auto px-4 py-6 sm:px-6 lg:px-8 flex flex-col gap-6\">\n\n        <!-- KAZANIM MADDELERİ & GİRİŞ AYETİ KARTI -->\n        <section class=\"bg-white rounded-3xl p-5 sm:p-6 shadow-sm border border-slate-200/80\">\n            <div class=\"grid md:grid-cols-3 gap-6 items-center\">\n                <div class=\"md:col-span-1 space-y-3\">\n                    <div class=\"inline-flex items-center gap-2 px-3 py-1 bg-amber-100 text-amber-800 rounded-full text-xs font-bold\">\n                        <i class=\"fa-solid fa-bullseye\"></i> Temel İlke & Kazanım\n                    </div>\n                    <h2 class=\"text-xl font-bold text-slate-900\">İnanç Özgürlüğü ve Sınıflandırma</h2>\n                    <p class=\"text-sm text-slate-600 leading-relaxed\">\n                        Allah (cc) insanları inanma konusunda **serbest bıraktığı** için, Kur'an-ı Kerim'de insanlar tutum ve davranışlarına göre sınıflandırılmıştır.\n                    </p>\n                </div>\n                <div class=\"md:col-span-2 bg-gradient-to-br from-amber-50 to-orange-50 border border-amber-200 rounded-2xl p-4 sm:p-5 relative\">\n                    <i class=\"fa-solid fa-quote-left absolute right-4 bottom-4 text-4xl text-amber-200/60\"></i>\n                    <div class=\"flex items-center gap-2 text-amber-900 font-bold text-sm mb-2\">\n                        <i class=\"fa-solid fa-book-open\"></i> Yunus Suresi, 108. Ayet (Kehf 29 İle Birlikte)\n                    </div>\n                    <p class=\"text-slate-800 italic text-base sm:text-lg font-medium leading-relaxed\">\n                        “De ki: Ey insanlar, size Rabbinizden gerçek (Kur’an) gelmiştir. Artık kim doğru yola girerse ancak kendisi için girer. Kim de saparsa ancak kendi aleyhine sapar...”\n                    </p>\n                </div>\n            </div>\n        </section>\n\n        <!-- SEKMELER (NAVIGASYON) -->\n        <nav class=\"flex flex-wrap gap-2 p-1.5 bg-slate-200/70 rounded-2xl\">\n            <button onclick=\"switchTab('mumin')\" id=\"btn-mumin\" class=\"tab-btn active flex-1 min-w-[120px] py-3 px-4 rounded-xl text-sm font-bold transition-all flex items-center justify-center gap-2\">\n                <i class=\"fa-solid fa-heart\"></i> Mümin\n            </button>\n            <button onclick=\"switchTab('kafir')\" id=\"btn-kafir\" class=\"tab-btn bg-white/50 text-slate-700 hover:bg-white flex-1 min-w-[120px] py-3 px-4 rounded-xl text-sm font-bold transition-all flex items-center justify-center gap-2\">\n                <i class=\"fa-solid fa-ban\"></i> Kâfir\n            </button>\n            <button onclick=\"switchTab('munafik')\" id=\"btn-munafik\" class=\"tab-btn bg-white/50 text-slate-700 hover:bg-white flex-1 min-w-[120px] py-3 px-4 rounded-xl text-sm font-bold transition-all flex items-center justify-center gap-2\">\n                <i class=\"fa-solid fa-mask\"></i> Münafık\n            </button>\n            <button onclick=\"switchTab('musrik')\" id=\"btn-musrik\" class=\"tab-btn bg-white/50 text-slate-700 hover:bg-white flex-1 min-w-[120px] py-3 px-4 rounded-xl text-sm font-bold transition-all flex items-center justify-center gap-2\">\n                <i class=\"fa-solid fa-object-ungroup\"></i> Müşrik & Ehlikitap\n            </button>\n            <button onclick=\"switchTab('etkilesim')\" id=\"btn-etkilesim\" class=\"tab-btn bg-emerald-100 text-emerald-900 hover:bg-emerald-200 flex-1 min-w-[120px] py-3 px-4 rounded-xl text-sm font-bold transition-all flex items-center justify-center gap-2 border border-emerald-300\">\n                <i class=\"fa-solid fa-gamepad\"></i> Akıllı Tahta Etkinliği\n            </button>\n        </nav>\n\n        <!-- TAB İÇERİKLERİ -->\n\n        <!-- TAB 1: MÜMİN -->\n        <div id=\"tab-mumin\" class=\"tab-content space-y-6\">\n            <div class=\"grid lg:grid-cols-12 gap-6\">\n                <!-- Sol Kolon: Tanım ve Özellikler -->\n                <div class=\"lg:col-span-7 bg-white rounded-3xl p-6 shadow-sm border border-slate-200 flex flex-col justify-between\">\n                    <div>\n                        <div class=\"flex items-center gap-3 mb-4\">\n                            <span class=\"w-12 h-12 rounded-2xl bg-emerald-100 text-emerald-700 flex items-center justify-center text-xl font-bold\">\n                                <i class=\"fa-solid fa-heart\"></i>\n                            </span>\n                            <div>\n                                <h3 class=\"text-2xl font-extrabold text-slate-900\">Mümin Kimdir?</h3>\n                                <p class=\"text-xs font-semibold text-emerald-600 uppercase tracking-wide\">İnanan ve Güven Veren İnsan</p>\n                            </div>\n                        </div>\n\n                        <!-- Sözlük ve Dinî Terim Tanımları -->\n                        <div class=\"grid sm:grid-cols-2 gap-3 mb-6\">\n                            <div class=\"bg-emerald-50/60 p-4 rounded-2xl border border-emerald-100\">\n                                <span class=\"text-xs font-bold text-emerald-800 uppercase block mb-1\">📖 Sözlük Anlamı</span>\n                                <p class=\"text-sm text-slate-700 font-medium\">İman eden, gönülden bağlanan, güven veren, güvene kavuşturan kimse.</p>\n                            </div>\n                            <div class=\"bg-teal-50/60 p-4 rounded-2xl border border-teal-100\">\n                                <span class=\"text-xs font-bold text-teal-800 uppercase block mb-1\">🕌 Dinî Terim Anlamı</span>\n                                <p class=\"text-sm text-slate-700 font-medium\">Allah katından peygamberler aracılığıyla gelen her şeyi tereddütsüz doğrulayan ve kabul eden kişi.</p>\n                            </div>\n                        </div>\n\n                        <h4 class=\"font-bold text-slate-900 mb-3 flex items-center gap-2\">\n                            <i class=\"fa-solid fa-check-double text-emerald-600\"></i> Müminin Temel Özellikleri:\n                        </h4>\n                        <ul class=\"space-y-2.5 text-sm text-slate-700 font-medium\">\n                            <li class=\"flex items-start gap-2.5 bg-slate-50 p-2.5 rounded-xl border border-slate-100\">\n                                <i class=\"fa-solid fa-circle-check text-emerald-500 mt-1\"></i>\n                                <span>Allah’a (cc) ve Hz. Muhammed’in (sav) Allah’tan getirdiği emir ve yasaklara itaat eder.</span>\n                            </li>\n                            <li class=\"flex items-start gap-2.5 bg-slate-50 p-2.5 rounded-xl border border-slate-100\">\n                                <i class=\"fa-solid fa-circle-check text-emerald-500 mt-1\"></i>\n                                <span>Allah’a ve ilkelerine bağlı kalacağına söz verir, yaşadığı sürece bu söze bağlı kalır.</span>\n                            </li>\n                            <li class=\"flex items-start gap-2.5 bg-slate-50 p-2.5 rounded-xl border border-slate-100\">\n                                <i class=\"fa-solid fa-circle-check text-emerald-500 mt-1\"></i>\n                                <span>Sorumluluklarının bilincindedir; bu bilinç onu amaçsız yaşamaktan kurtarır.</span>\n                            </li>\n                            <li class=\"flex items-start gap-2.5 bg-slate-50 p-2.5 rounded-xl border border-slate-100\">\n                                <i class=\"fa-solid fa-circle-check text-emerald-500 mt-1\"></i>\n                                <span>Yaşı ne olursa olsun vatanına ve milletine faydalı olacak işler, fikir ve eserler ortaya koymaya çalışır.</span>\n                            </li>\n                        </ul>\n                    </div>\n\n                    <div class=\"mt-6 pt-4 border-t border-slate-100 bg-amber-50/80 p-3.5 rounded-2xl border border-amber-200/60 flex items-center gap-3\">\n                        <span class=\"text-2xl\">💡</span>\n                        <p class=\"text-xs text-amber-900 font-semibold\">\n                            <strong>Görsel Özet:</strong> Mümin yararlı işler yapan, çevresine değer katan kişidir.\n                        </p>\n                    </div>\n                </div>\n\n                <!-- Sağ Kolon: Hadis-i Şerif Benzetmeleri -->\n                <div class=\"lg:col-span-5 bg-gradient-to-b from-slate-900 to-emerald-950 text-white rounded-3xl p-6 shadow-md flex flex-col justify-between\">\n                    <div>\n                        <div class=\"flex items-center gap-2 text-emerald-400 font-bold text-sm uppercase mb-4\">\n                            <i class=\"fa-solid fa-quote-left\"></i> Hz. Muhammed'in (sav) Mümin Benzetmeleri\n                        </div>\n\n                        <div class=\"space-y-3.5\">\n                            <div class=\"bg-white/10 p-3.5 rounded-2xl backdrop-blur-sm border border-white/10 hover:border-emerald-400/50 transition-all\">\n                                <div class=\"flex items-center gap-2 font-bold text-amber-300 text-sm mb-1\">\n                                    <i class=\"fa-solid fa-bee\"></i> 1. Bal Arısı Benzetmesi\n                                </div>\n                                <p class=\"text-xs leading-relaxed text-slate-200 italic\">\n                                    “Mümin bal arısına benzer; güzel şeyler yer, güzel şeyler üretir, (güzel yerlere) konar, (konduğu yeri de) kırmaz ve bozmaz.” <span class=\"text-emerald-300 font-normal opacity-80\">(Müsned)</span>\n                                </p>\n                            </div>\n\n                            <div class=\"bg-white/10 p-3.5 rounded-2xl backdrop-blur-sm border border-white/10 hover:border-emerald-400/50 transition-all\">\n                                <div class=\"flex items-center gap-2 font-bold text-yellow-300 text-sm mb-1\">\n                                    <i class=\"fa-solid fa-coins\"></i> 2. Altın Parçası Benzetmesi\n                                </div>\n                                <p class=\"text-xs leading-relaxed text-slate-200 italic\">\n                                    “... Mümin altın parçasına benzer, sahibi ona körükle üflese bile değişmez ve azalmaz...” <span class=\"text-emerald-300 font-normal opacity-80\">(Müsned)</span>\n                                </p>\n                            </div>\n\n                            <div class=\"bg-white/10 p-3.5 rounded-2xl backdrop-blur-sm border border-white/10 hover:border-emerald-400/50 transition-all\">\n                                <div class=\"flex items-center gap-2 font-bold text-emerald-300 text-sm mb-1\">\n                                    <i class=\"fa-solid fa-tree\"></i> 3. Hurma Ağacı Benzetmesi\n                                </div>\n                                <p class=\"text-xs leading-relaxed text-slate-200 italic\">\n                                    “Mümin hurma ağacına benzer. Her zaman meyve verir ve yaprakları da hiçbir zaman dökülmez.” <span class=\"text-emerald-300 font-normal opacity-80\">(Buhari)</span>\n                                </p>\n                            </div>\n\n                            <div class=\"bg-white/10 p-3.5 rounded-2xl backdrop-blur-sm border border-white/10 hover:border-emerald-400/50 transition-all\">\n                                <div class=\"flex items-center gap-2 font-bold text-green-300 text-sm mb-1\">\n                                    <i class=\"fa-solid fa-wheat-awn\"></i> 4. Yeşil Ekin Benzetmesi\n                                </div>\n                                <p class=\"text-xs leading-relaxed text-slate-200 italic\">\n                                    “Mümin yeşil ekine benzer. Rüzgârla eğilir (fakat yıkılmaz). Rüzgâr sakinleştiğinde yine doğrulur...” <span class=\"text-emerald-300 font-normal opacity-80\">(Buhari)</span>\n                                </p>\n                            </div>\n                        </div>\n                    </div>\n\n                    <div class=\"mt-4 pt-3 border-t border-white/10 text-center\">\n                        <span class=\"text-xs text-emerald-300 font-semibold\">📌 Bu 4 benzetme müminin dirençli, üretken ve faydalı yapısını vurgular.</span>\n                    </div>\n                </div>\n            </div>\n        </div>\n\n        <!-- TAB 2: KÂFİR -->\n        <div id=\"tab-kafir\" class=\"tab-content hidden space-y-6\">\n            <div class=\"bg-white rounded-3xl p-6 shadow-sm border border-slate-200\">\n                <div class=\"flex items-center gap-3 mb-6\">\n                    <span class=\"w-12 h-12 rounded-2xl bg-rose-100 text-rose-700 flex items-center justify-center text-xl font-bold\">\n                        <i class=\"fa-solid fa-ban\"></i>\n                    </span>\n                    <div>\n                        <h3 class=\"text-2xl font-extrabold text-slate-900\">Kâfir Kimdir?</h3>\n                        <p class=\"text-xs font-semibold text-rose-600 uppercase tracking-wide\">İnkâr Eden İnsan</p>\n                    </div>\n                </div>\n\n                <div class=\"grid md:grid-cols-2 gap-6 mb-6\">\n                    <div class=\"space-y-4\">\n                        <div class=\"bg-rose-50/70 p-4 rounded-2xl border border-rose-100\">\n                            <span class=\"text-xs font-bold text-rose-800 uppercase block mb-1\">📖 Sözlük Anlamı</span>\n                            <p class=\"text-sm text-slate-700 font-medium\">Allah’ın (cc) varlığını ve birliğini inkâr eden kimse. Müslüman olmayanlara verilen bir isimdir.</p>\n                        </div>\n                        <div class=\"bg-red-50/70 p-4 rounded-2xl border border-red-100\">\n                            <span class=\"text-xs font-bold text-red-800 uppercase block mb-1\">🕌 Dinî Terim Anlamı</span>\n                            <p class=\"text-sm text-slate-700 font-medium\">Allah’ın varlığını, birliğini ve gönderdiği hükümleri inkâr eden, Allah’ın peygamberlerini ve kitaplarını reddeden kimsedir.</p>\n                        </div>\n                    </div>\n\n                    <!-- Ayet Kutusu -->\n                    <div class=\"bg-gradient-to-br from-slate-900 to-rose-950 text-white p-5 rounded-2xl flex flex-col justify-between\">\n                        <div>\n                            <div class=\"flex items-center gap-2 text-rose-400 font-bold text-xs uppercase mb-2\">\n                                <i class=\"fa-solid fa-book-quran\"></i> Nisa Suresi, 150-151. Ayetler\n                            </div>\n                            <p class=\"text-sm italic text-slate-200 leading-relaxed\">\n                                “Şüphesiz Allah’ı ve peygamberlerini inkâr edenler, Allah’a inanıp peygamberlerine inanmayarak ayrım yapmak isteyenler... işte onlar gerçekten kâfirlerdir…”\n                            </p>\n                        </div>\n                        <span class=\"text-xs text-rose-300 font-semibold mt-3 block\">📌 Allah'a inanıp peygamberleri ayırmak veya reddetmek küfürdür.</span>\n                    </div>\n                </div>\n\n                <!-- UYARI VE UYULMASI GEREKEN HUSUS (ÇOK ÖNEMLİ) -->\n                <div class=\"bg-amber-50 rounded-2xl p-5 border-2 border-amber-300 flex items-start gap-4\">\n                    <div class=\"text-3xl text-amber-600\">\n                        <i class=\"fa-solid fa-triangle-exclamation\"></i>\n                    </div>\n                    <div class=\"space-y-1\">\n                        <h4 class=\"font-extrabold text-amber-950 text-base\">⚠️ Hayati Dinî Kurallar & Sınav İpucu</h4>\n                        <ul class=\"text-sm text-amber-900 space-y-1.5 font-medium\">\n                            <li>• Hz. Muhammed (sav) <strong>“Ben Müslümanım!”</strong> diyen birine “kâfir” denilmesini kesinlikle yasaklamıştır.</li>\n                            <li>• İçerdiği olumsuz anlamdan dolayı müminlere <strong>şaka amaçlı da olsa</strong> kâfir diye hitap edilmez.</li>\n                            <li>• Ancak inkârcı olduğunu açık bir şekilde söyleyen ve davranışlarıyla da bunu gösteren kişi kâfir olarak nitelenir.</li>\n                        </ul>\n                    </div>\n                </div>\n            </div>\n        </div>\n\n        <!-- TAB 3: MÜNAFIK -->\n        <div id=\"tab-munafik\" class=\"tab-content hidden space-y-6\">\n            <div class=\"bg-white rounded-3xl p-6 shadow-sm border border-slate-200\">\n                <div class=\"flex items-center gap-3 mb-6\">\n                    <span class=\"w-12 h-12 rounded-2xl bg-amber-100 text-amber-700 flex items-center justify-center text-xl font-bold\">\n                        <i class=\"fa-solid fa-mask\"></i>\n                    </span>\n                    <div>\n                        <h3 class=\"text-2xl font-extrabold text-slate-900\">Münafık Kimdir?</h3>\n                        <p class=\"text-xs font-semibold text-amber-600 uppercase tracking-wide\">İki Yüzlü Davranan Kişi</p>\n                    </div>\n                </div>\n\n                <div class=\"grid md:grid-cols-2 gap-6 mb-6\">\n                    <div class=\"bg-amber-50/80 p-4 rounded-2xl border border-amber-200\">\n                        <span class=\"text-xs font-bold text-amber-900 uppercase block mb-1\">📖 Sözlük Anlamı</span>\n                        <p class=\"text-sm text-slate-800 font-medium\">İnsanların arasını bozan, toplumu karıştıran, dinî kurallara inanmadığı hâlde inanmış gibi görünen, iki yüzlü kimse.</p>\n                    </div>\n                    <div class=\"bg-yellow-50/80 p-4 rounded-2xl border border-yellow-200\">\n                        <span class=\"text-xs font-bold text-yellow-900 uppercase block mb-1\">🕌 Dinî Terim Anlamı</span>\n                        <p class=\"text-sm text-slate-800 font-medium\">Kalbiyle inanmadığı hâlde diliyle Müslüman olduğunu söyleyen kimsedir. Genellikle Müslüman toplumda kendilerini gizlerler ve menfaatleri gereği inanmış görünürler.</p>\n                    </div>\n                </div>\n\n                <div class=\"grid md:grid-cols-2 gap-6\">\n                    <!-- Münafıkların Özellikleri -->\n                    <div class=\"bg-slate-50 p-5 rounded-2xl border border-slate-200 space-y-3\">\n                        <h4 class=\"font-extrabold text-slate-900 text-base flex items-center gap-2\">\n                            <i class=\"fa-solid fa-list-check text-amber-600\"></i> Münafıkların Kur'an'daki 4 Temel Özelliği:\n                        </h4>\n                        <ul class=\"space-y-2 text-sm font-semibold text-slate-700\">\n                            <li class=\"flex items-center gap-2 bg-white p-2.5 rounded-xl border border-slate-200/60 shadow-sm\">\n                                <span class=\"w-2 h-2 rounded-full bg-amber-500\"></span> Allah’ın (cc) ayetlerini ciddiye almazlar.\n                            </li>\n                            <li class=\"flex items-center gap-2 bg-white p-2.5 rounded-xl border border-slate-200/60 shadow-sm\">\n                                <span class=\"w-2 h-2 rounded-full bg-amber-500\"></span> İslami değerlerle alay ederler.\n                            </li>\n                            <li class=\"flex items-center gap-2 bg-white p-2.5 rounded-xl border border-slate-200/60 shadow-sm\">\n                                <span class=\"w-2 h-2 rounded-full bg-amber-500\"></span> Kişiliklerini açıkça ortaya koymazlar.\n                            </li>\n                            <li class=\"flex items-center gap-2 bg-white p-2.5 rounded-xl border border-slate-200/60 shadow-sm\">\n                                <span class=\"w-2 h-2 rounded-full bg-amber-500\"></span> İnkârcılardan yana tavır sergilerler.\n                            </li>\n                        </ul>\n                    </div>\n\n                    <!-- Hadis & Bakara Ayeti -->\n                    <div class=\"space-y-4\">\n                        <div class=\"bg-gradient-to-r from-amber-900 to-yellow-900 text-white p-4.5 rounded-2xl\">\n                            <div class=\"flex items-center gap-2 text-amber-300 font-bold text-xs uppercase mb-1\">\n                                <i class=\"fa-solid fa-quote-left\"></i> Hadis-i Şerif: Münafığın 3 Alameti (Buhari)\n                            </div>\n                            <p class=\"text-sm font-medium italic text-amber-100\">\n                                “Münafığın alameti üçtür: \n                                <br>1. Konuşunca <strong>yalan söyler</strong>, \n                                <br>2. Söz verince <strong>sözünde durmaz</strong>, \n                                <br>3. Kendisine bir şey emanet edildiğinde <strong>ihanet eder</strong>.”\n                            </p>\n                        </div>\n\n                        <div class=\"bg-slate-100 p-4 rounded-2xl border border-slate-200\">\n                            <span class=\"text-xs font-bold text-slate-500 uppercase block mb-1\">📖 Bakara Suresi 8-9. Ayetler</span>\n                            <p class=\"text-xs text-slate-700 italic\">\n                                “İnsanlardan inanmadıkları hâlde ‘Allah’a ve ahiret gününe inandık.’ diyenler de vardır. Bunlar Allah’ı ve müminleri aldatmaya çalışırlar. Oysa sadece kendilerini aldatırlar da farkında değillerdir.”\n                            </p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n\n        <!-- TAB 4: MÜŞRİK & EHLİKİTAP -->\n        <div id=\"tab-musrik\" class=\"tab-content hidden space-y-6\">\n            <div class=\"grid md:grid-cols-2 gap-6\">\n                <!-- MÜŞRİK KARTI -->\n                <div class=\"bg-white rounded-3xl p-6 shadow-sm border border-slate-200 flex flex-col justify-between\">\n                    <div>\n                        <div class=\"flex items-center gap-3 mb-4\">\n                            <span class=\"w-12 h-12 rounded-2xl bg-indigo-100 text-indigo-700 flex items-center justify-center text-xl font-bold\">\n                                <i class=\"fa-solid fa-object-ungroup\"></i>\n                            </span>\n                            <div>\n                                <h3 class=\"text-2xl font-extrabold text-slate-900\">Müşrik</h3>\n                                <p class=\"text-xs font-semibold text-indigo-600 uppercase tracking-wide\">Allah'a Ortak Koşan</p>\n                            </div>\n                        </div>\n\n                        <div class=\"space-y-3 mb-4\">\n                            <div class=\"bg-indigo-50/70 p-3.5 rounded-2xl border border-indigo-100\">\n                                <span class=\"text-xs font-bold text-indigo-800 uppercase block mb-1\">📖 Sözlük Anlamı</span>\n                                <p class=\"text-xs sm:text-sm text-slate-700 font-medium\">Allah’a (cc) ortak, yardımcı ve eş koşan kimse (Şirk kelimesinden türemiştir).</p>\n                            </div>\n                            <div class=\"bg-slate-50 p-3.5 rounded-2xl border border-slate-100\">\n                                <span class=\"text-xs font-bold text-slate-800 uppercase block mb-1\">🕌 Dinî Tanım & İnancı</span>\n                                <p class=\"text-xs sm:text-sm text-slate-700 font-medium\">\n                                    Allah'a inandığını söylediği hâlde tabiat olaylarının yaratılmasını ve idaresini Allah'ın dışındaki güçlere bağlayan, bunları kutsallaştıran ve ibadetlerini bu güçlerin rızası için yapan kimsedir.\n                                </p>\n                            </div>\n                        </div>\n\n                        <div class=\"bg-indigo-950 text-white p-4 rounded-2xl\">\n                            <div class=\"text-xs text-indigo-300 font-bold mb-1\">📖 Enam Suresi, 102. Ayet</div>\n                            <p class=\"text-xs italic leading-relaxed text-indigo-100\">\n                                “İşte sizin Rabbiniz Allah. O’ndan başka hiçbir ilah yoktur. O her şeyin yaratıcısıdır. Öyle ise O’na kulluk edin...”\n                            </p>\n                        </div>\n                    </div>\n                </div>\n\n                <!-- EHLİKİTAP KARTI -->\n                <div class=\"bg-white rounded-3xl p-6 shadow-sm border border-slate-200 flex flex-col justify-between\">\n                    <div>\n                        <div class=\"flex items-center gap-3 mb-4\">\n                            <span class=\"w-12 h-12 rounded-2xl bg-purple-100 text-purple-700 flex items-center justify-center text-xl font-bold\">\n                                <i class=\"fa-solid fa-book-bible\"></i>\n                            </span>\n                            <div>\n                                <h3 class=\"text-2xl font-extrabold text-slate-900\">Ehlikitap</h3>\n                                <p class=\"text-xs font-semibold text-purple-600 uppercase tracking-wide\">İlahi Kitap Verilmiş Olanlar</p>\n                            </div>\n                        </div>\n\n                        <div class=\"space-y-3 mb-4\">\n                            <div class=\"bg-purple-50/70 p-3.5 rounded-2xl border border-purple-100\">\n                                <span class=\"text-xs font-bold text-purple-800 uppercase block mb-1\">📖 Tanım</span>\n                                <p class=\"text-xs sm:text-sm text-slate-700 font-medium\">\n                                    İlahi bir kitaba inananlar anlamına gelir. Müslümanlar dışında kendilerine ilahi bir kitap gönderilmiş olan **Yahudiler** ve **Hristiyanlar** için kullanılır.\n                                </p>\n                            </div>\n                            <div class=\"bg-slate-50 p-3.5 rounded-2xl border border-slate-100\">\n                                <span class=\"text-xs font-bold text-slate-800 uppercase block mb-1\">💡 Müşriklerden Ayrılma Sebebi</span>\n                                <p class=\"text-xs sm:text-sm text-slate-700 font-medium\">\n                                    Kur'an'dan önceki kitaplar (Tevrat, Zebur, İncil) zamanla asli özelliklerini kaybedip bozulmuştur. Ancak bu kitaplara inanan Yahudileri ve Hristiyanları **müşriklerden ayırmak için** Kur'an'da \"Ehlikitap\" ifadesi kullanılmıştır.\n                                </p>\n                            </div>\n                        </div>\n\n                        <div class=\"bg-purple-950 text-white p-4 rounded-2xl\">\n                            <div class=\"text-xs text-purple-300 font-bold mb-1\">📖 Ortak Çağrı Ayeti</div>\n                            <p class=\"text-xs italic leading-relaxed text-purple-100\">\n                                “De ki: Ey kitap ehli! Bizimle sizin aranızda ortak bir söze gelin. Yalnız Allah’a ibadet edelim. O’na hiçbir şeyi ortak koşmayalım...”\n                            </p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n\n        <!-- TAB 5: AKILLI TAHTA ETKİLEŞİMLİ EŞLEŞTİRME UYGULAMASI -->\n        <div id=\"tab-etkilesim\" class=\"tab-content hidden space-y-6\">\n            <div class=\"bg-white rounded-3xl p-6 shadow-sm border border-slate-200\">\n                <div class=\"text-center max-w-2xl mx-auto mb-6\">\n                    <span class=\"px-3 py-1 bg-emerald-100 text-emerald-800 rounded-full text-xs font-extrabold inline-block mb-2\">\n                        🎮 KİTAPTAKİ \"SIRA SİZDE\" ETKİNLİĞİ\n                    </span>\n                    <h3 class=\"text-2xl font-extrabold text-slate-900\">Kavram Eşleştirme Uygulaması</h3>\n                    <p class=\"text-xs sm:text-sm text-slate-600 mt-1\">\n                        Sol taraftaki kavramı seçip, sağ taraftaki doğru tanımıyla eşleştiriniz!\n                    </p>\n                </div>\n\n                <!-- Eşleştirme Oyunu Alanı -->\n                <div class=\"grid md:grid-cols-2 gap-6 max-w-4xl mx-auto items-center\">\n                    <!-- Sol Kolon: Kavramlar -->\n                    <div class=\"space-y-3\" id=\"left-column\">\n                        <button onclick=\"selectConcept('mumin', this)\" class=\"concept-btn w-full p-4 rounded-2xl border-2 border-slate-200 font-bold text-left transition-all hover:border-teal-500 bg-slate-50 flex items-center justify-between\">\n                            <span>Mümin</span>\n                            <i class=\"fa-solid fa-chevron-right text-slate-400\"></i>\n                        </button>\n                        <button onclick=\"selectConcept('kafir', this)\" class=\"concept-btn w-full p-4 rounded-2xl border-2 border-slate-200 font-bold text-left transition-all hover:border-teal-500 bg-slate-50 flex items-center justify-between\">\n                            <span>Kâfir</span>\n                            <i class=\"fa-solid fa-chevron-right text-slate-400\"></i>\n                        </button>\n                        <button onclick=\"selectConcept('munafik', this)\" class=\"concept-btn w-full p-4 rounded-2xl border-2 border-slate-200 font-bold text-left transition-all hover:border-teal-500 bg-slate-50 flex items-center justify-between\">\n                            <span>Münafık</span>\n                            <i class=\"fa-solid fa-chevron-right text-slate-400\"></i>\n                        </button>\n                        <button onclick=\"selectConcept('musrik', this)\" class=\"concept-btn w-full p-4 rounded-2xl border-2 border-slate-200 font-bold text-left transition-all hover:border-teal-500 bg-slate-50 flex items-center justify-between\">\n                            <span>Müşrik</span>\n                            <i class=\"fa-solid fa-chevron-right text-slate-400\"></i>\n                        </button>\n                        <button onclick=\"selectConcept('ehlikitap', this)\" class=\"concept-btn w-full p-4 rounded-2xl border-2 border-slate-200 font-bold text-left transition-all hover:border-teal-500 bg-slate-50 flex items-center justify-between\">\n                            <span>Ehlikitap</span>\n                            <i class=\"fa-solid fa-chevron-right text-slate-400\"></i>\n                        </button>\n                    </div>\n\n                    <!-- Sağ Kolon: Tanımlar (Karışık Sıralı) -->\n                    <div class=\"space-y-3\" id=\"right-column\">\n                        <button onclick=\"matchDefinition('ehlikitap', this)\" class=\"def-btn w-full p-3.5 rounded-2xl border-2 border-slate-200 text-xs sm:text-sm font-medium text-left transition-all hover:border-teal-500 bg-white\">\n                            Müslümanlar dışındaki Yahudiler ve Hristiyanlar.\n                        </button>\n                        <button onclick=\"matchDefinition('mumin', this)\" class=\"def-btn w-full p-3.5 rounded-2xl border-2 border-slate-200 text-xs sm:text-sm font-medium text-left transition-all hover:border-teal-500 bg-white\">\n                            Allah’a (cc) inanan.\n                        </button>\n                        <button onclick=\"matchDefinition('munafik', this)\" class=\"def-btn w-full p-3.5 rounded-2xl border-2 border-slate-200 text-xs sm:text-sm font-medium text-left transition-all hover:border-teal-500 bg-white\">\n                            İmanda iki yüzlü davranan.\n                        </button>\n                        <button onclick=\"matchDefinition('kafir', this)\" class=\"def-btn w-full p-3.5 rounded-2xl border-2 border-slate-200 text-xs sm:text-sm font-medium text-left transition-all hover:border-teal-500 bg-white\">\n                            İnanmayan, inkâr eden.\n                        </button>\n                        <button onclick=\"matchDefinition('musrik', this)\" class=\"def-btn w-full p-3.5 rounded-2xl border-2 border-slate-200 text-xs sm:text-sm font-medium text-left transition-all hover:border-teal-500 bg-white\">\n                            Allah’a (cc) ortak koşan.\n                        </button>\n                    </div>\n                </div>\n\n                <!-- Sonuç Bildirimi -->\n                <div id=\"quiz-feedback\" class=\"mt-6 text-center text-sm font-bold min-h-[30px]\"></div>\n                <div class=\"text-center mt-2\">\n                    <button onclick=\"resetQuiz()\" class=\"px-5 py-2 bg-slate-800 text-white text-xs font-bold rounded-xl hover:bg-slate-700 transition-all\">\n                        <i class=\"fa-solid fa-rotate-right mr-1\"></i> Sıfırla / Yeniden Başlat\n                    </button>\n                </div>\n            </div>\n        </div>\n\n    </main>\n\n    <!-- ALT BİLGİ / FOOTER -->\n    <footer class=\"bg-slate-900 text-slate-400 text-xs py-4 border-t border-slate-800 shrink-0\">\n        <div class=\"max-w-7xl mx-auto px-4 text-center flex flex-col sm:flex-row items-center justify-between gap-2\">\n            <span>MEB Temel Dini Bilgiler (1. Ünite / 4. Konu) %100 Sadık Ders Materyali</span>\n            <span class=\"text-slate-500\">Akıllı Tahta İnteraktif Özet Görünümü</span>\n        </div>\n    </footer>\n\n    <!-- INTERAKTIF JAVASCRIPT KODU -->\n    <script>\n        // Tab Değiştirme Fonksiyonu\n        function switchTab(tabId) {\n            // Tüm içerikleri gizle\n            document.querySelectorAll('.tab-content').forEach(content => {\n                content.classList.add('hidden');\n            });\n            \n            // Tüm buton pasifleşsin\n            document.querySelectorAll('.tab-btn').forEach(btn => {\n                btn.classList.remove('active');\n                btn.classList.add('bg-white/50', 'text-slate-700');\n            });\n\n            // Seçilen içeriği göster\n            const activeTab = document.getElementById('tab-' + tabId);\n            if(activeTab) activeTab.classList.remove('hidden');\n\n            // Seçilen butonu aktif et\n            const activeBtn = document.getElementById('btn-' + tabId);\n            if(activeBtn) {\n                activeBtn.classList.add('active');\n                activeBtn.classList.remove('bg-white/50', 'text-slate-700');\n            }\n        }\n\n        // Akıllı Tahta Eşleştirme Mantığı\n        let selectedConceptKey = null;\n        let selectedConceptBtn = null;\n        let matchedCount = 0;\n\n        function selectConcept(key, btn) {\n            // Önceki seçim vurgularını kaldır\n            document.querySelectorAll('.concept-btn').forEach(b => {\n                if(!b.disabled) {\n                    b.classList.remove('border-teal-600', 'bg-teal-50', 'ring-2', 'ring-teal-500');\n                    b.classList.add('bg-slate-50');\n                }\n            });\n\n            selectedConceptKey = key;\n            selectedConceptBtn = btn;\n\n            btn.classList.remove('bg-slate-50');\n            btn.classList.add('border-teal-600', 'bg-teal-50', 'ring-2', 'ring-teal-500');\n\n            const feedback = document.getElementById('quiz-feedback');\n            feedback.textContent = \"Şimdi sağ sütundan uygun tanımı seçiniz.\";\n            feedback.className = \"mt-6 text-center text-sm font-bold text-teal-700\";\n        }\n\n        function matchDefinition(key, btn) {\n            const feedback = document.getElementById('quiz-feedback');\n\n            if (!selectedConceptKey) {\n                feedback.textContent = \"Lütfen önce sol taraftan bir kavram seçiniz!\";\n                feedback.className = \"mt-6 text-center text-sm font-bold text-amber-600\";\n                return;\n            }\n\n            if (selectedConceptKey === key) {\n                // Doğru Eşleşme\n                selectedConceptBtn.classList.remove('border-teal-600', 'bg-teal-50', 'ring-2', 'ring-teal-500');\n                selectedConceptBtn.classList.add('bg-emerald-100', 'border-emerald-500', 'text-emerald-900');\n                selectedConceptBtn.disabled = true;\n\n                btn.classList.add('bg-emerald-100', 'border-emerald-500', 'text-emerald-900');\n                btn.disabled = true;\n\n                feedback.textContent = \"✨ Tebrikler! Doğru Eşleştirme.\";\n                feedback.className = \"mt-6 text-center text-sm font-bold text-emerald-600\";\n\n                matchedCount++;\n                selectedConceptKey = null;\n                selectedConceptBtn = null;\n\n                if (matchedCount === 5) {\n                    feedback.textContent = \"🎉 Harika! Tüm kavramları doğru eşleştirdiniz!\";\n                    feedback.className = \"mt-6 text-center text-base font-extrabold text-emerald-700 animate-bounce\";\n                }\n            } else {\n                // Yanlış Eşleşme\n                feedback.textContent = \"❌ Yanlış eşleşme, tekrar deneyiniz!\";\n                feedback.className = \"mt-6 text-center text-sm font-bold text-rose-600\";\n                \n                btn.classList.add('border-rose-400', 'bg-rose-50');\n                setTimeout(() => {\n                    btn.classList.remove('border-rose-400', 'bg-rose-50');\n                }, 1000);\n            }\n        }\n\n        function resetQuiz() {\n            selectedConceptKey = null;\n            selectedConceptBtn = null;\n            matchedCount = 0;\n\n            document.querySelectorAll('.concept-btn').forEach(b => {\n                b.disabled = false;\n                b.className = \"concept-btn w-full p-4 rounded-2xl border-2 border-slate-200 font-bold text-left transition-all hover:border-teal-500 bg-slate-50 flex items-center justify-between\";\n            });\n\n            document.querySelectorAll('.def-btn').forEach(b => {\n                b.disabled = false;\n                b.className = \"def-btn w-full p-3.5 rounded-2xl border-2 border-slate-200 text-xs sm:text-sm font-medium text-left transition-all hover:border-teal-500 bg-white\";\n            });\n\n            const feedback = document.getElementById('quiz-feedback');\n            feedback.textContent = \"\";\n        }\n    </script>\n</body>\n</html>",
