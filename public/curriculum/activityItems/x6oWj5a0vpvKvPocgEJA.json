    "unitId": "14Ox2maDLwQIYSUE3qmd",
    "courseId": "134DwgMfh8VYogm3gDyh",
    "content": {
      "term": "Ömür",
      "definition": "İnsanın doğumundan ölümüne kadar sahip olduğu yaşam süresidir."
    },
    "updatedAt": "2026-09-16T18:36:57.283Z"
  },
  {
    "id": "def_x6oWj5a0vpvKvPocgEJA_1",
    "type": "definition",
    "topicId": "x6oWj5a0vpvKvPocgEJA",
    "unitId": "14Ox2maDLwQIYSUE3qmd",
    "courseId": "134DwgMfh8VYogm3gDyh",
    "content": {
      "term": "Ecel",
      "definition": "Hayatın son bulması için takdir edilen zamanın gelmesidir."
    },
    "updatedAt": "2026-09-16T18:36:57.283Z"
  },
  {
    "id": "def_x6oWj5a0vpvKvPocgEJA_2",
    "type": "definition",
    "topicId": "x6oWj5a0vpvKvPocgEJA",
    "unitId": "14Ox2maDLwQIYSUE3qmd",
    "courseId": "134DwgMfh8VYogm3gDyh",
    "content": {
      "term": "Kıyamet",
      "definition": "Kâinattaki her şeyin son bulması ve insanların diriltileceği zamandır."
    },
    "updatedAt": "2026-09-16T18:36:57.283Z"
  },
  {
    "id": "def_x6oWj5a0vpvKvPocgEJA_3",
    "type": "definition",
    "topicId": "x6oWj5a0vpvKvPocgEJA",
    "unitId": "14Ox2maDLwQIYSUE3qmd",
    "courseId": "134DwgMfh8VYogm3gDyh",
    "content": {
      "term": "Baas",
      "definition": "Sûra ikinci defa üflenmesiyle insanların yeniden diriltilmesidir."
    },
    "updatedAt": "2026-09-16T18:36:57.283Z"
  },
  {
    "id": "def_x6oWj5a0vpvKvPocgEJA_4",
    "type": "definition",
    "topicId": "x6oWj5a0vpvKvPocgEJA",
    "unitId": "14Ox2maDLwQIYSUE3qmd",
    "courseId": "134DwgMfh8VYogm3gDyh",
    "content": {
      "term": "Mahşer",
      "definition": "Diriltilen insanların hesap vermek üzere toplanacakları yerdir."
    },
    "updatedAt": "2026-09-16T18:36:57.283Z"
  },
  {
    "id": "def_x6oWj5a0vpvKvPocgEJA_5",
    "type": "definition",
    "topicId": "x6oWj5a0vpvKvPocgEJA",
    "unitId": "14Ox2maDLwQIYSUE3qmd",
    "courseId": "134DwgMfh8VYogm3gDyh",
    "content": {
      "term": "Amel Defteri",
      "definition": "İnsanların dünya hayatında yaptığı tüm eylemlerin yazıldığı kayıt."
    },
    "updatedAt": "2026-09-16T18:36:57.283Z"
  },
  {
    "id": "def_x6oWj5a0vpvKvPocgEJA_6",
    "type": "definition",
    "topicId": "x6oWj5a0vpvKvPocgEJA",
    "unitId": "14Ox2maDLwQIYSUE3qmd",
    "courseId": "134DwgMfh8VYogm3gDyh",
    "content": {
      "term": "Mizan",
      "definition": "İyilik ve kötülüklerin tartılacağı manevi adalet terazisidir."
    },
    "updatedAt": "2026-09-16T18:36:57.283Z"
  },
  {
    "id": "def_x6oWj5a0vpvKvPocgEJA_7",
    "type": "definition",
    "topicId": "x6oWj5a0vpvKvPocgEJA",
    "unitId": "14Ox2maDLwQIYSUE3qmd",
    "courseId": "134DwgMfh8VYogm3gDyh",
    "content": {
      "term": "Cennet",
      "definition": "Müminlerin ebedî kalacakları ve mükâfatlandırılacakları yerdir."
    },
    "updatedAt": "2026-09-16T18:36:57.283Z"
  },
  {
    "id": "def_x6oWj5a0vpvKvPocgEJA_8",
    "type": "definition",
    "topicId": "x6oWj5a0vpvKvPocgEJA",
    "unitId": "14Ox2maDLwQIYSUE3qmd",
    "courseId": "134DwgMfh8VYogm3gDyh",
    "content": {
      "term": "Cehennem",
      "definition": "İnançsızların ve günahkârların ahirette ceza çekecekleri yerdir."
    },
    "updatedAt": "2026-09-16T18:36:57.283Z"
  },
  {
    "id": "def_x6oWj5a0vpvKvPocgEJA_9",
    "type": "definition",
    "topicId": "x6oWj5a0vpvKvPocgEJA",
    "unitId": "14Ox2maDLwQIYSUE3qmd",
    "courseId": "134DwgMfh8VYogm3gDyh",
    "content": {
      "term": "Berzah",
      "definition": "Dünya ile ahiret hayatı arasındaki kabir alemidir."
    },
    "updatedAt": "2026-09-16T18:36:57.283Z"
  },
  {
    "id": "def_x6oWj5a0vpvKvPocgEJA_10",
    "type": "definition",
    "topicId": "x6oWj5a0vpvKvPocgEJA",
    "unitId": "14Ox2maDLwQIYSUE3qmd",
    "courseId": "134DwgMfh8VYogm3gDyh",
    "content": {
      "term": "İsrafil",
      "definition": "Sûra üflemekle görevli olan büyük meleklerden biridir."
    },
    "updatedAt": "2026-09-16T18:36:57.283Z"
  },
  {
    "id": "def_x6oWj5a0vpvKvPocgEJA_11",
    "type": "definition",
    "topicId": "x6oWj5a0vpvKvPocgEJA",
    "unitId": "14Ox2maDLwQIYSUE3qmd",
    "courseId": "134DwgMfh8VYogm3gDyh",
    "content": {
      "term": "Ahiret",
      "definition": "Dünya hayatının sona ermesiyle başlayan ebedî yaşamdır."
    },
    "updatedAt": "2026-09-16T18:36:57.283Z"
  },
  {
    "id": "sentence_x6oWj5a0vpvKvPocgEJA_0",
    "type": "sentence",
    "topicId": "x6oWj5a0vpvKvPocgEJA",
    "unitId": "14Ox2maDLwQIYSUE3qmd",
    "courseId": "134DwgMfh8VYogm3gDyh",
    "content": {
      "text": "Ölüm insan için bir yok oluş değildir."
    },
    "updatedAt": "2026-09-16T18:36:57.283Z"
  },
  {
    "id": "sentence_x6oWj5a0vpvKvPocgEJA_1",
    "type": "sentence",
    "topicId": "x6oWj5a0vpvKvPocgEJA",
    "unitId": "14Ox2maDLwQIYSUE3qmd",
    "courseId": "134DwgMfh8VYogm3gDyh",
    "content": {
      "text": "Ahirete iman İslam'ın esasları arasında yer alır."
    },
    "updatedAt": "2026-09-16T18:36:57.283Z"
  },
  {
    "id": "sentence_x6oWj5a0vpvKvPocgEJA_2",
    "type": "sentence",
    "topicId": "x6oWj5a0vpvKvPocgEJA",
    "unitId": "14Ox2maDLwQIYSUE3qmd",
    "courseId": "134DwgMfh8VYogm3gDyh",
    "content": {
      "text": "Dünya hayatı geçici ahiret hayatı ise ebedîdir."
    },
    "updatedAt": "2026-09-16T18:36:57.283Z"
  },
  {
    "id": "sentence_x6oWj5a0vpvKvPocgEJA_3",
    "type": "sentence",
    "topicId": "x6oWj5a0vpvKvPocgEJA",
    "unitId": "14Ox2maDLwQIYSUE3qmd",
    "courseId": "134DwgMfh8VYogm3gDyh",
    "content": {
      "text": "Kıyametin ne zaman kopacağını sadece Allah bilir."
    },
    "updatedAt": "2026-09-16T18:36:57.283Z"
  },
  {
    "id": "sentence_x6oWj5a0vpvKvPocgEJA_4",
    "type": "sentence",
    "topicId": "x6oWj5a0vpvKvPocgEJA",
    "unitId": "14Ox2maDLwQIYSUE3qmd",
    "courseId": "134DwgMfh8VYogm3gDyh",
    "content": {
      "text": "İsrafil sura iki defa üfleyecektir."
    },
    "updatedAt": "2026-09-16T18:36:57.283Z"
  },
  {
    "id": "sentence_x6oWj5a0vpvKvPocgEJA_5",
    "type": "sentence",
    "topicId": "x6oWj5a0vpvKvPocgEJA",
    "unitId": "14Ox2maDLwQIYSUE3qmd",
    "courseId": "134DwgMfh8VYogm3gDyh",
    "content": {
      "text": "Mahşer insanların hesap için toplanacağı yerdir."
    },
    "updatedAt": "2026-09-16T18:36:57.283Z"
  },
  {
    "id": "sentence_x6oWj5a0vpvKvPocgEJA_6",
    "type": "sentence",
    "topicId": "x6oWj5a0vpvKvPocgEJA",
    "unitId": "14Ox2maDLwQIYSUE3qmd",
    "courseId": "134DwgMfh8VYogm3gDyh",
    "content": {
      "text": "Her insan dünya hayatında sınava tabi tutulur."
    },
    "updatedAt": "2026-09-16T18:36:57.283Z"
  },
  {
    "id": "sentence_x6oWj5a0vpvKvPocgEJA_7",
    "type": "sentence",
    "topicId": "x6oWj5a0vpvKvPocgEJA",
    "unitId": "14Ox2maDLwQIYSUE3qmd",
    "courseId": "134DwgMfh8VYogm3gDyh",
    "content": {
      "text": "Amel defteri insana dünyadaki yaptıklarını gösterir."
    },
    "updatedAt": "2026-09-16T18:36:57.283Z"
  },
  {
    "id": "sentence_x6oWj5a0vpvKvPocgEJA_8",
    "type": "sentence",
    "topicId": "x6oWj5a0vpvKvPocgEJA",
    "unitId": "14Ox2maDLwQIYSUE3qmd",
    "courseId": "134DwgMfh8VYogm3gDyh",
    "content": {
      "text": "Mizan manevi bir adalet terazisidir."
    },
    "updatedAt": "2026-09-16T18:36:57.283Z"
  },
  {
    "id": "sentence_x6oWj5a0vpvKvPocgEJA_9",
    "type": "sentence",
    "topicId": "x6oWj5a0vpvKvPocgEJA",
    "unitId": "14Ox2maDLwQIYSUE3qmd",
    "courseId": "134DwgMfh8VYogm3gDyh",
    "content": {
      "text": "Müminler ahirette cennet ile mükâfatlandırılır."
    },
    "updatedAt": "2026-09-16T18:36:57.283Z"
  }
]