    },
    "updatedAt": "2026-10-02T16:36:55.487Z"
  },
  {
    "id": "def_O0nU07yfy10AQr7VxBXD_0",
    "type": "definition",
    "topicId": "O0nU07yfy10AQr7VxBXD",
    "unitId": "uu39ahmPymk6HDQWksah",
    "courseId": "jBx7iE5eK5eFQRvCU008",
    "content": {
      "term": "Esmayıhüsna",
      "definition": "Yüce Allah'ın en güzel isimlerinin genel adıdır."
    },
    "updatedAt": "2026-10-02T16:36:55.487Z"
  },
  {
    "id": "def_O0nU07yfy10AQr7VxBXD_1",
    "type": "definition",
    "topicId": "O0nU07yfy10AQr7VxBXD",
    "unitId": "uu39ahmPymk6HDQWksah",
    "courseId": "jBx7iE5eK5eFQRvCU008",
    "content": {
      "term": "Hâdi",
      "definition": "İnsanlara doğru yolu gösteren, rehberlik eden, zihinleri ve gönülleri aydınlatarak hayır ve mutluluk veren anlamına gelir."
    },
    "updatedAt": "2026-10-02T16:36:55.487Z"
  },
  {
    "id": "def_O0nU07yfy10AQr7VxBXD_2",
    "type": "definition",
    "topicId": "O0nU07yfy10AQr7VxBXD",
    "unitId": "uu39ahmPymk6HDQWksah",
    "courseId": "jBx7iE5eK5eFQRvCU008",
    "content": {
      "term": "Selam",
      "definition": "Her türlü eksiklikten uzak olan, yaratmasında kusursuz bulunan ve kullarına güvenlik, barış, esenlik ve sağlık bahşeden demektir."
    },
    "updatedAt": "2026-10-02T16:36:55.487Z"
  },
  {
    "id": "def_O0nU07yfy10AQr7VxBXD_3",
    "type": "definition",
    "topicId": "O0nU07yfy10AQr7VxBXD",
    "unitId": "uu39ahmPymk6HDQWksah",
    "courseId": "jBx7iE5eK5eFQRvCU008",
    "content": {
      "term": "Vekîl",
      "definition": "Bütün varlıkların işlerini düzenleyen, onları sevk ve idare eden, yardımını esirgemeden koruyup gözeten ve kullarının rızıklarına kefil olan anlamını taşır."
    },
    "updatedAt": "2026-10-02T16:36:55.487Z"
  },
  {
    "id": "def_O0nU07yfy10AQr7VxBXD_4",
    "type": "definition",
    "topicId": "O0nU07yfy10AQr7VxBXD",
    "unitId": "uu39ahmPymk6HDQWksah",
    "courseId": "jBx7iE5eK5eFQRvCU008",
    "content": {
      "term": "Tevekkül",
      "definition": "Bir kişinin üzerine düşen sorumlulukları ve çabayı eksiksiz yerine getirdikten sonra, sonucu Yüce Yaratıcıya bırakıp O'na gönülden güvenmesidir."
    },
    "updatedAt": "2026-10-02T16:36:55.487Z"
  },
  {
    "id": "def_O0nU07yfy10AQr7VxBXD_5",
    "type": "definition",
    "topicId": "O0nU07yfy10AQr7VxBXD",
    "unitId": "uu39ahmPymk6HDQWksah",
    "courseId": "jBx7iE5eK5eFQRvCU008",
    "content": {
      "term": "Hidayet",
      "definition": "Doğru yolu bulma, hak olan yola iletilme ve batıl inançlardan uzaklaşarak hakikate ulaşma durumudur."
    },
    "updatedAt": "2026-10-02T16:36:55.487Z"
  },
  {
    "id": "def_O0nU07yfy10AQr7VxBXD_6",
    "type": "definition",
    "topicId": "O0nU07yfy10AQr7VxBXD",
    "unitId": "uu39ahmPymk6HDQWksah",
    "courseId": "jBx7iE5eK5eFQRvCU008",
    "content": {
      "term": "Esma-i Hüsna",
      "definition": "Yüce Allah'ın Kur'an-ı Kerim'de ve hadislerde geçen en güzel isimlerinin genel adıdır."
    },
    "updatedAt": "2026-10-02T16:36:55.487Z"
  },
  {
    "id": "def_O0nU07yfy10AQr7VxBXD_7",
    "type": "definition",
    "topicId": "O0nU07yfy10AQr7VxBXD",
    "unitId": "uu39ahmPymk6HDQWksah",
    "courseId": "jBx7iE5eK5eFQRvCU008",
    "content": {
      "term": "Dua",
      "definition": "Kulun bütün benliğiyle Yüce Yaratıcıya yönelerek isteklerini, sıkıntılarını arz etmesi, O'ndan yardım ve bağışlanma dilemesidir."
    },
    "updatedAt": "2026-10-02T16:36:55.487Z"
  },
  {
    "id": "sentence_O0nU07yfy10AQr7VxBXD_0",
    "type": "sentence",
    "topicId": "O0nU07yfy10AQr7VxBXD",
    "unitId": "uu39ahmPymk6HDQWksah",
    "courseId": "jBx7iE5eK5eFQRvCU008",
    "content": {
      "text": "Allah en güzel isimlerin sahibidir."
    },
    "updatedAt": "2026-10-02T16:36:55.487Z"
  },
  {
    "id": "sentence_O0nU07yfy10AQr7VxBXD_1",
    "type": "sentence",
    "topicId": "O0nU07yfy10AQr7VxBXD",
    "unitId": "uu39ahmPymk6HDQWksah",
    "courseId": "jBx7iE5eK5eFQRvCU008",
    "content": {
      "text": "Hâdi doğru yolu gösteren demektir."
    },
    "updatedAt": "2026-10-02T16:36:55.487Z"
  },
  {
    "id": "sentence_O0nU07yfy10AQr7VxBXD_2",
    "type": "sentence",
    "topicId": "O0nU07yfy10AQr7VxBXD",
    "unitId": "uu39ahmPymk6HDQWksah",
    "courseId": "jBx7iE5eK5eFQRvCU008",
    "content": {
      "text": "Selam kullarına güven ve esenlik verir."
    },
    "updatedAt": "2026-10-02T16:36:55.487Z"
  },
  {
    "id": "sentence_O0nU07yfy10AQr7VxBXD_3",
    "type": "sentence",
    "topicId": "O0nU07yfy10AQr7VxBXD",
    "unitId": "uu39ahmPymk6HDQWksah",
    "courseId": "jBx7iE5eK5eFQRvCU008",
    "content": {
      "text": "Vekîl işleri düzenleyen ve koruyandır."
    },
    "updatedAt": "2026-10-02T16:36:55.487Z"
  },
  {
    "id": "sentence_O0nU07yfy10AQr7VxBXD_4",
    "type": "sentence",
    "topicId": "O0nU07yfy10AQr7VxBXD",
    "unitId": "uu39ahmPymk6HDQWksah",
    "courseId": "jBx7iE5eK5eFQRvCU008",
    "content": {
      "text": "Tevekkül edip sonucu Allah'a bırakmalıyız."
    },
    "updatedAt": "2026-10-02T16:36:55.487Z"
  },
  {
    "id": "sentence_O0nU07yfy10AQr7VxBXD_5",
    "type": "sentence",
    "topicId": "O0nU07yfy10AQr7VxBXD",
    "unitId": "uu39ahmPymk6HDQWksah",
    "courseId": "jBx7iE5eK5eFQRvCU008",
    "content": {
      "text": "Müslümanlar birbirlerine selam verirler."
    },
    "updatedAt": "2026-10-02T16:36:55.487Z"
  }
]