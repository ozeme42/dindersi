    "courseId": "OgnmTvY8rxVpEIP45iq4",
    "content": {
      "term": "Hasan bin Ali",
      "definition": "Peygamberimizin torunu, Hz. Ali ve Hz. Fatıma’nın oğlu."
    },
    "updatedAt": "2026-10-05T19:10:11.567Z"
  },
  {
    "id": "def_5leSpbBjVtIBxyaVqSZM_5",
