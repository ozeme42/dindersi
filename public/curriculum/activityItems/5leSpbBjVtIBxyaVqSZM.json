    "courseId": "OgnmTvY8rxVpEIP45iq4",
    "content": {
      "term": "Zeyd bin Harise",
      "definition": "Peygamberimizin evlatlığı, Hz. Hamza ile kardeş ilan edilen sahabi."
    },
    "updatedAt": "2026-10-05T19:10:11.567Z"
  },
  {
    "id": "def_5leSpbBjVtIBxyaVqSZM_3",
