    "unitId": "cUF2X2vchdqDFkcWMNkj",
    "courseId": "OgnmTvY8rxVpEIP45iq4",
    "content": {
      "term": "Hicret",
      "definition": "Peygamberimizin Mekke'den Medine'ye göç etmesi"
    },
    "updatedAt": "2026-10-05T19:10:11.567Z"
  },
  {
    "id": "def_5leSpbBjVtIBxyaVqSZM_7",
    "type": "definition",
