    "courseId": "OgnmTvY8rxVpEIP45iq4",
    "content": {
      "term": "Asrısaadet",
      "definition": "Hz. Muhammed'in peygamberlik görevini yürüttüğü, Kur'an'ın indirildiği ve İslam'ın en güzel şekilde yaşandığı mutluluk devri."
    },
    "updatedAt": "2026-10-05T19:10:11.567Z"
  },
  {
    "id": "def_5leSpbBjVtIBxyaVqSZM_2",
