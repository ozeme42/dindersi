  {
    "id": "def_B9ZrNo6WzlfdvpyRvYun_0",
    "type": "definition",
    "topicId": "B9ZrNo6WzlfdvpyRvYun",
    "unitId": "KXaDVYOgeUiDEerxQ7jR",
    "courseId": "OgnmTvY8rxVpEIP45iq4",
    "content": {
      "term": "İsraf",
      "definition": "Sahip olunan nimetlerin gereksiz yere harcanmasına ne denir?"
    },
    "updatedAt": "2026-10-05T19:14:23.281Z"
  },
  {
    "id": "def_B9ZrNo6WzlfdvpyRvYun_1",
    "type": "definition",
    "topicId": "B9ZrNo6WzlfdvpyRvYun",
    "unitId": "KXaDVYOgeUiDEerxQ7jR",
    "courseId": "OgnmTvY8rxVpEIP45iq4",
    "content": {
      "term": "Rızık",
      "definition": "Allah'ın verdiği yiyecek, içecek ve diğer tüm nimetler için kullanılan kelime nedir?"
    },
    "updatedAt": "2026-10-05T19:14:23.281Z"
  },
  {
    "id": "def_B9ZrNo6WzlfdvpyRvYun_2",
    "type": "definition",
    "topicId": "B9ZrNo6WzlfdvpyRvYun",
    "unitId": "KXaDVYOgeUiDEerxQ7jR",
    "courseId": "OgnmTvY8rxVpEIP45iq4",
    "content": {
      "term": "Helal",
      "definition": "Dinen yenilmesine izin verilen yiyecek ve içeceklere ne denir?"
    },
    "updatedAt": "2026-10-05T19:14:23.281Z"
  },
  {
    "id": "def_B9ZrNo6WzlfdvpyRvYun_3",
    "type": "definition",
    "topicId": "B9ZrNo6WzlfdvpyRvYun",
    "unitId": "KXaDVYOgeUiDEerxQ7jR",
    "courseId": "OgnmTvY8rxVpEIP45iq4",
    "content": {
      "term": "Bereket",
      "definition": "Allah'ın verdiği nimetlerin çoğalması ve verimli olması anlamına gelen kelime nedir?"
    },
    "updatedAt": "2026-10-05T19:14:23.281Z"
  },
  {
    "id": "def_B9ZrNo6WzlfdvpyRvYun_4",
    "type": "definition",
    "topicId": "B9ZrNo6WzlfdvpyRvYun",
    "unitId": "KXaDVYOgeUiDEerxQ7jR",
    "courseId": "OgnmTvY8rxVpEIP45iq4",
    "content": {
      "term": "Sofra Adabı",
      "definition": "Yemek yerken uyulması gereken kurallar nelerdir?"
    },
    "updatedAt": "2026-10-05T19:14:23.281Z"
  },
  {
    "id": "def_B9ZrNo6WzlfdvpyRvYun_5",
    "type": "definition",
    "topicId": "B9ZrNo6WzlfdvpyRvYun",
    "unitId": "KXaDVYOgeUiDEerxQ7jR",
    "courseId": "OgnmTvY8rxVpEIP45iq4",
    "content": {
      "term": "Tevazu",
      "definition": "Alçakgönüllülük ve gösterişsizlik olarak tanımlanan davranış şekli nedir?"
    },
    "updatedAt": "2026-10-05T19:14:23.281Z"
  },
  {
    "id": "def_B9ZrNo6WzlfdvpyRvYun_6",
    "type": "definition",
    "topicId": "B9ZrNo6WzlfdvpyRvYun",
    "unitId": "KXaDVYOgeUiDEerxQ7jR",
    "courseId": "OgnmTvY8rxVpEIP45iq4",
    "content": {
      "term": "Besmele",
      "definition": "Yemeğe başlamadan önce \"Bismillahirrahmanirrahim\" demenin adı nedir?"
    },
    "updatedAt": "2026-10-05T19:14:23.281Z"
  },
  {
    "id": "sentence_B9ZrNo6WzlfdvpyRvYun_0",
    "type": "sentence",
    "topicId": "B9ZrNo6WzlfdvpyRvYun",
    "unitId": "KXaDVYOgeUiDEerxQ7jR",
    "courseId": "OgnmTvY8rxVpEIP45iq4",
    "content": {
      "text": "Su kabına üflememek, kabın ağzını kapalı tutmak ve ikram edilen yiyeceği kontrol etmek temizliğe verilen önemi gösterir."
    },
    "updatedAt": "2026-10-05T19:14:23.281Z"
  },
  {
    "id": "sentence_B9ZrNo6WzlfdvpyRvYun_1",
    "type": "sentence",
    "topicId": "B9ZrNo6WzlfdvpyRvYun",
    "unitId": "KXaDVYOgeUiDEerxQ7jR",
    "courseId": "OgnmTvY8rxVpEIP45iq4",
    "content": {
      "text": "Peygamber Efendimiz ayakta yemek yemeyi uygun görmemiştir."
    },
    "updatedAt": "2026-10-05T19:14:23.281Z"
  },
  {
    "id": "sentence_B9ZrNo6WzlfdvpyRvYun_2",
    "type": "sentence",
    "topicId": "B9ZrNo6WzlfdvpyRvYun",
    "unitId": "KXaDVYOgeUiDEerxQ7jR",
    "courseId": "OgnmTvY8rxVpEIP45iq4",
    "content": {
      "text": "İslam'da helal ve temiz olan yiyeceklerin tüketilmesi önemlidir."
    },
    "updatedAt": "2026-10-05T19:14:23.281Z"
  },
  {
    "id": "sentence_B9ZrNo6WzlfdvpyRvYun_3",
    "type": "sentence",
    "topicId": "B9ZrNo6WzlfdvpyRvYun",
    "unitId": "KXaDVYOgeUiDEerxQ7jR",
    "courseId": "OgnmTvY8rxVpEIP45iq4",
    "content": {
      "text": "Yemeklerden önce ve sonra ellerin yıkanması, besmele çekmek ve şükretmek önemlidir."
    },
    "updatedAt": "2026-10-05T19:14:23.281Z"
  },
  {
    "id": "sentence_B9ZrNo6WzlfdvpyRvYun_4",
    "type": "sentence",
    "topicId": "B9ZrNo6WzlfdvpyRvYun",
    "unitId": "KXaDVYOgeUiDEerxQ7jR",
    "courseId": "OgnmTvY8rxVpEIP45iq4",
    "content": {
      "text": "Peygamberimiz yeme içme konusunda önemli ilkeler belirlemiştir ve Müslümanlar bu konuda O'nu örnek alırlar."
    },
    "updatedAt": "2026-10-05T19:14:23.281Z"
  },
  {
    "id": "sentence_B9ZrNo6WzlfdvpyRvYun_5",
    "type": "sentence",
    "topicId": "B9ZrNo6WzlfdvpyRvYun",
    "unitId": "KXaDVYOgeUiDEerxQ7jR",
    "courseId": "OgnmTvY8rxVpEIP45iq4",
    "content": {
      "text": "Peygamberimiz ikram edilen yemeği asla eleştirmemiş, sofra sahibine saygılı davranmıştır."
    },
    "updatedAt": "2026-10-05T19:14:23.281Z"
  },
  {
    "id": "sentence_B9ZrNo6WzlfdvpyRvYun_6",
    "type": "sentence",
    "topicId": "B9ZrNo6WzlfdvpyRvYun",
    "unitId": "KXaDVYOgeUiDEerxQ7jR",
    "courseId": "OgnmTvY8rxVpEIP45iq4",
    "content": {
      "text": "Helal yiyecek, meşru yollarla kazanılmış ve dinen yasaklanmamış olan yiyecektir."
    },
    "updatedAt": "2026-10-05T19:14:23.281Z"
  },
  {
    "id": "sentence_B9ZrNo6WzlfdvpyRvYun_7",
    "type": "sentence",
    "topicId": "B9ZrNo6WzlfdvpyRvYun",
    "unitId": "KXaDVYOgeUiDEerxQ7jR",
    "courseId": "OgnmTvY8rxVpEIP45iq4",
    "content": {
      "text": "Peygamberimiz, yemeğin israf edilmemesini ve tabağın temiz bırakılmasını tavsiye etmiştir."
    },
    "updatedAt": "2026-10-05T19:14:23.281Z"
  },
  {
    "id": "sentence_B9ZrNo6WzlfdvpyRvYun_8",
    "type": "sentence",
    "topicId": "B9ZrNo6WzlfdvpyRvYun",
    "unitId": "KXaDVYOgeUiDEerxQ7jR",
    "courseId": "OgnmTvY8rxVpEIP45iq4",
    "content": {
      "text": "Aşırı yemekten kaçınmak ve midenin bir kısmını boş bırakmak sağlıklı beslenmenin bir parçasıdır."
    },
    "updatedAt": "2026-10-05T19:14:23.281Z"
  },
  {
    "id": "sentence_B9ZrNo6WzlfdvpyRvYun_9",
    "type": "sentence",
    "topicId": "B9ZrNo6WzlfdvpyRvYun",
    "unitId": "KXaDVYOgeUiDEerxQ7jR",
    "courseId": "OgnmTvY8rxVpEIP45iq4",
    "content": {
      "text": "Sağ elle yemek yemek, tabağın kendi önümüzdeki kısmından yemek ve suyu üç yudumda içmek sofra adabındandır."
    },
    "updatedAt": "2026-10-05T19:14:23.281Z"
  }
]