    "courseId": "OgnmTvY8rxVpEIP45iq4",
    "content": {
      "term": "Tasarruf",
      "definition": "Kaynakları bilinçli ve dikkatli kullanmaktır."
    },
    "updatedAt": "2026-10-05T19:15:13.275Z"
  },
  {
    "id": "def_E9N2CrvEzfymGt1ZUdQN_5",
    "type": "definition",
    "topicId": "E9N2CrvEzfymGt1ZUdQN",
    "unitId": "KXaDVYOgeUiDEerxQ7jR",
    "courseId": "OgnmTvY8rxVpEIP45iq4",
    "content": {
      "term": "Taharet",
      "definition": "İslami kaynaklarda temizlik anlamında kullanılan kavramdır."
    },
    "updatedAt": "2026-10-05T19:15:13.275Z"
  },
  {
    "id": "def_E9N2CrvEzfymGt1ZUdQN_6",
    "type": "definition",
    "topicId": "E9N2CrvEzfymGt1ZUdQN",
    "unitId": "KXaDVYOgeUiDEerxQ7jR",
    "courseId": "OgnmTvY8rxVpEIP45iq4",
    "content": {
      "term": "Sadaka",
      "definition": "İhtiyaç sahiplerine yapılan maddi ve manevi yardıma denir."
    },
    "updatedAt": "2026-10-05T19:15:13.275Z"
  },
  {
    "id": "def_E9N2CrvEzfymGt1ZUdQN_7",
    "type": "definition",
    "topicId": "E9N2CrvEzfymGt1ZUdQN",
    "unitId": "KXaDVYOgeUiDEerxQ7jR",
    "courseId": "OgnmTvY8rxVpEIP45iq4",
    "content": {
      "term": "Kibir",
      "definition": "Kendini başkalarından üstün görmektir."
    },
    "updatedAt": "2026-10-05T19:15:13.275Z"
  },
  {
    "id": "sentence_E9N2CrvEzfymGt1ZUdQN_0",
    "type": "sentence",
    "topicId": "E9N2CrvEzfymGt1ZUdQN",
    "unitId": "KXaDVYOgeUiDEerxQ7jR",
    "courseId": "OgnmTvY8rxVpEIP45iq4",
    "content": {
      "text": "İsraf ve kibirden kaçınılması, İslam dininin önemli öğütlerindendir."
    },
    "updatedAt": "2026-10-05T19:15:13.275Z"
  },
  {
    "id": "sentence_E9N2CrvEzfymGt1ZUdQN_1",
    "type": "sentence",
    "topicId": "E9N2CrvEzfymGt1ZUdQN",
    "unitId": "KXaDVYOgeUiDEerxQ7jR",
    "courseId": "OgnmTvY8rxVpEIP45iq4",
    "content": {
      "text": "Giyim kuşamda israftan ve kibirden kaçınılması gerektiğini öğütlemiştir."
    },
    "updatedAt": "2026-10-05T19:15:13.275Z"
  },
  {
    "id": "sentence_E9N2CrvEzfymGt1ZUdQN_2",
    "type": "sentence",
    "topicId": "E9N2CrvEzfymGt1ZUdQN",
    "unitId": "KXaDVYOgeUiDEerxQ7jR",
    "courseId": "OgnmTvY8rxVpEIP45iq4",
    "content": {
      "text": "Hz. Muhammed (sav), giyim kuşamında temizlik, sadelik ve ölçülülük ilkelerini benimsemiştir."
    },
    "updatedAt": "2026-10-05T19:15:13.275Z"
  },
  {
    "id": "sentence_E9N2CrvEzfymGt1ZUdQN_3",
    "type": "sentence",
    "topicId": "E9N2CrvEzfymGt1ZUdQN",
    "unitId": "KXaDVYOgeUiDEerxQ7jR",
    "courseId": "OgnmTvY8rxVpEIP45iq4",
    "content": {
      "text": "Giyimde marka ısrarcılığı ve aşırı harcama yapmak israftır."
    },
    "updatedAt": "2026-10-05T19:15:13.275Z"
  },
  {
    "id": "sentence_E9N2CrvEzfymGt1ZUdQN_4",
    "type": "sentence",
    "topicId": "E9N2CrvEzfymGt1ZUdQN",
    "unitId": "KXaDVYOgeUiDEerxQ7jR",
    "courseId": "OgnmTvY8rxVpEIP45iq4",
    "content": {
      "text": "Hz. Muhammed (sav), giyim kuşamında temizlik, sadelik ve ölçülülük ilkelerine dikkat etmiştir."
    },
    "updatedAt": "2026-10-05T19:15:13.275Z"
  },
  {
    "id": "sentence_E9N2CrvEzfymGt1ZUdQN_5",
    "type": "sentence",
    "topicId": "E9N2CrvEzfymGt1ZUdQN",
    "unitId": "KXaDVYOgeUiDEerxQ7jR",
    "courseId": "OgnmTvY8rxVpEIP45iq4",
    "content": {
      "text": "Müslümanlar, giyim kuşamlarında başkalarının gözünü yormayacak renk, desen ve dokuları tercih etmelidir."
    },
    "updatedAt": "2026-10-05T19:15:13.275Z"
  },
  {
    "id": "sentence_E9N2CrvEzfymGt1ZUdQN_6",
    "type": "sentence",
    "topicId": "E9N2CrvEzfymGt1ZUdQN",
    "unitId": "KXaDVYOgeUiDEerxQ7jR",
    "courseId": "OgnmTvY8rxVpEIP45iq4",
    "content": {
      "text": "Tasarruf etmek, kaynakları verimli kullanmak ve israftan kaçınmak önemlidir."
    },
    "updatedAt": "2026-10-05T19:15:13.275Z"
  },
  {
    "id": "sentence_E9N2CrvEzfymGt1ZUdQN_7",
    "type": "sentence",
    "topicId": "E9N2CrvEzfymGt1ZUdQN",
    "unitId": "KXaDVYOgeUiDEerxQ7jR",
    "courseId": "OgnmTvY8rxVpEIP45iq4",
    "content": {
      "text": "Tesettür, kadın ve erkeklerin dinen örtülmesi gereken yerleri kapatmasıdır."
    },
    "updatedAt": "2026-10-05T19:15:13.275Z"
  },
  {
    "id": "sentence_E9N2CrvEzfymGt1ZUdQN_8",
    "type": "sentence",
    "topicId": "E9N2CrvEzfymGt1ZUdQN",
    "unitId": "KXaDVYOgeUiDEerxQ7jR",
    "courseId": "OgnmTvY8rxVpEIP45iq4",
    "content": {
      "text": "Peygamberimizin sade giyimi, mütevazı kişiliğinin bir yansımasıdır."
    },
    "updatedAt": "2026-10-05T19:15:13.275Z"
  },
  {
    "id": "sentence_E9N2CrvEzfymGt1ZUdQN_9",
    "type": "sentence",
    "topicId": "E9N2CrvEzfymGt1ZUdQN",
    "unitId": "KXaDVYOgeUiDEerxQ7jR",
    "courseId": "OgnmTvY8rxVpEIP45iq4",
    "content": {
      "text": "Mütevazı giyinmek, kişinin sahip olduklarını başkalarına üstünlük aracı olarak kullanmaması anlamına gelir."
    },
    "updatedAt": "2026-10-05T19:15:13.275Z"
  },
  {
    "id": "sentence_E9N2CrvEzfymGt1ZUdQN_10",
    "type": "sentence",
    "topicId": "E9N2CrvEzfymGt1ZUdQN",
    "unitId": "KXaDVYOgeUiDEerxQ7jR",
    "courseId": "OgnmTvY8rxVpEIP45iq4",
    "content": {
      "text": "Hz. Muhammed, tutumlu olmayı tavsiye etmiştir."
    },
    "updatedAt": "2026-10-05T19:15:13.275Z"
  },
  {
    "id": "sentence_E9N2CrvEzfymGt1ZUdQN_11",
    "type": "sentence",
    "topicId": "E9N2CrvEzfymGt1ZUdQN",
    "unitId": "KXaDVYOgeUiDEerxQ7jR",
    "courseId": "OgnmTvY8rxVpEIP45iq4",
    "content": {
      "text": "Peygamberimiz, Allah'ın nimetinin kulunun üzerinde görülmesini sever."
    },
    "updatedAt": "2026-10-05T19:15:13.275Z"
  },
  {
    "id": "sentence_E9N2CrvEzfymGt1ZUdQN_12",
    "type": "sentence",
    "topicId": "E9N2CrvEzfymGt1ZUdQN",
    "unitId": "KXaDVYOgeUiDEerxQ7jR",
    "courseId": "OgnmTvY8rxVpEIP45iq4",
    "content": {
      "text": "Peygamberimizin giyim kuşamı sade ve mütevazıydı."
    },
    "updatedAt": "2026-10-05T19:15:13.275Z"
  },
  {
    "id": "sentence_E9N2CrvEzfymGt1ZUdQN_13",
    "type": "sentence",
    "topicId": "E9N2CrvEzfymGt1ZUdQN",
    "unitId": "KXaDVYOgeUiDEerxQ7jR",
    "courseId": "OgnmTvY8rxVpEIP45iq4",
    "content": {
      "text": "Tasarruf, kaynakları verimli kullanmak ve israftan kaçınmak demektir."
    },
    "updatedAt": "2026-10-05T19:15:13.275Z"
  },
  {
    "id": "sentence_E9N2CrvEzfymGt1ZUdQN_14",
    "type": "sentence",
    "topicId": "E9N2CrvEzfymGt1ZUdQN",
    "unitId": "KXaDVYOgeUiDEerxQ7jR",
    "courseId": "OgnmTvY8rxVpEIP45iq4",
    "content": {
      "text": "İtidal, yeme içme ve giyim kuşamda dengeli ve ölçülü olmaktır."
    },
    "updatedAt": "2026-10-05T19:15:13.275Z"
  }
]