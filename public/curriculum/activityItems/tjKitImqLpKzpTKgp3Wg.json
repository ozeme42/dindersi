  {
    "id": "def_tjKitImqLpKzpTKgp3Wg_0",
    "type": "definition",
    "topicId": "tjKitImqLpKzpTKgp3Wg",
    "unitId": "dtuuPHngOY7wTmbxRSzs",
    "courseId": "XboyC5jGWhYxh8RHYtrC",
    "content": {
      "term": "Zeyd bin Harise",
      "definition": "Taif yolculuğunda Peygamber Efendimize eşlik eden ve atılan taşlara karşı kendini siper ederek onu korumaya çalışan sahabi."
    },
    "updatedAt": "2026-09-14T12:52:51.792Z"
  },
  {
    "id": "def_tjKitImqLpKzpTKgp3Wg_1",
    "type": "definition",
    "topicId": "tjKitImqLpKzpTKgp3Wg",
    "unitId": "dtuuPHngOY7wTmbxRSzs",
    "courseId": "XboyC5jGWhYxh8RHYtrC",
    "content": {
      "term": "Addas",
      "definition": "Taif'teki üzüm bahçesinde Peygamber Efendimizin besmele çekmesinden etkilenip Ninovalı hemşehrisi olan peygamberin adını duyunca Müslüman olan Hristiyan köle."
    },
    "updatedAt": "2026-09-14T12:52:51.792Z"
  },
  {
    "id": "def_tjKitImqLpKzpTKgp3Wg_2",
    "type": "definition",
    "topicId": "tjKitImqLpKzpTKgp3Wg",
    "unitId": "dtuuPHngOY7wTmbxRSzs",
    "courseId": "XboyC5jGWhYxh8RHYtrC",
    "content": {
      "term": "Sabır",
      "definition": "Zorluklar, musibetler ve haksızlıklar karşısında direnç gösterip metanetini koruma erdemi."
    },
    "updatedAt": "2026-09-14T12:52:51.792Z"
  },
  {
    "id": "def_tjKitImqLpKzpTKgp3Wg_3",
    "type": "definition",
    "topicId": "tjKitImqLpKzpTKgp3Wg",
    "unitId": "dtuuPHngOY7wTmbxRSzs",
    "courseId": "XboyC5jGWhYxh8RHYtrC",
    "content": {
      "term": "Tevekkül",
      "definition": "Bir amaç için gerekli tüm çabayı gösterdikten sonra sonucu Allah'a bırakıp O'na güvenme durumu."
    },
    "updatedAt": "2026-09-14T12:52:51.792Z"
  },
  {
    "id": "def_tjKitImqLpKzpTKgp3Wg_4",
    "type": "definition",
    "topicId": "tjKitImqLpKzpTKgp3Wg",
    "unitId": "dtuuPHngOY7wTmbxRSzs",
    "courseId": "XboyC5jGWhYxh8RHYtrC",
    "content": {
      "term": "Tebliğ",
      "definition": "Peygamberlerin Allah'tan aldıkları ilahi mesajları insanlara eksiksiz bir şekilde bildirmesi ve açıklaması görevi."
    },
    "updatedAt": "2026-09-14T12:52:51.792Z"
  },
  {
    "id": "def_tjKitImqLpKzpTKgp3Wg_5",
    "type": "definition",
    "topicId": "tjKitImqLpKzpTKgp3Wg",
    "unitId": "dtuuPHngOY7wTmbxRSzs",
    "courseId": "XboyC5jGWhYxh8RHYtrC",
    "content": {
      "term": "Merhamet",
      "definition": "Canlılara acıma, şefkat gösterme ve iyilikle muamele etme."
    },
    "updatedAt": "2026-09-14T12:52:51.792Z"
  },
  {
    "id": "def_tjKitImqLpKzpTKgp3Wg_6",
    "type": "definition",
    "topicId": "tjKitImqLpKzpTKgp3Wg",
    "unitId": "dtuuPHngOY7wTmbxRSzs",
    "courseId": "XboyC5jGWhYxh8RHYtrC",
    "content": {
      "term": "Taif",
      "definition": "Hz. Muhammed'in İslam'ı tebliğ etmek için gittiği Mekke yakınındaki şehir."
    },
    "updatedAt": "2026-09-14T12:52:51.792Z"
  },
  {
    "id": "def_tjKitImqLpKzpTKgp3Wg_7",
    "type": "definition",
    "topicId": "tjKitImqLpKzpTKgp3Wg",
    "unitId": "dtuuPHngOY7wTmbxRSzs",
    "courseId": "XboyC5jGWhYxh8RHYtrC",
    "content": {
      "term": "Mescid-i Addas",
      "definition": "Peygamber Efendimizin Taif'te taşlandıktan sonra sığındığı bağda kendisine üzüm ikram eden Hristiyan kölenin Müslüman olduğu yere sonradan inşa edilen ibadethane."
    },
    "updatedAt": "2026-09-14T12:52:51.792Z"
  },
  {
    "id": "def_tjKitImqLpKzpTKgp3Wg_8",
    "type": "definition",
    "topicId": "tjKitImqLpKzpTKgp3Wg",
    "unitId": "dtuuPHngOY7wTmbxRSzs",
    "courseId": "XboyC5jGWhYxh8RHYtrC",
    "content": {
      "term": "Hz. Yunus",
      "definition": "Ninova halkına gönderilen, Peygamber Efendimizin 'kardeşim' olarak nitelediği ve Kur'an-ı Kerim'de adı geçen peygamber."
    },
    "updatedAt": "2026-09-14T12:52:51.792Z"
  },
  {
    "id": "sentence_tjKitImqLpKzpTKgp3Wg_0",
    "type": "sentence",
    "topicId": "tjKitImqLpKzpTKgp3Wg",
    "unitId": "dtuuPHngOY7wTmbxRSzs",
    "courseId": "XboyC5jGWhYxh8RHYtrC",
    "content": {
      "text": "Hz. Muhammed Taif'e Zeyd ile gitti."
    },
    "updatedAt": "2026-09-14T12:52:51.792Z"
  },
  {
    "id": "sentence_tjKitImqLpKzpTKgp3Wg_1",
    "type": "sentence",
    "topicId": "tjKitImqLpKzpTKgp3Wg",
    "unitId": "dtuuPHngOY7wTmbxRSzs",
    "courseId": "XboyC5jGWhYxh8RHYtrC",
    "content": {
      "text": "Peygamberimiz Taifliler için merhametle dua etti."
    },
    "updatedAt": "2026-09-14T12:52:51.792Z"
  },
  {
    "id": "sentence_tjKitImqLpKzpTKgp3Wg_2",
    "type": "sentence",
    "topicId": "tjKitImqLpKzpTKgp3Wg",
    "unitId": "dtuuPHngOY7wTmbxRSzs",
    "courseId": "XboyC5jGWhYxh8RHYtrC",
    "content": {
      "text": "Addas üzüm bağında Müslüman olan köledir."
    },
    "updatedAt": "2026-09-14T12:52:51.792Z"
  },
  {
    "id": "sentence_tjKitImqLpKzpTKgp3Wg_3",
    "type": "sentence",
    "topicId": "tjKitImqLpKzpTKgp3Wg",
    "unitId": "dtuuPHngOY7wTmbxRSzs",
    "courseId": "XboyC5jGWhYxh8RHYtrC",
    "content": {
      "text": "Müslümanlar kötülüğe karşı iyilikle karşılık verir."
    },
    "updatedAt": "2026-09-14T12:52:51.792Z"
  },
  {
    "id": "sentence_tjKitImqLpKzpTKgp3Wg_4",
    "type": "sentence",
    "topicId": "tjKitImqLpKzpTKgp3Wg",
    "unitId": "dtuuPHngOY7wTmbxRSzs",
    "courseId": "XboyC5jGWhYxh8RHYtrC",
    "content": {
      "text": "Taif yolculuğu 620 yılında gerçekleşmiş olaydır."
    },
    "updatedAt": "2026-09-14T12:52:51.792Z"
  },
  {
    "id": "sentence_tjKitImqLpKzpTKgp3Wg_5",
    "type": "sentence",
    "topicId": "tjKitImqLpKzpTKgp3Wg",
    "unitId": "dtuuPHngOY7wTmbxRSzs",
    "courseId": "XboyC5jGWhYxh8RHYtrC",
    "content": {
      "text": "Peygamberimiz zorluklar karşısında sabır ve tevekkül gösterdi."
    },
    "updatedAt": "2026-09-14T12:52:51.792Z"
  },
  {
    "id": "sentence_tjKitImqLpKzpTKgp3Wg_6",
    "type": "sentence",
    "topicId": "tjKitImqLpKzpTKgp3Wg",
    "unitId": "dtuuPHngOY7wTmbxRSzs",
    "courseId": "XboyC5jGWhYxh8RHYtrC",
    "content": {
      "text": "Hz. Muhammed insanları daima İslam'a davet etti."
    },
    "updatedAt": "2026-09-14T12:52:51.792Z"
  },
  {
    "id": "sentence_tjKitImqLpKzpTKgp3Wg_7",
    "type": "sentence",
    "topicId": "tjKitImqLpKzpTKgp3Wg",
    "unitId": "dtuuPHngOY7wTmbxRSzs",
    "courseId": "XboyC5jGWhYxh8RHYtrC",
    "content": {
      "text": "Kötülük yapan insanlara asla zulüm edilmemelidir."
    },
    "updatedAt": "2026-09-14T12:52:51.792Z"
  }
]