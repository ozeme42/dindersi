    "content": {
      "term": "Tevazu",
      "definition": "Alçakgönüllü olma, büyüklük taslamama ve insanlara eşit yaklaşma durumu."
    },
    "updatedAt": "2026-10-05T19:11:48.554Z"
  },
  {
    "id": "def_W0oWMb2NmbPD9loOa99m_1",
    "type": "definition",
    "topicId": "W0oWMb2NmbPD9loOa99m",
    "unitId": "cUF2X2vchdqDFkcWMNkj",
    "courseId": "OgnmTvY8rxVpEIP45iq4",
    "content": {
      "term": "Hz. Ali",
      "definition": "Beş yaşından itibaren Peygamberimizin evinde yaşamaya başlayan çocuk sahabe."
    },
    "updatedAt": "2026-10-05T19:11:48.554Z"
  },
  {
    "id": "def_W0oWMb2NmbPD9loOa99m_2",
    "type": "definition",
    "topicId": "W0oWMb2NmbPD9loOa99m",
    "unitId": "cUF2X2vchdqDFkcWMNkj",
    "courseId": "OgnmTvY8rxVpEIP45iq4",
    "content": {
      "term": "Hz. Zeyd bin Harise",
      "definition": "Peygamberimizin hürriyetine kavuşturduğu ve evlat edindiği sahabi."
    },
    "updatedAt": "2026-10-05T19:11:48.554Z"
  },
  {
    "id": "def_W0oWMb2NmbPD9loOa99m_3",
    "type": "definition",
    "topicId": "W0oWMb2NmbPD9loOa99m",
    "unitId": "cUF2X2vchdqDFkcWMNkj",
    "courseId": "OgnmTvY8rxVpEIP45iq4",
    "content": {
      "term": "Asrısaadet",
      "definition": "Hz. Muhammed'in yaşadığı, huzur ve mutluluk devri."
    },
    "updatedAt": "2026-10-05T19:11:48.554Z"
  },
  {
    "id": "def_W0oWMb2NmbPD9loOa99m_4",
    "type": "definition",
    "topicId": "W0oWMb2NmbPD9loOa99m",
    "unitId": "cUF2X2vchdqDFkcWMNkj",
    "courseId": "OgnmTvY8rxVpEIP45iq4",
    "content": {
      "term": "Hicret",
      "definition": "Müslümanların 622 yılında Mekke’den Medine’ye yaptıkları göç."
    },
    "updatedAt": "2026-10-05T19:11:48.554Z"
  },
  {
    "id": "def_W0oWMb2NmbPD9loOa99m_5",
    "type": "definition",
    "topicId": "W0oWMb2NmbPD9loOa99m",
    "unitId": "cUF2X2vchdqDFkcWMNkj",
    "courseId": "OgnmTvY8rxVpEIP45iq4",
    "content": {
      "term": "Hz. Enes bin Malik",
      "definition": "Peygamberimize on yıl hizmet eden, onun terbiyesinde yetişen çocuk."
    },
    "updatedAt": "2026-10-05T19:11:48.554Z"
  },
  {
    "id": "def_W0oWMb2NmbPD9loOa99m_6",
    "type": "definition",
    "topicId": "W0oWMb2NmbPD9loOa99m",
    "unitId": "cUF2X2vchdqDFkcWMNkj",
    "courseId": "OgnmTvY8rxVpEIP45iq4",
    "content": {
      "term": "Hâdimü’n-nebi",
      "definition": "Peygamberin küçük hizmetkârı anlamına gelen, Hz. Enes'e verilen unvan."
    },
    "updatedAt": "2026-10-05T19:11:48.554Z"
  },
  {
    "id": "def_W0oWMb2NmbPD9loOa99m_7",
    "type": "definition",
    "topicId": "W0oWMb2NmbPD9loOa99m",
    "unitId": "cUF2X2vchdqDFkcWMNkj",
    "courseId": "OgnmTvY8rxVpEIP45iq4",
    "content": {
      "term": "Vahiy",
      "definition": "Yüce Yaratıcı'nın emir ve yasaklarını peygamberlere ilahi yolla bildirmesi."
    },
    "updatedAt": "2026-10-05T19:11:48.554Z"
  },
  {
    "id": "def_W0oWMb2NmbPD9loOa99m_8",
    "type": "definition",
    "topicId": "W0oWMb2NmbPD9loOa99m",
    "unitId": "cUF2X2vchdqDFkcWMNkj",
    "courseId": "OgnmTvY8rxVpEIP45iq4",
    "content": {
      "term": "Halife",
      "definition": "Devlet başkanlığı makamında bulunan ve yönetimi devralan lider."
    },
    "updatedAt": "2026-10-05T19:11:48.554Z"
  },
  {
    "id": "def_W0oWMb2NmbPD9loOa99m_9",
    "type": "definition",
    "topicId": "W0oWMb2NmbPD9loOa99m",
    "unitId": "cUF2X2vchdqDFkcWMNkj",
    "courseId": "OgnmTvY8rxVpEIP45iq4",
    "content": {
      "term": "Hadis",
      "definition": "Son elçinin söz, fiil ve onaylarının bütünü."
    },
    "updatedAt": "2026-10-05T19:11:48.554Z"
  },
  {
    "id": "sentence_W0oWMb2NmbPD9loOa99m_0",
    "type": "sentence",
    "topicId": "W0oWMb2NmbPD9loOa99m",
    "unitId": "cUF2X2vchdqDFkcWMNkj",
    "courseId": "OgnmTvY8rxVpEIP45iq4",
    "content": {
      "text": "Hz. Ali, Hz. Zeyd bin Harise ve Hz. Enes bin Malik, Peygamberimizin yanında yetişen önemli çocuk sahabelerdendir."
    },
    "updatedAt": "2026-10-05T19:11:48.554Z"
  },
  {
    "id": "sentence_W0oWMb2NmbPD9loOa99m_1",
    "type": "sentence",
    "topicId": "W0oWMb2NmbPD9loOa99m",
    "unitId": "cUF2X2vchdqDFkcWMNkj",
    "courseId": "OgnmTvY8rxVpEIP45iq4",
    "content": {
      "text": "Peygamberimiz, çocuklara sevgi, şefkat ve merhametle yaklaşmıştır."
    },
    "updatedAt": "2026-10-05T19:11:48.554Z"
  },
  {
    "id": "sentence_W0oWMb2NmbPD9loOa99m_2",
    "type": "sentence",
    "topicId": "W0oWMb2NmbPD9loOa99m",
    "unitId": "cUF2X2vchdqDFkcWMNkj",
    "courseId": "OgnmTvY8rxVpEIP45iq4",
    "content": {
      "text": "Peygamberimizin yanında yetişen çocuklar, Müslümanlar için örnek teşkil etmektedir."
    },
    "updatedAt": "2026-10-05T19:11:48.554Z"
  },
  {
    "id": "sentence_W0oWMb2NmbPD9loOa99m_3",
    "type": "sentence",
    "topicId": "W0oWMb2NmbPD9loOa99m",
    "unitId": "cUF2X2vchdqDFkcWMNkj",
    "courseId": "OgnmTvY8rxVpEIP45iq4",
    "content": {
      "text": "Asrısaadet dönemi, Hz. Muhammed'in yaşadığı ve İslam'ın yayılmaya başladığı dönemdir."
    },
    "updatedAt": "2026-10-05T19:11:48.554Z"
  },
  {
    "id": "sentence_W0oWMb2NmbPD9loOa99m_4",
    "type": "sentence",
    "topicId": "W0oWMb2NmbPD9loOa99m",
    "unitId": "cUF2X2vchdqDFkcWMNkj",
    "courseId": "OgnmTvY8rxVpEIP45iq4",
    "content": {
      "text": "Çocuk sahabiler, Peygamberimizi örnek alarak yaşamışlardır."
    },
    "updatedAt": "2026-10-05T19:11:48.554Z"
  },
  {
    "id": "sentence_W0oWMb2NmbPD9loOa99m_5",
    "type": "sentence",
    "topicId": "W0oWMb2NmbPD9loOa99m",
    "unitId": "cUF2X2vchdqDFkcWMNkj",
    "courseId": "OgnmTvY8rxVpEIP45iq4",
    "content": {
      "text": "Hz. Zeyd bin Harise, Peygamberimiz tarafından hürriyetine kavuşturulan ilk köledir."
    },
    "updatedAt": "2026-10-05T19:11:48.554Z"
  },
  {
    "id": "sentence_W0oWMb2NmbPD9loOa99m_6",
    "type": "sentence",
    "topicId": "W0oWMb2NmbPD9loOa99m",
    "unitId": "cUF2X2vchdqDFkcWMNkj",
    "courseId": "OgnmTvY8rxVpEIP45iq4",
    "content": {
      "text": "Hz. Enes bin Malik, Peygamberimize on yıl hizmet etmiştir ve \"Peygamberin küçük hizmetkarı\" olarak bilinir."
    },
    "updatedAt": "2026-10-05T19:11:48.554Z"
  },
  {
    "id": "sentence_W0oWMb2NmbPD9loOa99m_7",
    "type": "sentence",
    "topicId": "W0oWMb2NmbPD9loOa99m",
    "unitId": "cUF2X2vchdqDFkcWMNkj",
    "courseId": "OgnmTvY8rxVpEIP45iq4",
    "content": {
      "text": "Hz. Peygamber, çocukların eğitimine ve ahlaklı yetişmesine önem vermiştir."
    },
    "updatedAt": "2026-10-05T19:11:48.554Z"
  },
  {
    "id": "sentence_W0oWMb2NmbPD9loOa99m_8",
    "type": "sentence",
    "topicId": "W0oWMb2NmbPD9loOa99m",
    "unitId": "cUF2X2vchdqDFkcWMNkj",
    "courseId": "OgnmTvY8rxVpEIP45iq4",
    "content": {
      "text": "Hz. Ali, Peygamberimize iman eden ilk çocuktur."
    },
    "updatedAt": "2026-10-05T19:11:48.554Z"
  }
]