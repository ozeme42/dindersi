  },
  {
    "id": "def_ZbuhKsMwd4wNNdqKjmix_6",
    "type": "definition",
    "topicId": "ZbuhKsMwd4wNNdqKjmix",
    "unitId": "g5vZnJOuq1Bg3hSVaYGZ",
    "courseId": "OgnmTvY8rxVpEIP45iq4",
    "content": {
      "term": "Hz. Aişe",
      "definition": "Peygamberimizin Hz. Hatice'den sonraki eşi"
    },
    "updatedAt": "2026-10-05T19:16:16.889Z"
  },
  {
    "id": "sentence_ZbuhKsMwd4wNNdqKjmix_0",
    "type": "sentence",
    "topicId": "ZbuhKsMwd4wNNdqKjmix",
    "unitId": "g5vZnJOuq1Bg3hSVaYGZ",
    "courseId": "OgnmTvY8rxVpEIP45iq4",
    "content": {
      "text": "Hz. Peygamber, aile bireylerine zaman ayırır ve onlarla ilgilenirdi."
    },
    "updatedAt": "2026-10-05T19:16:16.889Z"
  },
  {
    "id": "sentence_ZbuhKsMwd4wNNdqKjmix_1",
    "type": "sentence",
    "topicId": "ZbuhKsMwd4wNNdqKjmix",
    "unitId": "g5vZnJOuq1Bg3hSVaYGZ",
    "courseId": "OgnmTvY8rxVpEIP45iq4",
    "content": {
      "text": "Peygamberimiz, Hz. Hatice'ye olan sevgisini ve vefasını her zaman dile getirmiştir."
    },
    "updatedAt": "2026-10-05T19:16:16.889Z"
  },
  {
    "id": "sentence_ZbuhKsMwd4wNNdqKjmix_2",
    "type": "sentence",
    "topicId": "ZbuhKsMwd4wNNdqKjmix",
    "unitId": "g5vZnJOuq1Bg3hSVaYGZ",
    "courseId": "OgnmTvY8rxVpEIP45iq4",
    "content": {
      "text": "Peygamberimiz, Hz. Hatice'nin vefatından sonra bile onun sevdikleriyle ilişkisini sürdürmüştür."
    },
    "updatedAt": "2026-10-05T19:16:16.889Z"
  },
  {
    "id": "sentence_ZbuhKsMwd4wNNdqKjmix_3",
    "type": "sentence",
    "topicId": "ZbuhKsMwd4wNNdqKjmix",
    "unitId": "g5vZnJOuq1Bg3hSVaYGZ",
    "courseId": "OgnmTvY8rxVpEIP45iq4",
    "content": {
      "text": "Peygamberimiz, ev işlerinde ailesine yardım ederdi."
    },
    "updatedAt": "2026-10-05T19:16:16.889Z"
  },
  {
    "id": "sentence_ZbuhKsMwd4wNNdqKjmix_4",
    "type": "sentence",
    "topicId": "ZbuhKsMwd4wNNdqKjmix",
    "unitId": "g5vZnJOuq1Bg3hSVaYGZ",
    "courseId": "OgnmTvY8rxVpEIP45iq4",
    "content": {
      "text": "Hz. Hatice, Peygamberimize ilk iman eden kişidir ve ona destek olmuştur."
    },
    "updatedAt": "2026-10-05T19:16:16.889Z"
  },
  {
    "id": "sentence_ZbuhKsMwd4wNNdqKjmix_5",
    "type": "sentence",
    "topicId": "ZbuhKsMwd4wNNdqKjmix",
    "unitId": "g5vZnJOuq1Bg3hSVaYGZ",
    "courseId": "OgnmTvY8rxVpEIP45iq4",
    "content": {
      "text": "Peygamberimiz, vefa duygusuna önem verirdi ve Hz. Hatice'nin vefatından sonra bile onun arkadaşlarına iyi davranırdı."
    },
    "updatedAt": "2026-10-05T19:16:16.889Z"
  },
  {
    "id": "sentence_ZbuhKsMwd4wNNdqKjmix_6",
    "type": "sentence",
    "topicId": "ZbuhKsMwd4wNNdqKjmix",
    "unitId": "g5vZnJOuq1Bg3hSVaYGZ",
    "courseId": "OgnmTvY8rxVpEIP45iq4",
    "content": {
      "text": "Hz. Aişe, Peygamberimiz ile yarış yaptığı bir anısını anlatır."
    },
    "updatedAt": "2026-10-05T19:16:16.889Z"
  },
  {
    "id": "sentence_ZbuhKsMwd4wNNdqKjmix_7",
    "type": "sentence",
    "topicId": "ZbuhKsMwd4wNNdqKjmix",
    "unitId": "g5vZnJOuq1Bg3hSVaYGZ",
    "courseId": "OgnmTvY8rxVpEIP45iq4",
    "content": {
      "text": "Peygamber Efendimiz, aile hayatında Müslümanlara örnek olmuştur."
    },
    "updatedAt": "2026-10-05T19:16:16.889Z"
  },
  {
    "id": "sentence_ZbuhKsMwd4wNNdqKjmix_8",
    "type": "sentence",
    "topicId": "ZbuhKsMwd4wNNdqKjmix",
    "unitId": "g5vZnJOuq1Bg3hSVaYGZ",
    "courseId": "OgnmTvY8rxVpEIP45iq4",
    "content": {
      "text": "Peygamberimiz, eşlerine karşı nazik davranır ve onların isteklerini geri çevirmezdi."
    },
    "updatedAt": "2026-10-05T19:16:16.889Z"
  },
  {
    "id": "sentence_ZbuhKsMwd4wNNdqKjmix_9",
    "type": "sentence",
    "topicId": "ZbuhKsMwd4wNNdqKjmix",
    "unitId": "g5vZnJOuq1Bg3hSVaYGZ",
    "courseId": "OgnmTvY8rxVpEIP45iq4",
    "content": {
      "text": "Peygamberimiz, Hz. Aişe ile evlendikten sonra ona sevgi ve saygı göstermiştir."
    },
    "updatedAt": "2026-10-05T19:16:16.889Z"
  }
]