    "content": {
      "term": "Kelimeişehadet",
      "definition": "İslam'ın temel esaslarından biridir."
    },
    "updatedAt": "2026-10-05T18:53:59.265Z"
  },
  {
    "id": "def_4fgyq1e8tIlXt8HCELq5_2",
    "type": "definition",
    "topicId": "4fgyq1e8tIlXt8HCELq5",
    "unitId": "vjkkjfl8lYIiW2miv1RF",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "term": "Salih Kullar",
      "definition": "Tahiyyat duasında selam gönderilen Allah’ın iyi kulları."
    },
    "updatedAt": "2026-10-05T18:53:59.265Z"
  },
  {
    "id": "def_4fgyq1e8tIlXt8HCELq5_3",
    "type": "definition",
    "topicId": "4fgyq1e8tIlXt8HCELq5",
    "unitId": "vjkkjfl8lYIiW2miv1RF",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "term": "Selam",
      "definition": "Esenlik, ikram ve hürmet anlamlarına gelir."
    },
    "updatedAt": "2026-10-05T18:53:59.265Z"
  },
  {
    "id": "def_4fgyq1e8tIlXt8HCELq5_4",
    "type": "definition",
    "topicId": "4fgyq1e8tIlXt8HCELq5",
    "unitId": "vjkkjfl8lYIiW2miv1RF",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "term": "Rahmet",
      "definition": "Allah'ın merhameti ve acımasıdır."
    },
    "updatedAt": "2026-10-05T18:53:59.265Z"
  },
  {
    "id": "def_4fgyq1e8tIlXt8HCELq5_5",
    "type": "definition",
    "topicId": "4fgyq1e8tIlXt8HCELq5",
    "unitId": "vjkkjfl8lYIiW2miv1RF",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "term": "Hadis",
      "definition": "Peygamberimizin sözleri ve uygulamalarıdır."
    },
    "updatedAt": "2026-10-05T18:53:59.265Z"
  },
  {
    "id": "def_4fgyq1e8tIlXt8HCELq5_6",
    "type": "definition",
    "topicId": "4fgyq1e8tIlXt8HCELq5",
    "unitId": "vjkkjfl8lYIiW2miv1RF",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "term": "Kelime-i Şehadet (Sözü)",
      "definition": "\"Eşhedü en lâ ilâhe illallah ve eşhedü enne Muhammeden abdühü ve resûlüh\" cümlesidir."
    },
    "updatedAt": "2026-10-05T18:53:59.265Z"
  },
  {
    "id": "def_4fgyq1e8tIlXt8HCELq5_7",
    "type": "definition",
    "topicId": "4fgyq1e8tIlXt8HCELq5",
    "unitId": "vjkkjfl8lYIiW2miv1RF",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "term": "Namaz",
      "definition": "Müslümanların günde beş vakit yaptığı ibadettir."
    },
    "updatedAt": "2026-10-05T18:53:59.265Z"
  },
  {
    "id": "def_4fgyq1e8tIlXt8HCELq5_8",
    "type": "definition",
    "topicId": "4fgyq1e8tIlXt8HCELq5",
    "unitId": "vjkkjfl8lYIiW2miv1RF",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "term": "Tahiyyat",
      "definition": "Namazlarda otururken okunan bir ibadettir."
    },
    "updatedAt": "2026-10-05T18:53:59.265Z"
  },
  {
    "id": "def_4fgyq1e8tIlXt8HCELq5_9",
    "type": "definition",
    "topicId": "4fgyq1e8tIlXt8HCELq5",
    "unitId": "vjkkjfl8lYIiW2miv1RF",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "term": "Ashab",
      "definition": "Peygamberimizin arkadaşlarıdır."
    },
    "updatedAt": "2026-10-05T18:53:59.265Z"
  },
  {
    "id": "def_4fgyq1e8tIlXt8HCELq5_10",
    "type": "definition",
    "topicId": "4fgyq1e8tIlXt8HCELq5",
    "unitId": "vjkkjfl8lYIiW2miv1RF",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "term": "Dua",
      "definition": "Allah'tan yardım dileme, yalvarma eylemidir."
    },
    "updatedAt": "2026-10-05T18:53:59.265Z"
  },
  {
    "id": "sentence_4fgyq1e8tIlXt8HCELq5_0",
    "type": "sentence",
    "topicId": "4fgyq1e8tIlXt8HCELq5",
    "unitId": "vjkkjfl8lYIiW2miv1RF",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "text": "Tahiyyat duası çocukların ilk öğrendiğidir."
    },
    "updatedAt": "2026-10-05T18:53:59.265Z"
  },
  {
    "id": "sentence_4fgyq1e8tIlXt8HCELq5_1",
    "type": "sentence",
    "topicId": "4fgyq1e8tIlXt8HCELq5",
    "unitId": "vjkkjfl8lYIiW2miv1RF",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "text": "Müslümanlar Tahiyyat ile selamlaşmayı hatırlar."
    },
    "updatedAt": "2026-10-05T18:53:59.265Z"
  },
  {
    "id": "sentence_4fgyq1e8tIlXt8HCELq5_2",
    "type": "sentence",
    "topicId": "4fgyq1e8tIlXt8HCELq5",
    "unitId": "vjkkjfl8lYIiW2miv1RF",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "text": "Allah'tan başka ilah yoktur."
    },
    "updatedAt": "2026-10-05T18:53:59.265Z"
  },
  {
    "id": "sentence_4fgyq1e8tIlXt8HCELq5_3",
    "type": "sentence",
    "topicId": "4fgyq1e8tIlXt8HCELq5",
    "unitId": "vjkkjfl8lYIiW2miv1RF",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "text": "Tahiyyat Allah'ı, kulları selamlamaktır."
    },
    "updatedAt": "2026-10-05T18:53:59.265Z"
  },
  {
    "id": "sentence_4fgyq1e8tIlXt8HCELq5_4",
    "type": "sentence",
    "topicId": "4fgyq1e8tIlXt8HCELq5",
    "unitId": "vjkkjfl8lYIiW2miv1RF",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "text": "Tahiyyat duası namazda otururken okunur, bu dua kelimeişehadet ile biter."
    },
    "updatedAt": "2026-10-05T18:53:59.265Z"
  },
  {
    "id": "sentence_4fgyq1e8tIlXt8HCELq5_5",
    "type": "sentence",
    "topicId": "4fgyq1e8tIlXt8HCELq5",
    "unitId": "vjkkjfl8lYIiW2miv1RF",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "text": "Tahiyyat selam ve ikram demektir."
    },
    "updatedAt": "2026-10-05T18:53:59.265Z"
  },
  {
    "id": "sentence_4fgyq1e8tIlXt8HCELq5_6",
    "type": "sentence",
    "topicId": "4fgyq1e8tIlXt8HCELq5",
    "unitId": "vjkkjfl8lYIiW2miv1RF",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "text": "Namazda tüm iyi kullar selamlanır."
    },
    "updatedAt": "2026-10-05T18:53:59.265Z"
  },
  {
    "id": "sentence_4fgyq1e8tIlXt8HCELq5_7",
    "type": "sentence",
    "topicId": "4fgyq1e8tIlXt8HCELq5",
    "unitId": "vjkkjfl8lYIiW2miv1RF",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "text": "Muhammed Allah'ın kulu ve elçisidir."
    },
    "updatedAt": "2026-10-05T18:53:59.265Z"
  },
  {
    "id": "sentence_4fgyq1e8tIlXt8HCELq5_8",
    "type": "sentence",
    "topicId": "4fgyq1e8tIlXt8HCELq5",
    "unitId": "vjkkjfl8lYIiW2miv1RF",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "text": "Selam ve rahmet Allah içindir."
    },
    "updatedAt": "2026-10-05T18:53:59.265Z"
  },
  {
    "id": "sentence_4fgyq1e8tIlXt8HCELq5_9",
    "type": "sentence",
    "topicId": "4fgyq1e8tIlXt8HCELq5",
    "unitId": "vjkkjfl8lYIiW2miv1RF",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "text": "Bütün güzellikler ve iyilikler Allah içindir."
    },
    "updatedAt": "2026-10-05T18:53:59.265Z"
  },
  {
    "id": "sentence_4fgyq1e8tIlXt8HCELq5_10",
    "type": "sentence",
    "topicId": "4fgyq1e8tIlXt8HCELq5",
    "unitId": "vjkkjfl8lYIiW2miv1RF",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "text": "Peygamber ashabına Tahiyyat'ı öğretti."
    },
    "updatedAt": "2026-10-05T18:53:59.265Z"
  },
  {
    "id": "sentence_4fgyq1e8tIlXt8HCELq5_11",
    "type": "sentence",
    "topicId": "4fgyq1e8tIlXt8HCELq5",
    "unitId": "vjkkjfl8lYIiW2miv1RF",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "text": "Allah ve Peygamber konuşması içerir."
    },
    "updatedAt": "2026-10-05T18:53:59.265Z"
  },
  {
    "id": "sentence_4fgyq1e8tIlXt8HCELq5_12",
    "type": "sentence",
    "topicId": "4fgyq1e8tIlXt8HCELq5",
    "unitId": "vjkkjfl8lYIiW2miv1RF",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "text": "Tahiyyat namazlarda otururken okunur."
    },
    "updatedAt": "2026-10-05T18:53:59.265Z"
  }
]