  {
    "id": "def_QS6SmMl5nG9VgWL9LNEy_0",
    "type": "definition",
    "topicId": "QS6SmMl5nG9VgWL9LNEy",
    "unitId": "jjotqKbHyi504QHH40ko",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "term": "Evren",
      "definition": "İçerisinde dünyamız, yıldızlar ve gezegenler gibi tüm varlıkların bulunduğu sonsuz boşluk."
    },
    "updatedAt": "2026-09-11T15:08:12.640Z"
  },
  {
    "id": "def_QS6SmMl5nG9VgWL9LNEy_1",
    "type": "definition",
    "topicId": "QS6SmMl5nG9VgWL9LNEy",
    "unitId": "jjotqKbHyi504QHH40ko",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "term": "Akıl",
      "definition": "İnsanı diğer canlılardan ayıran, onu özel kılan yetenektir."
    },
    "updatedAt": "2026-09-11T15:08:12.640Z"
  },
  {
    "id": "def_QS6SmMl5nG9VgWL9LNEy_2",
    "type": "definition",
    "topicId": "QS6SmMl5nG9VgWL9LNEy",
    "unitId": "jjotqKbHyi504QHH40ko",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "term": "Su Döngüsü",
      "definition": "Yeryüzündeki canlıların su ihtiyacını karşılayan doğal süreç."
    },
    "updatedAt": "2026-09-11T15:08:12.640Z"
  },
  {
    "id": "def_QS6SmMl5nG9VgWL9LNEy_3",
    "type": "definition",
    "topicId": "QS6SmMl5nG9VgWL9LNEy",
    "unitId": "jjotqKbHyi504QHH40ko",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "term": "Gözlem",
      "definition": "Çevremizdeki olayları dikkatlice izleyip inceleme."
    },
    "updatedAt": "2026-09-11T15:08:12.640Z"
  },
  {
    "id": "def_QS6SmMl5nG9VgWL9LNEy_4",
    "type": "definition",
    "topicId": "QS6SmMl5nG9VgWL9LNEy",
    "unitId": "jjotqKbHyi504QHH40ko",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "term": "Mevsimler",
      "definition": "Dünya'nın güneş etrafındaki dönüşünün sonucudur."
    },
    "updatedAt": "2026-09-11T15:08:12.640Z"
  },
  {
    "id": "def_QS6SmMl5nG9VgWL9LNEy_5",
    "type": "definition",
    "topicId": "QS6SmMl5nG9VgWL9LNEy",
    "unitId": "jjotqKbHyi504QHH40ko",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "term": "Alem",
      "definition": "Yeryüzü ve gökyüzündeki nesnelerin oluşturduğu bütün evrenin adıdır"
    },
    "updatedAt": "2026-09-11T15:08:12.640Z"
  },
  {
    "id": "sentence_QS6SmMl5nG9VgWL9LNEy_0",
    "type": "sentence",
    "topicId": "QS6SmMl5nG9VgWL9LNEy",
    "unitId": "jjotqKbHyi504QHH40ko",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "text": "Gece ve gündüz birbirini takip eder."
    },
    "updatedAt": "2026-09-11T15:08:12.640Z"
  },
  {
    "id": "sentence_QS6SmMl5nG9VgWL9LNEy_1",
    "type": "sentence",
    "topicId": "QS6SmMl5nG9VgWL9LNEy",
    "unitId": "jjotqKbHyi504QHH40ko",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "text": "Evrendeki her şey bir amaç için yaratılmıştır ve tesadüfi değildir."
    },
    "updatedAt": "2026-09-11T15:08:12.640Z"
  },
  {
    "id": "sentence_QS6SmMl5nG9VgWL9LNEy_2",
    "type": "sentence",
    "topicId": "QS6SmMl5nG9VgWL9LNEy",
    "unitId": "jjotqKbHyi504QHH40ko",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "text": "İnsan, evreni anlamaya çalışır."
    },
    "updatedAt": "2026-09-11T15:08:12.640Z"
  },
  {
    "id": "sentence_QS6SmMl5nG9VgWL9LNEy_3",
    "type": "sentence",
    "topicId": "QS6SmMl5nG9VgWL9LNEy",
    "unitId": "jjotqKbHyi504QHH40ko",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "text": "Evren mükemmel bir düzen içindedir."
    },
    "updatedAt": "2026-09-11T15:08:12.640Z"
  },
  {
    "id": "sentence_QS6SmMl5nG9VgWL9LNEy_4",
    "type": "sentence",
    "topicId": "QS6SmMl5nG9VgWL9LNEy",
    "unitId": "jjotqKbHyi504QHH40ko",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "text": "Mevsimler düzenli olarak değişir."
    },
    "updatedAt": "2026-09-11T15:08:12.640Z"
  },
  {
    "id": "sentence_QS6SmMl5nG9VgWL9LNEy_5",
    "type": "sentence",
    "topicId": "QS6SmMl5nG9VgWL9LNEy",
    "unitId": "jjotqKbHyi504QHH40ko",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "text": "İnsan, gözlem yaparak ve sorgulayarak evrendeki düzeni anlayabilir."
    },
    "updatedAt": "2026-09-11T15:08:12.640Z"
  },
  {
    "id": "sentence_QS6SmMl5nG9VgWL9LNEy_6",
    "type": "sentence",
    "topicId": "QS6SmMl5nG9VgWL9LNEy",
    "unitId": "jjotqKbHyi504QHH40ko",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "text": "Gözlem ve araştırma önemlidir."
    },
    "updatedAt": "2026-09-11T15:08:12.640Z"
  },
  {
    "id": "sentence_QS6SmMl5nG9VgWL9LNEy_7",
    "type": "sentence",
    "topicId": "QS6SmMl5nG9VgWL9LNEy",
    "unitId": "jjotqKbHyi504QHH40ko",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "text": "Doğada uyum ve denge vardır."
    },
    "updatedAt": "2026-09-11T15:08:12.640Z"
  },
  {
    "id": "sentence_QS6SmMl5nG9VgWL9LNEy_8",
    "type": "sentence",
    "topicId": "QS6SmMl5nG9VgWL9LNEy",
    "unitId": "jjotqKbHyi504QHH40ko",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "text": "İnsan, akıl sahibi olmasıyla diğer canlılardan ayrılır ve evrendeki düzeni anlamaya çalışır."
    },
    "updatedAt": "2026-09-11T15:08:12.640Z"
  },
  {
    "id": "sentence_QS6SmMl5nG9VgWL9LNEy_9",
    "type": "sentence",
    "topicId": "QS6SmMl5nG9VgWL9LNEy",
    "unitId": "jjotqKbHyi504QHH40ko",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "text": "Su döngüsü yaşam için önemlidir."
    },
    "updatedAt": "2026-09-11T15:08:12.640Z"
  },
  {
    "id": "sentence_QS6SmMl5nG9VgWL9LNEy_10",
    "type": "sentence",
    "topicId": "QS6SmMl5nG9VgWL9LNEy",
    "unitId": "jjotqKbHyi504QHH40ko",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "text": "Evren, mükemmel bir düzen içinde işleyen bir sistemdir."
    },
    "updatedAt": "2026-09-11T15:08:12.640Z"
  },
  {
    "id": "sentence_QS6SmMl5nG9VgWL9LNEy_11",
    "type": "sentence",
    "topicId": "QS6SmMl5nG9VgWL9LNEy",
    "unitId": "jjotqKbHyi504QHH40ko",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "text": "Her şey bir amaç için yaratılmıştır."
    },
    "updatedAt": "2026-09-11T15:08:12.640Z"
  },
  {
    "id": "sentence_QS6SmMl5nG9VgWL9LNEy_12",
    "type": "sentence",
    "topicId": "QS6SmMl5nG9VgWL9LNEy",
    "unitId": "jjotqKbHyi504QHH40ko",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "text": "Döngüler doğanın dengesini sağlar."
    },
    "updatedAt": "2026-09-11T15:08:12.640Z"
  },
  {
    "id": "sentence_QS6SmMl5nG9VgWL9LNEy_13",
    "type": "sentence",
    "topicId": "QS6SmMl5nG9VgWL9LNEy",
    "unitId": "jjotqKbHyi504QHH40ko",
    "courseId": "9UqFYq2nwNkjBcq1mJ3o",
    "content": {
      "text": "İnsan vücudundaki ve evrendeki döngüler, dengenin korunmasını sağlar."
    },
    "updatedAt": "2026-09-11T15:08:12.640Z"
  }
]