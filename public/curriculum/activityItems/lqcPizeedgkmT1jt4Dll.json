    "unitId": "HaG39Z2i3AIE1XQznLZw",
    "content": {
      "text": "Ramazan ayı oruç ve Kur'an ayıdır."
    },
    "type": "sentence",
    "createdAt": {
      "type": "firestore/timestamp/1.0",
      "seconds": 1767361332,
      "nanoseconds": 686000000
    },
