  {
    "id": "def_iMXvYZESmR3700GLvsuj_0",
    "type": "definition",
    "topicId": "iMXvYZESmR3700GLvsuj",
    "unitId": "14Ox2maDLwQIYSUE3qmd",
    "courseId": "134DwgMfh8VYogm3gDyh",
    "content": {
      "term": "Gayb",
      "definition": "Göz önünde olmayan, duyularla algılanamayan, varlığı ancak vahiy yoluyla bilinebilen gizli âlem ve bilgiler."
    },
    "updatedAt": "2026-09-16T18:57:11.875Z"
  },
  {
    "id": "def_iMXvYZESmR3700GLvsuj_1",
    "type": "definition",
    "topicId": "iMXvYZESmR3700GLvsuj",
    "unitId": "14Ox2maDLwQIYSUE3qmd",
    "courseId": "134DwgMfh8VYogm3gDyh",
    "content": {
      "term": "Melek",
      "definition": "Yüce Allah'ın emirlerine eksiksiz itaat eden, nurdan yaratılmış, yeme-içme ve cinsiyeti bulunmayan görünmez ruhani varlık."
    },
    "updatedAt": "2026-09-16T18:57:11.875Z"
  },
  {
    "id": "def_iMXvYZESmR3700GLvsuj_2",
    "type": "definition",
    "topicId": "iMXvYZESmR3700GLvsuj",
    "unitId": "14Ox2maDLwQIYSUE3qmd",
    "courseId": "134DwgMfh8VYogm3gDyh",
    "content": {
      "term": "Cin",
      "definition": "Yalın ateşten yaratılan, insanlar gibi ibadet etmekle yükümlü olan, inananı ve inanmayanı bulunan gözle görülmeyen varlık."
    },
    "updatedAt": "2026-09-16T18:57:11.875Z"
  },
  {
    "id": "def_iMXvYZESmR3700GLvsuj_3",
    "type": "definition",
    "topicId": "iMXvYZESmR3700GLvsuj",
    "unitId": "14Ox2maDLwQIYSUE3qmd",
    "courseId": "134DwgMfh8VYogm3gDyh",
    "content": {
      "term": "Cebrail",
      "definition": "Yüce Allah'ın emir ve yasaklarını peygamberlere bildirmekle görevli vahiy elçisi."
    },
    "updatedAt": "2026-09-16T18:57:11.875Z"
  },
  {
    "id": "def_iMXvYZESmR3700GLvsuj_4",
    "type": "definition",
    "topicId": "iMXvYZESmR3700GLvsuj",
    "unitId": "14Ox2maDLwQIYSUE3qmd",
    "courseId": "134DwgMfh8VYogm3gDyh",
    "content": {
      "term": "Azrail",
      "definition": "Eceli gelen canlıların ruhunu teslim almakla görevlendirilen görevli."
    },
    "updatedAt": "2026-09-16T18:57:11.875Z"
  },
  {
    "id": "def_iMXvYZESmR3700GLvsuj_5",
    "type": "definition",
    "topicId": "iMXvYZESmR3700GLvsuj",
    "unitId": "14Ox2maDLwQIYSUE3qmd",
    "courseId": "134DwgMfh8VYogm3gDyh",
    "content": {
      "term": "Mikâil",
      "definition": "Tabiat olaylarını idare etmek ve canlıların rızıklarının dağıtılmasıyla görevli ulvi varlık."
    },
    "updatedAt": "2026-09-16T18:57:11.875Z"
  },
  {
    "id": "def_iMXvYZESmR3700GLvsuj_6",
    "type": "definition",
    "topicId": "iMXvYZESmR3700GLvsuj",
    "unitId": "14Ox2maDLwQIYSUE3qmd",
    "courseId": "134DwgMfh8VYogm3gDyh",
    "content": {
      "term": "İsrafil",
      "definition": "Kıyametin kopması ve kıyametten sonra diriliş anında meşhur boruyu üflemekle görevli ulvi varlık."
    },
    "updatedAt": "2026-09-16T18:57:11.875Z"
  },
  {
    "id": "def_iMXvYZESmR3700GLvsuj_7",
    "type": "definition",
    "topicId": "iMXvYZESmR3700GLvsuj",
    "unitId": "14Ox2maDLwQIYSUE3qmd",
    "courseId": "134DwgMfh8VYogm3gDyh",
    "content": {
      "term": "Kiramen Kâtibin",
      "definition": "İnsanın sağında ve solunda bulunarak onun sevap ve günahlarını amel defterine kaydetmekle görevli değerli kâtipler."
    },
    "updatedAt": "2026-09-16T18:57:11.875Z"
  },
  {
    "id": "def_iMXvYZESmR3700GLvsuj_8",
    "type": "definition",
    "topicId": "iMXvYZESmR3700GLvsuj",
    "unitId": "14Ox2maDLwQIYSUE3qmd",
    "courseId": "134DwgMfh8VYogm3gDyh",
    "content": {
      "term": "Münker ve Nekir",
      "definition": "Kabirde insanları sorgulamakla görevli melekler."
    },
    "updatedAt": "2026-09-16T18:57:11.875Z"
  },
  {
    "id": "def_iMXvYZESmR3700GLvsuj_9",
    "type": "definition",
    "topicId": "iMXvYZESmR3700GLvsuj",
    "unitId": "14Ox2maDLwQIYSUE3qmd",
    "courseId": "134DwgMfh8VYogm3gDyh",
    "content": {
      "term": "Şeytan",
      "definition": "Kibirlenerek doğru yoldan sapan, insanları kötülüğe ve vesveseye sevk etmeye çalışan düşman varlık."
    },
    "updatedAt": "2026-09-16T18:57:11.875Z"
  },
  {
    "id": "def_iMXvYZESmR3700GLvsuj_10",
    "type": "definition",
    "topicId": "iMXvYZESmR3700GLvsuj",
    "unitId": "14Ox2maDLwQIYSUE3qmd",
    "courseId": "134DwgMfh8VYogm3gDyh",
    "content": {
      "term": "Varlıklar Âlemi",
      "definition": "Allah’ın yarattığı, duyu organları ve akılla bilinebilen veya var olduğu düşünülebilen bütün mevcudatın oluşturduğu kapsayıcı bütün."
    },
    "updatedAt": "2026-09-16T18:57:11.875Z"
  },
  {
    "id": "def_iMXvYZESmR3700GLvsuj_11",
    "type": "definition",
    "topicId": "iMXvYZESmR3700GLvsuj",
    "unitId": "14Ox2maDLwQIYSUE3qmd",
    "courseId": "134DwgMfh8VYogm3gDyh",
    "content": {
      "term": "İblis",
      "definition": "Büyüklük taslayarak Yüce Yaratan'ın emrine karşı gelen, ateşten yaratılmış ve cennetten kovularak insanlara düşman olan varlık."
    },
    "updatedAt": "2026-09-16T18:57:11.875Z"
  },
  {
    "id": "def_iMXvYZESmR3700GLvsuj_12",
    "type": "definition",
    "topicId": "iMXvYZESmR3700GLvsuj",
    "unitId": "14Ox2maDLwQIYSUE3qmd",
    "courseId": "134DwgMfh8VYogm3gDyh",
    "content": {
      "term": "Halife",
      "definition": "Yeryüzünde Allah'ın emir ve yasaklarını uygulayan, adaleti sağlayan ve orayı imar etmekle görevlendirilen temsilci varlık."
    },
    "updatedAt": "2026-09-16T18:57:11.875Z"
  },
  {
    "id": "def_iMXvYZESmR3700GLvsuj_13",
    "type": "definition",
    "topicId": "iMXvYZESmR3700GLvsuj",
    "unitId": "14Ox2maDLwQIYSUE3qmd",
    "courseId": "134DwgMfh8VYogm3gDyh",
    "content": {
      "term": "Sûr",
      "definition": "Kıyametin kopması ve öldükten sonra yeniden diriliş esnasında üflenecek olan özel boru veya vasıta."
    },
    "updatedAt": "2026-09-16T18:57:11.875Z"
  },
  {
    "id": "sentence_iMXvYZESmR3700GLvsuj_0",
    "type": "sentence",
    "topicId": "iMXvYZESmR3700GLvsuj",
    "unitId": "14Ox2maDLwQIYSUE3qmd",
    "courseId": "134DwgMfh8VYogm3gDyh",
    "content": {
      "text": "Melekler nurdan yaratılmış gözle görülmeyen varlıklardır."
    },
    "updatedAt": "2026-09-16T18:57:11.875Z"
  },
  {
    "id": "sentence_iMXvYZESmR3700GLvsuj_1",
    "type": "sentence",
    "topicId": "iMXvYZESmR3700GLvsuj",
    "unitId": "14Ox2maDLwQIYSUE3qmd",
    "courseId": "134DwgMfh8VYogm3gDyh",
    "content": {
      "text": "Gaybın bilgisini yalnızca Yüce Allah bilir."
    },
    "updatedAt": "2026-09-16T18:57:11.875Z"
  },
  {
    "id": "sentence_iMXvYZESmR3700GLvsuj_2",
    "type": "sentence",
    "topicId": "iMXvYZESmR3700GLvsuj",
    "unitId": "14Ox2maDLwQIYSUE3qmd",
    "courseId": "134DwgMfh8VYogm3gDyh",
    "content": {
      "text": "Cebrail peygamberlere vahiy getirmekle görevli melektir."
    },
    "updatedAt": "2026-09-16T18:57:11.875Z"
  },
  {
    "id": "sentence_iMXvYZESmR3700GLvsuj_3",
    "type": "sentence",
    "topicId": "iMXvYZESmR3700GLvsuj",
    "unitId": "14Ox2maDLwQIYSUE3qmd",
    "courseId": "134DwgMfh8VYogm3gDyh",
    "content": {
      "text": "İnsanın tüm davranışları amel defterine yazılır."
    },
    "updatedAt": "2026-09-16T18:57:11.875Z"
  },
  {
    "id": "sentence_iMXvYZESmR3700GLvsuj_4",
    "type": "sentence",
    "topicId": "iMXvYZESmR3700GLvsuj",
    "unitId": "14Ox2maDLwQIYSUE3qmd",
    "courseId": "134DwgMfh8VYogm3gDyh",
    "content": {
      "text": "Cinler de insanlar gibi ibadetle yükümlüdür."
    },
    "updatedAt": "2026-09-16T18:57:11.875Z"
  },
  {
    "id": "sentence_iMXvYZESmR3700GLvsuj_5",
    "type": "sentence",
    "topicId": "iMXvYZESmR3700GLvsuj",
    "unitId": "14Ox2maDLwQIYSUE3qmd",
    "courseId": "134DwgMfh8VYogm3gDyh",
    "content": {
      "text": "Şeytan kibri yüzünden Allah'ın emrine karşı gelmiştir."
    },
    "updatedAt": "2026-09-16T18:57:11.875Z"
  },
  {
    "id": "sentence_iMXvYZESmR3700GLvsuj_6",
    "type": "sentence",
    "topicId": "iMXvYZESmR3700GLvsuj",
    "unitId": "14Ox2maDLwQIYSUE3qmd",
    "courseId": "134DwgMfh8VYogm3gDyh",
    "content": {
      "text": "Mikail doğa olaylarını idare etmekle görevlidir."
    },
    "updatedAt": "2026-09-16T18:57:11.875Z"
  },
  {
    "id": "sentence_iMXvYZESmR3700GLvsuj_7",
    "type": "sentence",
    "topicId": "iMXvYZESmR3700GLvsuj",
    "unitId": "14Ox2maDLwQIYSUE3qmd",
    "courseId": "134DwgMfh8VYogm3gDyh",
    "content": {
      "text": "İsrafil kıyamet günü sûra üflemekle görevlidir."
    },
    "updatedAt": "2026-09-16T18:57:11.875Z"
  },
  {
    "id": "sentence_iMXvYZESmR3700GLvsuj_8",
    "type": "sentence",
    "topicId": "iMXvYZESmR3700GLvsuj",
    "unitId": "14Ox2maDLwQIYSUE3qmd",
    "courseId": "134DwgMfh8VYogm3gDyh",
    "content": {
      "text": "Kabirdeki insanları Münker ve Nekir sorgular."
    },
    "updatedAt": "2026-09-16T18:57:11.875Z"
  },
  {
    "id": "sentence_iMXvYZESmR3700GLvsuj_9",
    "type": "sentence",
    "topicId": "iMXvYZESmR3700GLvsuj",
    "unitId": "14Ox2maDLwQIYSUE3qmd",
    "courseId": "134DwgMfh8VYogm3gDyh",
    "content": {
      "text": "Hz. Âdem topraktan yaratılan ilk insandır."
    },
    "updatedAt": "2026-09-16T18:57:11.875Z"
  }
]