  {
    "id": "def_BpeFac8LEKcwfQ8s1cu3_0",
    "type": "definition",
    "topicId": "BpeFac8LEKcwfQ8s1cu3",
    "unitId": "uu39ahmPymk6HDQWksah",
    "courseId": "jBx7iE5eK5eFQRvCU008",
    "content": {
      "term": "İslam",
      "definition": "Teslim olmak, güven ve emniyette bulunmak anlamlarına gelen, Yüce Allah tarafından Hz. Muhammed aracılığıyla gönderilen son ilahi dindir."
    },
    "updatedAt": "2026-10-02T16:35:54.729Z"
  },
  {
    "id": "def_BpeFac8LEKcwfQ8s1cu3_1",
    "type": "definition",
    "topicId": "BpeFac8LEKcwfQ8s1cu3",
    "unitId": "uu39ahmPymk6HDQWksah",
    "courseId": "jBx7iE5eK5eFQRvCU008",
    "content": {
      "term": "Mümin",
      "definition": "İlahi çağrıyı özgür iradesiyle kabul eden, Allah’ın var ve bir olduğunu dil ile söyleyip kalbiyle tasdik eden kimisedir."
    },
    "updatedAt": "2026-10-02T16:35:54.729Z"
  },
  {
    "id": "def_BpeFac8LEKcwfQ8s1cu3_2",
    "type": "definition",
    "topicId": "BpeFac8LEKcwfQ8s1cu3",
    "unitId": "uu39ahmPymk6HDQWksah",
    "courseId": "jBx7iE5eK5eFQRvCU008",
    "content": {
      "term": "Kelimeişehadet",
      "definition": "İnancın dil ile söylenmesi ve kalple onaylanması olup, İslam’a girmenin ilk şartı ve inancın ifadesidir."
    },
    "updatedAt": "2026-10-02T16:35:54.729Z"
  },
  {
    "id": "def_BpeFac8LEKcwfQ8s1cu3_3",
    "type": "definition",
    "topicId": "BpeFac8LEKcwfQ8s1cu3",
    "unitId": "uu39ahmPymk6HDQWksah",
    "courseId": "jBx7iE5eK5eFQRvCU008",
    "content": {
      "term": "Namaz",
      "definition": "Belirli vakitlerde yerine getirilen, insanı Allah ile bağ kurmaya ve disiplinli yaşamaya yönelten farz ibadettir."
    },
    "updatedAt": "2026-10-02T16:35:54.729Z"
  },
  {
    "id": "def_BpeFac8LEKcwfQ8s1cu3_4",
    "type": "definition",
    "topicId": "BpeFac8LEKcwfQ8s1cu3",
    "unitId": "uu39ahmPymk6HDQWksah",
    "courseId": "jBx7iE5eK5eFQRvCU008",
    "content": {
      "term": "Oruç",
      "definition": "Ramazan ayı boyunca belli vakitlerde yeme, içme ve nefsi kötü davranışlardan uzak tutarak iradeye hâkim olma becerisidir."
    },
    "updatedAt": "2026-10-02T16:35:54.729Z"
  },
  {
    "id": "def_BpeFac8LEKcwfQ8s1cu3_5",
    "type": "definition",
    "topicId": "BpeFac8LEKcwfQ8s1cu3",
    "unitId": "uu39ahmPymk6HDQWksah",
    "courseId": "jBx7iE5eK5eFQRvCU008",
    "content": {
      "term": "Zekât",
      "definition": "Dinen zengin sayılan kişilerin mallarının belli bir kısmını her yıl ihtiyaç sahipleriyle paylaşmasıdır."
    },
    "updatedAt": "2026-10-02T16:35:54.729Z"
  },
  {
    "id": "def_BpeFac8LEKcwfQ8s1cu3_6",
    "type": "definition",
    "topicId": "BpeFac8LEKcwfQ8s1cu3",
    "unitId": "uu39ahmPymk6HDQWksah",
    "courseId": "jBx7iE5eK5eFQRvCU008",
    "content": {
      "term": "Hac",
      "definition": "İmkânı olanların belirli günlerde kutsal mekanları ziyaret ederek kardeşlik ve birlik duygusuyla bir araya gelmesidir."
    },
    "updatedAt": "2026-10-02T16:35:54.729Z"
  },
  {
    "id": "def_BpeFac8LEKcwfQ8s1cu3_7",
    "type": "definition",
    "topicId": "BpeFac8LEKcwfQ8s1cu3",
    "unitId": "uu39ahmPymk6HDQWksah",
    "courseId": "jBx7iE5eK5eFQRvCU008",
    "content": {
      "term": "Ahlak",
      "definition": "Bir bireyin sergilediği tutum, davranış ve erdemlerin bütünü olup, inancın dışa yansıyan en güzel biçimidir."
    },
    "updatedAt": "2026-10-02T16:35:54.729Z"
  },
  {
    "id": "def_BpeFac8LEKcwfQ8s1cu3_8",
    "type": "definition",
    "topicId": "BpeFac8LEKcwfQ8s1cu3",
    "unitId": "uu39ahmPymk6HDQWksah",
    "courseId": "jBx7iE5eK5eFQRvCU008",
    "content": {
      "term": "İbadet",
      "definition": "Yaratıcıya duyulan sevgi ve saygının gösterilmesi, O'nun rızasını kazanmak için yapılan her türlü güzel ve hayırlı eylemdir."
    },
    "updatedAt": "2026-10-02T16:35:54.729Z"
  },
  {
    "id": "def_BpeFac8LEKcwfQ8s1cu3_9",
    "type": "definition",
    "topicId": "BpeFac8LEKcwfQ8s1cu3",
    "unitId": "uu39ahmPymk6HDQWksah",
    "courseId": "jBx7iE5eK5eFQRvCU008",
    "content": {
      "term": "Sorumluluk",
      "definition": "Kişinin yaptığı veya yapmadığı her türlü eylemin neticesini üstlenme ve bilincinde olma durumudur."
    },
    "updatedAt": "2026-10-02T16:35:54.729Z"
  },
  {
    "id": "def_BpeFac8LEKcwfQ8s1cu3_10",
    "type": "definition",
    "topicId": "BpeFac8LEKcwfQ8s1cu3",
    "unitId": "uu39ahmPymk6HDQWksah",
    "courseId": "jBx7iE5eK5eFQRvCU008",
    "content": {
      "term": "Güven",
      "definition": "İnsanların birbirine karşı dürüst, tutarlı ve zarar vermeyeceğinden emin olunan bir huzur ortamı yaratmasıdır."
    },
    "updatedAt": "2026-10-02T16:35:54.729Z"
  },
  {
    "id": "def_BpeFac8LEKcwfQ8s1cu3_11",
    "type": "definition",
    "topicId": "BpeFac8LEKcwfQ8s1cu3",
    "unitId": "uu39ahmPymk6HDQWksah",
    "courseId": "jBx7iE5eK5eFQRvCU008",
    "content": {
      "term": "Yardımlaşma",
      "definition": "İmkanları başkalarıyla paylaşarak ihtiyaç sahiplerinin sıkıntılarını giderme ve toplumsal dayanışmayı güçlendirme eylemidir."
    },
    "updatedAt": "2026-10-02T16:35:54.729Z"
  },
  {
    "id": "sentence_BpeFac8LEKcwfQ8s1cu3_0",
    "type": "sentence",
    "topicId": "BpeFac8LEKcwfQ8s1cu3",
    "unitId": "uu39ahmPymk6HDQWksah",
    "courseId": "jBx7iE5eK5eFQRvCU008",
    "content": {
      "text": "İslam beş temel şart üzerine kurulmuştur."
    },
    "updatedAt": "2026-10-02T16:35:54.729Z"
  },
  {
    "id": "sentence_BpeFac8LEKcwfQ8s1cu3_1",
    "type": "sentence",
    "topicId": "BpeFac8LEKcwfQ8s1cu3",
    "unitId": "uu39ahmPymk6HDQWksah",
    "courseId": "jBx7iE5eK5eFQRvCU008",
    "content": {
      "text": "Mümin kimliğinin özü kelimeişehadet getirmektir."
    },
    "updatedAt": "2026-10-02T16:35:54.729Z"
  },
  {
    "id": "sentence_BpeFac8LEKcwfQ8s1cu3_2",
    "type": "sentence",
    "topicId": "BpeFac8LEKcwfQ8s1cu3",
    "unitId": "uu39ahmPymk6HDQWksah",
    "courseId": "jBx7iE5eK5eFQRvCU008",
    "content": {
      "text": "Namaz insanı kötülükten ve hayâsızlıktan alıkoyar."
    },
    "updatedAt": "2026-10-02T16:35:54.729Z"
  },
  {
    "id": "sentence_BpeFac8LEKcwfQ8s1cu3_3",
    "type": "sentence",
    "topicId": "BpeFac8LEKcwfQ8s1cu3",
    "unitId": "uu39ahmPymk6HDQWksah",
    "courseId": "jBx7iE5eK5eFQRvCU008",
    "content": {
      "text": "Oruç tutmak insana sabretmeyi öğretir."
    },
    "updatedAt": "2026-10-02T16:35:54.729Z"
  },
  {
    "id": "sentence_BpeFac8LEKcwfQ8s1cu3_4",
    "type": "sentence",
    "topicId": "BpeFac8LEKcwfQ8s1cu3",
    "unitId": "uu39ahmPymk6HDQWksah",
    "courseId": "jBx7iE5eK5eFQRvCU008",
    "content": {
      "text": "Zekât toplumsal bir yardımlaşma köprüsüdür."
    },
    "updatedAt": "2026-10-02T16:35:54.729Z"
  },
  {
    "id": "sentence_BpeFac8LEKcwfQ8s1cu3_5",
    "type": "sentence",
    "topicId": "BpeFac8LEKcwfQ8s1cu3",
    "unitId": "uu39ahmPymk6HDQWksah",
    "courseId": "jBx7iE5eK5eFQRvCU008",
    "content": {
      "text": "İman ile güzel ahlak birbirini tamamlar."
    },
    "updatedAt": "2026-10-02T16:35:54.729Z"
  }
]