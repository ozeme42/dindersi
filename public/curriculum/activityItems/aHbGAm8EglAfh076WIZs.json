  {
    "id": "def_aHbGAm8EglAfh076WIZs_0",
    "type": "definition",
    "topicId": "aHbGAm8EglAfh076WIZs",
    "unitId": "14Ox2maDLwQIYSUE3qmd",
    "courseId": "134DwgMfh8VYogm3gDyh",
    "content": {
      "term": "Kirâmen Kâtibîn",
      "definition": "İnsanların sağında ve solunda bulunarak yapılan iyi ve kötü tüm davranışları yazmakla görevli olan şerefli varlıklar."
    },
    "updatedAt": "2026-09-16T18:37:15.391Z"
  },
  {
    "id": "def_aHbGAm8EglAfh076WIZs_1",
    "type": "definition",
    "topicId": "aHbGAm8EglAfh076WIZs",
    "unitId": "14Ox2maDLwQIYSUE3qmd",
    "courseId": "134DwgMfh8VYogm3gDyh",
    "content": {
      "term": "Hafaza",
      "definition": "Yüce Yaratıcı'nın emriyle insanları çeşitli tehlikelerden ve olumsuzluklardan koruyan göksel görevliler."
    },
    "updatedAt": "2026-09-16T18:37:15.391Z"
  },
  {
    "id": "def_aHbGAm8EglAfh076WIZs_2",
    "type": "definition",
    "topicId": "aHbGAm8EglAfh076WIZs",
    "unitId": "14Ox2maDLwQIYSUE3qmd",
    "courseId": "134DwgMfh8VYogm3gDyh",
    "content": {
      "term": "Ahiret",
      "definition": "Dünya hayatındaki son nefesten sonra başlayıp sonsuza kadar sürecek olan ikinci yaşam ve değerlendirme evresi."
    },
    "updatedAt": "2026-09-16T18:37:15.391Z"
  },
  {
    "id": "def_aHbGAm8EglAfh076WIZs_3",
    "type": "definition",
    "topicId": "aHbGAm8EglAfh076WIZs",
    "unitId": "14Ox2maDLwQIYSUE3qmd",
    "courseId": "134DwgMfh8VYogm3gDyh",
    "content": {
      "term": "İmtihan",
      "definition": "İnsanın dünya yaşantısındaki özgür tercihlerine, davranışlarına ve inancına göre sınanması durumu."
    },
    "updatedAt": "2026-09-16T18:37:15.391Z"
  },
  {
    "id": "def_aHbGAm8EglAfh076WIZs_4",
    "type": "definition",
    "topicId": "aHbGAm8EglAfh076WIZs",
    "unitId": "14Ox2maDLwQIYSUE3qmd",
    "courseId": "134DwgMfh8VYogm3gDyh",
    "content": {
      "term": "Sorumluluk",
      "definition": "Kişinin kendi davranışlarının ve karar süreçlerinin sonuçlarını üstlenmesi bilinci."
    },
    "updatedAt": "2026-09-16T18:37:15.391Z"
  },
  {
    "id": "def_aHbGAm8EglAfh076WIZs_5",
    "type": "definition",
    "topicId": "aHbGAm8EglAfh076WIZs",
    "unitId": "14Ox2maDLwQIYSUE3qmd",
    "courseId": "134DwgMfh8VYogm3gDyh",
    "content": {
      "term": "Adalet",
      "definition": "Her hak sahibine hakkını vermek, haksızlıktan kaçınmak ve her koşulda tarafsızlığı korumak."
    },
    "updatedAt": "2026-09-16T18:37:15.391Z"
  },
  {
    "id": "def_aHbGAm8EglAfh076WIZs_6",
    "type": "definition",
    "topicId": "aHbGAm8EglAfh076WIZs",
    "unitId": "14Ox2maDLwQIYSUE3qmd",
    "courseId": "134DwgMfh8VYogm3gDyh",
    "content": {
      "term": "Sabır",
      "definition": "Karşılaşılan zorluklar, musibetler ve sıkıntılar karşısında metaneti koruyup direnç gösterme erdemi."
    },
    "updatedAt": "2026-09-16T18:37:15.391Z"
  },
  {
    "id": "def_aHbGAm8EglAfh076WIZs_7",
    "type": "definition",
    "topicId": "aHbGAm8EglAfh076WIZs",
    "unitId": "14Ox2maDLwQIYSUE3qmd",
    "courseId": "134DwgMfh8VYogm3gDyh",
    "content": {
      "term": "Dürüstlük",
      "definition": "Özü sözü bir olmak, yalandan kaçınmak ve ilişkilerde daima doğruluğu esas almak."
    },
    "updatedAt": "2026-09-16T18:37:15.391Z"
  },
  {
    "id": "def_aHbGAm8EglAfh076WIZs_8",
    "type": "definition",
    "topicId": "aHbGAm8EglAfh076WIZs",
    "unitId": "14Ox2maDLwQIYSUE3qmd",
    "courseId": "134DwgMfh8VYogm3gDyh",
    "content": {
      "term": "Tövbe",
      "definition": "Yapılan bir hatadan pişmanlık duyup bağışlanmayı dilemek ve aynı yanlışa dönmemeye karar vermek."
    },
    "updatedAt": "2026-09-16T18:37:15.391Z"
  },
  {
    "id": "def_aHbGAm8EglAfh076WIZs_9",
    "type": "definition",
    "topicId": "aHbGAm8EglAfh076WIZs",
    "unitId": "14Ox2maDLwQIYSUE3qmd",
    "courseId": "134DwgMfh8VYogm3gDyh",
    "content": {
      "term": "Kul Hakkı",
      "definition": "İnsanların birbiri üzerindeki maddi veya manevi nitelikteki hakları ve emeği."
    },
    "updatedAt": "2026-09-16T18:37:15.391Z"
  },
  {
    "id": "sentence_aHbGAm8EglAfh076WIZs_0",
    "type": "sentence",
    "topicId": "aHbGAm8EglAfh076WIZs",
    "unitId": "14Ox2maDLwQIYSUE3qmd",
    "courseId": "134DwgMfh8VYogm3gDyh",
    "content": {
      "text": "Melekler insanların iyi davranışlarını kaydeder."
    },
    "updatedAt": "2026-09-16T18:37:15.391Z"
  },
  {
    "id": "sentence_aHbGAm8EglAfh076WIZs_1",
    "type": "sentence",
    "topicId": "aHbGAm8EglAfh076WIZs",
    "unitId": "14Ox2maDLwQIYSUE3qmd",
    "courseId": "134DwgMfh8VYogm3gDyh",
    "content": {
      "text": "Ahiret inancı insan hayatına anlam katar."
    },
    "updatedAt": "2026-09-16T18:37:15.391Z"
  },
  {
    "id": "sentence_aHbGAm8EglAfh076WIZs_2",
    "type": "sentence",
    "topicId": "aHbGAm8EglAfh076WIZs",
    "unitId": "14Ox2maDLwQIYSUE3qmd",
    "courseId": "134DwgMfh8VYogm3gDyh",
    "content": {
      "text": "Sorumluluk sahibi insan adaletle hareket eder."
    },
    "updatedAt": "2026-09-16T18:37:15.391Z"
  },
  {
    "id": "sentence_aHbGAm8EglAfh076WIZs_3",
    "type": "sentence",
    "topicId": "aHbGAm8EglAfh076WIZs",
    "unitId": "14Ox2maDLwQIYSUE3qmd",
    "courseId": "134DwgMfh8VYogm3gDyh",
    "content": {
      "text": "Dünya hayatı bir imtihan alanıdır."
    },
    "updatedAt": "2026-09-16T18:37:15.391Z"
  },
  {
    "id": "sentence_aHbGAm8EglAfh076WIZs_4",
    "type": "sentence",
    "topicId": "aHbGAm8EglAfh076WIZs",
    "unitId": "14Ox2maDLwQIYSUE3qmd",
    "courseId": "134DwgMfh8VYogm3gDyh",
    "content": {
      "text": "İyilik yapan insan huzur ve mutluluk duyar."
    },
    "updatedAt": "2026-09-16T18:37:15.391Z"
  },
  {
    "id": "sentence_aHbGAm8EglAfh076WIZs_5",
    "type": "sentence",
    "topicId": "aHbGAm8EglAfh076WIZs",
    "unitId": "14Ox2maDLwQIYSUE3qmd",
    "courseId": "134DwgMfh8VYogm3gDyh",
    "content": {
      "text": "Dürüst davranmak insanın manevi gücünü artırır."
    },
    "updatedAt": "2026-09-16T18:37:15.391Z"
  },
  {
    "id": "sentence_aHbGAm8EglAfh076WIZs_6",
    "type": "sentence",
    "topicId": "aHbGAm8EglAfh076WIZs",
    "unitId": "14Ox2maDLwQIYSUE3qmd",
    "courseId": "134DwgMfh8VYogm3gDyh",
    "content": {
      "text": "Ahirete inanan insan zorluklara sabreder."
    },
    "updatedAt": "2026-09-16T18:37:15.391Z"
  },
  {
    "id": "sentence_aHbGAm8EglAfh076WIZs_7",
    "type": "sentence",
    "topicId": "aHbGAm8EglAfh076WIZs",
    "unitId": "14Ox2maDLwQIYSUE3qmd",
    "courseId": "134DwgMfh8VYogm3gDyh",
    "content": {
      "text": "İman eden birey kul hakkına dikkat eder."
    },
    "updatedAt": "2026-09-16T18:37:15.391Z"
  },
  {
    "id": "sentence_aHbGAm8EglAfh076WIZs_8",
    "type": "sentence",
    "topicId": "aHbGAm8EglAfh076WIZs",
    "unitId": "14Ox2maDLwQIYSUE3qmd",
    "courseId": "134DwgMfh8VYogm3gDyh",
    "content": {
      "text": "Meleklere inanmak insanı kötülüklerden korur."
    },
    "updatedAt": "2026-09-16T18:37:15.391Z"
  },
  {
    "id": "sentence_aHbGAm8EglAfh076WIZs_9",
    "type": "sentence",
    "topicId": "aHbGAm8EglAfh076WIZs",
    "unitId": "14Ox2maDLwQIYSUE3qmd",
    "courseId": "134DwgMfh8VYogm3gDyh",
    "content": {
      "text": "Güzel ahlak sahibi insan çevresine güven verir."
    },
    "updatedAt": "2026-09-16T18:37:15.391Z"
  }
]