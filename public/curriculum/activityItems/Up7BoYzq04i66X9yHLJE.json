  {
    "id": "def_Up7BoYzq04i66X9yHLJE_0",
    "type": "definition",
    "topicId": "Up7BoYzq04i66X9yHLJE",
    "unitId": "KXaDVYOgeUiDEerxQ7jR",
    "courseId": "OgnmTvY8rxVpEIP45iq4",
    "content": {
      "term": "Taharet",
      "definition": "Dinen pis kabul edilen şeyleri su veya temizleyici başka şeylerle temizleme."
    },
    "updatedAt": "2026-10-05T19:12:50.426Z"
  },
  {
    "id": "def_Up7BoYzq04i66X9yHLJE_1",
    "type": "definition",
    "topicId": "Up7BoYzq04i66X9yHLJE",
    "unitId": "KXaDVYOgeUiDEerxQ7jR",
    "courseId": "OgnmTvY8rxVpEIP45iq4",
    "content": {
      "term": "Manevi Temizlik",
      "definition": "Kalbi kötü düşünce ve duygulardan arındırma, günahlardan tövbe etme."
    },
    "updatedAt": "2026-10-05T19:12:50.426Z"
  },
  {
    "id": "def_Up7BoYzq04i66X9yHLJE_2",
    "type": "definition",
    "topicId": "Up7BoYzq04i66X9yHLJE",
    "unitId": "KXaDVYOgeUiDEerxQ7jR",
    "courseId": "OgnmTvY8rxVpEIP45iq4",
    "content": {
      "term": "Misvak",
      "definition": "Peygamberimizin de kullandığı, ağız ve diş temizliği için kullanılan araç."
    },
    "updatedAt": "2026-10-05T19:12:50.426Z"
  },
  {
    "id": "def_Up7BoYzq04i66X9yHLJE_3",
    "type": "definition",
    "topicId": "Up7BoYzq04i66X9yHLJE",
    "unitId": "KXaDVYOgeUiDEerxQ7jR",
    "courseId": "OgnmTvY8rxVpEIP45iq4",
    "content": {
      "term": "Tövbe",
      "definition": "İşlenen günahlardan pişmanlık duyup Allah'a yönelme."
    },
    "updatedAt": "2026-10-05T19:12:50.426Z"
  },
  {
    "id": "def_Up7BoYzq04i66X9yHLJE_4",
    "type": "definition",
    "topicId": "Up7BoYzq04i66X9yHLJE",
    "unitId": "KXaDVYOgeUiDEerxQ7jR",
    "courseId": "OgnmTvY8rxVpEIP45iq4",
    "content": {
      "term": "Maddi Temizlik",
      "definition": "Beden, elbise ve çevre temizliği gibi görünen kirlerden arınma."
    },
    "updatedAt": "2026-10-05T19:12:50.426Z"
  },
  {
    "id": "def_Up7BoYzq04i66X9yHLJE_5",
    "type": "definition",
    "topicId": "Up7BoYzq04i66X9yHLJE",
    "unitId": "KXaDVYOgeUiDEerxQ7jR",
    "courseId": "OgnmTvY8rxVpEIP45iq4",
    "content": {
      "term": "Gusül",
      "definition": "Bütün bedenin yıkanması, boy abdesti."
    },
    "updatedAt": "2026-10-05T19:12:50.426Z"
  },
  {
    "id": "def_Up7BoYzq04i66X9yHLJE_6",
    "type": "definition",
    "topicId": "Up7BoYzq04i66X9yHLJE",
    "unitId": "KXaDVYOgeUiDEerxQ7jR",
    "courseId": "OgnmTvY8rxVpEIP45iq4",
    "content": {
      "term": "Abdest",
      "definition": "Namaz gibi ibadetlerden önce alınan, bedenin bazı bölgelerinin yıkanması."
    },
    "updatedAt": "2026-10-05T19:12:50.426Z"
  },
  {
    "id": "sentence_Up7BoYzq04i66X9yHLJE_0",
    "type": "sentence",
    "topicId": "Up7BoYzq04i66X9yHLJE",
    "unitId": "KXaDVYOgeUiDEerxQ7jR",
    "courseId": "OgnmTvY8rxVpEIP45iq4",
    "content": {
      "text": "Elbise temizliği, namaz gibi ibadetler için bir ön şarttır."
    },
    "updatedAt": "2026-10-05T19:12:50.426Z"
  },
  {
    "id": "sentence_Up7BoYzq04i66X9yHLJE_1",
    "type": "sentence",
    "topicId": "Up7BoYzq04i66X9yHLJE",
    "unitId": "KXaDVYOgeUiDEerxQ7jR",
    "courseId": "OgnmTvY8rxVpEIP45iq4",
    "content": {
      "text": "Ağız ve diş temizliği, beden temizliği, elbise temizliği ve çevre temizliği önemlidir."
    },
    "updatedAt": "2026-10-05T19:12:50.426Z"
  },
  {
    "id": "sentence_Up7BoYzq04i66X9yHLJE_2",
    "type": "sentence",
    "topicId": "Up7BoYzq04i66X9yHLJE",
    "unitId": "KXaDVYOgeUiDEerxQ7jR",
    "courseId": "OgnmTvY8rxVpEIP45iq4",
    "content": {
      "text": "Temizlik, hem fiziksel hem de ruhsal sağlığımız için önemlidir ve İslam'da imanın yarısı olarak kabul edilir."
    },
    "updatedAt": "2026-10-05T19:12:50.426Z"
  },
  {
    "id": "sentence_Up7BoYzq04i66X9yHLJE_3",
    "type": "sentence",
    "topicId": "Up7BoYzq04i66X9yHLJE",
    "unitId": "KXaDVYOgeUiDEerxQ7jR",
    "courseId": "OgnmTvY8rxVpEIP45iq4",
    "content": {
      "text": "Peygamberimiz, temizliğe büyük önem vermiş ve bunu hem sözleriyle hem de uygulamalarıyla göstermiştir."
    },
    "updatedAt": "2026-10-05T19:12:50.426Z"
  },
  {
    "id": "sentence_Up7BoYzq04i66X9yHLJE_4",
    "type": "sentence",
    "topicId": "Up7BoYzq04i66X9yHLJE",
    "unitId": "KXaDVYOgeUiDEerxQ7jR",
    "courseId": "OgnmTvY8rxVpEIP45iq4",
    "content": {
      "text": "Maddi temizlik beden, elbise ve çevre temizliğini kapsar."
    },
    "updatedAt": "2026-10-05T19:12:50.426Z"
  },
  {
    "id": "sentence_Up7BoYzq04i66X9yHLJE_5",
    "type": "sentence",
    "topicId": "Up7BoYzq04i66X9yHLJE",
    "unitId": "KXaDVYOgeUiDEerxQ7jR",
    "courseId": "OgnmTvY8rxVpEIP45iq4",
    "content": {
      "text": "Temizlik, İslam'da imanin yarısı olarak kabul edilir ve hem maddi hem manevi yönleri vardır."
    },
    "updatedAt": "2026-10-05T19:12:50.426Z"
  },
  {
    "id": "sentence_Up7BoYzq04i66X9yHLJE_6",
    "type": "sentence",
    "topicId": "Up7BoYzq04i66X9yHLJE",
    "unitId": "KXaDVYOgeUiDEerxQ7jR",
    "courseId": "OgnmTvY8rxVpEIP45iq4",
    "content": {
      "text": "Ağız ve diş temizliği, beden temizliğinin önemli bir parçasıdır ve Peygamberimiz misvak kullanımını tavsiye etmiştir."
    },
    "updatedAt": "2026-10-05T19:12:50.426Z"
  },
  {
    "id": "sentence_Up7BoYzq04i66X9yHLJE_7",
    "type": "sentence",
    "topicId": "Up7BoYzq04i66X9yHLJE",
    "unitId": "KXaDVYOgeUiDEerxQ7jR",
    "courseId": "OgnmTvY8rxVpEIP45iq4",
    "content": {
      "text": "Peygamberimiz temizliğe çok önem vermiş ve insanlara örnek olmuştur."
    },
    "updatedAt": "2026-10-05T19:12:50.426Z"
  },
  {
    "id": "sentence_Up7BoYzq04i66X9yHLJE_8",
    "type": "sentence",
    "topicId": "Up7BoYzq04i66X9yHLJE",
    "unitId": "KXaDVYOgeUiDEerxQ7jR",
    "courseId": "OgnmTvY8rxVpEIP45iq4",
    "content": {
      "text": "Manevi temizlik ise kalbi kötü düşüncelerden arındırmayı ve günahlardan tövbe etmeyi içerir."
    },
    "updatedAt": "2026-10-05T19:12:50.426Z"
  },
  {
    "id": "sentence_Up7BoYzq04i66X9yHLJE_9",
    "type": "sentence",
    "topicId": "Up7BoYzq04i66X9yHLJE",
    "unitId": "KXaDVYOgeUiDEerxQ7jR",
    "courseId": "OgnmTvY8rxVpEIP45iq4",
    "content": {
      "text": "Maddi temizlik, bedenimizi, kıyafetlerimizi ve çevrimizi temiz tutmayı içerir."
    },
    "updatedAt": "2026-10-05T19:12:50.426Z"
  },
  {
    "id": "sentence_Up7BoYzq04i66X9yHLJE_10",
    "type": "sentence",
    "topicId": "Up7BoYzq04i66X9yHLJE",
    "unitId": "KXaDVYOgeUiDEerxQ7jR",
    "courseId": "OgnmTvY8rxVpEIP45iq4",
    "content": {
      "text": "Manevi temizlik ise kalbimizi kötü düşüncelerden ve günahlardan arındırmayı ifade eder."
    },
    "updatedAt": "2026-10-05T19:12:50.426Z"
  },
  {
    "id": "sentence_Up7BoYzq04i66X9yHLJE_11",
    "type": "sentence",
    "topicId": "Up7BoYzq04i66X9yHLJE",
    "unitId": "KXaDVYOgeUiDEerxQ7jR",
    "courseId": "OgnmTvY8rxVpEIP45iq4",
    "content": {
      "text": "Abdest, namazdan önce alınır ve hem maddi hem manevi temizlik sağlar."
    },
    "updatedAt": "2026-10-05T19:12:50.426Z"
  },
  {
    "id": "sentence_Up7BoYzq04i66X9yHLJE_12",
    "type": "sentence",
    "topicId": "Up7BoYzq04i66X9yHLJE",
    "unitId": "KXaDVYOgeUiDEerxQ7jR",
    "courseId": "OgnmTvY8rxVpEIP45iq4",
    "content": {
      "text": "Gusül, tüm vücudu yıkamak anlamına gelir ve belirli durumlarda gereklidir."
    },
    "updatedAt": "2026-10-05T19:12:50.426Z"
  },
  {
    "id": "sentence_Up7BoYzq04i66X9yHLJE_13",
    "type": "sentence",
    "topicId": "Up7BoYzq04i66X9yHLJE",
    "unitId": "KXaDVYOgeUiDEerxQ7jR",
    "courseId": "OgnmTvY8rxVpEIP45iq4",
    "content": {
      "text": "Tövbe etmek, manevi temizliğin önemli bir yoludur ve günahlardan arınmayı sağlar."
    },
    "updatedAt": "2026-10-05T19:12:50.426Z"
  },
  {
    "id": "sentence_Up7BoYzq04i66X9yHLJE_14",
    "type": "sentence",
    "topicId": "Up7BoYzq04i66X9yHLJE",
    "unitId": "KXaDVYOgeUiDEerxQ7jR",
    "courseId": "OgnmTvY8rxVpEIP45iq4",
    "content": {
      "text": "Çevre temizliği, tüm canlıların sağlığı için önemlidir ve bir ibadet olarak kabul edilir."
    },
    "updatedAt": "2026-10-05T19:12:50.426Z"
  }
]