    "isPublished": false,
    "type": "htmlSlide",
    "title": "İnteraktif Sunum",
    "htmlContent": "<!DOCTYPE html>\n<html lang=\"tr\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Merhametli Olmak - Ders Sunumu</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <link href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css\" rel=\"stylesheet\">\n    <link href=\"https://fonts.googleapis.com/css2?family=Pacifico&family=Quicksand:wght@300;500;700&display=swap\" rel=\"stylesheet\">\n\n    <style>\n        body {\n            font-family: 'Quicksand', sans-serif;\n            background-color: #0f172a;\n            color: #f8fafc;\n            overflow: hidden;\n        }\n        h1, h2 { font-family: 'Pacifico', cursive; letter-spacing: 2px; }\n\n        /* SLAYT YAPISI */\n        .slide {\n            display: none !important;\n            opacity: 0;\n            transition: opacity 0.8s ease-in-out;\n            position: absolute;\n            inset: 0;\n            padding: 0;\n            flex-direction: column;\n            justify-content: center;\n            align-items: center;\n            z-index: 1;\n        }\n        .slide.active {\n            display: flex !important;\n            opacity: 1;\n            z-index: 10;\n        }\n\n        /* CAM KARTLAR */\n        .glass-panel {\n            width: 90vw;\n            height: 85vh;\n            background: rgba(255, 255, 255, 0.05);\n            backdrop-filter: blur(20px);\n            border: 1px solid rgba(255, 255, 255, 0.1);\n            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);\n            border-radius: 2rem;\n            display: flex;\n            flex-direction: column;\n            justify-content: center;\n            align-items: center;\n            padding: 3rem;\n            position: relative;\n        }\n\n        /* ANİMASYONLAR */\n        .fade-up { animation: fadeUp 1s forwards; opacity: 0; transform: translateY(30px); }\n        .delay-1 { animation-delay: 0.2s; }\n        .delay-2 { animation-delay: 0.4s; }\n        .delay-3 { animation-delay: 0.6s; }\n\n        @keyframes fadeUp { to { opacity: 1; transform: translateY(0); } }\n\n        /* ARKA PLAN */\n        .bg-gradient-nature {\n            background-image: radial-gradient(circle at center, #14532d 0%, #020617 100%);\n        }\n    </style>\n</head>\n<body class=\"h-screen w-screen relative bg-gradient-nature\">\n\n    <!-- Dekoratif -->\n    <div class=\"absolute top-0 left-0 w-[40vw] h-[40vw] bg-emerald-600/10 rounded-full blur-[150px] pointer-events-none\"></div>\n    <div class=\"absolute bottom-0 right-0 w-[40vw] h-[40vw] bg-teal-600/10 rounded-full blur-[150px] pointer-events-none\"></div>\n\n    <!-- Navigasyon -->\n    <div class=\"absolute bottom-6 right-8 z-50 flex gap-6\">\n        <button onclick=\"changeSlide(-1)\" class=\"w-16 h-16 rounded-full bg-white/10 hover:bg-white/20 flex items-center justify-center transition border border-white/20 text-2xl\"><i class=\"fas fa-chevron-left\"></i></button>\n        <span id=\"slide-num\" class=\"flex items-center font-bold text-emerald-200 text-2xl w-16 justify-center\">1/7</span>\n        <button onclick=\"changeSlide(1)\" class=\"w-16 h-16 rounded-full bg-white/10 hover:bg-white/20 flex items-center justify-center transition border border-white/20 text-2xl\"><i class=\"fas fa-chevron-right\"></i></button>\n    </div>\n\n    <!-- SLAYT 1: KAPAK -->\n    <div class=\"slide active\">\n        <div class=\"glass-panel border-t-8 border-emerald-500 fade-up\">\n            <div class=\"inline-block bg-emerald-500/20 p-10 rounded-full mb-8 animate-bounce\">\n                <i class=\"fas fa-dove text-8xl text-emerald-300\"></i>\n            </div>\n            <h1 class=\"text-7xl lg:text-9xl font-extrabold mb-6 text-transparent bg-clip-text bg-gradient-to-r from-emerald-200 to-white\">\n                Merhametli Olmak\n            </h1>\n            <h2 class=\"text-3xl text-gray-300 font-light mb-8 text-center max-w-4xl font-sans\">\n                \"Yeryüzündekilere merhamet edin ki gökyüzündekiler de size merhamet etsin.\"\n            </h2>\n            <div class=\"bg-white/5 px-10 py-4 rounded-full border border-white/10\">\n                <span class=\"text-xl text-emerald-200 font-bold\">3. ÜNİTE</span>\n            </div>\n        </div>\n    </div>\n\n    <!-- SLAYT 2: KUŞ EVLERİ (GİRİŞ) -->\n    <div class=\"slide\">\n        <div class=\"glass-panel fade-up\">\n            <h2 class=\"text-5xl font-bold mb-10 text-emerald-100 border-b-2 border-emerald-500/50 pb-4\">Osmanlı'da Merhamet ve Estetik</h2>\n            <div class=\"flex gap-12 items-center w-full max-w-7xl\">\n                <div class=\"w-1/3 text-center\">\n                    <div class=\"w-64 h-64 bg-white/10 rounded-full flex items-center justify-center mx-auto border-4 border-emerald-500/30\">\n                        <i class=\"fas fa-home text-9xl text-emerald-400\"></i>\n                    </div>\n                    <p class=\"mt-6 text-2xl font-bold text-emerald-300\">Kuş Evleri</p>\n                </div>\n                <div class=\"w-2/3 space-y-6 text-2xl text-gray-300 leading-relaxed font-sans\">\n                    <p><i class=\"fas fa-leaf text-xs text-emerald-500 mr-3\"></i> Osmanlı mimarisinde, kuşların barınması için binaların dış cephelerine zarif evler yapılırdı.</p>\n                    <p><i class=\"fas fa-leaf text-xs text-emerald-500 mr-3\"></i> Bu, ecdadımızın sadece insanlara değil, <strong>tüm canlılara</strong> duyduğu merhametin en güzel göstergesidir.</p>\n                    <p><i class=\"fas fa-leaf text-xs text-emerald-500 mr-3\"></i> Merhamet; korumaktır, yaşatmaktır, incelik göstermektir.</p>\n                </div>\n            </div>\n        </div>\n    </div>\n\n    <!-- SLAYT 3: TANIM VE KAVRAMLAR -->\n    <div class=\"slide\">\n        <div class=\"glass-panel fade-up\">\n            <h2 class=\"text-5xl font-bold mb-12 text-emerald-200\">Merhamet Nedir?</h2>\n            <div class=\"grid grid-cols-2 gap-10 w-full max-w-6xl font-sans\">\n                <div class=\"bg-white/5 p-10 rounded-3xl border border-white/10 hover:bg-white/10 transition\">\n                    <h3 class=\"text-3xl font-bold text-emerald-400 mb-6\"><i class=\"fas fa-book-open mr-2\"></i>Tanım</h3>\n                    <p class=\"text-xl text-gray-300 leading-relaxed\">\n                        Şefkat gösterme, acıma, yumuşak huylu olma, affetme ve bağışlamadır. Karşımızdaki canlıyı bir \"can\" olarak kabul etmektir.\n                    </p>\n                </div>\n                <div class=\"bg-white/5 p-10 rounded-3xl border border-white/10 hover:bg-white/10 transition\">\n                    <h3 class=\"text-3xl font-bold text-yellow-400 mb-6\"><i class=\"fas fa-link mr-2\"></i>İlişkili Kavramlar</h3>\n                    <ul class=\"text-xl text-gray-300 space-y-4\">\n                        <li><strong class=\"text-white\">Sevgi:</strong> Merhametin kaynağıdır.</li>\n                        <li><strong class=\"text-white\">Şefkat:</strong> Merhametin eyleme dönüşmüş halidir.</li>\n                        <li><strong class=\"text-white\">Vicdan:</strong> Acılar karşısında duyarlı olmaktır.</li>\n                        <li><strong class=\"text-white\">Empati:</strong> Kendini başkasının yerine koymaktır.</li>\n                    </ul>\n                </div>\n            </div>\n        </div>\n    </div>\n\n    <!-- SLAYT 4: ALLAH'IN İSİMLERİ (RAHMAN VE RAHİM) -->\n    <div class=\"slide\">\n        <div class=\"glass-panel fade-up\">\n            <h2 class=\"text-5xl font-bold mb-10 text-teal-200\">Allah'ın Rahmeti</h2>\n            <p class=\"text-2xl text-gray-400 mb-12 font-sans italic\">\"Bismillâhirraḥmânirraḥîm\"</p>\n            \n            <div class=\"flex gap-10 w-full max-w-6xl font-sans\">\n                <!-- RAHMAN -->\n                <div class=\"flex-1 bg-gradient-to-br from-orange-500/20 to-transparent p-10 rounded-3xl border-l-8 border-orange-500 text-center\">\n                    <h3 class=\"text-4xl font-bold text-orange-400 mb-4\">RAHMAN</h3>\n                    <i class=\"fas fa-globe-americas text-6xl text-orange-300/50 mb-6\"></i>\n                    <p class=\"text-xl text-gray-200\">\n                        Dünyada, inanan-inanmayan ayrımı yapmadan <strong>bütün varlıklara</strong> merhamet etmesidir. Güneşin herkesi ısıtması gibi.\n                    </p>\n                </div>\n\n                <!-- RAHİM -->\n                <div class=\"flex-1 bg-gradient-to-br from-blue-500/20 to-transparent p-10 rounded-3xl border-l-8 border-blue-500 text-center\">\n                    <h3 class=\"text-4xl font-bold text-blue-400 mb-4\">RAHİM</h3>\n                    <i class=\"fas fa-pray text-6xl text-blue-300/50 mb-6\"></i>\n                    <p class=\"text-xl text-gray-200\">\n                        Ahirette <strong>sadece inananlara</strong> merhamet etmesi ve onları bağışlayacak olmasıdır.\n                    </p>\n                </div>\n            </div>\n        </div>\n    </div>\n\n    <!-- SLAYT 5: PEYGAMBERİMİZ -->\n    <div class=\"slide\">\n        <div class=\"glass-panel fade-up border-t-8 border-pink-500\">\n            <h2 class=\"text-5xl font-bold mb-12 text-pink-200\">Alemlere Rahmet</h2>\n            \n            <div class=\"flex flex-col items-center gap-8 text-center max-w-5xl font-sans\">\n                <div class=\"text-8xl text-pink-400\"><i class=\"fas fa-hand-holding-heart\"></i></div>\n                <p class=\"text-3xl font-light leading-relaxed\">\n                    \"Ve seni ancak <strong>âlemlere rahmet</strong> olarak gönderdik.\"\n                    <br><span class=\"text-lg text-gray-400 mt-2\">(Enbiya Suresi, 107. Ayet)</span>\n                </p>\n                \n                <div class=\"grid grid-cols-2 gap-6 mt-8 w-full text-left\">\n                    <div class=\"bg-white/5 p-6 rounded-xl\">\n                        <p class=\"text-xl text-gray-300\">Ümmetinin sıkıntıya düşmesi ona çok ağır gelir.</p>\n                    </div>\n                    <div class=\"bg-white/5 p-6 rounded-xl\">\n                        <p class=\"text-xl text-gray-300\">Müminlere karşı çok şefkatli ve merhametlidir.</p>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n\n    <!-- SLAYT 6: GÜNCEL ÖRNEK (MİRAÇ DURSUN) -->\n    <div class=\"slide\">\n        <div class=\"glass-panel fade-up\">\n            <h2 class=\"text-5xl font-bold mb-8 text-yellow-200\">Küçük Kalpler, Büyük Merhamet</h2>\n            \n            <div class=\"flex gap-10 w-full max-w-7xl h-full items-center\">\n                <div class=\"w-1/3 text-center\">\n                    <div class=\"w-48 h-48 bg-yellow-500 rounded-full flex items-center justify-center mx-auto text-black text-6xl font-bold border-8 border-yellow-300\">\n                        10\n                    </div>\n                    <p class=\"mt-4 text-xl text-yellow-400 font-bold\">Yaşında Bir Kahraman</p>\n                </div>\n\n                <div class=\"w-2/3 bg-white/5 p-10 rounded-3xl border border-white/10 font-sans\">\n                    <h3 class=\"text-3xl font-bold text-white mb-6\">Miraç Dursun'un Hikayesi</h3>\n                    <p class=\"text-xl text-gray-300 leading-relaxed mb-6\">\n                        Kahramanmaraş merkezli depremlerde, Erzurum'da yaşayan 10 yaşındaki Miraç, okul çıkışı oyun oynamak yerine yardım merkezine koştu.\n                    </p>\n                    <ul class=\"text-lg text-gray-300 space-y-3\">\n                        <li><i class=\"fas fa-check-circle text-green-500 mr-2\"></i> Yardım kolilerini paketledi.</li>\n                        <li><i class=\"fas fa-check-circle text-green-500 mr-2\"></i> Depremzede çocuklarla oyun oynayıp moral verdi.</li>\n                        <li><i class=\"fas fa-check-circle text-green-500 mr-2\"></i> Merhametin yaşı olmadığını gösterdi.</li>\n                    </ul>\n                </div>\n            </div>\n        </div>\n    </div>\n\n    <!-- SLAYT 7: SONUÇ VE ÖZET -->\n    <div class=\"slide\">\n        <div class=\"glass-panel text-center fade-up border-t-8 border-white\">\n            <h1 class=\"text-7xl font-bold mb-8 text-white\">ÖZETLE</h1>\n            <div class=\"grid grid-cols-2 gap-8 text-left max-w-5xl mx-auto mb-12 font-sans\">\n                <div class=\"bg-white/10 p-8 rounded-2xl flex items-center gap-4\">\n                    <i class=\"fas fa-heart text-red-400 text-4xl\"></i>\n                    <span class=\"text-xl\">Merhamet, insanı insan yapan temel değerdir.</span>\n                </div>\n                <div class=\"bg-white/10 p-8 rounded-2xl flex items-center gap-4\">\n                    <i class=\"fas fa-bug text-green-400 text-4xl\"></i>\n                    <span class=\"text-xl\">\"Karıncayı bile incitmemek\" kültürümüzün parçasıdır.</span>\n                </div>\n                <div class=\"bg-white/10 p-8 rounded-2xl flex items-center gap-4\">\n                    <i class=\"fas fa-hands-helping text-blue-400 text-4xl\"></i>\n                    <span class=\"text-xl\">Toplumsal dayanışma merhametle sağlanır.</span>\n                </div>\n                <div class=\"bg-white/10 p-8 rounded-2xl flex items-center gap-4\">\n                    <i class=\"fas fa-dove text-white text-4xl\"></i>\n                    <span class=\"text-xl\">Allah Rahman ve Rahimdir; merhamet edenleri sever.</span>\n                </div>\n            </div>\n            <button onclick=\"changeSlide(-6)\" class=\"px-12 py-5 bg-emerald-600 hover:bg-emerald-500 rounded-full font-bold transition shadow-2xl text-white text-2xl transform hover:scale-105\">\n                <i class=\"fas fa-redo mr-4\"></i> Başa Dön\n            </button>\n        </div>\n    </div>\n\n    <script>\n        let currentSlide = 0;\n        const slides = document.querySelectorAll('.slide');\n        const numDisplay = document.getElementById('slide-num');\n\n        function updateSlide() {\n            slides.forEach((s, i) => {\n                s.classList.remove('active');\n                if(i === currentSlide) {\n                    s.classList.add('active');\n                    const anims = s.querySelectorAll('.fade-up');\n                    anims.forEach(el => {\n                        el.style.animation = 'none';\n                        el.offsetHeight; \n                        el.style.animation = null; \n                    });\n                }\n            });\n            numDisplay.innerText = `${currentSlide + 1}/${slides.length}`;\n        }\n\n        function changeSlide(n) {\n            let next = currentSlide + n;\n            if(next >= 0 && next < slides.length) {\n                currentSlide = next;\n                updateSlide();\n            }\n        }\n\n        document.addEventListener('keydown', (e) => {\n            if(e.key === 'ArrowRight' || e.key === ' ') changeSlide(1);\n            if(e.key === 'ArrowLeft') changeSlide(-1);\n        });\n\n        updateSlide();\n    </script>\n</body>\n</html>",
    "content": {
