    "title": "İnteraktif Sunum",
    "type": "htmlSlide",
    "htmlContent": "<!DOCTYPE html>\n<html lang=\"tr\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no\">\n    <title>Merhamet Oyun Merkezi</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <link href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css\" rel=\"stylesheet\">\n    <link href=\"https://fonts.googleapis.com/css2?family=Fredoka:wght@400;600&family=Quicksand:wght@400;700&display=swap\" rel=\"stylesheet\">\n\n    <style>\n        body { font-family: 'Quicksand', sans-serif; background-color: #111827; color: white; touch-action: manipulation; overflow: hidden; }\n        h1, h2 { font-family: 'Fredoka', sans-serif; }\n\n        /* HEADER */\n        .header-btn { padding: 15px 30px; border-radius: 12px; font-size: 1.1rem; background: rgba(255,255,255,0.05); transition: all 0.3s; font-weight: bold; border: 1px solid rgba(255,255,255,0.1); display: flex; align-items: center; gap: 10px; }\n        .header-btn.active { background: #059669; border-color: #34d399; box-shadow: 0 0 20px rgba(5, 150, 105, 0.5); transform: scale(1.05); }\n\n        /* OYUN 1: KUŞ EVİ İNŞAAT (DOĞRU/YANLIŞ) */\n        .brick-btn {\n            background: #eab308; color: #451a03; border: 4px solid #a16207;\n            padding: 20px; font-weight: bold; font-size: 1.2rem; cursor: pointer;\n            transition: all 0.2s; border-radius: 8px; width: 100%;\n        }\n        .brick-btn:hover { transform: scale(1.02); background: #facc15; }\n        .birdhouse-stage { width: 300px; height: 300px; background-size: contain; background-repeat: no-repeat; background-position: center; transition: all 0.5s; opacity: 0.5; filter: grayscale(100%); }\n        .birdhouse-stage.built { opacity: 1; filter: grayscale(0%); }\n\n        /* OYUN 2: EŞLEŞTİRME */\n        .match-item { padding: 1.5rem; font-size: 1.2rem; border-radius: 1rem; cursor: pointer; transition: all 0.2s; border: 1px solid rgba(255,255,255,0.1); background: #1f2937; }\n        .match-item:hover { background: #374151; transform: translateX(5px); }\n        .match-item.selected { background: #f59e0b !important; color: black; border-color: #fbbf24; transform: scale(1.02); }\n        .match-item.matched { background: #10b981 !important; opacity: 0.5; pointer-events: none; }\n        .match-item.wrong { animation: shake 0.4s; background: #ef4444 !important; }\n\n        /* OYUN 3: SENARYO */\n        .scenario-btn { text-align: left; padding: 1.5rem; font-size: 1.2rem; background: rgba(255,255,255,0.05); border-radius: 1rem; border: 1px solid rgba(255,255,255,0.1); transition: all 0.2s; }\n        .scenario-btn:hover { background: rgba(255,255,255,0.15); transform: translateY(-2px); }\n        .scenario-btn.correct { background: #059669; border-color: #34d399; }\n        .scenario-btn.wrong { background: #b91c1c; border-color: #f87171; }\n\n        @keyframes shake { 0%, 100% { transform: translateX(0); } 25% { transform: translateX(-5px); } 75% { transform: translateX(5px); } }\n    </style>\n</head>\n<body class=\"h-screen w-screen flex flex-col\">\n\n    <!-- Header -->\n    <header class=\"bg-slate-900 p-6 shadow-2xl flex justify-between items-center z-50 h-[100px]\">\n        <h1 class=\"text-3xl text-emerald-400 font-bold\"><i class=\"fas fa-dove mr-3\"></i>MERHAMET OYUNLARI</h1>\n        <div class=\"flex gap-4\">\n            <button onclick=\"switchTab('game1')\" id=\"btn-game1\" class=\"header-btn active\"><i class=\"fas fa-home\"></i> Kuş Evi Kur</button>\n            <button onclick=\"switchTab('game2')\" id=\"btn-game2\" class=\"header-btn\"><i class=\"fas fa-link\"></i> Eşleştirme</button>\n            <button onclick=\"switchTab('game3')\" id=\"btn-game3\" class=\"header-btn\"><i class=\"fas fa-question-circle\"></i> Sen Olsan?</button>\n        </div>\n    </header>\n\n    <!-- Oyun Alanı -->\n    <div id=\"game-container\" class=\"w-full h-[calc(100vh-100px)] flex justify-center items-center p-4\">\n        \n        <!-- OYUN 1: KUŞ EVİ İNŞAAT -->\n        <div id=\"game1\" class=\"w-full max-w-6xl flex gap-12 items-center\">\n            <div class=\"w-1/2 text-center\">\n                <h2 class=\"text-4xl font-bold mb-6 text-yellow-400\">Merhametli Davranışları Seç</h2>\n                <p class=\"text-xl text-gray-400 mb-8\">Doğruyu seçersen Kuş Evi inşa edilecek!</p>\n                <div id=\"quiz-area\" class=\"bg-slate-800 p-8 rounded-2xl border border-slate-700\">\n                    <h3 class=\"text-2xl font-bold mb-6\" id=\"bh-question\">...</h3>\n                    <div class=\"grid grid-cols-2 gap-4\">\n                        <button onclick=\"checkBH(true)\" class=\"brick-btn bg-green-600 border-green-800 text-white\">DOĞRU</button>\n                        <button onclick=\"checkBH(false)\" class=\"brick-btn bg-red-600 border-red-800 text-white\">YANLIŞ</button>\n                    </div>\n                </div>\n            </div>\n            <div class=\"w-1/2 flex flex-col items-center justify-center relative\">\n                <!-- Temsili Kuş Evi Aşamaları (İkonlarla) -->\n                <i id=\"house-icon\" class=\"fas fa-home text-[300px] text-emerald-600 transition-all duration-1000 opacity-20 transform scale-50\"></i>\n                <div id=\"birds\" class=\"absolute top-0 opacity-0 transition duration-1000\">\n                    <i class=\"fas fa-dove text-4xl text-white absolute -top-10 left-10\"></i>\n                    <i class=\"fas fa-dove text-3xl text-white absolute top-10 -right-10\"></i>\n                </div>\n                <p id=\"progress-text\" class=\"mt-8 text-2xl font-bold text-emerald-400\">İnşaat: %0</p>\n            </div>\n        </div>\n\n        <!-- OYUN 2: EŞLEŞTİRME -->\n        <div id=\"game2\" class=\"hidden w-full h-full flex flex-col items-center justify-center\">\n            <div class=\"text-center mb-10\">\n                <h2 class=\"text-4xl font-bold mb-4 text-emerald-200\">Kavramları Eşleştir</h2>\n                <p class=\"text-xl text-gray-400\">Tanımları ve isimleri doğru eşleştir.</p>\n            </div>\n            <div class=\"grid grid-cols-2 gap-16 w-full max-w-6xl\">\n                <div class=\"flex flex-col gap-4\" id=\"col-defs\"></div>\n                <div class=\"flex flex-col gap-4\" id=\"col-terms\"></div>\n            </div>\n            <div id=\"msg2\" class=\"text-center mt-10 text-4xl font-bold hidden text-green-400\">Harika! Hepsini eşleştirdin.</div>\n        </div>\n\n        <!-- OYUN 3: SENARYO -->\n        <div id=\"game3\" class=\"hidden w-full max-w-4xl\">\n            <div class=\"text-center mb-10\">\n                <h2 class=\"text-4xl font-bold mb-4 text-yellow-200\">Merhamet Ne Gerektirir?</h2>\n                <p class=\"text-xl text-gray-400\">Olaylara merhametli bir kalp ile yaklaş.</p>\n            </div>\n            <div id=\"scenario-card\" class=\"bg-slate-800 p-10 rounded-3xl border border-slate-700 shadow-2xl\"></div>\n        </div>\n\n    </div>\n\n    <script>\n        function switchTab(id) {\n            ['game1', 'game2', 'game3'].forEach(g => document.getElementById(g).classList.add('hidden'));\n            ['btn-game1', 'btn-game2', 'btn-game3'].forEach(b => document.getElementById(b).classList.remove('active'));\n            \n            document.getElementById(id).classList.remove('hidden');\n            document.getElementById('btn-' + id).classList.add('active');\n        }\n\n        // --- OYUN 1: KUŞ EVİ (SORULAR) ---\n        const bhQuestions = [\n            { q: \"Merhametli insan sadece insanlara değil, hayvanlara da iyi davranır.\", a: true },\n            { q: \"Osmanlı'da kuş evleri sadece süs olsun diye yapılmıştır.\", a: false },\n            { q: \"Depremzedelere yardım etmek toplumsal merhametin bir örneğidir.\", a: true },\n            { q: \"Merhamet etmek, güçsüzleri ezmek demektir.\", a: false },\n            { q: \"Allah'ın Rahman ismi, dünyadaki bütün canlılara merhamet etmesidir.\", a: true }\n        ];\n        let bhIdx = 0;\n        let bhScore = 0;\n\n        function checkBH(answer) {\n            if(answer === bhQuestions[bhIdx].a) {\n                bhScore++;\n                updateHouse(bhScore);\n            }\n            bhIdx++;\n            if(bhIdx < bhQuestions.length) {\n                document.getElementById('bh-question').innerText = bhQuestions[bhIdx].q;\n            } else {\n                document.getElementById('quiz-area').innerHTML = \"<h3 class='text-3xl text-green-400 font-bold'>Tebrikler! Kuş Evi Tamamlandı.</h3>\";\n            }\n        }\n\n        function updateHouse(score) {\n            const percent = (score / 5) * 100;\n            document.getElementById('progress-text').innerText = `İnşaat: %${percent}`;\n            \n            const icon = document.getElementById('house-icon');\n            icon.style.opacity = 0.2 + (score * 0.16);\n            icon.style.transform = `scale(${0.5 + (score * 0.1)})`;\n\n            if(score === 5) {\n                document.getElementById('birds').style.opacity = 1;\n                icon.classList.add('text-yellow-400'); // Altın ev :)\n            }\n        }\n        \n        // Başlangıç Sorusu\n        document.getElementById('bh-question').innerText = bhQuestions[0].q;\n\n\n        // --- OYUN 2: EŞLEŞTİRME ---\n        const matchData = [\n            { def: \"Dünyada bütün varlıklara merhamet eden.\", term: \"RAHMAN\" },\n            { def: \"Ahirette sadece inananlara merhamet eden.\", term: \"RAHİM\" },\n            { def: \"Kendini başkasının yerine koyma.\", term: \"EMPATİ\" },\n            { def: \"Acıma, şefkat gösterme, affetme.\", term: \"MERHAMET\" },\n            { def: \"Osmanlı'da hayvanlara merhamet sembolü.\", term: \"KUŞ EVİ\" }\n        ];\n\n        let selDef = null, selTerm = null, matches = 0;\n        const defCol = document.getElementById('col-defs');\n        const termCol = document.getElementById('col-terms');\n\n        const shufDefs = [...matchData].sort(() => Math.random() - 0.5);\n        const shufTerms = [...matchData].sort(() => Math.random() - 0.5);\n\n        shufDefs.forEach(d => {\n            const btn = document.createElement('div');\n            btn.className = 'match-item bg-slate-700 text-lg';\n            btn.innerText = d.def;\n            btn.onclick = () => selectItem(btn, 'def', d.term);\n            defCol.appendChild(btn);\n        });\n\n        shufTerms.forEach(t => {\n            const btn = document.createElement('div');\n            btn.className = 'match-item bg-slate-800 text-center font-bold text-xl';\n            btn.innerText = t.term;\n            btn.onclick = () => selectItem(btn, 'term', t.term);\n            termCol.appendChild(btn);\n        });\n\n        function selectItem(el, type, val) {\n            if(el.classList.contains('matched')) return;\n            \n            if(type === 'def') {\n                if(selDef) selDef.el.classList.remove('selected');\n                selDef = { el, val };\n            } else {\n                if(selTerm) selTerm.el.classList.remove('selected');\n                selTerm = { el, val };\n            }\n            el.classList.add('selected');\n\n            if(selDef && selTerm) {\n                if(selDef.val === selTerm.val) {\n                    selDef.el.classList.add('matched'); selTerm.el.classList.add('matched');\n                    selDef.el.classList.remove('selected'); selTerm.el.classList.remove('selected');\n                    selDef = null; selTerm = null; matches++;\n                    if(matches === matchData.length) document.getElementById('msg2').classList.remove('hidden');\n                } else {\n                    selDef.el.classList.add('wrong'); selTerm.el.classList.add('wrong');\n                    setTimeout(() => {\n                        selDef.el.classList.remove('wrong', 'selected');\n                        selTerm.el.classList.remove('wrong', 'selected');\n                        selDef = null; selTerm = null;\n                    }, 500);\n                }\n            }\n        }\n\n        // --- OYUN 3: SENARYO ---\n        const scenarios = [\n            {\n                q: \"Sokakta soğuktan titreyen bir kedi gördün. Merhametli insan ne yapar?\",\n                opts: [\n                    { t: \"Görmezden gelip geçerim.\", c: false },\n                    { t: \"Ona yiyecek veya sıcak bir yer bulmaya çalışırım.\", c: true }\n                ]\n            },\n            {\n                q: \"Arkadaşın yanlışlıkla kalemini kırdı ve çok üzgün. Ne dersin?\",\n                opts: [\n                    { t: \"Canın sağ olsun, bilerek yapmadın ya. (Affetme)\", c: true },\n                    { t: \"Ona çok kızar ve bağırırım.\", c: false }\n                ]\n            },\n            {\n                q: \"Miraç gibi, zor durumda kalan insanlar görünce ne hissetmeliyiz?\",\n                opts: [\n                    { t: \"Bu benim sorunum değil deyip geçmeliyiz.\", c: false },\n                    { t: \"Acılarını paylaşmalı ve elimizden geleni yapmalıyız (Vicdan).\", c: true }\n                ]\n            }\n        ];\n        let scenIdx = 0;\n\n        function loadScenario() {\n            if(scenIdx >= scenarios.length) {\n                document.getElementById('scenario-card').innerHTML = '<h3 class=\"text-4xl text-center text-green-400 font-bold\">Harika! Merhametlisin.</h3><button onclick=\"location.reload()\" class=\"mt-8 w-full bg-slate-600 py-4 rounded-xl text-xl\">Başa Dön</button>';\n                return;\n            }\n            const data = scenarios[scenIdx];\n            let html = `<div class=\"mb-6 text-yellow-400 font-bold text-xl\">DURUM ${scenIdx + 1}</div><p class=\"text-3xl mb-10 font-bold leading-relaxed\">${data.q}</p><div class=\"space-y-4\">`;\n            data.opts.forEach(opt => {\n                html += `<button onclick=\"checkScenario(this, ${opt.c})\" class=\"scenario-btn w-full text-xl font-bold\">${opt.t}</button>`;\n            });\n            html += `</div><div id=\"scen-msg\" class=\"mt-8 font-bold text-center h-10 text-2xl\"></div>`;\n            document.getElementById('scenario-card').innerHTML = html;\n        }\n\n        function checkScenario(btn, isCorrect) {\n            if(isCorrect) {\n                btn.classList.add('correct');\n                document.getElementById('scen-msg').innerText = \"DOĞRU! ✅\";\n                document.getElementById('scen-msg').className = \"mt-8 font-bold text-center h-10 text-2xl text-green-400\";\n                setTimeout(() => { scenIdx++; loadScenario(); }, 1500);\n            } else {\n                btn.classList.add('wrong');\n                document.getElementById('scen-msg').innerText = \"MERHAMET BU DEĞİL ❌\";\n                document.getElementById('scen-msg').className = \"mt-8 font-bold text-center h-10 text-2xl text-red-400\";\n            }\n        }\n        loadScenario();\n\n    </script>\n</body>\n</html>",
    "isPublished": false
  },
