  {
    "title": "💻 4. Salli ve Barik Duaları ile Anlamları İnteraktif Slaytı",
    "htmlContent": "<div id=\"presentation-container\" class=\"relative w-full h-full min-h-[580px] max-h-[92vh] bg-slate-950 text-slate-100 rounded-3xl border border-white/10 p-4 md:p-7 flex flex-col justify-between overflow-hidden select-none font-sans shadow-2xl shadow-purple-950/40\">\n\n  <!-- ÜST KONTROL & BİLGİ ÇUBUĞU -->\n  <div class=\"flex items-center justify-between border-b border-white/10 pb-3 mb-2 z-20\">\n    <div class=\"flex items-center gap-2.5\">\n      <span class=\"px-3 py-1 rounded-full text-[11px] font-extrabold uppercase tracking-wider bg-gradient-to-r from-cyan-500/20 to-purple-500/20 border border-cyan-500/40 text-cyan-300 shadow-sm flex items-center gap-1.5\">\n        <span class=\"w-2 h-2 rounded-full bg-cyan-400 animate-pulse\"></span> 1. Tema: Kur'an-ı Kerim'i Tanıyorum\n      </span>\n      <span class=\"hidden sm:inline-block text-xs text-slate-400 font-medium\">| 1.4. Salli ve Barik Duaları</span>\n    </div>\n\n    <div class=\"flex items-center gap-3\">\n      <span id=\"slide-counter\" class=\"font-mono text-xs px-3 py-1 rounded-full bg-white/10 text-purple-300 font-bold border border-white/10 tracking-widest shadow-inner\">\n        1 / 5\n      </span>\n      <div class=\"w-20 sm:w-28 bg-white/10 h-2 rounded-full overflow-hidden p-0.5 border border-white/5\">\n        <div id=\"slide-progress\" class=\"bg-gradient-to-r from-purple-500 via-indigo-400 to-cyan-400 h-full rounded-full transition-all duration-300 shadow-[0_0_8px_rgba(168,85,247,0.7)]\" style=\"width: 20%\"></div>\n      </div>\n    </div>\n  </div>\n\n  <!-- SLAYT ALANI -->\n  <div class=\"relative flex-1 flex flex-col justify-center items-center my-auto overflow-hidden z-10 py-1\">\n\n    <!-- SLAYT 1: KAPAK & ÇARPICI GİRİŞ -->\n    <div class=\"slide-page w-full max-w-5xl mx-auto flex flex-col justify-center items-center text-center px-2 animate-fadeIn\" data-slide=\"0\">\n      <div class=\"inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-purple-950/80 border border-purple-500/40 text-purple-300 text-xs md:text-sm font-semibold mb-4 shadow-lg shadow-purple-900/30\">\n        ✨ Peygamber Sevgisi & Salavatın Anlam Dünyası\n      </div>\n      \n      <h1 class=\"text-3xl md:text-5xl lg:text-6xl font-black tracking-tight leading-tight mb-4 bg-clip-text text-transparent bg-gradient-to-r from-cyan-300 via-indigo-200 to-fuchsia-400 drop-shadow-md\">\n        Salli ve Barik Duaları\n      </h1>\n      \n      <p class=\"text-base md:text-xl text-slate-300 max-w-3xl mb-6 font-normal leading-relaxed\">\n        Hz. Muhammed’e <span class=\"text-amber-300 font-medium\">(s.a.v.)</span> ve onun kutlu ailesine gönderilen en güzel selam, rahmet ve bereket niyazı...\n      </p>\n\n      <div class=\"grid grid-cols-1 md:grid-cols-2 gap-3.5 max-w-3xl w-full mb-7 text-left\">\n        <div class=\"bg-slate-900/80 border border-cyan-500/30 rounded-2xl p-4 backdrop-blur-md flex items-center gap-3.5 hover:border-cyan-400/60 transition-all shadow-lg\">\n          <div class=\"w-12 h-12 rounded-xl bg-cyan-500/20 text-cyan-300 flex items-center justify-center text-2xl flex-shrink-0 border border-cyan-500/30\">🕊️</div>\n          <div>\n            <h4 class=\"text-sm font-bold text-cyan-200\">Rahmet & Selam</h4>\n            <p class=\"text-xs text-slate-400\">Peygamber Efendimize ve Hz. İbrahim'in âline dualar</p>\n          </div>\n        </div>\n        <div class=\"bg-slate-900/80 border border-purple-500/30 rounded-2xl p-4 backdrop-blur-md flex items-center gap-3.5 hover:border-purple-400/60 transition-all shadow-lg\">\n          <div class=\"w-12 h-12 rounded-xl bg-purple-500/20 text-purple-300 flex items-center justify-center text-2xl flex-shrink-0 border border-purple-500/30\">🤲</div>\n          <div>\n            <h4 class=\"text-sm font-bold text-purple-200\">Namazın Zirvesi</h4>\n            <p class=\"text-xs text-slate-400\">Tahiyyat sonrasında okunan en faziletli salavatlar</p>\n          </div>\n        </div>\n      </div>\n\n      <button onclick=\"nextSlide()\" class=\"group relative px-7 py-3 rounded-2xl bg-gradient-to-r from-cyan-500 via-indigo-600 to-purple-600 hover:from-cyan-400 hover:to-purple-500 text-white font-bold text-base md:text-lg flex items-center gap-3 transition-all duration-300 shadow-xl shadow-indigo-900/50 hover:scale-105 active:scale-95 cursor-pointer\">\n        <span>Derse Başla</span>\n        <span class=\"group-hover:translate-x-1 transition-transform\">➔</span>\n      </button>\n    </div>\n\n    <!-- SLAYT 2: KİLİT KAVRAMLAR & TANIMLAR -->\n    <div class=\"slide-page hidden w-full max-w-5xl mx-auto flex flex-col justify-center px-2 animate-fadeIn\" data-slide=\"1\">\n      <div class=\"text-center mb-5\">\n        <h2 class=\"text-2xl md:text-4xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-cyan-300 to-indigo-300\">\n          Kilit Kavramlar ve Anlam Dünyası\n        </h2>\n        <p class=\"text-xs md:text-sm text-slate-400 mt-1\">Dualarımızdaki derin anlamları ve kavramsal temelleri tanıyalım</p>\n      </div>\n\n      <div class=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3.5\">\n        <!-- Kart 1 -->\n        <div class=\"bg-slate-900/90 border border-cyan-500/30 hover:border-cyan-400 rounded-2xl p-4 transition-all duration-300 shadow-lg hover:shadow-cyan-500/10 flex flex-col justify-between\">\n          <div>\n            <div class=\"w-10 h-10 rounded-xl bg-cyan-500/20 text-cyan-300 flex items-center justify-center text-xl mb-3 border border-cyan-500/30\">📜</div>\n            <h3 class=\"text-base font-bold text-cyan-300 mb-1\">Salavat</h3>\n            <p class=\"text-xs text-slate-300 leading-relaxed\">\n              Hz. Muhammed'e (s.a.v.) saygı bildirmek, onun için Allah'tan rahmet ve bereket dilemek, manevi şahsiyetini selamlamaktır.\n            </p>\n          </div>\n          <span class=\"mt-3 text-[10px] text-cyan-400/80 font-mono\">#SevgiVeSaygı</span>\n        </div>\n\n        <!-- Kart 2 -->\n        <div class=\"bg-slate-900/90 border border-indigo-500/30 hover:border-indigo-400 rounded-2xl p-4 transition-all duration-300 shadow-lg hover:shadow-indigo-500/10 flex flex-col justify-between\">\n          <div>\n            <div class=\"w-10 h-10 rounded-xl bg-indigo-500/20 text-indigo-300 flex items-center justify-center text-xl mb-3 border border-indigo-500/30\">🌧️</div>\n            <h3 class=\"text-base font-bold text-indigo-300 mb-1\">Salli Duası</h3>\n            <p class=\"text-xs text-slate-300 leading-relaxed\">\n              Hz. İbrahim ve ailesine lütfedildiği gibi, Hz. Muhammed ve ailesine de Yüce Allah'tan <strong class=\"text-indigo-200\">\"rahmet\"</strong> istenen duadır.\n            </p>\n          </div>\n          <span class=\"mt-3 text-[10px] text-indigo-400/80 font-mono\">#İlahiRahmet</span>\n        </div>\n\n        <!-- Kart 3 -->\n        <div class=\"bg-slate-900/90 border border-fuchsia-500/30 hover:border-fuchsia-400 rounded-2xl p-4 transition-all duration-300 shadow-lg hover:shadow-fuchsia-500/10 flex flex-col justify-between\">\n          <div>\n            <div class=\"w-10 h-10 rounded-xl bg-fuchsia-500/20 text-fuchsia-300 flex items-center justify-center text-xl mb-3 border border-fuchsia-500/30\">🌱</div>\n            <h3 class=\"text-base font-bold text-fuchsia-300 mb-1\">Barik Duası</h3>\n            <p class=\"text-xs text-slate-300 leading-relaxed\">\n              Hz. İbrahim ve ailesine ihsan edildiği gibi, Hz. Muhammed ve ailesine de <strong class=\"text-fuchsia-200\">\"bereket ve bolluk\"</strong> istenen duadır.\n            </p>\n          </div>\n          <span class=\"mt-3 text-[10px] text-fuchsia-400/80 font-mono\">#KutluBereket</span>\n        </div>\n\n        <!-- Kart 4 -->\n        <div class=\"bg-slate-900/90 border border-amber-500/30 hover:border-amber-400 rounded-2xl p-4 transition-all duration-300 shadow-lg hover:shadow-amber-500/10 flex flex-col justify-between\">\n          <div>\n            <div class=\"w-10 h-10 rounded-xl bg-amber-500/20 text-amber-300 flex items-center justify-center text-xl mb-3 border border-amber-500/30\">👑</div>\n            <h3 class=\"text-base font-bold text-amber-300 mb-1\">Hamîd & Mecîd</h3>\n            <p class=\"text-xs text-slate-300 leading-relaxed\">\n              Allah'ın güzel isimleri: <strong class=\"text-amber-200\">Hamîd;</strong> övgüye en layık olan, <strong class=\"text-amber-200\">Mecîd;</strong> şânı ve cömertliği en yüce olan demektir.\n            </p>\n          </div>\n          <span class=\"mt-3 text-[10px] text-amber-400/80 font-mono\">#EsmaülHüsna</span>\n        </div>\n      </div>\n    </div>\n\n    <!-- SLAYT 3: İNFOGRAFİK AKIŞ & OKUNDUĞU YERLER / EZBER ADIMLARI -->\n    <div class=\"slide-page hidden w-full max-w-5xl mx-auto flex flex-col justify-center px-2 animate-fadeIn\" data-slide=\"2\">\n      <div class=\"text-center mb-4\">\n        <h2 class=\"text-2xl md:text-3xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-emerald-300 via-teal-200 to-cyan-400\">\n          Uygulama & Okunduğu Yerler\n        </h2>\n        <p class=\"text-xs md:text-sm text-slate-400 mt-0.5\">Salli ve Barik duaları hayatımızın hangi anlarında yer alır?</p>\n      </div>\n\n      <div class=\"grid grid-cols-1 lg:grid-cols-12 gap-4 items-stretch\">\n        <!-- Sol: Okunduğu Yerler Grid -->\n        <div class=\"lg:col-span-7 bg-slate-900/80 border border-teal-500/30 rounded-2xl p-4 backdrop-blur-md flex flex-col justify-between\">\n          <div class=\"flex items-center gap-2 mb-3 text-teal-300 font-bold text-sm\">\n            <span class=\"text-lg\">📍</span> Salli & Barik Dualarının Okunduğu Başlıca Yerler\n          </div>\n          \n          <div class=\"grid grid-cols-2 sm:grid-cols-3 gap-2.5\">\n            <div class=\"bg-slate-950/70 border border-white/10 rounded-xl p-2.5 text-center flex flex-col items-center justify-center\">\n              <span class=\"text-xl mb-1\">🕌</span>\n              <span class=\"text-xs font-semibold text-slate-200\">Vakit Namazları</span>\n              <span class=\"text-[10px] text-slate-400\">Son oturuşlarda</span>\n            </div>\n            <div class=\"bg-slate-950/70 border border-white/10 rounded-xl p-2.5 text-center flex flex-col items-center justify-center\">\n              <span class=\"text-xl mb-1\">🚪</span>\n              <span class=\"text-xs font-semibold text-slate-200\">Mescide Giriş-Çıkış</span>\n              <span class=\"text-[10px] text-slate-400\">Rahmet kapıları için</span>\n            </div>\n            <div class=\"bg-slate-950/70 border border-white/10 rounded-xl p-2.5 text-center flex flex-col items-center justify-center\">\n              <span class=\"text-xl mb-1\">📢</span>\n              <span class=\"text-xs font-semibold text-slate-200\">Ezan Dinlerken</span>\n              <span class=\"text-[10px] text-slate-400\">Ezan duasında</span>\n            </div>\n            <div class=\"bg-slate-950/70 border border-white/10 rounded-xl p-2.5 text-center flex flex-col items-center justify-center\">\n              <span class=\"text-xl mb-1\">🕊️</span>\n              <span class=\"text-xs font-semibold text-slate-200\">Cenaze Namazı</span>\n              <span class=\"text-[10px] text-slate-400\">2. Tekbirden sonra</span>\n            </div>\n            <div class=\"bg-slate-950/70 border border-white/10 rounded-xl p-2.5 text-center flex flex-col items-center justify-center\">\n              <span class=\"text-xl mb-1\">🗣️</span>\n              <span class=\"text-xs font-semibold text-slate-200\">İsmi Anıldığında</span>\n              <span class=\"text-[10px] text-slate-400\">Vefa ve hürmetle</span>\n            </div>\n            <div class=\"bg-slate-950/70 border border-white/10 rounded-xl p-2.5 text-center flex flex-col items-center justify-center\">\n              <span class=\"text-xl mb-1\">✨</span>\n              <span class=\"text-xs font-semibold text-slate-200\">Cuma Günleri</span>\n              <span class=\"text-[10px] text-slate-400\">En faziletli vakitte</span>\n            </div>\n          </div>\n        </div>\n\n        <!-- Sağ: 3 Adımlı Ezber Yöntemi İnfografiği -->\n        <div class=\"lg:col-span-5 bg-gradient-to-br from-indigo-950/60 to-purple-950/60 border border-indigo-500/30 rounded-2xl p-4 flex flex-col justify-between\">\n          <div class=\"text-xs font-bold text-indigo-300 uppercase tracking-wide mb-2 flex items-center gap-1.5\">\n            <span>🧩</span> 3 Aşamalı Ezberleme Tekniği\n          </div>\n\n          <div class=\"space-y-2 text-xs\">\n            <div class=\"flex items-center gap-2.5 bg-slate-900/80 p-2 rounded-xl border border-white/5\">\n              <span class=\"w-6 h-6 rounded-full bg-cyan-500/20 text-cyan-300 font-bold flex items-center justify-center text-xs flex-shrink-0\">1</span>\n              <div>\n                <p class=\"font-semibold text-cyan-200\">Hz. Muhammed (s.a.v.) Bölümü</p>\n                <p class=\"text-[11px] text-slate-400 font-arabic\">Allahümme salli/bârik alâ Muhammedin ve alâ âli Muhammed</p>\n              </div>\n            </div>\n\n            <div class=\"flex items-center gap-2.5 bg-slate-900/80 p-2 rounded-xl border border-white/5\">\n              <span class=\"w-6 h-6 rounded-full bg-indigo-500/20 text-indigo-300 font-bold flex items-center justify-center text-xs flex-shrink-0\">2</span>\n              <div>\n                <p class=\"font-semibold text-indigo-200\">Hz. İbrahim (a.s.) Bölümü</p>\n                <p class=\"text-[11px] text-slate-400 font-arabic\">Kemâ salleyte/bârekte alâ İbrâhîme ve alâ âli İbrâhîm</p>\n              </div>\n            </div>\n\n            <div class=\"flex items-center gap-2.5 bg-slate-900/80 p-2 rounded-xl border border-white/5\">\n              <span class=\"w-6 h-6 rounded-full bg-fuchsia-500/20 text-fuchsia-300 font-bold flex items-center justify-center text-xs flex-shrink-0\">3</span>\n              <div>\n                <p class=\"font-semibold text-fuchsia-200\">Övgü ve Şan (Sonuç)</p>\n                <p class=\"text-[11px] text-slate-400 font-arabic\">İnneke Hamîdün Mecîd</p>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <!-- SLAYT 4: KARŞILAŞTIRMA & KRİTİK NOKTALAR -->\n    <div class=\"slide-page hidden w-full max-w-5xl mx-auto flex flex-col justify-center px-2 animate-fadeIn\" data-slide=\"3\">\n      <div class=\"text-center mb-4\">\n        <h2 class=\"text-2xl md:text-3xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-amber-300 via-orange-300 to-rose-400\">\n          Kritik Noktalar & Dua Adabı\n        </h2>\n        <p class=\"text-xs md:text-sm text-slate-400 mt-0.5\">Salli ile Barik arasındaki fark nedir ve dua ederken sıramız nasıl olmalıdır?</p>\n      </div>\n\n      <div class=\"grid grid-cols-1 md:grid-cols-2 gap-4 mb-3.5\">\n        <!-- Karşılaştırma 1: SALLİ -->\n        <div class=\"bg-slate-900/90 border-l-4 border-l-cyan-400 border-y border-r border-white/10 rounded-2xl p-4\">\n          <div class=\"flex items-center justify-between mb-2\">\n            <span class=\"text-base font-bold text-cyan-300 flex items-center gap-2\">🔹 Allahümme Salli</span>\n            <span class=\"text-[11px] px-2 py-0.5 bg-cyan-950 text-cyan-300 border border-cyan-800 rounded-md\">Rahmet Niyazı</span>\n          </div>\n          <p class=\"text-xs text-slate-300 mb-2\">\n            <strong>Kilit Kelime:</strong> <span class=\"text-cyan-200 font-semibold\">\"Salleyte\"</span> (Rahmet ettiğin gibi rahmet eyle).\n          </p>\n          <p class=\"text-xs text-slate-400\">\n            Hz. Muhammed'e ve onun temiz soyuna manevi yücelik ve ilahi şefkatin inmesi talep edilir.\n          </p>\n        </div>\n\n        <!-- Karşılaştırma 2: BARİK -->\n        <div class=\"bg-slate-900/90 border-l-4 border-l-fuchsia-400 border-y border-r border-white/10 rounded-2xl p-4\">\n          <div class=\"flex items-center justify-between mb-2\">\n            <span class=\"text-base font-bold text-fuchsia-300 flex items-center gap-2\">🔸 Allahümme Barik</span>\n            <span class=\"text-[11px] px-2 py-0.5 bg-fuchsia-950 text-fuchsia-300 border border-fuchsia-800 rounded-md\">Bereket Niyazı</span>\n          </div>\n          <p class=\"text-xs text-slate-300 mb-2\">\n            <strong>Kilit Kelime:</strong> <span class=\"text-fuchsia-200 font-semibold\">\"Bârekte\"</span> (Bereketli kıldığın gibi bereket ihsan eyle).\n          </p>\n          <p class=\"text-xs text-slate-400\">\n            Hz. Muhammed'in dininin, getirdiği nurun ve ümmetinin daimi kılınması, bereketlenmesi istenir.\n          </p>\n        </div>\n      </div>\n\n      <!-- Alt Hap Bilgi: Dua Adabı Hadisi -->\n      <div class=\"bg-gradient-to-r from-amber-950/40 via-purple-950/40 to-slate-900 border border-amber-500/40 rounded-2xl p-3.5 flex items-center gap-3.5 shadow-lg\">\n        <div class=\"w-12 h-12 rounded-xl bg-amber-500/20 text-amber-300 flex items-center justify-center text-2xl flex-shrink-0 border border-amber-500/40\">💡</div>\n        <div class=\"text-xs\">\n          <span class=\"font-bold text-amber-300 uppercase tracking-wide\">Peygamberimizden (s.a.v.) Dua Adabı Tüyosu:</span>\n          <p class=\"text-slate-200 mt-0.5 italic\">\n            \"Biriniz dua edeceği zaman önce Yüce Rabb'ine <strong>hamd ve sena</strong> ile başlasın, sonra Peygamber'e <strong>salavat getirsin</strong>, daha sonra dilediği gibi dua etsin.\"\n          </p>\n        </div>\n      </div>\n    </div>\n\n    <!-- SLAYT 5: DEFTERE YAZILACAKLAR & ALTIN ÇIKARIMLAR -->\n    <div class=\"slide-page hidden w-full max-w-5xl mx-auto flex flex-col justify-center px-2 animate-fadeIn\" data-slide=\"4\">\n      <div class=\"text-center mb-4\">\n        <h2 class=\"text-2xl md:text-3xl font-black text-transparent bg-clip-text bg-gradient-to-r from-teal-300 via-cyan-200 to-indigo-300\">\n          Defterimize Not Edelim & Altın Kurallar\n        </h2>\n        <p class=\"text-xs md:text-sm text-slate-400 mt-0.5\">Dersimizin özeti niteliğindeki altın kazanımlar</p>\n      </div>\n\n      <div class=\"grid grid-cols-1 md:grid-cols-12 gap-4\">\n        <!-- Defter Özeti Paneli (8 Kolon) -->\n        <div class=\"md:col-span-8 bg-slate-900/90 border border-cyan-500/30 rounded-2xl p-4 shadow-xl flex flex-col justify-between\">\n          <div class=\"flex items-center gap-2 text-cyan-300 font-bold text-sm mb-3 border-b border-white/10 pb-2\">\n            <span>✏️</span> Defter Özeti (Temel Maddeler)\n          </div>\n\n          <div class=\"space-y-2.5 text-xs text-slate-200\">\n            <div class=\"flex items-start gap-2.5\">\n              <span class=\"text-cyan-400 font-bold\">1.</span>\n              <p><strong class=\"text-cyan-300\">Konum:</strong> Salli ve Barik duaları, namazların son oturuşunda <em>Tahiyyat</em> duasından sonra okunur.</p>\n            </div>\n            <div class=\"flex items-start gap-2.5\">\n              <span class=\"text-cyan-400 font-bold\">2.</span>\n              <p><strong class=\"text-indigo-300\">Peygamberler Bağı:</strong> Bu dualarla İslam ümmeti, Hz. İbrahim'den Hz. Muhammed'e uzanan kutlu peygamberler zincirini ve tevhid mirasını hatırlar.</p>\n            </div>\n            <div class=\"flex items-start gap-2.5\">\n              <span class=\"text-cyan-400 font-bold\">3.</span>\n              <p><strong class=\"text-fuchsia-300\">Salavatın Gücü:</strong> Hz. Peygamber, <em>\"Kıyamet günü insanların bana en yakını, bana en çok salavat getirendir.\"</em> buyurarak bağlılığın önemini vurgulamıştır.</p>\n            </div>\n            <div class=\"flex items-start gap-2.5\">\n              <span class=\"text-cyan-400 font-bold\">4.</span>\n              <p><strong class=\"text-amber-300\">Dua Mantığı:</strong> Başkasına rahmet ve bereket isteyen kalp, bizzat kendisi de rahmete kavuşur.</p>\n            </div>\n          </div>\n        </div>\n\n        <!-- Altın Sınav Tüyosu (4 Kolon) -->\n        <div class=\"md:col-span-4 bg-gradient-to-br from-purple-950/80 to-indigo-950/80 border border-purple-500/40 rounded-2xl p-4 flex flex-col justify-between shadow-xl\">\n          <div>\n            <div class=\"flex items-center gap-2 text-purple-300 font-bold text-xs uppercase tracking-wider mb-2\">\n              <span class=\"text-base\">🎯</span> Sınav & Değerlendirme Tüyosu\n            </div>\n            <div class=\"bg-black/40 rounded-xl p-3 border border-purple-400/20 text-xs text-purple-100 leading-relaxed\">\n              <strong>Unutma!</strong> <br>\n              • <em>Salli</em> = <span class=\"text-cyan-300 font-bold\">Rahmet</span><br>\n              • <em>Barik</em> = <span class=\"text-fuchsia-300 font-bold\">Bereket</span><br>\n              • Her iki dua da Allah'ın <strong>\"Hamîd\"</strong> ve <strong>\"Mecîd\"</strong> sıfatlarıyla mühürlenir.\n            </div>\n          </div>\n\n          <div class=\"mt-3 pt-2 border-t border-white/10 text-center\">\n            <span class=\"text-[11px] text-emerald-300 font-semibold flex items-center justify-center gap-1\">\n              <span>✅</span> Konuyu Başarıyla Tamamladınız!\n            </span>\n          </div>\n        </div>\n      </div>\n    </div>\n\n  </div>\n\n  <!-- ALT KONTROL VE GEÇİŞ ÇUBUĞU -->\n  <div class=\"flex items-center justify-between border-t border-white/10 pt-3 mt-1 z-20\">\n    <button id=\"btn-prev\" onclick=\"prevSlide()\" class=\"px-4 py-2 rounded-xl bg-white/10 hover:bg-white/20 text-white font-bold text-xs flex items-center gap-1.5 transition-all cursor-pointer opacity-50 cursor-not-allowed disabled:pointer-events-none\" disabled>\n      <span>◀</span> <span>Önceki</span>\n    </button>\n\n    <!-- SLAYT NOKTALARI (DOTS) -->\n    <div id=\"slide-dots\" class=\"flex items-center gap-2\">\n      <button onclick=\"goToSlide(0)\" class=\"w-3 h-3 rounded-full bg-cyan-400 scale-125 transition-all duration-300 shadow-md cursor-pointer\" aria-label=\"Slayt 1\"></button>\n      <button onclick=\"goToSlide(1)\" class=\"w-2.5 h-2.5 rounded-full bg-white/20 hover:bg-white/40 transition-all duration-300 cursor-pointer\" aria-label=\"Slayt 2\"></button>\n      <button onclick=\"goToSlide(2)\" class=\"w-2.5 h-2.5 rounded-full bg-white/20 hover:bg-white/40 transition-all duration-300 cursor-pointer\" aria-label=\"Slayt 3\"></button>\n      <button onclick=\"goToSlide(3)\" class=\"w-2.5 h-2.5 rounded-full bg-white/20 hover:bg-white/40 transition-all duration-300 cursor-pointer\" aria-label=\"Slayt 4\"></button>\n      <button onclick=\"goToSlide(4)\" class=\"w-2.5 h-2.5 rounded-full bg-white/20 hover:bg-white/40 transition-all duration-300 cursor-pointer\" aria-label=\"Slayt 5\"></button>\n    </div>\n\n    <button id=\"btn-next\" onclick=\"nextSlide()\" class=\"px-5 py-2 rounded-xl bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-500 hover:to-indigo-500 text-white font-bold text-xs flex items-center gap-1.5 transition-all shadow-lg shadow-purple-900/40 cursor-pointer\">\n      <span>Sonraki</span> <span>▶</span>\n    </button>\n  </div>\n\n  <!-- JAVASCRIPT ETKİLEŞİM & SLAYT MOTORU -->\n  <script>\n    let currentSlide = 0;\n    const totalSlides = 5;\n    const slides = document.querySelectorAll('.slide-page');\n    const dots = document.querySelectorAll('#slide-dots button');\n    const counter = document.getElementById('slide-counter');\n    const progress = document.getElementById('slide-progress');\n    const btnPrev = document.getElementById('btn-prev');\n    const btnNext = document.getElementById('btn-next');\n\n    function updatePresentation() {\n      // Slaytları gizle/göster\n      slides.forEach((slide, idx) => {\n        if (idx === currentSlide) {\n          slide.classList.remove('hidden');\n          slide.classList.add('flex');\n        } else {\n          slide.classList.add('hidden');\n          slide.classList.remove('flex');\n        }\n      });\n\n      // Noktaları güncelle\n      dots.forEach((dot, idx) => {\n        if (idx === currentSlide) {\n          dot.className = \"w-3 h-3 rounded-full bg-cyan-400 scale-125 transition-all duration-300 shadow-[0_0_8px_rgba(34,211,238,0.8)] cursor-pointer\";\n        } else {\n          dot.className = \"w-2.5 h-2.5 rounded-full bg-white/20 hover:bg-white/40 transition-all duration-300 cursor-pointer\";\n        }\n      });\n\n      // Sayaç & İlerleme çubuğu\n      counter.textContent = `${currentSlide + 1} / ${totalSlides}`;\n      progress.style.width = `${((currentSlide + 1) / totalSlides) * 100}%`;\n\n      // Buton Durumları\n      if (currentSlide === 0) {\n        btnPrev.disabled = true;\n        btnPrev.classList.add('opacity-50', 'cursor-not-allowed');\n      } else {\n        btnPrev.disabled = false;\n        btnPrev.classList.remove('opacity-50', 'cursor-not-allowed');\n      }\n\n      if (currentSlide === totalSlides - 1) {\n        btnNext.innerHTML = '<span>Başa Dön</span> <span>🔄</span>';\n        btnNext.className = \"px-5 py-2 rounded-xl bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-500 hover:to-teal-500 text-white font-bold text-xs flex items-center gap-1.5 transition-all shadow-lg shadow-emerald-900/40 cursor-pointer\";\n      } else {\n        btnNext.innerHTML = '<span>Sonraki</span> <span>▶</span>';\n        btnNext.className = \"px-5 py-2 rounded-xl bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-500 hover:to-indigo-500 text-white font-bold text-xs flex items-center gap-1.5 transition-all shadow-lg shadow-purple-900/40 cursor-pointer\";\n      }\n    }\n\n    function nextSlide() {\n      if (currentSlide < totalSlides - 1) {\n        currentSlide++;\n      } else {\n        currentSlide = 0; // Döngü\n      }\n      updatePresentation();\n    }\n\n    function prevSlide() {\n      if (currentSlide > 0) {\n        currentSlide--;\n        updatePresentation();\n      }\n    }\n\n    function goToSlide(index) {\n      if (index >= 0 && index < totalSlides) {\n        currentSlide = index;\n        updatePresentation();\n      }\n    }\n\n    // Klavye Ok Tuşları Desteği\n    window.addEventListener('keydown', (e) => {\n      if (e.key === 'ArrowRight' || e.key === ' ') {\n        e.preventDefault();\n        nextSlide();\n      } else if (e.key === 'ArrowLeft') {\n        e.preventDefault();\n        prevSlide();\n      }\n    });\n\n    // Dokunmatik / Akıllı Tahta Swipe (Kaydırma) Desteği\n    let touchStartX = 0;\n    let touchEndX = 0;\n    const container = document.getElementById('presentation-container');\n\n    container.addEventListener('touchstart', (e) => {\n      touchStartX = e.changedTouches[0].screenX;\n    }, { passive: true });\n\n    container.addEventListener('touchend', (e) => {\n      touchEndX = e.changedTouches[0].screenX;\n      handleSwipe();\n    }, { passive: true });\n\n    function handleSwipe() {\n      const swipeDistance = touchEndX - touchStartX;\n      const threshold = 45; // min piksel mesafesi\n      if (swipeDistance < -threshold) {\n        // Sola kaydırıldı -> Sonraki\n        nextSlide();\n      } else if (swipeDistance > threshold) {\n        // Sağa kaydırıldı -> Önceki\n        prevSlide();\n      }\n    }\n\n    // İlk başlatma\n    updatePresentation();\n  </script>\n</div>",
