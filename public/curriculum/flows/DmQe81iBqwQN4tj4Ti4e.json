    "htmlContent": "<!DOCTYPE html><html lang='tr'><head><meta charset='UTF-8'><meta name='viewport' content='width=device-width, initial-scale=1.0'><script src='https://cdn.tailwindcss.com'></script></head><body class='bg-slate-950 text-white min-h-screen p-4 flex flex-col items-center justify-center font-sans'><div class='max-w-3xl w-full bg-slate-900 rounded-2xl p-6 shadow-2xl border border-slate-800 flex flex-col gap-6'><div class='text-center space-y-2'><h1 class='text-2xl md:text-3xl font-bold text-amber-400'>🧩 Salli ve Barik Duaları Sıralama Oyunu</h1><p class='text-slate-400 text-sm md:text-base'>Karışık olarak verilen dua bölümlerini doğru sırayla diziniz (Hatalı parça seçimine izin verilmez).</p></div><div class='flex justify-center gap-3'><button id='btnSalli' onclick='selectPrayer(\"salli\")' class='px-5 py-2.5 rounded-xl font-bold transition duration-200 bg-amber-500 text-slate-950 shadow-lg shadow-amber-500/20 hover:bg-amber-400'>Allahümme Salli</button><button id='btnBarik' onclick='selectPrayer(\"barik\")' class='px-5 py-2.5 rounded-xl font-bold transition duration-200 bg-slate-800 text-slate-300 hover:bg-slate-700'>Allahümme Barik</button></div><div class='bg-slate-950 rounded-xl p-4 min-h-[140px] border border-slate-800 flex flex-col justify-between'><div class='text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2'>Oluşturulan Sıra:</div><div id='selectedArea' class='flex flex-wrap gap-2 min-h-[60px] items-center justify-center p-3 bg-slate-900/60 rounded-lg border border-dashed border-slate-700'></div><div class='flex justify-end gap-2 mt-3'><button onclick='undoLast()' class='px-3 py-1.5 bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-semibold rounded-lg transition'>↺ Geri Al</button><button onclick='resetGame()' class='px-3 py-1.5 bg-rose-950 hover:bg-rose-900 text-rose-300 text-xs font-semibold rounded-lg transition border border-rose-800/40'>🗑️ Sıfırla</button></div></div><div><div class='text-xs font-semibold text-slate-400 uppercase tracking-wider mb-3 text-center'>Eklenecek Bölümü Seçiniz:</div><div id='optionsArea' class='flex flex-col gap-3'></div></div><div class='flex justify-center pt-2'><button onclick='checkAnswer()' class='w-full md:w-auto px-8 py-3 bg-emerald-600 hover:bg-emerald-500 text-white font-bold rounded-xl shadow-lg shadow-emerald-600/30 transition transform active:scale-95 text-lg'>✓ Kontrol Et</button></div><div id='resultModal' class='hidden bg-slate-900 border border-slate-700 rounded-xl p-4 text-center space-y-2'><div id='resultTitle' class='text-xl font-bold'></div><div id='resultMessage' class='text-sm text-slate-300'></div></div></div><script>const prayers = { salli: { name: 'Allahümme Salli', items: [ { id: 1, text: 'اَللَّهُمَّ صَلِّ عَلٰى مُحَمَّدٍ وَعَلٰى اٰلِ مُحَمَّدٍ' }, { id: 2, text: 'كَمَا صَلَّيْتَ عَلٰى اِبْرَاهِيمَ وَعَلٰى اٰلِ اِبْرَاهِيمَ' }, { id: 3, text: 'اِنَّكَ حَمِيدٌ مَجِيدٌ' } ] }, barik: { name: 'Allahümme Barik', items: [ { id: 1, text: 'اَللَّهُمَّ بَارِكْ عَلٰى مُحَمَّدٍ وَعَلٰى اٰلِ مُحَمَّدٍ' }, { id: 2, text: 'كَمَا بَارَكْتَ عَلٰى اِبْرَاهِيمَ وَعَلٰى اٰلِ اِبْرَاهِيمَ' }, { id: 3, text: 'اِنَّكَ حَمِيدٌ مَجِيدٌ' } ] } }; let currentPrayer = 'salli'; let selectedItems = []; let availableItems = []; function shuffle(array) { return [...array].sort(() => Math.random() - 0.5); } function selectPrayer(type) { currentPrayer = type; document.getElementById('btnSalli').className = type === 'salli' ? 'px-5 py-2.5 rounded-xl font-bold transition duration-200 bg-amber-500 text-slate-950 shadow-lg shadow-amber-500/20 hover:bg-amber-400' : 'px-5 py-2.5 rounded-xl font-bold transition duration-200 bg-slate-800 text-slate-300 hover:bg-slate-700'; document.getElementById('btnBarik').className = type === 'barik' ? 'px-5 py-2.5 rounded-xl font-bold transition duration-200 bg-amber-500 text-slate-950 shadow-lg shadow-amber-500/20 hover:bg-amber-400' : 'px-5 py-2.5 rounded-xl font-bold transition duration-200 bg-slate-800 text-slate-300 hover:bg-slate-700'; resetGame(); } function resetGame() { selectedItems = []; availableItems = shuffle(prayers[currentPrayer].items); hideResult(); render(); } function hideResult() { document.getElementById('resultModal').classList.add('hidden'); } function addItem(item) { const expectedNextId = selectedItems.length + 1; if (item.id !== expectedNextId) { const modal = document.getElementById('resultModal'); const title = document.getElementById('resultTitle'); const msg = document.getElementById('resultMessage'); modal.classList.remove('hidden'); title.innerText = '⚠️ Sıralama Hatası'; title.className = 'text-xl font-bold text-amber-400'; msg.innerText = 'Bu parça şu anki sıra için uygun değil! Lütfen sıradaki doğru parçayı seçiniz.'; return; } selectedItems.push(item); availableItems = availableItems.filter(i => i.id !== item.id); hideResult(); render(); } function undoLast() { if (selectedItems.length > 0) { const last = selectedItems.pop(); availableItems.push(last); hideResult(); render(); } } function render() { const selArea = document.getElementById('selectedArea'); const optArea = document.getElementById('optionsArea'); selArea.innerHTML = ''; if (selectedItems.length === 0) { selArea.innerHTML = '<span class=\"text-slate-500 text-sm italic\">Henüz bölüm seçilmedi. Aşağıdaki butonlara basarak sırayla diziniz.</span>'; } else { selectedItems.forEach((item, index) => { const el = document.createElement('div'); el.className = 'bg-amber-500/20 border border-amber-500/40 text-amber-200 px-3 py-2 rounded-lg text-lg font-semibold flex items-center gap-3 dir-rtl'; el.innerHTML = `<span class=\"text-xs bg-amber-500/30 text-amber-300 px-2 py-0.5 rounded font-mono font-bold\">${index + 1}</span> <span class=\"text-xl\">${item.text}</span>`; selArea.appendChild(el); }); } optArea.innerHTML = ''; availableItems.forEach(item => { const btn = document.createElement('button'); btn.className = 'w-full bg-slate-800 hover:bg-slate-700 text-amber-100 p-4 rounded-xl border border-slate-700 text-xl font-semibold text-center transition active:scale-[0.99] shadow-md flex items-center justify-center'; btn.innerText = item.text; btn.onclick = () => addItem(item); optArea.appendChild(btn); }); } function checkAnswer() { const modal = document.getElementById('resultModal'); const title = document.getElementById('resultTitle'); const msg = document.getElementById('resultMessage'); modal.classList.remove('hidden'); if (selectedItems.length !== prayers[currentPrayer].items.length) { title.innerText = '⚠️ Eksik Sıralama'; title.className = 'text-xl font-bold text-amber-400'; msg.innerText = 'Lütfen tüm dua bölümlerini sıraya dizdikten sonra kontrol ediniz.'; return; } const isCorrect = selectedItems.every((item, idx) => item.id === idx + 1); if (isCorrect) { title.innerText = '🎉 Tebrikler! Doğru Sıralama!'; title.className = 'text-xl font-bold text-emerald-400'; msg.innerText = prayers[currentPrayer].name + ' duasını eksiksiz ve doğru sırayla tamamladınız.'; } else { title.innerText = '❌ Yanlış Sıralama'; title.className = 'text-xl font-bold text-rose-400'; msg.innerText = 'Dua parçalarının sırası hatalي. \"Sıfırla\" butonuna tıklayıp tekrar deneyebilirsiniz.'; } } resetGame();</script></body></html>",
    "type": "htmlSlide",
    "title": "🧩 Salli ve Barik Duaları İnteraktif Sıralama Oyunu"
  }
]