    "htmlContent": "<!DOCTYPE html>\n<html lang=\"tr\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>En Güzel Örnek Peygamberimiz - Konu Anlatımı</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <link href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css\" rel=\"stylesheet\">\n    <link href=\"https://fonts.googleapis.com/css2?family=Fredoka:wght@300;400;600&family=Amiri:wght@700&display=swap\" rel=\"stylesheet\">\n    <style>\n        :root {\n            font-size: 16px;\n        }\n        body {\n            font-family: 'Fredoka', sans-serif;\n            background-color: #fdf4ff; /* Fuchsia-50 */\n            background-image: radial-gradient(#f0abfc 10%, transparent 10%);\n            background-size: 20px 20px;\n            color: #374151;\n            overflow: hidden; /* Prevent body scroll */\n        }\n        .arabic-text { font-family: 'Amiri', serif; }\n        .card-shadow { box-shadow: 0 10px 20px rgba(0,0,0,0.1); }\n        .gradient-header { background: linear-gradient(135deg, #a21caf 0%, #c026d3 100%); }\n        \n        /* Custom Scrollbar */\n        ::-webkit-scrollbar { width: 12px; }\n        ::-webkit-scrollbar-track { background: #fdf4ff; border-radius: 6px; }\n        ::-webkit-scrollbar-thumb { background: #d946ef; border-radius: 6px; border: 2px solid #fdf4ff; }\n        ::-webkit-scrollbar-thumb:hover { background: #c026d3; }\n    </style>\n</head>\n<body class=\"h-screen flex flex-col p-4\">\n\n    <!-- Control Bar -->\n    <div class=\"flex justify-between items-center mb-4 bg-white p-3 rounded-xl shadow-lg border-2 border-fuchsia-200 z-10\">\n        <h1 class=\"text-fuchsia-800 text-xl md:text-2xl font-bold ml-4\">\n            <i class=\"fas fa-chalkboard-teacher mr-2\"></i> 4. Ünite Konu Anlatımı\n        </h1>\n        <div class=\"flex gap-2\">\n            <button onclick=\"changeFontSize(-1)\" class=\"bg-gray-100 hover:bg-gray-200 text-gray-700 px-4 py-2 rounded-lg text-lg font-bold border border-gray-300 transition shadow-sm\" title=\"Yazıyı Küçült\">\n                <i class=\"fas fa-minus\"></i> A\n            </button>\n            <button onclick=\"changeFontSize(1)\" class=\"bg-gray-100 hover:bg-gray-200 text-gray-700 px-4 py-2 rounded-lg text-lg font-bold border border-gray-300 transition shadow-sm\" title=\"Yazıyı Büyüt\">\n                <i class=\"fas fa-plus\"></i> A\n            </button>\n            <button onclick=\"toggleFullScreen()\" class=\"bg-fuchsia-600 hover:bg-fuchsia-500 text-white px-6 py-2 rounded-lg text-lg font-bold border border-fuchsia-700 transition shadow-md hover:shadow-lg\" title=\"Tam Ekran\">\n                <i class=\"fas fa-expand\"></i> Tam Ekran\n            </button>\n        </div>\n    </div>\n\n    <!-- Main Content Area (Scrollable) -->\n    <div class=\"flex-grow w-full h-full relative overflow-hidden rounded-3xl border-4 border-fuchsia-100 bg-white/50 shadow-inner backdrop-blur-sm\">\n        <div class=\"h-full w-full overflow-y-auto p-4 md:p-8\">\n            <div class=\"max-w-6xl mx-auto\">\n                \n                <!-- Original Header -->\n                <header class=\"text-center mb-10 gradient-header text-white p-8 rounded-3xl shadow-xl relative overflow-hidden\">\n                    <div class=\"absolute -left-10 -bottom-10 opacity-20 text-9xl\">\n                        <i class=\"fas fa-star\"></i>\n                    </div>\n                    <h1 class=\"text-4xl md:text-5xl font-bold mb-2\">En Güzel Örnek Peygamberimiz</h1>\n                    <p class=\"text-xl font-medium opacity-90\">7. Sınıf - 4. Ünite</p>\n                </header>\n\n                <!-- 1. DÜNYA VE AHİRET DENGESİ -->\n                <div class=\"mb-12\">\n                    <h2 class=\"text-3xl font-bold text-center text-fuchsia-800 mb-6\"><i class=\"fas fa-balance-scale mr-2\"></i>1. Dünya ve Ahiret Dengesi</h2>\n                    <div class=\"bg-white p-8 rounded-3xl shadow-lg border-l-8 border-purple-500\">\n                        <div class=\"flex flex-col md:flex-row items-center gap-8\">\n                            <div class=\"flex-1\">\n                                <p class=\"text-lg mb-4\"><strong>\"Dünya ahiretin tarlasıdır.\"</strong> Peygamberimiz ne sadece dünya için çalışmış ne de dünyayı tamamen terk etmiştir. O, her zaman dengeyi gözetmiştir.</p>\n                                <div class=\"grid grid-cols-1 md:grid-cols-3 gap-4 mt-6\">\n                                    <div class=\"bg-red-100 p-4 rounded-xl text-center border-2 border-red-200\">\n                                        <h4 class=\"font-bold text-red-600 text-xl\">İFRAT</h4>\n                                        <p class=\"text-sm\">Aşırıya gitmek, ölçüyü aşmak.</p>\n                                    </div>\n                                    <div class=\"bg-green-100 p-4 rounded-xl text-center border-2 border-green-200 transform scale-105 shadow-md\">\n                                        <h4 class=\"font-bold text-green-700 text-2xl\">İTİDAL</h4>\n                                        <p class=\"text-sm\">Orta yol, dengeli olmak. (Önerilen)</p>\n                                    </div>\n                                    <div class=\"bg-blue-100 p-4 rounded-xl text-center border-2 border-blue-200\">\n                                        <h4 class=\"font-bold text-blue-600 text-xl\">TEFRİT</h4>\n                                        <p class=\"text-sm\">Geride kalmak, ihmal etmek.</p>\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"w-full md:w-1/3 flex justify-center\">\n                                <i class=\"fas fa-scale-balanced text-9xl text-purple-200\"></i>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n\n                <!-- 2. İNFAK VE SADAKA -->\n                <div class=\"grid grid-cols-1 md:grid-cols-2 gap-8 mb-12\">\n                    <div class=\"bg-white p-6 rounded-2xl border-t-8 border-orange-500 card-shadow\">\n                        <h3 class=\"text-2xl font-bold text-orange-600 mb-4\"><i class=\"fas fa-hand-holding-heart mr-2\"></i>2. İnfak ve Sadaka</h3>\n                        <ul class=\"space-y-3 text-gray-600 text-lg\">\n                            <li class=\"flex items-start\"><i class=\"fas fa-check text-orange-400 mt-1 mr-2\"></i> <strong>İnfak:</strong> Allah rızası için harcama yapmak.</li>\n                            <li class=\"flex items-start\"><i class=\"fas fa-check text-orange-400 mt-1 mr-2\"></i> <strong>Sadaka:</strong> Her türlü iyilik (Gülümsemek, yol tarif etmek).</li>\n                            <li class=\"flex items-start\"><i class=\"fas fa-check text-orange-400 mt-1 mr-2\"></i> <strong>Ölçü:</strong> İhtiyaç fazlasından ve en yakınlardan başlayarak verilir.</li>\n                        </ul>\n                        <div class=\"mt-4 bg-orange-50 p-3 rounded-lg text-center text-base italic font-semibold text-orange-800\">\n                            \"Yarım hurma ile de olsa ateşten korunun.\"\n                        </div>\n                    </div>\n\n                    <!-- 3. SADELİK -->\n                    <div class=\"bg-white p-6 rounded-2xl border-t-8 border-teal-500 card-shadow\">\n                        <h3 class=\"text-2xl font-bold text-teal-600 mb-4\"><i class=\"fas fa-leaf mr-2\"></i>3. Sadelik ve Tevazu</h3>\n                        <ul class=\"space-y-3 text-gray-600 text-lg\">\n                            <li class=\"flex items-start\"><i class=\"fas fa-check text-teal-400 mt-1 mr-2\"></i> <strong>İsraf Yok:</strong> Yiyin, için fakat israf etmeyin.</li>\n                            <li class=\"flex items-start\"><i class=\"fas fa-check text-teal-400 mt-1 mr-2\"></i> <strong>Mütevazı Yaşam:</strong> Lider olmasına rağmen ev işlerine yardım eder, yamalı elbise giyerdi.</li>\n                            <li class=\"flex items-start\"><i class=\"fas fa-check text-teal-400 mt-1 mr-2\"></i> <strong>Sadelik:</strong> Gösterişten uzak, doğal bir hayat.</li>\n                        </ul>\n                        <div class=\"mt-4 bg-teal-50 p-3 rounded-lg text-center text-base italic font-semibold text-teal-800\">\n                            \"Sadelik imandandır.\"\n                        </div>\n                    </div>\n                </div>\n\n                <!-- 4. AFFEDİCİLİK & 5. HADİS -->\n                <div class=\"mb-12\">\n                    <div class=\"grid grid-cols-1 md:grid-cols-3 gap-6\">\n                        <!-- Affedicilik -->\n                        <div class=\"md:col-span-2 bg-rose-50 rounded-3xl p-8 border-2 border-rose-200\">\n                            <h2 class=\"text-3xl font-bold text-rose-700 mb-4\"><i class=\"fas fa-heart mr-2\"></i>4. Affedici Olmak</h2>\n                            <p class=\"text-lg text-gray-700 mb-4\">Peygamberimiz \"Rahmet Peygamberi\" idi. İntikam almaz, affederdi.</p>\n                            <div class=\"flex gap-4 overflow-x-auto pb-2\">\n                                <div class=\"min-w-[200px] bg-white p-4 rounded-xl shadow-sm border border-rose-100\">\n                                    <h5 class=\"font-bold text-rose-600 text-lg\">Taif Olayı</h5>\n                                    <p class=\"text-sm mt-2 text-gray-600\">Kendisini taşlayanlara beddua etmedi, hidayet diledi.</p>\n                                </div>\n                                <div class=\"min-w-[200px] bg-white p-4 rounded-xl shadow-sm border border-rose-100\">\n                                    <h5 class=\"font-bold text-rose-600 text-lg\">Mekke'nin Fethi</h5>\n                                    <p class=\"text-sm mt-2 text-gray-600\">Kendisine zulmeden müşrikleri \"Bugün size kınama yok\" diyerek affetti.</p>\n                                </div>\n                                <div class=\"min-w-[200px] bg-white p-4 rounded-xl shadow-sm border border-rose-100\">\n                                    <h5 class=\"font-bold text-rose-600 text-lg\">Uhud Savaşı</h5>\n                                    <p class=\"text-sm mt-2 text-gray-600\">Dişini kıranlar için bile dua etti.</p>\n                                </div>\n                            </div>\n                        </div>\n\n                        <!-- Sadaka-i Cariye -->\n                        <div class=\"bg-indigo-600 text-white rounded-3xl p-6 flex flex-col justify-center items-center text-center shadow-xl\">\n                            <i class=\"fas fa-infinity text-6xl mb-4 text-yellow-300\"></i>\n                            <h3 class=\"text-2xl font-bold mb-2\">Sadaka-i Cariye</h3>\n                            <p class=\"text-base opacity-90 mb-4 font-medium\">Öldükten sonra da sevap kazandıran 3 şey:</p>\n                            <ul class=\"text-left text-lg space-y-2 w-full pl-4 font-light\">\n                                <li>1. Kalıcı Eser <span class=\"text-sm opacity-70\">(Cami, Okul)</span></li>\n                                <li>2. Faydalı İlim</li>\n                                <li>3. Hayırlı Evlat</li>\n                            </ul>\n                        </div>\n                    </div>\n                </div>\n\n            </div>\n        </div>\n    </div>\n\n    <script>\n        let currentFontSize = 16;\n\n        function changeFontSize(amount) {\n            currentFontSize += amount;\n            if (currentFontSize < 12) currentFontSize = 12;\n            if (currentFontSize > 28) currentFontSize = 28;\n            document.documentElement.style.fontSize = currentFontSize + 'px';\n        }\n\n        function toggleFullScreen() {\n            if (!document.fullscreenElement) {\n                document.documentElement.requestFullscreen();\n            } else {\n                if (document.exitFullscreen) {\n                    document.exitFullscreen();\n                }\n            }\n        }\n    </script>\n</body>\n</html>",
