    "htmlContent": "<!DOCTYPE html>\n<html lang=\"tr\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>4. Ünite Akıllı Tahta Etkinlikleri</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <link href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css\" rel=\"stylesheet\">\n    <link href=\"https://fonts.googleapis.com/css2?family=Fredoka:wght@400;600&display=swap\" rel=\"stylesheet\">\n    <style>\n        body {\n            font-family: 'Fredoka', sans-serif;\n            background-color: #fdf2f8; /* Pink-50 */\n            user-select: none;\n        }\n        .touch-btn:active { transform: scale(0.95); }\n        .card-front, .card-back {\n            backface-visibility: hidden;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            border-radius: 1rem;\n        }\n        .perspective { perspective: 1000px; }\n        .flipped .card-inner { transform: rotateY(180deg); }\n        .card-inner {\n            position: relative;\n            width: 100%;\n            height: 100%;\n            transition: transform 0.6s;\n            transform-style: preserve-3d;\n        }\n        .card-back {\n            transform: rotateY(180deg);\n            position: absolute;\n            top: 0; left: 0; width: 100%; height: 100%;\n        }\n    </style>\n</head>\n<body class=\"h-screen flex flex-col overflow-hidden\">\n\n    <!-- Navbar -->\n    <header class=\"bg-fuchsia-700 text-white p-4 shadow-lg flex justify-between items-center z-10\">\n        <h1 class=\"text-3xl font-bold\"><i class=\"fas fa-gamepad mr-3\"></i>En Güzel Örnek Peygamberimiz</h1>\n        <button onclick=\"goHome()\" class=\"bg-fuchsia-900 hover:bg-fuchsia-800 px-6 py-2 rounded-xl text-xl font-bold transition shadow-md\">\n            <i class=\"fas fa-home\"></i> Ana Menü\n        </button>\n    </header>\n\n    <main class=\"flex-grow relative flex items-center justify-center p-6\">\n        \n        <!-- MENU SCREEN -->\n        <div id=\"menu-screen\" class=\"w-full max-w-6xl grid grid-cols-1 md:grid-cols-3 gap-8\">\n            <div onclick=\"startGame('quiz')\" class=\"touch-btn cursor-pointer bg-white border-b-8 border-purple-500 rounded-3xl p-8 shadow-2xl flex flex-col items-center justify-center hover:bg-purple-50 h-80\">\n                <i class=\"fas fa-question-circle text-7xl text-purple-500 mb-4\"></i>\n                <h2 class=\"text-3xl font-bold text-gray-700\">Bilgi Yarışması</h2>\n                <p class=\"text-lg text-gray-500 mt-2\">Çoktan seçmeli sorular.</p>\n            </div>\n            <div onclick=\"startGame('tf')\" class=\"touch-btn cursor-pointer bg-white border-b-8 border-pink-500 rounded-3xl p-8 shadow-2xl flex flex-col items-center justify-center hover:bg-pink-50 h-80\">\n                <i class=\"fas fa-check-double text-7xl text-pink-500 mb-4\"></i>\n                <h2 class=\"text-3xl font-bold text-gray-700\">Doğru mu Yanlış mı?</h2>\n                <p class=\"text-lg text-gray-500 mt-2\">Peygamberimizin hayatı.</p>\n            </div>\n            <div onclick=\"startGame('cards')\" class=\"touch-btn cursor-pointer bg-white border-b-8 border-orange-500 rounded-3xl p-8 shadow-2xl flex flex-col items-center justify-center hover:bg-orange-50 h-80\">\n                <i class=\"fas fa-layer-group text-7xl text-orange-500 mb-4\"></i>\n                <h2 class=\"text-3xl font-bold text-gray-700\">Kavram Kartları</h2>\n                <p class=\"text-lg text-gray-500 mt-2\">İfrat, Tefrit, İtidal...</p>\n            </div>\n        </div>\n\n        <!-- GAME 1: QUIZ -->\n        <div id=\"quiz-screen\" class=\"hidden w-full max-w-5xl h-full flex flex-col justify-center\">\n            <div class=\"bg-white rounded-3xl shadow-xl border-4 border-purple-200 p-8 h-full flex flex-col\">\n                <div class=\"flex justify-between text-2xl font-bold text-purple-800 mb-6\">\n                    <span id=\"quiz-progress\">Soru 1/5</span>\n                    <span id=\"quiz-score\">Puan: 0</span>\n                </div>\n                <div class=\"flex-grow flex items-center justify-center mb-8 bg-purple-50 rounded-2xl p-6\">\n                    <h2 id=\"q-text\" class=\"text-4xl font-bold text-center text-gray-800\"></h2>\n                </div>\n                <div id=\"q-options\" class=\"grid grid-cols-2 gap-6 h-64\"></div>\n            </div>\n        </div>\n\n        <!-- GAME 2: TRUE/FALSE -->\n        <div id=\"tf-screen\" class=\"hidden w-full max-w-4xl h-full flex flex-col justify-center\">\n             <div class=\"bg-white rounded-3xl shadow-xl border-4 border-pink-200 p-8 h-full flex flex-col items-center text-center\">\n                <h2 class=\"text-3xl font-bold text-pink-700 mb-8\">Bu ifade Doğru mu?</h2>\n                <div class=\"flex-grow flex items-center justify-center w-full bg-pink-50 rounded-2xl p-6 mb-8\">\n                    <p id=\"tf-statement\" class=\"text-4xl font-bold text-gray-800\"></p>\n                </div>\n                <div class=\"flex gap-8 w-full h-32\">\n                    <button onclick=\"checkTF(true)\" class=\"flex-1 bg-green-500 hover:bg-green-600 text-white text-4xl font-bold rounded-2xl shadow-lg border-b-8 border-green-700 touch-btn\">DOĞRU</button>\n                    <button onclick=\"checkTF(false)\" class=\"flex-1 bg-red-500 hover:bg-red-600 text-white text-4xl font-bold rounded-2xl shadow-lg border-b-8 border-red-700 touch-btn\">YANLIŞ</button>\n                </div>\n             </div>\n        </div>\n\n        <!-- GAME 3: CARDS -->\n        <div id=\"cards-screen\" class=\"hidden w-full max-w-6xl h-full flex flex-col items-center justify-center\">\n            <h2 class=\"text-4xl font-bold text-orange-800 mb-8\">Karta Dokun ve Anlamını Gör</h2>\n            <div class=\"grid grid-cols-2 md:grid-cols-3 gap-8 w-full h-3/4\">\n                <!-- Card 1 -->\n                <div class=\"perspective cursor-pointer\" onclick=\"flipCard(this)\">\n                    <div class=\"card-inner\">\n                        <div class=\"card-front bg-teal-100 border-4 border-teal-300\">\n                            <h3 class=\"text-3xl font-bold text-teal-800\">İTİDAL</h3>\n                        </div>\n                        <div class=\"card-back bg-teal-600 text-white border-4 border-teal-800\">\n                            <p class=\"text-xl font-bold px-4 text-center\">Aşırılıklardan uzak durup orta yolu tutmak, denge.</p>\n                        </div>\n                    </div>\n                </div>\n                <!-- Card 2 -->\n                <div class=\"perspective cursor-pointer\" onclick=\"flipCard(this)\">\n                    <div class=\"card-inner\">\n                        <div class=\"card-front bg-blue-100 border-4 border-blue-300\">\n                            <h3 class=\"text-3xl font-bold text-blue-800\">SADAKA-İ CARİYE</h3>\n                        </div>\n                        <div class=\"card-back bg-blue-600 text-white border-4 border-blue-800\">\n                            <p class=\"text-xl font-bold px-4 text-center\">Öldükten sonra da sevap kazandıran kalıcı iyilikler (Okul, Çeşme).</p>\n                        </div>\n                    </div>\n                </div>\n                <!-- Card 3 -->\n                <div class=\"perspective cursor-pointer\" onclick=\"flipCard(this)\">\n                    <div class=\"card-inner\">\n                        <div class=\"card-front bg-purple-100 border-4 border-purple-300\">\n                            <h3 class=\"text-3xl font-bold text-purple-800\">İNFAK</h3>\n                        </div>\n                        <div class=\"card-back bg-purple-600 text-white border-4 border-purple-800\">\n                            <p class=\"text-xl font-bold px-4 text-center\">Allah rızası için maldan harcama yapmak.</p>\n                        </div>\n                    </div>\n                </div>\n                <!-- Card 4 -->\n                <div class=\"perspective cursor-pointer\" onclick=\"flipCard(this)\">\n                    <div class=\"card-inner\">\n                        <div class=\"card-front bg-red-100 border-4 border-red-300\">\n                            <h3 class=\"text-3xl font-bold text-red-800\">İFRAT</h3>\n                        </div>\n                        <div class=\"card-back bg-red-600 text-white border-4 border-red-800\">\n                            <p class=\"text-xl font-bold px-4 text-center\">Herhangi bir konuda çok ileri gitmek, ölçüyü aşmak.</p>\n                        </div>\n                    </div>\n                </div>\n                <!-- Card 5 -->\n                <div class=\"perspective cursor-pointer\" onclick=\"flipCard(this)\">\n                    <div class=\"card-inner\">\n                        <div class=\"card-front bg-yellow-100 border-4 border-yellow-300\">\n                            <h3 class=\"text-3xl font-bold text-yellow-800\">TEFRİT</h3>\n                        </div>\n                        <div class=\"card-back bg-yellow-600 text-white border-4 border-yellow-800\">\n                            <p class=\"text-xl font-bold px-4 text-center\">Bir konuda geride kalmak, gevşeklik göstermek.</p>\n                        </div>\n                    </div>\n                </div>\n                <!-- Card 6 -->\n                <div class=\"perspective cursor-pointer\" onclick=\"flipCard(this)\">\n                    <div class=\"card-inner\">\n                        <div class=\"card-front bg-gray-100 border-4 border-gray-300\">\n                            <h3 class=\"text-3xl font-bold text-gray-800\">SADELİK</h3>\n                        </div>\n                        <div class=\"card-back bg-gray-600 text-white border-4 border-gray-800\">\n                            <p class=\"text-xl font-bold px-4 text-center\">İsraftan kaçınmak, gösterişsiz ve doğal yaşamak.</p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n\n        <!-- RESULT SCREEN -->\n        <div id=\"result-screen\" class=\"hidden w-full flex flex-col items-center justify-center animate-bounce\">\n            <i class=\"fas fa-trophy text-9xl text-yellow-400 mb-6\"></i>\n            <h2 class=\"text-7xl font-bold text-gray-800 mb-4\">Tebrikler!</h2>\n            <p id=\"final-msg\" class=\"text-4xl text-gray-600 mb-10\"></p>\n            <button onclick=\"goHome()\" class=\"bg-fuchsia-600 text-white px-12 py-6 rounded-full text-3xl font-bold shadow-xl\">Başa Dön</button>\n        </div>\n\n    </main>\n\n    <script>\n        const quizData = [\n            { q: \"Peygamberimizin 'Ben bazen oruç tutarım bazen tutmam' demesi neye örnektir?\", correct: \"Denge (İtidal)\", options: [\"Tefrit\", \"Denge (İtidal)\", \"İfrat\", \"İsraf\"] },\n            { q: \"Aşağıdakilerden hangisi Sadaka-i Cariye örneğidir?\", correct: \"Hastane Yaptırmak\", options: [\"Gülümsemek\", \"Selam vermek\", \"Hastane Yaptırmak\", \"Borç Vermek\"] },\n            { q: \"Bir konuda aşırıya gitmeye, ölçüyü aşmaya ne denir?\", correct: \"İfrat\", options: [\"İtidal\", \"İfrat\", \"Tefrit\", \"İsraf\"] },\n            { q: \"Peygamberimiz Mekke'nin fethinde kendisini üzenlere ne yapmıştır?\", correct: \"Affetmiştir\", options: [\"Cezalandırmıştır\", \"Sürgün etmiştir\", \"Affetmiştir\", \"Hapse atmıştır\"] },\n            { q: \"Peygamberimizin giyim ve ev eşyalarında tercih ettiği yaşam tarzı hangisidir?\", correct: \"Sadelik\", options: [\"Lüks\", \"Sadelik\", \"Cimrilik\", \"Gösteriş\"] }\n        ];\n\n        const tfData = [\n            { s: \"Peygamberimiz Taif'te taşlanmasına rağmen beddua etmemiştir.\", a: true },\n            { s: \"Sadece zenginler sadaka verebilir.\", a: false },\n            { s: \"Dünya hayatı önemsizdir, hiç çalışmaya gerek yoktur.\", a: false },\n            { s: \"Peygamberimiz ev işlerinde ailesine yardım ederdi.\", a: true },\n            { s: \"Hayırlı evlat, anne babası öldükten sonra onlara sevap kazandırır.\", a: true }\n        ];\n\n        let currentIdx = 0, score = 0, activeGame = \"\";\n\n        function hideAll() {\n            document.getElementById('menu-screen').classList.add('hidden');\n            document.getElementById('quiz-screen').classList.add('hidden');\n            document.getElementById('tf-screen').classList.add('hidden');\n            document.getElementById('cards-screen').classList.add('hidden');\n            document.getElementById('result-screen').classList.add('hidden');\n        }\n\n        function goHome() { hideAll(); document.getElementById('menu-screen').classList.remove('hidden'); }\n\n        function startGame(game) {\n            hideAll(); activeGame = game; currentIdx = 0; score = 0;\n            if(game === 'quiz') { document.getElementById('quiz-screen').classList.remove('hidden'); loadQuiz(); }\n            else if(game === 'tf') { document.getElementById('tf-screen').classList.remove('hidden'); loadTF(); }\n            else if(game === 'cards') { document.getElementById('cards-screen').classList.remove('hidden'); }\n        }\n\n        function loadQuiz() {\n            const d = quizData[currentIdx];\n            document.getElementById('q-text').innerText = d.q;\n            document.getElementById('quiz-progress').innerText = `Soru ${currentIdx+1}/${quizData.length}`;\n            document.getElementById('quiz-score').innerText = `Puan: ${score}`;\n            const c = document.getElementById('q-options'); c.innerHTML = '';\n            d.options.forEach(o => {\n                const btn = document.createElement('button');\n                btn.className = \"bg-purple-100 hover:bg-purple-200 text-purple-900 text-2xl font-bold rounded-2xl border-b-4 border-purple-300 p-4 touch-btn\";\n                btn.innerText = o;\n                btn.onclick = () => checkQuiz(o, btn);\n                c.appendChild(btn);\n            });\n        }\n\n        function checkQuiz(ans, btn) {\n            if(ans === quizData[currentIdx].correct) { btn.classList.add('bg-green-500', 'text-white'); score+=20; }\n            else { btn.classList.add('bg-red-500', 'text-white'); }\n            setTimeout(() => { currentIdx++; if(currentIdx < quizData.length) loadQuiz(); else showResult(); }, 1000);\n        }\n\n        function loadTF() { document.getElementById('tf-statement').innerText = tfData[currentIdx].s; }\n\n        function checkTF(ans) {\n            if(ans === tfData[currentIdx].a) score+=20;\n            setTimeout(() => { currentIdx++; if(currentIdx < tfData.length) loadTF(); else showResult(); }, 500);\n        }\n\n        function flipCard(el) { el.classList.toggle('flipped'); }\n\n        function showResult() {\n            hideAll(); document.getElementById('result-screen').classList.remove('hidden');\n            document.getElementById('final-msg').innerText = `Toplam Puan: ${score}`;\n        }\n    </script>\n</body>\n</html>",
    "title": "İnteraktif Sunum",
    "isPublished": true
