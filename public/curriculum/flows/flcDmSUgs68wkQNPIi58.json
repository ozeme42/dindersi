    "htmlContent": "<!DOCTYPE html>\n<html lang=\"tr\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no\">\n    <title>Doğruluk Oyun Merkezi</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <link href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css\" rel=\"stylesheet\">\n    <link href=\"https://fonts.googleapis.com/css2?family=Fredoka:wght@400;600&family=Nunito:wght@400;700&display=swap\" rel=\"stylesheet\">\n\n    <style>\n        body { font-family: 'Nunito', sans-serif; background-color: #111827; color: white; touch-action: manipulation; overflow: hidden; }\n        h1, h2 { font-family: 'Fredoka', sans-serif; }\n\n        /* HEADER */\n        .header-btn { padding: 15px 30px; border-radius: 12px; font-size: 1.1rem; background: rgba(255,255,255,0.05); transition: all 0.3s; font-weight: bold; border: 1px solid rgba(255,255,255,0.1); display: flex; align-items: center; gap: 10px; }\n        .header-btn.active { background: #2563eb; border-color: #60a5fa; box-shadow: 0 0 20px rgba(37, 99, 235, 0.5); transform: scale(1.05); }\n\n        /* OYUN 1: DOĞRU/YANLIŞ */\n        .tf-btn { padding: 2rem; border-radius: 1rem; font-size: 1.5rem; font-weight: bold; transition: all 0.2s; border: 2px solid rgba(255,255,255,0.2); }\n        .tf-btn:hover { transform: scale(1.05); }\n        .tf-btn.true { background: #059669; }\n        .tf-btn.false { background: #b91c1c; }\n\n        /* OYUN 2: EŞLEŞTİRME */\n        .match-item { padding: 1.5rem; font-size: 1.2rem; border-radius: 1rem; cursor: pointer; transition: all 0.2s; border: 1px solid rgba(255,255,255,0.1); background: #1f2937; }\n        .match-item:hover { background: #374151; transform: translateX(5px); }\n        .match-item.selected { background: #f59e0b !important; color: black; border-color: #fbbf24; transform: scale(1.02); }\n        .match-item.matched { background: #10b981 !important; opacity: 0.5; pointer-events: none; }\n        .match-item.wrong { animation: shake 0.4s; background: #ef4444 !important; }\n\n        /* OYUN 3: SENARYO */\n        .scenario-btn { text-align: left; padding: 1.5rem; font-size: 1.2rem; background: rgba(255,255,255,0.05); border-radius: 1rem; border: 1px solid rgba(255,255,255,0.1); transition: all 0.2s; }\n        .scenario-btn:hover { background: rgba(255,255,255,0.15); transform: translateY(-2px); }\n        .scenario-btn.correct { background: #059669; border-color: #34d399; }\n        .scenario-btn.wrong { background: #b91c1c; border-color: #f87171; }\n\n        /* OYUN 4: ANAGRAM */\n        .slot { width: 60px; height: 80px; border-bottom: 4px solid #94a3b8; display: flex; align-items: center; justify-content: center; font-size: 2.5rem; font-weight: bold; margin: 0 5px; transition: all 0.3s; }\n        .slot.filled { border-color: #fbbf24; color: #fbbf24; animation: popIn 0.3s; }\n        .letter-btn { width: 70px; height: 70px; border-radius: 12px; font-size: 2rem; font-weight: bold; display: flex; align-items: center; justify-content: center; cursor: pointer; background: #2563eb; border-bottom: 6px solid #1e40af; user-select: none; transition: transform 0.1s; }\n        .letter-btn:active { transform: translateY(6px); border-bottom: 0; }\n        .letter-btn.used { opacity: 0; pointer-events: none; transform: scale(0); }\n\n        @keyframes shake { 0%, 100% { transform: translateX(0); } 25% { transform: translateX(-5px); } 75% { transform: translateX(5px); } }\n        @keyframes popIn { from { transform: scale(0.5); opacity: 0; } to { transform: scale(1); opacity: 1; } }\n    </style>\n</head>\n<body class=\"h-screen w-screen flex flex-col\">\n\n    <!-- Header -->\n    <header class=\"bg-slate-900 p-6 shadow-2xl flex justify-between items-center z-50 h-[100px]\">\n        <h1 class=\"text-3xl text-blue-400 font-bold\"><i class=\"fas fa-check-double mr-3\"></i>DOĞRULUK OYUNLARI</h1>\n        <div class=\"flex gap-4\">\n            <button onclick=\"switchTab('game1')\" id=\"btn-game1\" class=\"header-btn active\"><i class=\"fas fa-check\"></i> Doğru/Yanlış</button>\n            <button onclick=\"switchTab('game2')\" id=\"btn-game2\" class=\"header-btn\"><i class=\"fas fa-link\"></i> Eşleştirme</button>\n            <button onclick=\"switchTab('game3')\" id=\"btn-game3\" class=\"header-btn\"><i class=\"fas fa-question-circle\"></i> Ne Yapardın?</button>\n            <button onclick=\"switchTab('game4')\" id=\"btn-game4\" class=\"header-btn\"><i class=\"fas fa-spell-check\"></i> Kelime Avı</button>\n        </div>\n    </header>\n\n    <!-- Oyun Alanı -->\n    <div id=\"game-container\" class=\"w-full h-[calc(100vh-100px)] flex justify-center items-center p-4\">\n        \n        <!-- OYUN 1: DOĞRU/YANLIŞ -->\n        <div id=\"game1\" class=\"w-full max-w-4xl text-center\">\n            <div class=\"bg-slate-800 p-12 rounded-3xl border border-slate-700 shadow-2xl relative\">\n                <span class=\"text-blue-400 font-bold text-xl block mb-6\" id=\"tf-counter\">Soru 1/5</span>\n                <h2 class=\"text-4xl font-bold mb-12 text-white leading-relaxed\" id=\"tf-question\">...</h2>\n                <div class=\"flex gap-8 justify-center\">\n                    <button onclick=\"checkTF(true)\" class=\"tf-btn true w-48\"><i class=\"fas fa-check mr-2\"></i>Doğru</button>\n                    <button onclick=\"checkTF(false)\" class=\"tf-btn false w-48\"><i class=\"fas fa-times mr-2\"></i>Yanlış</button>\n                </div>\n                <div id=\"tf-feedback\" class=\"mt-8 h-8 text-2xl font-bold\"></div>\n            </div>\n        </div>\n\n        <!-- OYUN 2: EŞLEŞTİRME -->\n        <div id=\"game2\" class=\"hidden w-full h-full flex flex-col items-center justify-center\">\n            <div class=\"text-center mb-10\">\n                <h2 class=\"text-4xl font-bold mb-4 text-blue-200\">Kavramları Eşleştir</h2>\n                <p class=\"text-xl text-gray-400\">Tanımları ve isimleri doğru eşleştir.</p>\n            </div>\n            <div class=\"grid grid-cols-2 gap-16 w-full max-w-6xl\">\n                <div class=\"flex flex-col gap-4\" id=\"col-defs\"></div>\n                <div class=\"flex flex-col gap-4\" id=\"col-terms\"></div>\n            </div>\n            <div id=\"msg2\" class=\"text-center mt-10 text-4xl font-bold hidden text-green-400\">Harika! Hepsini eşleştirdin.</div>\n        </div>\n\n        <!-- OYUN 3: SENARYO -->\n        <div id=\"game3\" class=\"hidden w-full max-w-4xl\">\n            <div class=\"text-center mb-10\">\n                <h2 class=\"text-4xl font-bold mb-4 text-yellow-200\">Sen Olsan Ne Yapardın?</h2>\n                <p class=\"text-xl text-gray-400\">Günlük hayatta karşılaşabileceğin durumlarda dürüst olanı seç.</p>\n            </div>\n            <div id=\"scenario-card\" class=\"bg-slate-800 p-10 rounded-3xl border border-slate-700 shadow-2xl\"></div>\n        </div>\n\n        <!-- OYUN 4: ANAGRAM -->\n        <div id=\"game4\" class=\"hidden w-full max-w-5xl flex flex-col items-center\">\n            <div class=\"bg-slate-800 p-12 rounded-3xl border border-slate-700 shadow-2xl w-full text-center relative\">\n                <span class=\"absolute top-0 left-1/2 -translate-x-1/2 -translate-y-1/2 bg-blue-600 px-6 py-2 rounded-full font-bold shadow-lg text-lg\" id=\"anagram-counter\">Soru 1</span>\n                <h2 class=\"text-4xl font-bold mb-10 text-white\" id=\"anagram-q\">...</h2>\n                \n                <div class=\"flex justify-center flex-wrap gap-4 mb-10\" id=\"anagram-slots\"></div>\n                <div class=\"flex justify-center flex-wrap gap-4\" id=\"anagram-pool\"></div>\n                \n                <div id=\"anagram-msg\" class=\"mt-8 h-10 text-3xl font-bold text-green-400\"></div>\n                <button onclick=\"nextAnagram()\" id=\"anagram-next\" class=\"hidden mt-8 bg-green-600 hover:bg-green-500 px-10 py-4 rounded-full font-bold shadow-lg transition text-xl\">Sonraki Soru <i class=\"fas fa-arrow-right ml-2\"></i></button>\n            </div>\n        </div>\n\n    </div>\n\n    <script>\n        function switchTab(id) {\n            ['game1', 'game2', 'game3', 'game4'].forEach(g => document.getElementById(g).classList.add('hidden'));\n            ['btn-game1', 'btn-game2', 'btn-game3', 'btn-game4'].forEach(b => document.getElementById(b).classList.remove('active'));\n            \n            document.getElementById(id).classList.remove('hidden');\n            document.getElementById('btn-' + id).classList.add('active');\n\n            if(id === 'game4' && !isAnagramInit) initAnagram();\n        }\n\n        // --- OYUN 1: DOĞRU/YANLIŞ ---\n        const tfQuestions = [\n            { q: \"Güven, kırılan bir cam gibidir; yapıştırılsa bile izi belli olur.\", a: true, fb: \"Doğru! Kaybolan güvenin tamiri zordur.\" },\n            { q: \"Doğru sözlü olmak, sadece sözlerimizde dürüst olmak demektir.\", a: false, fb: \"Hayır, davranışlarımızda ve özümüzde de dürüst olmalıyız.\" },\n            { q: \"Peygamberimiz şaka yaparken bile yalan söylememiştir.\", a: true, fb: \"Doğru! O, şakada bile dürüsttü.\" },\n            { q: \"Endonezya'daki tüccar, fazla parayı aldığı için zengin olmuştur.\", a: false, fb: \"Yanlış! Parayı iade etmiş, dürüstlüğüyle halkın Müslüman olmasını sağlamıştır.\" },\n            { q: \"Hz. Şuayb'ın kavmi ölçü ve tartıda hile yapıyordu.\", a: true, fb: \"Doğru! Medyen halkı bu yüzden uyarılmıştı.\" },\n            { q: \"Bir yalanı gizlemek için başka yalanlara başvurulmaz.\", a: false, fb: \"Yanlış! Genellikle bir yalan, diğer yalanları doğurur (Domino Etkisi).\" }\n        ];\n        let tfIdx = 0;\n\n        function checkTF(answer) {\n            const q = tfQuestions[tfIdx];\n            const fb = document.getElementById('tf-feedback');\n            if(answer === q.a) {\n                fb.innerHTML = `<span class=\"text-green-400\">TEBRİKLER! ${q.fb}</span>`;\n                setTimeout(() => {\n                    tfIdx++;\n                    if(tfIdx < tfQuestions.length) loadTF();\n                    else fb.innerHTML = \"OYUN BİTTİ! HEPSİNİ BİLDİNİZ.\";\n                }, 2500);\n            } else {\n                fb.innerHTML = `<span class=\"text-red-400\">YANLIŞ. ${q.fb}</span>`;\n            }\n        }\n\n        function loadTF() {\n            if(tfIdx < tfQuestions.length) {\n                document.getElementById('tf-counter').innerText = `Soru ${tfIdx+1}/${tfQuestions.length}`;\n                document.getElementById('tf-question').innerText = tfQuestions[tfIdx].q;\n                document.getElementById('tf-feedback').innerText = \"\";\n            }\n        }\n        loadTF();\n\n        // --- OYUN 2: EŞLEŞTİRME ---\n        const matchData = [\n            { def: \"Peygamberimizin 'Güvenilir' lakabı.\", term: \"EL-EMİN\" },\n            { def: \"Ticarette hile yapan kavim.\", term: \"MEDYEN\" },\n            { def: \"Medyen halkına gönderilen peygamber.\", term: \"HZ. ŞUAYB\" },\n            { def: \"Doğruluk, dürüstlük.\", term: \"SIDK\" },\n            { def: \"İnsanın iyi ve kötü huyları.\", term: \"AHLAK\" }\n        ];\n\n        let selDef = null, selTerm = null, matches = 0;\n        const defCol = document.getElementById('col-defs');\n        const termCol = document.getElementById('col-terms');\n\n        const shufDefs = [...matchData].sort(() => Math.random() - 0.5);\n        const shufTerms = [...matchData].sort(() => Math.random() - 0.5);\n\n        shufDefs.forEach(d => {\n            const btn = document.createElement('div');\n            btn.className = 'match-item bg-slate-700 text-lg';\n            btn.innerText = d.def;\n            btn.onclick = () => selectItem(btn, 'def', d.term);\n            defCol.appendChild(btn);\n        });\n\n        shufTerms.forEach(t => {\n            const btn = document.createElement('div');\n            btn.className = 'match-item bg-slate-800 text-center font-bold text-xl';\n            btn.innerText = t.term;\n            btn.onclick = () => selectItem(btn, 'term', t.term);\n            termCol.appendChild(btn);\n        });\n\n        function selectItem(el, type, val) {\n            if(el.classList.contains('matched')) return;\n            \n            if(type === 'def') {\n                if(selDef) selDef.el.classList.remove('selected');\n                selDef = { el, val };\n            } else {\n                if(selTerm) selTerm.el.classList.remove('selected');\n                selTerm = { el, val };\n            }\n            el.classList.add('selected');\n\n            if(selDef && selTerm) {\n                if(selDef.val === selTerm.val) {\n                    selDef.el.classList.add('matched'); selTerm.el.classList.add('matched');\n                    selDef.el.classList.remove('selected'); selTerm.el.classList.remove('selected');\n                    selDef = null; selTerm = null; matches++;\n                    if(matches === matchData.length) document.getElementById('msg2').classList.remove('hidden');\n                } else {\n                    selDef.el.classList.add('wrong'); selTerm.el.classList.add('wrong');\n                    setTimeout(() => {\n                        selDef.el.classList.remove('wrong', 'selected');\n                        selTerm.el.classList.remove('wrong', 'selected');\n                        selDef = null; selTerm = null;\n                    }, 500);\n                }\n            }\n        }\n\n        // --- OYUN 3: SENARYO ---\n        const scenarios = [\n            {\n                q: \"Arkadaşına şaka olsun diye 'Öğretmen seni çağırıyor' diye yalan söyledin. Arkadaşın korktu. Ne olur?\",\n                opts: [\n                    { t: \"Şaka olduğu için sorun olmaz.\", c: false },\n                    { t: \"Arkadaşının sana güveni sarsılır (Yalancı Çoban etkisi).\", c: true }\n                ]\n            },\n            {\n                q: \"Kantinci dalgınlıkla sana 10 TL fazla para üstü verdi. Ne yaparsın?\",\n                opts: [\n                    { t: \"Fark etmemiş gibi cebime atarım.\", c: false },\n                    { t: \"Parayı geri verip hatasını söylerim.\", c: true }\n                ]\n            },\n            {\n                q: \"Ödevini yapmadın ama öğretmenin sordu. Ne dersin?\",\n                opts: [\n                    { t: \"Dürüstçe unuttuğumu söyler, özür dilerim.\", c: true },\n                    { t: \"Evde unuttum veya hastaydım diye yalan söylerim.\", c: false }\n                ]\n            },\n            {\n                q: \"Arkadaşın sırrını tutmanı istedi ama başkası soruyor.\",\n                opts: [\n                    { t: \"Doğru sözlü olmak için sırrı hemen anlatırım.\", c: false },\n                    { t: \"Sır saklamak da bir dürüstlüktür, emaneti korurum.\", c: true }\n                ]\n            }\n        ];\n        let scenIdx = 0;\n\n        function loadScenario() {\n            if(scenIdx >= scenarios.length) {\n                document.getElementById('scenario-card').innerHTML = '<h3 class=\"text-4xl text-center text-green-400 font-bold\">Harika! Dürüstlük kazandı.</h3><button onclick=\"location.reload()\" class=\"mt-8 w-full bg-slate-600 py-4 rounded-xl text-xl\">Başa Dön</button>';\n                return;\n            }\n            const data = scenarios[scenIdx];\n            let html = `<div class=\"mb-6 text-yellow-400 font-bold text-xl\">DURUM ${scenIdx + 1}</div><p class=\"text-3xl mb-10 font-bold leading-relaxed\">${data.q}</p><div class=\"space-y-4\">`;\n            data.opts.forEach(opt => {\n                html += `<button onclick=\"checkScenario(this, ${opt.c})\" class=\"scenario-btn w-full text-xl font-bold\">${opt.t}</button>`;\n            });\n            html += `</div><div id=\"scen-msg\" class=\"mt-8 font-bold text-center h-10 text-2xl\"></div>`;\n            document.getElementById('scenario-card').innerHTML = html;\n        }\n\n        function checkScenario(btn, isCorrect) {\n            if(isCorrect) {\n                btn.classList.add('correct');\n                document.getElementById('scen-msg').innerText = \"DOĞRU! ✅\";\n                document.getElementById('scen-msg').className = \"mt-8 font-bold text-center h-10 text-2xl text-green-400\";\n                setTimeout(() => { scenIdx++; loadScenario(); }, 1500);\n            } else {\n                btn.classList.add('wrong');\n                document.getElementById('scen-msg').innerText = \"BU DAVRANIŞ YANLIŞ ❌\";\n                document.getElementById('scen-msg').className = \"mt-8 font-bold text-center h-10 text-2xl text-red-400\";\n            }\n        }\n        loadScenario();\n\n        // --- OYUN 4: ANAGRAM ---\n        const anagrams = [\n            { q: \"Medyen halkına gönderilen peygamber?\", a: \"ŞUAYB\" },\n            { q: \"Ölçü ve tartıda hile yapılan şehir?\", a: \"MEDYEN\" },\n            { q: \"Doğruluk ve dürüstlük anlamına gelen kavram?\", a: \"SIDK\" },\n            { q: \"Peygamberimizin 'Güvenilir' lakabı?\", a: \"ELEMİN\" },\n            { q: \"Doğru sözlü insan karşıya ne verir?\", a: \"GÜVEN\" },\n            { q: \"Yalanın zıttı?\", a: \"DOĞRULUK\" }\n        ];\n        \n        let anaIdx = 0, anaProg = 0, isAnagramInit = false;\n        let shuffledAnagrams = [];\n\n        function initAnagram() {\n            shuffledAnagrams = [...anagrams].sort(() => Math.random() - 0.5);\n            anaIdx = 0; \n            loadAnagram(); \n            isAnagramInit = true;\n        }\n\n        function loadAnagram() {\n            if(anaIdx >= shuffledAnagrams.length) {\n                document.getElementById('anagram-q').innerText = \"TEBRİKLER! TÜM SORULAR BİTTİ!\";\n                document.getElementById('anagram-slots').innerHTML = '';\n                document.getElementById('anagram-pool').innerHTML = '';\n                document.getElementById('anagram-next').classList.add('hidden');\n                document.getElementById('anagram-counter').classList.add('hidden');\n                return;\n            }\n            const data = shuffledAnagrams[anaIdx];\n            anaProg = 0;\n            document.getElementById('anagram-counter').innerText = `Soru ${anaIdx+1}/${shuffledAnagrams.length}`;\n            document.getElementById('anagram-q').innerText = data.q;\n            document.getElementById('anagram-msg').innerText = '';\n            document.getElementById('anagram-next').classList.add('hidden');\n            \n            const slots = document.getElementById('anagram-slots');\n            const pool = document.getElementById('anagram-pool');\n            slots.innerHTML = ''; pool.innerHTML = '';\n\n            for(let i=0; i<data.a.length; i++) {\n                const s = document.createElement('div'); s.className = 'slot'; s.id = `slot-${i}`;\n                slots.appendChild(s);\n            }\n\n            data.a.split('').sort(() => Math.random()-0.5).forEach(char => {\n                const btn = document.createElement('div');\n                btn.className = 'letter-btn'; btn.innerText = char;\n                btn.onclick = () => {\n                    if(char === data.a[anaProg]) {\n                        document.getElementById(`slot-${anaProg}`).innerText = char;\n                        document.getElementById(`slot-${anaProg}`).classList.add('filled');\n                        btn.classList.add('used');\n                        anaProg++;\n                        if(anaProg === data.a.length) {\n                            document.getElementById('anagram-msg').innerText = \"DOĞRU CEVAP!\";\n                            document.getElementById('anagram-next').classList.remove('hidden');\n                        }\n                    } else {\n                        btn.style.animation = 'shake 0.4s';\n                        setTimeout(()=> { btn.style.animation = ''; }, 400);\n                    }\n                };\n                pool.appendChild(btn);\n            });\n        }\n\n        function nextAnagram() { anaIdx++; loadAnagram(); }\n\n    </script>\n</body>\n</html>",
