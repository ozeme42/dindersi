    "title": "İnteraktif Sunum",
    "type": "htmlSlide",
    "isPublished": true,
    "htmlContent": "<!DOCTYPE html>\n<html lang=\"tr\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Kur'an-ı Kerim İç Düzeni - Akıllı Tahta Etkinlikleri</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <link href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css\" rel=\"stylesheet\">\n    <link href=\"https://fonts.googleapis.com/css2?family=Fredoka:wght@400;600&family=Amiri:wght@700&display=swap\" rel=\"stylesheet\">\n    <style>\n        body {\n            font-family: 'Fredoka', sans-serif;\n            background-color: #ecfdf5;\n            user-select: none; /* Metin seçimini engelle (dokunmatik için iyi) */\n        }\n        .arabic {\n            font-family: 'Amiri', serif;\n        }\n        .touch-btn {\n            transition: transform 0.1s, background-color 0.2s;\n        }\n        .touch-btn:active {\n            transform: scale(0.95);\n        }\n        /* Kart Çevirme Efekti */\n        .perspective {\n            perspective: 1000px;\n        }\n        .card-inner {\n            position: relative;\n            width: 100%;\n            height: 100%;\n            text-align: center;\n            transition: transform 0.6s;\n            transform-style: preserve-3d;\n        }\n        .card-front, .card-back {\n            position: absolute;\n            width: 100%;\n            height: 100%;\n            backface-visibility: hidden;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            border-radius: 1rem;\n            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);\n        }\n        .card-back {\n            transform: rotateY(180deg);\n        }\n        .flipped .card-inner {\n            transform: rotateY(180deg);\n        }\n    </style>\n</head>\n<body class=\"h-screen flex flex-col overflow-hidden\">\n\n    <!-- Navbar / Header -->\n    <header class=\"bg-emerald-600 text-white p-4 shadow-lg flex justify-between items-center z-10\">\n        <h1 class=\"text-3xl font-bold\"><i class=\"fas fa-chalkboard-teacher mr-3\"></i>6. Sınıf Akıllı Tahta Etkinlikleri</h1>\n        <button onclick=\"goHome()\" class=\"bg-emerald-800 hover:bg-emerald-900 text-white px-6 py-2 rounded-xl text-xl font-bold shadow transition\">\n            <i class=\"fas fa-home\"></i> Ana Menü\n        </button>\n    </header>\n\n    <!-- MAIN CONTENT AREA -->\n    <main id=\"game-container\" class=\"flex-grow relative flex items-center justify-center p-6\">\n        \n        <!-- MENU SCREEN -->\n        <div id=\"menu-screen\" class=\"w-full max-w-6xl grid grid-cols-1 md:grid-cols-3 gap-8\">\n            <div onclick=\"startGame('quiz')\" class=\"touch-btn cursor-pointer bg-white border-b-8 border-blue-500 rounded-3xl p-10 shadow-2xl flex flex-col items-center justify-center hover:bg-blue-50 h-96\">\n                <i class=\"fas fa-question-circle text-8xl text-blue-500 mb-6\"></i>\n                <h2 class=\"text-4xl font-bold text-gray-700\">Bilgi Yarışması</h2>\n                <p class=\"text-xl text-gray-500 mt-4\">Soruları bil, puanları topla!</p>\n            </div>\n\n            <div onclick=\"startGame('cards')\" class=\"touch-btn cursor-pointer bg-white border-b-8 border-orange-500 rounded-3xl p-10 shadow-2xl flex flex-col items-center justify-center hover:bg-orange-50 h-96\">\n                <i class=\"fas fa-layer-group text-8xl text-orange-500 mb-6\"></i>\n                <h2 class=\"text-4xl font-bold text-gray-700\">Kavram Kartları</h2>\n                <p class=\"text-xl text-gray-500 mt-4\">Ayet, Sure, Cüz ve Hizip öğren.</p>\n            </div>\n\n            <div onclick=\"startGame('peltek')\" class=\"touch-btn cursor-pointer bg-white border-b-8 border-purple-500 rounded-3xl p-10 shadow-2xl flex flex-col items-center justify-center hover:bg-purple-50 h-96\">\n                <span class=\"arabic text-8xl text-purple-500 mb-6\">ث ذ ظ</span>\n                <h2 class=\"text-4xl font-bold text-gray-700\">Peltek Harf Avı</h2>\n                <p class=\"text-xl text-gray-500 mt-4\">Doğru harfi bulabilir misin?</p>\n            </div>\n        </div>\n\n        <!-- 1. QUIZ GAME SCREEN -->\n        <div id=\"quiz-screen\" class=\"hidden w-full max-w-5xl h-full flex flex-col justify-center\">\n            <div class=\"bg-white rounded-3xl shadow-2xl border-4 border-emerald-200 p-8 h-full flex flex-col\">\n                <div class=\"flex justify-between text-2xl font-bold text-emerald-700 mb-6\">\n                    <span id=\"quiz-progress\">Soru 1/5</span>\n                    <span id=\"quiz-score\">Puan: 0</span>\n                </div>\n                \n                <div class=\"flex-grow flex items-center justify-center mb-8\">\n                    <h2 id=\"question-text\" class=\"text-4xl md:text-5xl font-bold text-center text-gray-800 leading-tight\">\n                        Soru yükleniyor...\n                    </h2>\n                </div>\n\n                <div id=\"options-container\" class=\"grid grid-cols-2 gap-6 h-64\">\n                    <!-- Options will be injected here -->\n                </div>\n            </div>\n        </div>\n\n        <!-- 2. FLASHCARDS SCREEN -->\n        <div id=\"cards-screen\" class=\"hidden w-full max-w-6xl h-full flex flex-col items-center justify-center\">\n            <h2 class=\"text-4xl font-bold text-emerald-800 mb-8\">Kartın Arkasında Ne Var? (Dokun ve Çevir)</h2>\n            <div class=\"grid grid-cols-2 gap-8 w-full h-3/4\">\n                \n                <!-- Card 1 -->\n                <div class=\"perspective cursor-pointer\" onclick=\"flipCard(this)\">\n                    <div class=\"card-inner w-full h-full bg-white rounded-3xl\">\n                        <div class=\"card-front bg-blue-100 border-4 border-blue-400\">\n                            <h3 class=\"text-5xl font-bold text-blue-700\">AYET</h3>\n                        </div>\n                        <div class=\"card-back bg-blue-600 text-white border-4 border-blue-800\">\n                            <p class=\"text-3xl font-bold px-4\">Kur'an-ı Kerim'in her bir cümlesidir.</p>\n                        </div>\n                    </div>\n                </div>\n\n                <!-- Card 2 -->\n                <div class=\"perspective cursor-pointer\" onclick=\"flipCard(this)\">\n                    <div class=\"card-inner w-full h-full bg-white rounded-3xl\">\n                        <div class=\"card-front bg-orange-100 border-4 border-orange-400\">\n                            <h3 class=\"text-5xl font-bold text-orange-700\">SURE</h3>\n                        </div>\n                        <div class=\"card-back bg-orange-600 text-white border-4 border-orange-800\">\n                            <p class=\"text-3xl font-bold px-4\">Ayetlerden oluşan, en az 3 ayetli bölümdür.</p>\n                        </div>\n                    </div>\n                </div>\n\n                <!-- Card 3 -->\n                <div class=\"perspective cursor-pointer\" onclick=\"flipCard(this)\">\n                    <div class=\"card-inner w-full h-full bg-white rounded-3xl\">\n                        <div class=\"card-front bg-purple-100 border-4 border-purple-400\">\n                            <h3 class=\"text-5xl font-bold text-purple-700\">CÜZ</h3>\n                        </div>\n                        <div class=\"card-back bg-purple-600 text-white border-4 border-purple-800\">\n                            <p class=\"text-3xl font-bold px-4\">20 Sayfadan oluşan her bir bölümdür.</p>\n                        </div>\n                    </div>\n                </div>\n\n                <!-- Card 4 -->\n                <div class=\"perspective cursor-pointer\" onclick=\"flipCard(this)\">\n                    <div class=\"card-inner w-full h-full bg-white rounded-3xl\">\n                        <div class=\"card-front bg-rose-100 border-4 border-rose-400\">\n                            <h3 class=\"text-5xl font-bold text-rose-700\">HİZİP</h3>\n                        </div>\n                        <div class=\"card-back bg-rose-600 text-white border-4 border-rose-800\">\n                            <p class=\"text-3xl font-bold px-4\">Her cüzün 5 sayfalık (1/4) bölümüdür.</p>\n                        </div>\n                    </div>\n                </div>\n\n            </div>\n        </div>\n\n        <!-- 3. PELTEK GAME SCREEN -->\n        <div id=\"peltek-screen\" class=\"hidden w-full max-w-5xl h-full flex flex-col items-center justify-center\">\n            <h2 class=\"text-4xl font-bold text-emerald-800 mb-4\">Hangisi Peltek Harf?</h2>\n            <p class=\"text-2xl text-gray-600 mb-10\">Aşağıdaki harflerden peltek olanına dokun!</p>\n            \n            <div id=\"peltek-container\" class=\"flex justify-center gap-10\">\n                <!-- Letters injected here -->\n            </div>\n            \n            <div id=\"peltek-feedback\" class=\"mt-10 h-20 text-4xl font-bold text-center\"></div>\n            <button onclick=\"nextPeltekLevel()\" class=\"mt-6 bg-emerald-500 text-white px-8 py-4 rounded-xl text-2xl font-bold hidden\" id=\"next-peltek-btn\">Sıradaki <i class=\"fas fa-arrow-right\"></i></button>\n        </div>\n\n        <!-- RESULT SCREEN (Shared) -->\n        <div id=\"result-screen\" class=\"hidden w-full flex flex-col items-center justify-center text-center animate-bounce\">\n            <i class=\"fas fa-trophy text-9xl text-yellow-400 mb-6\"></i>\n            <h2 class=\"text-6xl font-bold text-gray-800 mb-4\">Tebrikler!</h2>\n            <p id=\"final-message\" class=\"text-3xl text-gray-600 mb-8\">Etkinliği tamamladınız.</p>\n            <button onclick=\"goHome()\" class=\"bg-emerald-600 text-white px-10 py-5 rounded-full text-3xl font-bold shadow-lg hover:bg-emerald-700 transition\">\n                Tekrar Oyna\n            </button>\n        </div>\n\n    </main>\n\n    <script>\n        // --- DATA ---\n        const quizData = [\n            {\n                q: \"Kur'an-ı Kerim'in her 20 sayfalık bölümüne ne ad verilir?\",\n                options: [\"Sure\", \"Ayet\", \"Cüz\", \"Hizip\"],\n                correct: 2 // Index of correct answer\n            },\n            {\n                q: \"Aşağıdakilerden hangisi bir 'Peltek' harf DEĞİLDİR?\",\n                options: [\"ث (Se)\", \"ذ (Zel)\", \"ظ (Za)\", \"ب (Be)\"],\n                correct: 3\n            },\n            {\n                q: \"Salli ve Barik duaları namazın neresinde okunur?\",\n                options: [\"İlk oturuşta\", \"Rükuda\", \"Son oturuşta\", \"Secdede\"],\n                correct: 2\n            },\n            {\n                q: \"Bir cüz kaç hizipten oluşur?\",\n                options: [\"2 Hizip\", \"4 Hizip\", \"5 Hizip\", \"10 Hizip\"],\n                correct: 1\n            },\n            {\n                q: \"Kur'an-ı Kerim'deki sure sayısı kaçtır?\",\n                options: [\"114\", \"99\", \"40\", \"30\"],\n                correct: 0\n            }\n        ];\n\n        const peltekLevels = [\n            { letters: [\"ب\", \"ث\", \"ج\"], correct: 1 },\n            { letters: [\"س\", \"د\", \"ذ\"], correct: 2 },\n            { letters: [\"ظ\", \"ط\", \"ع\"], correct: 0 },\n            { letters: [\"ر\", \"ز\", \"ذ\"], correct: 2 },\n            { letters: [\"ث\", \"ش\", \"ص\"], correct: 0 }\n        ];\n\n        // --- STATE ---\n        let currentQuizIndex = 0;\n        let score = 0;\n        let currentPeltekIndex = 0;\n\n        // --- NAVIGATION FUNCTIONS ---\n        function hideAllScreens() {\n            document.getElementById('menu-screen').classList.add('hidden');\n            document.getElementById('quiz-screen').classList.add('hidden');\n            document.getElementById('cards-screen').classList.add('hidden');\n            document.getElementById('peltek-screen').classList.add('hidden');\n            document.getElementById('result-screen').classList.add('hidden');\n        }\n\n        function goHome() {\n            hideAllScreens();\n            document.getElementById('menu-screen').classList.remove('hidden');\n            // Reset states if needed\n            resetCardFlips();\n        }\n\n        function startGame(gameType) {\n            hideAllScreens();\n            if (gameType === 'quiz') {\n                currentQuizIndex = 0;\n                score = 0;\n                document.getElementById('quiz-screen').classList.remove('hidden');\n                loadQuestion();\n            } else if (gameType === 'cards') {\n                document.getElementById('cards-screen').classList.remove('hidden');\n            } else if (gameType === 'peltek') {\n                currentPeltekIndex = 0;\n                document.getElementById('peltek-screen').classList.remove('hidden');\n                loadPeltekLevel();\n            }\n        }\n\n        function showResult(message) {\n            hideAllScreens();\n            document.getElementById('result-screen').classList.remove('hidden');\n            document.getElementById('final-message').innerText = message;\n        }\n\n        // --- QUIZ LOGIC ---\n        function loadQuestion() {\n            const qData = quizData[currentQuizIndex];\n            document.getElementById('question-text').innerText = qData.q;\n            document.getElementById('quiz-progress').innerText = `Soru ${currentQuizIndex + 1}/${quizData.length}`;\n            document.getElementById('quiz-score').innerText = `Puan: ${score}`;\n\n            const optionsContainer = document.getElementById('options-container');\n            optionsContainer.innerHTML = '';\n\n            qData.options.forEach((opt, index) => {\n                const btn = document.createElement('button');\n                btn.className = \"bg-emerald-100 border-b-4 border-emerald-400 text-gray-800 text-3xl font-bold rounded-xl hover:bg-emerald-200 transition p-4 touch-btn\";\n                btn.innerText = opt;\n                btn.onclick = () => checkAnswer(index, btn);\n                optionsContainer.appendChild(btn);\n            });\n        }\n\n        function checkAnswer(selectedIndex, btnElement) {\n            // Disable all buttons\n            const buttons = document.querySelectorAll('#options-container button');\n            buttons.forEach(b => b.disabled = true);\n\n            const correctIndex = quizData[currentQuizIndex].correct;\n\n            if (selectedIndex === correctIndex) {\n                btnElement.classList.remove('bg-emerald-100', 'border-emerald-400');\n                btnElement.classList.add('bg-green-500', 'border-green-700', 'text-white');\n                score += 20;\n                playSound(true);\n            } else {\n                btnElement.classList.remove('bg-emerald-100', 'border-emerald-400');\n                btnElement.classList.add('bg-red-500', 'border-red-700', 'text-white');\n                // Highlight correct one\n                buttons[correctIndex].classList.add('bg-green-500', 'text-white');\n                playSound(false);\n            }\n\n            document.getElementById('quiz-score').innerText = `Puan: ${score}`;\n\n            setTimeout(() => {\n                currentQuizIndex++;\n                if (currentQuizIndex < quizData.length) {\n                    loadQuestion();\n                } else {\n                    showResult(`Toplam Puanın: ${score}`);\n                }\n            }, 1500);\n        }\n\n        // --- FLASHCARD LOGIC ---\n        function flipCard(cardElement) {\n            cardElement.classList.toggle('flipped');\n        }\n        \n        function resetCardFlips() {\n            document.querySelectorAll('.perspective').forEach(card => card.classList.remove('flipped'));\n        }\n\n        // --- PELTEK GAME LOGIC ---\n        function loadPeltekLevel() {\n            const level = peltekLevels[currentPeltekIndex];\n            const container = document.getElementById('peltek-container');\n            const feedback = document.getElementById('peltek-feedback');\n            const nextBtn = document.getElementById('next-peltek-btn');\n\n            container.innerHTML = '';\n            feedback.innerText = '';\n            nextBtn.classList.add('hidden');\n\n            level.letters.forEach((letter, index) => {\n                const div = document.createElement('div');\n                div.className = \"w-48 h-48 bg-white border-4 border-gray-300 rounded-full flex items-center justify-center cursor-pointer shadow-lg hover:bg-gray-50 touch-btn\";\n                div.innerHTML = `<span class=\"arabic text-8xl\">${letter}</span>`;\n                div.onclick = () => checkPeltek(index, div);\n                container.appendChild(div);\n            });\n        }\n\n        function checkPeltek(selectedIndex, divElement) {\n            const correctIndex = peltekLevels[currentPeltekIndex].correct;\n            const feedback = document.getElementById('peltek-feedback');\n            \n            // Disable clicks\n            const allDivs = document.getElementById('peltek-container').children;\n            for(let d of allDivs) d.style.pointerEvents = 'none';\n\n            if (selectedIndex === correctIndex) {\n                divElement.classList.add('bg-green-100', 'border-green-500');\n                divElement.querySelector('span').classList.add('text-green-600');\n                feedback.innerHTML = '<span class=\"text-green-600\"><i class=\"fas fa-check\"></i> Harika! Bu harf Peltek.</span>';\n                playSound(true);\n            } else {\n                divElement.classList.add('bg-red-100', 'border-red-500');\n                divElement.querySelector('span').classList.add('text-red-600');\n                \n                // Show correct one\n                const correctDiv = allDivs[correctIndex];\n                correctDiv.classList.add('bg-green-100', 'border-green-500');\n                \n                feedback.innerHTML = '<span class=\"text-red-600\"><i class=\"fas fa-times\"></i> Yanlış. Yeşil olan Peltek.</span>';\n                playSound(false);\n            }\n\n            document.getElementById('next-peltek-btn').classList.remove('hidden');\n        }\n\n        function nextPeltekLevel() {\n            currentPeltekIndex++;\n            if (currentPeltekIndex < peltekLevels.length) {\n                loadPeltekLevel();\n            } else {\n                showResult(\"Tüm Peltek harfleri buldun!\");\n            }\n        }\n\n        // --- UTILS ---\n        function playSound(isCorrect) {\n            // Simple visual feedback instead of audio to avoid autoplay issues\n            const body = document.body;\n            if(isCorrect) {\n                body.style.backgroundColor = \"#d1fae5\"; // Greenish\n            } else {\n                body.style.backgroundColor = \"#fee2e2\"; // Reddish\n            }\n            setTimeout(() => {\n                body.style.backgroundColor = \"#ecfdf5\"; // Reset\n            }, 300);\n        }\n\n    </script>\n</body>\n</html>"
  },
