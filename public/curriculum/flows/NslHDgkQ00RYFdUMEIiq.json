    "htmlContent": "<!DOCTYPE html>\n<html lang=\"tr\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>2. Ünite Akıllı Tahta Etkinlikleri</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <link href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css\" rel=\"stylesheet\">\n    <link href=\"https://fonts.googleapis.com/css2?family=Fredoka:wght@400;600&family=Amiri:wght@700&display=swap\" rel=\"stylesheet\">\n    <style>\n        body {\n            font-family: 'Fredoka', sans-serif;\n            background-color: #f0fdf4; /* Green-50 */\n            user-select: none;\n        }\n        .arabic { font-family: 'Amiri', serif; }\n        .touch-btn:active { transform: scale(0.95); }\n        /* Card Flip Styles */\n        .perspective { perspective: 1000px; }\n        .card-inner {\n            position: relative;\n            width: 100%;\n            height: 100%;\n            text-align: center;\n            transition: transform 0.6s;\n            transform-style: preserve-3d;\n        }\n        .card-front, .card-back {\n            position: absolute;\n            width: 100%;\n            height: 100%;\n            backface-visibility: hidden;\n            border-radius: 1rem;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);\n        }\n        .card-back { transform: rotateY(180deg); }\n        .flipped .card-inner { transform: rotateY(180deg); }\n    </style>\n</head>\n<body class=\"h-screen flex flex-col overflow-hidden\">\n\n    <!-- Navbar -->\n    <header class=\"bg-green-600 text-white p-4 shadow-lg flex justify-between items-center z-10\">\n        <h1 class=\"text-3xl font-bold\"><i class=\"fas fa-chalkboard mr-3\"></i>Tecvit ve Sureler</h1>\n        <button onclick=\"goHome()\" class=\"bg-green-800 hover:bg-green-900 px-6 py-2 rounded-xl text-xl font-bold transition shadow-md\">\n            <i class=\"fas fa-home\"></i> Ana Menü\n        </button>\n    </header>\n\n    <main class=\"flex-grow relative flex items-center justify-center p-6\">\n        \n        <!-- MENU SCREEN -->\n        <div id=\"menu-screen\" class=\"w-full max-w-6xl grid grid-cols-1 md:grid-cols-3 gap-8\">\n            <!-- Game 1: Tecvit Detective -->\n            <div onclick=\"startGame('detective')\" class=\"touch-btn cursor-pointer bg-white border-b-8 border-purple-500 rounded-3xl p-8 shadow-2xl flex flex-col items-center justify-center hover:bg-purple-50 h-80 transition transform hover:-translate-y-2\">\n                <i class=\"fas fa-search text-7xl text-purple-500 mb-4\"></i>\n                <h2 class=\"text-3xl font-bold text-gray-700\">Tecvit Dedektifi</h2>\n                <p class=\"text-lg text-gray-500 mt-2 text-center\">İzhar mı, İklap mı, İhfa mı?</p>\n            </div>\n            <!-- Game 2: Surah Match -->\n            <div onclick=\"startGame('surah')\" class=\"touch-btn cursor-pointer bg-white border-b-8 border-orange-500 rounded-3xl p-8 shadow-2xl flex flex-col items-center justify-center hover:bg-orange-50 h-80 transition transform hover:-translate-y-2\">\n                <i class=\"fas fa-book-open text-7xl text-orange-500 mb-4\"></i>\n                <h2 class=\"text-3xl font-bold text-gray-700\">Sureleri Tanı</h2>\n                <p class=\"text-lg text-gray-500 mt-2 text-center\">Mesajlar hangi sureye ait?</p>\n            </div>\n            <!-- Game 3: Med Race -->\n            <div onclick=\"startGame('med')\" class=\"touch-btn cursor-pointer bg-white border-b-8 border-blue-500 rounded-3xl p-8 shadow-2xl flex flex-col items-center justify-center hover:bg-blue-50 h-80 transition transform hover:-translate-y-2\">\n                <i class=\"fas fa-wave-square text-7xl text-blue-500 mb-4\"></i>\n                <h2 class=\"text-3xl font-bold text-gray-700\">Med Ustası</h2>\n                <p class=\"text-lg text-gray-500 mt-2 text-center\">Arız, Lazım ve Lin'i Bul.</p>\n            </div>\n        </div>\n\n        <!-- GAME 1: TECVİT DEDEKTİFİ SCREEN -->\n        <div id=\"detective-screen\" class=\"hidden w-full max-w-4xl h-full flex flex-col justify-center\">\n            <div class=\"bg-white rounded-3xl shadow-xl border-4 border-purple-200 p-8 h-full flex flex-col\">\n                <div class=\"flex justify-between text-2xl font-bold text-purple-800 mb-6\">\n                    <span id=\"d-progress\">Soru 1/5</span>\n                    <span id=\"d-score\">Puan: 0</span>\n                </div>\n                \n                <div class=\"flex-grow flex flex-col items-center justify-center mb-8 bg-purple-50 rounded-2xl p-6\">\n                    <p class=\"text-gray-500 mb-4 text-xl\">Bu kelimede hangi kural var?</p>\n                    <h2 id=\"d-question\" class=\"arabic text-7xl md:text-8xl font-bold text-gray-800 mb-4 leading-normal\"></h2>\n                </div>\n\n                <div class=\"grid grid-cols-3 gap-6 h-32\">\n                    <button onclick=\"checkDetective('İhfa')\" class=\"d-opt bg-yellow-100 hover:bg-yellow-200 text-yellow-800 text-3xl font-bold rounded-2xl border-b-8 border-yellow-300 touch-btn\">İhfa</button>\n                    <button onclick=\"checkDetective('İzhar')\" class=\"d-opt bg-red-100 hover:bg-red-200 text-red-800 text-3xl font-bold rounded-2xl border-b-8 border-red-300 touch-btn\">İzhar</button>\n                    <button onclick=\"checkDetective('İklap')\" class=\"d-opt bg-indigo-100 hover:bg-indigo-200 text-indigo-800 text-3xl font-bold rounded-2xl border-b-8 border-indigo-300 touch-btn\">İklap</button>\n                </div>\n                <div id=\"d-feedback\" class=\"h-12 text-center text-3xl font-bold mt-4\"></div>\n            </div>\n        </div>\n\n        <!-- GAME 2: SURE MATCH SCREEN -->\n        <div id=\"surah-screen\" class=\"hidden w-full max-w-5xl h-full flex flex-col justify-center\">\n             <div class=\"bg-white rounded-3xl shadow-xl border-4 border-orange-200 p-8 h-full flex flex-col items-center\">\n                <h2 class=\"text-3xl font-bold text-orange-700 mb-6\">Bu özellik hangi sureye ait?</h2>\n                \n                <div class=\"flex-grow flex items-center justify-center w-full bg-orange-50 rounded-2xl p-8 mb-8 border-2 border-dashed border-orange-300\">\n                    <p id=\"s-statement\" class=\"text-4xl font-bold text-gray-800 text-center leading-relaxed\"></p>\n                </div>\n\n                <div class=\"grid grid-cols-2 gap-6 w-full h-40\">\n                    <button id=\"s-btn-1\" onclick=\"checkSurah(this)\" class=\"bg-white hover:bg-orange-100 text-gray-700 text-3xl font-bold rounded-2xl border-4 border-orange-300 shadow-md touch-btn transition\"></button>\n                    <button id=\"s-btn-2\" onclick=\"checkSurah(this)\" class=\"bg-white hover:bg-orange-100 text-gray-700 text-3xl font-bold rounded-2xl border-4 border-orange-300 shadow-md touch-btn transition\"></button>\n                    <button id=\"s-btn-3\" onclick=\"checkSurah(this)\" class=\"bg-white hover:bg-orange-100 text-gray-700 text-3xl font-bold rounded-2xl border-4 border-orange-300 shadow-md touch-btn transition\"></button>\n                    <button id=\"s-btn-4\" onclick=\"checkSurah(this)\" class=\"bg-white hover:bg-orange-100 text-gray-700 text-3xl font-bold rounded-2xl border-4 border-orange-300 shadow-md touch-btn transition\"></button>\n                </div>\n             </div>\n        </div>\n\n        <!-- GAME 3: MED USTASI SCREEN -->\n        <div id=\"med-screen\" class=\"hidden w-full max-w-4xl h-full flex flex-col justify-center\">\n            <div class=\"bg-white rounded-3xl shadow-xl border-4 border-blue-200 p-8 h-full flex flex-col\">\n                <div class=\"flex justify-between text-2xl font-bold text-blue-800 mb-6\">\n                    <span id=\"m-progress\">Soru 1/5</span>\n                    <span id=\"m-score\">Puan: 0</span>\n                </div>\n                \n                <div class=\"flex-grow flex flex-col items-center justify-center mb-8 bg-blue-50 rounded-2xl p-6\">\n                    <h2 id=\"m-question\" class=\"arabic text-7xl md:text-8xl font-bold text-gray-800 mb-4 leading-normal\"></h2>\n                    <p class=\"text-gray-500 text-lg\">(Durunca hangi med olur?)</p>\n                </div>\n\n                <div class=\"grid grid-cols-3 gap-6 h-32\">\n                    <button onclick=\"checkMed('Meddiarız')\" class=\"bg-blue-100 hover:bg-blue-200 text-blue-800 text-2xl font-bold rounded-2xl border-b-8 border-blue-300 touch-btn\">Meddiarız</button>\n                    <button onclick=\"checkMed('Meddilazım')\" class=\"bg-purple-100 hover:bg-purple-200 text-purple-800 text-2xl font-bold rounded-2xl border-b-8 border-purple-300 touch-btn\">Meddilazım</button>\n                    <button onclick=\"checkMed('Meddilin')\" class=\"bg-green-100 hover:bg-green-200 text-green-800 text-2xl font-bold rounded-2xl border-b-8 border-green-300 touch-btn\">Meddilin</button>\n                </div>\n                <div id=\"m-feedback\" class=\"h-12 text-center text-3xl font-bold mt-4\"></div>\n            </div>\n        </div>\n\n        <!-- RESULT SCREEN -->\n        <div id=\"result-screen\" class=\"hidden w-full flex flex-col items-center justify-center animate-bounce\">\n            <i class=\"fas fa-trophy text-9xl text-yellow-400 mb-6 drop-shadow-lg\"></i>\n            <h2 class=\"text-7xl font-bold text-gray-800 mb-4\">Tebrikler!</h2>\n            <p id=\"final-msg\" class=\"text-4xl text-gray-600 mb-10\">Etkinliği tamamladın.</p>\n            <button onclick=\"goHome()\" class=\"bg-green-600 text-white px-12 py-6 rounded-full text-3xl font-bold shadow-xl hover:bg-green-700 transition\">Ana Menüye Dön</button>\n        </div>\n\n    </main>\n\n    <script>\n        // --- DATA ---\n        // Tecvit Dedektifi Data\n        const detectiveData = [\n            { q: \"سَمِيعٌ بَصِيرٌ\", a: \"İklap\" }, // Nun -> Mim (Ba harfi)\n            { q: \"مَنْ آمَنَ\", a: \"İzhar\" }, // Elif (Boğaz harfi)\n            { q: \"مِنْ شَرِّ\", a: \"İhfa\" }, // Şın harfi\n            { q: \"مِنْ خَوْفٍ\", a: \"İzhar\" }, // Hı harfi\n            { q: \"أَنْتُمْ\", a: \"İhfa\" }, // Te harfi\n            { q: \"مِنْ بَعْدِ\", a: \"İklap\" } // Ba harfi\n        ];\n\n        // Surah Match Data\n        const surahData = [\n            { q: \"Ebrehe ve ordusunun Kabe'yi yıkmaya çalışmasını anlatır.\", correct: \"Fil Suresi\", options: [\"Fil Suresi\", \"Kureyş Suresi\", \"Maun Suresi\", \"Kafirun Suresi\"] },\n            { q: \"Yetimi itip kakan, yoksulu doyurmayanlardan bahseder.\", correct: \"Maun Suresi\", options: [\"Fil Suresi\", \"Kureyş Suresi\", \"Maun Suresi\", \"Kafirun Suresi\"] },\n            { q: \"'Sizin dininiz size, benim dinim banadır' mesajını verir.\", correct: \"Kafirun Suresi\", options: [\"Kafirun Suresi\", \"Fil Suresi\", \"Maun Suresi\", \"Kureyş Suresi\"] },\n            { q: \"Kureyş kabilesine verilen güven ve ticaret nimetlerini hatırlatır.\", correct: \"Kureyş Suresi\", options: [\"Kureyş Suresi\", \"Fil Suresi\", \"Maun Suresi\", \"Kafirun Suresi\"] },\n            { q: \"Ebabil kuşlarının attığı taşlardan bahseder.\", correct: \"Fil Suresi\", options: [\"Fil Suresi\", \"Maun Suresi\", \"Kureyş Suresi\", \"Kafirun Suresi\"] }\n        ];\n\n        // Med Ustası Data\n        const medData = [\n            { q: \"يَعْلَمُونَ\", a: \"Meddiarız\" }, // Durunca\n            { q: \"دَٓابَّةٍ\", a: \"Meddilazım\" }, // Şedde var\n            { q: \"قُرَيْشٍ\", a: \"Meddilin\" }, // Lin harfi (Ya) + Sükun\n            { q: \"الْحَٓاقَّةُ\", a: \"Meddilazım\" }, // Şedde var\n            { q: \"خَوْفٍ\", a: \"Meddilin\" }, // Lin harfi (Vav) + Sükun\n            { q: \"نَسْتَعِينُ\", a: \"Meddiarız\" } // Durunca\n        ];\n\n        // --- STATE ---\n        let currentIdx = 0;\n        let score = 0;\n        let activeGame = \"\";\n\n        // --- FUNCTIONS ---\n        function hideAll() {\n            document.getElementById('menu-screen').classList.add('hidden');\n            document.getElementById('detective-screen').classList.add('hidden');\n            document.getElementById('surah-screen').classList.add('hidden');\n            document.getElementById('med-screen').classList.add('hidden');\n            document.getElementById('result-screen').classList.add('hidden');\n        }\n\n        function goHome() {\n            hideAll();\n            document.getElementById('menu-screen').classList.remove('hidden');\n        }\n\n        function startGame(game) {\n            hideAll();\n            activeGame = game;\n            currentIdx = 0;\n            score = 0;\n\n            if (game === 'detective') {\n                document.getElementById('detective-screen').classList.remove('hidden');\n                loadDetective();\n            } else if (game === 'surah') {\n                document.getElementById('surah-screen').classList.remove('hidden');\n                loadSurah();\n            } else if (game === 'med') {\n                document.getElementById('med-screen').classList.remove('hidden');\n                loadMed();\n            }\n        }\n\n        // --- DETECTIVE GAME LOGIC ---\n        function loadDetective() {\n            const data = detectiveData[currentIdx];\n            document.getElementById('d-question').innerText = data.q;\n            document.getElementById('d-progress').innerText = `Soru ${currentIdx + 1}/${detectiveData.length}`;\n            document.getElementById('d-score').innerText = `Puan: ${score}`;\n            document.getElementById('d-feedback').innerText = \"\";\n            document.querySelectorAll('.d-opt').forEach(b => b.disabled = false);\n        }\n\n        function checkDetective(answer) {\n            const correct = detectiveData[currentIdx].a;\n            const fb = document.getElementById('d-feedback');\n            document.querySelectorAll('.d-opt').forEach(b => b.disabled = true);\n\n            if (answer === correct) {\n                fb.innerText = \"Doğru!\";\n                fb.className = \"h-12 text-center text-3xl font-bold mt-4 text-green-600\";\n                score += 10;\n            } else {\n                fb.innerText = `Yanlış. Cevap: ${correct}`;\n                fb.className = \"h-12 text-center text-3xl font-bold mt-4 text-red-600\";\n            }\n            \n            document.getElementById('d-score').innerText = `Puan: ${score}`;\n\n            setTimeout(() => {\n                currentIdx++;\n                if (currentIdx < detectiveData.length) {\n                    loadDetective();\n                } else {\n                    showResult(score);\n                }\n            }, 1500);\n        }\n\n        // --- SURAH GAME LOGIC ---\n        function loadSurah() {\n            const data = surahData[currentIdx];\n            document.getElementById('s-statement').innerText = data.q;\n            \n            // Shuffle options\n            let opts = [...data.options];\n            opts.sort(() => Math.random() - 0.5);\n\n            for(let i=0; i<4; i++) {\n                let btn = document.getElementById(`s-btn-${i+1}`);\n                btn.innerText = opts[i];\n                btn.classList.remove('bg-green-500', 'bg-red-500', 'text-white');\n                btn.classList.add('bg-white', 'text-gray-700');\n                btn.disabled = false;\n            }\n        }\n\n        function checkSurah(btn) {\n            const correct = surahData[currentIdx].correct;\n            // Disable all\n            for(let i=1; i<=4; i++) document.getElementById(`s-btn-${i}`).disabled = true;\n\n            if (btn.innerText === correct) {\n                btn.classList.remove('bg-white', 'text-gray-700');\n                btn.classList.add('bg-green-500', 'text-white');\n                score += 10;\n            } else {\n                btn.classList.remove('bg-white', 'text-gray-700');\n                btn.classList.add('bg-red-500', 'text-white');\n            }\n\n            setTimeout(() => {\n                currentIdx++;\n                if (currentIdx < surahData.length) {\n                    loadSurah();\n                } else {\n                    showResult(score);\n                }\n            }, 1000);\n        }\n\n        // --- MED GAME LOGIC ---\n        function loadMed() {\n            const data = medData[currentIdx];\n            document.getElementById('m-question').innerText = data.q;\n            document.getElementById('m-progress').innerText = `Soru ${currentIdx + 1}/${medData.length}`;\n            document.getElementById('m-score').innerText = `Puan: ${score}`;\n            document.getElementById('m-feedback').innerText = \"\";\n        }\n\n        function checkMed(answer) {\n            const correct = medData[currentIdx].a;\n            const fb = document.getElementById('m-feedback');\n\n            if (answer === correct) {\n                fb.innerText = \"Doğru!\";\n                fb.className = \"h-12 text-center text-3xl font-bold mt-4 text-green-600\";\n                score += 10;\n            } else {\n                fb.innerText = `Yanlış. Cevap: ${correct}`;\n                fb.className = \"h-12 text-center text-3xl font-bold mt-4 text-red-600\";\n            }\n            \n            document.getElementById('m-score').innerText = `Puan: ${score}`;\n\n            setTimeout(() => {\n                currentIdx++;\n                if (currentIdx < medData.length) {\n                    loadMed();\n                } else {\n                    showResult(score);\n                }\n            }, 1500);\n        }\n\n        // --- RESULT ---\n        function showResult(finalScore) {\n            hideAll();\n            document.getElementById('result-screen').classList.remove('hidden');\n            document.getElementById('final-msg').innerText = `Toplam Puanın: ${finalScore}`;\n        }\n\n    </script>\n</body>\n</html>",
