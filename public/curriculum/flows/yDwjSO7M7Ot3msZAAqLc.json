    "htmlContent": "<!DOCTYPE html>\n<html lang=\"tr\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Akıllı Tahta Etkinlikleri - 2. Tema</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <link href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css\" rel=\"stylesheet\">\n    <link href=\"https://fonts.googleapis.com/css2?family=Fredoka:wght@400;600&family=Amiri:wght@700&display=swap\" rel=\"stylesheet\">\n    <style>\n        body {\n            font-family: 'Fredoka', sans-serif;\n            background-color: #f0f9ff;\n            user-select: none;\n        }\n        .arabic {\n            font-family: 'Amiri', serif;\n        }\n        .touch-btn:active {\n            transform: scale(0.95);\n        }\n        /* Card Flip Styles */\n        .perspective { perspective: 1000px; }\n        .card-inner {\n            position: relative;\n            width: 100%;\n            height: 100%;\n            text-align: center;\n            transition: transform 0.6s;\n            transform-style: preserve-3d;\n        }\n        .card-front, .card-back {\n            position: absolute;\n            width: 100%;\n            height: 100%;\n            backface-visibility: hidden;\n            border-radius: 1rem;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n        }\n        .card-back { transform: rotateY(180deg); }\n        .flipped .card-inner { transform: rotateY(180deg); }\n    </style>\n</head>\n<body class=\"h-screen flex flex-col overflow-hidden\">\n\n    <!-- Navbar -->\n    <header class=\"bg-indigo-600 text-white p-4 shadow-lg flex justify-between items-center z-10\">\n        <h1 class=\"text-3xl font-bold\"><i class=\"fas fa-chalkboard mr-3\"></i>2. Tema Akıllı Tahta Etkinlikleri</h1>\n        <button onclick=\"goHome()\" class=\"bg-indigo-800 hover:bg-indigo-900 px-6 py-2 rounded-xl text-xl font-bold transition\">\n            <i class=\"fas fa-home\"></i> Ana Menü\n        </button>\n    </header>\n\n    <main class=\"flex-grow relative flex items-center justify-center p-6\">\n        \n        <!-- MENU SCREEN -->\n        <div id=\"menu-screen\" class=\"w-full max-w-6xl grid grid-cols-1 md:grid-cols-3 gap-8\">\n            <!-- Game 1 -->\n            <div onclick=\"startGame('detective')\" class=\"touch-btn cursor-pointer bg-white border-b-8 border-blue-500 rounded-3xl p-8 shadow-2xl flex flex-col items-center justify-center hover:bg-blue-50 h-80\">\n                <i class=\"fas fa-search text-7xl text-blue-500 mb-4\"></i>\n                <h2 class=\"text-3xl font-bold text-gray-700\">Med Dedektifi</h2>\n                <p class=\"text-lg text-gray-500 mt-2 text-center\">Ayetlerdeki Med kuralını bul!</p>\n            </div>\n            <!-- Game 2 -->\n            <div onclick=\"startGame('yunus')\" class=\"touch-btn cursor-pointer bg-white border-b-8 border-teal-500 rounded-3xl p-8 shadow-2xl flex flex-col items-center justify-center hover:bg-teal-50 h-80\">\n                <i class=\"fas fa-ship text-7xl text-teal-500 mb-4\"></i>\n                <h2 class=\"text-3xl font-bold text-gray-700\">Hz. Yunus Hikayesi</h2>\n                <p class=\"text-lg text-gray-500 mt-2 text-center\">Doğru mu Yanlış mı?</p>\n            </div>\n            <!-- Game 3 -->\n            <div onclick=\"startGame('cards')\" class=\"touch-btn cursor-pointer bg-white border-b-8 border-orange-500 rounded-3xl p-8 shadow-2xl flex flex-col items-center justify-center hover:bg-orange-50 h-80\">\n                <i class=\"fas fa-layer-group text-7xl text-orange-500 mb-4\"></i>\n                <h2 class=\"text-3xl font-bold text-gray-700\">Kavram Kartları</h2>\n                <p class=\"text-lg text-gray-500 mt-2 text-center\">Med, Lin, Arız nedir?</p>\n            </div>\n        </div>\n\n        <!-- GAME 1: MED DEDEKTİFİ -->\n        <div id=\"detective-screen\" class=\"hidden w-full max-w-4xl h-full flex flex-col justify-center\">\n            <div class=\"bg-white rounded-3xl shadow-xl border-4 border-blue-200 p-8 h-full flex flex-col\">\n                <div class=\"flex justify-between text-2xl font-bold text-blue-800 mb-4\">\n                    <span id=\"detective-progress\">Soru 1/5</span>\n                    <span id=\"detective-score\">Puan: 0</span>\n                </div>\n                \n                <div class=\"flex-grow flex flex-col items-center justify-center mb-8 bg-blue-50 rounded-2xl p-6\">\n                    <p class=\"text-gray-500 text-xl mb-4\">Bu kelimede hangi kural var?</p>\n                    <h2 id=\"arabic-word\" class=\"arabic text-7xl md:text-8xl font-bold text-gray-800 mb-2\"></h2>\n                    <p id=\"latin-word\" class=\"text-gray-400 text-xl italic\"></p>\n                </div>\n\n                <div class=\"grid grid-cols-3 gap-4 h-32\">\n                    <button onclick=\"checkDetective(0)\" class=\"detective-opt bg-red-100 hover:bg-red-200 text-red-700 text-2xl font-bold rounded-xl border-b-4 border-red-300\">Meddiarız</button>\n                    <button onclick=\"checkDetective(1)\" class=\"detective-opt bg-purple-100 hover:bg-purple-200 text-purple-700 text-2xl font-bold rounded-xl border-b-4 border-purple-300\">Meddilazım</button>\n                    <button onclick=\"checkDetective(2)\" class=\"detective-opt bg-green-100 hover:bg-green-200 text-green-700 text-2xl font-bold rounded-xl border-b-4 border-green-300\">Meddilin</button>\n                </div>\n                <div id=\"feedback-msg\" class=\"h-10 text-center text-2xl font-bold mt-4\"></div>\n            </div>\n        </div>\n\n        <!-- GAME 2: HZ. YUNUS QUIZ (True/False) -->\n        <div id=\"yunus-screen\" class=\"hidden w-full max-w-4xl h-full flex flex-col justify-center\">\n             <div class=\"bg-white rounded-3xl shadow-xl border-4 border-teal-200 p-8 h-full flex flex-col items-center text-center\">\n                <h2 class=\"text-3xl font-bold text-teal-700 mb-8\">Doğru mu Yanlış mı?</h2>\n                <div class=\"flex-grow flex items-center justify-center\">\n                    <p id=\"yunus-question\" class=\"text-4xl font-bold text-gray-700 leading-relaxed\"></p>\n                </div>\n                <div class=\"flex gap-8 w-full mt-8\">\n                    <button onclick=\"checkYunus(true)\" class=\"flex-1 bg-green-500 hover:bg-green-600 text-white text-3xl font-bold py-6 rounded-2xl shadow-lg transform transition active:scale-95\"><i class=\"fas fa-check mr-2\"></i> DOĞRU</button>\n                    <button onclick=\"checkYunus(false)\" class=\"flex-1 bg-red-500 hover:bg-red-600 text-white text-3xl font-bold py-6 rounded-2xl shadow-lg transform transition active:scale-95\"><i class=\"fas fa-times mr-2\"></i> YANLIŞ</button>\n                </div>\n             </div>\n        </div>\n\n        <!-- GAME 3: FLASHCARDS -->\n        <div id=\"cards-screen\" class=\"hidden w-full max-w-6xl h-full flex flex-col items-center justify-center\">\n            <h2 class=\"text-3xl font-bold text-orange-700 mb-6\">Kartın Arkasını Çevir</h2>\n            <div class=\"grid grid-cols-2 md:grid-cols-3 gap-6 w-full h-3/4\">\n                \n                <!-- Card 1 -->\n                <div class=\"perspective cursor-pointer\" onclick=\"flipCard(this)\">\n                    <div class=\"card-inner w-full h-full bg-white rounded-2xl shadow-lg\">\n                        <div class=\"card-front bg-orange-100 border-2 border-orange-300\">\n                            <h3 class=\"text-3xl font-bold text-orange-800\">Sükunu Arız</h3>\n                        </div>\n                        <div class=\"card-back bg-orange-600 text-white\">\n                            <p class=\"text-xl font-bold px-4\">Durunca ortaya çıkan, geçince kaybolan sükun.</p>\n                        </div>\n                    </div>\n                </div>\n\n                 <!-- Card 2 -->\n                <div class=\"perspective cursor-pointer\" onclick=\"flipCard(this)\">\n                    <div class=\"card-inner w-full h-full bg-white rounded-2xl shadow-lg\">\n                        <div class=\"card-front bg-blue-100 border-2 border-blue-300\">\n                            <h3 class=\"text-3xl font-bold text-blue-800\">Harf-i Lin</h3>\n                        </div>\n                        <div class=\"card-back bg-blue-600 text-white\">\n                            <p class=\"text-xl font-bold px-4\">Cezimli Vav veya Ya. Öncesi Üstün olmalı.</p>\n                        </div>\n                    </div>\n                </div>\n\n                 <!-- Card 3 -->\n                <div class=\"perspective cursor-pointer\" onclick=\"flipCard(this)\">\n                    <div class=\"card-inner w-full h-full bg-white rounded-2xl shadow-lg\">\n                        <div class=\"card-front bg-purple-100 border-2 border-purple-300\">\n                            <h3 class=\"text-3xl font-bold text-purple-800\">Meddilazım</h3>\n                        </div>\n                        <div class=\"card-back bg-purple-600 text-white\">\n                            <p class=\"text-xl font-bold px-4\">Med harfinden sonra Şedde veya Cezim gelirse olur.</p>\n                        </div>\n                    </div>\n                </div>\n                 <!-- Card 4 -->\n                <div class=\"perspective cursor-pointer\" onclick=\"flipCard(this)\">\n                    <div class=\"card-inner w-full h-full bg-white rounded-2xl shadow-lg\">\n                        <div class=\"card-front bg-teal-100 border-2 border-teal-300\">\n                            <h3 class=\"text-3xl font-bold text-teal-800\">Ninova</h3>\n                        </div>\n                        <div class=\"card-back bg-teal-600 text-white\">\n                            <p class=\"text-xl font-bold px-4\">Hz. Yunus'un gönderildiği ve sonra tövbe eden şehir.</p>\n                        </div>\n                    </div>\n                </div>\n\n                 <!-- Card 5 -->\n                <div class=\"perspective cursor-pointer\" onclick=\"flipCard(this)\">\n                    <div class=\"card-inner w-full h-full bg-white rounded-2xl shadow-lg\">\n                        <div class=\"card-front bg-pink-100 border-2 border-pink-300\">\n                            <h3 class=\"text-3xl font-bold text-pink-800\">Sükunu Lazım</h3>\n                        </div>\n                        <div class=\"card-back bg-pink-600 text-white\">\n                            <p class=\"text-xl font-bold px-4\">Dursan da geçsen de okunan sükun (Cezim/Şedde).</p>\n                        </div>\n                    </div>\n                </div>\n\n                 <!-- Card 6 -->\n                <div class=\"perspective cursor-pointer\" onclick=\"flipCard(this)\">\n                    <div class=\"card-inner w-full h-full bg-white rounded-2xl shadow-lg\">\n                        <div class=\"card-front bg-yellow-100 border-2 border-yellow-300\">\n                            <h3 class=\"text-3xl font-bold text-yellow-800\">Kureyş</h3>\n                        </div>\n                        <div class=\"card-back bg-yellow-600 text-white\">\n                            <p class=\"text-xl font-bold px-4\">Yaz ve kış güvenle ticaret yapan kabile.</p>\n                        </div>\n                    </div>\n                </div>\n\n            </div>\n        </div>\n\n        <!-- Result Screen -->\n        <div id=\"result-screen\" class=\"hidden w-full flex flex-col items-center justify-center animate-bounce\">\n            <i class=\"fas fa-star text-9xl text-yellow-400 mb-6\"></i>\n            <h2 class=\"text-6xl font-bold text-gray-800 mb-4\">Harika!</h2>\n            <p id=\"final-msg\" class=\"text-3xl text-gray-600 mb-8\">Oyunu tamamladın.</p>\n            <button onclick=\"goHome()\" class=\"bg-indigo-600 text-white px-10 py-5 rounded-full text-3xl font-bold shadow-lg\">Tekrar Oyna</button>\n        </div>\n\n    </main>\n\n    <script>\n        // --- DATA ---\n        const detectiveData = [\n            { arabic: \"يَعْلَمُونَ\", latin: \"Ya'lemûûn (Durunca)\", type: 0, rule: \"Meddiarız\" }, // Arız\n            { arabic: \"دَٓابَّةٍ\", latin: \"Dââbbeh\", type: 1, rule: \"Meddilazım\" }, // Lazım\n            { arabic: \"قُرَيْشٍ\", latin: \"Qurayyyş\", type: 2, rule: \"Meddilin\" }, // Lin\n            { arabic: \"الْحَٓاقَّةُ\", latin: \"El-Hââqqah\", type: 1, rule: \"Meddilazım\" }, // Lazım\n            { arabic: \"نَسْتَعِينُ\", latin: \"Neste'îîn (Durunca)\", type: 0, rule: \"Meddiarız\" }, // Arız\n            { arabic: \"خَوْفٍ\", latin: \"Khavvven\", type: 2, rule: \"Meddilin\" } // Lin\n        ];\n\n        const yunusData = [\n            { q: \"Hz. Yunus balığın karnında dua etmiştir.\", a: true },\n            { q: \"Hz. Yunus Ninova halkından izin alarak ayrılmıştır.\", a: false }, // İzinsiz ayrıldı (Zelle)\n            { q: \"Ninova halkı sonunda tövbe etmiş ve kurtulmuştur.\", a: true },\n            { q: \"Hz. Yunus gemiye binince kura çekilmiş ve ona çıkmıştır.\", a: true },\n            { q: \"Meddiarız 10 elif miktarı uzatılır.\", a: false } // 4 elif\n        ];\n\n        // --- STATE ---\n        let currentIdx = 0;\n        let score = 0;\n        let gameMode = \"\";\n\n        // --- NAVIGATION ---\n        function hideAll() {\n            document.getElementById('menu-screen').classList.add('hidden');\n            document.getElementById('detective-screen').classList.add('hidden');\n            document.getElementById('yunus-screen').classList.add('hidden');\n            document.getElementById('cards-screen').classList.add('hidden');\n            document.getElementById('result-screen').classList.add('hidden');\n        }\n\n        function goHome() {\n            hideAll();\n            document.getElementById('menu-screen').classList.remove('hidden');\n            // Reset cards\n            document.querySelectorAll('.perspective').forEach(c => c.classList.remove('flipped'));\n        }\n\n        function startGame(mode) {\n            hideAll();\n            gameMode = mode;\n            currentIdx = 0;\n            score = 0;\n\n            if(mode === 'detective') {\n                document.getElementById('detective-screen').classList.remove('hidden');\n                loadDetective();\n            } else if(mode === 'yunus') {\n                document.getElementById('yunus-screen').classList.remove('hidden');\n                loadYunus();\n            } else if(mode === 'cards') {\n                document.getElementById('cards-screen').classList.remove('hidden');\n            }\n        }\n\n        // --- GAME 1: DETECTIVE ---\n        function loadDetective() {\n            const data = detectiveData[currentIdx];\n            document.getElementById('arabic-word').innerText = data.arabic;\n            document.getElementById('latin-word').innerText = data.latin;\n            document.getElementById('detective-progress').innerText = `Soru ${currentIdx + 1}/${detectiveData.length}`;\n            document.getElementById('feedback-msg').innerText = \"\";\n            document.getElementById('feedback-msg').className = \"h-10 text-center text-2xl font-bold mt-4\"; // reset color\n            \n            // Enable buttons\n            document.querySelectorAll('.detective-opt').forEach(btn => btn.disabled = false);\n        }\n\n        function checkDetective(guessType) {\n            const data = detectiveData[currentIdx];\n            const feedback = document.getElementById('feedback-msg');\n            const btns = document.querySelectorAll('.detective-opt');\n            \n            btns.forEach(b => b.disabled = true); // Prevent double click\n\n            if(guessType === data.type) {\n                score += 10;\n                feedback.innerText = \"Doğru! Cevap: \" + data.rule;\n                feedback.classList.add('text-green-600');\n                document.getElementById('detective-score').innerText = \"Puan: \" + score;\n            } else {\n                feedback.innerText = \"Yanlış. Doğrusu: \" + data.rule;\n                feedback.classList.add('text-red-600');\n            }\n\n            setTimeout(() => {\n                currentIdx++;\n                if(currentIdx < detectiveData.length) {\n                    loadDetective();\n                } else {\n                    showResult(score);\n                }\n            }, 1500);\n        }\n\n        // --- GAME 2: YUNUS QUIZ ---\n        function loadYunus() {\n            document.getElementById('yunus-question').innerText = yunusData[currentIdx].q;\n        }\n\n        function checkYunus(userAnswer) {\n            const correct = yunusData[currentIdx].a;\n            if(userAnswer === correct) {\n                // Correct visual feedback (Flash green)\n                document.body.style.backgroundColor = \"#dcfce7\";\n            } else {\n                // Wrong visual feedback (Flash red)\n                document.body.style.backgroundColor = \"#fee2e2\";\n            }\n\n            setTimeout(() => {\n                document.body.style.backgroundColor = \"#f0f9ff\"; // Reset\n                currentIdx++;\n                if(currentIdx < yunusData.length) {\n                    loadYunus();\n                } else {\n                    showResult(\"Tüm sorular bitti!\");\n                }\n            }, 500);\n        }\n\n        // --- CARDS ---\n        function flipCard(el) {\n            el.classList.toggle('flipped');\n        }\n\n        // --- RESULT ---\n        function showResult(msg) {\n            hideAll();\n            document.getElementById('result-screen').classList.remove('hidden');\n            if(typeof msg === 'number') {\n                document.getElementById('final-msg').innerText = `Toplam Puan: ${msg}`;\n            } else {\n                document.getElementById('final-msg').innerText = msg;\n            }\n        }\n\n    </script>\n</body>\n</html>",
    "isPublished": true,
    "title": "İnteraktif Sunum"
  },
