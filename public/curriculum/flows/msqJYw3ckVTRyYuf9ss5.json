    "title": "İnteraktif Sunum",
    "htmlContent": "<!DOCTYPE html>\n<html lang=\"tr\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>1. Ünite Akıllı Tahta Etkinlikleri</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <link href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css\" rel=\"stylesheet\">\n    <link href=\"https://fonts.googleapis.com/css2?family=Fredoka:wght@400;600&display=swap\" rel=\"stylesheet\">\n    <style>\n        body {\n            font-family: 'Fredoka', sans-serif;\n            background-color: #ecfccb; /* Lime-100 */\n            user-select: none;\n        }\n        .touch-btn:active { transform: scale(0.95); }\n        /* Card Flip Styles */\n        .perspective { perspective: 1000px; }\n        .card-inner {\n            position: relative;\n            width: 100%;\n            height: 100%;\n            text-align: center;\n            transition: transform 0.6s;\n            transform-style: preserve-3d;\n        }\n        .card-front, .card-back {\n            position: absolute;\n            width: 100%;\n            height: 100%;\n            backface-visibility: hidden;\n            border-radius: 1rem;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);\n        }\n        .card-back { transform: rotateY(180deg); }\n        .flipped .card-inner { transform: rotateY(180deg); }\n    </style>\n</head>\n<body class=\"h-screen flex flex-col overflow-hidden\">\n\n    <!-- Navbar -->\n    <header class=\"bg-emerald-600 text-white p-4 shadow-lg flex justify-between items-center z-10\">\n        <h1 class=\"text-3xl font-bold\"><i class=\"fas fa-chalkboard-teacher mr-3\"></i>Kur'an-ı Kerim'i Tanıyalım</h1>\n        <button onclick=\"goHome()\" class=\"bg-emerald-800 hover:bg-emerald-900 px-6 py-2 rounded-xl text-xl font-bold transition shadow-md\">\n            <i class=\"fas fa-home\"></i> Ana Menü\n        </button>\n    </header>\n\n    <main class=\"flex-grow relative flex items-center justify-center p-6\">\n        \n        <!-- MENU SCREEN -->\n        <div id=\"menu-screen\" class=\"w-full max-w-6xl grid grid-cols-1 md:grid-cols-3 gap-8\">\n            <!-- Game 1 -->\n            <div onclick=\"startGame('quiz')\" class=\"touch-btn cursor-pointer bg-white border-b-8 border-blue-500 rounded-3xl p-8 shadow-2xl flex flex-col items-center justify-center hover:bg-blue-50 h-80 transition transform hover:-translate-y-2\">\n                <i class=\"fas fa-question-circle text-7xl text-blue-500 mb-4\"></i>\n                <h2 class=\"text-3xl font-bold text-gray-700\">Bilgi Yarışması</h2>\n                <p class=\"text-lg text-gray-500 mt-2 text-center\">Ünite geneli sorular.</p>\n            </div>\n            <!-- Game 2 -->\n            <div onclick=\"startGame('prophets')\" class=\"touch-btn cursor-pointer bg-white border-b-8 border-purple-500 rounded-3xl p-8 shadow-2xl flex flex-col items-center justify-center hover:bg-purple-50 h-80 transition transform hover:-translate-y-2\">\n                <i class=\"fas fa-crown text-7xl text-purple-500 mb-4\"></i>\n                <h2 class=\"text-3xl font-bold text-gray-700\">Davud & Süleyman</h2>\n                <p class=\"text-lg text-gray-500 mt-2 text-center\">Doğru mu? Yanlış mı?</p>\n            </div>\n            <!-- Game 3 -->\n            <div onclick=\"startGame('cards')\" class=\"touch-btn cursor-pointer bg-white border-b-8 border-orange-500 rounded-3xl p-8 shadow-2xl flex flex-col items-center justify-center hover:bg-orange-50 h-80 transition transform hover:-translate-y-2\">\n                <i class=\"fas fa-cubes text-7xl text-orange-500 mb-4\"></i>\n                <h2 class=\"text-3xl font-bold text-gray-700\">Kavram Kartları</h2>\n                <p class=\"text-lg text-gray-500 mt-2 text-center\">Din, İman, Tevhit...</p>\n            </div>\n        </div>\n\n        <!-- GAME 1: QUIZ SCREEN -->\n        <div id=\"quiz-screen\" class=\"hidden w-full max-w-5xl h-full flex flex-col justify-center\">\n            <div class=\"bg-white rounded-3xl shadow-xl border-4 border-blue-200 p-8 h-full flex flex-col\">\n                <div class=\"flex justify-between text-2xl font-bold text-blue-800 mb-6\">\n                    <span id=\"quiz-progress\">Soru 1/5</span>\n                    <span id=\"quiz-score\">Puan: 0</span>\n                </div>\n                \n                <div class=\"flex-grow flex items-center justify-center mb-8 bg-blue-50 rounded-2xl p-6\">\n                    <h2 id=\"question-text\" class=\"text-4xl md:text-5xl font-bold text-center text-gray-800 leading-tight\"></h2>\n                </div>\n\n                <div id=\"options-container\" class=\"grid grid-cols-2 gap-6 h-64\">\n                    <!-- Options injected via JS -->\n                </div>\n            </div>\n        </div>\n\n        <!-- GAME 2: PROPHETS (True/False) -->\n        <div id=\"prophets-screen\" class=\"hidden w-full max-w-4xl h-full flex flex-col justify-center\">\n             <div class=\"bg-white rounded-3xl shadow-xl border-4 border-purple-200 p-8 h-full flex flex-col items-center text-center\">\n                <h2 class=\"text-3xl font-bold text-purple-700 mb-8\"><i class=\"fas fa-balance-scale mr-2\"></i>Doğru mu Yanlış mı?</h2>\n                <div class=\"flex-grow flex items-center justify-center w-full bg-purple-50 rounded-2xl p-6 mb-8\">\n                    <p id=\"prophet-statement\" class=\"text-4xl font-bold text-gray-800 leading-relaxed\"></p>\n                </div>\n                <div class=\"flex gap-8 w-full h-32\">\n                    <button onclick=\"checkProphet(true)\" class=\"flex-1 bg-green-500 hover:bg-green-600 text-white text-4xl font-bold rounded-2xl shadow-lg border-b-8 border-green-700 touch-btn\"><i class=\"fas fa-check\"></i> DOĞRU</button>\n                    <button onclick=\"checkProphet(false)\" class=\"flex-1 bg-red-500 hover:bg-red-600 text-white text-4xl font-bold rounded-2xl shadow-lg border-b-8 border-red-700 touch-btn\"><i class=\"fas fa-times\"></i> YANLIŞ</button>\n                </div>\n             </div>\n        </div>\n\n        <!-- GAME 3: FLASHCARDS -->\n        <div id=\"cards-screen\" class=\"hidden w-full max-w-6xl h-full flex flex-col items-center justify-center\">\n            <h2 class=\"text-4xl font-bold text-orange-800 mb-8\">Karta Dokun ve Anlamını Gör</h2>\n            <div class=\"grid grid-cols-2 md:grid-cols-3 gap-8 w-full h-3/4\">\n                \n                <!-- Card 1 -->\n                <div class=\"perspective cursor-pointer\" onclick=\"flipCard(this)\">\n                    <div class=\"card-inner w-full h-full\">\n                        <div class=\"card-front bg-red-100 border-4 border-red-300\">\n                            <h3 class=\"text-4xl font-bold text-red-800\">TEVHİT</h3>\n                        </div>\n                        <div class=\"card-back bg-red-600 text-white border-4 border-red-800\">\n                            <p class=\"text-2xl font-bold px-4\">Allah'ı zatında ve sıfatlarında bir ve tek kabul etmektir.</p>\n                        </div>\n                    </div>\n                </div>\n\n                <!-- Card 2 -->\n                <div class=\"perspective cursor-pointer\" onclick=\"flipCard(this)\">\n                    <div class=\"card-inner w-full h-full\">\n                        <div class=\"card-front bg-blue-100 border-4 border-blue-300\">\n                            <h3 class=\"text-4xl font-bold text-blue-800\">DİN</h3>\n                        </div>\n                        <div class=\"card-back bg-blue-600 text-white border-4 border-blue-800\">\n                            <p class=\"text-2xl font-bold px-4\">Allah'ın insanları mutluluğa ulaştıran ilahi kanunlarıdır.</p>\n                        </div>\n                    </div>\n                </div>\n\n                <!-- Card 3 -->\n                <div class=\"perspective cursor-pointer\" onclick=\"flipCard(this)\">\n                    <div class=\"card-inner w-full h-full\">\n                        <div class=\"card-front bg-green-100 border-4 border-green-300\">\n                            <h3 class=\"text-4xl font-bold text-green-800\">ZEBUR</h3>\n                        </div>\n                        <div class=\"card-back bg-green-600 text-white border-4 border-green-800\">\n                            <p class=\"text-2xl font-bold px-4\">Hz. Davud'a (a.s) verilen ilahi kitaptır.</p>\n                        </div>\n                    </div>\n                </div>\n\n                <!-- Card 4 -->\n                <div class=\"perspective cursor-pointer\" onclick=\"flipCard(this)\">\n                    <div class=\"card-inner w-full h-full\">\n                        <div class=\"card-front bg-yellow-100 border-4 border-yellow-300\">\n                            <h3 class=\"text-4xl font-bold text-yellow-800\">İTAAT</h3>\n                        </div>\n                        <div class=\"card-back bg-yellow-600 text-white border-4 border-yellow-800\">\n                            <p class=\"text-2xl font-bold px-4\">Allah'ın ve Peygamber'in emirlerine uymak, boyun eğmektir.</p>\n                        </div>\n                    </div>\n                </div>\n\n                <!-- Card 5 -->\n                <div class=\"perspective cursor-pointer\" onclick=\"flipCard(this)\">\n                    <div class=\"card-inner w-full h-full\">\n                        <div class=\"card-front bg-purple-100 border-4 border-purple-300\">\n                            <h3 class=\"text-4xl font-bold text-purple-800\">BELKIS</h3>\n                        </div>\n                        <div class=\"card-back bg-purple-600 text-white border-4 border-purple-800\">\n                            <p class=\"text-2xl font-bold px-4\">Hz. Süleyman zamanında yaşayan Sebe Melikesi (Kraliçesi).</p>\n                        </div>\n                    </div>\n                </div>\n\n                 <!-- Card 6 -->\n                 <div class=\"perspective cursor-pointer\" onclick=\"flipCard(this)\">\n                    <div class=\"card-inner w-full h-full\">\n                        <div class=\"card-front bg-gray-100 border-4 border-gray-300\">\n                            <h3 class=\"text-4xl font-bold text-gray-800\">İMAN</h3>\n                        </div>\n                        <div class=\"card-back bg-gray-600 text-white border-4 border-gray-800\">\n                            <p class=\"text-2xl font-bold px-4\">Kalp ile tasdik etmek, gönülden inanmaktır.</p>\n                        </div>\n                    </div>\n                </div>\n\n            </div>\n        </div>\n\n        <!-- RESULT SCREEN -->\n        <div id=\"result-screen\" class=\"hidden w-full flex flex-col items-center justify-center animate-bounce\">\n            <i class=\"fas fa-star text-9xl text-yellow-400 mb-6 drop-shadow-lg\"></i>\n            <h2 class=\"text-7xl font-bold text-gray-800 mb-4\">Harika İş!</h2>\n            <p id=\"final-msg\" class=\"text-4xl text-gray-600 mb-10\">Etkinliği tamamladın.</p>\n            <button onclick=\"goHome()\" class=\"bg-emerald-600 text-white px-12 py-6 rounded-full text-3xl font-bold shadow-xl hover:bg-emerald-700 transition\">Ana Menüye Dön</button>\n        </div>\n\n    </main>\n\n    <script>\n        // --- DATA ---\n        const quizData = [\n            {\n                q: \"İbrahim Suresi'nde Hz. İbrahim, hangi şehrin güvenliği için dua etmiştir?\",\n                options: [\"Medine\", \"Kudüs\", \"Mekke\", \"Şam\"],\n                correct: 2\n            },\n            {\n                q: \"İslam'ın inanç esaslarını kabul etmeyip, Allah'a ortak koşan kimseye ne denir?\",\n                options: [\"Mümin\", \"Müşrik\", \"Münafık\", \"Müslüman\"],\n                correct: 1\n            },\n            {\n                q: \"Aşağıdakilerden hangisi Kur'an-ı Kerim'in temel konularından biri DEĞİLDİR?\",\n                options: [\"İnanç\", \"İbadet\", \"Ahlak\", \"Müzik\"],\n                correct: 3\n            },\n            {\n                q: \"Hz. Davud (a.s) geçimini hangi meslekle sağlardı?\",\n                options: [\"Demircilik (Zırh yapımı)\", \"Terzilik\", \"Çobanlık\", \"Marangozluk\"],\n                correct: 0\n            },\n            {\n                q: \"'Din günü' ifadesi Fatiha suresinde hangi anlamda kullanılmıştır?\",\n                options: [\"Bayram günü\", \"Hesap ve ceza günü\", \"Cuma günü\", \"Kadir gecesi\"],\n                correct: 1\n            }\n        ];\n\n        const prophetData = [\n            { s: \"Hz. Süleyman kuşların dilini bilir ve onlarla konuşurdu.\", a: true },\n            { s: \"Hz. Davud'a İncil kitabı verilmiştir.\", a: false }, // Zebur\n            { s: \"Hz. Süleyman, cinleri çalıştırarak Mescid-i Aksa'yı inşa ettirmiştir.\", a: true },\n            { s: \"Hz. Davud, Calut adlı dev komutanı yenmiştir.\", a: true },\n            { s: \"Sebe Kraliçesi Belkıs, Hz. Süleyman'ın davetini reddedip savaştı.\", a: false } // Müslüman oldu\n        ];\n\n        // --- STATE ---\n        let currentIdx = 0;\n        let score = 0;\n        let activeGame = \"\";\n\n        // --- FUNCTIONS ---\n        function hideAll() {\n            document.getElementById('menu-screen').classList.add('hidden');\n            document.getElementById('quiz-screen').classList.add('hidden');\n            document.getElementById('prophets-screen').classList.add('hidden');\n            document.getElementById('cards-screen').classList.add('hidden');\n            document.getElementById('result-screen').classList.add('hidden');\n        }\n\n        function goHome() {\n            hideAll();\n            document.getElementById('menu-screen').classList.remove('hidden');\n            document.querySelectorAll('.perspective').forEach(c => c.classList.remove('flipped')); // Reset cards\n        }\n\n        function startGame(game) {\n            hideAll();\n            activeGame = game;\n            currentIdx = 0;\n            score = 0;\n\n            if (game === 'quiz') {\n                document.getElementById('quiz-screen').classList.remove('hidden');\n                loadQuiz();\n            } else if (game === 'prophets') {\n                document.getElementById('prophets-screen').classList.remove('hidden');\n                loadProphets();\n            } else if (game === 'cards') {\n                document.getElementById('cards-screen').classList.remove('hidden');\n            }\n        }\n\n        // --- QUIZ LOGIC ---\n        function loadQuiz() {\n            const data = quizData[currentIdx];\n            document.getElementById('question-text').innerText = data.q;\n            document.getElementById('quiz-progress').innerText = `Soru ${currentIdx + 1}/${quizData.length}`;\n            document.getElementById('quiz-score').innerText = `Puan: ${score}`;\n            \n            const container = document.getElementById('options-container');\n            container.innerHTML = '';\n            \n            data.options.forEach((opt, idx) => {\n                const btn = document.createElement('button');\n                btn.className = \"bg-blue-100 hover:bg-blue-200 text-blue-900 text-2xl font-bold rounded-2xl border-b-4 border-blue-300 p-4 touch-btn\";\n                btn.innerText = opt;\n                btn.onclick = () => checkQuiz(idx, btn);\n                container.appendChild(btn);\n            });\n        }\n\n        function checkQuiz(selectedIdx, btn) {\n            const correctIdx = quizData[currentIdx].correct;\n            const buttons = document.querySelectorAll('#options-container button');\n            buttons.forEach(b => b.disabled = true);\n\n            if (selectedIdx === correctIdx) {\n                btn.classList.remove('bg-blue-100', 'border-blue-300');\n                btn.classList.add('bg-green-500', 'text-white', 'border-green-700');\n                score += 20;\n            } else {\n                btn.classList.remove('bg-blue-100', 'border-blue-300');\n                btn.classList.add('bg-red-500', 'text-white', 'border-red-700');\n                // Highlight correct\n                buttons[correctIdx].classList.remove('bg-blue-100', 'border-blue-300');\n                buttons[correctIdx].classList.add('bg-green-500', 'text-white', 'border-green-700');\n            }\n\n            document.getElementById('quiz-score').innerText = `Puan: ${score}`;\n            \n            setTimeout(() => {\n                currentIdx++;\n                if (currentIdx < quizData.length) {\n                    loadQuiz();\n                } else {\n                    showResult(score);\n                }\n            }, 1500);\n        }\n\n        // --- PROPHETS LOGIC ---\n        function loadProphets() {\n            document.getElementById('prophet-statement').innerText = prophetData[currentIdx].s;\n        }\n\n        function checkProphet(answer) {\n            const isCorrect = answer === prophetData[currentIdx].a;\n            \n            // Visual Feedback\n            if(isCorrect) {\n                document.body.style.backgroundColor = \"#86efac\"; // Green\n                score += 1; // Just tracking correct answers\n            } else {\n                document.body.style.backgroundColor = \"#fca5a5\"; // Red\n            }\n\n            setTimeout(() => {\n                document.body.style.backgroundColor = \"#ecfccb\"; // Reset\n                currentIdx++;\n                if (currentIdx < prophetData.length) {\n                    loadProphets();\n                } else {\n                    showResult(\"Oyun Bitti!\");\n                }\n            }, 500);\n        }\n\n        // --- CARDS ---\n        function flipCard(el) {\n            el.classList.toggle('flipped');\n        }\n\n        // --- RESULT ---\n        function showResult(finalText) {\n            hideAll();\n            document.getElementById('result-screen').classList.remove('hidden');\n            if (typeof finalText === 'number') {\n                document.getElementById('final-msg').innerText = `Toplam Puan: ${finalText}`;\n            } else {\n                document.getElementById('final-msg').innerText = finalText;\n            }\n        }\n    </script>\n</body>\n</html>",
    "type": "htmlSlide",
    "isPublished": true
  },
