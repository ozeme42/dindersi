    "htmlContent": "<!DOCTYPE html>\n<html lang=\"tr\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>7. Sınıf 1. Ünite Özeti</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <link href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css\" rel=\"stylesheet\">\n    <link href=\"https://fonts.googleapis.com/css2?family=Kalam:wght@400;700&family=Nunito:wght@400;700&display=swap\" rel=\"stylesheet\">\n    <style>\n        :root {\n            font-size: 16px; /* Base font size for scaling */\n        }\n        body {\n            font-family: 'Nunito', sans-serif;\n            background-color: #111827; /* Dark Background */\n            color: #1f2937;\n            overflow: hidden; /* Prevent body scroll, handle in board */\n        }\n        .chalk-font {\n            font-family: 'Kalam', cursive;\n        }\n        .blackboard {\n            background-color: #2f3e46; /* Blackboard Green/Grey */\n            border: 12px solid #5c4033; /* Wood border */\n            box-shadow: 0 10px 30px rgba(0,0,0,0.5);\n            color: #f1f5f9;\n        }\n        .chalk-text {\n            color: #f1f5f9;\n            text-shadow: 1px 1px 2px rgba(0,0,0,0.3);\n        }\n        .highlight-yellow { color: #facc15; }\n        .highlight-green { color: #86efac; }\n        .highlight-pink { color: #f9a8d4; }\n        .highlight-blue { color: #93c5fd; }\n\n        /* Custom Scrollbar for the board */\n        ::-webkit-scrollbar { width: 12px; }\n        ::-webkit-scrollbar-track { background: #1f2937; border-radius: 6px; }\n        ::-webkit-scrollbar-thumb { background: #4b5563; border-radius: 6px; border: 2px solid #1f2937; }\n        ::-webkit-scrollbar-thumb:hover { background: #6b7280; }\n    </style>\n</head>\n<body class=\"h-screen flex flex-col p-4\">\n\n    <!-- Control Bar -->\n    <div class=\"flex justify-between items-center mb-4 bg-gray-800 p-3 rounded-xl shadow-lg border border-gray-700\">\n        <h1 class=\"text-white text-xl md:text-2xl font-bold ml-4 chalk-font\">\n            <span class=\"text-yellow-400\">1. ÜNİTE:</span> Kur'an-ı Kerim'i Tanıyalım\n        </h1>\n        <div class=\"flex gap-2\">\n            <button onclick=\"changeFontSize(-1)\" class=\"bg-gray-700 hover:bg-gray-600 text-white px-4 py-2 rounded-lg text-lg font-bold transition shadow border border-gray-600\" title=\"Yazıyı Küçült\">\n                <i class=\"fas fa-minus\"></i>\n            </button>\n            <button onclick=\"changeFontSize(1)\" class=\"bg-gray-700 hover:bg-gray-600 text-white px-4 py-2 rounded-lg text-lg font-bold transition shadow border border-gray-600\" title=\"Yazıyı Büyüt\">\n                <i class=\"fas fa-plus\"></i>\n            </button>\n            <button onclick=\"toggleFullScreen()\" class=\"bg-yellow-600 hover:bg-yellow-500 text-white px-6 py-2 rounded-lg text-lg font-bold transition shadow border border-yellow-700\" title=\"Tam Ekran\">\n                <i class=\"fas fa-expand\"></i> Tam Ekran\n            </button>\n        </div>\n    </div>\n\n    <!-- MAIN BOARD AREA -->\n    <div class=\"flex-grow w-full h-full relative overflow-hidden\">\n        \n        <div class=\"blackboard h-full w-full rounded-xl p-8 overflow-y-auto\">\n            \n            <!-- Header Decor -->\n            <div class=\"text-center mb-8 border-b-2 border-gray-500 pb-4\">\n                <i class=\"fas fa-star text-yellow-400 text-3xl mx-2 opacity-80\"></i>\n                <span class=\"text-4xl chalk-font highlight-blue\">İnanç ve Peygamberler</span>\n                <i class=\"fas fa-star text-yellow-400 text-3xl mx-2 opacity-80\"></i>\n            </div>\n            \n            <div class=\"grid grid-cols-1 md:grid-cols-2 gap-12\">\n                <!-- Sol: Konular ve Kavramlar -->\n                <div class=\"space-y-8\">\n                    <div>\n                        <h3 class=\"text-3xl chalk-font highlight-green mb-4 border-b border-gray-600 inline-block\"><i class=\"fas fa-list\"></i> Kur'an'ın Konuları</h3>\n                        <ul class=\"text-2xl space-y-4 chalk-text ml-2\">\n                            <li class=\"flex items-start\"><span class=\"text-yellow-400 mr-2\">•</span> <strong>İnanç (Tevhit):</strong> Allah'ın birliğine, ahirete ve peygamberlere inanmak.</li>\n                            <li class=\"flex items-start\"><span class=\"text-yellow-400 mr-2\">•</span> <strong>İbadet:</strong> Namaz, oruç, zekât gibi kulluk görevleri.</li>\n                            <li class=\"flex items-start\"><span class=\"text-yellow-400 mr-2\">•</span> <strong>Ahlak:</strong> İyi davranışlar, dürüstlük, yardımseverlik.</li>\n                            <li class=\"flex items-start\"><span class=\"text-yellow-400 mr-2\">•</span> <strong>Sosyal Hayat:</strong> İnsan ilişkileri, adalet, ticaret ahlakı.</li>\n                        </ul>\n                    </div>\n                    \n                    <div>\n                        <h3 class=\"text-3xl chalk-font highlight-green mb-4 border-b border-gray-600 inline-block\"><i class=\"fas fa-book-open\"></i> İbrahim Suresi</h3>\n                        <div class=\"bg-gray-700 bg-opacity-30 p-4 rounded-lg border border-gray-600\">\n                            <ul class=\"text-xl chalk-text space-y-3\">\n                                <li><i class=\"fas fa-check text-green-400 mr-2\"></i> Mekke'de inmiştir.</li>\n                                <li><i class=\"fas fa-check text-green-400 mr-2\"></i> <strong>\"Güzel Söz\" (Tevhit)</strong> kökü sağlam, dalları gökte bir ağaca benzetilir.</li>\n                                <li><i class=\"fas fa-check text-green-400 mr-2\"></i> Hz. İbrahim'in Mekke'nin güvenliği için yaptığı dualar anlatılır.</li>\n                            </ul>\n                        </div>\n                    </div>\n                </div>\n\n                <!-- Sağ: Peygamberler -->\n                <div class=\"border-l-2 border-gray-500 pl-8 space-y-8\">\n                    <h3 class=\"text-3xl chalk-font highlight-pink mb-4 border-b border-gray-600 inline-block\"><i class=\"fas fa-crown\"></i> Hükümdar Peygamberler</h3>\n                    \n                    <div class=\"bg-gray-700 bg-opacity-30 p-5 rounded-lg border border-gray-600 relative\">\n                        <div class=\"absolute -top-3 -right-3 bg-yellow-600 text-white text-sm px-2 py-1 rounded\">BABA</div>\n                        <strong class=\"text-2xl highlight-yellow block mb-2\"><i class=\"fas fa-hammer mr-2\"></i>Hz. Davud (a.s):</strong>\n                        <ul class=\"text-xl chalk-text ml-6 space-y-2 list-disc marker:text-yellow-500\">\n                            <li>Kendisine <strong>Zebur</strong> kitabı verildi.</li>\n                            <li>Sesi çok güzeldi, dağlar ve kuşlar ona eşlik ederdi.</li>\n                            <li><strong>Demiri</strong> yumuşatır, zırh yapardı.</li>\n                            <li>Calut'u yenerek İsrailoğullarını kurtardı.</li>\n                        </ul>\n                    </div>\n\n                    <div class=\"bg-gray-700 bg-opacity-30 p-5 rounded-lg border border-gray-600 relative\">\n                        <div class=\"absolute -top-3 -right-3 bg-purple-600 text-white text-sm px-2 py-1 rounded\">OĞUL</div>\n                        <strong class=\"text-2xl highlight-yellow block mb-2\"><i class=\"fas fa-wind mr-2\"></i>Hz. Süleyman (a.s):</strong>\n                        <ul class=\"text-xl chalk-text ml-6 space-y-2 list-disc marker:text-yellow-500\">\n                            <li><strong>Rüzgar</strong> ve cinler emrine verildi.</li>\n                            <li>Hayvanlarla konuşabilirdi (<strong>Hüdhüd</strong> kuşu).</li>\n                            <li><strong>Mescid-i Aksa</strong>'yı inşa etti.</li>\n                            <li>Sebe Kraliçesi Belkıs'ı hak dine davet etti.</li>\n                        </ul>\n                    </div>\n                </div>\n            </div>\n        </div>\n\n    </div>\n\n    <script>\n        let currentFontSize = 16; \n\n        function changeFontSize(amount) {\n            currentFontSize += amount;\n            if (currentFontSize < 12) currentFontSize = 12;\n            if (currentFontSize > 24) currentFontSize = 24;\n            document.documentElement.style.fontSize = currentFontSize + 'px';\n        }\n\n        function toggleFullScreen() {\n            if (!document.fullscreenElement) {\n                document.documentElement.requestFullscreen();\n            } else {\n                if (document.exitFullscreen) {\n                    document.exitFullscreen();\n                }\n            }\n        }\n    </script>\n</body>\n</html>"
  }
