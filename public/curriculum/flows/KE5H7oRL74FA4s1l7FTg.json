    "type": "htmlSlide",
    "htmlContent": "<!DOCTYPE html>\n<html lang=\"tr\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Vatanımızı Sevmek - Ders Sunumu</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <link href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css\" rel=\"stylesheet\">\n    <link href=\"https://fonts.googleapis.com/css2?family=Cinzel:wght@700&family=Noto+Sans+TR:wght@300;600;800&family=Playfair+Display:ital,wght@1,600&display=swap\" rel=\"stylesheet\">\n\n    <style>\n        body {\n            font-family: 'Noto Sans TR', sans-serif;\n            background-color: #0f172a;\n            color: #f8fafc;\n            overflow: hidden;\n        }\n        h1, h2 { font-family: 'Cinzel', serif; letter-spacing: 1px; }\n        .poem-font { font-family: 'Playfair Display', serif; }\n\n        /* SLAYT YAPISI */\n        .slide {\n            display: none !important;\n            opacity: 0;\n            transition: opacity 0.6s ease-in-out;\n            position: absolute;\n            inset: 0;\n            padding-left: 20rem; /* Menü payı */\n            flex-direction: column;\n            justify-content: center;\n            align-items: center;\n            z-index: 1;\n        }\n        .slide.active {\n            display: flex !important;\n            opacity: 1;\n            z-index: 10;\n        }\n\n        /* YAN MENÜ */\n        .sidebar {\n            width: 18rem;\n            position: fixed;\n            left: 0;\n            top: 0;\n            height: 100%;\n            background: linear-gradient(to bottom, #7f1d1d, #450a0a);\n            border-right: 4px solid #b91c1c;\n            z-index: 50;\n            padding: 2rem 1rem;\n            box-shadow: 5px 0 20px rgba(0,0,0,0.5);\n        }\n        .menu-item {\n            display: block;\n            padding: 15px 20px;\n            margin-bottom: 8px;\n            border-radius: 8px;\n            cursor: pointer;\n            transition: all 0.3s;\n            color: #fca5a5;\n            font-weight: 600;\n            border-left: 4px solid transparent;\n        }\n        .menu-item:hover { background: rgba(255,255,255,0.1); color: white; padding-left: 25px; }\n        .menu-item.active { background: rgba(255,255,255,0.2); color: white; border-left-color: white; }\n\n        /* CAM KARTLAR */\n        .glass-panel {\n            width: 90%;\n            height: 90%;\n            background: rgba(255, 255, 255, 0.03);\n            backdrop-filter: blur(15px);\n            border: 1px solid rgba(255, 255, 255, 0.1);\n            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);\n            border-radius: 2rem;\n            display: flex;\n            flex-direction: column;\n            justify-content: center;\n            align-items: center;\n            padding: 3rem;\n            position: relative;\n        }\n\n        /* ANİMASYONLAR */\n        .fade-up { animation: fadeUp 0.8s forwards; opacity: 0; transform: translateY(30px); }\n        .delay-1 { animation-delay: 0.2s; }\n        .delay-2 { animation-delay: 0.4s; }\n        .delay-3 { animation-delay: 0.6s; }\n\n        @keyframes fadeUp { to { opacity: 1; transform: translateY(0); } }\n\n        /* ARKA PLAN */\n        .bg-flag {\n            background: radial-gradient(circle at 80% 20%, #450a0a 0%, #0f172a 70%);\n        }\n    </style>\n</head>\n<body class=\"h-screen w-screen relative bg-flag\">\n\n    <!-- SOL MENÜ -->\n    <div class=\"sidebar\">\n        <div class=\"text-center mb-10\">\n            <div class=\"w-20 h-20 bg-white rounded-full flex items-center justify-center mx-auto mb-4 shadow-lg shadow-red-900\">\n                <i class=\"fas fa-star-and-crescent text-4xl text-red-700\"></i>\n            </div>\n            <h1 class=\"text-xl font-bold text-white\">VATAN SEVGİSİ</h1>\n        </div>\n        \n        <div onclick=\"goToSlide(0)\" class=\"menu-item active\" id=\"btn-0\">1. Vatan ve Millet</div>\n        <div onclick=\"goToSlide(1)\" class=\"menu-item\" id=\"btn-1\">2. Şiir Köşesi</div>\n        <div onclick=\"goToSlide(2)\" class=\"menu-item\" id=\"btn-2\">3. Şehitlik ve Gazilik</div>\n        <div onclick=\"goToSlide(3)\" class=\"menu-item\" id=\"btn-3\">4. Tarihi Mücadele</div>\n        <div onclick=\"goToSlide(4)\" class=\"menu-item\" id=\"btn-4\">5. 15 Temmuz</div>\n        <div onclick=\"goToSlide(5)\" class=\"menu-item\" id=\"btn-5\">6. Sorumluluklarımız</div>\n    </div>\n\n    <!-- İÇERİK ALANI -->\n    \n    <!-- SLAYT 0: GİRİŞ -->\n    <div class=\"slide active\">\n        <div class=\"glass-panel text-center fade-up border-t-8 border-red-600\">\n            <h1 class=\"text-7xl font-bold mb-6 text-white drop-shadow-lg\">VATANIMIZI SEVMEK</h1>\n            <p class=\"text-3xl text-red-200 font-light mb-12\">\"Verme, dünyaları alsan da bu cennet vatanı.\"</p>\n            \n            <div class=\"grid grid-cols-2 gap-12 w-full max-w-5xl\">\n                <div class=\"bg-white/5 p-8 rounded-2xl border-l-8 border-red-600 text-left\">\n                    <h3 class=\"text-3xl font-bold text-red-400 mb-4\">VATAN NEDİR?</h3>\n                    <p class=\"text-xl text-gray-300 leading-relaxed\">Bir milletin üzerinde yaşadığı, sınırları belli olan, tarihi ve kültürüyle bütünleştiği toprak parçasıdır.</p>\n                </div>\n                <div class=\"bg-white/5 p-8 rounded-2xl border-l-8 border-white text-left\">\n                    <h3 class=\"text-3xl font-bold text-white mb-4\">MİLLET NEDİR?</h3>\n                    <p class=\"text-xl text-gray-300 leading-relaxed\">Aynı topraklar üzerinde yaşayan; aralarında dil, tarih, duygu ve ülkü birliği bulunan insan topluluğudur.</p>\n                </div>\n            </div>\n        </div>\n    </div>\n\n    <!-- SLAYT 1: ŞİİR KÖŞESİ -->\n    <div class=\"slide\">\n        <div class=\"glass-panel fade-up\">\n            <h2 class=\"text-5xl font-bold mb-12 text-red-200\"><i class=\"fas fa-feather-alt mr-4\"></i>Şiir Köşesi</h2>\n            <div class=\"flex gap-12 w-full max-w-7xl\">\n                <!-- İstiklal Marşı -->\n                <div class=\"w-1/2 bg-red-900/30 p-10 rounded-3xl border border-red-500/30 relative\">\n                    <i class=\"fas fa-quote-left absolute -top-4 -left-4 text-5xl text-red-500 opacity-50\"></i>\n                    <h3 class=\"text-2xl font-bold text-white mb-6\">Mehmet Akif ERSOY</h3>\n                    <p class=\"poem-font text-2xl italic leading-loose text-red-100\">\n                        \"Bastığın yerleri 'toprak' diyerek geçme, tanı,<br>\n                        Düşün altındaki binlerce kefensiz yatanı.<br>\n                        Sen şehit oğlusun, incitme, yazıktır atanı,<br>\n                        Verme, dünyaları alsan da bu cennet vatanı.\"\n                    </p>\n                </div>\n                <!-- Bayrak Şiiri -->\n                <div class=\"w-1/2 bg-white/5 p-10 rounded-3xl border border-white/20 relative\">\n                    <i class=\"fas fa-quote-right absolute -bottom-4 -right-4 text-5xl text-white opacity-50\"></i>\n                    <h3 class=\"text-2xl font-bold text-white mb-6\">Arif Nihat ASYA</h3>\n                    <p class=\"poem-font text-2xl italic leading-loose text-gray-200\">\n                        \"Ey mavi göklerin beyaz ve kızıl süsü,<br>\n                        Kız kardeşimin gelinliği, şehidimin son örtüsü,<br>\n                        Işık ışık, dalga dalga bayrağım!<br>\n                        Senin destanını okudum, senin destanını yazacağım.\"\n                    </p>\n                </div>\n            </div>\n        </div>\n    </div>\n\n    <!-- SLAYT 2: ŞEHİTLİK VE GAZİLİK -->\n    <div class=\"slide\">\n        <div class=\"glass-panel fade-up\">\n            <h2 class=\"text-5xl font-bold mb-10 text-white\">Şehitlik ve Gazilik</h2>\n            \n            <div class=\"flex gap-10 w-full max-w-6xl items-center\">\n                <div class=\"w-1/2 space-y-6\">\n                    <div class=\"bg-red-600/20 p-6 rounded-2xl border-l-4 border-red-500\">\n                        <h3 class=\"text-2xl font-bold text-red-400 mb-2\">ŞEHİT</h3>\n                        <p class=\"text-lg text-gray-300\">Allah yolunda; vatan, din, namus ve bayrak için canını feda eden kimsedir.</p>\n                    </div>\n                    <div class=\"bg-blue-600/20 p-6 rounded-2xl border-l-4 border-blue-500\">\n                        <h3 class=\"text-2xl font-bold text-blue-400 mb-2\">GAZİ</h3>\n                        <p class=\"text-lg text-gray-300\">Vatan savunması için savaşa katılıp sağ dönen kahramandır.</p>\n                    </div>\n                </div>\n                \n                <div class=\"w-1/2 bg-black/40 p-8 rounded-3xl border border-yellow-500/30 text-center\">\n                    <i class=\"fas fa-scroll text-5xl text-yellow-500 mb-6\"></i>\n                    <h3 class=\"text-2xl font-bold text-yellow-200 mb-4\">Bir Hadis</h3>\n                    <p class=\"text-xl italic text-gray-200 leading-relaxed\">\n                        \"Cennete giren hiçbir kimse dünyaya geri dönmeyi arzu etmez. <strong class=\"text-white\">Sadece şehit</strong>, gördüğü itibar sebebiyle dünyaya dönüp on defa şehit olmayı ister.\"\n                    </p>\n                </div>\n            </div>\n        </div>\n    </div>\n\n    <!-- SLAYT 3: TARİHİ MÜCADELE -->\n    <div class=\"slide\">\n        <div class=\"glass-panel fade-up\">\n            <h2 class=\"text-5xl font-bold mb-12 text-red-200\">Tarihimizden Altın Sayfalar</h2>\n            <div class=\"grid grid-cols-3 gap-8 w-full max-w-7xl\">\n                \n                <div class=\"bg-white/5 p-8 rounded-2xl hover:bg-white/10 transition group text-center cursor-default\">\n                    <div class=\"w-24 h-24 bg-red-800 rounded-full flex items-center justify-center mx-auto mb-6 group-hover:scale-110 transition\">\n                        <span class=\"text-3xl font-bold\">1915</span>\n                    </div>\n                    <h3 class=\"text-2xl font-bold text-white mb-2\">Çanakkale Zaferi</h3>\n                    <p class=\"text-gray-400\">\"Çanakkale Geçilmez\" diyerek vatanı savunanların destanı.</p>\n                </div>\n\n                <div class=\"bg-white/5 p-8 rounded-2xl hover:bg-white/10 transition group text-center cursor-default\">\n                    <div class=\"w-24 h-24 bg-red-700 rounded-full flex items-center justify-center mx-auto mb-6 group-hover:scale-110 transition\">\n                        <span class=\"text-3xl font-bold\">1919</span>\n                    </div>\n                    <h3 class=\"text-2xl font-bold text-white mb-2\">Kurtuluş Savaşı</h3>\n                    <p class=\"text-gray-400\">Bağımsızlık ve yurt bütünlüğü için verilen topyekûn mücadele.</p>\n                </div>\n\n                <div class=\"bg-white/5 p-8 rounded-2xl hover:bg-white/10 transition group text-center cursor-default\">\n                    <div class=\"w-24 h-24 bg-red-600 rounded-full flex items-center justify-center mx-auto mb-6 group-hover:scale-110 transition\">\n                        <span class=\"text-3xl font-bold\">1974</span>\n                    </div>\n                    <h3 class=\"text-2xl font-bold text-white mb-2\">Kıbrıs Barış Harekâtı</h3>\n                    <p class=\"text-gray-400\">Kıbrıs Türklerini zulümden kurtarmak için yapılan harekât.</p>\n                </div>\n\n            </div>\n        </div>\n    </div>\n\n    <!-- SLAYT 4: 15 TEMMUZ -->\n    <div class=\"slide\">\n        <div class=\"glass-panel fade-up border-b-8 border-red-600\">\n            <div class=\"flex items-center gap-12 w-full max-w-6xl\">\n                <div class=\"w-1/2\">\n                    <h2 class=\"text-6xl font-bold mb-4 text-white\">15 TEMMUZ</h2>\n                    <h3 class=\"text-3xl text-red-400 mb-8 font-light\">Demokrasi ve Millî Birlik Günü</h3>\n                    <p class=\"text-xl text-gray-300 leading-relaxed mb-6\">\n                        2016 yılında milletimiz, darbecilere karşı sokaklara dökülerek vatanına ve iradesine sahip çıkmıştır.\n                    </p>\n                    <div class=\"flex items-center gap-4 bg-white/10 p-4 rounded-xl\">\n                        <i class=\"fas fa-fist-raised text-3xl text-white\"></i>\n                        <span class=\"text-lg font-bold\">Milli İradenin Zaferi</span>\n                    </div>\n                </div>\n                <div class=\"w-1/2 text-center bg-white/5 p-8 rounded-3xl border border-white/10\">\n                    <div class=\"w-40 h-40 bg-gray-200 rounded-full flex items-center justify-center mx-auto mb-6 overflow-hidden border-4 border-red-500\">\n                        <i class=\"fas fa-user-shield text-8xl text-gray-600\"></i>\n                    </div>\n                    <h3 class=\"text-3xl font-bold text-white mb-2\">Ömer HALİSDEMİR</h3>\n                    <p class=\"text-red-300 font-bold mb-4\">Kahraman Şehit</p>\n                    <p class=\"text-gray-400 text-sm\">\n                        Darbeci generale karşı sıktığı ilk kurşunla darbe girişiminin seyrini değiştiren, canını vatanı için feda eden kahraman astsubay.\n                    </p>\n                </div>\n            </div>\n        </div>\n    </div>\n\n    <!-- SLAYT 5: SORUMLULUKLARIMIZ (GÜNCEL) -->\n    <div class=\"slide\">\n        <div class=\"glass-panel fade-up\">\n            <h2 class=\"text-5xl font-bold mb-10 text-white\">Vatanı Sevmek Çalışmaktır</h2>\n            <p class=\"text-2xl text-gray-400 mb-12 text-center max-w-4xl\">\n                \"Vatanını en çok seven, görevini en iyi yapandır.\"\n            </p>\n            \n            <div class=\"grid grid-cols-2 gap-8 w-full max-w-6xl\">\n                <!-- KAAN -->\n                <div class=\"bg-gradient-to-br from-slate-800 to-slate-900 p-8 rounded-3xl border border-slate-600 flex items-center gap-6\">\n                    <i class=\"fas fa-fighter-jet text-6xl text-sky-400\"></i>\n                    <div>\n                        <h3 class=\"text-2xl font-bold text-white\">Milli Muharip Uçak KAAN</h3>\n                        <p class=\"text-gray-400 mt-2\">Yerli ve milli imkanlarla geliştirilen gururumuz.</p>\n                    </div>\n                </div>\n\n                <!-- TEKNOLOJİ -->\n                <div class=\"bg-gradient-to-br from-slate-800 to-slate-900 p-8 rounded-3xl border border-slate-600 flex items-center gap-6\">\n                    <i class=\"fas fa-rocket text-6xl text-orange-400\"></i>\n                    <div>\n                        <h3 class=\"text-2xl font-bold text-white\">Savunma Sanayi</h3>\n                        <p class=\"text-gray-400 mt-2\">İHA, SİHA ve yerli teknolojilerle güçlü Türkiye.</p>\n                    </div>\n                </div>\n\n                <!-- BİZİM GÖREVİMİZ -->\n                <div class=\"col-span-2 bg-red-900/30 p-8 rounded-3xl border border-red-600/30 text-center\">\n                    <h3 class=\"text-3xl font-bold text-red-200 mb-4\"><i class=\"fas fa-user-graduate mr-3\"></i>Senin Görevin Ne?</h3>\n                    <p class=\"text-xl text-white\">Çok çalışmak, bilim üretmek, ahlaklı olmak ve vatanı ileriye taşımak.</p>\n                </div>\n            </div>\n        </div>\n    </div>\n\n    <script>\n        let currentSlide = 0;\n        const slides = document.querySelectorAll('.slide');\n        const menuItems = document.querySelectorAll('.menu-item');\n\n        function updateSlide() {\n            slides.forEach((s, i) => {\n                s.classList.remove('active');\n                if(i === currentSlide) {\n                    s.classList.add('active');\n                    const anims = s.querySelectorAll('.fade-up');\n                    anims.forEach(el => {\n                        el.style.animation = 'none';\n                        el.offsetHeight; \n                        el.style.animation = null; \n                    });\n                }\n            });\n            \n            menuItems.forEach((m, i) => {\n                if(i === currentSlide) m.classList.add('active');\n                else m.classList.remove('active');\n            });\n        }\n\n        function goToSlide(n) {\n            currentSlide = n;\n            updateSlide();\n        }\n\n        document.addEventListener('keydown', (e) => {\n            if(e.key === 'ArrowDown' || e.key === ' ') {\n                if(currentSlide < slides.length - 1) { currentSlide++; updateSlide(); }\n            }\n            if(e.key === 'ArrowUp') {\n                if(currentSlide > 0) { currentSlide--; updateSlide(); }\n            }\n        });\n\n        updateSlide();\n    </script>\n</body>\n</html>",
