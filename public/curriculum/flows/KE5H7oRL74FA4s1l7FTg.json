    "htmlContent": "<!DOCTYPE html>\n<html lang=\"tr\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no\">\n    <title>Vatan Oyunları Merkezi</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <link href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css\" rel=\"stylesheet\">\n    <link href=\"https://fonts.googleapis.com/css2?family=Fredoka:wght@400;600&family=Nunito:wght@400;700&display=swap\" rel=\"stylesheet\">\n\n    <style>\n        body { font-family: 'Nunito', sans-serif; background-color: #111827; color: white; touch-action: manipulation; overflow: hidden; }\n        h1, h2 { font-family: 'Fredoka', sans-serif; }\n\n        /* HEADER */\n        .header-btn { padding: 15px 30px; border-radius: 12px; font-size: 1.1rem; background: rgba(255,255,255,0.05); transition: all 0.3s; font-weight: bold; border: 1px solid rgba(255,255,255,0.1); display: flex; align-items: center; gap: 10px; }\n        .header-btn.active { background: #b91c1c; border-color: #f87171; box-shadow: 0 0 20px rgba(185, 28, 28, 0.5); transform: scale(1.05); }\n\n        /* OYUN 1: KAHRAMAN KARTLARI */\n        .flip-card { perspective: 1000px; height: 300px; cursor: pointer; }\n        .flip-card-inner { position: relative; width: 100%; height: 100%; transition: transform 0.6s; transform-style: preserve-3d; }\n        .flip-card.flipped .flip-card-inner { transform: rotateY(180deg); }\n        .flip-card-front, .flip-card-back { position: absolute; width: 100%; height: 100%; backface-visibility: hidden; border-radius: 1.5rem; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 2rem; text-align: center; border: 2px solid rgba(255,255,255,0.1); box-shadow: 0 10px 20px rgba(0,0,0,0.3); }\n        .flip-card-front { background: #1f2937; }\n        .flip-card-back { background: #991b1b; transform: rotateY(180deg); border-color: #ef4444; }\n\n        /* OYUN 2: DOĞRU YANLIŞ */\n        .tf-btn { padding: 2rem; font-size: 2rem; border-radius: 1rem; font-weight: bold; cursor: pointer; transition: transform 0.1s; border: 2px solid rgba(255,255,255,0.2); }\n        .tf-btn:active { transform: scale(0.95); }\n        .tf-true { background: #16a34a; }\n        .tf-false { background: #dc2626; }\n\n        /* OYUN 3: EŞLEŞTİRME */\n        .match-item { padding: 1.5rem; font-size: 1.2rem; border-radius: 1rem; cursor: pointer; transition: all 0.2s; border: 1px solid rgba(255,255,255,0.1); background: #1f2937; }\n        .match-item:hover { background: #374151; transform: translateX(5px); }\n        .match-item.selected { background: #eab308 !important; color: black; border-color: #facc15; transform: scale(1.02); }\n        .match-item.matched { background: #15803d !important; opacity: 0.5; pointer-events: none; }\n        .match-item.wrong { animation: shake 0.4s; background: #991b1b !important; }\n\n        /* OYUN 4: ANAGRAM */\n        .slot { width: 60px; height: 80px; border-bottom: 4px solid #94a3b8; display: flex; align-items: center; justify-content: center; font-size: 2.5rem; font-weight: bold; margin: 0 5px; transition: all 0.3s; }\n        .slot.filled { border-color: #fca5a5; color: #fca5a5; animation: popIn 0.3s; }\n        .letter-btn { width: 70px; height: 70px; border-radius: 12px; font-size: 2rem; font-weight: bold; display: flex; align-items: center; justify-content: center; cursor: pointer; background: #b91c1c; border-bottom: 6px solid #7f1d1d; user-select: none; transition: transform 0.1s; }\n        .letter-btn:active { transform: translateY(6px); border-bottom: 0; }\n        .letter-btn.used { opacity: 0; pointer-events: none; transform: scale(0); }\n\n        @keyframes shake { 0%, 100% { transform: translateX(0); } 25% { transform: translateX(-5px); } 75% { transform: translateX(5px); } }\n        @keyframes popIn { from { transform: scale(0.5); opacity: 0; } to { transform: scale(1); opacity: 1; } }\n    </style>\n</head>\n<body class=\"h-screen w-screen flex flex-col\">\n\n    <!-- Header -->\n    <header class=\"bg-slate-900 p-6 shadow-2xl flex justify-between items-center z-50 h-[100px]\">\n        <h1 class=\"text-3xl text-red-500 font-bold\"><i class=\"fas fa-flag mr-3\"></i>VATAN OYUNLARI</h1>\n        <div class=\"flex gap-4\">\n            <button onclick=\"switchTab('game1')\" id=\"btn-game1\" class=\"header-btn active\"><i class=\"fas fa-users\"></i> Kahramanlar</button>\n            <button onclick=\"switchTab('game2')\" id=\"btn-game2\" class=\"header-btn\"><i class=\"fas fa-check-circle\"></i> Doğru/Yanlış</button>\n            <button onclick=\"switchTab('game3')\" id=\"btn-game3\" class=\"header-btn\"><i class=\"fas fa-link\"></i> Eşleştirme</button>\n            <button onclick=\"switchTab('game4')\" id=\"btn-game4\" class=\"header-btn\"><i class=\"fas fa-spell-check\"></i> Kelime Avı</button>\n        </div>\n    </header>\n\n    <!-- Oyun Alanı -->\n    <div id=\"game-container\" class=\"w-full h-[calc(100vh-100px)] flex justify-center items-center p-4\">\n        \n        <!-- OYUN 1: KAHRAMANLAR -->\n        <div id=\"game1\" class=\"w-full h-full p-4 overflow-y-auto\">\n            <div class=\"text-center mb-8\">\n                <h2 class=\"text-4xl font-bold mb-4 text-red-200\">Kim Olduğumu Bil?</h2>\n                <p class=\"text-xl text-gray-400\">İpucunu oku, kartı çevir ve kahramanı bul.</p>\n            </div>\n            <div class=\"grid grid-cols-4 gap-6 max-w-[90vw] mx-auto pb-10\" id=\"cards-grid\"></div>\n        </div>\n\n        <!-- OYUN 2: DOĞRU YANLIŞ -->\n        <div id=\"game2\" class=\"hidden w-full max-w-4xl text-center\">\n            <div class=\"bg-slate-800 p-12 rounded-3xl border border-red-900 shadow-2xl relative\">\n                <span class=\"text-red-400 font-bold text-xl block mb-6\" id=\"tf-counter\">Soru 1</span>\n                <h2 class=\"text-4xl font-bold mb-12 text-white leading-relaxed\" id=\"tf-question\">...</h2>\n                <div class=\"flex gap-12 justify-center\">\n                    <button onclick=\"checkTF(true)\" class=\"tf-btn tf-true w-64\"><i class=\"fas fa-check mr-2\"></i>DOĞRU</button>\n                    <button onclick=\"checkTF(false)\" class=\"tf-btn tf-false w-64\"><i class=\"fas fa-times mr-2\"></i>YANLIŞ</button>\n                </div>\n                <div id=\"tf-feedback\" class=\"mt-8 h-8 text-2xl font-bold\"></div>\n            </div>\n        </div>\n\n        <!-- OYUN 3: EŞLEŞTİRME -->\n        <div id=\"game3\" class=\"hidden w-full h-full flex flex-col items-center justify-center\">\n            <div class=\"text-center mb-10\">\n                <h2 class=\"text-4xl font-bold mb-4 text-yellow-200\">Kavramları Eşleştir</h2>\n                <p class=\"text-xl text-gray-400\">Tanımları ve isimleri doğru eşleştir.</p>\n            </div>\n            <div class=\"grid grid-cols-2 gap-16 w-full max-w-6xl\">\n                <div class=\"flex flex-col gap-4\" id=\"col-defs\"></div>\n                <div class=\"flex flex-col gap-4\" id=\"col-terms\"></div>\n            </div>\n            <div id=\"msg2\" class=\"text-center mt-10 text-4xl font-bold hidden text-green-400\">Harika! Hepsini eşleştirdin.</div>\n        </div>\n\n        <!-- OYUN 4: ANAGRAM -->\n        <div id=\"game4\" class=\"hidden w-full max-w-5xl flex flex-col items-center\">\n            <div class=\"bg-slate-800 p-12 rounded-3xl border border-slate-700 shadow-2xl w-full text-center relative\">\n                <span class=\"absolute top-0 left-1/2 -translate-x-1/2 -translate-y-1/2 bg-red-600 px-6 py-2 rounded-full font-bold shadow-lg text-lg\" id=\"anagram-counter\">Soru 1</span>\n                <h2 class=\"text-4xl font-bold mb-10 text-white\" id=\"anagram-q\">...</h2>\n                <div class=\"flex justify-center flex-wrap gap-4 mb-10\" id=\"anagram-slots\"></div>\n                <div class=\"flex justify-center flex-wrap gap-4\" id=\"anagram-pool\"></div>\n                <div id=\"anagram-msg\" class=\"mt-8 h-10 text-3xl font-bold text-green-400\"></div>\n                <button onclick=\"nextAnagram()\" id=\"anagram-next\" class=\"hidden mt-8 bg-green-600 hover:bg-green-500 px-10 py-4 rounded-full font-bold shadow-lg transition text-xl\">Sonraki Soru <i class=\"fas fa-arrow-right ml-2\"></i></button>\n            </div>\n        </div>\n\n    </div>\n\n    <script>\n        function switchTab(id) {\n            ['game1', 'game2', 'game3', 'game4'].forEach(g => document.getElementById(g).classList.add('hidden'));\n            ['btn-game1', 'btn-game2', 'btn-game3', 'btn-game4'].forEach(b => document.getElementById(b).classList.remove('active'));\n            \n            document.getElementById(id).classList.remove('hidden');\n            document.getElementById('btn-' + id).classList.add('active');\n\n            if(id === 'game4' && !isAnagramInit) initAnagram();\n        }\n\n        // --- OYUN 1: KAHRAMANLAR ---\n        const heroes = [\n            { q: \"15 Temmuz kahramanı şehit astsubay.\", a: \"ÖMER HALİSDEMİR\" },\n            { q: \"İstiklal Marşı'mızın şairi.\", a: \"MEHMET AKİF ERSOY\" },\n            { q: \"Bayrak şiirinin şairi.\", a: \"ARİF NİHAT ASYA\" },\n            { q: \"Milli imkanlarla geliştirilen savaş uçağımız.\", a: \"KAAN\" },\n            { q: \"Kıbrıs Türklerini kurtarmak için yapılan harekat (1974).\", a: \"KIBRIS BARIŞ HAREKATI\" },\n            { q: \"1915'te 'Geçilmez' dediğimiz zafer.\", a: \"ÇANAKKALE ZAFERİ\" },\n            { q: \"Bağımsızlık için verdiğimiz topyekûn savaş.\", a: \"KURTULUŞ SAVAŞI\" },\n            { q: \"15 Temmuz'un diğer adı.\", a: \"DEMOKRASİ VE MİLLİ BİRLİK\" }\n        ];\n\n        const grid1 = document.getElementById('cards-grid');\n        heroes.forEach(h => {\n            const card = document.createElement('div');\n            card.className = 'flip-card group';\n            card.innerHTML = `\n                <div class=\"flip-card-inner\">\n                    <div class=\"flip-card-front\"><i class=\"fas fa-star text-5xl text-red-500 mb-4\"></i><p class=\"font-bold text-lg text-gray-200\">${h.q}</p></div>\n                    <div class=\"flip-card-back\"><i class=\"fas fa-flag text-5xl text-white mb-4\"></i><p class=\"font-bold text-2xl\">${h.a}</p></div>\n                </div>\n            `;\n            card.onclick = () => card.classList.toggle('flipped');\n            grid1.appendChild(card);\n        });\n\n        // --- OYUN 2: DOĞRU YANLIŞ ---\n        const tfQuestions = [\n            { q: \"Vatan sadece bir toprak parçasından ibarettir.\", a: false, fb: \"Yanlış! Vatan; tarih, kültür ve değerler bütünüdür.\" },\n            { q: \"Şehitler, Allah katında ölmezler, diridirler.\", a: true, fb: \"Doğru! Ayetle sabittir.\" },\n            { q: \"Vatanını en çok seven, görevini en iyi yapandır.\", a: true, fb: \"Doğru! Çalışmak en büyük vatanseverliktir.\" },\n            { q: \"Kıbrıs Barış Harekatı 2023 yılında yapılmıştır.\", a: false, fb: \"Yanlış! 1974 yılında yapılmıştır.\" },\n            { q: \"Ömer Halisdemir 15 Temmuz'un seyrini değiştiren kahramandır.\", a: true, fb: \"Doğru! Darbecilere geçit vermemiştir.\" }\n        ];\n        let tfIdx = 0;\n\n        function loadTF() {\n            if(tfIdx >= tfQuestions.length) {\n                document.getElementById('tf-question').innerText = \"TÜM SORULAR BİTTİ!\";\n                return;\n            }\n            document.getElementById('tf-counter').innerText = `Soru ${tfIdx+1}/${tfQuestions.length}`;\n            document.getElementById('tf-question').innerText = tfQuestions[tfIdx].q;\n            document.getElementById('tf-feedback').innerText = \"\";\n        }\n\n        function checkTF(ans) {\n            const q = tfQuestions[tfIdx];\n            const fb = document.getElementById('tf-feedback');\n            if(ans === q.a) {\n                fb.innerHTML = `<span class=\"text-green-400\">TEBRİKLER! ${q.fb}</span>`;\n                setTimeout(() => { tfIdx++; loadTF(); }, 2500);\n            } else {\n                fb.innerHTML = `<span class=\"text-red-400\">YANLIŞ. ${q.fb}</span>`;\n            }\n        }\n        loadTF();\n\n        // --- OYUN 3: EŞLEŞTİRME ---\n        const matchData = [\n            { def: \"Aynı topraklarda yaşayan, dil ve tarih birliği olan topluluk.\", term: \"MİLLET\" },\n            { def: \"Allah yolunda canını feda eden kimse.\", term: \"ŞEHİT\" },\n            { def: \"Savaşa katılıp sağ dönen kahraman.\", term: \"GAZİ\" },\n            { def: \"Bağımsızlık sembolümüz.\", term: \"BAYRAK\" },\n            { def: \"Milli şairimiz.\", term: \"MEHMET AKİF\" }\n        ];\n\n        let selDef = null, selTerm = null, matches = 0;\n        const defCol = document.getElementById('col-defs');\n        const termCol = document.getElementById('col-terms');\n\n        const shufDefs = [...matchData].sort(() => Math.random() - 0.5);\n        const shufTerms = [...matchData].sort(() => Math.random() - 0.5);\n\n        shufDefs.forEach(d => {\n            const btn = document.createElement('div');\n            btn.className = 'match-item text-lg';\n            btn.innerText = d.def;\n            btn.onclick = () => selectItem(btn, 'def', d.term);\n            defCol.appendChild(btn);\n        });\n\n        shufTerms.forEach(t => {\n            const btn = document.createElement('div');\n            btn.className = 'match-item text-center font-bold text-xl';\n            btn.innerText = t.term;\n            btn.onclick = () => selectItem(btn, 'term', t.term);\n            termCol.appendChild(btn);\n        });\n\n        function selectItem(el, type, val) {\n            if(el.classList.contains('matched')) return;\n            \n            if(type === 'def') {\n                if(selDef) selDef.el.classList.remove('selected');\n                selDef = { el, val };\n            } else {\n                if(selTerm) selTerm.el.classList.remove('selected');\n                selTerm = { el, val };\n            }\n            el.classList.add('selected');\n\n            if(selDef && selTerm) {\n                if(selDef.val === selTerm.val) {\n                    selDef.el.classList.add('matched'); selTerm.el.classList.add('matched');\n                    selDef.el.classList.remove('selected'); selTerm.el.classList.remove('selected');\n                    selDef = null; selTerm = null; matches++;\n                    if(matches === matchData.length) document.getElementById('msg2').classList.remove('hidden');\n                } else {\n                    selDef.el.classList.add('wrong'); selTerm.el.classList.add('wrong');\n                    setTimeout(() => {\n                        selDef.el.classList.remove('wrong', 'selected');\n                        selTerm.el.classList.remove('wrong', 'selected');\n                        selDef = null; selTerm = null;\n                    }, 500);\n                }\n            }\n        }\n\n        // --- OYUN 4: ANAGRAM ---\n        const anagrams = [\n            { q: \"Milletin evi, toprağı?\", a: \"VATAN\" },\n            { q: \"Vatan için can veren?\", a: \"ŞEHİT\" },\n            { q: \"Savaştan sağ dönen?\", a: \"GAZİ\" },\n            { q: \"Bağımsızlık sembolümüz?\", a: \"BAYRAK\" },\n            { q: \"Milli uçağımız?\", a: \"KAAN\" },\n            { q: \"15 Temmuz kahramanı (Soyadı)?\", a: \"HALİSDEMİR\" }\n        ];\n        \n        let anaIdx = 0, anaProg = 0, isAnagramInit = false;\n\n        function initAnagram() {\n            anaIdx = 0; \n            loadAnagram(); \n            isAnagramInit = true;\n        }\n\n        function loadAnagram() {\n            if(anaIdx >= anagrams.length) {\n                document.getElementById('anagram-q').innerText = \"TEBRİKLER! TÜM SORULAR BİTTİ!\";\n                document.getElementById('anagram-slots').innerHTML = '';\n                document.getElementById('anagram-pool').innerHTML = '';\n                document.getElementById('anagram-next').classList.add('hidden');\n                document.getElementById('anagram-counter').classList.add('hidden');\n                return;\n            }\n            const data = anagrams[anaIdx];\n            anaProg = 0;\n            document.getElementById('anagram-counter').innerText = `Soru ${anaIdx+1}/${anagrams.length}`;\n            document.getElementById('anagram-q').innerText = data.q;\n            document.getElementById('anagram-msg').innerText = '';\n            document.getElementById('anagram-next').classList.add('hidden');\n            \n            const slots = document.getElementById('anagram-slots');\n            const pool = document.getElementById('anagram-pool');\n            slots.innerHTML = ''; pool.innerHTML = '';\n\n            for(let i=0; i<data.a.length; i++) {\n                const s = document.createElement('div'); s.className = 'slot'; s.id = `slot-${i}`;\n                slots.appendChild(s);\n            }\n\n            data.a.split('').sort(() => Math.random()-0.5).forEach(char => {\n                const btn = document.createElement('div');\n                btn.className = 'letter-btn'; btn.innerText = char;\n                btn.onclick = () => {\n                    if(char === data.a[anaProg]) {\n                        document.getElementById(`slot-${anaProg}`).innerText = char;\n                        document.getElementById(`slot-${anaProg}`).classList.add('filled');\n                        btn.classList.add('used');\n                        anaProg++;\n                        if(anaProg === data.a.length) {\n                            document.getElementById('anagram-msg').innerText = \"DOĞRU CEVAP!\";\n                            document.getElementById('anagram-next').classList.remove('hidden');\n                        }\n                    } else {\n                        btn.style.animation = 'shake 0.4s';\n                        setTimeout(()=> { btn.style.animation = ''; }, 400);\n                    }\n                };\n                pool.appendChild(btn);\n            });\n        }\n\n        function nextAnagram() { anaIdx++; loadAnagram(); }\n\n    </script>\n</body>\n</html>",
    "title": "İnteraktif Sunum"
  },
