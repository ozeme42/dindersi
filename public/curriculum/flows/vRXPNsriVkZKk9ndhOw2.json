    "type": "htmlSlide",
    "htmlContent": "<!DOCTYPE html>\n<html lang=\"tr\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Adap ve Nezaket Kuralları - Ders Sunumu</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <link href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css\" rel=\"stylesheet\">\n    <link href=\"https://fonts.googleapis.com/css2?family=Patrick+Hand&family=Rubik:wght@300;500;700&display=swap\" rel=\"stylesheet\">\n\n    <style>\n        body {\n            font-family: 'Rubik', sans-serif;\n            background-color: #1e1b4b; /* Koyu Lacivert */\n            color: #e2e8f0;\n            overflow: hidden;\n        }\n        h1, h2 { font-family: 'Patrick Hand', cursive; letter-spacing: 1px; }\n\n        /* SLAYT YAPISI */\n        .slide {\n            display: none !important;\n            opacity: 0;\n            transition: opacity 0.6s ease-in-out;\n            position: absolute;\n            inset: 0;\n            padding: 0;\n            flex-direction: column;\n            justify-content: center;\n            align-items: center;\n            z-index: 1;\n        }\n        .slide.active {\n            display: flex !important;\n            opacity: 1;\n            z-index: 10;\n        }\n\n        /* CAM KARTLAR */\n        .glass-panel {\n            width: 90vw;\n            height: 85vh;\n            background: rgba(255, 255, 255, 0.05);\n            backdrop-filter: blur(20px);\n            border: 1px solid rgba(255, 255, 255, 0.1);\n            box-shadow: 0 25px 50px rgba(0, 0, 0, 0.5);\n            border-radius: 2.5rem;\n            display: flex;\n            flex-direction: column;\n            justify-content: center;\n            align-items: center;\n            padding: 4rem;\n            position: relative;\n        }\n\n        /* ANİMASYONLAR */\n        .fade-up { animation: fadeUp 0.8s forwards; opacity: 0; transform: translateY(30px); }\n        .delay-1 { animation-delay: 0.2s; }\n        .delay-2 { animation-delay: 0.4s; }\n        .delay-3 { animation-delay: 0.6s; }\n\n        @keyframes fadeUp { to { opacity: 1; transform: translateY(0); } }\n\n        /* ARKA PLAN */\n        .bg-pattern {\n            background-image: radial-gradient(circle at 20% 20%, #4338ca 0%, transparent 40%),\n                              radial-gradient(circle at 80% 80%, #be185d 0%, transparent 40%);\n        }\n    </style>\n</head>\n<body class=\"h-screen w-screen relative bg-pattern bg-[#0f172a]\">\n\n    <!-- Navigasyon -->\n    <div class=\"absolute bottom-8 right-10 z-50 flex gap-6\">\n        <button onclick=\"changeSlide(-1)\" class=\"w-16 h-16 rounded-full bg-white/10 hover:bg-white/20 flex items-center justify-center transition border border-white/20 text-2xl\"><i class=\"fas fa-chevron-left\"></i></button>\n        <span id=\"slide-num\" class=\"flex items-center font-bold text-indigo-200 text-2xl w-16 justify-center\">1/7</span>\n        <button onclick=\"changeSlide(1)\" class=\"w-16 h-16 rounded-full bg-white/10 hover:bg-white/20 flex items-center justify-center transition border border-white/20 text-2xl\"><i class=\"fas fa-chevron-right\"></i></button>\n    </div>\n\n    <!-- SLAYT 1: KAPAK -->\n    <div class=\"slide active\">\n        <div class=\"glass-panel border-t-8 border-indigo-500 fade-up text-center\">\n            <div class=\"inline-block bg-indigo-500/20 p-10 rounded-full mb-8 animate-pulse\">\n                <i class=\"fas fa-handshake text-8xl text-indigo-300\"></i>\n            </div>\n            <h1 class=\"text-7xl lg:text-9xl font-extrabold mb-6 text-transparent bg-clip-text bg-gradient-to-r from-indigo-200 to-white\">\n                Adap ve Nezaket\n            </h1>\n            <h2 class=\"text-4xl text-gray-300 font-light mb-12\">\n                \"Nezaket, insanı yormayan ama herkesi mutlu eden ince davranışlardır.\"\n            </h2>\n            <div class=\"bg-white/10 px-12 py-4 rounded-full border border-white/10\">\n                <span class=\"text-2xl text-indigo-200 font-bold\">3. ÜNİTE: BİRLİKTE YAŞAMA SANATI</span>\n            </div>\n        </div>\n    </div>\n\n    <!-- SLAYT 2: TANIMLAR -->\n    <div class=\"slide\">\n        <div class=\"glass-panel fade-up\">\n            <h2 class=\"text-6xl font-bold mb-16 text-indigo-200\">Kavramları Öğrenelim</h2>\n            <div class=\"grid grid-cols-2 gap-16 w-full max-w-7xl\">\n                \n                <div class=\"bg-white/5 p-12 rounded-3xl border-l-8 border-blue-500 hover:bg-white/10 transition\">\n                    <div class=\"flex items-center gap-6 mb-6\">\n                        <i class=\"fas fa-book-reader text-6xl text-blue-400\"></i>\n                        <h3 class=\"text-5xl font-bold text-white\">ADAP (EDEP)</h3>\n                    </div>\n                    <p class=\"text-2xl text-gray-300 leading-relaxed\">\n                        Bir toplumda örf, âdet ve kural hâlini almış <strong>iyi ve güzel davranışlardır.</strong> Saygının hayata yansımasıdır.\n                    </p>\n                </div>\n\n                <div class=\"bg-white/5 p-12 rounded-3xl border-l-8 border-pink-500 hover:bg-white/10 transition\">\n                    <div class=\"flex items-center gap-6 mb-6\">\n                        <i class=\"fas fa-heart text-6xl text-pink-400\"></i>\n                        <h3 class=\"text-5xl font-bold text-white\">NEZAKET</h3>\n                    </div>\n                    <p class=\"text-2xl text-gray-300 leading-relaxed\">\n                        İnsanlara <strong>kibar, nazik ve saygılı</strong> davranmaktır. Kalp kırmamak, ince düşünceli olmaktır.\n                    </p>\n                </div>\n\n            </div>\n        </div>\n    </div>\n\n    <!-- SLAYT 3: PEYGAMBERİMİZİN ÖRNEKLİĞİ -->\n    <div class=\"slide\">\n        <div class=\"glass-panel fade-up\">\n            <h2 class=\"text-5xl font-bold mb-10 text-yellow-200\">En Güzel Örnek: Hz. Muhammed (sav)</h2>\n            \n            <div class=\"flex gap-12 w-full max-w-7xl items-center\">\n                <div class=\"w-1/3 text-center\">\n                    <div class=\"w-64 h-64 bg-yellow-500/20 rounded-full flex items-center justify-center mx-auto mb-6 border-4 border-yellow-500/50\">\n                        <i class=\"fas fa-child text-8xl text-yellow-300\"></i>\n                    </div>\n                    <p class=\"text-2xl font-bold text-yellow-400\">Enes bin Malik (ra)</p>\n                </div>\n                <div class=\"w-2/3 bg-black/30 p-10 rounded-3xl border border-white/10 relative\">\n                    <i class=\"fas fa-quote-left absolute -top-6 -left-6 text-6xl text-yellow-500 opacity-50\"></i>\n                    <p class=\"text-3xl italic text-gray-200 leading-relaxed font-serif\">\n                        \"On sene Peygamber'in yanındaydım, bana bir kerecik olsun <strong>'Öf!'</strong> demedi. Yaptığım bir şey hakkında 'Bunu neden yaptın?' veya yapmadığım bir iş için 'Böyle yapsaydın olmaz mıydı?' demedi.\"\n                    </p>\n                </div>\n            </div>\n        </div>\n    </div>\n\n    <!-- SLAYT 4: SELAMLAŞMA ADABI -->\n    <div class=\"slide\">\n        <div class=\"glass-panel fade-up border-t-8 border-green-500\">\n            <h2 class=\"text-5xl font-bold mb-12 text-green-200\"><i class=\"fas fa-hand-paper mr-4\"></i>Selamlaşma Adabı</h2>\n            \n            <div class=\"grid grid-cols-2 gap-12 w-full max-w-6xl\">\n                <div class=\"space-y-6\">\n                    <div class=\"bg-white/5 p-6 rounded-2xl flex items-center gap-4\">\n                        <span class=\"bg-green-500 text-black font-bold px-4 py-2 rounded-lg\">TANIM</span>\n                        <p class=\"text-xl\">\"Selamünaleyküm\" (Selam senin üzerine olsun).</p>\n                    </div>\n                    <div class=\"bg-white/5 p-6 rounded-2xl flex items-center gap-4\">\n                        <span class=\"bg-green-500 text-black font-bold px-4 py-2 rounded-lg\">CEVAP</span>\n                        <p class=\"text-xl\">\"Aleykümselam\" (Selam senin de üzerine olsun).</p>\n                    </div>\n                    <div class=\"bg-white/5 p-6 rounded-2xl flex items-center gap-4\">\n                        <span class=\"bg-green-500 text-black font-bold px-4 py-2 rounded-lg\">ÖNEM</span>\n                        <p class=\"text-xl\">\"Aranızda selamı yayınız.\" (Hadis-i Şerif)</p>\n                    </div>\n                </div>\n\n                <div class=\"bg-green-900/30 p-8 rounded-3xl border border-green-500/30\">\n                    <h3 class=\"text-2xl font-bold text-green-300 mb-6 border-b border-green-500/50 pb-2\">Kim Kime Selam Verir?</h3>\n                    <ul class=\"text-xl space-y-4 text-gray-300\">\n                        <li><i class=\"fas fa-arrow-right text-green-500 mr-2\"></i> Küçükler → Büyüklere</li>\n                        <li><i class=\"fas fa-arrow-right text-green-500 mr-2\"></i> Yürüyenler → Oturanlara</li>\n                        <li><i class=\"fas fa-arrow-right text-green-500 mr-2\"></i> Araçtakiler → Yayalara</li>\n                        <li><i class=\"fas fa-arrow-right text-green-500 mr-2\"></i> Az olanlar → Çok olanlara</li>\n                    </ul>\n                </div>\n            </div>\n        </div>\n    </div>\n\n    <!-- SLAYT 5: İLETİŞİM VE KONUŞMA ADABI -->\n    <div class=\"slide\">\n        <div class=\"glass-panel fade-up\">\n            <h2 class=\"text-5xl font-bold mb-10 text-blue-200\"><i class=\"fas fa-comments mr-4\"></i>İletişim Adabı</h2>\n            \n            <div class=\"grid grid-cols-3 gap-8 w-full max-w-7xl\">\n                <!-- Kural 1 -->\n                <div class=\"bg-white/5 p-8 rounded-2xl text-center hover:bg-white/10 transition\">\n                    <i class=\"fas fa-check-circle text-5xl text-blue-400 mb-4\"></i>\n                    <h3 class=\"text-2xl font-bold mb-2\">Doğru Sözlülük</h3>\n                    <p class=\"text-gray-300\">Yalandan uzak durmak, dürüst olmak.</p>\n                </div>\n                <!-- Kural 2 -->\n                <div class=\"bg-white/5 p-8 rounded-2xl text-center hover:bg-white/10 transition\">\n                    <i class=\"fas fa-volume-down text-5xl text-blue-400 mb-4\"></i>\n                    <h3 class=\"text-2xl font-bold mb-2\">Nazik Dil</h3>\n                    <p class=\"text-gray-300\">Bağırmamak, kaba söz kullanmamak.</p>\n                </div>\n                <!-- Kural 3 -->\n                <div class=\"bg-white/5 p-8 rounded-2xl text-center hover:bg-white/10 transition\">\n                    <i class=\"fas fa-listen text-5xl text-blue-400 mb-4\"></i>\n                    <h3 class=\"text-2xl font-bold mb-2\">İyi Dinleyici</h3>\n                    <p class=\"text-gray-300\">Söz kesmemek, yüzüne bakarak dinlemek.</p>\n                </div>\n                \n                <!-- Sosyal Medya (Alt Kısım) -->\n                <div class=\"col-span-3 bg-indigo-900/30 p-6 rounded-2xl border border-indigo-500/30 flex items-center justify-between\">\n                    <div class=\"flex items-center gap-4\">\n                        <i class=\"fas fa-hashtag text-4xl text-pink-400\"></i>\n                        <div>\n                            <h3 class=\"text-2xl font-bold text-white\">Sosyal Medya Adabı</h3>\n                            <p class=\"text-gray-300\">Türkçeyi doğru kullan, özel bilgilerini paylaşma, emin olmadığın haberi yayma.</p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n\n    <!-- SLAYT 6: SOFRA ADABI -->\n    <div class=\"slide\">\n        <div class=\"glass-panel fade-up border-t-8 border-orange-500\">\n            <h2 class=\"text-5xl font-bold mb-10 text-orange-200\"><i class=\"fas fa-utensils mr-4\"></i>Sofra Adabı</h2>\n            \n            <div class=\"flex gap-10 w-full max-w-6xl\">\n                <!-- Resulullah'ın Öğüdü -->\n                <div class=\"w-1/2 bg-black/20 p-8 rounded-3xl\">\n                    <h3 class=\"text-2xl font-bold text-orange-400 mb-4\">Peygamberimizin Öğüdü</h3>\n                    <p class=\"text-xl text-gray-300 leading-relaxed italic\">\n                        \"Evlat! Besmele çek, sağ elinle ye ve önünden ye!\"\n                        <br><span class=\"text-sm not-italic text-gray-500 mt-2\">(Ömer bin Ebu Seleme'ye tavsiyesi)</span>\n                    </p>\n                    <div class=\"mt-6 flex gap-4\">\n                        <span class=\"bg-white/10 px-4 py-2 rounded-lg\"><i class=\"fas fa-hand-sparkles mr-2\"></i>Elleri Yıka</span>\n                        <span class=\"bg-white/10 px-4 py-2 rounded-lg\"><i class=\"fas fa-pray mr-2\"></i>Besmele/Dua</span>\n                    </div>\n                </div>\n\n                <!-- Kurallar Listesi -->\n                <div class=\"w-1/2 grid grid-cols-2 gap-4\">\n                    <div class=\"bg-white/5 p-4 rounded-xl flex items-center gap-3\"><i class=\"fas fa-check text-green-500\"></i> Oturarak ye.</div>\n                    <div class=\"bg-white/5 p-4 rounded-xl flex items-center gap-3\"><i class=\"fas fa-check text-green-500\"></i> Tabağını bitir.</div>\n                    <div class=\"bg-white/5 p-4 rounded-xl flex items-center gap-3\"><i class=\"fas fa-times text-red-500\"></i> İsraf etme.</div>\n                    <div class=\"bg-white/5 p-4 rounded-xl flex items-center gap-3\"><i class=\"fas fa-times text-red-500\"></i> Ağzın doluyken konuşma.</div>\n                    <div class=\"bg-white/5 p-4 rounded-xl flex items-center gap-3\"><i class=\"fas fa-check text-green-500\"></i> Yemeği yapana teşekkür et.</div>\n                    <div class=\"bg-white/5 p-4 rounded-xl flex items-center gap-3\"><i class=\"fas fa-check text-green-500\"></i> Sofraya beraber otur.</div>\n                </div>\n            </div>\n        </div>\n    </div>\n\n    <!-- SLAYT 7: SONUÇ -->\n    <div class=\"slide\">\n        <div class=\"glass-panel text-center fade-up border-t-8 border-white\">\n            <h1 class=\"text-8xl font-bold mb-8 text-white\">ÖZETLE</h1>\n            <p class=\"text-4xl text-gray-300 mb-16 max-w-4xl mx-auto leading-relaxed\">\n                Adap ve nezaket kurallarına uymak, toplumu güzelleştirir, sevgi ve saygıyı artırır.\n                <br><span class=\"text-indigo-400 font-bold\">Müslüman, elinden ve dilinden herkesin emin olduğu kimsedir.</span>\n            </p>\n            <button onclick=\"changeSlide(-6)\" class=\"px-16 py-6 bg-indigo-600 hover:bg-indigo-500 rounded-full font-bold transition shadow-2xl text-white text-2xl transform hover:scale-105\">\n                <i class=\"fas fa-redo mr-4\"></i> Başa Dön\n            </button>\n        </div>\n    </div>\n\n    <script>\n        let currentSlide = 0;\n        const slides = document.querySelectorAll('.slide');\n        const numDisplay = document.getElementById('slide-num');\n\n        function updateSlide() {\n            slides.forEach((s, i) => {\n                s.classList.remove('active');\n                if(i === currentSlide) {\n                    s.classList.add('active');\n                    const anims = s.querySelectorAll('.fade-up');\n                    anims.forEach(el => {\n                        el.style.animation = 'none';\n                        el.offsetHeight; \n                        el.style.animation = null; \n                    });\n                }\n            });\n            numDisplay.innerText = `${currentSlide + 1}/${slides.length}`;\n        }\n\n        function changeSlide(n) {\n            let next = currentSlide + n;\n            if(next >= 0 && next < slides.length) {\n                currentSlide = next;\n                updateSlide();\n            }\n        }\n\n        document.addEventListener('keydown', (e) => {\n            if(e.key === 'ArrowRight' || e.key === ' ') changeSlide(1);\n            if(e.key === 'ArrowLeft') changeSlide(-1);\n        });\n\n        updateSlide();\n    </script>\n</body>\n</html>",
    "title": "İnteraktif Sunum"
  },
