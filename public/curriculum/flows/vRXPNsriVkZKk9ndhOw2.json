    "title": "İnteraktif Sunum",
    "htmlContent": "<!DOCTYPE html>\n<html lang=\"tr\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no\">\n    <title>Adap ve Nezaket Oyunları</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <link href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css\" rel=\"stylesheet\">\n    <link href=\"https://fonts.googleapis.com/css2?family=Fredoka:wght@400;600&family=Quicksand:wght@400;700&display=swap\" rel=\"stylesheet\">\n\n    <style>\n        body { font-family: 'Quicksand', sans-serif; background-color: #111827; color: white; touch-action: manipulation; overflow: hidden; }\n        h1, h2 { font-family: 'Fredoka', sans-serif; }\n\n        /* HEADER */\n        .header-btn { padding: 15px 30px; border-radius: 12px; font-size: 1.1rem; background: rgba(255,255,255,0.05); transition: all 0.3s; font-weight: bold; border: 1px solid rgba(255,255,255,0.1); display: flex; align-items: center; gap: 10px; }\n        .header-btn.active { background: #6366f1; border-color: #a5b4fc; box-shadow: 0 0 20px rgba(99, 102, 241, 0.5); transform: scale(1.05); }\n\n        /* OYUN 1: SINIFLANDIRMA */\n        .rule-card { background: #1f2937; padding: 2rem; border-radius: 1.5rem; border: 2px solid #374151; font-size: 1.5rem; text-align: center; margin-bottom: 2rem; box-shadow: 0 10px 20px rgba(0,0,0,0.3); }\n        .category-btn { padding: 2rem; border-radius: 1rem; font-size: 1.5rem; font-weight: bold; transition: all 0.2s; cursor: pointer; border: 2px solid rgba(255,255,255,0.1); }\n        .category-btn:hover { transform: translateY(-5px); }\n        .btn-selam { background: #059669; }\n        .btn-iletisim { background: #2563eb; }\n        .btn-sofra { background: #d97706; }\n\n        /* OYUN 2: DOĞRU YANLIŞ */\n        .tf-btn { padding: 2rem; font-size: 2rem; border-radius: 1rem; font-weight: bold; cursor: pointer; transition: transform 0.1s; }\n        .tf-btn:active { transform: scale(0.95); }\n        .tf-true { background: #16a34a; }\n        .tf-false { background: #dc2626; }\n\n        /* OYUN 3: BOŞLUK DOLDURMA */\n        .word-bank-item { padding: 10px 20px; background: #4f46e5; border-radius: 8px; cursor: pointer; font-size: 1.2rem; margin: 5px; display: inline-block; }\n        .blank { border-bottom: 3px dashed #fbbf24; min-width: 100px; display: inline-block; text-align: center; color: #fbbf24; cursor: pointer; }\n\n        /* FEEDBACK */\n        .correct-anim { animation: pulse 0.5s; }\n        .wrong-anim { animation: shake 0.4s; background-color: #ef4444 !important; }\n        @keyframes shake { 0%, 100% { transform: translateX(0); } 25% { transform: translateX(-5px); } 75% { transform: translateX(5px); } }\n    </style>\n</head>\n<body class=\"h-screen w-screen flex flex-col\">\n\n    <!-- Header -->\n    <header class=\"bg-slate-900 p-6 shadow-2xl flex justify-between items-center z-50 h-[100px]\">\n        <h1 class=\"text-3xl text-indigo-400 font-bold\"><i class=\"fas fa-star mr-3\"></i>ADAP OYUNLARI</h1>\n        <div class=\"flex gap-4\">\n            <button onclick=\"switchTab('game1')\" id=\"btn-game1\" class=\"header-btn active\"><i class=\"fas fa-layer-group\"></i> Kuralı Bul</button>\n            <button onclick=\"switchTab('game2')\" id=\"btn-game2\" class=\"header-btn\"><i class=\"fas fa-check-circle\"></i> Doğru/Yanlış</button>\n            <button onclick=\"switchTab('game3')\" id=\"btn-game3\" class=\"header-btn\"><i class=\"fas fa-pen\"></i> Boşluk Doldurma</button>\n        </div>\n    </header>\n\n    <!-- Oyun Alanı -->\n    <div id=\"game-container\" class=\"w-full h-[calc(100vh-100px)] flex justify-center items-center p-4\">\n        \n        <!-- OYUN 1: SINIFLANDIRMA -->\n        <div id=\"game1\" class=\"w-full max-w-5xl text-center\">\n            <h2 class=\"text-4xl font-bold mb-8 text-indigo-200\">Bu Kural Hangi Gruba Girer?</h2>\n            \n            <div id=\"rule-display\" class=\"rule-card\">...</div>\n            \n            <div class=\"grid grid-cols-3 gap-8\">\n                <button onclick=\"checkCat('SELAM')\" class=\"category-btn btn-selam\"><i class=\"fas fa-hand-paper mr-2\"></i>Selamlaşma</button>\n                <button onclick=\"checkCat('ILETISIM')\" class=\"category-btn btn-iletisim\"><i class=\"fas fa-comments mr-2\"></i>İletişim</button>\n                <button onclick=\"checkCat('SOFRA')\" class=\"category-btn btn-sofra\"><i class=\"fas fa-utensils mr-2\"></i>Sofra</button>\n            </div>\n            <div id=\"cat-msg\" class=\"mt-8 h-10 text-2xl font-bold\"></div>\n        </div>\n\n        <!-- OYUN 2: DOĞRU YANLIŞ -->\n        <div id=\"game2\" class=\"hidden w-full max-w-4xl text-center\">\n            <div class=\"bg-slate-800 p-12 rounded-3xl border border-slate-700 shadow-2xl relative\">\n                <span class=\"text-blue-400 font-bold text-xl block mb-6\" id=\"tf-counter\">Soru 1</span>\n                <h2 class=\"text-4xl font-bold mb-12 text-white leading-relaxed\" id=\"tf-question\">...</h2>\n                <div class=\"flex gap-12 justify-center\">\n                    <button onclick=\"checkTF(true)\" class=\"tf-btn tf-true w-64\"><i class=\"fas fa-check mr-2\"></i>DOĞRU</button>\n                    <button onclick=\"checkTF(false)\" class=\"tf-btn tf-false w-64\"><i class=\"fas fa-times mr-2\"></i>YANLIŞ</button>\n                </div>\n                <div id=\"tf-feedback\" class=\"mt-8 h-8 text-2xl font-bold\"></div>\n            </div>\n        </div>\n\n        <!-- OYUN 3: BOŞLUK DOLDURMA -->\n        <div id=\"game3\" class=\"hidden w-full max-w-4xl\">\n            <div class=\"text-center mb-10\"><h2 class=\"text-4xl font-bold text-indigo-200\">Cümleleri Tamamla</h2></div>\n            <div id=\"sentences-area\" class=\"bg-slate-800 p-8 rounded-2xl border border-slate-700 text-2xl leading-loose mb-8\">\n                <!-- JS ile -->\n            </div>\n            <div id=\"word-bank\" class=\"flex flex-wrap justify-center gap-4\">\n                <!-- JS ile -->\n            </div>\n            <div class=\"text-center mt-8\">\n                <button onclick=\"resetGame3()\" class=\"bg-indigo-600 px-8 py-3 rounded-full font-bold hidden\" id=\"reset-btn3\">Tekrar Oyna</button>\n            </div>\n        </div>\n\n    </div>\n\n    <script>\n        function switchTab(id) {\n            ['game1', 'game2', 'game3'].forEach(g => document.getElementById(g).classList.add('hidden'));\n            ['btn-game1', 'btn-game2', 'btn-game3'].forEach(b => document.getElementById(b).classList.remove('active'));\n            \n            document.getElementById(id).classList.remove('hidden');\n            document.getElementById('btn-' + id).classList.add('active');\n        }\n\n        // --- OYUN 1: SINIFLANDIRMA (Etkinlik-9) ---\n        const rules = [\n            { text: \"Konuşurken kaba ve kırıcı olmamak\", cat: \"ILETISIM\" },\n            { text: \"Yemeğe besmele ile başlamak\", cat: \"SOFRA\" },\n            { text: \"Yolda karşılaşınca 'Merhaba' demek\", cat: \"SELAM\" },\n            { text: \"Yemeği sağ elle ve önünden yemek\", cat: \"SOFRA\" },\n            { text: \"Başkalarının sözünü kesmemek\", cat: \"ILETISIM\" },\n            { text: \"Selam verene karşılık vermek\", cat: \"SELAM\" },\n            { text: \"Yemekten sonra 'Elhamdülillah' demek\", cat: \"SOFRA\" },\n            { text: \"Eve girerken izin istemek ve selam vermek\", cat: \"SELAM\" },\n            { text: \"Sosyal medyada özel bilgileri paylaşmamak\", cat: \"ILETISIM\" }\n        ];\n        let ruleIdx = 0;\n\n        function loadRule() {\n            if(ruleIdx >= rules.length) {\n                document.getElementById('rule-display').innerText = \"TEBRİKLER! OYUN BİTTİ.\";\n                return;\n            }\n            document.getElementById('rule-display').innerText = rules[ruleIdx].text;\n            document.getElementById('cat-msg').innerText = \"\";\n        }\n\n        function checkCat(selectedCat) {\n            if(selectedCat === rules[ruleIdx].cat) {\n                document.getElementById('cat-msg').innerHTML = \"<span class='text-green-400'>DOĞRU! ✅</span>\";\n                ruleIdx++;\n                setTimeout(loadRule, 1000);\n            } else {\n                document.getElementById('cat-msg').innerHTML = \"<span class='text-red-400'>YANLIŞ! TEKRAR DENE ❌</span>\";\n            }\n        }\n        loadRule();\n\n        // --- OYUN 2: DOĞRU/YANLIŞ ---\n        const tfQuestions = [\n            { q: \"Adap ve nezaket kuralları toplumsal huzuru sağlar.\", a: true },\n            { q: \"Yemek yerken ağzımız doluyken konuşabiliriz.\", a: false },\n            { q: \"Sosyal medyada istediğimiz her şeyi yazmakta özgürüz.\", a: false },\n            { q: \"Peygamberimiz çocuklara bile selam verirdi.\", a: true },\n            { q: \"Yemeğe başlamadan önce elleri yıkamak sünnettir.\", a: true },\n            { q: \"Birinin evine girerken izin almaya gerek yoktur.\", a: false }\n        ];\n        let tfIdx = 0;\n\n        function loadTF() {\n            if(tfIdx >= tfQuestions.length) {\n                document.getElementById('tf-question').innerText = \"TÜM SORULAR BİTTİ!\";\n                return;\n            }\n            document.getElementById('tf-counter').innerText = `Soru ${tfIdx+1}/${tfQuestions.length}`;\n            document.getElementById('tf-question').innerText = tfQuestions[tfIdx].q;\n            document.getElementById('tf-feedback').innerText = \"\";\n        }\n\n        function checkTF(ans) {\n            if(ans === tfQuestions[tfIdx].a) {\n                document.getElementById('tf-feedback').innerHTML = \"<span class='text-green-400'>DOĞRU!</span>\";\n                setTimeout(() => { tfIdx++; loadTF(); }, 1500);\n            } else {\n                document.getElementById('tf-feedback').innerHTML = \"<span class='text-red-400'>YANLIŞ!</span>\";\n            }\n        }\n        loadTF();\n\n        // --- OYUN 3: BOŞLUK DOLDURMA ---\n        const sentences = [\n            { text: \"Müslümanların birbirine dua etmesine\", blank: \"SELAMLAŞMA\" },\n            { text: \"denir. Yemekten önce ve sonra\", blank: \"ELLERİ\" },\n            { text: \"yıkamalıyız. Peygamberimiz bir konuda asla\", blank: \"KABA\" },\n            { text: \"davranmazdı. Toplumun benimsediği güzel davranışlara\", blank: \"ADAP\" },\n            { text: \"denir.\" }\n        ];\n\n        function initGame3() {\n            const container = document.getElementById('sentences-area');\n            const bank = document.getElementById('word-bank');\n            container.innerHTML = ''; bank.innerHTML = '';\n            \n            const words = [];\n            sentences.forEach(s => {\n                container.appendChild(document.createTextNode(s.text + \" \"));\n                if(s.blank) {\n                    const span = document.createElement('span');\n                    span.className = 'blank';\n                    span.innerText = \"_____\";\n                    span.dataset.word = s.blank;\n                    container.appendChild(span);\n                    words.push(s.blank);\n                }\n                container.appendChild(document.createElement('br'));\n            });\n\n            words.sort(() => Math.random() - 0.5).forEach(w => {\n                const btn = document.createElement('div');\n                btn.className = 'word-bank-item';\n                btn.innerText = w;\n                btn.onclick = () => placeWord(btn, w);\n                bank.appendChild(btn);\n            });\n        }\n\n        function placeWord(btn, word) {\n            const blanks = document.querySelectorAll('.blank');\n            for(let b of blanks) {\n                if(b.innerText === \"_____\") {\n                    if(b.dataset.word === word) {\n                        b.innerText = word;\n                        b.style.color = \"#4ade80\";\n                        b.style.borderBottom = \"none\";\n                        btn.style.display = 'none';\n                    } else {\n                        btn.style.backgroundColor = \"#ef4444\";\n                        setTimeout(() => btn.style.backgroundColor = \"#4f46e5\", 400);\n                    }\n                    return;\n                }\n            }\n        }\n        \n        function resetGame3() {\n            initGame3();\n        }\n\n        initGame3();\n\n    </script>\n</body>\n</html>"
  },
