    "htmlContent": "<!DOCTYPE html>\n<html lang=\"tr\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no\">\n    <title>Kunut Oyun Merkezi</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <link href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css\" rel=\"stylesheet\">\n    <link href=\"https://fonts.googleapis.com/css2?family=Fredoka:wght@400;600&family=Nunito:wght@400;700&display=swap\" rel=\"stylesheet\">\n\n    <style>\n        body { font-family: 'Nunito', sans-serif; background-color: #111827; color: white; touch-action: manipulation; overflow: hidden; }\n        h1, h2 { font-family: 'Fredoka', sans-serif; }\n\n        /* HEADER */\n        .header-btn { padding: 15px 30px; border-radius: 12px; font-size: 1.1rem; background: rgba(255,255,255,0.05); transition: all 0.3s; font-weight: bold; border: 1px solid rgba(255,255,255,0.1); display: flex; align-items: center; gap: 10px; }\n        .header-btn.active { background: #d97706; border-color: #fbbf24; box-shadow: 0 0 20px rgba(245, 158, 11, 0.5); transform: scale(1.05); }\n\n        /* OYUN 1: EŞLEŞTİRME */\n        .match-item { padding: 1.5rem; font-size: 1.2rem; border-radius: 1rem; cursor: pointer; transition: all 0.2s; border: 1px solid rgba(255,255,255,0.1); background: #1f2937; }\n        .match-item:hover { background: #374151; transform: translateX(5px); }\n        .match-item.selected { background: #0ea5e9 !important; color: white; border-color: #38bdf8; transform: scale(1.02); }\n        .match-item.matched { background: #16a34a !important; opacity: 0.5; pointer-events: none; }\n        .match-item.wrong { animation: shake 0.4s; background: #dc2626 !important; }\n\n        /* OYUN 2: BOŞLUK DOLDURMA */\n        .word-bank-item { padding: 10px 20px; background: #4f46e5; border-radius: 8px; cursor: pointer; font-size: 1.2rem; margin: 5px; display: inline-block; transition: all 0.2s; }\n        .word-bank-item:hover { transform: scale(1.1); background: #6366f1; }\n        .blank { border-bottom: 3px dashed #fbbf24; min-width: 120px; display: inline-block; text-align: center; color: #fbbf24; cursor: pointer; font-weight: bold; }\n\n        /* OYUN 3: DOĞRU YANLIŞ */\n        .tf-btn { padding: 2rem; font-size: 2rem; border-radius: 1rem; font-weight: bold; cursor: pointer; transition: transform 0.1s; border: 2px solid rgba(255,255,255,0.2); }\n        .tf-btn:active { transform: scale(0.95); }\n        .tf-true { background: #16a34a; }\n        .tf-false { background: #dc2626; }\n\n        /* OYUN 4: SIRALAMA */\n        .sort-item { background: #334155; padding: 1rem; margin-bottom: 0.5rem; border-radius: 0.5rem; cursor: grab; display: flex; justify-content: space-between; align-items: center; border: 1px solid #475569; font-size: 1.2rem; }\n        .sort-item:active { cursor: grabbing; background: #475569; }\n\n        @keyframes shake { 0%, 100% { transform: translateX(0); } 25% { transform: translateX(-5px); } 75% { transform: translateX(5px); } }\n    </style>\n</head>\n<body class=\"h-screen w-screen flex flex-col\">\n\n    <!-- Header -->\n    <header class=\"bg-slate-900 p-6 shadow-2xl flex justify-between items-center z-50 h-[100px]\">\n        <h1 class=\"text-3xl text-amber-400 font-bold\"><i class=\"fas fa-hands-praying mr-3\"></i>KUNUT OYUNLARI</h1>\n        <div class=\"flex gap-4\">\n            <button onclick=\"switchTab('game1')\" id=\"btn-game1\" class=\"header-btn active\"><i class=\"fas fa-link\"></i> Eşleştirme</button>\n            <button onclick=\"switchTab('game2')\" id=\"btn-game2\" class=\"header-btn\"><i class=\"fas fa-pen\"></i> Doldurma</button>\n            <button onclick=\"switchTab('game3')\" id=\"btn-game3\" class=\"header-btn\"><i class=\"fas fa-check-circle\"></i> Doğru/Yanlış</button>\n            <button onclick=\"switchTab('game4')\" id=\"btn-game4\" class=\"header-btn\"><i class=\"fas fa-sort-amount-down\"></i> Sıralama</button>\n        </div>\n    </header>\n\n    <!-- Oyun Alanı -->\n    <div id=\"game-container\" class=\"w-full h-[calc(100vh-100px)] flex justify-center items-center p-4\">\n        \n        <!-- OYUN 1: EŞLEŞTİRME -->\n        <div id=\"game1\" class=\"w-full max-w-6xl text-center\">\n            <h2 class=\"text-4xl font-bold mb-4 text-blue-200\">Kelime ve Anlamı</h2>\n            <p class=\"text-xl text-gray-400 mb-8\">Arapça ifadeleri Türkçe anlamlarıyla eşleştir.</p>\n            \n            <div class=\"grid grid-cols-2 gap-16 w-full\">\n                <div class=\"flex flex-col gap-4\" id=\"col-arabic\"></div>\n                <div class=\"flex flex-col gap-4\" id=\"col-turkish\"></div>\n            </div>\n            <div id=\"msg1\" class=\"text-center mt-10 text-4xl font-bold hidden text-green-400\">Tebrikler! Hepsini bildin.</div>\n        </div>\n\n        <!-- OYUN 2: BOŞLUK DOLDURMA -->\n        <div id=\"game2\" class=\"hidden w-full max-w-5xl text-center\">\n            <h2 class=\"text-4xl font-bold mb-4 text-purple-200\">Duayı Tamamla</h2>\n            <p class=\"text-xl text-gray-400 mb-10\">Kelimeleri doğru yerlere sürükle veya tıkla.</p>\n            \n            <div id=\"sentences-area\" class=\"bg-slate-800 p-10 rounded-3xl border border-slate-700 text-3xl leading-loose mb-10 text-left shadow-2xl\">\n                <!-- JS ile -->\n            </div>\n            <div id=\"word-bank\" class=\"flex flex-wrap justify-center gap-6\">\n                <!-- JS ile -->\n            </div>\n            <div class=\"text-center mt-8\">\n                <button onclick=\"resetGame2()\" class=\"bg-indigo-600 px-8 py-3 rounded-full font-bold hidden\" id=\"reset-btn2\">Tekrar Oyna</button>\n            </div>\n        </div>\n\n        <!-- OYUN 3: DOĞRU YANLIŞ -->\n        <div id=\"game3\" class=\"hidden w-full max-w-4xl text-center\">\n            <div class=\"bg-slate-800 p-12 rounded-3xl border border-slate-700 shadow-2xl relative\">\n                <span class=\"text-amber-400 font-bold text-xl block mb-6\" id=\"tf-counter\">Soru 1</span>\n                <h2 class=\"text-4xl font-bold mb-12 text-white leading-relaxed\" id=\"tf-question\">...</h2>\n                <div class=\"flex gap-12 justify-center\">\n                    <button onclick=\"checkTF(true)\" class=\"tf-btn tf-true w-64\"><i class=\"fas fa-check mr-2\"></i>DOĞRU</button>\n                    <button onclick=\"checkTF(false)\" class=\"tf-btn tf-false w-64\"><i class=\"fas fa-times mr-2\"></i>YANLIŞ</button>\n                </div>\n                <div id=\"tf-feedback\" class=\"mt-8 h-8 text-2xl font-bold\"></div>\n            </div>\n        </div>\n\n        <!-- OYUN 4: SIRALAMA -->\n        <div id=\"game4\" class=\"hidden w-full max-w-3xl text-center\">\n            <h2 class=\"text-4xl font-bold mb-8 text-green-200\">Kunut 1 Sıralaması</h2>\n            <div id=\"sort-list\" class=\"space-y-4 text-left\">\n                <!-- JS ile -->\n            </div>\n            <div id=\"sort-msg\" class=\"mt-8 text-2xl font-bold hidden\"></div>\n            <div class=\"flex gap-4 justify-center mt-8\">\n                <button onclick=\"checkOrder()\" class=\"bg-green-600 hover:bg-green-500 px-8 py-3 rounded-xl font-bold text-xl\">KONTROL ET</button>\n                <button onclick=\"initGame4()\" class=\"bg-slate-600 hover:bg-slate-500 px-8 py-3 rounded-xl font-bold text-xl\">SIFIRLA</button>\n            </div>\n        </div>\n\n    </div>\n\n    <script>\n        function switchTab(id) {\n            ['game1', 'game2', 'game3', 'game4'].forEach(g => document.getElementById(g).classList.add('hidden'));\n            ['btn-game1', 'btn-game2', 'btn-game3', 'btn-game4'].forEach(b => document.getElementById(b).classList.remove('active'));\n            \n            document.getElementById(id).classList.remove('hidden');\n            document.getElementById('btn-' + id).classList.add('active');\n        }\n\n        // --- OYUN 1: EŞLEŞTİRME ---\n        const matchData = [\n            { ar: \"Nestaînüke\", tr: \"Senden yardım isteriz\" },\n            { ar: \"Nestağfirüke\", tr: \"Senden bağışlanma dileriz\" },\n            { ar: \"Netûbü ileyk\", tr: \"Sana tövbe ederiz\" },\n            { ar: \"Na'büdü\", tr: \"Kulluk ederiz\" },\n            { ar: \"Nescüdü\", tr: \"Secde ederiz\" }\n        ];\n\n        let selAr = null, selTr = null, matches = 0;\n        const colAr = document.getElementById('col-arabic');\n        const colTr = document.getElementById('col-turkish');\n\n        const shufAr = [...matchData].sort(() => Math.random() - 0.5);\n        const shufTr = [...matchData].sort(() => Math.random() - 0.5);\n\n        shufAr.forEach(d => {\n            const btn = document.createElement('div');\n            btn.className = 'match-item bg-slate-700 text-xl font-serif';\n            btn.innerText = d.ar;\n            btn.onclick = () => selectItem(btn, 'ar', d.ar);\n            colAr.appendChild(btn);\n        });\n\n        shufTr.forEach(d => {\n            const btn = document.createElement('div');\n            btn.className = 'match-item bg-slate-800 text-center text-xl';\n            btn.innerText = d.tr;\n            btn.onclick = () => selectItem(btn, 'tr', d.ar); // Key olarak AR kullan\n            colTr.appendChild(btn);\n        });\n\n        function selectItem(el, type, key) {\n            if(el.classList.contains('matched')) return;\n            \n            if(type === 'ar') {\n                if(selAr) selAr.el.classList.remove('selected');\n                selAr = { el, key };\n            } else {\n                if(selTr) selTr.el.classList.remove('selected');\n                selTr = { el, key };\n            }\n            el.classList.add('selected');\n\n            if(selAr && selTr) {\n                if(selAr.key === selTr.key) {\n                    selAr.el.classList.add('matched'); selTr.el.classList.add('matched');\n                    selAr.el.classList.remove('selected'); selTr.el.classList.remove('selected');\n                    selAr = null; selTr = null; matches++;\n                    if(matches === matchData.length) document.getElementById('msg1').classList.remove('hidden');\n                } else {\n                    selAr.el.classList.add('wrong'); selTr.el.classList.add('wrong');\n                    setTimeout(() => {\n                        selAr.el.classList.remove('wrong', 'selected');\n                        selTr.el.classList.remove('wrong', 'selected');\n                        selAr = null; selTr = null;\n                    }, 500);\n                }\n            }\n        }\n\n        // --- OYUN 2: BOŞLUK DOLDURMA ---\n        const sentences = [\n            { text: \"Allah'ım! Senden\", blank: \"YARDIM\" },\n            { text: \"isteriz. Günahlarımızı\", blank: \"BAĞIŞLAMANI\" },\n            { text: \"dileriz. Sana\", blank: \"İNANIRIZ\" },\n            { text: \"sana tövbe ederiz. Sana\", blank: \"GÜVENİRİZ\" },\n            { text: \".\" }\n        ];\n\n        function initGame2() {\n            const container = document.getElementById('sentences-area');\n            const bank = document.getElementById('word-bank');\n            container.innerHTML = ''; bank.innerHTML = '';\n            \n            const words = [];\n            sentences.forEach(s => {\n                container.appendChild(document.createTextNode(s.text + \" \"));\n                if(s.blank) {\n                    const span = document.createElement('span');\n                    span.className = 'blank';\n                    span.innerText = \"_____\";\n                    span.dataset.word = s.blank;\n                    container.appendChild(span);\n                    words.push(s.blank);\n                }\n            });\n\n            words.sort(() => Math.random() - 0.5).forEach(w => {\n                const btn = document.createElement('div');\n                btn.className = 'word-bank-item';\n                btn.innerText = w;\n                btn.onclick = () => placeWord(btn, w);\n                bank.appendChild(btn);\n            });\n        }\n\n        function placeWord(btn, word) {\n            const blanks = document.querySelectorAll('.blank');\n            for(let b of blanks) {\n                if(b.innerText === \"_____\") {\n                    if(b.dataset.word === word) {\n                        b.innerText = word;\n                        b.style.color = \"#4ade80\";\n                        b.style.borderBottom = \"none\";\n                        btn.style.display = 'none';\n                    } else {\n                        btn.style.backgroundColor = \"#ef4444\";\n                        setTimeout(() => btn.style.backgroundColor = \"#4f46e5\", 400);\n                    }\n                    return;\n                }\n            }\n        }\n        \n        function resetGame2() { initGame2(); }\n        initGame2();\n\n        // --- OYUN 3: DOĞRU YANLIŞ ---\n        const tfQuestions = [\n            { q: \"Kunut duaları sabah namazında okunur.\", a: false, fb: \"Yanlış! Vitir namazında okunur.\" },\n            { q: \"Kunut, 'itaat etmek, saygı durmak' demektir.\", a: true, fb: \"Doğru!\" },\n            { q: \"Vitir namazının son rekatında tekbirden sonra okunur.\", a: true, fb: \"Doğru!\" },\n            { q: \"Kunut dualarında sadece kendimiz için dua ederiz.\", a: false, fb: \"Yanlış! Çoğul ifadeler (Biz) kullanırız.\" },\n            { q: \"Kunut duaları Kur'an-ı Kerim'de bir suredir.\", a: false, fb: \"Yanlış! Hz. Peygamber'den rivayet edilen dualardır.\" }\n        ];\n        let tfIdx = 0;\n\n        function loadTF() {\n            if(tfIdx >= tfQuestions.length) {\n                document.getElementById('tf-question').innerText = \"TÜM SORULAR BİTTİ!\";\n                return;\n            }\n            document.getElementById('tf-counter').innerText = `Soru ${tfIdx+1}/${tfQuestions.length}`;\n            document.getElementById('tf-question').innerText = tfQuestions[tfIdx].q;\n            document.getElementById('tf-feedback').innerText = \"\";\n        }\n\n        function checkTF(ans) {\n            const q = tfQuestions[tfIdx];\n            const fb = document.getElementById('tf-feedback');\n            if(ans === q.a) {\n                fb.innerHTML = `<span class=\"text-green-400\">TEBRİKLER! ${q.fb}</span>`;\n                setTimeout(() => { tfIdx++; loadTF(); }, 2000);\n            } else {\n                document.getElementById('tf-feedback').innerHTML = \"<span class='text-red-400'>YANLIŞ!</span>\";\n            }\n        }\n        loadTF();\n\n        // --- OYUN 4: SIRALAMA ---\n        const correctOrder = [\n            \"Allah'ım! Senden yardım isteriz,\",\n            \"günahlarımızı bağışlamanı isteriz,\",\n            \"razı olduğun şeylere hidayet etmeni isteriz.\",\n            \"Sana inanırız, sana tövbe ederiz.\",\n            \"Sana güveniriz.\"\n        ];\n        \n        function initGame4() {\n            const list = document.getElementById('sort-list');\n            list.innerHTML = '';\n            document.getElementById('sort-msg').innerText = '';\n            document.getElementById('sort-msg').className = \"mt-8 text-2xl font-bold hidden\";\n\n            // Karıştır\n            const shuffled = [...correctOrder].sort(() => Math.random() - 0.5);\n            \n            shuffled.forEach(text => {\n                const item = document.createElement('div');\n                item.className = 'sort-item';\n                item.draggable = true;\n                item.innerHTML = `<span>${text}</span> <i class=\"fas fa-bars text-gray-400\"></i>`;\n                \n                // Drag Events\n                item.addEventListener('dragstart', () => item.classList.add('dragging'));\n                item.addEventListener('dragend', () => item.classList.remove('dragging'));\n                \n                list.appendChild(item);\n            });\n\n            const draggables = document.querySelectorAll('.sort-item');\n            const container = document.getElementById('sort-list');\n\n            container.addEventListener('dragover', e => {\n                e.preventDefault();\n                const afterElement = getDragAfterElement(container, e.clientY);\n                const draggable = document.querySelector('.dragging');\n                if (afterElement == null) {\n                    container.appendChild(draggable);\n                } else {\n                    container.insertBefore(draggable, afterElement);\n                }\n            });\n        }\n\n        function getDragAfterElement(container, y) {\n            const draggableElements = [...container.querySelectorAll('.sort-item:not(.dragging)')];\n            return draggableElements.reduce((closest, child) => {\n                const box = child.getBoundingClientRect();\n                const offset = y - box.top - box.height / 2;\n                if (offset < 0 && offset > closest.offset) {\n                    return { offset: offset, element: child };\n                } else {\n                    return closest;\n                }\n            }, { offset: Number.NEGATIVE_INFINITY }).element;\n        }\n\n        function checkOrder() {\n            const currentItems = document.querySelectorAll('.sort-item span');\n            let isCorrect = true;\n            currentItems.forEach((item, index) => {\n                if(item.innerText !== correctOrder[index]) isCorrect = false;\n            });\n\n            const msg = document.getElementById('sort-msg');\n            msg.classList.remove('hidden');\n            if(isCorrect) {\n                msg.innerText = \"HARİKA! SIRALAMA DOĞRU.\";\n                msg.className = \"mt-8 text-2xl font-bold text-green-400\";\n            } else {\n                msg.innerText = \"HENÜZ OLMADI, TEKRAR DENE.\";\n                msg.className = \"mt-8 text-2xl font-bold text-red-400\";\n            }\n        }\n\n        initGame4();\n\n    </script>\n</body>\n</html>",
    "isPublished": false
  },
