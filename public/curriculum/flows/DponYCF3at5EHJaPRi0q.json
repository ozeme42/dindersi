    "htmlContent": "<!DOCTYPE html>\n<html lang=\"tr\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Kunut Duaları - Ders Sunumu</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <link href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css\" rel=\"stylesheet\">\n    <link href=\"https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&family=Cinzel:wght@700&family=Noto+Sans+TR:wght@300;500;700&display=swap\" rel=\"stylesheet\">\n\n    <style>\n        body {\n            font-family: 'Noto Sans TR', sans-serif;\n            background-color: #0c4a6e; /* Koyu Petrol Mavisi */\n            color: #f0f9ff;\n            overflow: hidden;\n        }\n        h1, h2 { font-family: 'Cinzel', serif; letter-spacing: 1px; }\n        .arabic-text { font-family: 'Amiri', serif; line-height: 1.8; }\n\n        /* SLAYT YAPISI */\n        .slide {\n            display: none !important;\n            opacity: 0;\n            transition: opacity 0.8s ease-in-out;\n            position: absolute;\n            inset: 0;\n            padding: 0;\n            flex-direction: column;\n            justify-content: center;\n            align-items: center;\n            z-index: 1;\n        }\n        .slide.active {\n            display: flex !important;\n            opacity: 1;\n            z-index: 10;\n        }\n\n        /* CAM KARTLAR */\n        .glass-panel {\n            width: 90vw;\n            height: 85vh;\n            background: rgba(255, 255, 255, 0.05);\n            backdrop-filter: blur(20px);\n            border: 1px solid rgba(255, 255, 255, 0.15);\n            box-shadow: 0 25px 50px rgba(0, 0, 0, 0.5);\n            border-radius: 2rem;\n            display: flex;\n            flex-direction: column;\n            justify-content: center;\n            align-items: center;\n            padding: 3rem;\n            position: relative;\n        }\n\n        /* YAN MENÜ (Masaüstü için) */\n        .sidebar {\n            position: absolute; left: 2rem; top: 50%; transform: translateY(-50%);\n            display: flex; flex-direction: column; gap: 1rem; z-index: 50;\n        }\n        .menu-dot {\n            width: 12px; height: 12px; background: rgba(255,255,255,0.3);\n            border-radius: 50%; cursor: pointer; transition: all 0.3s;\n        }\n        .menu-dot.active { background: #fbbf24; transform: scale(1.5); box-shadow: 0 0 10px #fbbf24; }\n        .menu-dot:hover::after {\n            content: attr(data-title);\n            position: absolute; left: 20px; top: -5px;\n            background: rgba(0,0,0,0.8); padding: 4px 8px;\n            border-radius: 4px; font-size: 0.8rem; white-space: nowrap;\n        }\n\n        /* ANİMASYONLAR */\n        .fade-up { animation: fadeUp 1s forwards; opacity: 0; transform: translateY(30px); }\n        .delay-1 { animation-delay: 0.2s; }\n        .delay-2 { animation-delay: 0.4s; }\n        .delay-3 { animation-delay: 0.6s; }\n\n        @keyframes fadeUp { to { opacity: 1; transform: translateY(0); } }\n\n        /* ARKA PLAN */\n        .bg-pattern {\n            background-image: radial-gradient(circle at 50% 0%, #0369a1 0%, #082f49 100%);\n        }\n    </style>\n</head>\n<body class=\"h-screen w-screen relative bg-pattern\">\n\n    <!-- Dekoratif -->\n    <div class=\"absolute top-0 right-0 w-[40vw] h-[40vw] bg-amber-500/10 rounded-full blur-[150px] pointer-events-none\"></div>\n    <div class=\"absolute bottom-0 left-0 w-[40vw] h-[40vw] bg-cyan-500/10 rounded-full blur-[150px] pointer-events-none\"></div>\n\n    <!-- Yan Menü -->\n    <div class=\"sidebar\">\n        <div class=\"menu-dot active\" onclick=\"goToSlide(0)\" data-title=\"Kapak\"></div>\n        <div class=\"menu-dot\" onclick=\"goToSlide(1)\" data-title=\"Kunut Nedir?\"></div>\n        <div class=\"menu-dot\" onclick=\"goToSlide(2)\" data-title=\"Kunut 1\"></div>\n        <div class=\"menu-dot\" onclick=\"goToSlide(3)\" data-title=\"Kunut 2\"></div>\n        <div class=\"menu-dot\" onclick=\"goToSlide(4)\" data-title=\"Özet\"></div>\n    </div>\n\n    <!-- Navigasyon -->\n    <div class=\"absolute bottom-6 right-8 z-50 flex gap-6\">\n        <button onclick=\"changeSlide(-1)\" class=\"w-16 h-16 rounded-full bg-white/10 hover:bg-white/20 flex items-center justify-center transition border border-white/20 text-2xl\"><i class=\"fas fa-chevron-left\"></i></button>\n        <span id=\"slide-num\" class=\"flex items-center font-bold text-amber-300 text-2xl w-16 justify-center\">1/5</span>\n        <button onclick=\"changeSlide(1)\" class=\"w-16 h-16 rounded-full bg-white/10 hover:bg-white/20 flex items-center justify-center transition border border-white/20 text-2xl\"><i class=\"fas fa-chevron-right\"></i></button>\n    </div>\n\n    <!-- SLAYT 1: KAPAK -->\n    <div class=\"slide active\">\n        <div class=\"glass-panel border-t-8 border-amber-500 fade-up\">\n            <div class=\"inline-block bg-amber-500/20 p-10 rounded-full mb-8 shadow-[0_0_50px_rgba(251,191,36,0.2)]\">\n                <i class=\"fas fa-hands-praying text-8xl text-amber-400\"></i>\n            </div>\n            <h1 class=\"text-7xl lg:text-9xl font-extrabold mb-6 text-transparent bg-clip-text bg-gradient-to-r from-amber-200 to-white\">\n                KUNUT DUALARI\n            </h1>\n            <h2 class=\"text-3xl text-gray-300 font-light mb-8 text-center max-w-4xl\">\n                \"Allah'ım! Senden yardım isteriz, günahlarımızı bağışlamanı dileriz.\"\n            </h2>\n            <div class=\"bg-white/5 px-10 py-4 rounded-full border border-white/10\">\n                <span class=\"text-xl text-amber-200 font-bold\">BİR DUA ÖĞRENİYORUM</span>\n            </div>\n        </div>\n    </div>\n\n    <!-- SLAYT 2: KUNUT NEDİR? -->\n    <div class=\"slide\">\n        <div class=\"glass-panel fade-up\">\n            <h2 class=\"text-5xl font-bold mb-12 text-cyan-200 border-b-2 border-cyan-500/50 pb-4\">Kunut Ne Demektir?</h2>\n            \n            <div class=\"grid grid-cols-2 gap-12 w-full max-w-7xl items-center\">\n                <div class=\"bg-white/5 p-10 rounded-3xl border border-white/10 h-full\">\n                    <h3 class=\"text-3xl font-bold text-amber-400 mb-6\"><i class=\"fas fa-book mr-3\"></i>Anlamı</h3>\n                    <ul class=\"text-2xl text-gray-200 space-y-4 leading-relaxed\">\n                        <li><i class=\"fas fa-check text-cyan-400 mr-2\"></i> İtaat etmek</li>\n                        <li><i class=\"fas fa-check text-cyan-400 mr-2\"></i> İbadet etmek</li>\n                        <li><i class=\"fas fa-check text-cyan-400 mr-2\"></i> Ayakta durmak</li>\n                        <li><i class=\"fas fa-check text-cyan-400 mr-2\"></i> Allah'a sığınmak</li>\n                    </ul>\n                </div>\n\n                <div class=\"bg-white/5 p-10 rounded-3xl border border-white/10 h-full flex flex-col justify-center\">\n                    <h3 class=\"text-3xl font-bold text-amber-400 mb-6\"><i class=\"fas fa-mosque mr-3\"></i>Ne Zaman Okunur?</h3>\n                    <div class=\"space-y-6\">\n                        <div class=\"bg-black/20 p-4 rounded-xl flex items-center gap-4\">\n                            <span class=\"text-3xl text-cyan-400 font-bold\">1</span>\n                            <span class=\"text-xl\">Yatsı namazından sonra kılınan <strong>Vitir Namazının</strong> son rekâtında.</span>\n                        </div>\n                        <div class=\"bg-black/20 p-4 rounded-xl flex items-center gap-4\">\n                            <span class=\"text-3xl text-cyan-400 font-bold\">2</span>\n                            <span class=\"text-xl\">Zor durumlarda, salgın hastalık ve doğal afetlerde yardım dilemek için.</span>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n\n    <!-- SLAYT 3: KUNUT 1 -->\n    <div class=\"slide\">\n        <div class=\"glass-panel fade-up border-r-8 border-green-500\">\n            <div class=\"absolute top-10 left-10 text-xl font-bold text-green-400 bg-green-900/30 px-4 py-2 rounded\">KUNUT - 1</div>\n            \n            <div class=\"flex gap-12 w-full max-w-7xl h-full items-center\">\n                <!-- Arapça -->\n                <div class=\"w-1/2 text-right\">\n                    <p class=\"arabic-text text-5xl leading-[1.8] text-white\" dir=\"rtl\">\n                        اَللّٰهُمَّ اِنَّا نَسْتَعِينُكَ <br>\n                        وَنَسْتَغْفِرُكَ وَنَسْتَهْدِيكَ <br>\n                        وَنُؤْمِنُ بِكَ وَنَتُوبُ اِلَيْكَ <br>\n                        وَنَتَوَكَّلُ عَلَيْكَ\n                    </p>\n                </div>\n                \n                <!-- Türkçe -->\n                <div class=\"w-1/2 space-y-6\">\n                    <h3 class=\"text-3xl font-bold text-green-300 mb-4\">Allah'ım!</h3>\n                    <div class=\"space-y-4 text-xl text-gray-200\">\n                        <p class=\"p-3 bg-white/5 rounded-lg border-l-4 border-green-500\">Senden yardım isteriz.</p>\n                        <p class=\"p-3 bg-white/5 rounded-lg border-l-4 border-green-500\">Günahlarımızı bağışlamanı isteriz.</p>\n                        <p class=\"p-3 bg-white/5 rounded-lg border-l-4 border-green-500\">Razı olduğun şeylere hidayet etmeni isteriz.</p>\n                        <p class=\"p-3 bg-white/5 rounded-lg border-l-4 border-green-500\">Sana inanırız, sana tövbe ederiz.</p>\n                        <p class=\"p-3 bg-white/5 rounded-lg border-l-4 border-green-500\">Sana güveniriz.</p>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n\n    <!-- SLAYT 4: KUNUT 2 -->\n    <div class=\"slide\">\n        <div class=\"glass-panel fade-up border-l-8 border-blue-500\">\n            <div class=\"absolute top-10 right-10 text-xl font-bold text-blue-400 bg-blue-900/30 px-4 py-2 rounded\">KUNUT - 2</div>\n            \n            <div class=\"flex gap-12 w-full max-w-7xl h-full items-center flex-row-reverse\">\n                <!-- Arapça -->\n                <div class=\"w-1/2 text-right\">\n                    <p class=\"arabic-text text-5xl leading-[1.8] text-white\" dir=\"rtl\">\n                        اَللّٰهُمَّ اِيَّاكَ نَعْبُدُ <br>\n                        وَلَكَ نُصَلِّي وَنَسْجُدُ <br>\n                        وَاِلَيْكَ نَسْعٰى وَنَحْفِدُ <br>\n                        نَرْجُوا رَحْمَتَكَ وَنَخْشٰى عَذَابَكَ\n                    </p>\n                </div>\n                \n                <!-- Türkçe -->\n                <div class=\"w-1/2 space-y-6\">\n                    <h3 class=\"text-3xl font-bold text-blue-300 mb-4\">Allah'ım!</h3>\n                    <div class=\"space-y-4 text-xl text-gray-200\">\n                        <p class=\"p-3 bg-white/5 rounded-lg border-r-4 border-blue-500\">Biz yalnız sana kulluk ederiz.</p>\n                        <p class=\"p-3 bg-white/5 rounded-lg border-r-4 border-blue-500\">Namazı yalnız senin için kılarız, ancak sana secde ederiz.</p>\n                        <p class=\"p-3 bg-white/5 rounded-lg border-r-4 border-blue-500\">Yalnız sana koşar ve sana yaklaştıracak şeyleri kazanmaya çalışırız.</p>\n                        <p class=\"p-3 bg-white/5 rounded-lg border-r-4 border-blue-500\">Rahmetini umarız, azabından korkarız.</p>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n\n    <!-- SLAYT 5: ÖZET VE SONUÇ -->\n    <div class=\"slide\">\n        <div class=\"glass-panel text-center fade-up border-t-8 border-white\">\n            <h1 class=\"text-6xl font-bold mb-10 text-white\">DUANIN ÖZÜ</h1>\n            \n            <div class=\"grid grid-cols-3 gap-8 max-w-6xl w-full\">\n                <div class=\"bg-white/10 p-8 rounded-2xl hover:bg-white/20 transition\">\n                    <i class=\"fas fa-hands-helping text-5xl text-amber-400 mb-4\"></i>\n                    <h3 class=\"text-2xl font-bold mb-2\">YARDIM</h3>\n                    <p class=\"text-gray-300\">Yalnızca Allah'tan yardım dileriz.</p>\n                </div>\n                <div class=\"bg-white/10 p-8 rounded-2xl hover:bg-white/20 transition\">\n                    <i class=\"fas fa-heart text-5xl text-red-400 mb-4\"></i>\n                    <h3 class=\"text-2xl font-bold mb-2\">SEVGİ & KORKU</h3>\n                    <p class=\"text-gray-300\">Rahmetini umar (sevgi), azabından sakınırız (korku).</p>\n                </div>\n                <div class=\"bg-white/10 p-8 rounded-2xl hover:bg-white/20 transition\">\n                    <i class=\"fas fa-pray text-5xl text-green-400 mb-4\"></i>\n                    <h3 class=\"text-2xl font-bold mb-2\">KULLUK</h3>\n                    <p class=\"text-gray-300\">Sadece O'na ibadet ve secde ederiz.</p>\n                </div>\n            </div>\n\n            <button onclick=\"changeSlide(-4)\" class=\"mt-16 px-16 py-6 bg-cyan-700 hover:bg-cyan-600 rounded-full font-bold transition shadow-2xl text-white text-2xl transform hover:scale-105\">\n                <i class=\"fas fa-redo mr-4\"></i> Başa Dön\n            </button>\n        </div>\n    </div>\n\n    <script>\n        let currentSlide = 0;\n        const slides = document.querySelectorAll('.slide');\n        const dots = document.querySelectorAll('.menu-dot');\n        const numDisplay = document.getElementById('slide-num');\n\n        function updateSlide() {\n            slides.forEach((s, i) => {\n                s.classList.remove('active');\n                if(i === currentSlide) {\n                    s.classList.add('active');\n                    const anims = s.querySelectorAll('.fade-up');\n                    anims.forEach(el => {\n                        el.style.animation = 'none';\n                        el.offsetHeight; \n                        el.style.animation = null; \n                    });\n                }\n            });\n            \n            dots.forEach((d, i) => {\n                if(i === currentSlide) d.classList.add('active');\n                else d.classList.remove('active');\n            });\n\n            numDisplay.innerText = `${currentSlide + 1}/${slides.length}`;\n        }\n\n        function changeSlide(n) {\n            let next = currentSlide + n;\n            if(next >= 0 && next < slides.length) {\n                currentSlide = next;\n                updateSlide();\n            }\n        }\n\n        function goToSlide(n) {\n            currentSlide = n;\n            updateSlide();\n        }\n\n        document.addEventListener('keydown', (e) => {\n            if(e.key === 'ArrowRight' || e.key === ' ') changeSlide(1);\n            if(e.key === 'ArrowLeft') changeSlide(-1);\n        });\n\n        updateSlide();\n    </script>\n</body>\n</html>",
    "isPublished": false
  },
